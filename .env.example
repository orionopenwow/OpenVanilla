# ==============================================================================
# Open Vanilla Cloud Deployment & Server Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables for your cloud hosting environment
# (Docker container, Kubernetes pod, VPS instance, or managed Linux server).

# Server Root & Binaries
SPP_ROOT=/opt/openvanilla/server
MYSQL_BIN=/usr/bin/mysql
MANGOSD_BIN=/opt/openvanilla/server/bin/mangosd
REALMD_BIN=/opt/openvanilla/server/bin/realmd

# Database Connection (MySQL / MariaDB)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
AUTH_DATABASE=realmd
WORLD_DATABASE=classicmangos
CHARACTERS_DATABASE=classiccharacters

# Network & Ports
REALM_NAME=Vanilla Remastered
REALM_ADDRESS=play.openvanilla.gg
AUTH_PORT=3724
WORLD_PORT=8085
WEB_PORT=18090
PUBLIC_HTTPS_PORT=443

# Herald (Discord bot, herald.py): only the first two are required
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
SIGNUP_MODE=open            # open: anyone past the Discord gate can make an account. waves: staff /wave invites
MIN_ACCOUNT_AGE_DAYS=0      # >0: Discord accounts newer than this many days wait at the gate (0 = off)
GATE_TIMEOUT_HOURS=48       # Outsiders who never pass the gate are shown out (0 = never)
RAID_JOINS=8                # this many joins within RAID_WINDOW_SEC raises the raid shield
RAID_WINDOW_SEC=60
RAID_COOLDOWN_MIN=15
TRAILBLAZER_LIMIT=500       # the first N adventurers keep the Trailblazer role (0 = off)
# DISCORD_INVITE_URL=https://discord.gg/...
# HERALD_PUBLIC_DIR=./public   (feed.json for the website)
# Herald support desk (in-game tickets; hetzner/herald_up.sh fills in the realm ones on the server)
# OWNER_DISCORD_ID=           your Discord user id: approvals and the ticket DM feed
# SUPPORT_CHANNEL=support-queue
# SUPPORT_DM_OWNER=1
# OWNER_APPROVAL=talents      actions only the owner may run (talents, revive, unstuck, reply, bug)
# AUTO_UNSTUCK=0
# SUPPORT_DB_HOST=127.0.0.1  SUPPORT_DB_PORT=13306  SUPPORT_DB_USER=herald  SUPPORT_DB_PASS=
# SOAP_URL=http://127.0.0.1:17878/  SOAP_USER=HELPDESK  SOAP_PASS=
# GITHUB_TOKEN=  GITHUB_REPO=orionopenwow/OpenVanilla   optional: "Log bug" opens a GitHub issue

# Reverse Proxy & Edge CDN
ENABLE_TLS=true
DOMAIN=openvanilla.gg
CDN_ASSET_URL=https://assets.openvanilla.gg/data/

# Herald, the test bot (tools/Run_Herald.bat): a web login made for it in the realm's admin panel.
# Sign in as it once at the realm and make its one character: Herald, a Human Hunter.
REALM_URL=https://play.openvanilla.app
OWBOT_USER=herald
OWBOT_PASS=
# OWBOT_WEBHOOK=https://discord.com/api/webhooks/...   (optional: post each run's summary)
