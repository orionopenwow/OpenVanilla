# Environment & Secrets
.env
.env.local

# Server runtime data & heavy binaries
SPP_Server/
mysql/
logs/
*.log
web-backend.log
backups/
studio_state/
node_modules/
CaddyData/
*_result.txt
release/OpenVanilla_Client_Win64/

# Blizzard game data never goes in the repo: only Open Vanilla's own addons and art under Data/
Data/*
!Data/Interface/
Data/Interface/*
!Data/Interface/AddOns/
!Data/Interface/ClassicPlus/
Data/Interface/AddOns/Blizzard_*/
# the folder is "addons" on disk: say both, so a case-sensitive checkout ignores them too
!Data/Interface/addons/
Data/Interface/addons/Blizzard_*/
Data/Interface/addons/blizzard_*/

# Database dumps hold player accounts and characters
hetzner/database/dumps/
hetzner/.env

# Big binaries: browser client build, third-party exes, release zips (published to www/downloads)
www/wenilla_bg.wasm*
bin/*.exe
release/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Browser test profiles & temporary files
test_chrome_profile/
.chrome_test_profile/
.chrome_temp/
test_*.png
test_*.js
*.tmp
*.bak
dist/
build/

# Repack build output and per-player launcher settings
release/_build/
release/OpenVanilla_*_Win64/
launcher/settings.json

# Generated by the server control panel (holds the public address) and the push script's log
Caddyfile
push_log.txt
CaddyData/
launcher_settings.json
history_backup.bundle
herald.db
public/
discord_setup.log
herald.log*
discord_content.log
# Blizzard-derived tables are generated on the realm server, never committed
realm/classicplus/*.dbc
realm/classicplus/dbc/
realm/classicplus/gen_classicplus.py
realm/classicplus/diffpc.py

# Release zips live on GitHub Releases (Ship.bat uploads them); the Pages workflow copies the
# latest ones into the website at deploy time, so they never bloat git again.
www/downloads/*.zip
www/downloads/*.sha256
# Backend rate-limit state, and the old local-only git history kept by Make_OpenVanilla_The_Repo.bat
rate_limits.json
.git_local_backup/

# Herald test bot output (tools/owbot.mjs, tools/Run_Herald.bat)
owbot-report.json
owbot-summary.txt
owbot-shots/
tools/package.json
tools/package-lock.json

# Local-only working files (old builds, dumps, logs, caches): never committed
_local/

# Herald's raw film takes (tools/herald_film.mjs); the cut video goes in www/assets/herald
herald-film/
# the portable Forge that "Vanilla Forge.bat" fetches
forge/bin/
