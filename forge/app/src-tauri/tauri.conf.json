{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vanilla Forge",
  "version": "0.9.1",
  "identifier": "app.openvanilla.forge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vanilla Forge",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://openvanilla.app https://openvanilla.app"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Make addons, art and content packs for Open Vanilla",
    "category": "DeveloperTool",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
