# /opt/openvanilla-relay/relay.env (relay_up.sh fills in the secret; chmod 600)
# Central verify: the realm container on the same Docker network (works once patch 0012 is
# deployed with DIRECTORY_ENABLED=1 and the same RELAY_VERIFY_SECRET in the realm's environment).
RELAY_VERIFY_URL=http://realm:8090/api/directory/verify
RELAY_VERIFY_SECRET=change-me-shared-with-central
# Until then (and for the smoke test) hosts are let in from this list: host_id sha256(token) [public|private]
RELAY_ALLOW_FILE=/etc/openvanilla-relay/allow.txt
# Test-round limits, per host. The box also runs the realm: keep them small and raise later.
RELAY_MAX_STREAMS=32
RELAY_KBPS=256
RELAY_DAILY_GB=5
RELAY_STREAM_IDLE_SECS=900
RELAY_CTRL_IDLE_SECS=90
RELAY_OPEN_TIMEOUT_SECS=10
RUST_LOG=info
