[Unit]
Description=Open Vanilla Classic Mangosd World Daemon
After=network.target mariadb.service openvanilla-realmd.service
Requires=mariadb.service openvanilla-realmd.service

[Service]
Type=simple
User=openvanilla
WorkingDirectory=/opt/openvanilla/server/bin
ExecStart=/opt/openvanilla/server/bin/mangosd -c /opt/openvanilla/server/etc/mangosd.conf
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
