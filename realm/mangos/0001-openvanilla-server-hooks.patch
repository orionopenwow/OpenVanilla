diff --git a/src/game/OpenVanilla/StarPouch.cpp b/src/game/OpenVanilla/StarPouch.cpp
new file mode 100644
index 000000000..11d0a8c1f
--- /dev/null
+++ b/src/game/OpenVanilla/StarPouch.cpp
@@ -0,0 +1,50 @@
+/*
+ * Open Vanilla — Star Pouches (GPLv2, as CMaNGOS). See StarPouch.h.
+ */
+
+#include "OpenVanilla/StarPouch.h"
+
+#include "Entities/Item.h"
+#include "Entities/ItemPrototype.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Mails/Mail.h"
+
+namespace
+{
+    void Give(Player* player, uint32 entry)
+    {
+        ItemPrototype const* proto = ObjectMgr::GetItemPrototype(entry);
+        if (!proto)
+            return; // classicplus_starpouch.sql not installed
+
+        ItemPosCountVec dest;
+        if (player->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, entry, 1) == EQUIP_ERR_OK)
+        {
+            if (Item* item = player->StoreNewItem(dest, entry, true, Item::GenerateItemRandomPropertyId(entry)))
+                player->SendNewItem(item, 1, true, false);
+            return;
+        }
+        // Bags full: the pouch waits in the mailbox instead of being lost.
+        if (Item* item = Item::CreateItem(entry, 1, player))
+        {
+            item->SaveToDB(); // a failed send must not lose it at the next mail load
+            MailDraft(proto->Name1, "Your bags were full, so your Star Pouch came by mail. Congratulations on the level!")
+                .AddItem(item)
+                .SendMailTo(player, MailSender(MAIL_NORMAL, uint32(0), MAIL_STATIONERY_GM));
+        }
+    }
+}
+
+namespace StarPouch
+{
+    void OnLevelUp(Player* player, uint32 oldLevel, uint32 newLevel)
+    {
+        if (!player || !player->GetSession() || newLevel <= oldLevel)
+            return;
+        // One pouch per level gained, so a jump of several levels is not short-changed.
+        for (uint32 level = oldLevel + 1; level <= newLevel; ++level)
+            if (uint32 entry = PouchFor(level))
+                Give(player, entry);
+    }
+}
diff --git a/src/game/OpenVanilla/StarPouch.h b/src/game/OpenVanilla/StarPouch.h
new file mode 100644
index 000000000..fa6bcaaee
--- /dev/null
+++ b/src/game/OpenVanilla/StarPouch.h
@@ -0,0 +1,32 @@
+/*
+ * Open Vanilla — Star Pouches (GPLv2, as CMaNGOS).
+ *
+ * Every level gained hands the player a Star Pouch for the new level's band (items 90100–90105,
+ * defined by classicplus_starpouch.sql): gold, loot from the band's world drops and boosts
+ * (potions, elixirs, scrolls). Into the bags when there is room, else by mail. Until the SQL is
+ * installed the items do not exist and this does nothing.
+ */
+
+#ifndef OPENVANILLA_STAR_POUCH_H
+#define OPENVANILLA_STAR_POUCH_H
+
+#include "Common.h"
+
+class Player;
+
+namespace StarPouch
+{
+    uint32 const FIRST_ENTRY = 90100;
+    // The pouch for reaching `level`: 2–10 → 90100, 11–20 → 90101, … 51–60 → 90105; 0 for none.
+    inline uint32 PouchFor(uint32 level)
+    {
+        if (level < 2)
+            return 0;
+        uint32 band = (level - 1) / 10;
+        return FIRST_ENTRY + (band > 5 ? 5 : band);
+    }
+    // Called from Player::GiveLevel once the new level is set.
+    void OnLevelUp(Player* player, uint32 oldLevel, uint32 newLevel);
+}
+
+#endif
diff --git a/src/game/OpenVanilla/Wnl.cpp b/src/game/OpenVanilla/Wnl.cpp
new file mode 100644
index 000000000..8142f1aab
--- /dev/null
+++ b/src/game/OpenVanilla/Wnl.cpp
@@ -0,0 +1,524 @@
+/*
+ * Open Vanilla — the WNL server hook (GPLv2, as CMaNGOS). See Wnl.h for the protocol.
+ */
+
+#include "OpenVanilla/Wnl.h"
+#include "OpenVanilla/WnlFormat.h"
+
+#include "AuctionHouse/AuctionHouseMgr.h"
+#include "Database/DatabaseEnv.h"
+#include "Chat/Chat.h"
+#include "Combat/ThreatManager.h"
+#include "Entities/Creature.h"
+#include "Entities/GameObject.h"
+#include "Entities/ItemPrototype.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Maps/Map.h"
+#include "Quests/QuestDef.h"
+#include "Server/DBCStores.h"
+#include "Server/WorldSession.h"
+#include "Spells/SpellAuras.h"
+#include "World/World.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+    char const* const PREFIX = "WNL";
+    char const* const SERVER_VERSION = "1";
+    char const* const SERVED = "Quests,Threat,Prices,Plates";
+
+    uint32 const HELLO_EVERY = 60000;   // re-greet, so a /reload'ed client reconnects
+    uint32 const THREAT_EVERY = 1000;
+    uint32 const DEBUFF_EVERY = 1000;
+    uint32 const DEBUFF_REFRESH = 5000; // resend an unchanged debuff set for drift
+    uint32 const PINS_EVERY = 5000;
+    size_t const MAX_PINS = 24;
+    float const PIN_RANGE = 500.0f;     // yards: spawns farther away are not pinned
+    size_t const THREAT_ROWS = 5;
+
+    struct State
+    {
+        std::mutex lock;                // the map thread's update and the world thread's command
+        bool greeted = false;           // the client answered ".wnl hi"
+        uint32 helloIn = 0;
+        uint32 threatIn = 0;
+        uint32 debuffIn = 0;
+        uint32 debuffAge = 0;
+        uint32 pinsIn = 0;
+        uint32 zone = 0;
+        uint32 seq = 0;
+        bool threatShown = false;
+        std::string lastDebuffs;
+        std::string lastPins;
+    };
+
+    std::mutex g_lock;
+    std::unordered_map<uint32, std::shared_ptr<State>> g_states; // by player guid counter
+
+    std::shared_ptr<State> StateOf(Player* player)
+    {
+        std::lock_guard<std::mutex> guard(g_lock);
+        auto& slot = g_states[player->GetGUIDLow()];
+        if (!slot)
+            slot = std::make_shared<State>();
+        return slot;
+    }
+
+    // ── SpellIcon.dbc: icon id → lowercased texture basename, as Visage keys its timers ──
+
+    std::once_flag g_iconsOnce;
+    std::unordered_map<uint32, std::string> g_icons;
+
+    void LoadIcons()
+    {
+        std::string path = sWorld.GetDataPath() + "dbc/SpellIcon.dbc";
+        std::ifstream f(path, std::ios::binary);
+        if (!f)
+        {
+            sLog.outError("WNL: %s not found; Visage gets no debuff timers", path.c_str());
+            return;
+        }
+        std::vector<char> buf((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+        if (buf.size() < 20 || std::string(buf.data(), 4) != "WDBC")
+            return;
+        auto u32 = [&](size_t at) { uint32 v; memcpy(&v, buf.data() + at, 4); return v; };
+        uint32 records = u32(4), fields = u32(8), recordSize = u32(12), stringSize = u32(16);
+        size_t strings = 20 + size_t(records) * recordSize;
+        if (fields < 2 || recordSize < 8 || strings + stringSize > buf.size())
+            return;
+        for (uint32 i = 0; i < records; ++i)
+        {
+            size_t rec = 20 + size_t(i) * recordSize;
+            uint32 id = u32(rec), off = u32(rec + 4);
+            if (off >= stringSize)
+                continue;
+            std::string name(buf.data() + strings + off);
+            size_t slash = name.find_last_of("\\/");
+            if (slash != std::string::npos)
+                name = name.substr(slash + 1);
+            std::transform(name.begin(), name.end(), name.begin(), ::tolower);
+            g_icons[id] = name;
+        }
+        sLog.outString("WNL: %u spell icons loaded", uint32(g_icons.size()));
+    }
+
+    std::string IconName(uint32 iconId)
+    {
+        std::call_once(g_iconsOnce, LoadIcons);
+        auto it = g_icons.find(iconId);
+        return it == g_icons.end() ? std::string() : it->second;
+    }
+
+    // ── Spawn index: entry → positions, built once from the loaded world data ──
+
+    struct Spot { uint32 map; float x; float y; };
+    std::once_flag g_spawnsOnce;
+    std::unordered_map<uint32, std::vector<Spot>> g_creatures;
+    std::unordered_map<uint32, std::vector<Spot>> g_objects;
+    std::unordered_map<uint32, std::vector<uint32>> g_enders;    // quest → ender creature entries
+    std::vector<std::pair<uint32, uint32>> g_starters;           // (creature entry, quest)
+
+    struct CreatureWorker
+    {
+        bool operator()(CreatureDataPair const& p)
+        {
+            g_creatures[p.second.id].push_back({ p.second.mapid, p.second.posX, p.second.posY });
+            return false;
+        }
+    };
+    struct ObjectWorker
+    {
+        bool operator()(GameObjectDataPair const& p)
+        {
+            g_objects[p.second.id].push_back({ p.second.mapid, p.second.posX, p.second.posY });
+            return false;
+        }
+    };
+
+    void LoadSpawns()
+    {
+        CreatureWorker cw;
+        sObjectMgr.DoCreatureData(cw);
+        ObjectWorker ow;
+        sObjectMgr.DoGOData(ow);
+        // Relations by entry; the reverse (quest → enders) is what turn-in pins need.
+        for (auto const& c : g_creatures)
+        {
+            QuestRelationsMapBounds b = sObjectMgr.GetCreatureQuestInvolvedRelationsMapBounds(c.first);
+            for (auto it = b.first; it != b.second; ++it)
+                g_enders[it->second].push_back(c.first);
+            QuestRelationsMapBounds s = sObjectMgr.GetCreatureQuestRelationsMapBounds(c.first);
+            for (auto it = s.first; it != s.second; ++it)
+                g_starters.emplace_back(c.first, it->second);
+        }
+        sLog.outString("WNL: spawn index ready (%u creature entries, %u object entries)",
+                       uint32(g_creatures.size()), uint32(g_objects.size()));
+    }
+
+    using WnlFormat::Clean;
+
+    // ── Transport ──
+
+    void SendLine(Player* player, std::string const& text)
+    {
+        WorldPacket data;
+        ChatHandler::BuildChatPacket(data, CHAT_MSG_PARTY, text.c_str(), LANG_ADDON, CHAT_TAG_NONE,
+                                     player->GetObjectGuid(), player->GetName());
+        player->GetSession()->SendPacket(data);
+    }
+
+    void Send(Player* player, State& st, char const* tag, std::string const& body)
+    {
+        for (std::string const& line : WnlFormat::Lines(tag, ++st.seq, body))
+            SendLine(player, line);
+    }
+
+    void Hello(Player* player)
+    {
+        std::ostringstream line;
+        line << PREFIX << '\t' << "HI " << SERVER_VERSION << ' ' << SERVED;
+        SendLine(player, line.str());
+    }
+
+    // ── VG: the target's threat table ──
+
+    void Threat(Player* player, State& st)
+    {
+        Unit* target = player->GetMap()->GetUnit(player->GetSelectionGuid());
+        Creature* creature = (target && target->GetTypeId() == TYPEID_UNIT) ? static_cast<Creature*>(target) : nullptr;
+        ThreatList const* list = nullptr;
+        if (creature && creature->IsAlive() && creature->IsInCombat())
+            list = &creature->getThreatManager().getThreatList();
+        if (!list || list->empty())
+        {
+            if (st.threatShown)
+            {
+                Send(player, st, "VG", "-");
+                st.threatShown = false;
+            }
+            return;
+        }
+        Unit* tank = creature->GetVictim();
+        float tankThreat = 0.0f;
+        std::vector<std::pair<float, Unit*>> rows;
+        for (HostileReference* ref : *list)
+        {
+            Unit* u = ref->getTarget();
+            if (!u)
+                continue;
+            rows.emplace_back(ref->getThreat(), u);
+            if (u == tank)
+                tankThreat = ref->getThreat();
+        }
+        if (tankThreat <= 0.0f && !rows.empty())
+            tankThreat = std::max_element(rows.begin(), rows.end(),
+                [](auto const& a, auto const& b) { return a.first < b.first; })->first;
+        if (tankThreat <= 0.0f)
+            tankThreat = 1.0f;
+        std::stable_sort(rows.begin(), rows.end(), [](auto const& a, auto const& b) { return a.first > b.first; });
+
+        bool onList = false;
+        uint32 rank = 0;
+        float mine = 0.0f;
+        for (size_t i = 0; i < rows.size(); ++i)
+            if (rows[i].second == player)
+            {
+                onList = true;
+                rank = uint32(i + 1);
+                mine = rows[i].first;
+            }
+        if (!onList)
+        {
+            if (st.threatShown)
+            {
+                Send(player, st, "VG", "-");
+                st.threatShown = false;
+            }
+            return;
+        }
+
+        std::ostringstream body;
+        body << Clean(creature->GetName());
+        for (size_t i = 0; i < rows.size() && i < THREAT_ROWS; ++i)
+            body << ';' << Clean(rows[i].second->GetName()) << ','
+                 << uint32(std::lround(rows[i].first * 100.0f / tankThreat)) << ','
+                 << (rows[i].second == tank ? 1 : 0);
+        uint32 pullAt = player->CanReachWithMeleeAttack(creature) ? 110 : 130;
+        body << ";S," << rank << ',' << uint32(std::lround(mine * 100.0f / tankThreat)) << ',' << pullAt;
+        Send(player, st, "VG", body.str());
+        st.threatShown = true;
+    }
+
+    // ── VS: the target's timed debuffs ──
+
+    void Debuffs(Player* player, State& st, uint32 diff)
+    {
+        Unit* target = player->GetMap()->GetUnit(player->GetSelectionGuid());
+        st.debuffAge += diff;
+        if (!target || !target->IsAlive() || target == player)
+        {
+            st.lastDebuffs.clear();
+            return;
+        }
+        std::ostringstream body, key;
+        body << Clean(target->GetName());
+        key << target->GetObjectGuid().GetRawValue();
+        bool any = false;
+        for (auto const& h : target->GetSpellAuraHolderMap())
+        {
+            SpellAuraHolder const* holder = h.second;
+            if (!holder || holder->IsPositive() || holder->GetAuraDuration() <= 0)
+                continue;
+            std::string icon = IconName(holder->GetSpellProto()->SpellIconID);
+            if (icon.empty())
+                continue;
+            body << ';' << icon << ',' << holder->GetAuraDuration();
+            key << ';' << icon << ',' << holder->GetAuraMaxDuration();
+            any = true;
+        }
+        if (!any)
+        {
+            st.lastDebuffs.clear();
+            return;
+        }
+        // Resend on a change in the set, or now and then so the client's countdown cannot drift.
+        if (key.str() == st.lastDebuffs && st.debuffAge < DEBUFF_REFRESH)
+            return;
+        st.lastDebuffs = key.str();
+        st.debuffAge = 0;
+        Send(player, st, "VS", body.str());
+    }
+
+    // ── CP: quest pins in the player's zone ──
+
+    struct Pin { float dist; std::string text; };
+
+    bool ToZone(uint32 zone, float wx, float wy, float& zx, float& zy)
+    {
+        float x = wx, y = wy;
+        if (!Map2ZoneCoordinates(x, y, zone))
+            return false;
+        zx = x / 100.0f;
+        zy = y / 100.0f;
+        return zx >= 0.0f && zx <= 1.0f && zy >= 0.0f && zy <= 1.0f;
+    }
+
+    void AddSpots(Player* player, uint32 zone, std::vector<Spot> const& spots, uint32 questId,
+                  char const* kind, std::string const& title, size_t keep, std::vector<Pin>& out)
+    {
+        std::vector<Pin> mine;
+        for (Spot const& s : spots)
+        {
+            if (s.map != player->GetMapId())
+                continue;
+            float dx = s.x - player->GetPositionX(), dy = s.y - player->GetPositionY();
+            float d = std::sqrt(dx * dx + dy * dy);
+            if (d > PIN_RANGE)
+                continue;
+            float zx, zy;
+            if (!ToZone(zone, s.x, s.y, zx, zy))
+                continue;
+            char text[160];
+            snprintf(text, sizeof(text), "%u,%.4f,%.4f,%s,%s", questId, zx, zy, kind, title.c_str());
+            mine.push_back({ d, text });
+        }
+        std::sort(mine.begin(), mine.end(), [](Pin const& a, Pin const& b) { return a.dist < b.dist; });
+        for (size_t i = 0; i < mine.size() && i < keep; ++i)
+            out.push_back(mine[i]);
+    }
+
+    void Pins(Player* player, State& st)
+    {
+        std::call_once(g_spawnsOnce, LoadSpawns);
+        uint32 zone = player->GetZoneId();
+        std::vector<Pin> pins;
+        for (uint16 slot = 0; slot < MAX_QUEST_LOG_SIZE; ++slot)
+        {
+            uint32 questId = player->GetQuestSlotQuestId(slot);
+            if (!questId)
+                continue;
+            Quest const* quest = sObjectMgr.GetQuestTemplate(questId);
+            if (!quest)
+                continue;
+            std::string title = Clean(quest->GetTitle()).substr(0, 48);
+            QuestStatus status = player->GetQuestStatus(questId);
+            if (status == QUEST_STATUS_COMPLETE)
+            {
+                auto it = g_enders.find(questId);
+                if (it != g_enders.end())
+                    for (uint32 entry : it->second)
+                        if (auto c = g_creatures.find(entry); c != g_creatures.end())
+                            AddSpots(player, zone, c->second, questId, "TURNIN", title, 1, pins);
+                continue;
+            }
+            if (status != QUEST_STATUS_INCOMPLETE)
+                continue;
+            auto const& sm = player->getQuestStatusMap();
+            auto qs = sm.find(questId);
+            for (int i = 0; i < QUEST_OBJECTIVES_COUNT; ++i)
+            {
+                int32 id = quest->ReqCreatureOrGOId[i];
+                if (!id || !quest->ReqCreatureOrGOCount[i])
+                    continue;
+                if (qs != sm.end() && qs->second.m_creatureOrGOcount[i] >= quest->ReqCreatureOrGOCount[i])
+                    continue;
+                auto const& index = id > 0 ? g_creatures : g_objects;
+                auto c = index.find(uint32(std::abs(id)));
+                if (c != index.end())
+                    AddSpots(player, zone, c->second, questId, "OBJ", title, 3, pins);
+            }
+        }
+        // Givers with a quest this player can take now.
+        for (auto const& sq : g_starters)
+        {
+            Quest const* quest = sObjectMgr.GetQuestTemplate(sq.second);
+            if (!quest || player->GetQuestStatus(sq.second) != QUEST_STATUS_NONE)
+                continue;
+            if (!player->CanTakeQuest(quest, false))
+                continue;
+            auto c = g_creatures.find(sq.first);
+            if (c != g_creatures.end())
+                AddSpots(player, zone, c->second, sq.second, "GIVER", Clean(quest->GetTitle()).substr(0, 48), 1, pins);
+        }
+        std::sort(pins.begin(), pins.end(), [](Pin const& a, Pin const& b) { return a.dist < b.dist; });
+        std::ostringstream body;
+        for (size_t i = 0; i < pins.size() && i < MAX_PINS; ++i)
+            body << (i ? ";" : "") << pins[i].text;
+        std::string b = body.str();
+        if (b == st.lastPins)
+            return;
+        st.lastPins = b;
+        Send(player, st, "CP", b);
+    }
+
+    // ── LG: the faction auction house's market for one item ──
+
+    void Prices(Player* player, State& st, uint32 itemId)
+    {
+        ItemPrototype const* proto = ObjectMgr::GetItemPrototype(itemId);
+        if (!proto)
+            return;
+        std::vector<uint32> perUnit;
+        AuctionHouseEntry const* house = AuctionHouseMgr::GetAuctionHouseEntry(player);
+        if (AuctionHouseObject* auctions = house ? sAuctionMgr.GetAuctionsMap(house) : nullptr)
+            for (auto const& a : auctions->GetAuctions())
+                if (a.second && a.second->itemTemplate == itemId && a.second->buyout && a.second->itemCount)
+                    perUnit.push_back(a.second->buyout / a.second->itemCount);
+        uint32 median = 0;
+        if (!perUnit.empty())
+        {
+            std::sort(perUnit.begin(), perUnit.end());
+            median = perUnit[perUnit.size() / 2];
+        }
+        std::ostringstream body;
+        body << itemId << ',' << median << ',' << proto->SellPrice << ',' << perUnit.size();
+        Send(player, st, "LG", body.str());
+    }
+}
+
+namespace Wnl
+{
+    void Update(Player* player, uint32 diff)
+    {
+        if (!player || !player->GetSession())
+            return;
+        std::shared_ptr<State> held = StateOf(player);
+        State& st = *held;
+        std::lock_guard<std::mutex> guard(st.lock);
+
+        if (st.helloIn <= diff)
+        {
+            Hello(player);
+            st.helloIn = HELLO_EVERY;
+        }
+        else
+            st.helloIn -= diff;
+        if (!st.greeted)
+            return; // a client without the suite gets the greeting only
+
+        if (st.threatIn <= diff)
+        {
+            Threat(player, st);
+            st.threatIn = THREAT_EVERY;
+        }
+        else
+            st.threatIn -= diff;
+
+        if (st.debuffIn <= diff)
+        {
+            Debuffs(player, st, DEBUFF_EVERY);
+            st.debuffIn = DEBUFF_EVERY;
+        }
+        else
+            st.debuffIn -= diff;
+
+        uint32 zone = player->GetZoneId();
+        if (zone != st.zone)
+        {
+            st.zone = zone;
+            st.lastPins.clear(); // the client clears its pins on a zone change
+            st.pinsIn = 0;
+        }
+        if (st.pinsIn <= diff)
+        {
+            Pins(player, st);
+            st.pinsIn = PINS_EVERY;
+        }
+        else
+            st.pinsIn -= diff;
+    }
+
+    void HandleCommand(Player* player, char const* args)
+    {
+        if (!player || !args)
+            return;
+        std::istringstream in(args);
+        std::string cmd;
+        in >> cmd;
+        std::transform(cmd.begin(), cmd.end(), cmd.begin(), ::tolower);
+        std::shared_ptr<State> held = StateOf(player);
+        State& st = *held;
+        std::lock_guard<std::mutex> guard(st.lock);
+        if (cmd == "hi")
+        {
+            st.greeted = true;
+            st.lastPins.clear();
+            st.lastDebuffs.clear();
+            st.pinsIn = 0;
+        }
+        else if (cmd == "lg" && st.greeted)
+        {
+            uint32 itemId = 0;
+            if (in >> itemId)
+                Prices(player, st, itemId);
+        }
+        // "sc" (Scrapper) and "ch" (Chronicle) are not served yet; they are ignored silently.
+    }
+
+    void Forget(ObjectGuid const& guid)
+    {
+        std::lock_guard<std::mutex> guard(g_lock);
+        g_states.erase(guid.GetCounter());
+    }
+}
+
+// ".wnl <cmd> <args>": always handled and never answered in chat, so a stray line is invisible.
+bool ChatHandler::HandleWnlCommand(char* args)
+{
+    if (WorldSession* session = GetSession())
+        Wnl::HandleCommand(session->GetPlayer(), args ? args : "");
+    return true;
+}
diff --git a/src/game/OpenVanilla/Wnl.h b/src/game/OpenVanilla/Wnl.h
new file mode 100644
index 000000000..75a9a16c0
--- /dev/null
+++ b/src/game/OpenVanilla/Wnl.h
@@ -0,0 +1,34 @@
+/*
+ * Open Vanilla — the WNL server hook (GPLv2, as CMaNGOS).
+ *
+ * Feeds the Classic+ addon suite the data a 1.12 client cannot see on its own:
+ *   CP  Compass quest pins       "<questId>,<x>,<y>,<OBJ|GIVER|TURNIN>[,<title>];..."  (0..1 zone)
+ *   VG  Vanguard threat          "<target>;<name>,<pct>,<isTank>;...;S,<rank>,<pct>,<pullAt>" | "-"
+ *   LG  Ledger market prices     "<itemId>,<median>,<vendor>,<samples>"   (answer to ".wnl lg <id>")
+ *   VS  Visage debuff timers     "<unitName>;<iconName>,<remainingMs>;..."
+ *
+ * Every line goes to the player alone as an addon message (LANG_ADDON, from the player's own
+ * guid, prefix "WNL"): a client without the suite never renders it. Bodies are always sent in
+ * the chunked form "<seq> <i>/<n> <part>", which WenillaCore reassembles. The server greets with
+ * "HI <version> <addons>" and streams to a client only once it has answered ".wnl hi <version>".
+ */
+
+#ifndef OPENVANILLA_WNL_H
+#define OPENVANILLA_WNL_H
+
+#include "Common.h"
+
+class Player;
+class ObjectGuid;
+
+namespace Wnl
+{
+    // Called from Player::Update (the player's map thread).
+    void Update(Player* player, uint32 diff);
+    // Called from ChatHandler::HandleWnlCommand (the world thread): ".wnl <cmd> <args>".
+    void HandleCommand(Player* player, char const* args);
+    // Called at logout.
+    void Forget(ObjectGuid const& guid);
+}
+
+#endif
diff --git a/src/game/OpenVanilla/WnlFormat.h b/src/game/OpenVanilla/WnlFormat.h
new file mode 100644
index 000000000..011efc6ec
--- /dev/null
+++ b/src/game/OpenVanilla/WnlFormat.h
@@ -0,0 +1,43 @@
+/*
+ * Open Vanilla — WNL line formatting, kept free of game headers so it can be tested on its own.
+ */
+
+#ifndef OPENVANILLA_WNL_FORMAT_H
+#define OPENVANILLA_WNL_FORMAT_H
+
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace WnlFormat
+{
+    // Bytes of body per addon line: well under the 255 a 1.12 chat line carries.
+    constexpr size_t CHUNK = 200;
+
+    // "WNL\t<TAG> <seq> <i>/<n> <part>" per line; an empty body is one empty part, which the
+    // client reads as "clear".
+    inline std::vector<std::string> Lines(char const* tag, unsigned seq, std::string const& body)
+    {
+        std::vector<std::string> out;
+        size_t n = body.empty() ? 1 : (body.size() + CHUNK - 1) / CHUNK;
+        for (size_t i = 0; i < n; ++i)
+        {
+            std::ostringstream line;
+            line << "WNL\t" << tag << ' ' << seq << ' ' << (i + 1) << '/' << n << ' '
+                 << body.substr(i * CHUNK, CHUNK);
+            out.push_back(line.str());
+        }
+        return out;
+    }
+
+    // A name or title made safe for the record separators the addons split on.
+    inline std::string Clean(std::string s)
+    {
+        for (char& c : s)
+            if (c == ',' || c == ';' || c == '\t' || c == '\n' || c == '|')
+                c = ' ';
+        return s;
+    }
+}
+
+#endif
