+/*
+ * Open Vanilla — achievements (GPLv2, as CMaNGOS).
+ *
+ * Server-authoritative achievements: the realm decides what a character has earned and tells the
+ * Achievements addon over the WNL channel (tag "AC"; realm/achievements/PROTOCOL.md). A client
+ * can't grant itself anything. Points and recognition only, never power: nothing here touches
+ * items, stats, spells or gold.
+ *
+ * Catalogue: world tables openvanilla_achievement + openvanilla_achievement_criteria (generated from
+ * realm/achievements/achievements.yml by tools/gen_achievements.py). Per character:
+ * character_achievement (guid, achievement, date) and character_achievement_progress
+ * (guid, criteria, counter); realm firsts once in openvanilla_realm_first. Until that SQL is
+ * installed the catalogue is empty and every hook returns at once.
+ *
+ * The hooks run on the player's map thread; the ".wnl ac" commands on the world thread. Each
+ * character's state has its own lock, taken before the WNL lock (Wnl::Push) and never after it.
+ */
+
+#ifndef OPENVANILLA_ACHIEVEMENTS_H
+#define OPENVANILLA_ACHIEVEMENTS_H
+
+#include "Common.h"
+
+#include <string>
+
+class Map;
+class ObjectGuid;
+class Player;
+class Quest;
+struct FactionEntry;
+
+namespace Achievements
+{
+    // Player::Update (through Wnl::Update), outside the WNL lock: loads the character's
+    // achievements once (granting what was already done before launch), tracks the dungeon the
+    // player is in (for "without dying" / "within N minutes"), polls gold, bags, pets, items and
+    // PvP rank every few seconds, sends the full list after the client greets, and announces
+    // realm firsts claimed by others.
+    void Update(Player* player, uint32 diff);
+
+    void OnLevelUp(Player* player, uint32 level);                     // Player::GiveLevel
+    void OnQuestRewarded(Player* player, Quest const* quest);         // Player::RewardQuest
+    void OnCreatureKill(Player* player, uint32 entry);                // Player::KilledMonster (group credit included)
