diff --git a/src/game/OpenVanilla/AutoLearn.cpp b/src/game/OpenVanilla/AutoLearn.cpp
new file mode 100644
index 0000000..eeb1b76
--- /dev/null
+++ b/src/game/OpenVanilla/AutoLearn.cpp
@@ -0,0 +1,175 @@
+/*
+ * Open Vanilla — skills learned on level-up, no trainer visit (GPLv2, as CMaNGOS).
+ *
+ * At every level gained, at login (catch-up) and when a talent is learned, the player learns
+ * every spell or rank their class trainers would offer them right now: the same rules as the
+ * trainer window (Player::GetTrainerSpellState: level, previous rank, required ability or
+ * talent, race/class fit, trainer conditions), so talent-gated ranks come only with the talent.
+ * Lists: class trainers of the class, the hunter pet trainers (hunters only) and the weapon
+ * skills weapon masters teach. Professions, riding and quest rewards are never touched.
+ * What was learned goes to the client as  LL <spell name (Rank n)>;...
+ */
+
+#include "OpenVanilla/Play.h"
+#include "OpenVanilla/PlayState.h"
+
+#include "Entities/Creature.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Log/Log.h"
+#include "Server/SQLStorages.h"
+#include "Spells/SpellMgr.h"
+
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace OwPlay
+{
+    namespace
+    {
+        // Trainer spells by class (index = class id); [0] = weapon skills for every class.
+        std::once_flag g_once;
+        std::vector<TrainerSpell> g_lists[MAX_CLASSES];
+
+        bool TeachesWeaponSkill(uint32 spellId)
+        {
+            SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(spellId);
+            if (!info)
+                return false;
+            for (int i = 0; i < MAX_EFFECT_INDEX; ++i)
+                if (info->Effect[i] == SPELL_EFFECT_WEAPON)
+                    return true;
+            return false;
+        }
+
+        void Add(std::unordered_map<uint32, TrainerSpell>& into, TrainerSpellData const* data)
+        {
+            if (!data)
+                return;
+            for (auto const& it : data->spellList)
+            {
+                TrainerSpell const& ts = it.second;
+                if (!ts.learnedSpell || SpellMgr::IsProfessionSpell(ts.learnedSpell))
+                    continue;
+                auto found = into.find(ts.learnedSpell);
+                // the same spell at several trainers: the earliest level wins
+                if (found == into.end() || ts.reqLevel < found->second.reqLevel)
+                    into[ts.learnedSpell] = ts;
+            }
+        }
+
+        void Build()
+        {
+            std::unordered_map<uint32, TrainerSpell> byClass[MAX_CLASSES];
+            std::unordered_map<uint32, TrainerSpell> weapons;
+            for (uint32 i = 1; i < sCreatureStorage.GetMaxEntry(); ++i)
+            {
+                CreatureInfo const* info = sCreatureStorage.LookupEntry<CreatureInfo>(i);
+                if (!info || !(info->NpcFlags & UNIT_NPC_FLAG_TRAINER))
+                    continue;
+                TrainerSpellData const* own = sObjectMgr.GetNpcTrainerSpells(i);
+                TrainerSpellData const* tmpl = info->TrainerTemplateId ? sObjectMgr.GetNpcTrainerTemplateSpells(info->TrainerTemplateId) : nullptr;
+                if (info->TrainerType == TRAINER_TYPE_CLASS && info->TrainerClass > 0 && info->TrainerClass < MAX_CLASSES)
+                {
+                    Add(byClass[info->TrainerClass], own);
+                    Add(byClass[info->TrainerClass], tmpl);
+                }
+                else if (info->TrainerType == TRAINER_TYPE_PETS)
+                {
+                    Add(byClass[CLASS_HUNTER], own);
+                    Add(byClass[CLASS_HUNTER], tmpl);
+                }
+                else if (info->TrainerType != TRAINER_TYPE_MOUNTS)
+                {
+                    // weapon masters: only their weapon skills
+                    std::unordered_map<uint32, TrainerSpell> any;
+                    Add(any, own);
+                    Add(any, tmpl);
+                    for (auto const& w : any)
+                        if (TeachesWeaponSkill(w.first))
+                            if (!weapons.count(w.first) || w.second.reqLevel < weapons[w.first].reqLevel)
+                                weapons[w.first] = w.second;
+                }
+            }
+            for (uint32 c = 0; c < MAX_CLASSES; ++c)
+            {
+                auto const& src = c ? byClass[c] : weapons;
+                for (auto const& s : src)
+                    g_lists[c].push_back(s.second);
+                // lower levels first, so a chain of ranks is learned in one pass where it can be
+                std::sort(g_lists[c].begin(), g_lists[c].end(), [](TrainerSpell const& a, TrainerSpell const& b)
+                {
+                    return a.reqLevel != b.reqLevel ? a.reqLevel < b.reqLevel : a.learnedSpell < b.learnedSpell;
+                });
+            }
+            uint32 total = 0;
+            for (auto const& l : g_lists)
+                total += uint32(l.size());
+            sLog.outString("OpenVanilla: %u trainer spells indexed for learning on level-up", total);
+        }
+
+        bool TryLearn(Player* player, TrainerSpell const& ts)
+        {
+            if (player->HasSpell(ts.learnedSpell) || StarterPet::IsLockedSpell(ts.learnedSpell))
+                return false;
+            uint32 reqLevel = 0;
+            if (!player->IsSpellFitByClassAndRace(ts.learnedSpell, &reqLevel))
+                return false;
+            if (ts.conditionId && !sObjectMgr.IsConditionSatisfied(ts.conditionId, player, player->GetMap(), player, CONDITION_FROM_TRAINER))
+                return false;
+            reqLevel = ts.isProvidedReqLevel ? ts.reqLevel : std::max(reqLevel, ts.reqLevel);
+            if (player->GetTrainerSpellState(&ts, reqLevel) != TRAINER_SPELL_GREEN)
+                return false;
+            player->learnSpell(ts.learnedSpell, false);
+            return player->HasSpell(ts.learnedSpell);
+        }
+
+        std::string NameOf(uint32 spellId)
+        {
+            SpellEntry const* info = sSpellTemplate.LookupEntry<SpellEntry>(spellId);
+            if (!info || !info->SpellName[0])
+                return std::string();
+            std::string name = info->SpellName[0];
+            if (info->Rank[0] && *info->Rank[0])
+                name += std::string(" (") + info->Rank[0] + ")";
+            return CleanText(name);
+        }
+    }
+
+    namespace AutoLearn
+    {
+        void Run(Player* player, bool announce)
+        {
+            if (!Config().autoLearn || !player || player->getClass() >= MAX_CLASSES)
+                return;
+            std::call_once(g_once, Build);
+            std::vector<uint32> learned;
+            // Learning a rank can open the next one at the same level: repeat until nothing new.
+            for (int pass = 0; pass < 8; ++pass)
+            {
+                size_t before = learned.size();
+                for (std::vector<TrainerSpell> const* list : { &g_lists[player->getClass()], &g_lists[0] })
+                    for (TrainerSpell const& ts : *list)
+                        if (TryLearn(player, ts))
+                            learned.push_back(ts.learnedSpell);
+                if (learned.size() == before)
+                    break;
+            }
+            if (!announce || learned.empty())
+                return;
+            std::string body;
+            for (uint32 id : learned)
+            {
+                std::string name = NameOf(id);
+                if (name.empty())
+                    continue;
+                if (!body.empty())
+                    body += ';';
+                body += name;
+            }
+            if (!body.empty())
+                Send(player, "LL", body);
+        }
+    }
+}
diff --git a/src/game/OpenVanilla/DualSpec.cpp b/src/game/OpenVanilla/DualSpec.cpp
new file mode 100644
index 0000000..766849e
--- /dev/null
+++ b/src/game/OpenVanilla/DualSpec.cpp
@@ -0,0 +1,382 @@
+/*
+ * Open Vanilla — dual talent specialization (GPLv2, as CMaNGOS).
+ *
+ * From level 10 a player has two specs, each with its own talents and action bars. The active
+ * spec is simply the character's live talents and bars; the other one waits in the characters
+ * database (openvanilla_spec, openvanilla_spec_action). Switching is a 5 second cast out of combat
+ * (Divining Trance's cast bar, which does nothing else); moving, combat or any interrupt cancels it.
+ *   .wnl spec <1|2>            switch          .wnl specname <1|2> <name>      rename
+ *   .wnl specs                 ask for the state
+ *   SP <active>,<count>;<name1>;<name2>        sent on login, level 10, switch, rename and ask
+ */
+
+#include "OpenVanilla/Play.h"
+#include "OpenVanilla/PlayState.h"
+
+#include "Chat/Chat.h"
+#include "Database/DatabaseEnv.h"
+#include "Entities/Pet.h"
+#include "Entities/Player.h"
+#include "Log/Log.h"
+#include "Maps/Map.h"
+#include "Server/DBCStores.h"
+#include "Spells/Spell.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <sstream>
+#include <tuple>
+
+namespace OwPlay
+{
+    namespace
+    {
+        uint32 const SWITCH_SPELL = 5017;   // Divining Trance: 5 s cast, a dummy effect nothing handles
+        uint32 const SWITCH_TIME = 5000;
+        uint32 const MIN_LEVEL = 10;
+
+        bool g_tablesChecked = false;
+        bool g_tablesOk = false;
+
+        bool TablesOk()
+        {
+            if (!g_tablesChecked)
+            {
+                g_tablesChecked = true;
+                if (auto r = CharacterDatabase.Query("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name IN ('openvanilla_character','openvanilla_spec','openvanilla_spec_action')"))
+                    g_tablesOk = r->Fetch()[0].GetUInt32() == 3;
+                if (!g_tablesOk)
+                    sLog.outError("OpenVanilla: characters tables openvanilla_character/openvanilla_spec/openvanilla_spec_action missing; dual spec and the starter pet are off (run classicplus_characters.sql)");
+            }
+            return g_tablesOk;
+        }
+
+        uint32 SpecCount(Player* player)
+        {
+            return (Config().dualSpec && TablesOk() && player->GetLevel() >= MIN_LEVEL) ? 2 : 1;
+        }
+
+        void Say(Player* player, char const* text)
+        {
+            ChatHandler(player).SendSysMessage(text);
+        }
+
+        struct Known { uint32 row; uint32 talent; uint32 rank; };
+
+        std::vector<Known> KnownTalents(Player* player)
+        {
+            std::vector<Known> out;
+            for (uint32 i = 0; i < sTalentStore.GetNumRows(); ++i)
+            {
+                TalentEntry const* t = sTalentStore.LookupEntry(i);
+                if (!t)
+                    continue;
+                TalentTabEntry const* tab = sTalentTabStore.LookupEntry(t->TalentTab);
+                if (!tab || !(player->getClassMask() & tab->ClassMask))
+                    continue;
+                for (int r = MAX_TALENT_RANK - 1; r >= 0; --r)
+                    if (t->RankID[r] && player->HasSpell(t->RankID[r]))
+                    {
+                        out.push_back({ t->Row, t->TalentID, uint32(r) });
+                        break;
+                    }
+            }
+            std::sort(out.begin(), out.end(), [](Known const& a, Known const& b)
+            {
+                return std::tie(a.row, a.talent) < std::tie(b.row, b.talent);
+            });
+            return out;
+        }
+
+        struct SwitchCtx { std::vector<std::pair<uint32, uint32>> talents; };
+
+        void ApplyTalents(Player* player, void* raw)
+        {
+            SwitchCtx* ctx = static_cast<SwitchCtx*>(raw);
+            player->resetTalents(true);
+            // Tree rows in order, so every tier's points are spent before the next tier is learned.
+            for (auto const& t : ctx->talents)
+                player->LearnTalent(t.first, t.second);
+        }
+
+        void SaveRow(Player* player, State& st)
+        {
+            CharacterDatabase.PExecute("INSERT INTO openvanilla_character (guid, active_spec, starter_pet) VALUES (%u, %u, %u) "
+                                       "ON DUPLICATE KEY UPDATE active_spec = VALUES(active_spec)",
+                                       player->GetGUIDLow(), uint32(st.activeSpec), uint32(st.starterGiven));
+        }
+
+        void Switch(Player* player, State& st, uint8 to)
+        {
+            uint8 from = st.activeSpec;
+            uint32 guid = player->GetGUIDLow();
+
+            // 1. The spec we leave: its talents and bars.
+            std::string talents = Spec::SerializeTalents(player);
+            std::string name = st.specName[from - 1];
+            CharacterDatabase.escape_string(name);
+            std::ostringstream bars;
+            for (auto const& b : player->GetActionButtons())
+            {
+                if (b.second.uState == ACTIONBUTTON_DELETED)
+                    continue;
+                bars << (bars.tellp() ? "," : "") << '(' << guid << ',' << uint32(from) << ',' << uint32(b.first) << ','
+                     << b.second.GetAction() << ',' << uint32(b.second.GetType()) << ')';
+            }
+
+            // 2. The spec we go to (still in the database).
+            SwitchCtx ctx;
+            bool storedBars = false;
+            std::vector<std::tuple<uint8, uint32, uint8>> newBars;
+            if (auto r = CharacterDatabase.PQuery("SELECT talents FROM openvanilla_spec WHERE guid = %u AND spec = %u", guid, uint32(to)))
+            {
+                std::istringstream in(r->Fetch()[0].GetCppString());
+                std::string item;
+                while (std::getline(in, item, ','))
+                {
+                    size_t colon = item.find(':');
+                    if (colon == std::string::npos)
+                        continue;
+                    ctx.talents.emplace_back(uint32(std::strtoul(item.c_str(), nullptr, 10)),
+                                             uint32(std::strtoul(item.c_str() + colon + 1, nullptr, 10)));
+                }
+            }
+            if (auto r = CharacterDatabase.PQuery("SELECT button, action, type FROM openvanilla_spec_action WHERE guid = %u AND spec = %u", guid, uint32(to)))
+            {
+                storedBars = true;
+                do
+                {
+                    Field* f = r->Fetch();
+                    newBars.emplace_back(f[0].GetUInt8(), f[1].GetUInt32(), f[2].GetUInt8());
+                }
+                while (r->NextRow());
+            }
+            // Keep tree-row order (the string was written that way; re-sort to be safe).
+            std::stable_sort(ctx.talents.begin(), ctx.talents.end(), [](auto const& a, auto const& b)
+            {
+                TalentEntry const* ta = sTalentStore.LookupEntry(a.first);
+                TalentEntry const* tb = sTalentStore.LookupEntry(b.first);
+                return (ta ? ta->Row : 0) < (tb ? tb->Row : 0);
+            });
+
+            CharacterDatabase.BeginTransaction();
+            CharacterDatabase.PExecute("INSERT INTO openvanilla_spec (guid, spec, name, talents) VALUES (%u, %u, '%s', '%s') "
+                                       "ON DUPLICATE KEY UPDATE talents = VALUES(talents)", guid, uint32(from), name.c_str(), talents.c_str());
+            CharacterDatabase.PExecute("DELETE FROM openvanilla_spec_action WHERE guid = %u AND spec = %u", guid, uint32(from));
+            if (bars.tellp())
+                CharacterDatabase.PExecute("INSERT INTO openvanilla_spec_action (guid, spec, button, action, type) VALUES %s", bars.str().c_str());
+            CharacterDatabase.CommitTransaction();
+
+            // 3. Swap talents (a hunter keeps the pet), then bars. A spec never used keeps the
+            //    current bars as its start.
+            Spec::KeepHunterPet(player, ApplyTalents, &ctx);
+            if (storedBars)
+            {
+                std::vector<uint8> old;
+                for (auto const& b : player->GetActionButtons())
+                    if (b.second.uState != ACTIONBUTTON_DELETED)
+                        old.push_back(b.first);
+                for (uint8 button : old)
+                    player->removeActionButton(button);
+                for (auto const& b : newBars)
+                    if (Player::IsActionButtonDataValid(std::get<0>(b), std::get<1>(b), std::get<2>(b), player))
+                        player->addActionButton(std::get<0>(b), std::get<1>(b), std::get<2>(b));
+                player->SendInitialActionButtons();
+            }
+            if (Pet* pet = player->GetPet())
+                pet->CastOwnerTalentAuras();
+
+            st.activeSpec = to;
+            SaveRow(player, st);
+            Spec::SendState(player, st);
+            std::string text = "You are now using " + st.specName[to - 1] + ".";
+            Say(player, text.c_str());
+        }
+
+        void Cancel(Player* player, State& st, char const* why)
+        {
+            st.switchTo = 0;
+            if (Spell* spell = player->GetCurrentSpell(CURRENT_GENERIC_SPELL))
+                if (spell->m_spellInfo->Id == SWITCH_SPELL)
+                    player->InterruptSpell(CURRENT_GENERIC_SPELL);
+            if (why)
+                Say(player, why);
+            Spec::SendState(player, st);
+        }
+    }
+
+    namespace Spec
+    {
+        uint32 SpentTalentPoints(Player* player)
+        {
+            uint32 spent = 0;
+            for (Known const& k : KnownTalents(player))
+                spent += k.rank + 1;
+            return spent;
+        }
+
+        std::string SerializeTalents(Player* player)
+        {
+            std::ostringstream out;
+            for (Known const& k : KnownTalents(player))
+                out << (out.tellp() ? "," : "") << k.talent << ':' << k.rank;
+            return out.str();
+        }
+
+        void KeepHunterPet(Player* player, void (*fn)(Player*, void*), void* ctx)
+        {
+            // resetTalents dismisses the pet out of its slot; a hunter's pet is put away as the
+            // current pet instead and called back afterwards.
+            bool recall = false;
+            if (player->getClass() == CLASS_HUNTER)
+                if (Pet* pet = player->GetPet())
+                    if (pet->getPetType() == HUNTER_PET && pet->IsAlive())
+                    {
+                        pet->Unsummon(PET_SAVE_AS_CURRENT, player);
+                        recall = true;
+                    }
+            fn(player, ctx);
+            if (recall && !player->GetPet())
+                player->CastSpell(player, 883, TRIGGERED_OLD_TRIGGERED);    // Call Pet
+        }
+
+        void SendState(Player* player, State& st)
+        {
+            uint32 count = SpecCount(player);
+            st.lastSpecCount = int(count);
+            std::ostringstream body;
+            body << uint32(st.activeSpec) << ',' << count << ';' << st.specName[0] << ';' << st.specName[1];
+            Send(player, "SP", body.str());
+        }
+
+        void Load(Player* player, State& st)
+        {
+            if (!TablesOk())
+                return;
+            st.dbOk = true;
+            uint32 guid = player->GetGUIDLow();
+            if (auto r = CharacterDatabase.PQuery("SELECT active_spec, starter_pet FROM openvanilla_character WHERE guid = %u", guid))
+            {
+                Field* f = r->Fetch();
+                st.activeSpec = f[0].GetUInt8() == 2 ? 2 : 1;
+                st.starterGiven = f[1].GetUInt8() != 0;
+            }
+            if (auto r = CharacterDatabase.PQuery("SELECT spec, name FROM openvanilla_spec WHERE guid = %u", guid))
+            {
+                do
+                {
+                    Field* f = r->Fetch();
+                    uint32 spec = f[0].GetUInt32();
+                    std::string name = f[1].GetCppString();
+                    if ((spec == 1 || spec == 2) && !name.empty())
+                        st.specName[spec - 1] = name;
+                }
+                while (r->NextRow());
+            }
+        }
+
+        void Command(Player* player, State& st, std::string const& cmd, std::string const& args)
+        {
+            if (cmd == "specs")
+            {
+                SendState(player, st);
+                return;
+            }
+            if (!Config().dualSpec || !st.dbOk)
+            {
+                SendState(player, st);
+                return;
+            }
+            int which = std::atoi(args.c_str());
+            if (which != 1 && which != 2)
+                return;
+            if (cmd == "specname")
+            {
+                size_t space = args.find(' ');
+                std::string name = space == std::string::npos ? std::string() : args.substr(space + 1);
+                name = CleanText(name);
+                size_t a = name.find_first_not_of(' '), b = name.find_last_not_of(' ');
+                name = a == std::string::npos ? std::string() : name.substr(a, b - a + 1);
+                if (name.size() > 24)
+                    name = name.substr(0, 24);
+                if (name.empty())
+                    name = which == 1 ? "Spec 1" : "Spec 2";
+                st.specName[which - 1] = name;
+                std::string esc = name;
+                CharacterDatabase.escape_string(esc);
+                CharacterDatabase.PExecute("INSERT INTO openvanilla_spec (guid, spec, name, talents) VALUES (%u, %u, '%s', '') "
+                                           "ON DUPLICATE KEY UPDATE name = VALUES(name)", player->GetGUIDLow(), uint32(which), esc.c_str());
+                SendState(player, st);
+                return;
+            }
+            // cmd == "spec"
+            char const* err = nullptr;
+            if (SpecCount(player) < 2)
+                err = "Your second specialization opens at level 10.";
+            else if (which == st.activeSpec)
+                err = nullptr;
+            else if (st.switchTo)
+                err = "You are already changing specialization.";
+            else if (!player->IsAlive())
+                err = "You can't change specialization while dead.";
+            else if (player->IsInCombat())
+                err = "You can't change specialization in combat.";
+            if (err || which == st.activeSpec)
+            {
+                if (err)
+                    Say(player, err);
+                SendState(player, st);
+                return;
+            }
+            SpellCastResult res = player->CastSpell(player, SWITCH_SPELL, TRIGGERED_NONE);
+            if (res != SPELL_CAST_OK)
+            {
+                Say(player, "You can't change specialization right now.");
+                SendState(player, st);
+                return;
+            }
+            st.switchTo = uint8(which);
+            st.switchElapsed = 0;
+            st.switchCastSeen = false;
+            st.switchX = player->GetPositionX();
+            st.switchY = player->GetPositionY();
+        }
+
+        void Update(Player* player, State& st, uint32 diff)
+        {
+            // Reaching level 10 (or a client that asked again): the second spec appears.
+            if (st.lastSpecCount != int(SpecCount(player)))
+                SendState(player, st);
+            if (!st.switchTo)
+                return;
+            st.switchElapsed += diff;
+            Spell* spell = player->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+            bool casting = spell && spell->m_spellInfo->Id == SWITCH_SPELL;
+            if (casting)
+                st.switchCastSeen = true;
+            float dx = player->GetPositionX() - st.switchX, dy = player->GetPositionY() - st.switchY;
+            if (player->IsInCombat() || !player->IsAlive())
+            {
+                Cancel(player, st, "Specialization change interrupted.");
+                return;
+            }
+            if (dx * dx + dy * dy > 1.0f)
+            {
+                Cancel(player, st, "Specialization change cancelled: you moved.");
+                return;
+            }
+            if (casting)
+                return;
+            // The cast is over: done if it ran its course, else it was interrupted.
+            if (st.switchElapsed + 150 >= SWITCH_TIME)
+            {
+                uint8 to = st.switchTo;
+                st.switchTo = 0;
+                Switch(player, st, to);
+            }
+            else
+                Cancel(player, st, "Specialization change interrupted.");
+        }
+    }
+}
