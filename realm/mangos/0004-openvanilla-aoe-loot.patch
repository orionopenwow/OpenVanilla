+// AoE looting (OpenVanilla/AoeLoot.cpp). A friend of Loot: the merged slots live in the opened loot.
+struct OwAoeLoot
+{
+    // WorldSession::HandleLootOpcode, before the window is shown.
+    static void Merge(Player* player, Loot* loot);
+    // ...and once it is shown: the AL line telling the client where each slot comes from.
+    static void AfterShow(Player* player, Loot* loot);
+    // WorldSession::HandleAutostoreLootItemOpcode: true when `slot` was a gathered slot (handled).
+    static bool Take(Player* player, Loot* loot, uint32 slot);
+    // Loot::SendGold, before paying: the gathered coins leave their own corpses.
+    static void OnGold(Loot* loot);
+    // Loot::Release: give the window back its own items only.
+    static void Unmerge(Loot* loot);
+};
+
 #endif
