 #include "Loot/LootMgr.h"
+#include "OpenVanilla/StarPouch.h"
 #include "Log/Log.h"
 #include "Util/ProgressBar.h"
 #include "World/World.h"
@@ -1372,11 +1373,28 @@ void Loot::Release(Player* player)
                 // normal persistence loot
                 default:
                 {
+                    // OpenVanilla: a Star Pouch is spent once opened. Whatever is left in it (gold,
+                    // items) goes straight to the bags when the window closes; it only stays when
+                    // the bags could not take everything, so nothing is lost.
+                    bool pouch = StarPouch::IsPouch(m_itemTarget->GetEntry());
+                    if (pouch && !IsLootedFor(player))
+                    {
+                        if (m_gold)
+                            SendGold(player);
+                        AutoStore(player);
+                    }
                     // must be destroyed only if no loot
                     if (IsLootedFor(player))
                     {
                         m_itemTarget->SetLootState(ITEM_LOOT_REMOVED);
-                        player->DestroyItem(m_itemTarget->GetBagSlot(), m_itemTarget->GetSlot(), true);
+                        if (pouch && m_itemTarget->GetCount() > 1)
+                        {
+                            // a stack from before pouches stopped stacking: spend just this one
+                            uint32 one = 1;
+                            player->DestroyItemCount(*m_itemTarget, one, true);
+                        }
+                        else
+                            player->DestroyItem(m_itemTarget->GetBagSlot(), m_itemTarget->GetSlot(), true);
                     }
                     break;
                 }
