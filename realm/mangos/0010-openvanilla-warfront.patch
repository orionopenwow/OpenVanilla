+    // ── shared gear sets (characters database) ──
+
+    namespace
+    {
+        std::string SetItemsText(std::vector<std::pair<uint32, uint32>> const& v)
+        {
+            std::ostringstream o;
+            for (size_t i = 0; i < v.size(); ++i)
+                o << (i ? "," : "") << v[i].first << ':' << v[i].second;
+            return o.str();
+        }
+
+        void Share(Player* p, State& st, std::string const& args)
+        {
+            // <spec>~<name>~<slot>:<item>,...   ('|' can't be sent: the 1.12 client refuses it in chat)
+            size_t a = args.find('~'), b = a == std::string::npos ? a : args.find('~', a + 1);
+            if (b == std::string::npos)
+                return Reply(p, "WH", Err("name"));
+            std::string spec = CleanSetName(args.substr(0, a)), name = CleanSetName(args.substr(a + 1, b - a - 1));
+            std::vector<std::pair<uint32, uint32>> items;
+            if (spec.empty() || name.empty())
+                return Reply(p, "WH", Err("name"));
+            if (!ParseSlotItems(args.substr(b + 1), items))
+                return Reply(p, "WH", Err("item"));
+            for (auto const& si : items)
+            {
+                ItemPrototype const* proto = sObjectMgr.GetItemPrototype(si.second);
+                if (!proto || PoolTier(si.second) < 0 || !UsableBy(p, proto) || !FitsSlot(proto, uint8(si.first), true))
+                    return Reply(p, "WH", Err("item"));
+            }
+            if (auto r = CharacterDatabase.PQuery("SELECT COUNT(*) FROM warfront_shared_set WHERE account = %u AND hidden = 0", st.accountId))
+                if (r->Fetch()[0].GetUInt32() >= 10)
+                    return Reply(p, "WH", Err("full"));
+            std::string eSpec = spec, eName = name, eOwner = p->GetName();
+            CharacterDatabase.escape_string(eSpec);
+            CharacterDatabase.escape_string(eName);
+            CharacterDatabase.escape_string(eOwner);
+            if (!CharacterDatabase.DirectPExecute("INSERT INTO warfront_shared_set (owner_guid, owner_name, account, class, spec, name, items, votes, reports, hidden, created) "
+                                                  "VALUES (%u, '%s', %u, %u, '%s', '%s', '%s', 0, 0, 0, %u)",
+                                                  p->GetGUIDLow(), eOwner.c_str(), st.accountId, uint32(p->getClass()), eSpec.c_str(), eName.c_str(),
+                                                  SetItemsText(items).c_str(), uint32(time(nullptr))))
+                return Reply(p, "WH", Err("gone"));
+            uint32 id = 0;
+            if (auto r = CharacterDatabase.PQuery("SELECT MAX(id) FROM warfront_shared_set WHERE account = %u", st.accountId))
+                id = r->Fetch()[0].GetUInt32();
+            Reply(p, "WH", "ok," + std::to_string(id));
+        }
+
+        void ListSets(Player* p, std::string const& spec)
+        {
+            std::ostringstream q;
+            std::string eSpec = CleanSetName(spec);
+            CharacterDatabase.escape_string(eSpec);
+            std::unique_ptr<QueryResult> r;
+            if (eSpec.empty())
+                r = CharacterDatabase.PQuery("SELECT id, votes, owner_name, spec, name, items FROM warfront_shared_set "
+                                             "WHERE class = %u AND hidden = 0 ORDER BY votes DESC, id DESC LIMIT 15", uint32(p->getClass()));
+            else
+                r = CharacterDatabase.PQuery("SELECT id, votes, owner_name, spec, name, items FROM warfront_shared_set "
+                                             "WHERE class = %u AND hidden = 0 AND spec = '%s' ORDER BY votes DESC, id DESC LIMIT 15",
+                                             uint32(p->getClass()), eSpec.c_str());
+            std::ostringstream body;
+            int n = 0;
+            if (r)
+                do
+                {
+                    Field* f = r->Fetch();
+                    std::string items = f[5].GetCppString();
+                    std::replace(items.begin(), items.end(), ',', '/');
+                    body << (n++ ? ";" : "") << f[0].GetUInt32() << ',' << f[1].GetUInt32() << ','
+                         << WnlFormat::Clean(f[2].GetCppString()) << ',' << WnlFormat::Clean(f[3].GetCppString()) << ','
+                         << WnlFormat::Clean(f[4].GetCppString()) << ',' << items;
+                }
+                while (r->NextRow());
+            Reply(p, "WL", n ? body.str() : std::string("-"));
+        }
+
+        void Vote(Player* p, State& st, uint32 id)
+        {
+            auto r = CharacterDatabase.PQuery("SELECT account, votes FROM warfront_shared_set WHERE id = %u AND hidden = 0", id);
+            if (!r)
+                return Reply(p, "WV", Err("gone"));
+            Field* f = r->Fetch();
+            if (f[0].GetUInt32() == st.accountId)
+                return Reply(p, "WV", Err("self"));
+            uint32 votes = f[1].GetUInt32();
+            if (CharacterDatabase.PQuery("SELECT 1 FROM warfront_set_vote WHERE set_id = %u AND account = %u", id, st.accountId))
+                return Reply(p, "WV", Err("voted"));
+            CharacterDatabase.PExecute("INSERT IGNORE INTO warfront_set_vote (set_id, account) VALUES (%u, %u)", id, st.accountId);
+            CharacterDatabase.PExecute("UPDATE warfront_shared_set SET votes = votes + 1 WHERE id = %u", id);
+            Reply(p, "WV", "ok," + std::to_string(id) + "," + std::to_string(votes + 1));
+        }
+
+        void Report(Player* p, State& st, uint32 id)
+        {
+            auto r = CharacterDatabase.PQuery("SELECT account FROM warfront_shared_set WHERE id = %u AND hidden = 0", id);
+            if (!r)
+                return Reply(p, "WR", Err("gone"));
+            if (r->Fetch()[0].GetUInt32() == st.accountId)
+                return Reply(p, "WR", Err("self"));
+            if (CharacterDatabase.PQuery("SELECT 1 FROM warfront_set_report WHERE set_id = %u AND account = %u", id, st.accountId))
+                return Reply(p, "WR", Err("voted"));
+            CharacterDatabase.PExecute("INSERT IGNORE INTO warfront_set_report (set_id, account) VALUES (%u, %u)", id, st.accountId);
+            // three reports from different accounts hide a set until staff look at it (MySQL applies
+            // SET left to right, so `reports` is already the new count when `hidden` is worked out)
+            CharacterDatabase.PExecute("UPDATE warfront_shared_set SET reports = reports + 1, hidden = (reports >= 3) WHERE id = %u", id);
+            Reply(p, "WR", "ok," + std::to_string(id));
+        }
+
+        void ApplySet(Player* p, State& st, uint32 id)
+        {
+            auto r = CharacterDatabase.PQuery("SELECT class, items FROM warfront_shared_set WHERE id = %u AND hidden = 0", id);
+            if (!r)
+                return Reply(p, "WK", Err("gone"));
+            Field* f = r->Fetch();
+            if (f[0].GetUInt32() != p->getClass())
+                return Reply(p, "WK", Err("class"));
+            std::vector<std::pair<uint32, uint32>> items;
+            if (!ParseSlotItems(f[1].GetCppString(), items))
+                return Reply(p, "WK", Err("gone"));
+            // main hand first, so a two-hander settles the off hand before it is filled
+            std::stable_sort(items.begin(), items.end(), [](auto const& a, auto const& b) { return a.first < b.first; });
+            uint32 applied = 0, skipped = 0;
+            for (auto const& si : items)
+            {
+                char const* err = nullptr;
+                if (Wear(p, uint8(si.first), si.second, st.tier, err))
+                    ++applied;
+                else
+                    ++skipped;
+            }
+            Reply(p, "WK", "ok,set" + std::to_string(id) + "," + std::to_string(applied) + "," + std::to_string(skipped));
+        }
+    }
