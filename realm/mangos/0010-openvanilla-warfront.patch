index 000000000..08f39c6dc
--- /dev/null
+++ b/src/game/OpenVanilla/WarfrontArena.cpp
@@ -0,0 +1,1095 @@
+/*
+ * Open Vanilla — Warfront arena: queues, matchmaking and matches in the Ring of Law (GPLv2, as CMaNGOS).
+ * See WarfrontArena.h.
+ *
+ * Threads: the queues and matches live behind one lock. The world thread (WorldUpdate, which
+ * World::Update runs before the maps update, so no map thread is running) forms matches, runs
+ * their clocks, makes each match's instance and binds and unbinds the players to it: the instance
+ * bookkeeping (sMapPersistentStateMgr, the saves) is never touched from two threads at once. Each
+ * player's own update does the rest to that player (teleport, faction, root, reset) and reports
+ * back (alive, health, on the match map).
+ */
+
+#include "OpenVanilla/WarfrontArena.h"
+#include "OpenVanilla/Warfront.h"
+#include "OpenVanilla/Play.h"
+
+#include "Config/Config.h"
+#include "Database/DatabaseEnv.h"
+#include "Globals/ObjectAccessor.h"
+#include "Entities/Creature.h"
+#include "Entities/Pet.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Grids/CellImpl.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Groups/Group.h"
+#include "Log/Log.h"
+#include "Maps/Map.h"
+#include "Maps/MapManager.h"
+#include "Maps/MapPersistentStateMgr.h"
+#include "Maps/InstanceData.h"
+#include "Server/WorldSession.h"
+#include "Spells/SpellAuras.h"
+#include "Spells/SpellMgr.h"
+
+#include <algorithm>
+#include <atomic>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <unordered_map>
+
+namespace Warfront
+{
+    namespace Arena
+    {
+        // ── modes ──
+
+        namespace
+        {
+            enum Mode { S2, S3, R2, R3, D1, MODES };
+            char const* const MODE_NAME[MODES] = { "s2", "s3", "r2", "r3", "d1" };
+            size_t const MODE_SIZE[MODES] = { 2, 3, 2, 3, 1 };
+            bool const MODE_RATED[MODES] = { false, false, true, true, true };
+
+            int ModeOf(std::string const& s)
+            {
+                for (int m = 0; m < MODES; ++m)
+                    if (s == MODE_NAME[m])
+                        return m;
+                return -1;
+            }
+
+            // Blackrock Depths, the Ring of Law: team 0 by the north gate, team 1 by the south.
+            uint32 const RING_MAP = 230;
+            float const RING_X = 596.82f, RING_Y = -188.77f, RING_Z = -54.15f;
+            float const SPAWN[2][4] = { { 590.2f, -164.2f, -53.9f, 4.98f }, { 603.3f, -213.3f, -53.9f, 1.84f } };
+            uint32 const TEAM_FACTION[2] = { 1, 2 };     // Human (Alliance), Orc (Horde) player factions
+
+            uint32 const PREP_MS = 60 * IN_MILLISECONDS;
+            uint32 const PORT_TIMEOUT_MS = 45 * IN_MILLISECONDS;
+            uint32 const FIGHT_MS = 15 * MINUTE * IN_MILLISECONDS;
+            uint32 const END_MS = 10 * IN_MILLISECONDS;
+            uint32 const LEAVER_LOCK_SEC = 15 * MINUTE;
+            int32 const START_RATING = 1500;
+            uint32 const RING_OF_LAW_DATA = 1, RING_DONE = 3;   // blackrock_depths.h TYPE_RING_OF_LAW, sc_instance.h DONE
+            uint32 const SAME_MATCHUP_PER_DAY = 5;              // rated games between the same players that count, per day
+            uint32 const QUICK_FEED_MS = 30 * IN_MILLISECONDS;  // a rated loss by leaving this soon after "go" gives the winners nothing
+            uint32 const LIVE_SAVE_MS = 15 * IN_MILLISECONDS;   // how often the live counts go to warfront_live
+
+            // Rated matches never put two characters of one account, or (unless the realm allows it)
+            // of one network address, on opposite teams: that is how win trading is done alone.
+            bool SameAddressRated()
+            {
+                static bool const allow = MaNGOS::Singleton<::Config>::Instance().GetBoolDefault("OpenVanilla.Warfront.Arena.SameAddressRated", false);
+                return allow;
+            }
+
+            struct Ticket
+            {
+                std::vector<uint32> guids;
+                std::vector<int32> ratings; // each player's personal rating in the mode
+                std::vector<uint32> accounts;
+                std::vector<std::string> addresses;
+                uint32 rating = 0;          // their average
+                time_t joined = 0;
+            };
+
+            struct Member
+            {
+                uint8 team = 0;
+                bool bound = false;         // bound to the match instance (world thread)
+                bool unbound = false;       // and freed from it again (world thread)
+                bool ported = false;        // teleport sent
+                bool arrived = false;       // on the match map at least once
+                bool present = false;       // on the match map now
+                bool alive = true;
+                bool left = false;          // logged out, left the ring alive, or couldn't come
+                float health = 1.0f;
+                int32 rating = START_RATING;
+                int32 delta = 0;
+                uint32 retMap = 0;
+                float retX = 0, retY = 0, retZ = 0, retO = 0;
+                bool sentPop = false, sentPrep = false, sentGo = false, sentEnd = false, sentHome = false, done = false;
+            };
+
+            enum Phase { PORTING, PREP, FIGHT, ENDING, DONE };
+
+            struct Match
+            {
+                uint32 id = 0;
+                int mode = S2;
+                Phase phase = PORTING;
+                uint32 clock = 0;           // ms in this phase
+                uint32 instanceId = 0;
+                bool cleared = false;       // the ring's creatures removed
+                int winner = -1;            // 0, 1, 2 = draw, -1 = none (cancelled)
+                bool rated = false;
+                std::map<uint32, Member> members;
+            };
+
+            std::mutex g_lock;
+            std::deque<Ticket> g_queue[MODES];
+            std::unordered_map<uint32, int> g_queued;               // guid -> mode
+            std::map<uint32, std::shared_ptr<Match>> g_matches;
+            std::unordered_map<uint32, uint32> g_inMatch;           // guid -> match id
+            std::unordered_map<uint32, time_t> g_locked;            // guid -> queue lock until
+            std::unordered_map<uint32, std::string> g_notice;       // guid -> one line to send (queue changes)
+            std::unordered_map<std::string, std::pair<uint32, time_t>> g_matchups;  // who met whom: games today
+            uint32 g_nextMatch = 1;
+            uint32 g_mmClock = 0;
+            uint32 g_liveClock = 0;
+            std::string g_live = "0,0,0,0,0,0,0,0,0";              // LiveCounts(), refreshed by WorldUpdate
+            std::atomic<uint32> g_realBgQueued{ 0 };
+
+            // personal ratings, cached; written through to warfront_arena_rating
+            std::mutex g_ratingLock;
+            std::unordered_map<uint64, int32> g_ratings;            // (guid << 8 | mode) -> rating
+
+            int32 RatingOf(uint32 guid, int mode)
+            {
+                uint64 key = (uint64(guid) << 8) | uint64(mode);
+                {
+                    std::lock_guard<std::mutex> guard(g_ratingLock);
+                    auto it = g_ratings.find(key);
+                    if (it != g_ratings.end())
+                        return it->second;
+                }
+                int32 r = START_RATING;
+                if (auto q = CharacterDatabase.PQuery("SELECT rating FROM warfront_arena_rating WHERE guid = %u AND bracket = %u", guid, uint32(mode)))
+                    r = int32(q->Fetch()[0].GetUInt32());
+                std::lock_guard<std::mutex> guard(g_ratingLock);
+                g_ratings[key] = r;
+                return r;
+            }
+
+            void StoreRating(uint32 guid, int mode, int32 rating, bool won)
+            {
+                {
+                    std::lock_guard<std::mutex> guard(g_ratingLock);
+                    g_ratings[(uint64(guid) << 8) | uint64(mode)] = rating;
+                }
+                CharacterDatabase.PExecute("INSERT INTO warfront_arena_rating (guid, bracket, rating, best, wins, losses) VALUES (%u, %u, %d, %d, %u, %u) "
+                                           "ON DUPLICATE KEY UPDATE rating = VALUES(rating), best = GREATEST(best, VALUES(rating)), "
+                                           "wins = wins + VALUES(wins), losses = losses + VALUES(losses)",
+                                           guid, uint32(mode), rating, rating, won ? 1u : 0u, won ? 0u : 1u);
+                CharacterDatabase.PExecute("UPDATE warfront_account a JOIN characters c ON c.account = a.account SET a.best_rating = GREATEST(a.best_rating, %d) WHERE c.guid = %u",
+                                           rating, guid);
+            }
+
+            void Notice(uint32 guid, std::string const& line)   // g_lock held
+            {
+                g_notice[guid] = line;
+            }
+
+            void RemoveFromQueue(uint32 guid)                   // g_lock held: the whole ticket goes
+            {
+                auto q = g_queued.find(guid);
+                if (q == g_queued.end())
+                    return;
+                auto& dq = g_queue[q->second];
+                for (auto it = dq.begin(); it != dq.end(); ++it)
+                    if (std::find(it->guids.begin(), it->guids.end(), guid) != it->guids.end())
+                    {
+                        for (uint32 g : it->guids)
+                        {
+                            g_queued.erase(g);
+                            if (g != guid)
+                                Notice(g, "left");
+                        }
+                        dq.erase(it);
+                        break;
+                    }
+                g_queued.erase(guid);
+            }
+        }
+
+        // ── queries ──
+
+        bool InQueue(Player* p)
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            return g_queued.count(p->GetGUIDLow()) != 0;
+        }
+
+        bool InMatch(Player* p)
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            return g_inMatch.count(p->GetGUIDLow()) != 0;
+        }
+
+        bool SkipEntryChecks(Player* p, uint32 mapId)
+        {
+            if (!p || mapId != RING_MAP || !Enabled())
+                return false;
+            std::lock_guard<std::mutex> guard(g_lock);
+            return g_inMatch.count(p->GetGUIDLow()) != 0;
+        }
+
+        uint32 BestRating(uint32 accountId)
+        {
+            if (auto r = CharacterDatabase.PQuery("SELECT MAX(r.best) FROM warfront_arena_rating r JOIN characters c ON c.guid = r.guid WHERE c.account = %u", accountId))
+                return r->Fetch()[0].GetUInt32();
+            return 0;
+        }
+
+        void Forget(uint32 guidLow)
+        {
+            {
+                std::lock_guard<std::mutex> guard(g_ratingLock);
+                for (int m = 0; m < MODES; ++m)
+                    g_ratings.erase((uint64(guidLow) << 8) | uint64(m));
+            }
+            std::lock_guard<std::mutex> guard(g_lock);
+            g_notice.erase(guidLow);
+            RemoveFromQueue(guidLow);
+            auto m = g_inMatch.find(guidLow);
+            if (m != g_inMatch.end())
+            {
+                auto it = g_matches.find(m->second);
+                if (it != g_matches.end())
+                {
+                    Member& mem = it->second->members[guidLow];
+                    if (it->second->phase == ENDING)
+                        mem.left = true;            // still in the ring at logout: sent home at the next login
+                    else if (it->second->phase == PORTING || it->second->phase == PREP || it->second->phase == FIGHT)
+                    {
+                        mem.left = true;
+                        mem.alive = false;
+                        mem.present = false;
+                        if (it->second->rated && mem.ported)
+                            g_locked[guidLow] = time(nullptr) + LEAVER_LOCK_SEC;
+                    }
+                }
+                // the logout keeps the match entry: the character still has to leave the ring at login
+            }
+        }
+
+        // ── commands ──
+
+        namespace
+        {
+            void Say(Player* p, std::string const& body) { OwPlay::Send(p, "WQ", body); }
+
+            char const* CannotQueue(Player* p)
+            {
+                if (p->GetLevel() < 60)
+                    return "level";
+                if (!p->IsAlive())
+                    return "dead";
+                if (p->IsInCombat())
+                    return "combat";
+                if (p->InBattleGround() || p->InBattleGroundQueue())
+                    return "battleground";
+                if (p->GetMap()->Instanceable())
+                    return "instance";
+                if (p->IsTaxiFlying())
+                    return "flying";
+                return nullptr;
+            }
+        }
+
+        void Command(Player* p, std::string const& args)
+        {
+            std::istringstream in(args);
+            std::string cmd, arg;
+            in >> cmd >> arg;
+            uint32 guid = p->GetGUIDLow();
+            if (cmd == "join")
+            {
+                int mode = ModeOf(arg);
+                if (mode < 0)
+                    return Say(p, "err,mode");
+                if (char const* why = CannotQueue(p))
+                    return Say(p, std::string("err,") + why);
+                // party members by guid only: they may be on other maps (other threads); the world
+                // thread checks each of them when the match pops
+                std::vector<uint32> party{ guid };
+                if (Group* g = p->GetGroup())
+                {
+                    if (g->GetLeaderGuid() != p->GetObjectGuid())
+                        return Say(p, "err,leader");
+                    if (size_t(g->GetMembersCount()) > MODE_SIZE[mode])
+                        return Say(p, "err,group");
+                    party.clear();
+                    for (GroupReference* ref = g->GetFirstMember(); ref; ref = ref->next())
+                        if (Player* m = ref->getSource())
+                            party.push_back(m->GetGUIDLow());
+                    if (party.size() != size_t(g->GetMembersCount()))
+                        return Say(p, "err,offline");
+                }
+                Ticket t;
+                t.joined = time(nullptr);
+                int64 sum = 0;
+                for (uint32 g : party)
+                {
+                    int32 r = MODE_RATED[mode] ? RatingOf(g, mode) : START_RATING;
+                    t.guids.push_back(g);
+                    t.ratings.push_back(r);
+                    Player* who = g == guid ? p : sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, g));
+                    WorldSession* ses = who ? who->GetSession() : nullptr;
+                    t.accounts.push_back(ses ? ses->GetAccountId() : 0);
+                    t.addresses.push_back(ses ? ses->GetRemoteAddress() : std::string());
+                    sum += r;
+                }
+                t.rating = uint32(sum / int64(party.size()));
+                std::lock_guard<std::mutex> guard(g_lock);
+                time_t now = time(nullptr);
+                for (uint32 g : t.guids)
+                {
+                    auto l = g_locked.find(g);
+                    if (l != g_locked.end() && l->second > now)
+                        return Say(p, "err,locked," + std::to_string(uint32(l->second - now)));
+                    if (g_inMatch.count(g))
+                        return Say(p, "err,match");
+                }
+                for (uint32 g : t.guids)
+                    RemoveFromQueue(g);
+                for (uint32 g : t.guids)
+                {
+                    g_queued[g] = mode;
+                    Notice(g, std::string("q,") + MODE_NAME[mode] + ",0," + std::to_string(g_queue[mode].size() + 1));
+                }
+                g_queue[mode].push_back(t);
+                return;
+            }
+            if (cmd == "leave")
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                if (!g_queued.count(guid))
+                    return Say(p, "err,none");
+                RemoveFromQueue(guid);
+                Notice(guid, "left");
+                return;
+            }
+            if (cmd == "status")
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                auto q = g_queued.find(guid);
+                if (q == g_queued.end())
+                    return Say(p, "none");
+                uint32 waited = 0;
+                for (Ticket const& t : g_queue[q->second])
+                    if (std::find(t.guids.begin(), t.guids.end(), guid) != t.guids.end())
+                        waited = uint32(time(nullptr) - t.joined);
+                return Say(p, std::string("q,") + MODE_NAME[q->second] + "," + std::to_string(waited) + "," + std::to_string(g_queue[q->second].size()));
+            }
+            if (cmd == "rating")
+                return Say(p, "r," + std::to_string(RatingOf(guid, R2)) + "," + std::to_string(RatingOf(guid, R3)) + "," + std::to_string(RatingOf(guid, D1)));
+            if (cmd == "top")
+            {
+                int mode = ModeOf(arg);
+                if (mode < 0 || !MODE_RATED[mode])
+                    return Say(p, "err,mode");
+                std::ostringstream b;
+                b << "top," << MODE_NAME[mode];
+                if (auto r = CharacterDatabase.PQuery("SELECT c.name, r.rating FROM warfront_arena_rating r JOIN characters c ON c.guid = r.guid "
+                                                      "WHERE r.bracket = %u ORDER BY r.rating DESC LIMIT 10", uint32(mode)))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        b << ';' << f[0].GetCppString() << ',' << f[1].GetUInt32();
+                    }
+                    while (r->NextRow());
+                return Say(p, b.str());
+            }
+            Say(p, "err,command");
+        }
+
+        // ── the world thread: matchmaking and clocks ──
+
+        namespace
+        {
+            // Whether two teams (ticket indexes into dq) share an account or a network address.
+            bool SameOwner(std::deque<Ticket> const& dq, std::vector<size_t> const& a, std::vector<size_t> const& b)
+            {
+                std::set<uint32> accounts;
+                std::set<std::string> addresses;
+                for (size_t t : a)
+                    for (size_t k = 0; k < dq[t].guids.size(); ++k)
+                    {
+                        if (k < dq[t].accounts.size() && dq[t].accounts[k])
+                            accounts.insert(dq[t].accounts[k]);
+                        if (k < dq[t].addresses.size() && !dq[t].addresses[k].empty())
+                            addresses.insert(dq[t].addresses[k]);
+                    }
+                for (size_t t : b)
+                    for (size_t k = 0; k < dq[t].guids.size(); ++k)
+                    {
+                        if (k < dq[t].accounts.size() && dq[t].accounts[k] && accounts.count(dq[t].accounts[k]))
+                            return true;
+                        if (!SameAddressRated() && k < dq[t].addresses.size() && !dq[t].addresses[k].empty() && addresses.count(dq[t].addresses[k]))
+                            return true;
+                    }
+                return false;
+            }
+
+            void MakeMatches(int mode)                          // g_lock held
+            {
+                auto& dq = g_queue[mode];
+                size_t size = MODE_SIZE[mode];
+                std::vector<size_t> sizes;
+                for (Ticket const& t : dq)
+                    sizes.push_back(t.guids.size());
+                std::vector<std::vector<size_t>> teams = FormTeams(sizes, size);
+                if (teams.size() < 2)
+                    return;
+                time_t now = time(nullptr);
+                // team rating and oldest wait
+                std::vector<uint32> rating(teams.size());
+                std::vector<uint32> waited(teams.size());
+                for (size_t i = 0; i < teams.size(); ++i)
+                {
+                    uint64 sum = 0;
+                    size_t n = 0;
+                    time_t oldest = now;
+                    for (size_t t : teams[i])
+                    {
+                        sum += uint64(dq[t].rating) * dq[t].guids.size();
+                        n += dq[t].guids.size();
+                        oldest = std::min(oldest, dq[t].joined);
+                    }
+                    rating[i] = uint32(sum / std::max<size_t>(1, n));
+                    waited[i] = uint32(now - oldest);
+                }
+                std::vector<bool> taken(teams.size(), false);
+                std::set<size_t> usedTickets;
+                for (size_t a = 0; a < teams.size(); ++a)
+                {
+                    if (taken[a])
+                        continue;
+                    for (size_t b = a + 1; b < teams.size(); ++b)
+                    {
+                        if (taken[b])
+                            continue;
+                        if (MODE_RATED[mode] && !RatingsMeet(rating[a], rating[b], std::max(waited[a], waited[b])))
+                            continue;
+                        if (MODE_RATED[mode] && SameOwner(dq, teams[a], teams[b]))
+                            continue;
+                        taken[a] = taken[b] = true;
+                        auto m = std::make_shared<Match>();
+                        m->id = g_nextMatch++;
+                        m->mode = mode;
+                        m->rated = MODE_RATED[mode];
+                        uint8 side = 0;
+                        for (size_t teamIdx : { a, b })
+                        {
+                            for (size_t t : teams[teamIdx])
+                            {
+                                usedTickets.insert(t);
+                                for (size_t k = 0; k < dq[t].guids.size(); ++k)
+                                {
+                                    uint32 g = dq[t].guids[k];
+                                    Member mem;
+                                    mem.team = side;
+                                    mem.rating = k < dq[t].ratings.size() ? dq[t].ratings[k] : START_RATING;
+                                    m->members[g] = mem;
+                                    g_inMatch[g] = m->id;
+                                    g_queued.erase(g);
+                                }
+                            }
+                            ++side;
+                        }
+                        g_matches[m->id] = m;
+                        sLog.outString("Open Vanilla Warfront: arena match %u (%s) formed, %u players", m->id, MODE_NAME[mode], uint32(m->members.size()));
+                        break;
+                    }
+                }
+                if (usedTickets.empty())
+                    return;
+                std::deque<Ticket> rest;
+                for (size_t i = 0; i < dq.size(); ++i)
+                    if (!usedTickets.count(i))
+                        rest.push_back(dq[i]);
+                dq.swap(rest);
+            }
+
+            void Finish(Match& m, int winner)                   // g_lock held
+            {
+                uint32 fightMs = m.phase == FIGHT ? m.clock : 0;
+                m.winner = winner;
+                m.phase = ENDING;
+                m.clock = 0;
+                if (!m.rated || winner < 0)
+                    return;
+                // each player against the other team's average
+                int64 sum[2] = { 0, 0 };
+                int n[2] = { 0, 0 };
+                for (auto const& kv : m.members)
+                {
+                    sum[kv.second.team] += kv.second.rating;
+                    ++n[kv.second.team];
+                }
+                int32 avg[2] = { int32(sum[0] / std::max(1, n[0])), int32(sum[1] / std::max(1, n[1])) };
+                // the same players meeting again and again (win trading): only the first few count each day
+                std::vector<uint32> all;
+                for (auto const& kv : m.members)
+                    all.push_back(kv.first * 2 + kv.second.team);
+                std::sort(all.begin(), all.end());
+                std::string key = std::to_string(m.mode);
+                for (uint32 g : all)
+                    key += "," + std::to_string(g);
+                time_t now = time(nullptr);
+                auto& mu = g_matchups[key];
+                if (now - mu.second > DAY)
+                    mu = { 0, now };
+                if (++mu.first > SAME_MATCHUP_PER_DAY)
+                {
+                    sLog.outString("Open Vanilla Warfront: arena match %u: same players met %u times today, not rated (win trading?)", m.id, mu.first);
+                    return;
+                }
+                // the losers left within seconds of the start: they still lose, the winners gain nothing
+                bool fed = false;
+                if (winner == 0 || winner == 1)
+                    for (auto const& kv : m.members)
+                        if (kv.second.team != winner && kv.second.left && fightMs < QUICK_FEED_MS)
+                            fed = true;
+                if (fed)
+                    sLog.outString("Open Vanilla Warfront: arena match %u: the losers left %u s in, the winners gain no rating", m.id, fightMs / IN_MILLISECONDS);
+                for (auto& kv : m.members)
+                {
+                    Member& mem = kv.second;
+                    if (winner == 2 && !mem.left)
+                        continue;           // a draw changes nothing, except for a leaver
+                    if (fed && mem.team == winner && !mem.left)
+                        continue;
+                    bool won = winner == mem.team && !mem.left;     // leaving is a loss, whatever the team did
+                    int32 after = EloAfter(mem.rating, avg[1 - mem.team], won);
+                    mem.delta = after - mem.rating;
+                    mem.rating = after;
+                    StoreRating(kv.first, m.mode, after, won);
+                }
+            }
+
+            // The instance and the binds: world thread, before the maps update (g_lock held).
+            void BindMembers(Match& m)
+            {
+                MapEntry const* entry = sMapStore.LookupEntry(RING_MAP);
+                if (!entry)
+                    return;
+                if (!m.instanceId)
+                {
+                    uint32 id = sMapMgr.GenerateInstanceId();
+                    if (!sMapPersistentStateMgr.AddPersistentState(entry, id, 0, true, false))
+                        return;
+                    m.instanceId = id;
+                }
+                DungeonPersistentState* st = (DungeonPersistentState*)sMapPersistentStateMgr.GetPersistentState(RING_MAP, m.instanceId);
+                if (!st)
+                    return;
+                for (auto& kv : m.members)
+                {
+                    Member& mem = kv.second;
+                    if (mem.bound || mem.left || mem.done)
+                        continue;
+                    Player* p = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, kv.first));
+                    if (!p || !p->IsInWorld() || p->IsBeingTeleported())
+                        continue;                   // not here (yet): the port timeout decides
+                    char const* why = CannotQueue(p);
+                    if (why && std::string(why) != "combat" && std::string(why) != "flying")
+                    {
+                        // went into a battleground or a dungeon, died, ...: out of this match
+                        mem.left = true;
+                        mem.done = true;
+                        mem.alive = false;
+                        Notice(kv.first, std::string("err,") + why);
+                        continue;
+                    }
+                    if (why)
+                        continue;                   // in combat or on a flight: wait for it
+                    mem.retMap = p->GetMapId();
+                    mem.retX = p->GetPositionX();
+                    mem.retY = p->GetPositionY();
+                    mem.retZ = p->GetPositionZ();
+                    mem.retO = p->GetOrientation();
+                    // a permanent player save wins over any group save (MapManager::CreateInstance), so the
+                    // party's own Blackrock Depths run is never touched
+                    p->BindToInstance(st, true);
+                    mem.bound = true;
+                }
+            }
+
+            // Free everyone who is done from the match instance (world thread, g_lock held).
+            void UnbindMembers(Match& m)
+            {
+                for (auto& kv : m.members)
+                {
+                    Member& mem = kv.second;
+                    if (!mem.bound || mem.unbound || !(mem.done || m.phase == DONE))
+                        continue;
+                    mem.unbound = true;
+                    if (Player* p = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, kv.first), false))
+                    {
+                        if (InstancePlayerBind* b = p->GetBoundInstance(RING_MAP))
+                            if (b->state && b->state->GetInstanceId() == m.instanceId)
+                                p->UnbindInstance(RING_MAP);
+                    }
+                    // offline: the save stays, so the next login sees "a ring save, no match" and goes home
+                }
+            }
+
+            void Clock(Match& m, uint32 diff)                   // g_lock held
+            {
+                m.clock += diff;
+                bool teamHere[2] = { false, false };
+                bool teamAlive[2] = { false, false };
+                float health[2] = { 0, 0 };
+                int count[2] = { 0, 0 };
+                bool allArrived = true;
+                for (auto const& kv : m.members)
+                {
+                    Member const& mem = kv.second;
+                    if (!mem.arrived && !mem.left)
+                        allArrived = false;
+                    if (mem.present)
+                        teamHere[mem.team] = true;
+                    if (mem.present && mem.alive && !mem.left)
+                        teamAlive[mem.team] = true;
+                    health[mem.team] += mem.left ? 0.0f : mem.health;
+                    ++count[mem.team];
+                }
+                switch (m.phase)
+                {
+                    case PORTING:
+                        BindMembers(m);
+                        if (allArrived || m.clock >= PORT_TIMEOUT_MS)
+                        {
+                            if (!teamHere[0] || !teamHere[1])
+                            {
+                                // one side never came: no rating change, everyone goes home
+                                m.winner = -1;
+                                m.phase = ENDING;
+                                m.clock = END_MS;   // straight out
+                            }
+                            else
+                            {
+                                m.phase = PREP;
+                                m.clock = 0;
+                            }
+                        }
+                        break;
+                    case PREP:
+                        if (m.clock >= PREP_MS)
+                        {
+                            m.phase = FIGHT;
+                            m.clock = 0;
+                        }
+                        break;
+                    case FIGHT:
+                        if (!teamAlive[0] && !teamAlive[1])
+                            Finish(m, 2);
+                        else if (!teamAlive[0])
+                            Finish(m, 1);
+                        else if (!teamAlive[1])
+                            Finish(m, 0);
+                        else if (m.clock >= FIGHT_MS)
+                            Finish(m, TimeLimitWinner(health[0] / std::max(1, count[0]), health[1] / std::max(1, count[1])));
+                        break;
+                    case ENDING:
+                        if (m.clock >= END_MS)
+                        {
+                            bool allDone = true;
+                            for (auto const& kv : m.members)
+                                if (!kv.second.done && !kv.second.left)
+                                    allDone = false;
+                            if (allDone || m.clock >= END_MS + 60 * IN_MILLISECONDS)
+                                m.phase = DONE;
+                        }
+                        break;
+                    case DONE:
+                        break;
+                }
+            }
+        }
+
+        namespace
+        {
+            // The live line (Warfront.h, WC): players queued per arena mode, arena matches running,
+            // real players in battleground queues and in battles, realm bots in battles. g_lock held.
+            void RefreshLive(uint32 diff)
+            {
+                uint32 queued[MODES] = {};
+                for (int m = 0; m < MODES; ++m)
+                    for (Ticket const& t : g_queue[m])
+                        queued[m] += uint32(t.guids.size());
+                uint32 bgQueued = 0, bgPlaying = 0, bgBots = 0;
+                {
+                    HashMapHolder<Player>::ReadGuard guard(HashMapHolder<Player>::GetLock());
+                    for (auto const& kv : sObjectAccessor.GetPlayers())
+                    {
+                        Player* pl = kv.second;
+                        if (!pl || !pl->IsInWorld())
+                            continue;
+                        bool bot = IsRealmBot(pl);
+                        if (pl->InBattleGround())
+                            (bot ? bgBots : bgPlaying) += 1;
+                        else if (!bot && pl->InBattleGroundQueue())
+                            ++bgQueued;
+                    }
+                }
+                std::ostringstream b;
+                for (int m = 0; m < MODES; ++m)
+                    b << queued[m] << ',';
+                b << g_matches.size() << ',' << bgQueued << ',' << bgPlaying << ',' << bgBots;
+                g_live = b.str();
+                g_realBgQueued = bgQueued;
+                g_liveClock += diff;
+                if (g_liveClock >= LIVE_SAVE_MS)
+                {
+                    g_liveClock = 0;
+                    CharacterDatabase.PExecute("REPLACE INTO warfront_live (id, line, updated) VALUES (1, '%s', UNIX_TIMESTAMP())", g_live.c_str());
+                }
+            }
+        }
+
+        uint32 RealBgQueuedNow() { return g_realBgQueued.load(); }
+
+        std::string Live()
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            return g_live;
+        }
+
+        void WorldUpdate(uint32 diff)
+        {
+            if (!Enabled())
+                return;
+            std::lock_guard<std::mutex> guard(g_lock);
+            g_mmClock += diff;
+            if (g_mmClock >= 2 * IN_MILLISECONDS)
+            {
+                g_mmClock = 0;
+                for (int m = 0; m < MODES; ++m)
+                    MakeMatches(m);
+                time_t now = time(nullptr);
+                for (auto it = g_locked.begin(); it != g_locked.end();)
+                    it = it->second <= now ? g_locked.erase(it) : std::next(it);
+                for (auto it = g_matchups.begin(); it != g_matchups.end();)
+                    it = now - it->second.second > DAY ? g_matchups.erase(it) : std::next(it);
+                RefreshLive(2 * IN_MILLISECONDS);
+            }
+            for (auto it = g_matches.begin(); it != g_matches.end();)
+            {
+                Match& m = *it->second;
+                Clock(m, diff);
+                UnbindMembers(m);
+                // a finished match stays until every member who logged out has been sent home
+                bool anyLeft = false;
+                for (auto const& kv : m.members)
+                    if (kv.second.left && !kv.second.done)
+                        anyLeft = true;
+                if (m.phase == DONE && (!anyLeft || m.clock > 30 * MINUTE * IN_MILLISECONDS))
+                {
+                    for (auto& kv : m.members)
+                        kv.second.done = true;
+                    UnbindMembers(m);
+                    for (auto const& kv : m.members)
+                        if (g_inMatch.count(kv.first) && g_inMatch[kv.first] == m.id)
+                            g_inMatch.erase(kv.first);
+                    it = g_matches.erase(it);
+                }
+                else
+                    ++it;
+            }
+        }
+
+        // ── the player's own update ──
+
+        namespace
+        {
+            bool OnMatchMap(Player* p, Match const& m)
+            {
+                return m.instanceId && p->GetMapId() == RING_MAP && p->GetInstanceId() == m.instanceId;
+            }
+
+            void StripBuffs(Player* p)
+            {
+                // flasks, elixirs, world buffs and every other timed buff go; stances and auras stay
+                std::vector<uint32> remove;
+                for (auto const& kv : p->GetSpellAuraHolderMap())
+                {
+                    SpellAuraHolder const* h = kv.second;
+                    if (h->IsPositive() && !h->IsPassive() && h->GetAuraMaxDuration() > 0)
+                        remove.push_back(h->GetId());
+                }
+                for (uint32 id : remove)
+                    p->RemoveAurasDueToSpell(id);
+            }
+
+            void StripAndReset(Player* p)
+            {
+                StripBuffs(p);
+                p->SetHealth(p->GetMaxHealth());
+                if (p->GetPowerType() == POWER_MANA)
+                    p->SetPower(POWER_MANA, p->GetMaxPower(POWER_MANA));
+                else if (p->GetPowerType() == POWER_RAGE)
+                    p->SetPower(POWER_RAGE, 0);
+                else if (p->GetPowerType() == POWER_ENERGY)
+                    p->SetPower(POWER_ENERGY, p->GetMaxPower(POWER_ENERGY));
+                p->RemoveSomeCooldown([](SpellEntry const& e)
+                {
+                    return e.RecoveryTime <= 10 * MINUTE * IN_MILLISECONDS && e.CategoryRecoveryTime <= 10 * MINUTE * IN_MILLISECONDS;
+                });
+            }
+
+            void SetFaction(Player* p, uint32 faction)
+            {
+                p->setFaction(faction);
+                if (Pet* pet = p->GetPet())
+                    pet->setFaction(faction);
+            }
+
+            void RestoreFaction(Player* p)
+            {
+                p->setFactionForRace(p->getRace());
+                if (Pet* pet = p->GetPet())
+                    pet->setFaction(p->GetFaction());
+            }
+
+            void ClearRing(Player* p)
+            {
+                // the instance's own creatures near the ring (spectators, the arena event) go away
+                CreatureList found;
+                MaNGOS::AnyUnitInObjectRangeCheck check(p, 90.0f);
+                MaNGOS::CreatureListSearcher<MaNGOS::AnyUnitInObjectRangeCheck> searcher(found, check);
+                Cell::VisitGridObjects(RING_X, RING_Y, p->GetMap(), searcher, 90.0f);
+                for (Creature* c : found)
+                    if (!c->IsPet() && !c->IsTotem() && !c->GetOwnerGuid())
+                        c->ForcedDespawn();
+            }
+
+            void SendHome(Player* p, Member const& mem)
+            {
+                RestoreFaction(p);
+                p->SetImmobilizedState(false);
+                if (!p->IsAlive())
+                {
+                    p->ResurrectPlayer(1.0f);
+                    p->SpawnCorpseBones();
+                }
+                p->SetHealth(p->GetMaxHealth());
+                // the save is freed on the world thread (UnbindMembers)
+                if (mem.retMap || mem.retX != 0.0f)
+                    p->TeleportTo(mem.retMap, mem.retX, mem.retY, mem.retZ, mem.retO);
+                else
+                    p->TeleportToHomebind();
+            }
+
+            // Blackrock Depths' own Ring of Law event (Grimstone and his waves) must never start in a
+            // match copy: mark it done, and clear anything it already summoned.
+            void QuietRing(Player* p, Match& m)                 // the match map's thread
+            {
+                InstanceData* data = p->GetMap()->GetInstanceData();
+                if (data && data->GetData(RING_OF_LAW_DATA) != RING_DONE)
+                {
+                    data->SetData(RING_OF_LAW_DATA, RING_DONE);
+                    m.cleared = false;      // anything the event summoned goes too
+                }
+                if (!m.cleared)
+                {
+                    m.cleared = true;
+                    ClearRing(p);
+                }
+            }
+        }
+
+        void Update(Player* p, uint32 /*diff*/)
+        {
+            uint32 guid = p->GetGUIDLow();
+            std::string notice;
+            std::shared_ptr<Match> held;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                auto n = g_notice.find(guid);
+                if (n != g_notice.end())
+                {
+                    notice = n->second;
+                    g_notice.erase(n);
+                }
+                auto m = g_inMatch.find(guid);
+                if (m != g_inMatch.end())
+                {
+                    auto it = g_matches.find(m->second);
+                    if (it != g_matches.end())
+                        held = it->second;
+                }
+            }
+            if (!notice.empty())
+                Say(p, notice);
+            if (!held)
+            {
+                // a character that logged out in a ring whose match is over: send it home
+                if (p->GetMapId() == RING_MAP && !p->IsBeingTeleported())
+                    if (InstancePlayerBind* b = p->GetBoundInstance(RING_MAP))
+                        if (b->perm)
+                        {
+                            p->UnbindInstance(RING_MAP);    // its match is gone: nobody else uses that save
+                            Member none;
+                            SendHome(p, none);
+                        }
+                return;
+            }
+            Match& m = *held;
+            std::unique_lock<std::mutex> guard(g_lock);
+            auto mit = m.members.find(guid);
+            if (mit == m.members.end())
+                return;
+            Member& mem = mit->second;
+            if (mem.done)
+            {
+                // done but still in the ring (logged back in, or the match is over): home
+                if (mem.ported && OnMatchMap(p, m) && !p->IsBeingTeleported() && !mem.sentHome)
+                {
+                    mem.sentHome = true;
+                    Member copy = mem;
+                    guard.unlock();
+                    SendHome(p, copy);
+                    return;
+                }
+                // out of the ring and done: free to queue again now, not only when the whole match
+                // is cleared (that waits for players who logged out in it, up to 30 minutes)
+                if (!OnMatchMap(p, m) && !p->IsBeingTeleported())
+                {
+                    auto g = g_inMatch.find(guid);
+                    if (g != g_inMatch.end() && g->second == m.id)
+                        g_inMatch.erase(g);
+                }
+                return;
+            }
+            if (mem.left && m.phase != DONE && m.phase != ENDING)
+            {
+                // logged back in while the match still runs: out of it (the loss is already counted)
+                mem.done = true;
+                if (!mem.ported)
+                    return;
+                mem.sentHome = true;
+                Member copy = mem;
+                guard.unlock();
+                SendHome(p, copy);
+                return;
+            }
+            bool here = OnMatchMap(p, m);
+            mem.present = here && !p->IsBeingTeleported();
+            if (mem.present)
+            {
+                mem.arrived = true;
+                mem.alive = p->IsAlive();
+                mem.health = p->IsAlive() ? float(p->GetHealth()) / float(std::max<uint32>(1, p->GetMaxHealth())) : 0.0f;
+            }
+            else if (mem.arrived && (m.phase == PREP || m.phase == FIGHT) && !p->IsBeingTeleported())
+            {
+                if (p->IsAlive())
+                {
+                    // out of the ring alive mid-match: that is leaving
+                    mem.left = true;
+                    mem.alive = false;
+                    if (m.rated)
+                        g_locked[guid] = time(nullptr) + LEAVER_LOCK_SEC;
+                }
+                else
+                    mem.alive = false;      // released to a graveyard: dead, not a leaver
+            }
+            if (!mem.sentPop)
+            {
+                mem.sentPop = true;
+                Say(p, std::string("pop,") + MODE_NAME[m.mode] + "," + std::to_string(m.id) + "," + std::to_string(mem.team));
+            }
+
+            switch (m.phase)
+            {
+                case PORTING:
+                {
+                    if (here)
+                    {
+                        QuietRing(p, m);
+                        return;
+                    }
+                    if (!mem.bound || mem.ported || p->IsBeingTeleported())
+                        break;              // the world thread binds when the player can go
+                    mem.ported = true;
+                    float const* s = SPAWN[mem.team];
+                    guard.unlock();
+                    if (!p->TeleportTo(RING_MAP, s[0], s[1], s[2], s[3], TELE_TO_SKIP_ENTRY_CHECKS))
+                    {
+                        std::lock_guard<std::mutex> again(g_lock);
+                        mem.left = true;
+                        mem.done = true;
+                        mem.alive = false;
+                        mem.ported = false;
+                        Say(p, "left");
+                    }
+                    return;
+                }
+                case PREP:
+                case FIGHT:
+                    if (!mem.ported)
+                    {
+                        // never made it in before the gates closed: out of this match
+                        mem.done = true;
+                        mem.left = true;
+                        guard.unlock();
+                        Say(p, "left");
+                        return;
+                    }
+                    if (!here)
+                        break;
+                    QuietRing(p, m);
+                    if (m.phase == PREP && !mem.sentPrep)
+                    {
+                        mem.sentPrep = true;
+                        uint32 left = (PREP_MS - std::min(PREP_MS, m.clock)) / IN_MILLISECONDS;
+                        guard.unlock();
+                        if (!p->IsAlive())
+                            p->ResurrectPlayer(1.0f);
+                        StripAndReset(p);
+                        SetFaction(p, TEAM_FACTION[0]);     // everyone friendly while the gates are shut
+                        p->SetImmobilizedState(true);
+                        Say(p, "prep," + std::to_string(left));
+                        return;
+                    }
+                    if (m.phase == FIGHT && !mem.sentGo)
+                    {
+                        mem.sentGo = true;
+                        uint8 team = mem.team;
+                        guard.unlock();
+                        StripBuffs(p);                      // whatever was drunk during preparation
+                        p->SetImmobilizedState(false);
+                        SetFaction(p, TEAM_FACTION[team]);
+                        p->UpdatePvP(true, true);
+                        Say(p, "go");
+                        return;
+                    }
+                    break;
+                case ENDING:
+                case DONE:
+                    if (!mem.sentEnd)
+                    {
+                        mem.sentEnd = true;
+                        int won = m.winner == 2 ? 2 : (m.winner == int(mem.team) ? 1 : 0);
+                        std::string line = m.winner < 0 ? std::string("end,2,0,") + std::to_string(mem.rating)
+                                                        : "end," + std::to_string(won) + "," + std::to_string(mem.delta) + "," + std::to_string(mem.rating);
+                        guard.unlock();
+                        Say(p, line);
+                        return;
+                    }
+                    if (m.phase == DONE || m.clock >= END_MS)
+                    {
+                        mem.done = true;
+                        mem.sentHome = true;
+                        Member copy = mem;
+                        bool wasPorted = mem.ported;
+                        guard.unlock();
+                        if (wasPorted)
+                            SendHome(p, copy);
+                        return;
+                    }
+                    break;
+            }
+        }
+    }
+}
diff --git a/src/game/OpenVanilla/WarfrontArena.h b/src/game/OpenVanilla/WarfrontArena.h
new file mode 100644
index 000000000..3ef56a843
--- /dev/null
+++ b/src/game/OpenVanilla/WarfrontArena.h
@@ -0,0 +1,66 @@
+/*
+ * Open Vanilla — Warfront arena (GPLv2, as CMaNGOS). Part of Warfront.h.
+ *
+ * 1.12.1 has no arena, so it is built here: queues and matchmaking on the world thread, and each
+ * match in its own fresh copy of Blackrock Depths with both teams in the Ring of Law.
+ *
+ * Modes:  s2 s3  skirmish 2v2, 3v3 (unrated)    r2 r3  rated 2v2, 3v3    d1  rated duel ladder 1v1
+ * Commands (".wnl wf q <cmd>"):
+ *   join <mode>    queue alone, or with your whole party when you lead one of the mode's size
+ *   leave          leave the queue (not a match)
+ *   status         WQ q,<mode>,<seconds waited>,<players queued in that mode> | WQ none
+ *   rating         WQ r,<r2>,<r3>,<d1>
+ *   top <mode>     WQ top,<mode>;<name>,<rating>;...  (the 10 best in a rated mode)
+ * Lines the addon gets (tag WQ):
+ *   q,<mode>,<waited>,<queued>   pop,<mode>,<match>,<team 0|1>   prep,<seconds left>   go
+ *   end,<won 0|1|2 draw>,<rating change>,<new rating>   left   err,<reason>
+ * Rules: 60 s preparation (rooted, both teams friendly), flasks/elixirs/world buffs removed and
+ * health, mana and cooldowns up to 10 minutes reset on entry; 15 minutes, then the team with more
+ * health left wins; leaving a rated match is a loss and locks the queue for 15 minutes; teams may
+ * mix factions (each team gets one faction for the match).
+ */
+
+#ifndef OPENVANILLA_WARFRONT_ARENA_H
+#define OPENVANILLA_WARFRONT_ARENA_H
+
+#include "Common.h"
+
+#include <string>
+#include <vector>
+
+class Player;
+
+namespace Warfront
+{
+    namespace Arena
+    {
+        // World::Update, before the maps update (the world thread): queues, matchmaking, match clocks.
+        void WorldUpdate(uint32 diff);
+        // The player's own update (map thread): teleports, preparation, reports, leaving.
+        void Update(Player* player, uint32 diff);
+        // ".wnl wf q ..." (run from the player's update).
+        void Command(Player* player, std::string const& args);
+        void Forget(uint32 guidLow);
+        bool InQueue(Player* player);
+        bool InMatch(Player* player);
+        // A teleport into (or an entry to) map `mapId` is this player's arena match: the dungeon's
+        // entrance checks (player cap, hourly instance limit) don't apply. False on other realms.
+        bool SkipEntryChecks(Player* player, uint32 mapId);
+        // The live counts line (Warfront::LiveCounts), refreshed every 2 seconds.
+        std::string Live();
+        uint32 RealBgQueuedNow();
+        // The best arena rating any character of this account has reached.
+        uint32 BestRating(uint32 accountId);
+
+        // ── pure helpers for the unit tests ──
+        // Teams of `size` made from tickets (each a party of 1..size players), oldest first; a
+        // ticket is never split. Returns the tickets' indexes per team.
+        std::vector<std::vector<size_t>> FormTeams(std::vector<size_t> const& ticketSizes, size_t size);
+        // Whether two teams' ratings are close enough to meet after waiting `waitedSec` seconds.
+        bool RatingsMeet(uint32 a, uint32 b, uint32 waitedSec);
+        // Who wins at the time limit: 0, 1, or 2 for a draw, from the teams' health fractions.
+        int TimeLimitWinner(float health0, float health1);
+    }
+}
+
+#endif
diff --git a/src/game/OpenVanilla/WarfrontLogic.cpp b/src/game/OpenVanilla/WarfrontLogic.cpp
new file mode 100644
index 000000000..514456780
--- /dev/null
+++ b/src/game/OpenVanilla/WarfrontLogic.cpp
@@ -0,0 +1,157 @@
+/*
+ * Open Vanilla — Warfront's pure rules (GPLv2, as CMaNGOS): no game objects, so they build and run in
+ * the unit test (realm/warfront/tests/test_logic.cpp) without a server. Declared in Warfront.h and
+ * WarfrontArena.h.
+ */
+
+#include "OpenVanilla/Warfront.h"
+#include "OpenVanilla/WarfrontArena.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <set>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace Warfront
+{
+    // ── pure helpers ──
+
+    uint32 TierFor(uint32 bestRating, uint32 kills, uint32 t2Rating, uint32 t2Kills, uint32 t3Rating, uint32 t3Kills)
+    {
+        if (bestRating >= t3Rating || kills >= t3Kills)
+            return 3;
+        if (bestRating >= t2Rating || kills >= t2Kills)
+            return 2;
+        return 0;
+    }
+
+    std::string CleanSetName(std::string const& raw)
+    {
+        std::string out;
+        for (char c : raw)
+        {
+            unsigned char u = static_cast<unsigned char>(c);
+            if (std::isalnum(u) || c == ' ' || c == '\'' || c == '-')
+                out += c;
+        }
+        size_t a = out.find_first_not_of(' ');
+        if (a == std::string::npos)
+            return std::string();
+        size_t b = out.find_last_not_of(' ');
+        out = out.substr(a, b - a + 1);
+        std::string squeezed;                       // no runs of spaces
+        for (char c : out)
+            if (!(c == ' ' && !squeezed.empty() && squeezed.back() == ' '))
+                squeezed += c;
+        if (squeezed.size() > 24)
+            squeezed.resize(24);
+        while (!squeezed.empty() && squeezed.back() == ' ')
+            squeezed.pop_back();
+        return squeezed;
+    }
+
+    bool ParseSlotItems(std::string const& text, std::vector<std::pair<uint32, uint32>>& out)
+    {
+        out.clear();
+        if (text.empty() || text.back() == ',' || text.front() == ',' || text.find(",,") != std::string::npos)
+            return false;
+        std::set<uint32> seen;
+        std::istringstream in(text);
+        std::string part;
+        while (std::getline(in, part, ','))
+        {
+            size_t colon = part.find(':');
+            if (colon == std::string::npos || colon == 0 || colon + 1 >= part.size())
+                return false;
+            std::string a = part.substr(0, colon), b = part.substr(colon + 1);
+            if (a.size() > 2 || b.size() > 6 || !std::all_of(a.begin(), a.end(), ::isdigit) || !std::all_of(b.begin(), b.end(), ::isdigit))
+                return false;
+            uint32 slot = std::stoul(a), item = std::stoul(b);
+            if (slot >= 19 || slot == 3 || slot == 18   /* EQUIPMENT_SLOT_END, _BODY (shirt), _TABARD */ || !item || !seen.insert(slot).second)
+                return false;
+            out.emplace_back(slot, item);
+        }
+        return !out.empty();
+    }
+
+    int32 EloAfter(int32 mine, int32 theirs, bool won, int32 k)
+    {
+        double expected = 1.0 / (1.0 + std::pow(10.0, double(theirs - mine) / 400.0));
+        double delta = k * ((won ? 1.0 : 0.0) - expected);
+        int32 d = int32(std::lround(delta));
+        if (won && d < 1)
+            d = 1;
+        if (!won && d > -1)
+            d = -1;
+        return std::max<int32>(0, mine + d);
+    }
+
+    bool InHours(std::string const& spec, uint32 hour)
+    {
+        size_t dash = spec.find('-');
+        if (spec.empty() || dash == std::string::npos)
+            return true;
+        std::string a = spec.substr(0, dash), b = spec.substr(dash + 1);
+        auto digits = [](std::string const& t) { return !t.empty() && t.size() <= 2 && std::all_of(t.begin(), t.end(), ::isdigit); };
+        if (!digits(a) || !digits(b))
+            return true;
+        uint32 from = std::stoul(a) % 25, to = std::stoul(b) % 25;
+        hour %= 24;
+        if (from == to || (from == 0 && to == 24))
+            return true;
+        if (from < to)
+            return hour >= from && hour < to;
+        return hour >= from || hour < to;       // wraps past midnight
+    }
+
+    namespace Arena
+    {
+        // ── pure helpers ──
+
+        std::vector<std::vector<size_t>> FormTeams(std::vector<size_t> const& ticketSizes, size_t size)
+        {
+            std::vector<std::vector<size_t>> teams;
+            std::vector<bool> used(ticketSizes.size(), false);
+            for (size_t i = 0; i < ticketSizes.size(); ++i)
+            {
+                if (used[i] || ticketSizes[i] == 0 || ticketSizes[i] > size)
+                    continue;
+                std::vector<size_t> team{ i };
+                size_t have = ticketSizes[i];
+                used[i] = true;
+                for (size_t j = i + 1; j < ticketSizes.size() && have < size; ++j)
+                    if (!used[j] && ticketSizes[j] && have + ticketSizes[j] <= size)
+                    {
+                        team.push_back(j);
+                        have += ticketSizes[j];
+                        used[j] = true;
+                    }
+                if (have == size)
+                    teams.push_back(team);
+                else
+                    for (size_t t : team)       // not enough yet: give the tickets back
+                        used[t] = false;
+            }
+            return teams;
+        }
+
+        bool RatingsMeet(uint32 a, uint32 b, uint32 waitedSec)
+        {
+            uint32 window = 150 + 10 * std::min<uint32>(waitedSec, 120);   // widens to 1350 after 2 minutes
+            return (a > b ? a - b : b - a) <= window;
+        }
+
+        int TimeLimitWinner(float health0, float health1)
+        {
+            if (health0 > health1 + 0.0001f)
+                return 0;
+            if (health1 > health0 + 0.0001f)
+                return 1;
+            return 2;
+        }
+
+    }
+}
