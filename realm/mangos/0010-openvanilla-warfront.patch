+    // ── account progress and the first login ──
+
+    namespace
+    {
+        void LoadProgress(Player* p, State& st)
+        {
+            st.accountId = p->GetSession()->GetAccountId();
+            uint32 kills = p->GetUInt32Value(PLAYER_FIELD_LIFETIME_HONORABLE_KILLS);
+            st.accountGifted = false;
+            if (auto r = CharacterDatabase.PQuery("SELECT best_rating, max_kills, gifted FROM warfront_account WHERE account = %u", st.accountId))
+            {
+                Field* f = r->Fetch();
+                st.bestRating = f[0].GetUInt32();
+                st.maxKills = std::max(f[1].GetUInt32(), kills);
+                st.accountGifted = f[2].GetUInt32() != 0;
+            }
+            else
+                st.maxKills = kills;
+            CharacterDatabase.PExecute("INSERT INTO warfront_account (account, best_rating, max_kills) VALUES (%u, %u, %u) "
+                                       "ON DUPLICATE KEY UPDATE max_kills = GREATEST(max_kills, VALUES(max_kills))",
+                                       st.accountId, st.bestRating, st.maxKills);
+            st.bestRating = std::max(st.bestRating, Arena::BestRating(st.accountId));
+            Settings const& c = Conf();
+            st.tier = TierFor(st.bestRating, st.maxKills, c.t2Rating, c.t2Kills, c.t3Rating, c.t3Kills);
+            st.welcomed = bool(CharacterDatabase.PQuery("SELECT 1 FROM warfront_character WHERE guid = %u", p->GetGUIDLow()));
+        }
+
+        void GiveItem(Player* p, uint32 item, uint32 count)
+        {
+            ItemPosCountVec dest;
+            if (p->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, item, count) == EQUIP_ERR_OK)
+                if (Item* it = p->StoreNewItem(dest, item, true))
+                    p->SendNewItem(it, count, true, false);
+        }
+
+        // the race's own riding skill in 1.12.1 (the mounts' client-side check), beside skill 762
+        uint32 RaceRiding(uint8 race)
+        {
+            switch (race)
+            {
+                case RACE_HUMAN: return 148;                // Horse Riding
+                case RACE_ORC: return 149;                  // Wolf Riding
+                case RACE_NIGHTELF: return 150;             // Tiger Riding
+                case RACE_DWARF: return 152;                // Ram Riding
+                case RACE_TROLL: return 533;                // Raptor Riding
+                case RACE_GNOME: return 553;                // Mechanostrider Piloting
+                case RACE_UNDEAD: return 554;               // Undead Horsemanship
+                case RACE_TAUREN: return 713;               // Kodo Riding
+                default: return 0;
+            }
+        }
+
+        void Welcome(Player* p, State& st)
+        {
+            // every character: riding and the faction's epic mount, Engineering and First Aid at 300,
+            // bags. Nothing here can be sold (warfront_world.sql zeroes their sell price).
+            for (uint32 spell : { 33388u, 33391u, 4036u, 4037u, 4038u, 12656u, 3273u, 3274u, 7924u, 10846u })
+                if (!p->HasSpell(spell) && sSpellTemplate.LookupEntry<SpellEntry>(spell))
+                    p->learnSpell(spell, false);
+            p->SetSkill(762, 150, 150);                     // Riding (what the mount items ask for here)
+            if (uint32 race = RaceRiding(p->getRace()))
+                p->SetSkill(uint16(race), 150, 150);
+            p->SetSkill(202, 300, 300);                     // Engineering
+            p->SetSkill(129, 300, 300);                     // First Aid
+            bool onyxia = false;                            // Onyxia Hide Backpack is unique: one, then Traveler's Backpacks
+            for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+                if (!p->GetItemByPos(INVENTORY_SLOT_BAG_0, bag))
+                {
+                    uint32 item = onyxia ? 4500 : 17966;
+                    uint16 dest = 0;
+                    if (p->CanEquipNewItem(bag, dest, item, false) == EQUIP_ERR_OK && p->EquipNewItem(dest, item, true))
+                        onyxia = true;
+                    else if (!onyxia && p->CanEquipNewItem(bag, dest, 4500, false) == EQUIP_ERR_OK)
+                        p->EquipNewItem(dest, 4500, true);
+                }
+            GiveItem(p, p->GetTeam() == ALLIANCE ? 18776 : 18797, 1);   // Swift Palomino / Horn of the Swift Timber Wolf
+            // once per account: the gold and the starter supplies (so a new character isn't a gold mine)
+            if (!st.accountGifted)
+            {
+                GiveItem(p, 14530, 20);                     // Heavy Runecloth Bandage
+                GiveItem(p, 15993, 10);                     // Thorium Grenade
+                GiveItem(p, 13446, 5);                      // Major Healing Potion
+                GiveItem(p, 5634, 5);                       // Free Action Potion
+                p->ModifyMoney(int32(std::min<uint32>(Conf().welcomeGold, 200000)) * 10000);
+                CharacterDatabase.PExecute("UPDATE warfront_account SET gifted = 1 WHERE account = %u", st.accountId);
+                st.accountGifted = true;
+            }
+            CharacterDatabase.PExecute("INSERT IGNORE INTO warfront_character (guid, welcomed, created) VALUES (%u, 1, %u)",
+                                       p->GetGUIDLow(), uint32(time(nullptr)));
+            st.welcomed = true;
+        }
+
+        void SendHello(Player* p, State& st, bool first)
+        {
+            std::ostringstream b;
+            b << "1," << st.tier << ',' << st.maxKills << ',' << st.bestRating << ',' << (first ? 1 : 0);
+            Reply(p, "WF", b.str());
