+++ b/src/game/OpenVanilla/Warfront.cpp
@@ -0,0 +1,1128 @@
+/*
+ * Open Vanilla — Warfront: kits, the gear picker, enchants, consumables, shared gear sets, the first
+ * login and duel resets (GPLv2, as CMaNGOS). See Warfront.h. Arena is WarfrontArena.cpp.
+ */
+
+#include "OpenVanilla/Warfront.h"
+#include "OpenVanilla/WarfrontArena.h"
+#include "OpenVanilla/Play.h"
+#include "OpenVanilla/PlayState.h"
+#include "OpenVanilla/WnlFormat.h"
+
+#include "Chat/Chat.h"
+#include "Config/Config.h"
+#include "Database/DatabaseEnv.h"
+#include "Entities/Item.h"
+#include "Entities/Pet.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Log/Log.h"
+#include "Maps/Map.h"
+#include "Server/DBCStores.h"
+#include "Server/SQLStorages.h"
+#include "Server/WorldSession.h"
+#include "Spells/SpellMgr.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <ctime>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <unordered_map>
+
+namespace Warfront
+{
+    // ── settings ──
+
+    namespace
+    {
+        struct Mall { uint32 map; float x, y, r; };
+        struct Settings
+        {
+            bool on = false;
+            std::vector<Mall> malls;
+            uint32 t2Rating = 1600, t2Kills = 1500, t3Rating = 1850, t3Kills = 5000;
+            uint32 welcomeGold = 2000;
+            bool crossFactionBG = true;
+            bool botFill = true;
+            std::string botFillHours = "0-24";
+            uint32 botFillBelow = 10;
+        };
+
+        Settings const& Conf()
+        {
+            static Settings const s = []
+            {
+                Settings c;
+                ::Config& conf = MaNGOS::Singleton<::Config>::Instance();
+                c.on = conf.GetBoolDefault("OpenVanilla.Warfront", false);
+                std::string malls = conf.GetStringDefault("OpenVanilla.Warfront.Mall", "0 -13226.3 232.03 80");
+                std::istringstream in(malls);
+                std::string one;
+                while (std::getline(in, one, ';'))
+                {
+                    std::istringstream f(one);
+                    Mall m{};
+                    if (f >> m.map >> m.x >> m.y >> m.r)
+                        c.malls.push_back(m);
+                }
+                c.t2Rating = conf.GetIntDefault("OpenVanilla.Warfront.Tier2.Rating", 1600);
+                c.t2Kills = conf.GetIntDefault("OpenVanilla.Warfront.Tier2.Kills", 1500);
+                c.t3Rating = conf.GetIntDefault("OpenVanilla.Warfront.Tier3.Rating", 1850);
+                c.t3Kills = conf.GetIntDefault("OpenVanilla.Warfront.Tier3.Kills", 5000);
+                c.welcomeGold = conf.GetIntDefault("OpenVanilla.Warfront.WelcomeGold", 2000);
+                c.crossFactionBG = conf.GetBoolDefault("OpenVanilla.Warfront.CrossFactionBG", true);
+                c.botFill = conf.GetBoolDefault("OpenVanilla.Warfront.BotFill", true);
+                c.botFillHours = conf.GetStringDefault("OpenVanilla.Warfront.BotFill.Hours", "0-24");
+                c.botFillBelow = conf.GetIntDefault("OpenVanilla.Warfront.BotFill.Below", 10);
+                if (c.on)
+                    sLog.outString("Open Vanilla Warfront: on; %u mall area(s); tier 2 at %u rating or %u kills, tier 3 at %u or %u",
+                                   uint32(c.malls.size()), c.t2Rating, c.t2Kills, c.t3Rating, c.t3Kills);
+                return c;
+            }();
+            return s;
+        }
+    }
+
+    bool Enabled()
+    {
+        return Conf().on;
+    }
+
+    bool CrossFactionBG()
+    {
+        return Conf().on && Conf().crossFactionBG;
+    }
+
+    bool BotMayQueueBG(uint32 realQueued)
+    {
+        if (!Conf().on)
+            return true;                            // other realms: the bot settings decide alone
+        if (!Conf().botFill || realQueued >= Conf().botFillBelow)
+            return false;
+        time_t now = time(nullptr);
+        tm utc{};
+#if PLATFORM == PLATFORM_WINDOWS
+        gmtime_s(&utc, &now);
+#else
+        gmtime_r(&now, &utc);
+#endif
+        return InHours(Conf().botFillHours, uint32(utc.tm_hour));
+    }
+
+    std::string LiveCounts()
+    {
+        return Arena::Live();
+    }
+
+    uint32 RealBgQueued()
+    {
+        return Arena::RealBgQueuedNow();
+    }
+
+    bool IsRealmBot(Player const* player)
+    {
+        return player && player->GetSession() && player->GetSession()->GetRemoteAddress() == "disconnected/bot";
+    }
+
+    // ── world data (loaded once) ──
+
+    namespace
+    {
+        struct Kit
+        {
+            uint8 playerClass = 0;
+            bool alliance = true;
+            std::vector<std::pair<uint8, uint32>> items;    // slot, item (slot order)
+            std::vector<std::pair<uint8, uint32>> enchants; // slot, spell
+        };
+        struct Consumable { uint32 price; uint32 maxCount; };
+
+        std::once_flag g_dataOnce;
+        std::map<std::string, Kit> g_kits;
+        std::unordered_map<uint32, uint8> g_pool;           // item -> tier
+        std::set<std::pair<uint8, uint32>> g_enchants;      // slot, spell
+        std::unordered_map<uint32, Consumable> g_shop;
+
+        bool TableExists(char const* name)
+        {
+            auto r = WorldDatabase.PQuery("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = '%s'", name);
+            return r && r->Fetch()[0].GetUInt32() != 0;
+        }
+
+        void LoadData()
+        {
+            if (TableExists("warfront_kit"))
+                if (auto r = WorldDatabase.Query("SELECT kit, class, faction, slot, item FROM warfront_kit ORDER BY kit, slot"))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        Kit& k = g_kits[f[0].GetCppString()];
+                        k.playerClass = f[1].GetUInt8();
+                        k.alliance = f[2].GetCppString() == "Alliance";
+                        k.items.emplace_back(f[3].GetUInt8(), f[4].GetUInt32());
+                    }
+                    while (r->NextRow());
+            if (TableExists("warfront_kit_enchant"))
+                if (auto r = WorldDatabase.Query("SELECT kit, slot, spell FROM warfront_kit_enchant ORDER BY kit, slot"))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        auto it = g_kits.find(f[0].GetCppString());
+                        if (it != g_kits.end())
+                            it->second.enchants.emplace_back(f[1].GetUInt8(), f[2].GetUInt32());
+                    }
+                    while (r->NextRow());
+            if (TableExists("warfront_item_pool"))
+                if (auto r = WorldDatabase.Query("SELECT item, tier FROM warfront_item_pool"))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        g_pool[f[0].GetUInt32()] = f[1].GetUInt8();
+                    }
+                    while (r->NextRow());
+            if (TableExists("warfront_enchant"))
+                if (auto r = WorldDatabase.Query("SELECT slot, spell FROM warfront_enchant"))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        g_enchants.insert({ f[0].GetUInt8(), f[1].GetUInt32() });
+                    }
+                    while (r->NextRow());
+            if (TableExists("warfront_consumable"))
+                if (auto r = WorldDatabase.Query("SELECT item, price, max_count FROM warfront_consumable"))
+                    do
+                    {
+                        Field* f = r->Fetch();
+                        g_shop[f[0].GetUInt32()] = { f[1].GetUInt32(), std::max<uint32>(1, f[2].GetUInt32()) };
+                    }
+                    while (r->NextRow());
+            sLog.outString("Open Vanilla Warfront: %u kits, %u pool items, %u enchants, %u consumables",
+                           uint32(g_kits.size()), uint32(g_pool.size()), uint32(g_enchants.size()), uint32(g_shop.size()));
+        }
+
+        void EnsureData()
+        {
+            std::call_once(g_dataOnce, LoadData);
+        }
+
+        int PoolTier(uint32 item)
+        {
+            auto it = g_pool.find(item);
+            return it == g_pool.end() ? -1 : int(it->second);
+        }
+    }
+
+    // ── per-player state ──
+
+    namespace
+    {
+        struct State
+        {
+            std::mutex lock;
+            std::vector<std::pair<std::string, std::string>> queue;
+            bool started = false;
+            bool welcomed = true;           // false = this login is the character's first
+            uint32 bestRating = 0;
+            uint32 maxKills = 0;
+            uint32 tier = 0;
+            uint32 accountId = 0;
+            uint32 streak = 0;              // honorable kills since the last death (distinct victims)
+            std::vector<uint32> streakVictims;
+            uint32 bountyStreak = 0;        // the streak this player had when last killed (paid to every killer)
+            uint32 bountyAt = 0;            // when (ms)
+            bool wasDead = false;           // for the streak: any death ends it
+            uint32 toldBg = 0;              // the battleground instance the bot-fill line was sent for
+            bool accountGifted = true;      // the account's one-time gold and supplies already given
+        };
+
+        std::mutex g_lock;
+        std::unordered_map<uint32, std::shared_ptr<State>> g_states;
+
+        std::shared_ptr<State> StateOf(Player* player)
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            auto& slot = g_states[player->GetGUIDLow()];
+            if (!slot)
+                slot = std::make_shared<State>();
+            return slot;
+        }
+    }
+
+    void Forget(uint32 guidLow)
+    {
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            g_states.erase(guidLow);
+        }
+        Arena::Forget(guidLow);
+    }
+
+    // ── gear ──
+
+    namespace
+    {
+        uint32 ClassMask(Player* p) { return 1u << (p->getClass() - 1); }
+        uint32 RaceMask(Player* p) { return 1u << (p->getRace() - 1); }
+
+        // the equipment slots an inventory type may go into
+        std::vector<uint8> SlotsFor(uint32 invType, bool dualWield)
+        {
+            switch (invType)
+            {
+                case INVTYPE_HEAD: return { EQUIPMENT_SLOT_HEAD };
+                case INVTYPE_NECK: return { EQUIPMENT_SLOT_NECK };
+                case INVTYPE_SHOULDERS: return { EQUIPMENT_SLOT_SHOULDERS };
+                case INVTYPE_CHEST: case INVTYPE_ROBE: return { EQUIPMENT_SLOT_CHEST };
+                case INVTYPE_WAIST: return { EQUIPMENT_SLOT_WAIST };
+                case INVTYPE_LEGS: return { EQUIPMENT_SLOT_LEGS };
+                case INVTYPE_FEET: return { EQUIPMENT_SLOT_FEET };
+                case INVTYPE_WRISTS: return { EQUIPMENT_SLOT_WRISTS };
+                case INVTYPE_HANDS: return { EQUIPMENT_SLOT_HANDS };
+                case INVTYPE_FINGER: return { EQUIPMENT_SLOT_FINGER1, EQUIPMENT_SLOT_FINGER2 };
+                case INVTYPE_TRINKET: return { EQUIPMENT_SLOT_TRINKET1, EQUIPMENT_SLOT_TRINKET2 };
+                case INVTYPE_CLOAK: return { EQUIPMENT_SLOT_BACK };
+                case INVTYPE_WEAPON:
+                    if (dualWield)
+                        return { EQUIPMENT_SLOT_MAINHAND, EQUIPMENT_SLOT_OFFHAND };
+                    return { EQUIPMENT_SLOT_MAINHAND };
+                case INVTYPE_2HWEAPON: case INVTYPE_WEAPONMAINHAND: return { EQUIPMENT_SLOT_MAINHAND };
+                case INVTYPE_SHIELD: case INVTYPE_WEAPONOFFHAND: case INVTYPE_HOLDABLE: return { EQUIPMENT_SLOT_OFFHAND };
+                case INVTYPE_RANGED: case INVTYPE_THROWN: case INVTYPE_RANGEDRIGHT: case INVTYPE_RELIC: return { EQUIPMENT_SLOT_RANGED };
+                default: return {};
+            }
+        }
+
+        bool FitsSlot(ItemPrototype const* proto, uint8 slot, bool dualWield)
+        {
+            std::vector<uint8> s = SlotsFor(proto->InventoryType, dualWield);
+            return std::find(s.begin(), s.end(), slot) != s.end();
+        }
+
+        bool UsableBy(Player* p, ItemPrototype const* proto)
+        {
+            if (int32(proto->AllowableClass) != -1 && !(uint32(proto->AllowableClass) & ClassMask(p)))
+                return false;
+            if (int32(proto->AllowableRace) != -1 && !(uint32(proto->AllowableRace) & RaceMask(p)))
+                return false;
+            return true;
+        }
+
+        // Why gear can't change right now, or nullptr.
+        char const* Blocked(Player* p)
+        {
+            if (!p->IsAlive())
+                return "dead";
+            if (p->IsInCombat())
+                return "combat";
+            if (p->InBattleGround() || p->GetMap()->Instanceable() || Arena::InMatch(p))
+                return "instance";
+            if (p->InBattleGroundQueue() || Arena::InQueue(p))
+                return "queue";
+            return nullptr;
+        }
+
+        // Empty an equipment slot: free items the player can pick again at their tier (and white or
+        // grey starting gear) go away; anything else goes to the bags, or the change is refused.
+        bool ClearSlot(Player* p, uint8 slot, uint32 tier, char const*& err)
+        {
+            Item* old = p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+            if (!old)
+                return true;
+            ItemPrototype const* proto = old->GetProto();
+            int t = PoolTier(old->GetEntry());
+            if ((t >= 0 && uint32(t) <= tier) || proto->Quality <= ITEM_QUALITY_NORMAL)
+            {
+                p->DestroyItem(INVENTORY_SLOT_BAG_0, slot, true);
+                return true;
+            }
+            ItemPosCountVec dest;
+            if (p->CanStoreItem(NULL_BAG, NULL_SLOT, dest, old, false) != EQUIP_ERR_OK)
+            {
+                err = "bags";
+                return false;
+            }
+            p->RemoveItem(INVENTORY_SLOT_BAG_0, slot, true);
+            p->StoreItem(dest, old, true);
+            return true;
+        }
+
+        // Put a pool item on, in that slot. err set on failure.
+        bool Wear(Player* p, uint8 slot, uint32 itemId, uint32 tier, char const*& err)
+        {
+            ItemPrototype const* proto = sObjectMgr.GetItemPrototype(itemId);
+            int t = PoolTier(itemId);
+            if (!proto || t < 0)
+            {
+                err = "item";
+                return false;
+            }
+            if (uint32(t) > tier)
+            {
+                err = "tier";
+                return false;
+            }
+            if (!UsableBy(p, proto))
+            {
+                err = "class";
+                return false;
+            }
+            if (!FitsSlot(proto, slot, p->CanDualWield()))
+            {
+                err = "slot";
+                return false;
+            }
+            // already wearing it there: nothing to do
+            if (Item* cur = p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                if (cur->GetEntry() == itemId)
+                    return true;
+            // can the character wear it at all (skill, level, unique in the bags)? Checked with the
+            // slot treated as free, before anything is taken off.
+            {
+                uint16 probe = 0;
+                InventoryResult res = p->CanEquipNewItem(slot, probe, itemId, true);
+                bool elsewhere = false;     // a unique ring/trinket worn in the other slot is moved below
+                for (uint8 other : SlotsFor(proto->InventoryType, true))
+                    if (Item* o = p->GetItemByPos(INVENTORY_SLOT_BAG_0, other))
+                        if (other != slot && o->GetEntry() == itemId)
+                            elsewhere = true;
+                if (res != EQUIP_ERR_OK && res != EQUIP_ERR_CANT_EQUIP_WITH_TWOHANDED && !(elsewhere && res == EQUIP_ERR_ITEM_CANT_BE_EQUIPPED))
+                {
+                    err = res == EQUIP_ERR_NO_REQUIRED_PROFICIENCY ? "skill" : "item";
+                    return false;
+                }
+            }
+            // a two-hander empties the off hand; an off-hand item needs a one-handed main hand
+            if (slot == EQUIPMENT_SLOT_MAINHAND && proto->InventoryType == INVTYPE_2HWEAPON)
+                if (!ClearSlot(p, EQUIPMENT_SLOT_OFFHAND, tier, err))
+                    return false;
+            if (slot == EQUIPMENT_SLOT_OFFHAND)
+                if (Item* mh = p->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_MAINHAND))
+                    if (mh->GetProto()->InventoryType == INVTYPE_2HWEAPON)
+                    {
+                        err = "twohand";
+                        return false;
+                    }
+            // the same unique item in the other ring or trinket slot: take it off first
+            if (proto->MaxCount == 1 || (proto->Flags & ITEM_FLAG_UNIQUE_EQUIPPABLE))
+                for (uint8 other : SlotsFor(proto->InventoryType, true))
+                    if (other != slot)
+                        if (Item* o = p->GetItemByPos(INVENTORY_SLOT_BAG_0, other))
+                            if (o->GetEntry() == itemId && !ClearSlot(p, other, tier, err))
+                                return false;
+            if (!ClearSlot(p, slot, tier, err))
+                return false;
+            uint16 dest = 0;
+            InventoryResult res = p->CanEquipNewItem(slot, dest, itemId, false);
+            if (res != EQUIP_ERR_OK)
+            {
+                err = res == EQUIP_ERR_NO_REQUIRED_PROFICIENCY ? "skill" : "item";
+                return false;
+            }
+            if (!p->EquipNewItem(dest, itemId, true))
+            {
+                err = "item";
+                return false;
+            }
+            return true;
+        }
+
+        uint32 EnchantIdOf(SpellEntry const* sp)
+        {
+            for (int i = 0; i < MAX_EFFECT_INDEX; ++i)
+                if (sp->Effect[i] == SPELL_EFFECT_ENCHANT_ITEM)
+                    return uint32(sp->EffectMiscValue[i]);
+            return 0;
+        }
+
+        bool Enchant(Player* p, uint8 slot, uint32 spellId, char const*& err)
+        {
+            if (!g_enchants.count({ slot, spellId }))
+            {
+                err = "enchant";
+                return false;
+            }
+            Item* item = p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot);
+            SpellEntry const* sp = sSpellTemplate.LookupEntry<SpellEntry>(spellId);
+            uint32 enchantId = sp ? EnchantIdOf(sp) : 0;
+            if (!item || !sp || !enchantId || !sSpellItemEnchantmentStore.LookupEntry(enchantId))
+            {
+                err = "enchant";
+                return false;
+            }
+            if (!item->IsFitToSpellRequirements(sp))
+            {
+                err = "slot";
+                return false;
+            }
+            if (item->GetEnchantmentId(PERM_ENCHANTMENT_SLOT) == enchantId)
+                return true;
+            p->ApplyEnchantment(item, PERM_ENCHANTMENT_SLOT, false);
+            item->SetEnchantment(PERM_ENCHANTMENT_SLOT, enchantId, 0, 0, p->GetObjectGuid());
+            p->ApplyEnchantment(item, PERM_ENCHANTMENT_SLOT, true);
+            return true;
+        }
+
+        void Reply(Player* p, char const* tag, std::string const& body)
+        {
+            OwPlay::Send(p, tag, body);
+        }
+
+        std::string Err(char const* reason) { return std::string("err,") + reason; }
+    }
