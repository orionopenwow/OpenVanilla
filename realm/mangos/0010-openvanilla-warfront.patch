+    // ── commands ──
+
+    bool HandleCommand(Player* player, char const* args)
+    {
+        if (!player || !args)
+            return false;
+        std::istringstream in(args);
+        std::string cmd;
+        in >> cmd;
+        std::transform(cmd.begin(), cmd.end(), cmd.begin(), ::tolower);
+        if (cmd != "wf")
+            return false;
+        std::string sub;
+        in >> sub;
+        std::transform(sub.begin(), sub.end(), sub.begin(), ::tolower);
+        std::string rest;
+        std::getline(in, rest);
+        size_t start = rest.find_first_not_of(' ');
+        rest = start == std::string::npos ? std::string() : rest.substr(start);
+        if (!Enabled())
+        {
+            OwPlay::Send(player, "WF", "0");
+            return true;
+        }
+        std::shared_ptr<State> st = StateOf(player);
+        std::lock_guard<std::mutex> guard(st->lock);
+        if (st->queue.size() >= 8)
+            return true;                            // flooding: the extra lines are dropped
+        st->queue.emplace_back(sub, rest);
+        return true;
+    }
+
+    namespace
+    {
+        void Run(Player* p, State& st, std::string const& cmd, std::string const& args)
+        {
+            std::istringstream in(args);
+            if (cmd == "hi")
+                return SendHello(p, st, false);
+            if (cmd == "pool")
+            {
+                uint32 slot = 99;
+                in >> slot;
+                if (slot >= EQUIPMENT_SLOT_END)
+                    return Reply(p, "WP", Err("slot"));
+                std::vector<std::pair<uint32, uint8>> list;
+                for (auto const& it : g_pool)
+                    if (ItemPrototype const* proto = sObjectMgr.GetItemPrototype(it.first))
+                        if (UsableBy(p, proto) && FitsSlot(proto, uint8(slot), p->CanDualWield()))
+                            list.emplace_back(it.first, it.second);
+                std::sort(list.begin(), list.end());
+                std::ostringstream b;
+                b << slot;
+                for (auto const& e : list)
+                    b << ';' << e.first << ',' << uint32(e.second);
+                return Reply(p, "WP", b.str());
+            }
+            if (cmd == "sets")
+            {
+                std::string spec;
+                std::getline(in, spec);
+                return ListSets(p, spec);
+            }
+            if (cmd == "vote" || cmd == "report")
+            {
+                uint32 id = 0;
+                in >> id;
+                return cmd == "vote" ? Vote(p, st, id) : Report(p, st, id);
+            }
+            if (cmd == "share")
+                return Share(p, st, args);
+            if (cmd == "q")
+                return Arena::Command(p, args);
+            if (cmd == "live")
+                return Reply(p, "WC", LiveCounts());
+            if (cmd == "streak")                    // staff test hook: set your own kill streak
+            {
+                if (p->GetSession()->GetSecurity() < SEC_GAMEMASTER)
+                    return Reply(p, "WD", Err("command"));
+                uint32 n = 0;
+                in >> n;
+                std::lock_guard<std::mutex> guard(g_lock);
+                st.streak = std::min<uint32>(n, 100);
+                st.streakVictims.clear();
+                st.bountyAt = 0;
+                return Reply(p, "WD", "streak," + std::to_string(st.streak));
+            }
+
+            // everything below changes the character
+            char const* blocked = Blocked(p);
+            char const* tag = cmd == "kit" || cmd == "apply" ? "WK" : cmd == "slot" ? "WS" : cmd == "ench" ? "WE" : cmd == "buy" ? "WB" : nullptr;
+            if (!tag)
+                return;
+            if (blocked && !(cmd == "buy" && std::string(blocked) == "queue"))
+                return Reply(p, tag, Err(blocked));
+            if (cmd == "kit")
+            {
+                std::string key;
+                in >> key;
+                auto it = g_kits.find(key);
+                if (it == g_kits.end())
+                    return Reply(p, "WK", Err("key"));
+                Kit const& kit = it->second;
+                if (kit.playerClass != p->getClass())
+                    return Reply(p, "WK", Err("class"));
+                if (kit.alliance != (p->GetTeam() == ALLIANCE))
+                    return Reply(p, "WK", Err("faction"));
+                OwPlay::AutoLearn::Run(p, false);   // weapon skills before the weapons
+                uint32 worn = 0, enchanted = 0;
+                char const* firstErr = nullptr;
+                for (auto const& si : kit.items)
+                {
+                    char const* err = nullptr;
+                    if (Wear(p, si.first, si.second, 3, err))   // kit items are all tier 0
+                        ++worn;
+                    else if (!firstErr)
+                        firstErr = err;
+                }
+                for (auto const& se : kit.enchants)
+                {
+                    char const* err = nullptr;
+                    if (Enchant(p, se.first, se.second, err))
+                        ++enchanted;
+                }
+                if (firstErr && !worn)
+                    return Reply(p, "WK", Err(firstErr));
+                return Reply(p, "WK", "ok," + key + "," + std::to_string(worn) + "," + std::to_string(enchanted));
+            }
+            if (cmd == "slot")
+            {
+                uint32 slot = 99, item = 0;
+                in >> slot >> item;
+                char const* err = nullptr;
+                if (slot >= EQUIPMENT_SLOT_END || slot == EQUIPMENT_SLOT_BODY || slot == EQUIPMENT_SLOT_TABARD)
+                    return Reply(p, "WS", Err("slot"));
+                OwPlay::AutoLearn::Run(p, false);
+                if (!Wear(p, uint8(slot), item, st.tier, err))
+                    return Reply(p, "WS", Err(err));
+                return Reply(p, "WS", "ok," + std::to_string(slot) + "," + std::to_string(item));
+            }
+            if (cmd == "ench")
+            {
+                uint32 slot = 99, spell = 0;
+                in >> slot >> spell;
+                char const* err = nullptr;
+                if (slot >= EQUIPMENT_SLOT_END || !Enchant(p, uint8(slot), spell, err))
+                    return Reply(p, "WE", Err(err ? err : "slot"));
+                return Reply(p, "WE", "ok," + std::to_string(slot) + "," + std::to_string(spell));
+            }
+            if (cmd == "buy")
+            {
+                uint32 item = 0, count = 1;
+                in >> item >> count;
+                auto it = g_shop.find(item);
+                if (it == g_shop.end())
+                    return Reply(p, "WB", Err("item"));
+                count = std::max<uint32>(1, std::min(count, it->second.maxCount));
+                uint64 cost = uint64(it->second.price) * count;
+                if (cost > p->GetMoney())
+                    return Reply(p, "WB", Err("money"));
+                ItemPosCountVec dest;
+                if (p->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, item, count) != EQUIP_ERR_OK)
+                    return Reply(p, "WB", Err("bags"));
+                if (Item* made = p->StoreNewItem(dest, item, true))
+                {
+                    p->ModifyMoney(-int32(cost));
+                    p->SendNewItem(made, count, true, false);
+                }
+                return Reply(p, "WB", "ok," + std::to_string(item) + "," + std::to_string(count));
+            }
+            if (cmd == "apply")
+            {
+                uint32 id = 0;
+                in >> id;
+                OwPlay::AutoLearn::Run(p, false);
+                return ApplySet(p, st, id);
+            }
+        }
+    }
+
+    namespace
+    {
+        // Any death ends a streak. A player's honorable death already took it (and paid the bounty);
+        // a death to a creature, a guard, a fall or a dishonorable kill takes it here, unpaid.
+        void WatchDeath(Player* player, State& st)
+        {
+            bool dead = !player->IsAlive();
+            if (dead == st.wasDead)
+                return;
+            st.wasDead = dead;
+            if (!dead)
+                return;
+            uint32 lost = 0;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                if (st.streak && (!st.bountyAt || WorldTimer::getMSTimeDiff(st.bountyAt, WorldTimer::getMSTime()) > 2000))
+                {
+                    lost = st.streak;
+                    st.streak = 0;
+                    st.streakVictims.clear();
+                }
+            }
+            if (lost >= 5 && !player->GetMap()->Instanceable())
+            {
+                std::string body = "ended," + std::string(player->GetName()) + "," + std::to_string(lost);
+                Map* map = player->GetMap();
+                uint32 zone = player->GetZoneId();
+                for (auto const& ref : map->GetPlayers())
+                    if (Player* p = ref.getSource())
+                        if (p->GetZoneId() == zone)
+                            OwPlay::Send(p, "WN", body);
+            }
+        }
+
+        // A mixed-faction battleground: play as the side the queue gave (team and faction: honor,
+        // flags, graveyards and who is an enemy all follow it), and as the race's own side again once
+        // out of the battle. Changing the race's team goes through setFactionForRace with a race of
+        // the wanted side, which sets both the team and that race's player faction.
+        void ApplyBGTeam(Player* player)
+        {
+            Team own = Player::TeamForRace(player->getRace());
+            Team want = own;
+            // only on the battleground's own map: an invite accepted whose port then fails (or a
+            // battle that ended mid-teleport) must never leave a player in a city as the other side
+            if (CrossFactionBG() && player->InBattleGround() && player->GetMap()->IsBattleGround() && !player->IsBeingTeleported())
+            {
+                Team bg = player->GetBGTeam();      // the queue's side while in a battle (else the current team)
+                if (bg == ALLIANCE || bg == HORDE)
+                    want = bg;
+            }
+            if (want == player->GetTeam())
+                return;
+            player->setFactionForRace(want == own ? player->getRace() : (want == ALLIANCE ? uint8(RACE_HUMAN) : uint8(RACE_ORC)));
+            if (Pet* pet = player->GetPet())
+                pet->setFaction(player->GetFaction());
+        }
+
+        // Entering a battle that has realm bots in it: say so, once per battle (the bot-fill label).
+        void TellBotFill(Player* player, State& st)
+        {
+            if (!player->InBattleGround() || !player->GetMap()->IsBattleGround() || IsRealmBot(player))
+            {
+                if (!player->InBattleGround())
+                    st.toldBg = 0;
+                return;
+            }
+            uint32 id = player->GetMap()->GetInstanceId();
+            if (st.toldBg == id)
+                return;
+            st.toldBg = id;
+            uint32 bots = 0, people = 0;
+            for (auto const& ref : player->GetMap()->GetPlayers())
+                if (Player* p = ref.getSource())
+                    (IsRealmBot(p) ? bots : people) += 1;
+            if (!bots)
+                return;
+            OwPlay::Send(player, "WG", "bots," + std::to_string(bots) + "," + std::to_string(people));
+            ChatHandler(player).PSendSysMessage("|cffffd100[Warfront]|r %u of the players in this battle are realm bots, filling empty spots while few people are queued. Bots never count for streaks or bounties.", bots);
+        }
+    }
+
+    void Update(Player* player, uint32 diff)
+    {
+        if (!Enabled() || !player || !player->GetSession() || !player->IsInWorld())
+            return;
+        EnsureData();
+        std::shared_ptr<State> held = StateOf(player);
+        State& st = *held;
+        if (!st.started)
+        {
+            st.started = true;
+            LoadProgress(player, st);
+            if (!st.welcomed)
+            {
+                Welcome(player, st);
+                SendHello(player, st, true);
+            }
+        }
+        // at most three commands an update: each may query the database on this map's thread
+        std::vector<std::pair<std::string, std::string>> queue;
+        {
+            std::lock_guard<std::mutex> guard(st.lock);
+            size_t n = std::min<size_t>(3, st.queue.size());
+            queue.assign(st.queue.begin(), st.queue.begin() + n);
+            st.queue.erase(st.queue.begin(), st.queue.begin() + n);
+        }
+        for (auto const& c : queue)
+            Run(player, st, c.first, c.second);
+        Arena::Update(player, diff);
+        ApplyBGTeam(player);
+        WatchDeath(player, st);
+        TellBotFill(player, st);
+    }
+
+    // ── duel resets in the mall ──
+
+    namespace
+    {
+        bool InMall(Player* p)
+        {
+            for (Mall const& m : Conf().malls)
+                if (p->GetMapId() == m.map)
+                {
+                    float dx = p->GetPositionX() - m.x, dy = p->GetPositionY() - m.y;
+                    if (dx * dx + dy * dy <= m.r * m.r)
+                        return true;
+                }
+            return false;
+        }
+
+        void Refresh(Player* p)
+        {
+            if (!p->IsAlive())
+                return;
+            p->SetHealth(p->GetMaxHealth());
+            if (p->GetPowerType() == POWER_MANA)
+                p->SetPower(POWER_MANA, p->GetMaxPower(POWER_MANA));
+            if (p->GetPowerType() == POWER_RAGE)
+                p->SetPower(POWER_RAGE, 0);
+            if (p->GetPowerType() == POWER_ENERGY)
+                p->SetPower(POWER_ENERGY, p->GetMaxPower(POWER_ENERGY));
+            // cooldowns of 10 minutes or less (Blind, Cold Snap, Shield Wall ...), not longer ones
+            p->RemoveSomeCooldown([](SpellEntry const& e)
+            {
+                return e.RecoveryTime <= 10 * MINUTE * IN_MILLISECONDS && e.CategoryRecoveryTime <= 10 * MINUTE * IN_MILLISECONDS;
+            });
+        }
+    }
+
+    void OnDuelComplete(Player* a, Player* b, uint8 completeType)
+    {
+        if (!Enabled() || !a || !b || completeType == DUEL_INTERRUPTED)
+            return;
+        if (!InMall(a) || !InMall(b))
+            return;
+        Refresh(a);
+        Refresh(b);
+    }
+}
+
+// ── bounties ──
+
+namespace Warfront
+{
+    namespace
+    {
+        void TellZone(Player* about, std::string const& body)
+        {
+            Map* map = about->GetMap();
+            uint32 zone = about->GetZoneId();
+            for (auto const& ref : map->GetPlayers())
+                if (Player* p = ref.getSource())
+                    if (p->GetZoneId() == zone)
+                        OwPlay::Send(p, "WN", body);
+        }
+    }
+
+    void OnHonorableKill(Player* killer, Player* victim)
+    {
+        if (!Enabled() || !killer || !victim || killer == victim)
+            return;
+        if (killer->GetMap()->Instanceable() || Arena::InMatch(killer))
+            return;                         // the open world only
+        if (IsRealmBot(killer) || IsRealmBot(victim))
+            return;                         // bots never make or pay a streak
+        std::shared_ptr<State> vs = StateOf(victim);
+        std::shared_ptr<State> ks = StateOf(killer);
+        uint32 victimStreak = 0, mine = 0;
+        bool counted = false;
+        uint32 now = WorldTimer::getMSTime();
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            // this is called once per credited killer: the first call of a death takes the streak,
+            // the others (within two seconds) are paid from the same snapshot
+            if (WorldTimer::getMSTimeDiff(vs->bountyAt, now) > 2000 || !vs->bountyAt)
+            {
+                vs->bountyStreak = vs->streak;
+                vs->bountyAt = now;
+                vs->streak = 0;
+                vs->streakVictims.clear();
+            }
+            victimStreak = vs->bountyStreak;
+            // a streak counts different victims only: killing the same alt again adds nothing
+            uint32 vg = victim->GetGUIDLow();
+            if (std::find(ks->streakVictims.begin(), ks->streakVictims.end(), vg) == ks->streakVictims.end())
+            {
+                ks->streakVictims.push_back(vg);
+                if (ks->streakVictims.size() > 15)
+                    ks->streakVictims.erase(ks->streakVictims.begin());
+                mine = ++ks->streak;
+                counted = true;
+            }
+        }
+        if (victimStreak >= 5)
+        {
+            uint32 gold = 25 * (std::min<uint32>(victimStreak, 15) / 5);
+            killer->ModifyMoney(int32(gold) * 10000);
+            OwPlay::Send(killer, "WN", "paid," + std::string(victim->GetName()) + "," + std::to_string(gold));
+        }
+        if (counted && (mine == 5 || mine == 10 || mine == 15))
+        {
+            std::string zone;
+            if (AreaTableEntry const* area = GetAreaEntryByAreaID(killer->GetZoneId()))
+                zone = area->area_name[0];
+            TellZone(killer, "streak," + std::string(killer->GetName()) + "," + std::to_string(mine) + "," + WnlFormat::Clean(zone));
+        }
+    }
+}
+
+// Called at the top of Wnl::HandleCommand (declared there, in Wnl.cpp).
+namespace Wnl
+{
+    bool WarfrontCommand(Player* player, char const* args)
+    {
+        return Warfront::HandleCommand(player, args);
+    }
+}
diff --git a/src/game/OpenVanilla/Warfront.h b/src/game/OpenVanilla/Warfront.h
new file mode 100644
index 000000000..9138ef805
--- /dev/null
+++ b/src/game/OpenVanilla/Warfront.h
@@ -0,0 +1,104 @@
+/*
+ * Open Vanilla — Warfront, the instant-60 PvP realm (GPLv2, as CMaNGOS).
+ *
+ * Off unless mangosd.conf says  OpenVanilla.Warfront = 1  (the Classic+ realm never sets it).
+ * Everything else in this file is a no-op while it is off.
+ *
+ * Settings (mangosd.conf, all optional):
+ *   OpenVanilla.Warfront                  0|1   the realm is Warfront
+ *   OpenVanilla.Warfront.Mall             "0 -13226.3 232.03 80"  "<map> <x> <y> <radius>;..." where a
+ *                                           finished duel resets both players (default: Gurubashi Arena)
+ *   OpenVanilla.Warfront.Tier2.Rating     1600  arena rating that unlocks tier 2 (or the kills below)
+ *   OpenVanilla.Warfront.Tier2.Kills      1500  lifetime honorable kills that unlock tier 2
+ *   OpenVanilla.Warfront.Tier3.Rating     1850
+ *   OpenVanilla.Warfront.Tier3.Kills      5000
+ *   OpenVanilla.Warfront.WelcomeGold      2000  gold given once, at the first login
+ *   OpenVanilla.Warfront.CrossFactionBG   1     battleground queues mix factions: each group is put on
+ *                                           the side with fewer players queued, and plays the match
+ *                                           with that side's faction (its own again on the way out)
+ *   OpenVanilla.Warfront.BotFill          1     realm bots may fill battlegrounds (0 = never)
+ *   OpenVanilla.Warfront.BotFill.Hours    "0-24" UTC hours bots may fill, "a-b" (b exclusive; may wrap: "22-14")
+ *   OpenVanilla.Warfront.BotFill.Below    10    and only while fewer than this many real players are queued
+ *                                           for battlegrounds; everyone in a battle with bots is told so
+ *
+ * World database: warfront_kit, warfront_kit_enchant, warfront_item_pool, warfront_enchant,
+ * warfront_consumable (realm/warfront/ SQL files). Characters database: warfront_character,
+ * warfront_account, warfront_shared_set, warfront_set_vote, warfront_set_report.
+ *
+ * Commands (".wnl wf <cmd> ...", from the Warfront addon) and their answers (addon lines, the
+ * same channel as OwPlay::Send):
+ *   hi                          WF <on 1>,<tier>,<kills>,<bestRating>,<firstLogin 0|1>
+ *   kit <key>                   WK ok,<key>,<items>,<enchants> | WK err,<reason>
+ *   slot <slot> <item>          WS ok,<slot>,<item> | WS err,<reason>
+ *   ench <slot> <spell>         WE ok,<slot>,<spell> | WE err,<reason>
+ *   pool <slot>                 WP <slot>;<item>,<tier>;...        items this class may wear there
+ *   buy <item> <count>          WB ok,<item>,<count> | WB err,<reason>
+ *   share <spec>~<name>~<s>:<i>,<s>:<i>...   WH ok,<id> | WH err,<reason>
+ *   sets [<spec>]               WL <id>,<votes>,<owner>,<spec>,<name>,<s>:<i>/<s>:<i>...;...
+ *   vote <id>                   WV ok,<id>,<votes> | WV err,<reason>
+ *   report <id>                 WR ok,<id> | WR err,<reason>
+ *   apply <id>                  WK ok,set<id>,<applied>,<skipped> | WK err,<reason>
+ *   q ...                       the arena queue (WarfrontArena.h)
+ *   streak <n>                  WD streak,<n>   (game masters only: set your own kill streak, for tests)
+ *   live                        WC <s2>,<s3>,<r2>,<r3>,<d1>,<arena matches>,<bg queued>,<bg playing>,<bots in bgs>
+ * Bounty lines: WN streak,<name>,<kills>,<zone>  (to everyone in the zone)  WN paid,<name>,<gold>
+ *               WN ended,<name>,<kills>   (a streak of 5+ ended by a death that paid no bounty)
+ * Battleground line: WG bots,<bots>,<players>  (on entering a battle that has realm bots in it)
+ * Realm bots never count for streaks or bounties, as killers or as victims.
+ * Reasons: off combat dead busy instance queue key class tier slot item bags enchant money name
+ * full gone self voted.
+ */
+
+#ifndef OPENVANILLA_WARFRONT_H
+#define OPENVANILLA_WARFRONT_H
+
+#include "Common.h"
+
+#include <string>
+#include <vector>
+
+class Player;
+
+namespace Warfront
+{
+    bool Enabled();
+
+    // ".wnl wf ..." (world thread): true when the line was a Warfront command (queued for Update).
+    bool HandleCommand(Player* player, char const* args);
+    // Player::Update, via OwPlay::Update (the player's map thread).
+    void Update(Player* player, uint32 diff);
+    // WorldSession::LogoutPlayer.
+    void Forget(uint32 guidLow);
+    // Player::DuelComplete, before the duel data goes: a duel finished inside a mall area resets
+    // both players (health, mana, rage, energy, cooldowns up to 10 minutes).
+    void OnDuelComplete(Player* a, Player* b, uint8 completeType);
+    // Player::AddHonorCP, an honorable kill of a player (once per credited killer): kill streaks
+    // and bounties. 5, 10 and 15 kills without dying mark the player and tell their zone; killing
+    // a marked player pays every credited killer 25 gold per 5 kills of the streak.
+    void OnHonorableKill(Player* killer, Player* victim);
+
+    // Battlegrounds (BattleGroundQueue / BattleGroundHandler, the battleground queue thread).
+    bool CrossFactionBG();
+    // Whether a realm bot may join a battleground queue now (`realQueued`: real players queued).
+    bool BotMayQueueBG(uint32 realQueued);
+    // A realm (random) bot, not a person; a player's own self-bot (Herald) is a person.
+    bool IsRealmBot(Player const* player);
+    // The one line the site, Herald and /wf show: queue and match counts (WC above, without the tag).
+    std::string LiveCounts();
+    // Real players in battleground queues (refreshed every 2 seconds).
+    uint32 RealBgQueued();
+
+    // ── pure helpers (no game objects), kept public for the unit tests ──
+    // "a-b" UTC hours (b exclusive, may wrap past midnight); "0-24" or empty = always.
+    bool InHours(std::string const& spec, uint32 hour);
+    // Unlock tier from a best arena rating and lifetime honorable kills: 0, 2 or 3.
+    uint32 TierFor(uint32 bestRating, uint32 kills, uint32 t2Rating, uint32 t2Kills, uint32 t3Rating, uint32 t3Kills);
+    // A shared set's name: letters, digits, spaces, ' and -, trimmed, at most 24 characters; empty = refused.
+    std::string CleanSetName(std::string const& raw);
+    // "<slot>:<item>,<slot>:<item>,..." -> pairs; false on any malformed or out-of-range entry.
+    bool ParseSlotItems(std::string const& text, std::vector<std::pair<uint32, uint32>>& out);
+    // Elo: new rating for a player of `mine` who beat (won=true) or lost to `theirs`.
+    int32 EloAfter(int32 mine, int32 theirs, bool won, int32 k = 32);
+}
+
+#endif
diff --git a/src/game/OpenVanilla/WarfrontArena.cpp b/src/game/OpenVanilla/WarfrontArena.cpp
