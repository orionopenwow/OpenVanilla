diff --git a/src/shared/Config/Config.cpp b/src/shared/Config/Config.cpp
index dfcd7aa8e..d4d09c28f 100644
--- a/src/shared/Config/Config.cpp
+++ b/src/shared/Config/Config.cpp
@@ -50,6 +50,10 @@ bool Config::Reload()
         return false;
 
     std::unordered_map<std::string, std::string> newEntries;
+    // Open Vanilla: "OpenVanilla.X" is the documented spelling of the "OpenVanilla.X" settings the server
+    // reads; such lines are also stored under the old name, and win over an old-name line.
+    std::unordered_map<std::string, std::string> renamed;
+    static std::string const newPrefix = "openvanilla.";
     std::lock_guard<std::mutex> guard(m_configLock);
 
     do
@@ -78,9 +82,14 @@ bool Config::Reload()
             value = *envValue;
         
         newEntries[entry] = value;
+        if (entry.compare(0, newPrefix.size(), newPrefix) == 0)
+            renamed["openvanilla." + entry.substr(newPrefix.size())] = value;
     }
     while (in.good());
 
+    for (auto const& r : renamed)
+        newEntries[r.first] = r.second;
+
     m_entries = std::move(newEntries);
 
     return true;
