diff --git a/src/game/OpenVanilla/TrainingDummy.cpp b/src/game/OpenVanilla/TrainingDummy.cpp
new file mode 100644
index 000000000..a67f28faf
--- /dev/null
+++ b/src/game/OpenVanilla/TrainingDummy.cpp
@@ -0,0 +1,106 @@
+/*
+ * Open Vanilla — training dummies for the capitals (GPLv2, as CMaNGOS).
+ *
+ * ScriptName npc_openvanilla_training_dummy (realm/classicplus/classicplus_pace.sql spawns them):
+ * never attacks, never moves, never drops below 10% health, and when you stop hitting it for
+ * 6 seconds it whispers what you did: damage, time and damage per second. The "your level" dummy
+ * (entry 990803) becomes the level of whoever hits it first, with that level's armor, so hit, crit
+ * and damage are what you'd get against a mob of your own level.
+ */
+
+#include "AI/ScriptDevAI/include/sc_common.h"
+#include "Entities/Player.h"
+
+#include <cstdio>
+#include <map>
+
+namespace
+{
+    uint32 const DUMMY_YOUR_LEVEL = 990803;
+    uint32 const REPORT_AFTER = 6 * IN_MILLISECONDS;   // quiet this long = the session is over
+
+    struct Session { uint64 damage = 0; uint32 hits = 0; uint32 start = 0; uint32 last = 0; };
+}
+
+struct npc_openvanilla_training_dummyAI : public ScriptedAI
+{
+    npc_openvanilla_training_dummyAI(Creature* creature) : ScriptedAI(creature), m_clock(0), m_check(1000)
+    {
+        SetReactState(REACT_PASSIVE);
+        SetCombatMovement(false);
+        SetMeleeEnabled(false);
+        Reset();
+    }
+
+    uint32 m_clock;                                 // ms since spawn
+    uint32 m_check;
+    std::map<ObjectGuid, Session> m_sessions;
+
+    void Reset() override {}
+
+    void DamageTaken(Unit* dealer, uint32& damage, DamageEffectType /*damageType*/, SpellEntry const* /*spellInfo*/) override
+    {
+        Player* player = dealer ? dealer->GetBeneficiaryPlayer() : nullptr;
+        if (player)
+        {
+            if (m_sessions.empty() && m_creature->GetEntry() == DUMMY_YOUR_LEVEL && m_creature->GetLevel() != player->GetLevel())
+                m_creature->SelectLevel(player->GetLevel());   // health and armor of a mob your level
+            Session& s = m_sessions[player->GetObjectGuid()];
+            if (!s.hits)
+                s.start = m_clock;
+            s.damage += damage;
+            ++s.hits;
+            s.last = m_clock;
+        }
+        // Counted in full above; the dummy itself never goes below 10%.
+        uint32 floor = m_creature->GetMaxHealth() / 10;
+        if (m_creature->GetHealth() <= floor + damage)
+        {
+            damage = 0;
+            m_creature->SetHealth(m_creature->GetMaxHealth());
+        }
+    }
+
+    void Report(ObjectGuid guid, Session const& s)
+    {
+        Player* player = m_creature->GetMap()->GetPlayer(guid);
+        if (!player)
+            return;
+        float secs = std::max(1.0f, (s.last - s.start) / 1000.0f);
+        char text[200];
+        std::snprintf(text, sizeof(text), "%llu damage in %.1f s (%u hits): %.1f damage per second.",
+                      (unsigned long long)s.damage, secs, s.hits, s.damage / secs);
+        m_creature->MonsterWhisper(text, player);
+    }
+
+    void UpdateAI(uint32 const diff) override
+    {
+        m_clock += diff;
+        if (m_check > diff)
+        {
+            m_check -= diff;
+            return;
+        }
+        m_check = 1000;
+        for (auto it = m_sessions.begin(); it != m_sessions.end();)
+        {
+            if (m_clock - it->second.last >= REPORT_AFTER)
+            {
+                Report(it->first, it->second);
+                it = m_sessions.erase(it);
+            }
+            else
+                ++it;
+        }
+        if (m_sessions.empty() && m_creature->IsInCombat())
+            EnterEvadeMode();                       // back to full health, out of combat
+    }
+};
+
+void AddSC_openvanilla_training_dummy()
+{
+    Script* pNewScript = new Script;
+    pNewScript->Name = "npc_openvanilla_training_dummy";
+    pNewScript->GetAI = &GetNewAIInstance<npc_openvanilla_training_dummyAI>;
+    pNewScript->RegisterSelf();
+}
