+++ b/src/game/OpenVanilla/Autopilot.h
@@ -0,0 +1,39 @@
+/*
+ * Open Vanilla — Herald Autopilot's server side (GPLv2, as CMaNGOS).
+ *
+ * Herald Autopilot (the desktop app, through bot/herald_autopilot_api.py) hands an online player's
+ * own character to the realm's bot AI and back, from the console (SOAP), so the player doesn't
+ * have to press anything in game first:
+ *
+ *   .wnl autopilot <Name> on     self-bot mode on, as the player's own ".bot self" would do
+ *   .wnl autopilot <Name> off    back to the player
+ *   .wnl autopilot <Name>        "on" or "off": whether the bot AI has the character now
+ *
+ * Staff only (SEC_GAMEMASTER and up: the HELPDESK console account). The realm's own rule still
+ * decides: AiPlayerbot.SelfBotLevel must allow self-bot for the player's account, exactly as for
+ * ".bot self". The API checks that the character belongs to the signed-in player before it asks.
+ * The player sees "Enable player ai (Autopilot)" / "Disable player ai (Autopilot)" as a system
+ * line, which the Herald addon reads (and a plain sentence on how to take control back).
+ * Without playerbots in the build the command answers that the bot AI is missing.
+ */
+
+#ifndef OPENVANILLA_AUTOPILOT_H
+#define OPENVANILLA_AUTOPILOT_H
+
+#include "Common.h"
+
+#include <string>
+
+class ChatHandler;
+
+namespace OwAutopilot
+{
+    // ".wnl <cmd> ..." from a player or the console: true when cmd was "autopilot".
+    bool HandleCommand(ChatHandler& handler, uint32 access, char const* args);
+
+    // Pure helper (unit-testable): "<Name> [on|off]" -> name and mode ("on", "off", "" for status).
+    // False when the arguments don't parse.
+    bool ParseArgs(std::string const& in, std::string& name, std::string& mode);
+}
+
+#endif
