diff --git a/src/game/OpenVanilla/Gm.cpp b/src/game/OpenVanilla/Gm.cpp
new file mode 100644
index 0000000..c12debd
--- /dev/null
+++ b/src/game/OpenVanilla/Gm.cpp
@@ -0,0 +1,125 @@
+/*
+ * Open Vanilla: the in-game GM console's data feed (Gm.h).
+ */
+#include "OpenVanilla/Gm.h"
+#include "OpenVanilla/Wnl.h"
+
+#include "Chat/Chat.h"
+#include "Database/DatabaseEnv.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectAccessor.h"
+#include "Guilds/GuildMgr.h"
+#include "Server/WorldSession.h"
+
+#include <cstdio>
+#include <ctime>
+#include <sstream>
+#include <string>
+
+namespace OwGm
+{
+    namespace
+    {
+        // Field text: no separators, no WNL control characters.
+        std::string Clean(std::string s, size_t limit)
+        {
+            for (char& c : s)
+                if (c == ',' || c == ';' || c == '|' || c == '\t' || c == '\n' || c == '\r')
+                    c = ' ';
+            if (s.size() > limit)
+                s.resize(limit);
+            return s;
+        }
+
+        std::string Num(float f)
+        {
+            char buf[32];
+            std::snprintf(buf, sizeof(buf), "%.1f", f);
+            return buf;
+        }
+
+        std::string Roster()
+        {
+            std::ostringstream out;
+            bool first = true;
+            time_t now = time(nullptr);
+            HashMapHolder<Player>::ReadGuard guard(HashMapHolder<Player>::GetLock());
+            for (auto const& kv : HashMapHolder<Player>::GetContainer())
+            {
+                Player* p = kv.second;
+                if (!p || !p->IsInWorld() || !p->GetSession())
+                    continue;
+                WorldSession* s = p->GetSession();
+                std::string acc = s->GetAccountName();
+                if (acc.compare(0, 6, "RNDBOT") == 0 || acc.compare(0, 6, "rndbot") == 0)
+                    continue;                                   // random bots: not players
+                uint32 state = p->IsAlive() ? 0 : (p->HasFlag(PLAYER_FLAGS, PLAYER_FLAGS_GHOST) ? 2 : 1);
+                Powers pt = p->GetPowerType();
+                std::string guild = p->GetGuildId() ? sGuildMgr.GetGuildNameById(p->GetGuildId()) : "";
+                std::string ip = s->GetRemoteAddress();
+                if (!first)
+                    out << ';';
+                first = false;
+                out << Clean(p->GetName(), 12) << ',' << uint32(p->GetLevel()) << ',' << uint32(p->getRace()) << ','
+                    << uint32(p->getClass()) << ',' << uint32(p->getGender()) << ',' << p->GetZoneId() << ','
+                    << p->GetMapId() << ',' << Num(p->GetPositionX()) << ',' << Num(p->GetPositionY()) << ','
+                    << Num(p->GetPositionZ()) << ',' << p->GetHealth() << ',' << p->GetMaxHealth() << ','
+                    << p->GetPower(pt) << ',' << p->GetMaxPower(pt) << ',' << uint32(pt) << ',' << p->GetMoney() << ','
+                    << Clean(acc, 32) << ',' << uint32(s->GetSecurity()) << ','
+                    << (s->m_muteTime > now ? uint32(s->m_muteTime - now) : 0u) << ',' << state << ','
+                    << (p->IsInCombat() ? 1 : 0) << ',' << s->GetLatency() << ',' << (p->IsGameMaster() ? 1 : 0) << ','
+                    << Clean(guild, 24) << ',' << Clean(ip, 45);
+            }
+            return out.str();
+        }
+
+        std::string Bugs()
+        {
+            std::ostringstream out;
+            auto r = CharacterDatabase.Query("SHOW TABLES LIKE 'openvanilla_bug_report'");
+            if (!r)
+                return "";
+            auto q = CharacterDatabase.Query(
+                "SELECT id, created, name, level, class, map, zone, x, y, z, category, LEFT(text, 160) "
+                "FROM openvanilla_bug_report ORDER BY id DESC LIMIT 25");
+            if (!q)
+                return "";
+            bool first = true;
+            do
+            {
+                Field* f = q->Fetch();
+                if (!first)
+                    out << ';';
+                first = false;
+                out << f[0].GetUInt32() << ',' << f[1].GetUInt64() << ',' << Clean(f[2].GetCppString(), 12) << ','
+                    << f[3].GetUInt32() << ',' << f[4].GetUInt32() << ',' << f[5].GetUInt32() << ',' << f[6].GetUInt32() << ','
+                    << Num(f[7].GetFloat()) << ',' << Num(f[8].GetFloat()) << ',' << Num(f[9].GetFloat()) << ','
+                    << Clean(f[10].GetCppString(), 24) << ',' << Clean(f[11].GetCppString(), 160);
+            }
+            while (q->NextRow());
+            return out.str();
+        }
+    }
+
+    bool HandleCommand(ChatHandler& handler, uint32 access, char const* args)
+    {
+        std::string a = args ? args : "";
+        size_t start = a.find_first_not_of(' ');
+        if (start == std::string::npos || a.compare(start, 3, "gm ") != 0)
+            return false;
+        std::string cmd = a.substr(start + 3);
+        cmd.erase(0, cmd.find_first_not_of(' '));
+        cmd.erase(cmd.find_last_not_of(' ') + 1);
+        WorldSession* session = handler.GetSession();
+        Player* me = session ? session->GetPlayer() : nullptr;
+        if (!me || access < SEC_GAMEMASTER)
+            return true;                                         // silent: the console stays hidden
+        if (cmd == "hi")
+            Wnl::Push(me, "GM", "OK " + std::to_string(access));
+        else if (cmd == "roster")
+            Wnl::Push(me, "GR", Roster());
+        else if (cmd == "bugs")
+            Wnl::Push(me, "GB", Bugs());
+        return true;
+    }
+}
