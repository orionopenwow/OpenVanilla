+++ b/src/game/OpenVanilla/Gm.h
@@ -0,0 +1,26 @@
+/*
+ * Open Vanilla: the in-game GM console's data feed (the hidden GMConsole addon).
+ *
+ * ".wnl gm <cmd>" from a game master (account level 2+) is answered over WNL (Wnl::Push):
+ *   gm hi       GM  "OK <accountLevel>"                    the addon opens only on this answer
+ *   gm roster   GR  "<row>;<row>;..."  each row "name,level,race,class,gender,zone,map,x,y,z,hp,maxhp,
+ *                   power,maxpower,powerType,copper,account,accountLevel,mutedSec,state,combat,latency,
+ *                   gmOn,guild,ip"  (state 0 alive, 1 dead, 2 ghost; random bots left out)
+ *   gm bugs     GB  "<row>;..."    each row "id,created,name,level,class,map,zone,x,y,z,category,text"
+ * Anyone else gets no answer at all, so the addon stays invisible. Every action the addon offers is
+ * an ordinary GM command, which the server checks against the account level as always.
+ */
+#ifndef OPENVANILLA_GM_H
+#define OPENVANILLA_GM_H
+
+#include "Common.h"
+
+class ChatHandler;
+
+namespace OwGm
+{
+    // true when args were a "gm ..." command (handled, answered or not).
+    bool HandleCommand(ChatHandler& handler, uint32 access, char const* args);
+}
+
+#endif
diff --git a/src/game/OpenVanilla/NameFilter.cpp b/src/game/OpenVanilla/NameFilter.cpp
new file mode 100644
index 0000000..0d4796e
--- /dev/null
+++ b/src/game/OpenVanilla/NameFilter.cpp
@@ -0,0 +1,131 @@
+/*
+ * Open Vanilla: the name filter (NameFilter.h). Two lists: words blocked anywhere in a name, and
+ * short words blocked only as the whole name, so ordinary names (Cassandra, Peacock, Scunthorpe)
+ * are never caught. Runs of a repeated letter are also squeezed ("Fuuuck" is checked as "fuck").
+ */
+#include "OpenVanilla/NameFilter.h"
+#include "Config/Config.h"
+
+#include <mutex>
+#include <vector>
+
+namespace OwNames
+{
+    namespace
+    {
+        // matched anywhere in the name
+        char const* const kAnywhere[] = {
+            "fuck", "phuck", "shit", "cunt", "nigg", "faggot", "fagot", "whore", "slut",
+            "bitch", "bastard", "penis", "vagina", "pussy", "dildo", "jizz", "porn", "wank", "twat", "cock",
+            "hitler", "nazi", "kike", "chink", "retard", "tranny", "rapist", "molest", "pedo", "paedo",
+            "kkk", "asshole", "arsehole", "motherf", "blowjob", "handjob", "cumshot", "boner", "clit",
+            "testicle", "anus", "orgasm", "semen", "spunk", "negro", "gook", "wetback", "beaner", "raghead",
+            "towelhead", "sandnig", "coon", "dyke", "lesbo", "homo", "queer", "spastic", "mongoloid",
+            "holocaust", "auschwitz", "jihad", "terrorist", "genocide", "suicide", "killyourself",
+            "heilhit", "siegheil", "whitepower", "gaschamber",
+        };
+        // matched only as the whole name
+        char const* const kWhole[] = {
+            "ass", "arse", "cum", "dick", "fag", "tit", "tits", "titty", "rape", "raped", "spic", "jew", "jews",
+            "gay", "anal", "sex", "sexy", "nude", "naked", "poop", "piss", "crap", "damn", "hell", "hoe", "hoes",
+            "thot", "simp", "incel", "nipple", "nipples", "boob", "boobs", "butt", "butthole", "balls", "nut", "nuts",
+        };
+
+        // "cock" is anywhere-matched but sits inside harmless names; these are let through.
+        char const* const kAllowed[] = {
+            "peacock", "hancock", "hitchcock", "babcock", "woodcock", "shuttlecock", "gamecock", "cockburn",
+            "coonan", "raccoon", "cocoon", "tycoon", "puccoon", "homolka", "homogen", "anusha", "manus",
+            "janus", "uranus", "magnus", "hanus", "isisa", "semenov", "clitheroe", "scunthorpe",
+            "dykes", "pedonne", "montenegro", "swank", "swanky", "torpedo", "speedo", "cockatrice", "cockatiel", "therapist", "shitak", "dickens",
+        };
+
+        struct Lists
+        {
+            std::vector<std::string> anywhere, whole, allowed;
+            bool on = true;
+        };
+
+        Lists const& Get()
+        {
+            static Lists lists;
+            static std::once_flag once;
+            std::call_once(once, []
+            {
+                ::Config& conf = MaNGOS::Singleton<::Config>::Instance();
+                lists.on = conf.GetBoolDefault("OpenVanilla.NameFilter", true);
+                for (char const* w : kAnywhere) lists.anywhere.emplace_back(w);
+                for (char const* w : kWhole) lists.whole.emplace_back(w);
+                for (char const* w : kAllowed) lists.allowed.emplace_back(w);
+                std::string extra = conf.GetStringDefault("OpenVanilla.NameFilter.Words", "");
+                std::string cur;
+                for (char c : extra + ",")
+                {
+                    if (c == ',' || c == ' ' || c == ';')
+                    {
+                        if (cur.size() >= 3) lists.anywhere.push_back(cur);
+                        cur.clear();
+                    }
+                    else if (c >= 'A' && c <= 'Z') cur += char(c - 'A' + 'a');
+                    else if (c >= 'a' && c <= 'z') cur += c;
+                }
+            });
+            return lists;
+        }
+
+        std::string Squeeze(std::string const& s)
+        {
+            std::string out;
+            for (char c : s)
+                if (out.empty() || out.back() != c)
+                    out += c;
+            return out;
+        }
+
+        bool Check(std::string const& name, Lists const& l)
+        {
+            for (std::string const& w : l.whole)
+                if (name == w)
+                    return true;
+            for (std::string const& w : l.anywhere)
+            {
+                size_t at = name.find(w);
+                while (at != std::string::npos)
+                {
+                    bool excused = false;
+                    for (std::string const& ok : l.allowed)
+                    {
+                        // the allowed word must cover this hit
+                        for (size_t s = name.find(ok); s != std::string::npos; s = name.find(ok, s + 1))
+                            if (s <= at && at + w.size() <= s + ok.size()) { excused = true; break; }
+                        if (excused) break;
+                    }
+                    if (!excused)
+                        return true;
+                    at = name.find(w, at + 1);
+                }
+            }
+            return false;
+        }
+    }
+
+    bool IsBlockedAscii(std::string const& lowerName)
+    {
+        Lists const& l = Get();
+        if (!l.on)
+            return false;
+        return Check(lowerName, l) || Check(Squeeze(lowerName), l);
+    }
+
+    bool IsBlocked(std::wstring const& lowerName)
+    {
+        // Latin letters only: accented letters are folded to nothing, so "Fück" is checked as "fck"
+        // (not a match) but "Füuck" as "fuck"; other scripts are left to the reserved-name table.
+        std::string ascii;
+        for (wchar_t c : lowerName)
+            if (c >= L'a' && c <= L'z')
+                ascii += char(c);
+            else if (c >= L'A' && c <= L'Z')
+                ascii += char(c - L'A' + L'a');
+        return IsBlockedAscii(ascii);
+    }
+}
diff --git a/src/game/OpenVanilla/NameFilter.h b/src/game/OpenVanilla/NameFilter.h
new file mode 100644
index 0000000..b6342a9
--- /dev/null
+++ b/src/game/OpenVanilla/NameFilter.h
@@ -0,0 +1,21 @@
+/*
+ * Open Vanilla: no slurs or obscenities in names on our realm (characters, pets, guilds).
+ * ObjectMgr::IsReservedName asks this, so every place the server checks a reserved name refuses
+ * these too: character create and rename, pet names, guild charters; and a character that already
+ * has one is made to pick a new name at its next login (Player::LoadFromDB, as for reserved names).
+ */
+#ifndef OPENVANILLA_NAME_FILTER_H
+#define OPENVANILLA_NAME_FILTER_H
+
+#include <string>
+
+namespace OwNames
+{
+    // true when the (lower-cased) name is or contains a blocked word. Off with OpenVanilla.NameFilter = 0;
+    // OpenVanilla.NameFilter.Words = a comma-separated list adds words (matched anywhere in the name).
+    bool IsBlocked(std::wstring const& lowerName);
+    // the same check on plain lower-case ASCII, for the tests
+    bool IsBlockedAscii(std::string const& lowerName);
+}
+
+#endif
