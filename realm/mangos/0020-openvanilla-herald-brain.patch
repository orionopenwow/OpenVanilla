new file mode 100644
index 0000000..03ce0ed
--- /dev/null
+++ b/src/modules/PlayerBots/playerbot/HeraldBrain.h
@@ -0,0 +1,45 @@
+#pragma once
+// Open Vanilla: Herald's own judgement on top of the bot AI (realm/mangos/0020-openvanilla-herald-brain.patch).
+//
+// Herald is the bot AI playing a real player's own character (the self-bot: PlayerbotAI::IsRealPlayer()).
+// The bot AI still walks, casts and loots; this file decides what a good solo player would decide:
+//   * whether a fight is worth taking (a fight predictor with a measured risk budget, not fixed rules);
+//   * getting unstuck in seconds, in steps, instead of after five minutes;
+//   * grouping with another Herald at the right moments (a group quest, or the same quest mobs), and
+//     leaving again when that's over;
+//   * a fight log and a stuck log in the database, which the scorecard reads;
+//   * one short line about each choice for the Herald panel ("Skipping Defias Thug: pack of 3"), sent to
+//     the character's own client only, never to chat (the Herald addon shows it in its panel).
+// Random bots never come here: every entry point returns at once unless the bot is a self-bot.
+
+#include "playerbot/HeraldMath.h"
+#include <string>
+#include <vector>
+
+class PlayerbotAI;
+class Player;
+class Unit;
+class ObjectGuid;
+
+namespace HeraldBrain
+{
+    // Is this bot Herald (a real player's character played by the bot AI)?
+    bool IsHerald(PlayerbotAI* ai);
+
+    // Called from PlayerbotAI::UpdateAI every tick (cheap: real work runs every 1-15 s).
+    void Update(PlayerbotAI* ai, uint32 elapsed);
+
+    // Combat bookkeeping for the fight log.
+    void OnCombatStarted(PlayerbotAI* ai);
+    void OnCombatEnded(PlayerbotAI* ai);
+    void OnDeath(PlayerbotAI* ai);
+
+    // The pull decision for one candidate from GrindTargetValue. Returns false to skip it; otherwise
+    // `penalty` is extra distance (yards) that makes riskier fights come later. `nearby` are the
+    // other possible targets around (the grind value's own list).
+    bool PullVerdict(PlayerbotAI* ai, Unit* unit, bool needForQuest, std::vector<Unit*> const& nearby, float& penalty);
+
+    // One line for the Herald panel (rate-limited, never repeated within a minute).
+    void Note(PlayerbotAI* ai, std::string const& text);
+
+}
diff --git a/src/modules/PlayerBots/playerbot/HeraldMath.h b/src/modules/PlayerBots/playerbot/HeraldMath.h
new file mode 100644
index 0000000..d0b0248
--- /dev/null
+++ b/src/modules/PlayerBots/playerbot/HeraldMath.h
@@ -0,0 +1,72 @@
+#pragma once
+// Open Vanilla: the numbers behind Herald's pull decision (HeraldBrain.cpp), with no game types, so
+// they can be tested on their own (realm/mangos/tests/herald_math_test.cpp).
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+namespace HeraldBrain
+{
+    struct Foe { float hp; float dps; };
+    struct Outlook { float damageTaken; float seconds; float endHealthPct; };
+
+inline float SeedDps(uint32_t level)
+{
+    // A solo character in leveling gear: about 15 at 10, 55 at 30, 165 at 60. Replaced fight by fight with
+    // what this character really does (State::dps).
+    float l = float(level);
+    return 0.035f * l * l + 0.6f * l + 5.0f;
+}
+
+inline float MobDps(uint32_t level, bool elite)
+{
+    // A normal mob's melee: about 7 at 10, 27 at 30, 87 at 60; elites hit about 2.5 times as hard.
+    float l = float(level);
+    float d = 0.02f * l * l + 0.2f * l + 3.0f;
+    return elite ? d * 2.5f : d;
+}
+
+inline float ArmorReduction(float armor, uint32_t attackerLevel)
+{
+    // The game's own formula for an attacker of this level (capped at 75%).
+    if (armor <= 0.0f)
+        return 0.0f;
+    float r = armor / (armor + 400.0f + 85.0f * float(attackerLevel));
+    return std::min(r, 0.75f);
+}
+
+inline float MinEndHealth(bool hasEscape, bool hasPotion, uint32_t groupSize)
+{
+    // The risk budget. Herald takes fights a careful player takes, not only sure wins: he may end a fight
+    // at 20% when he has a way out (an escape spell or a potion), 30% when he has none. A group spreads
+    // the damage, so a group of two may go a little lower.
+    float min = (hasEscape || hasPotion) ? 0.20f : 0.30f;
+    if (hasEscape && hasPotion)
+        min = 0.15f;
+    if (groupSize >= 2)
+        min -= 0.05f;
+    return std::max(min, 0.10f);
+}
+
+inline Outlook Predict(float health, float maxHealth, float dps, std::vector<Foe> foes, float damageScale)
+{
+    Outlook o{ 0.0f, 0.0f, maxHealth > 0.0f ? health / maxHealth : 0.0f };
+    if (dps <= 0.1f || foes.empty() || maxHealth <= 0.0f)
+        return o;
+    // lowest health first: every foe hits until the moment it dies
+    std::sort(foes.begin(), foes.end(), [](Foe const& a, Foe const& b) { return a.hp < b.hp; });
+    float t = 0.0f;
+    float dmg = 0.0f;
+    for (Foe const& f : foes)
+    {
+        t += f.hp / dps;
+        dmg += f.dps * t;
+    }
+    dmg *= damageScale;
+    o.damageTaken = dmg;
+    o.seconds = t;
+    o.endHealthPct = (health - dmg) / maxHealth;
+    return o;
+}
+
+}
