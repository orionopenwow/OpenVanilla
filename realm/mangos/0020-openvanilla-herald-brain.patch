+// ---------------------------------------------------------------------------------------------------------
+// Pure numbers
+// ---------------------------------------------------------------------------------------------------------
+
+// ---------------------------------------------------------------------------------------------------------
+// Per-character state (bots update in their map's thread; one lock keeps the map of states safe)
+// ---------------------------------------------------------------------------------------------------------
+
+struct Fight
+{
+    bool active = false;
+    uint32 startMs = 0;
+    float hp0 = 1.0f, mana0 = 1.0f, hpMin = 1.0f;
+    uint32 attackersMax = 0;
+    uint32 mobEntry = 0, mobLevel = 0;
+    float foeHealth = 0.0f;          // health of every foe seen in this fight, for the damage estimate
+    std::map<uint64, float> foes;    // foe guid -> max health
+    bool potion = false;             // health went up by 20% or more in one step while fighting
+    uint32 outOfCombatMs = 0;
+};
+
+struct Memory { uint32 map; float x, y; uint32 entry; uint32 atMs; };
+
+struct State
+{
+    std::vector<Memory> deaths;      // where and to what he died in the last hour (at most 8)
+    Fight fight;
+    float dps = -1.0f;               // measured damage per second (moving average), -1 = not yet
+    uint32 sampleMs = 0;
+    // walking
+    float lastX = 0, lastY = 0, lastZ = 0;
+    uint32 lastMap = 0;
+    float goodX = 0, goodY = 0, goodZ = 0;
+    bool haveGood = false;
+    uint32 stillMs = 0;
+    uint32 stuckTier = 0;
+    bool walkedBack = false;
+    // errands
+    uint32 vendorCheckMs = 0;
+    uint64 lastVendor = 0;
+    uint32 lastVendorMs = 0;
+    // grouping
+    uint32 groupCheckMs = 0;
+    uint32 formedGroupId = 0;        // a group Herald made (he only ever leaves groups he made)
+    uint32 inviteTo = 0, inviteMs = 0;   // the Herald he invited, and when
+    uint32 acceptedFrom = 0;         // the Herald whose invite he accepted
+    uint32 apartChecks = 0, idleChecks = 0;
+    // notes
+    std::map<std::string, uint32> noteAt;
+    uint32 lastNoteMs = 0;
+};
+
+static std::mutex s_lock;
+static std::unordered_map<uint32, State> s_state;
+
+static State& Get(Player* bot)
+{
+    return s_state[bot->GetGUIDLow()];
+}
+
+static bool InFormedGroup(Player* bot, uint32 formed)
+{
+    Group* g = bot->GetGroup();
+    return g && formed && g->GetId() == formed;
+}
+
+bool IsHerald(PlayerbotAI* ai)
+{
+    // master == bot first: a pointer compare that rules out every random and alt bot before the string
+    // compare in IsRealPlayer() (it copies the session's address)
+    return ai && ai->GetBot() && ai->IsSelfMaster() && ai->IsRealPlayer();
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Notes for the Herald panel
+// ---------------------------------------------------------------------------------------------------------
+
+static void NoteLocked(PlayerbotAI* ai, State& s, std::string const& text)
+{
+    uint32 now = WorldTimer::getMSTime();
+    auto it = s.noteAt.find(text);
+    if (it != s.noteAt.end() && WorldTimer::getMSTimeDiff(it->second, now) < 60000)
+        return;
+    if (s.lastNoteMs && WorldTimer::getMSTimeDiff(s.lastNoteMs, now) < 3000)
+        return;
+    s.noteAt[text] = now;
+    s.lastNoteMs = now;
+    if (s.noteAt.size() > 64)
+        s.noteAt.clear();
+    // to the character's own client only, as a whisper from itself; the Herald addon reads lines that
+    // start with "OVH:" into its panel and keeps them out of the chat window
+    Player* bot = ai->GetBot();
+    WorldPacket data;
+    std::string line = "OVH:" + text;
+    ChatHandler::BuildChatPacket(data, CHAT_MSG_WHISPER, line.c_str(), LANG_UNIVERSAL, bot->GetChatTag(), bot->GetObjectGuid(), bot->GetName());
+    bot->GetSession()->SendPacket(data);
+}
+
+void Note(PlayerbotAI* ai, std::string const& text)
+{
+    if (!IsHerald(ai))
+        return;
+    std::lock_guard<std::mutex> g(s_lock);
+    NoteLocked(ai, Get(ai->GetBot()), text);
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// The pull decision
+// ---------------------------------------------------------------------------------------------------------
+
+static float UnitDps(Unit* u, Player* bot)
+{
+    uint32 level = u->GetLevel();
+    bool elite = false;
+    bool caster = false;
+    if (u->GetTypeId() == TYPEID_UNIT)
+    {
+        CreatureInfo const* ci = ((Creature*)u)->GetCreatureInfo();
+        if (ci)
+        {
+            elite = ci->Rank != 0 && ci->Rank != 4;   // 4 = rare (normal strength)
+            caster = ci->UnitClass == 2 || ci->UnitClass == 8;   // paladin and mage creatures cast
+        }
+    }
+    float minD = u->GetFloatValue(UNIT_FIELD_MINDAMAGE);
+    float maxD = u->GetFloatValue(UNIT_FIELD_MAXDAMAGE);
+    uint32 speed = u->GetAttackTime(BASE_ATTACK);
+    float dps = 0.0f;
+    if (maxD > 0.0f && speed > 0)
+        dps = (minD + maxD) * 0.5f / (float(speed) / 1000.0f);
+    // casters' spells aren't in the melee fields; never trust a figure far below the level's norm
+    dps = std::max(dps, MobDps(level, elite) * 0.6f);
+    if (caster)
+        dps *= 1.3f;
+    dps *= 1.0f - ArmorReduction(float(bot->GetArmor()), level);
+    return dps;
+}
+
+static bool IsHealingPotion(ItemPrototype const* proto)
+{
+    if (!proto || !proto->IsPotion())
+        return false;
+    for (auto const& sp : proto->Spells)
+        if (sp.SpellId)
+            if (SpellEntry const* e = sSpellTemplate.LookupEntry<SpellEntry>(sp.SpellId))
+                for (int i = 0; i < MAX_EFFECT_INDEX; ++i)
+                    if (e->Effect[i] == SPELL_EFFECT_HEAL)
+                        return true;
+    return false;
+}
+
+static bool HasHealingPotion(Player* bot)
+{
+    for (uint8 slot = INVENTORY_SLOT_ITEM_START; slot < INVENTORY_SLOT_ITEM_END; ++slot)
+        if (Item* it = bot->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            if (IsHealingPotion(it->GetProto()))
+                return true;
+    for (uint8 bag = INVENTORY_SLOT_BAG_START; bag < INVENTORY_SLOT_BAG_END; ++bag)
+        if (Bag* b = (Bag*)bot->GetItemByPos(INVENTORY_SLOT_BAG_0, bag))
+            for (uint32 i = 0; i < b->GetBagSize(); ++i)
+                if (Item* it = b->GetItemByPos(i))
+                    if (IsHealingPotion(it->GetProto()))
+                        return true;
+    return false;
+}
+
+static bool HasEscape(Player* bot)
+{
+    // a class way out of a fight that went wrong, from the level it's normally learned
+    switch (bot->getClass())
+    {
+        case CLASS_MAGE:    return bot->GetLevel() >= 10;  // Frost Nova and step away
+        case CLASS_ROGUE:   return bot->GetLevel() >= 22;  // Vanish (Gouge, Sprint before that)
+        case CLASS_PRIEST:  return bot->GetLevel() >= 14;  // Psychic Scream
+        case CLASS_WARLOCK: return bot->GetLevel() >= 8;   // Fear
+        case CLASS_PALADIN: return bot->GetLevel() >= 6;   // Divine Protection, Lay on Hands
+        case CLASS_HUNTER:  return bot->GetLevel() >= 30;  // Feign Death
+        case CLASS_WARRIOR: return bot->GetLevel() >= 22;  // Intimidating Shout
+        case CLASS_DRUID:   return bot->GetLevel() >= 10;  // bear form and heals
+        default:            return false;
+    }
+}
+
+static float DamageScale(Player* bot)
+{
+    float scale = 1.0f;
+    switch (bot->getClass())
+    {
+        case CLASS_PRIEST: case CLASS_PALADIN: case CLASS_DRUID: case CLASS_SHAMAN:
+            scale *= 0.85f;    // heals themselves between hits
+            break;
+        default:
+            break;
+    }
+    if (Pet* pet = bot->GetPet())
+        if (pet->IsAlive())
+            scale *= 0.6f;     // the pet takes most of the hits
+    return scale;
+}
+
+static uint32 GroupSize(Player* bot)
+{
+    Group* g = bot->GetGroup();
+    return g ? g->GetMembersCount() : 1;
+}
+
+bool PullVerdict(PlayerbotAI* ai, Unit* unit, bool needForQuest, std::vector<Unit*> const& nearby, float& penalty)
+{
+    penalty = 0.0f;
+    if (!IsHerald(ai) || !unit)
+        return true;
+    Player* bot = ai->GetBot();
+    if (bot->InBattleGround() || bot->GetMap()->IsDungeon())
+        return true;
+    if (Group* grp = bot->GetGroup())
+    {
+        // in a group a player made, the group decides; only a pairing of two Heralds uses these rules
+        std::lock_guard<std::mutex> g(s_lock);
+        if (!InFormedGroup(bot, Get(bot).formedGroupId))
+            return true;
+    }
+
+    // already fighting him or his group: that's not a pull, it's self-defence
+    if (Unit* v = unit->GetVictim())
+        if (v == bot || (v->GetTypeId() == TYPEID_PLAYER && bot->IsInGroup(v)))
+            return true;
+
+    uint32 size = GroupSize(bot);
+    int gap = int(unit->GetLevel()) - int(bot->GetLevel());
+    // no fight far above his level: misses and crushing blows rise steeply from +3
+    int maxGap = (needForQuest ? 3 : 2) + (size >= 2 ? 1 : 0);
+    if (gap > maxGap)
+        return false;
+
+    // who joins: idle aggressive mobs whose own aggro radius covers the fight, and patrols within 30 yd
+    std::vector<Foe> foes;
+    foes.push_back({ float(unit->GetHealth()), UnitDps(unit, bot) });
+    uint32 adds = 0;
+    for (Unit* a : bot->getAttackers())     // whatever is already on him stays in the fight
+        if (a && a != unit && a->IsAlive())
+            foes.push_back({ float(a->GetHealth()), UnitDps(a, bot) });
+    for (Unit* other : nearby)
+    {
+        if (!other || other == unit || !other->IsAlive() || other->IsInCombat())
+            continue;
+        if (other->GetTypeId() != TYPEID_UNIT || ((Creature*)other)->IsCritter())
+            continue;
+        if (!((Creature*)other)->CanAttackOnSight(bot))
+            continue;
+        float reach = other->GetAttackDistance(bot) + 3.0f;
+        if (other->GetMotionMaster()->GetCurrentMovementGeneratorType() == WAYPOINT_MOTION_TYPE)
+            reach = std::max(reach, 30.0f);
+        if (sServerFacade.GetDistance2d(unit, other) > reach)
+            continue;
+        foes.push_back({ float(other->GetHealth()), UnitDps(other, bot) });
+        ++adds;
+    }
+    // a pack is never worth it alone (three or more for a mob a quest needs, so camp quests still get done)
+    if (adds >= (needForQuest ? 3u : 2u) + (size >= 2 ? 1u : 0u))
+    {
+        Note(ai, "Skipping " + std::string(unit->GetName()) + ": a pack of " + std::to_string(adds + 1));
+        return false;
+    }
+
+    float dps;
+    float wary = 0.0f;
+    {
+        std::lock_guard<std::mutex> g(s_lock);
+        State& s = Get(bot);
+        dps = s.dps > 0.0f ? s.dps : SeedDps(bot->GetLevel());
+        uint32 now = WorldTimer::getMSTime();
+        for (Memory const& m : s.deaths)
+        {
+            if (WorldTimer::getMSTimeDiff(m.atMs, now) > 3600000)
+                continue;
+            if (m.map == unit->GetMapId() && std::hypot(unit->GetPositionX() - m.x, unit->GetPositionY() - m.y) < 30.0f)
+            {
+                NoteLocked(ai, s, "Keeping away from where he died");
+                return false;
+            }
+            if (m.entry && m.entry == unit->GetEntry())
+                wary = 0.15f;            // the same kind of mob killed him: wants a bigger margin
+        }
+    }
+    if (size >= 2)
+        dps *= 1.8f;           // two of them at it (a group Herald forms is two)
+    float scale = DamageScale(bot) / float(std::min<uint32>(size, 2));
+
+    Outlook o = Predict(float(bot->GetHealth()), float(bot->GetMaxHealth()), dps, foes, scale);
+    bool potion = HasHealingPotion(bot);
+    bool escape = HasEscape(bot);
+    float floor = MinEndHealth(escape, potion, size) + wary;
+    if (o.endHealthPct < floor)
+    {
+        // only worth a line when it's a fight he'd otherwise take (healthy and not resting)
+        if (bot->GetHealthPercent() > 70.0f)
+            Note(ai, "Skipping " + std::string(unit->GetName()) + ": too risky (about " +
+                 std::to_string(std::max(0, int(o.endHealthPct * 100.0f))) + "% health left)");
+        return false;
+    }
+    // riskier fights come later: each 10% of health it costs is 4 yards farther away
+    penalty = std::max(0.0f, (1.0f - o.endHealthPct)) * 40.0f + 15.0f * float(adds);
+    return true;
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Fight log
+// ---------------------------------------------------------------------------------------------------------
+
+static float ManaPct(Player* bot)
+{
+    if (bot->GetPowerType() != POWER_MANA || !bot->GetMaxPower(POWER_MANA))
+        return 1.0f;
+    return float(bot->GetPower(POWER_MANA)) / float(bot->GetMaxPower(POWER_MANA));
+}
+
+static void SampleFight(Player* bot, Fight& f)
+{
+    float hp = bot->GetMaxHealth() ? float(bot->GetHealth()) / float(bot->GetMaxHealth()) : 0.0f;
+    if (hp > f.hpMin + 0.20f && f.hpMin < 0.5f)
+        f.potion = true;
+    f.hpMin = std::min(f.hpMin, hp);
+    uint32 n = 0;
+    for (Unit* a : bot->getAttackers())
+    {
+        if (!a)
+            continue;
+        ++n;
+        uint64 key = a->GetObjectGuid().GetRawValue();
+        if (f.foes.find(key) == f.foes.end())
+        {
+            f.foes[key] = float(a->GetMaxHealth());
+            f.foeHealth += float(a->GetMaxHealth());
+            if (!f.mobEntry)
+            {
+                f.mobEntry = a->GetEntry();
+                f.mobLevel = a->GetLevel();
+            }
+        }
+    }
+    if (Unit* v = bot->GetVictim())
+    {
+        if (!f.mobEntry)
+        {
+            f.mobEntry = v->GetEntry();
+            f.mobLevel = v->GetLevel();
+        }
+        uint64 key = v->GetObjectGuid().GetRawValue();
+        if (f.foes.find(key) == f.foes.end())
+        {
+            f.foes[key] = float(v->GetMaxHealth());
+            f.foeHealth += float(v->GetMaxHealth());
+        }
+    }
+    f.attackersMax = std::max(f.attackersMax, n);
+}
+
+void OnCombatStarted(PlayerbotAI* ai)
+{
+    if (!IsHerald(ai))
+        return;
+    Player* bot = ai->GetBot();
+    std::lock_guard<std::mutex> g(s_lock);
+    Fight& f = Get(bot).fight;
+    if (f.active)
+        return;                          // called on every tick of a fight; the first one starts it
+    f = Fight();
+    f.active = true;
+    f.startMs = WorldTimer::getMSTime();
+    f.hp0 = bot->GetMaxHealth() ? float(bot->GetHealth()) / float(bot->GetMaxHealth()) : 0.0f;
+    f.mana0 = ManaPct(bot);
+    f.hpMin = f.hp0;
+    SampleFight(bot, f);
+}
+
+static void FinishFight(PlayerbotAI* ai, State& s, char const* outcome)
+{
+    Fight& f = s.fight;
+    if (!f.active)
+        return;
+    f.active = false;
+    Player* bot = ai->GetBot();
+    float secs = float(WorldTimer::getMSTimeDiff(f.startMs, WorldTimer::getMSTime())) / 1000.0f;
+    if (secs < 1.0f)
+        return;
+    // what he really does: the health of everything that fought him, over the fight's length (wins only)
+    if (!strcmp(outcome, "win") && f.foeHealth > 0.0f && secs >= 4.0f)
+    {
+        float seen = f.foeHealth / secs;
+        float seed = SeedDps(bot->GetLevel());
+        seen = std::max(seed * 0.4f, std::min(seen, seed * 2.5f));
+        s.dps = s.dps > 0.0f ? s.dps * 0.8f + seen * 0.2f : seen;
+    }
+    int gap = int(f.mobLevel) - int(bot->GetLevel());
+    CharacterDatabase.PExecute(
+        "INSERT INTO `openvanilla_herald_fight` (`guid`,`class`,`level`,`map`,`zone`,`x`,`y`,`mob_entry`,`mob_level`,`level_gap`,"
+        "`attackers_max`,`hp_start`,`mana_start`,`hp_min`,`potion`,`seconds`,`outcome`,`group_size`,`dps_estimate`,`created`) "
+        "VALUES (%u,%u,%u,%u,%u,%.1f,%.1f,%u,%u,%d,%u,%u,%u,%u,%u,%.1f,'%s',%u,%.1f,UNIX_TIMESTAMP())",
+        bot->GetGUIDLow(), uint32(bot->getClass()), bot->GetLevel(), bot->GetMapId(), bot->GetZoneId(),
+        bot->GetPositionX(), bot->GetPositionY(), f.mobEntry, f.mobLevel, gap, f.attackersMax,
+        uint32(f.hp0 * 100.0f), uint32(f.mana0 * 100.0f), uint32(f.hpMin * 100.0f), f.potion ? 1u : 0u,
+        secs, outcome, GroupSize(bot), s.dps);
+}
+
+void OnCombatEnded(PlayerbotAI* ai)
+{
+    if (!IsHerald(ai))
+        return;
+    std::lock_guard<std::mutex> g(s_lock);
+    State& s = Get(ai->GetBot());
+    FinishFight(ai, s, ai->GetBot()->IsAlive() ? "win" : "death");
+}
+
+void OnDeath(PlayerbotAI* ai)
+{
+    if (!IsHerald(ai))
+        return;
+    Player* bot = ai->GetBot();
+    std::lock_guard<std::mutex> g(s_lock);
+    State& s = Get(bot);
+    uint32 entry = s.fight.active ? s.fight.mobEntry : 0;
+    if (s.fight.active)
+        FinishFight(ai, s, "death");
+    // remember it: he keeps away from this spot for an hour, and is warier of what killed him
+    s.deaths.push_back({ bot->GetMapId(), bot->GetPositionX(), bot->GetPositionY(), entry, WorldTimer::getMSTime() });
+    if (s.deaths.size() > 8)
+        s.deaths.erase(s.deaths.begin());
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Getting unstuck, in seconds and in steps
+// ---------------------------------------------------------------------------------------------------------
+
+static bool Busy(Player* bot)
+{
+    // standing still on purpose: resting, eating, casting, on a flight, at a vendor or mailbox
+    if (bot->IsSitState() || bot->IsTaxiFlying() || bot->IsNonMeleeSpellCasted(false))
+        return true;
+    if (bot->GetHealthPercent() < 90.0f)
+        return true;                     // regenerating before the next pull
+    if (bot->GetPowerType() == POWER_MANA && ManaPct(bot) < 0.80f)
+        return true;
+    if (bot->GetTradeData())
+        return true;
+    return false;
+}
+
+static void LogStuck(Player* bot, uint32 tier, uint32 seconds)
+{
+    CharacterDatabase.PExecute(
+        "INSERT INTO `openvanilla_herald_stuck` (`guid`,`level`,`map`,`zone`,`x`,`y`,`z`,`tier`,`seconds`,`created`) "
+        "VALUES (%u,%u,%u,%u,%.1f,%.1f,%.1f,%u,%u,UNIX_TIMESTAMP())",
+        bot->GetGUIDLow(), bot->GetLevel(), bot->GetMapId(), bot->GetZoneId(),
+        bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ(), tier, seconds);
+}
+
+// returns the action to run after the lock is released ("" = none)
+static std::string UnstuckStep(PlayerbotAI* ai, State& s, uint32 dt)
+{
+    Player* bot = ai->GetBot();
+    float x = bot->GetPositionX(), y = bot->GetPositionY(), z = bot->GetPositionZ();
+    bool sameMap = s.lastMap == bot->GetMapId();
+    float moved = sameMap ? std::sqrt((x - s.lastX) * (x - s.lastX) + (y - s.lastY) * (y - s.lastY)) : 100.0f;
+    s.lastX = x; s.lastY = y; s.lastZ = z; s.lastMap = bot->GetMapId();
+
+    // only when he means to go somewhere: a travel target being walked to, out in the world, alone or in
+    // a pairing of Heralds (a player standing at the bank, waiting in a dungeon or in a player's group is
+    // not stuck)
+    bool travelling = false;
+    if (TravelTarget* tt = ai->GetAiObjectContext()->GetValue<TravelTarget*>("travel target")->Get())
+        travelling = tt->GetStatus() == TravelStatus::TRAVEL_STATUS_TRAVEL || tt->GetStatus() == TravelStatus::TRAVEL_STATUS_READY;
+    bool ownGroup = !bot->GetGroup() || InFormedGroup(bot, s.formedGroupId);
+    if (moved > 2.0f || bot->IsInCombat() || !bot->IsAlive() || Busy(bot) || !travelling || !ownGroup ||
+        bot->GetMap()->IsDungeon())
+    {
+        if (moved > 2.0f && s.stuckTier)
+            NoteLocked(ai, s, "Moving again");
+        s.stillMs = 0;
+        s.stuckTier = 0;
+        s.walkedBack = false;
+        if (moved > 2.0f && bot->IsAlive() && !bot->IsInCombat())
+        {
+            s.goodX = x; s.goodY = y; s.goodZ = z; s.haveGood = true;
+        }
+        return "";
+    }
+    s.stillMs += dt;
+    uint32 secs = s.stillMs / 1000;
+    if (s.stuckTier < 1 && s.stillMs >= 25000)
+    {
+        s.stuckTier = 1;
+        NoteLocked(ai, s, "Stuck for 25 s: picking another way");
+        return "reset travel target";
+    }
+    if (s.stuckTier < 2 && s.stillMs >= 70000)
+    {
+        s.stuckTier = 2;
+        LogStuck(bot, 2, secs);
+        if (s.haveGood && bot->GetDistance(s.goodX, s.goodY, s.goodZ) > 8.0f)
+        {
+            NoteLocked(ai, s, "Still stuck: walking back to where he last moved freely");
+            bot->GetMotionMaster()->MovePoint(0, s.goodX, s.goodY, s.goodZ);
+            s.walkedBack = true;
+            return "";
+        }
+        NoteLocked(ai, s, "Still stuck: starting over");
+        return "reset";
+    }
+    // the hearthstone only when even walking back failed (standing still with nothing to do isn't stuck)
+    if (s.stuckTier < 3 && s.stillMs >= 150000 && s.walkedBack)
+    {
+        s.stuckTier = 3;
+        LogStuck(bot, 3, secs);
+        NoteLocked(ai, s, "Stuck for over 2 minutes: hearthstone");
+        return "hearthstone";
+    }
+    return "";
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Grouping at the right moments
+// ---------------------------------------------------------------------------------------------------------
+
+struct Shared { uint32 quest = 0; bool group = false; };
+
+static Shared SharedQuest(Player* a, Player* b)
+{
+    Shared best;
+    for (auto const& qs : a->getQuestStatusMap())
+    {
+        if (qs.second.m_status != QUEST_STATUS_INCOMPLETE)
+            continue;
+        if (b->GetQuestStatus(qs.first) != QUEST_STATUS_INCOMPLETE)
+            continue;
+        Quest const* q = sObjectMgr.GetQuestTemplate(qs.first);
+        if (!q)
+            continue;
+        bool groupQuest = q->GetType() == QUEST_TYPE_ELITE || q->GetSuggestedPlayers() > 1;
+        if (!best.quest || (groupQuest && !best.group))
+        {
+            best.quest = qs.first;
+            best.group = groupQuest;
+        }
+    }
+    return best;
+}
+
+static bool OtherHerald(Player* bot, Player* p)
+{
+    if (!p || p == bot || !p->IsAlive() || p->GetTeam() != bot->GetTeam())
+        return false;
+    PlayerbotAI* pai = p->GetPlayerbotAI();
+    return pai && pai->IsRealPlayer();
+}
+
+// Group changes go through the characters' own sessions as the client's packets (invite, accept, leave),
+// so the world thread runs them like any player's: group ids and the group list are not safe to touch from
+// a map thread.
+static void QueueGroupPacket(Player* p, Opcodes opcode, std::string const* name = nullptr)
+{
+    std::unique_ptr<WorldPacket> pk(new WorldPacket(opcode, name ? name->size() + 1 : 0));
+    if (name)
+        *pk << *name;
+    p->GetSession()->QueuePacket(std::move(pk));
+}
+
+static void GroupStep(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    if (bot->InBattleGround() || bot->IsInCombat() || !bot->IsAlive() || bot->GetMap()->IsDungeon())
+        return;
+
+    Group* group = bot->GetGroup();
+    uint32 now = WorldTimer::getMSTime();
+
+    // 1. An invite from another Herald that asked for this pairing: accept it (his own session runs it).
+    if (!group)
+    {
+        if (Group* inv = bot->GetGroupInvite())
+        {
+            Player* leader = sObjectMgr.GetPlayer(inv->GetLeaderGuid());
+            bool ours = false;
+            {
+                std::lock_guard<std::mutex> g(s_lock);
+                if (leader && OtherHerald(bot, leader))
+                {
+                    State& ls = Get(leader);
+                    ours = ls.inviteTo == bot->GetGUIDLow() && WorldTimer::getMSTimeDiff(ls.inviteMs, now) < 60000;
+                }
+                if (ours)
+                    Get(bot).acceptedFrom = leader->GetGUIDLow();
+            }
+            if (ours)
+                QueueGroupPacket(bot, CMSG_GROUP_ACCEPT);
+            return;                          // someone else's invite: the owner answers it
+        }
+    }
+
+    State* sp;
+    {
+        std::lock_guard<std::mutex> g(s_lock);
+        sp = &Get(bot);
+    }
+
+    if (group)
+    {
+        // 2. Just joined the pairing Herald asked for: remember the group as one he made.
+        bool justFormed = false;
+        std::string partner;
+        {
+            std::lock_guard<std::mutex> g(s_lock);
+            State& s = *sp;
+            uint32 other = s.inviteTo ? s.inviteTo : s.acceptedFrom;
+            if (!s.formedGroupId && other && group->IsMember(ObjectGuid(HIGHGUID_PLAYER, other)))
+            {
+                s.formedGroupId = group->GetId();
+                s.idleChecks = s.apartChecks = 0;
+                justFormed = true;
+            }
+            s.inviteTo = s.acceptedFrom = 0;
+            if (!InFormedGroup(bot, s.formedGroupId))
+                return;                      // a group a player made: never leave it, never steer it
+        }
+
+        // 3. In a group Herald made: stay while a quest is shared and the other one is near.
+        bool shared = false, near = false;
+        std::string sharedQuest;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* m = ref->getSource();
+            if (!m || m == bot)
+                continue;
+            partner = m->GetName();
+            if (!m->IsInMap(bot) || bot->GetDistance(m) > 150.0f)
+                continue;                    // another map's character is another thread's: only "apart"
+            near = true;
+            Shared sh = SharedQuest(bot, m);
+            if (sh.quest)
+            {
+                shared = true;
+                if (Quest const* q = sObjectMgr.GetQuestTemplate(sh.quest))
+                    sharedQuest = q->GetTitle();
+            }
+        }
+        bool leave = false;
+        {
+            std::lock_guard<std::mutex> g(s_lock);
+            State& s = *sp;
+            if (justFormed)
+                NoteLocked(ai, s, "Grouped with " + partner + (sharedQuest.empty() ? std::string() : " for " + sharedQuest));
+            s.idleChecks = shared ? 0 : s.idleChecks + 1;
+            s.apartChecks = near ? 0 : s.apartChecks + 1;
+            if (s.idleChecks >= 3 || s.apartChecks >= 4)
+            {
+                NoteLocked(ai, s, s.idleChecks >= 3 ? "Leaving the group: no quest left to share" : "Leaving the group: too far apart");
+                s.formedGroupId = 0;
+                s.idleChecks = s.apartChecks = 0;
+                leave = true;
+            }
+        }
+        if (leave)
+            QueueGroupPacket(bot, CMSG_GROUP_DISBAND);   // the client's "leave party"
+        return;
+    }
+
+    // 4. Not grouped: another Herald close by doing the same quest? Invite him (the lower guid asks).
+    {
+        std::lock_guard<std::mutex> g(s_lock);
+        if (sp->inviteTo && WorldTimer::getMSTimeDiff(sp->inviteMs, now) < 60000)
+            return;                          // an invite of his is still out
+        sp->formedGroupId = 0;
+    }
+    if (bot->GetGroupInvite())
+        return;
+    std::list<Player*> around;
+    MaNGOS::AnyPlayerInObjectRangeCheck check(bot, 80.0f);
+    MaNGOS::PlayerListSearcher<MaNGOS::AnyPlayerInObjectRangeCheck> searcher(around, check);
+    Cell::VisitWorldObjects(bot, searcher, 80.0f);
+    for (Player* p : around)
+    {
+        if (!OtherHerald(bot, p) || p->GetGroup() || p->GetGroupInvite() || p->IsInCombat() || !p->IsInMap(bot))
+            continue;
+        if (std::abs(int(p->GetLevel()) - int(bot->GetLevel())) > 4)
+            continue;
+        if (p->GetGUIDLow() < bot->GetGUIDLow())
+            continue;                        // the lower guid asks, so two Heralds never invite each other at once
+        Shared sh = SharedQuest(bot, p);
+        if (!sh.quest)
+            continue;
+        // the right moment: a group quest within 80 yd, or the same quest mobs within 40 yd (two players
+        // racing for the same kills are faster together)
+        if (!sh.group && bot->GetDistance(p) > 40.0f)
+            continue;
+        {
+            std::lock_guard<std::mutex> g(s_lock);
+            sp->inviteTo = p->GetGUIDLow();
+            sp->inviteMs = now;
+        }
+        std::string name = p->GetName();
+        QueueGroupPacket(bot, CMSG_GROUP_INVITE, &name);
+        return;
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// Errands at a vendor: gray items only, and repairs
+// ---------------------------------------------------------------------------------------------------------
+
+// The bot AI's own vendor habit is off for Herald (it sells anything it thinks it doesn't need, even an epic
+// mount), so when he stands next to a vendor he sells only gray (junk) items and repairs. Nothing else is
+// ever sold.
+static void VendorStep(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    if (bot->IsInCombat() || !bot->IsAlive() || bot->IsTaxiFlying())
+        return;
+    Creature* vendor = nullptr;
+    for (ObjectGuid const& g : ai->GetAiObjectContext()->GetValue<std::list<ObjectGuid>>("nearest npcs")->Get())
+    {
+        Creature* c = ai->GetCreature(g);
+        if (!c || !c->IsAlive() || bot->GetDistance(c) > 6.0f)
+            continue;
+        if (c->HasFlag(UNIT_NPC_FLAGS, UNIT_NPC_FLAG_VENDOR) || c->HasFlag(UNIT_NPC_FLAGS, UNIT_NPC_FLAG_REPAIR))
+        {
+            vendor = c;
+            break;
+        }
+    }
+    if (!vendor)
+        return;
+    uint64 key = vendor->GetObjectGuid().GetRawValue();
+    {
+        std::lock_guard<std::mutex> g(s_lock);
+        State& s = Get(bot);
+        uint32 now = WorldTimer::getMSTime();
+        if (s.lastVendor == key && WorldTimer::getMSTimeDiff(s.lastVendorMs, now) < 300000)
+            return;
+        s.lastVendor = key;
+        s.lastVendorMs = now;
+    }
+    bool sold = false, repaired = false;
+    if (vendor->HasFlag(UNIT_NPC_FLAGS, UNIT_NPC_FLAG_VENDOR))
+        sold = ai->DoSpecificAction("sell", Event("herald", "gray", bot), true);
+    uint8 durability = ai->GetAiObjectContext()->GetValue<uint8>("durability")->Get();
+    if (vendor->HasFlag(UNIT_NPC_FLAGS, UNIT_NPC_FLAG_REPAIR) && durability < 100)
+        repaired = ai->DoSpecificAction("repair", Event("herald", "", bot), true);
+    if (sold || repaired)
+        Note(ai, std::string(sold ? "Sold his gray items" : "") + (sold && repaired ? " and " : "") +
+             (repaired ? "repaired" : "") + " at " + vendor->GetName());
+}
+
+// ---------------------------------------------------------------------------------------------------------
+// The tick
+// ---------------------------------------------------------------------------------------------------------
+
+void Update(PlayerbotAI* ai, uint32 elapsed)
+{
+    if (!IsHerald(ai))
+        return;
+    Player* bot = ai->GetBot();
+    if (!bot->IsInWorld() || bot->IsBeingTeleported())
+        return;
+
+    std::string action;
+    bool groupNow = false, vendorNow = false;
+    {
+        std::lock_guard<std::mutex> g(s_lock);
+        State& s = Get(bot);
+        s.sampleMs += elapsed;
+        s.groupCheckMs += elapsed;
+        if (s.sampleMs < 1000)
+            return;
+        uint32 dt = s.sampleMs;
+        s.sampleMs = 0;
+        if (s.fight.active && bot->IsInCombat())
+        {
+            SampleFight(bot, s.fight);
+            s.fight.outOfCombatMs = 0;
+        }
+        else if (s.fight.active && bot->IsAlive() && (s.fight.outOfCombatMs += dt) >= 5000)
+            FinishFight(ai, s, "win");   // the bot AI didn't say the fight ended; it has
+        else if (!s.fight.active && bot->IsInCombat() && bot->IsAlive())
+        {
+            // a fight the bot AI didn't announce (he was attacked while walking): start it here
+            Fight& f = s.fight;
+            f = Fight();
+            f.active = true;
+            f.startMs = WorldTimer::getMSTime();
+            f.hp0 = bot->GetMaxHealth() ? float(bot->GetHealth()) / float(bot->GetMaxHealth()) : 0.0f;
+            f.mana0 = ManaPct(bot);
+            f.hpMin = f.hp0;
+            SampleFight(bot, f);
+        }
+        action = UnstuckStep(ai, s, dt);
+        s.vendorCheckMs += dt;
+        if (s.vendorCheckMs >= 5000)
+        {
+            s.vendorCheckMs = 0;
+            vendorNow = true;
+        }
+        if (s.groupCheckMs >= 15000)
+        {
+            s.groupCheckMs = 0;
+            groupNow = true;
+        }
+    }
+    if (!action.empty())
+        ai->DoSpecificAction(action, Event(), true);
+    if (groupNow)
+        GroupStep(ai);
+    if (vendorNow)
+        VendorStep(ai);
+}
+
+} // namespace HeraldBrain
