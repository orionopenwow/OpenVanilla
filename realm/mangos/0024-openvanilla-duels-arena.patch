diff --git a/src/game/OpenVanilla/DuelsRating.h b/src/game/OpenVanilla/DuelsRating.h
new file mode 100644
index 0000000..25850ae
--- /dev/null
+++ b/src/game/OpenVanilla/DuelsRating.h
@@ -0,0 +1,117 @@
+/*
+ * Open Vanilla — Duels' pure numbers (GPLv2, as CMaNGOS): the Glicko-2 rating, sudden death and Duel
+ * Points. No game objects, so realm/duels/tests/test_rounds.cpp runs them without a server. Used by
+ * WarfrontArena.cpp.
+ */
+
+#ifndef OPENVANILLA_DUELS_RATING_H
+#define OPENVANILLA_DUELS_RATING_H
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace Warfront
+{
+    namespace Arena
+    {
+        // ── Glicko-2 (Glickman, "Example of the Glicko-2 system", 2013), one game per update ──
+        //
+        // A rating r (shown, 1500 to start), its deviation rd (how sure: 350 new, smaller with every
+        // game) and the volatility vol. A new duelist moves fast and a settled one slowly; beating a
+        // much better player moves more than beating a weaker one. The deviation never goes below
+        // GLICKO_MIN_RD, so a long-time duelist still moves.
+        struct Glicko
+        {
+            double r = 1500.0;
+            double rd = 350.0;
+            double vol = 0.06;
+        };
+
+        double const GLICKO_SCALE = 173.7178;
+        double const GLICKO_TAU = 0.5;
+        double const GLICKO_MIN_RD = 50.0;
+        double const GLICKO_MAX_RD = 350.0;
+
+        // `score`: 1 a win, 0 a loss, 0.5 a draw.
+        inline Glicko GlickoAfter(Glicko me, Glicko opp, double score)
+        {
+            double const pi = 3.14159265358979323846;
+            double mu = (me.r - 1500.0) / GLICKO_SCALE, phi = me.rd / GLICKO_SCALE, sigma = me.vol;
+            double mu2 = (opp.r - 1500.0) / GLICKO_SCALE, phi2 = opp.rd / GLICKO_SCALE;
+            double g = 1.0 / std::sqrt(1.0 + 3.0 * phi2 * phi2 / (pi * pi));
+            double e = 1.0 / (1.0 + std::exp(-g * (mu - mu2)));
+            double v = 1.0 / (g * g * e * (1.0 - e));
+            double delta = v * g * (score - e);
+            // the new volatility: the Illinois method on f(x) = 0
+            double a = std::log(sigma * sigma);
+            auto f = [&](double x)
+            {
+                double ex = std::exp(x);
+                double d = phi * phi + v + ex;
+                return ex * (delta * delta - phi * phi - v - ex) / (2.0 * d * d) - (x - a) / (GLICKO_TAU * GLICKO_TAU);
+            };
+            double A = a, B;
+            if (delta * delta > phi * phi + v)
+                B = std::log(delta * delta - phi * phi - v);
+            else
+            {
+                int k = 1;
+                while (f(a - k * GLICKO_TAU) < 0 && k < 100)
+                    ++k;
+                B = a - k * GLICKO_TAU;
+            }
+            double fA = f(A), fB = f(B);
+            for (int i = 0; i < 100 && std::fabs(B - A) > 1e-6; ++i)
+            {
+                double C = A + (A - B) * fA / (fB - fA);
+                double fC = f(C);
+                if (fC * fB <= 0)
+                {
+                    A = B;
+                    fA = fB;
+                }
+                else
+                    fA /= 2.0;
+                B = C;
+                fB = fC;
+            }
+            double sigmaNew = std::exp(A / 2.0);
+            double phiStar = std::sqrt(phi * phi + sigmaNew * sigmaNew);
+            double phiNew = 1.0 / std::sqrt(1.0 / (phiStar * phiStar) + 1.0 / v);
+            double muNew = mu + phiNew * phiNew * g * (score - e);
+            Glicko out;
+            out.r = std::max(0.0, muNew * GLICKO_SCALE + 1500.0);
+            out.rd = std::max(GLICKO_MIN_RD, std::min(GLICKO_MAX_RD, phiNew * GLICKO_SCALE));
+            out.vol = std::max(0.01, std::min(0.2, sigmaNew));
+            return out;
+        }
+
+        // ── sudden death ("the crowd grows impatient") ──
+        //
+        // From `startMs` into a round, one stack now and one more every `everyMs`, up to `maxStacks`:
+        // each stack is 10% more damage taken and 15% less healing taken (no healing at 7 stacks).
+        inline uint32_t SuddenDeathStacks(uint32_t fightMs, uint32_t startMs, uint32_t everyMs, uint32_t maxStacks)
+        {
+            if (!startMs || fightMs < startMs || !everyMs)
+                return 0;
+            return std::min<uint32_t>(maxStacks, 1 + (fightMs - startMs) / everyMs);
+        }
+
+        inline float SuddenDeathDamageTaken(uint32_t stacks) { return 1.0f + 0.10f * float(stacks); }
+        inline float SuddenDeathHealingTaken(uint32_t stacks) { return std::max(0.0f, 1.0f - 0.15f * float(stacks)); }
+
+        // ── Duel Points: earned only, never sold, for cosmetics only ──
+        //
+        // 25 for a rated win, 5 for a rated loss (showing up counts), 10 more for ending a streak of
+        // three or more wins.
+        inline uint32_t DuelPoints(bool won, uint32_t opponentStreak)
+        {
+            if (!won)
+                return 5;
+            return 25 + (opponentStreak >= 3 ? 10 : 0);
+        }
+    }
+}
+
+#endif
