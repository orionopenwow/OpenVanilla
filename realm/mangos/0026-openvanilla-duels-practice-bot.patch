+            // The practice bot at its gate, friendly and rooted until "go" (the player's map thread).
+            ObjectGuid SpawnBot(Player* p, ObjectGuid old)
+            {
+                if (!old.IsEmpty())
+                    if (Creature* c = p->GetMap()->GetCreature(old))
+                        c->ForcedDespawn();
+                float const* s = ArenaSite().spawn[1];
+                Creature* c = p->SummonCreature(DuelsConf().practiceBotEntry, s[0], s[1], GroundZ(p, s[0], s[1], s[2]), s[3], TEMPSPAWN_MANUAL_DESPAWN, 0);
+                if (!c)
+                    return ObjectGuid();
+                c->setFaction(BOT_FRIENDLY);
+                c->SetImmobilizedState(true);
+                return c->GetObjectGuid();
+            }
+
+            void BotGo(Player* p, ObjectGuid guid)
+            {
+                Creature* c = p->GetMap()->GetCreature(guid);
+                if (!c || !c->IsAlive())
+                    return;
+                c->setFaction(BOT_HOSTILE);
+                c->SetImmobilizedState(false);
+                if (c->AI())
+                    c->AI()->AttackStart(p);
+            }
+
+            void DespawnBot(Player* p, ObjectGuid guid)
+            {
+                if (!guid.IsEmpty())
+                    if (Creature* c = p->GetMap()->GetCreature(guid))
+                        c->ForcedDespawn();
+            }
+        }
