+                                  (open && Bettable(m) ? "1," : "0,") + std::to_string(left) + "," + std::to_string(mySide) + "," + std::to_string(myAmount));
+                }
+                std::string sideArg, amountArg;
+                in >> sideArg >> amountArg;
+                uint32 side = uint32(std::strtoul(sideArg.c_str(), nullptr, 10));
+                uint32 amount = uint32(std::strtoul(amountArg.c_str(), nullptr, 10));
+                char const* why = nullptr;
+                if (!Bettable(m))
+                    why = "unrated";
+                else if (!open)
+                    why = "closed";
+                else if (side > 1 || !amount)
+                    why = "bad";
+                else if (m.members.count(guid) || g_inMatch.count(guid))
+                    why = "match";
+                else if (m.fighterAccounts.count(account))
+                    why = "self";
+                else if (!address.empty() && m.fighterAddresses.count(address))
+                    why = "address";
+                else if (mySide >= 0)
+                    why = "already";
+                else if (amount > DuelsConf().betMax)
+                    why = "max";
+                else if (w.betToday + amount > DuelsConf().betDaily)
+                    why = "daily";
+                else if (int64(amount) > w.gold)
+                    why = "gold";
+                if (why)
+                    return Say(p, std::string("bet,err,") + why);
+                Match::Bet b;
+                b.account = account;
+                b.guid = guid;
+                b.side = uint8(side);
+                b.amount = amount;
+                m.bets.push_back(b);
