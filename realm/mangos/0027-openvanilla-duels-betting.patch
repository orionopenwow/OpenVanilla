+            uint32 Today() { return uint32(time(nullptr) / DAY); }
+
+            // read a wallet from the database (no lock: before taking g_lock), making it if new
+            Wallet LoadWallet(uint32 account)
+            {
+                Wallet w;
+                w.day = Today();
+                if (auto r = CharacterDatabase.PQuery("SELECT gold, day, bet_today FROM duels_wallet WHERE account = %u", account))
+                {
+                    Field* f = r->Fetch();
+                    w.gold = int64(f[0].GetUInt32());
+                    w.day = f[1].GetUInt32();
+                    w.betToday = f[2].GetUInt32();
+                    return w;
+                }
+                w.gold = DuelsConf().betStart;
+                CharacterDatabase.PExecute("INSERT IGNORE INTO duels_wallet (account, gold, day, bet_today) VALUES (%u, %u, %u, 0)",
+                                           account, DuelsConf().betStart, w.day);
+                return w;
+            }
+
+            // the cached wallet (g_lock held); a new day tops it back up to the start and clears the day's bets
+            Wallet& WalletOf(uint32 account, Wallet const& loaded)
+            {
+                auto it = g_wallets.find(account);
+                if (it == g_wallets.end())
+                    it = g_wallets.emplace(account, loaded).first;
+                Wallet& w = it->second;
+                uint32 today = Today();
+                if (w.day != today)
+                {
+                    w.day = today;
+                    w.betToday = 0;
+                    if (w.gold < int64(DuelsConf().betStart))
+                        w.gold = DuelsConf().betStart;
+                    CharacterDatabase.PExecute("UPDATE duels_wallet SET day = %u, bet_today = 0, gold = GREATEST(gold, %u) WHERE account = %u",
+                                               today, DuelsConf().betStart, account);
+                }
+                return w;
+            }
+
+            // gold in or out of a wallet (g_lock held); a wallet not cached is changed in the database only
+            void WalletAdd(uint32 account, int64 delta)
+            {
+                if (!account || !delta)
+                    return;
+                auto it = g_wallets.find(account);
+                if (it != g_wallets.end())
+                    it->second.gold = std::max<int64>(0, it->second.gold + delta);
+                if (delta > 0)
+                    CharacterDatabase.PExecute("UPDATE duels_wallet SET gold = gold + %u WHERE account = %u", uint32(delta), account);
+                else
+                    CharacterDatabase.PExecute("UPDATE duels_wallet SET gold = IF(gold >= %u, gold - %u, 0) WHERE account = %u",
+                                               uint32(-delta), uint32(-delta), account);
+            }
+
+            int64 GoldOf(uint32 account)
+            {
+                auto it = g_wallets.find(account);
+                return it == g_wallets.end() ? -1 : it->second.gold;
+            }
+
+            void BetNote(uint32 guid, std::string const& line) { g_betNotes[guid].push_back(line); }
+
+            bool Bettable(Match const& m) { return DuelsConf().betting && m.rated && !m.vsBot && MODE_SIZE[m.mode] == 1; }
+
+            // round one begins: bets close; equal stakes from both fighters are taken from both wallets (g_lock held)
+            void LockStakes(Match& m)
+            {
+                m.betsOpen = false;
+                if (!Bettable(m) || m.staked)
+                    return;
+                uint32 offered = m.stake[0];
+                bool same = offered > 0 && m.stake[1] == offered;
+                bool afford = same;
+                for (auto const& kv : m.members)
+                    if (same && GoldOf(kv.second.account) < int64(offered))
+                        afford = false;
+                for (auto const& kv : m.members)
+                {
+                    if (afford)
+                        WalletAdd(kv.second.account, -int64(offered));
+                    if (m.stake[0] || m.stake[1])
+                        BetNote(kv.first, afford ? "stake,on," + std::to_string(offered) : std::string("stake,off"));
+                }
+                if (afford)
+                    m.staked = offered;
+            }
+
+            // pay out (g_lock held, once): stakes, the winner's prize, and the spectators' pool. Only the losing
+            // side's gold is burned (a part), so a winning bet never gets back less than it put in; no bets on
+            // the winner, a draw or a cancelled match: every bet comes back.
+            void Settle(Match& m)
+            {
+                if (m.settled)
+                    return;
+                m.settled = true;
+                if (!DuelsConf().betting)
+                    return;
+                int w = m.winner;
+                bool decided = w == 0 || w == 1;
+                for (auto const& kv : m.members)
+                {
+                    Member const& mem = kv.second;
+                    int64 gain = 0;
+                    if (m.staked)
+                        gain += decided ? (mem.team == w ? 2 * int64(m.staked) : 0) : int64(m.staked);
+                    if (decided && mem.team == w && !mem.left && m.rated && !m.vsBot)
+                        gain += DuelsConf().winPrize;
+                    WalletAdd(mem.account, gain);
+                    if (m.staked)
+                        BetNote(kv.first, std::string("stake,") + (!decided ? "back," : (mem.team == w ? "won," : "lost,")) +
+                                          std::to_string(decided && mem.team == w ? 2 * m.staked : m.staked));
+                    if (gain && GoldOf(mem.account) >= 0)
+                        BetNote(kv.first, "wallet," + std::to_string(GoldOf(mem.account)));
+                }
+                uint64 pool[2] = { 0, 0 };
+                for (auto const& b : m.bets)
+                    pool[b.side] += b.amount;
+                bool refund = !decided || pool[w] == 0;
+                uint64 pot = decided ? pool[w] + pool[1 - w] * (100 - DuelsConf().betBurnPct) / 100 : 0;
+                for (auto const& b : m.bets)
+                {
+                    uint64 paid = refund ? b.amount : (b.side == w ? uint64(b.amount) * pot / pool[w] : 0);
+                    if (!refund && b.side == w && paid < b.amount)
+                        paid = b.amount;
+                    WalletAdd(b.account, int64(paid));
+                    CharacterDatabase.PExecute("INSERT INTO duels_bet (ended, match_id, account, side, amount, paid) VALUES (UNIX_TIMESTAMP(), %u, %u, %u, %u, %u)",
+                                               m.id, b.account, uint32(b.side), b.amount, uint32(paid));
+                    std::string what = refund ? "back" : (b.side == w ? "won" : "lost");
+                    BetNote(b.guid, "bet," + what + "," + std::to_string(m.id) + "," + std::to_string(refund || b.side == w ? paid : b.amount) +
+                                    "," + std::to_string(std::max<int64>(0, GoldOf(b.account))));
+                }
+            }
+
