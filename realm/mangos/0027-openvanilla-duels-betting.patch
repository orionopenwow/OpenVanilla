+                WalletAdd(account, -int64(amount));
+                CharacterDatabase.PExecute("UPDATE duels_wallet SET bet_today = bet_today + %u WHERE account = %u", amount, account);
+                return Say(p, "bet,ok," + std::to_string(m.id) + "," + std::to_string(side) + "," + std::to_string(amount) + "," + std::to_string(w.gold));
+            }
