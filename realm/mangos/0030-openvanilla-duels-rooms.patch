+                    bool used = false;
+                    for (auto const& kv : g_rooms)
+                        if (kv.second.code == c)
+                            used = true;
+                    if (!used)
+                        return c;
+                }
+                return std::to_string(g_nextRoom) + "X";
+            }
+
+            Room* RoomByCode(std::string code)
+            {
+                std::transform(code.begin(), code.end(), code.begin(), ::toupper);
+                for (auto& kv : g_rooms)
+                    if (kv.second.code == code)
+                        return &kv.second;
+                return nullptr;
+            }
+
+            char const* ACCESS_NAME[3] = { "link", "public", "password" };
