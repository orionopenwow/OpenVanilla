+            // -- hosted rooms (patch 0030) -------------------------------------------------------------
+            std::string RoomCode()
+            {
+                static char const A[] = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+                for (int tries = 0; tries < 50; ++tries)
+                {
+                    std::string c;
+                    for (int i = 0; i < 6; ++i)
