+                return "room,on," + r.code + "," + MODE_NAME[r.mode] + "," + std::to_string(r.bestOf) + "," + (r.suddenDeath ? "1," : "0,") +
+                       (r.bets ? "1," : "0,") + ACCESS_NAME[r.access] + "," + r.hostName + "," + std::to_string(r.members.size()) + "," +
+                       (r.host == guid ? "1" : "0");
+            }
+
+            // "roominfo;<code>;<name>:<wins>:<losses>:<here 0|1>;..." (members first, then past ladder entries)
+            std::string RoomInfo(Room const& r)
+            {
+                std::vector<std::pair<uint32, std::pair<uint32, uint32>>> rows;
+                std::set<uint32> seen;
+                for (uint32 g : r.members)
+                {
+                    auto l = r.ladder.find(g);
+                    rows.push_back({ g, l == r.ladder.end() ? std::make_pair(0u, 0u) : l->second });
+                    seen.insert(g);
+                }
+                for (auto const& kv : r.ladder)
+                    if (!seen.count(kv.first))
+                        rows.push_back(kv);
+                std::sort(rows.begin(), rows.end(), [](auto const& a, auto const& b) { return a.second.first > b.second.first; });
+                std::string b = "roominfo;" + r.code;
+                for (size_t i = 0; i < rows.size() && i < 20; ++i)
+                {
+                    auto n = r.names.find(rows[i].first);
+                    b += ";" + (n == r.names.end() ? std::string("?") : n->second) + ":" + std::to_string(rows[i].second.first) + ":" +
+                         std::to_string(rows[i].second.second) + ":" + (r.members.count(rows[i].first) ? "1" : "0");
+                }
+                return b;
+            }
+
+            void LeaveRoom(uint32 guid)                         // g_lock held
+            {
+                auto ro = g_roomOf.find(guid);
+                if (ro == g_roomOf.end())
+                    return;
+                auto rit = g_rooms.find(ro->second);
+                g_roomOf.erase(ro);
+                if (rit == g_rooms.end())
+                    return;
+                Room& r = rit->second;
+                r.members.erase(guid);
+                for (uint32 g : r.members)
+                    BetNote(g, "room,left," + r.names[guid]);
+                if (r.members.empty())
+                    r.emptySince = time(nullptr);
+                else if (r.host == guid)
+                {
+                    r.host = *r.members.begin();
+                    r.hostName = r.names[r.host];
+                    for (uint32 g : r.members)
+                        BetNote(g, RoomLine(r, g));
+                }
+            }
+
