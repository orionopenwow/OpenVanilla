+            // patch 0031: everyone accepts, then the match ports as before. A no, a logout or 30 s without
+            // an answer: whoever accepted goes back into the queue where they were, the rest are out of it.
+            bool ConfirmTick(Match& m, uint32 diff)             // g_lock held; true: the match is gone
+            {
+                m.clock += diff;
+                bool all = true, no = false;
+                for (auto const& kv : m.members)
+                {
+                    if (!kv.second.accepted)
+                        all = false;
+                    if (kv.second.declined)
+                        no = true;
+                }
+                if (all && !no)
+                {
+                    m.phase = PORTING;
+                    m.clock = 0;
+                    for (auto const& kv : m.members)
+                        BetNote(kv.first, "ready,go," + std::to_string(m.id));
+                    sLog.outString("Open Vanilla Duels: match %u accepted by all %u", m.id, uint32(m.members.size()));
+                    return false;
+                }
+                if (!no && m.clock < READY_MS)
+                    return false;
+                uint32 back = 0;
+                for (Ticket const& t : m.tickets)
+                {
+                    bool ok = true;
+                    for (uint32 g : t.guids)
+                    {
+                        auto mk = m.members.find(g);
+                        if (mk == m.members.end() || !mk->second.accepted || mk->second.declined)
+                            ok = false;
+                    }
+                    for (uint32 g : t.guids)
+                    {
+                        auto gi = g_inMatch.find(g);
+                        if (gi != g_inMatch.end() && gi->second == m.id)
+                            g_inMatch.erase(gi);
+                        if (!ok)
+                            BetNote(g, "ready,missed," + std::to_string(m.id));
+                    }
+                    if (!ok || (t.room && !g_rooms.count(t.room)))
+                        continue;
+                    g_queue[m.mode].push_front(t);  // where they were: the oldest first
+                    for (uint32 g : t.guids)
+                    {
+                        g_queued[g] = m.mode;
+                        BetNote(g, "ready,back," + std::to_string(m.id));
+                        Notice(g, std::string("q,") + MODE_NAME[m.mode] + ",0," + std::to_string(g_queue[m.mode].size()));
+                        ++back;
+                    }
+                }
+                std::stable_sort(g_queue[m.mode].begin(), g_queue[m.mode].end(), [](Ticket const& a, Ticket const& b) { return a.joined < b.joined; });
+                sLog.outString("Open Vanilla Duels: match %u not accepted (%s); %u back in the queue", m.id, no ? "declined" : "no answer", back);
+                return true;
+            }
