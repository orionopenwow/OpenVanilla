+    // ── CL: cast bars for everyone near (patch 0032) ──
+
+    void CastBar(::Unit const* caster, SpellEntry const* info, uint32 durationMs, bool channel, int stop)
+    {
+        if (!caster || !info || !caster->IsInWorld() || !Config().castBars)
+            return;
+        if (stop < 0 && durationMs == 0)
+            return;
+        Map* map = caster->GetMap();
+        if (!map)
+            return;
+        std::string name = caster->GetName();
+        if (name.empty())
+            return;
+        std::string spell = info->SpellName[0] ? info->SpellName[0] : "";
+        for (char& c : spell)
+            if (c == ',' || c == ';')
+                c = ' ';
+        for (char& c : name)
+            if (c == ',' || c == ';')
+                c = ' ';
+        bool kickable = info->PreventionType == SPELL_PREVENTION_TYPE_SILENCE;
+        Map::PlayerList const& players = map->GetPlayers();
+        for (auto const& ref : players)
+        {
+            Player* r = ref.getSource();
+            if (!r || r == caster || !r->IsInWorld() || !r->GetSession() || r->GetSession()->PlayerLoading())
+                continue;
+            if (!r->IsWithinDist(caster, 45.0f))
+                continue;
+            bool targeted = r->GetSelectionGuid() == caster->GetObjectGuid();
+            if (!targeted && !r->IsEnemy(caster))
+                continue;
+            char const* role = targeted ? "target" : "plate";
+            std::string body;
+            if (stop < 0)
+                body = std::string(role) + "," + name + "," + spell + "," + std::to_string(durationMs) + "," + (kickable ? "1" : "0") + ",," + (channel ? "1" : "0");
+            else
+                body = std::string("stop,") + role + "," + name + "," + (stop ? "1" : "0");
+            Send(r, "CL", body);
+        }
+    }
+
