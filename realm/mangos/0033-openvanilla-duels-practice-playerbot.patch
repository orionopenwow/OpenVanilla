+            // patch 0033: practice bots are characters on the bot AI's own accounts (RNDBOT*, never on the
+            // ladder), one per class, made the first time a class is needed and kept (duels_practice_bot).
+            bool PlayerbotPractice()
+            {
+                return DuelsConf().practiceBotPlayer && sPlayerbotAIConfig.enabled;
+            }
+
+            uint32 LoginPracticeBot()                           // g_lock held; 0: none could be had
+            {
+                static uint8 const CLASSES[] = { 1, 2, 3, 4, 5, 7, 8, 9, 11 };
+                uint8 cls = CLASSES[urand(0, 8)];
+                uint32 guid = 0;
+                if (auto q = CharacterDatabase.PQuery("SELECT p.guid FROM duels_practice_bot p JOIN characters c ON c.guid = p.guid "
+                                                      "WHERE p.class = %u AND c.online = 0", uint32(cls)))
+                {
+                    do
+                    {
+                        uint32 g = q->Fetch()[0].GetUInt32();
+                        if (!g_practiceBots.count(g) && !sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, g)))
+                        {
+                            guid = g;
+                            break;
+                        }
+                    } while (q->NextRow());
+                }
+                if (!guid)
+                {
+                    std::list<std::string> said;
+                    ObjectGuid made;
+                    sRandomPlayerbotMgr.CreateBot(nullptr, "class=" + std::to_string(uint32(cls)) + " level=60 login=0", said, made);
+                    if (made.IsEmpty())
+                    {
+                        sLog.outError("Open Vanilla Duels: could not make a practice bot (%s)", said.empty() ? "no answer" : said.front().c_str());
+                        return 0;
+                    }
+                    guid = made.GetCounter();
+                    CharacterDatabase.PExecute("REPLACE INTO duels_practice_bot (guid, class, prepared) VALUES (%u, %u, 0)", guid, uint32(cls));
+                    sLog.outString("Open Vanilla Duels: practice bot %u made (class %u)", guid, uint32(cls));
+                }
+                g_practiceBots.insert(guid);
+                sRandomPlayerbotMgr.AddPlayerBot(guid, 0);
+                return guid;
+            }
+
+            // once in the world: level 60, the bot AI's own gear, spells and talents for it (the first time),
+            // full health, and only fighting: no wandering, questing or grinding
+            void PreparePracticeBot(Player* b)                  // world thread
+            {
+                bool first = true;
+                if (auto q = CharacterDatabase.PQuery("SELECT prepared FROM duels_practice_bot WHERE guid = %u", b->GetGUIDLow()))
+                    first = q->Fetch()[0].GetUInt32() == 0;
+                if (b->GetLevel() < 60)
+                    b->GiveLevel(60);
+                if (first)
+                {
+                    PlayerbotFactory factory(b, 60, ITEM_QUALITY_EPIC);
+                    factory.Randomize(false, false);
+                    CharacterDatabase.PExecute("UPDATE duels_practice_bot SET prepared = 1 WHERE guid = %u", b->GetGUIDLow());
+                }
+                if (PlayerbotAI* ai = b->GetPlayerbotAI())
+                    ai->ChangeStrategy("+pvp,+stay,-rpg,-travel,-grind,-quest,-loot,-gather,-follow,-wander,-explore", BotState::BOT_STATE_NON_COMBAT);
+                b->SetHealth(b->GetMaxHealth());
+                if (b->GetPowerType() == POWER_MANA)
+                    b->SetPower(POWER_MANA, b->GetMaxPower(POWER_MANA));
+            }
+
+            void LogoutPracticeBot(uint32 guid)                 // world thread
+            {
+                g_practiceBots.erase(guid);
+                if (sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, guid)))
+                    sRandomPlayerbotMgr.LogoutPlayerBot(guid);
+            }
+
+            // every 2 s: bots that came in get ready; bots nobody waits for or fights go
+            void PracticeBotsTick()                             // g_lock held, world thread
+            {
+                for (auto& kv : g_botAsk)
+                {
+                    BotAsk& a = kv.second;
+                    if (!a.bot || a.ready)
+                        continue;
+                    Player* b = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, a.bot));
+                    if (b && b->IsInWorld() && b->GetPlayerbotAI() && !b->IsBeingTeleported())
+                    {
+                        PreparePracticeBot(b);
+                        a.ready = true;
+                    }
+                }
+                for (auto it = g_botAsk.begin(); it != g_botAsk.end();)
+                {
+                    auto q = g_queued.find(it->first);
+                    if (q == g_queued.end() || q->second != U1)
+                        it = g_botAsk.erase(it);    // stopped waiting (or got a person): the bot goes below
+                    else
+                        ++it;
+                }
+                std::vector<uint32> gone;
+                for (uint32 g : g_practiceBots)
+                {
+                    bool wanted = g_inMatch.count(g) != 0;
+                    for (auto const& kv : g_botAsk)
+                        if (kv.second.bot == g)
+                            wanted = true;
+                    if (!wanted)
+                        gone.push_back(g);
+                }
+                for (uint32 g : gone)
+                    LogoutPracticeBot(g);
+            }
+#endif
