+            // patch 0035: one bot per class (as many as asked), kept in duels_hub_bot and logged in at start
+            void HubBotsTick(uint32 diff)                       // g_lock held, world thread, every 2 s
+            {
+                DuelsSettings const& d = DuelsConf();
+                if (!d.hubBots || !d.hub || !sPlayerbotAIConfig.enabled)
+                    return;
+                // in: the next one missing (one a tick)
+                if (g_hubBots.size() < d.hubBots)
+                {
+                    static uint8 const CLASSES[] = { 1, 2, 3, 4, 5, 7, 8, 9, 11 };
+                    uint8 cls = CLASSES[g_hubBots.size() % 9];
+                    uint32 guid = 0;
+                    if (auto q = CharacterDatabase.PQuery("SELECT guid FROM duels_hub_bot WHERE slot = %u", uint32(g_hubBots.size())))
+                        guid = q->Fetch()[0].GetUInt32();
+                    if (guid && !sObjectMgr.GetPlayerAccountIdByGUID(ObjectGuid(HIGHGUID_PLAYER, guid)))
+                        guid = 0;                   // its character is gone: make another
+                    if (!guid)
+                    {
+                        std::list<std::string> said;
+                        ObjectGuid made;
+                        sRandomPlayerbotMgr.CreateBot(nullptr, "class=" + std::to_string(uint32(cls)) + " level=60 login=0", said, made);
+                        if (made.IsEmpty())
+                            return;
+                        guid = made.GetCounter();
+                        CharacterDatabase.PExecute("REPLACE INTO duels_hub_bot (slot, guid, class) VALUES (%u, %u, %u)", uint32(g_hubBots.size()), guid, uint32(cls));
+                    }
+                    g_hubBots[guid] = HubBot();
+                    sRandomPlayerbotMgr.AddPlayerBot(guid, 0);
+                    sLog.outString("Open Vanilla Duels: hangout bot %u of %u (class %u) logging in", uint32(g_hubBots.size()), d.hubBots, uint32(cls));
+                    return;
+                }
+                // ready: level 60, the bot AI's gear the first time, no wandering off on its own
+                uint32 idle = 0;
+                bool duelOn = false;
+                for (auto& kv : g_hubBots)
+                {
+                    HubBot& hb = kv.second;
+                    Player* b = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, kv.first));
+                    if (!b || !b->IsInWorld())
+                    {
+                        if (hb.ready)
+                        {
+                            hb = HubBot();      // logged out (a restart of its session): in again
+                            sRandomPlayerbotMgr.AddPlayerBot(kv.first, 0);
+                        }
+                        continue;
+                    }
+                    if (!hb.ready && b->GetPlayerbotAI() && !b->IsBeingTeleported())
+                    {
+                        if (b->GetLevel() < 60)
+                            b->GiveLevel(60);
+                        bool first = true;
+                        if (auto q = CharacterDatabase.PQuery("SELECT prepared FROM duels_hub_bot WHERE guid = %u", kv.first))
+                            first = q->Fetch()[0].GetUInt32() == 0;
+                        if (first)
+                        {
+                            PlayerbotFactory factory(b, 60, ITEM_QUALITY_EPIC);
+                            factory.Randomize(false, false);
+                            CharacterDatabase.PExecute("UPDATE duels_hub_bot SET prepared = 1 WHERE guid = %u", kv.first);
+                        }
+                        b->GetPlayerbotAI()->ChangeStrategy("-rpg,-rpg jump,-travel,-grind,-quest,-loot,-gather,-wander,-follow,-follow jump,"
+                                                            "-mount,-lfg,-bg,-battleground,-arena,-group,-guild,-start duel,-ai chat,-tfish,+duel",
+                                                            BotState::BOT_STATE_NON_COMBAT);
+                        hb.ready = true;
+                        hb.timer = int32(urand(2, 10)) * IN_MILLISECONDS;
+                    }
+                    if (hb.doing == HB_TO_DUEL || hb.doing == HB_ASKED || hb.doing == HB_DUELING)
+                        duelOn = true;
+                    else if (hb.ready)
+                        ++idle;
+                }
+                // every so often two idle ones go and duel
+                g_hubDuelClock += diff;
+                if (duelOn || idle < 2 || g_hubDuelClock < d.hubBotDuelMs)
+                    return;
+                g_hubDuelClock = urand(0, d.hubBotDuelMs / 3);      // not like clockwork
+                std::vector<uint32> free;
+                for (auto const& kv : g_hubBots)
+                    if (kv.second.ready && (kv.second.doing == HB_WANDER || kv.second.doing == HB_AFK))
+                        free.push_back(kv.first);
+                if (free.size() < 2)
+                    return;
+                uint32 a = free[urand(0, uint32(free.size()) - 1)], b;
+                do { b = free[urand(0, uint32(free.size()) - 1)]; } while (b == a);
+                for (uint32 g : { a, b })
+                {
+                    HubBot& hb = g_hubBots[g];
+                    hb.doing = HB_TO_DUEL;
+                    hb.timer = 60 * IN_MILLISECONDS;     // to get there and start
+                    hb.partner = g == a ? b : a;
+                    hb.asks = g == a;
+                }
+            }
+
+            float BotGroundZ(Player* p, float x, float y, float z)
+            {
+                float g = p->GetMap()->GetHeight(x, y, z + 6.0f);
+                return g > INVALID_HEIGHT && std::fabs(g - z) < 20.0f ? g + 0.1f : z;
+            }
+
+            // the bot's own update (its map thread): walking, AFK, the walk to a duel and asking for it
+            void HubBotStep(Player* p, uint32 diff, std::unique_lock<std::mutex>& guard)    // g_lock held on entry
+            {
+                DuelsSettings const& d = DuelsConf();
+                auto it = g_hubBots.find(p->GetGUIDLow());
+                if (it == g_hubBots.end() || !it->second.ready)
+                    return;
+                HubBot& hb = it->second;
+                if (p->duel)
+                {
+                    hb.doing = HB_DUELING;
+                    return;
+                }
+                if (hb.doing == HB_DUELING)
+                {
+                    hb.doing = HB_WANDER;           // the duel is over (the hangout reset both)
+                    hb.partner = 0;
+                    hb.timer = int32(urand(5, 15)) * IN_MILLISECONDS;
+                    return;
+                }
+                if (p->IsInCombat() || !p->IsAlive())
+                    return;
+                hb.timer -= int32(diff);
+                float cx = d.fenceX, cy = d.fenceY, cz = d.hubZ;
+                switch (hb.doing)
+                {
+                    case HB_AFK:
+                        if (hb.timer > 0)
+                            return;
+                        hb.doing = HB_WANDER;
+                        hb.timer = 0;
+                        guard.unlock();
+                        if (p->isAFK())
+                            p->ToggleAFK();
+                        p->SetStandState(UNIT_STAND_STATE_STAND);
+                        return;
+                    case HB_WANDER:
+                    {
+                        if (hb.timer > 0)
+                            return;
+                        if (urand(0, 99) < 12)
+                        {
+                            // away from the keyboard for two to five minutes
+                            hb.doing = HB_AFK;
+                            hb.timer = int32(urand(120, 300)) * IN_MILLISECONDS;
+                            guard.unlock();
+                            p->GetMotionMaster()->Clear();
+                            p->StopMoving();
+                            if (!p->isAFK())
+                                p->ToggleAFK();
+                            if (urand(0, 1))
+                                p->SetStandState(UNIT_STAND_STATE_SIT);
+                            return;
+                        }
+                        hb.timer = int32(urand(8, 25)) * IN_MILLISECONDS;
+                        float a = frand(0.0f, 2.0f * float(M_PI)), r = frand(4.0f, 30.0f);
+                        float x = cx + r * std::cos(a), y = cy + r * std::sin(a);
+                        guard.unlock();
+                        p->SetStandState(UNIT_STAND_STATE_STAND);
+                        p->GetMotionMaster()->MovePoint(0, x, y, BotGroundZ(p, x, y, p->GetPositionZ()));
+                        return;
+                    }
+                    case HB_TO_DUEL:
+                    case HB_ASKED:
+                    {
+                        float x = cx + (hb.asks ? -3.0f : 3.0f), y = cy;
+                        uint32 partner = hb.partner;
+                        bool asks = hb.asks, asked = hb.doing == HB_ASKED;
+                        if (hb.timer <= 0)
+                        {
+                            hb.doing = HB_WANDER;           // it didn't happen: on with the day
+                            hb.timer = 0;
+                            auto pit = g_hubBots.find(partner);
+                            if (pit != g_hubBots.end() && (pit->second.doing == HB_TO_DUEL || pit->second.doing == HB_ASKED))
+                                pit->second.doing = HB_WANDER, pit->second.timer = 0;
+                            return;
+                        }
+                        bool there = p->GetDistance2d(x, y) < 2.5f;
+                        guard.unlock();
+                        if (p->isAFK())
+                            p->ToggleAFK();
+                        if (!there)
+                        {
+                            if (!p->IsMoving())
+                            {
+                                p->SetStandState(UNIT_STAND_STATE_STAND);
+                                p->GetMotionMaster()->MovePoint(0, x, y, BotGroundZ(p, x, y, cz));
+                            }
+                            return;
+                        }
+                        Player* other = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, partner));
+                        if (!other || other->GetMap() != p->GetMap())
+                            return;
+                        p->SetFacingToObject(other);
+                        if (asks && !asked && !p->duel && !other->duel && p->GetDistance(other) < 10.0f && !other->IsMoving())
+                        {
+                            p->CastSpell(other, 7266, TRIGGERED_OLD_TRIGGERED);     // Duel: the bot AI says yes
+                            std::lock_guard<std::mutex> again(g_lock);
+                            auto me = g_hubBots.find(p->GetGUIDLow());
+                            if (me != g_hubBots.end())
+                            {
+                                me->second.doing = HB_ASKED;
+                                me->second.timer = 20 * IN_MILLISECONDS;
+                            }
+                        }
+                        return;
+                    }
+                    default:
+                        return;
+                }
+            }
 #endif
 
