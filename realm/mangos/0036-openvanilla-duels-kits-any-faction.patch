Open Vanilla 0036: Duels kits for every race and class pair. With closed combos off a Horde paladin or an Alliance
shaman has no kit of their own faction: on Duels the other faction's kit is put on, and each piece they can't
wear (the other faction's PvP piece) becomes the item pool's nearest piece of the same kind they can, closest
in item level. "kitbags" does the same when it fills the bags.

diff --git a/src/game/OpenVanilla/Warfront.cpp b/src/game/OpenVanilla/Warfront.cpp
index e1fc3bfb2..b71e543f3 100644
--- a/src/game/OpenVanilla/Warfront.cpp
+++ b/src/game/OpenVanilla/Warfront.cpp
@@ -311,6 +311,44 @@ namespace Warfront
             return true;
         }
 
+        // patch 0036: a kit piece this character can't wear (the other faction's PvP piece, on a race and
+        // class pair the kits weren't made for): the pool's nearest piece of the same kind they can,
+        // closest in item level. 0 if none.
+        uint32 Substitute(Player* p, uint32 itemId, uint8 slot)
+        {
+            ItemPrototype const* want = sObjectMgr.GetItemPrototype(itemId);
+            if (!want)
+                return 0;
+            if (UsableBy(p, want))
+                return itemId;
+            uint32 best = 0;
+            int bestGap = 1000;
+            for (auto const& it : g_pool)
+            {
+                ItemPrototype const* proto = sObjectMgr.GetItemPrototype(it.first);
+                if (!proto || proto->Class != want->Class || proto->SubClass != want->SubClass || proto->InventoryType != want->InventoryType)
+                    continue;
+                if (!UsableBy(p, proto) || !FitsSlot(proto, slot, p->CanDualWield()))
+                    continue;
+                int gap = std::abs(int(proto->ItemLevel) - int(want->ItemLevel));
+                if (gap < bestGap || (gap == bestGap && proto->Quality > sObjectMgr.GetItemPrototype(best)->Quality))
+                {
+                    best = it.first;
+                    bestGap = gap;
+                }
+            }
+            return best;
+        }
+
+        // patch 0036: does this character have kits of their own faction? (a Horde paladin has none)
+        bool HasOwnFactionKit(Player* p)
+        {
+            for (auto const& kv : g_kits)
+                if (kv.second.playerClass == p->getClass() && kv.second.alliance == (p->GetTeam() == ALLIANCE))
+                    return true;
+            return false;
+        }
+
