                 // thread checks each of them when the match pops
                 std::vector<uint32> party{ guid };
-                if (Group* g = p->GetGroup())
+                // patch 0037 (Duels): a 1v1 is always yourself, in a party or not; 2v2 and 3v3 are a party
+                // of exactly that size, its leader queues it
+                if (DuelsConf().on && MODE_SIZE[mode] > 1)
+                {
+                    Group* g = p->GetGroup();
+                    if (!g || size_t(g->GetMembersCount()) != MODE_SIZE[mode])
+                        return Say(p, std::string("err,partysize,") + std::to_string(MODE_SIZE[mode]));
+                }
+                if (Group* g = (DuelsConf().on && MODE_SIZE[mode] == 1) ? nullptr : p->GetGroup())
                 {
                     if (g->GetLeaderGuid() != p->GetObjectGuid())
                         return Say(p, "err,leader");
