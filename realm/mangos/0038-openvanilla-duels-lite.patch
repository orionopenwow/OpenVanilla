-            b << "1," << st.tier << ',' << st.maxKills << ',' << st.bestRating << ',' << (first ? 1 : 0) << ',' << (Arena::DuelsOn() ? 1 : 0);
+            b << "1," << st.tier << ',' << st.maxKills << ',' << st.bestRating << ',' << (first ? 1 : 0) << ',' << (Arena::DuelsOn() ? 1 : 0)
+              << ',' << (Arena::DuelsLite() ? 1 : 0);      // patch 0038: the bare arena
