+namespace Warfront
+{
+    // patch 0039 (Duels): a duel body made ready on every arrival in the hangout, by the realm itself:
+    // the class's spells and weapon skills, every gear set of the class in the bags, and the first set
+    // worn when the body is (nearly) bare. Nothing happens to someone already dressed.
+    void OutfitDuelist(Player* p)
+    {
+        if (!p || !Enabled() || !Arena::DuelsOn())
+            return;
+        EnsureData();
+        OwPlay::AutoLearn::Run(p, false);
+        uint32 given = 0, full = 0;
+        GiveAllKits(p, given, full);
+        uint32 worn = 0;
+        for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+            if (p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                ++worn;
+        std::string key;
+        uint32 on = 0;
+        if (worn < 8)
+        {
+            bool own = HasOwnFactionKit(p);
+            for (auto const& kv : g_kits)
+                if (kv.second.playerClass == p->getClass() && (!own || kv.second.alliance == (p->GetTeam() == ALLIANCE)))
+                {
+                    key = kv.first;
+                    break;
+                }
+            if (!key.empty())
+            {
+                Kit const& kit = g_kits[key];
+                for (auto const& si : kit.items)
+                {
+                    char const* err = nullptr;
+                    if (uint32 item = Substitute(p, si.second, si.first))
+                        if (Wear(p, si.first, item, 3, err))
+                            ++on;
+                }
+                for (auto const& se : kit.enchants)
+                {
+                    char const* err = nullptr;
+                    Enchant(p, se.first, se.second, err);
+                }
+            }
+        }
+        if (given || on)
+        {
+            sLog.outString("Open Vanilla Duels: %s outfitted: %u gear set pieces into the bags (%u didn't fit), %u worn from %s",
+                           p->GetName(), given, full, on, key.empty() ? "nothing" : key.c_str());
+            Reply(p, "WK", "bags," + std::to_string(given) + "," + std::to_string(full));
+            if (on)
+                Reply(p, "WK", "ok," + key + "," + std::to_string(on) + ",0");
+        }
+    }
+}
