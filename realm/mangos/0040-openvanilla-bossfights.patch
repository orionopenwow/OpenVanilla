+    {
+        // ── the raids ──
+
+        struct Raid
+        {
+            char const* key;
+            char const* name;
+            uint32 map;                 // the raid's own map
+            float in[4];                // where a run starts inside (the entrance's teleport target)
+        };
+
+        // Where a run starts inside each raid: areatrigger_teleport's targets (the raid's own entrance).
+        Raid const RAIDS[] =
+        {
+            { "onyxia", "Onyxia's Lair",       249, {   30.89f,   -54.08f,  -5.03f, 4.71f } },
+            { "mc",     "Molten Core",         409, { 1091.89f,  -466.98f, -105.08f, 3.14f } },
+            { "bwl",    "Blackwing Lair",      469, {-7672.32f, -1107.05f, 396.65f, 0.79f } },
+            { "zg",     "Zul'Gurub",           309, {-11916.60f, -1243.52f, 92.53f, 4.71f } },
+            { "aq20",   "Ruins of Ahn'Qiraj",  509, {-8436.53f,  1519.17f,  31.91f, 2.62f } },
+            { "aq40",   "Temple of Ahn'Qiraj", 531, {-8221.35f,  2014.34f, 129.07f, 0.87f } },
+            { "naxx",   "Naxxramas",           533, { 3498.28f, -5349.90f, 144.97f, 1.31f } },
+        };
+
+        // The one lobby for every raid: Gurubashi Arena in Stranglethorn (the open world's arena on map 0, its
+        // pit, stands and ramps; not Duels' map-900 match copies). Arrival: .tele GurubashiArena. Fence: a
+        // circle round the pit's centre that holds the stands.
+        // Without a Duels hangout on this server (and no .Lobby of its own): Gurubashi Arena's pit and stands.
+        char const* const LOBBY_ARRIVE = "0 -13217.9 276.76 22.4 0";
+        char const* const LOBBY_FENCE = "-13202.9 276.76 70";
+
+        Raid const* RaidByKey(std::string const& k)
+        {
+            for (Raid const& r : RAIDS)
+                if (k == r.key)
+                    return &r;
+            return nullptr;
+        }
+
+        Raid const* RaidByMap(uint32 map)
+        {
+            for (Raid const& r : RAIDS)
+                if (r.map == map)
+                    return &r;
+            return nullptr;
+        }
+
+        struct Lobby { uint32 map = 0; float x = 0, y = 0, z = 0, o = 0; float fx = 0, fy = 0, r = 0; };
+
+        // Player factions (Human, Orc): everyone in a perimeter or a run plays as the first, so mixed-faction
+        // raids are friendly to each other; their own faction is back when they leave.
+        uint32 const SHARED_FACTION = 1;
+
+        // ── settings ──
+
+        struct Settings
+        {
+            bool on = false;
+            bool only = false;
+            std::vector<std::string> raids;
+            Lobby lobby;
+            uint32 raidSize = 10;
+            RoleRule roles;
+            uint32 maxTier = 5;
+            std::vector<Scale> tiers;
+            std::vector<uint32> affixes;
+            float sizeExpHealth = 1.0f, sizeExpDamage = 0.75f;
+            std::vector<uint32> worldBuffs;
+            std::vector<std::pair<uint32, uint32>> consumables;
+            std::map<std::string, std::vector<std::pair<uint32, uint32>>> raidConsumables;
+            float bonusPerTier = 2.0f, bonusCap = 10.0f;
+            uint32 portMs = 60 * IN_MILLISECONDS;
+            uint32 runMs = 120 * MINUTE * IN_MILLISECONDS;
+            uint32 leaverSec = 10 * MINUTE;
+        };
+
+        std::vector<std::pair<uint32, uint32>> ItemList(std::string const& text)
+        {
+            std::vector<std::pair<uint32, uint32>> out;
+            std::istringstream in(text);
+            std::string one;
+            while (in >> one)
+            {
+                size_t c = one.find(':');
+                uint32 item = uint32(std::strtoul(one.substr(0, c).c_str(), nullptr, 10));
+                uint32 count = c == std::string::npos ? 1 : uint32(std::strtoul(one.substr(c + 1).c_str(), nullptr, 10));
+                if (item && count)
+                    out.emplace_back(item, std::min<uint32>(count, 20));
+            }
+            return out;
+        }
+
+        // "<map> <x> <y> <z> <o>" (arrival) and "<x> <y> <radius>" (the fence round it); false if malformed.
+        bool ParseLobby(std::string const& arrive, std::string const& fence, Lobby& l)
+        {
+            std::istringstream a(arrive), f(fence);
+            if (!(a >> l.map >> l.x >> l.y >> l.z >> l.o) || !(f >> l.fx >> l.fy >> l.r))
+                return false;
+            l.r = std::max(10.0f, std::min(300.0f, l.r));
+            return true;
+        }
+
+        Settings const& Conf()
+        {
+            static Settings const s = []
+            {
+                Settings c;
+                ::Config& conf = MaNGOS::Singleton<::Config>::Instance();
+                c.on = conf.GetBoolDefault("OpenVanilla.BossFights", false);
+                c.only = conf.GetBoolDefault("OpenVanilla.BossFights.Only", false);
+                std::istringstream rs(conf.GetStringDefault("OpenVanilla.BossFights.Raids", "onyxia mc"));
+                std::string k;
+                while (rs >> k)
+                    if (RaidByKey(k))
+                    {
+                        c.raids.push_back(k);
+                        c.raidConsumables[k] = ItemList(conf.GetStringDefault(("OpenVanilla.BossFights.Consumables." + k).c_str(),
+                                                                              k == "mc" ? "22754:1" : ""));
+                    }
+                // One hangout for both modes: Duels' (OpenVanilla.Duels.Hub, .Hub.Fence) unless Boss Fights is
+                // given its own; the built-in Gurubashi Arena when neither is set
+                std::string arrive = conf.GetStringDefault("OpenVanilla.BossFights.Lobby", "");
+                std::string fence = conf.GetStringDefault("OpenVanilla.BossFights.Lobby.Fence", "");
+                if (arrive.empty())
+                {
+                    arrive = conf.GetStringDefault("OpenVanilla.Duels.Hub", "");
+                    fence = conf.GetStringDefault("OpenVanilla.Duels.Hub.Fence", "");
+                    if (!arrive.empty() && fence.empty())
+                    {
+                        // a hangout with no fence (Duels then keeps nobody in): 70 yards round the arrival point
+                        std::istringstream a(arrive);
+                        float m = 0, x = 0, y = 0;
+                        if (a >> m >> x >> y)
+                            fence = std::to_string(x) + " " + std::to_string(y) + " 70";
+                    }
+                }
+                if (arrive.empty() || !ParseLobby(arrive, fence, c.lobby))
+                    ParseLobby(LOBBY_ARRIVE, LOBBY_FENCE, c.lobby);
+                c.raidSize = uint32(std::max(1, std::min(40, conf.GetIntDefault("OpenVanilla.BossFights.RaidSize", 10))));
+                c.roles.tanks = uint32(std::max(0, std::min(5, conf.GetIntDefault("OpenVanilla.BossFights.MinTanks", 2))));
+                c.roles.healers = uint32(std::max(0, std::min(10, conf.GetIntDefault("OpenVanilla.BossFights.MinHealers", 2))));
+                c.roles.relaxSec = uint32(std::max(0, std::min(3600, conf.GetIntDefault("OpenVanilla.BossFights.RelaxRolesSeconds", 120))));
+                c.maxTier = uint32(std::max(1, std::min(10, conf.GetIntDefault("OpenVanilla.BossFights.MaxTier", 5))));
+                c.tiers = ParseTiers(conf.GetStringDefault("OpenVanilla.BossFights.Tiers", "1:1;1.3:1.2;1.7:1.4;2.2:1.6;3:1.8"));
+                c.affixes = ParseAffixes(conf.GetStringDefault("OpenVanilla.BossFights.Affixes", "none;fortified;tyrannical;enrage;fortified,enrage"));
+                c.sizeExpHealth = std::max(0.0f, std::min(2.0f, conf.GetFloatDefault("OpenVanilla.BossFights.SizeExp.Health", 1.0f)));
+                c.sizeExpDamage = std::max(0.0f, std::min(2.0f, conf.GetFloatDefault("OpenVanilla.BossFights.SizeExp.Damage", 0.75f)));
+                std::istringstream wb(conf.GetStringDefault("OpenVanilla.BossFights.WorldBuffs", "22888 16609 15366 22817 22818 22820 24425"));
+                uint32 spell;
+                while (wb >> spell)
+                    if (sSpellTemplate.LookupEntry<SpellEntry>(spell))
+                        c.worldBuffs.push_back(spell);
+                // Major Healing and Major Mana Potions, the three flasks, Smoked Desert Dumplings, Heavy Runecloth Bandages
+                c.consumables = ItemList(conf.GetStringDefault("OpenVanilla.BossFights.Consumables",
+                                                               "13446:5 13444:5 13510:1 13511:1 13512:1 20452:5 14530:10"));
+                c.bonusPerTier = std::max(0.0f, std::min(10.0f, conf.GetFloatDefault("OpenVanilla.BossFights.StatBonusPerTier", 2.0f)));
+                c.bonusCap = std::max(0.0f, std::min(50.0f, conf.GetFloatDefault("OpenVanilla.BossFights.StatBonusCap", 10.0f)));
+                c.portMs = uint32(std::max(15, std::min(300, conf.GetIntDefault("OpenVanilla.BossFights.PortSeconds", 60)))) * IN_MILLISECONDS;
+                c.runMs = uint32(std::max(10, std::min(600, conf.GetIntDefault("OpenVanilla.BossFights.RunMinutes", 120)))) * MINUTE * IN_MILLISECONDS;
+                c.leaverSec = uint32(std::max(0, std::min(120, conf.GetIntDefault("OpenVanilla.BossFights.LeaverMinutes", 10)))) * MINUTE;
+                if (c.on)
+                    sLog.outString("Open Vanilla Boss Fights: %u raid(s), %u players a run, %u tiers%s", uint32(c.raids.size()), c.raidSize,
+                                   c.maxTier, c.only ? ", every character" : "");
+                return c;
+            }();
+            return s;
+        }
+
+        Scale TierScaleFor(uint32 tier)
+        {
+            Settings const& c = Conf();
+            return tier >= 1 && tier <= c.tiers.size() ? c.tiers[tier - 1] : (c.tiers.empty() ? Scale() : c.tiers.back());
+        }
+
+        uint32 AffixesFor(uint32 tier)
+        {
+            Settings const& c = Conf();
+            return tier >= 1 && tier <= c.affixes.size() ? c.affixes[tier - 1] : 0;
+        }
+
+        // The encounters of a raid (DungeonEncounter rows of difficulty 0): their count, and names by index.
+        struct Encounters { uint32 count = 0; std::map<uint32, std::string> names; };
+
+        Encounters const& EncountersOf(uint32 map)
+        {
+            static std::mutex lock;
+            static std::map<uint32, Encounters> cache;
+            std::lock_guard<std::mutex> guard(lock);
+            auto it = cache.find(map);
+            if (it != cache.end())
+                return it->second;
+            Encounters e;
+            for (auto itr = sDungeonEncounterStore.getDataBegin<DungeonEncounterEntry>(); itr < sDungeonEncounterStore.getDataEnd<DungeonEncounterEntry>(); ++itr)
+                if (itr->mapId == map && itr->Difficulty == 0 && itr->encounterIndex < 31)
+                    e.names[itr->encounterIndex] = itr->encounterName[0] ? itr->encounterName[0] : "";
+            e.count = e.names.empty() ? 0 : e.names.rbegin()->first + 1;
+            return cache[map] = e;
+        }
+
+        // ── state ──
+
+        struct QTicket
+        {
+            std::vector<uint32> members;    // guids, the leader first
+            std::string raid;               // a raid key, or "any"
+            uint32 tier = 1;
+            time_t since = 0;
+        };
+
+        struct Post                         // party search
+        {
+            uint32 id = 0;
+            uint32 leader = 0;
+            std::string leaderName, raid, note;
+            uint32 tier = 1, needT = 0, needH = 0, needD = 0;
+            time_t created = 0;
+        };
+
+        enum Phase { PORTING, LIVE, DONE };
+
+        struct Member
+        {
+            std::string name;
+            uint8 cls = 0;
+            Role role = ROLE_DPS;
+            bool bound = false, here = false, alive = true, left = false, out = false, unbound = false, buffed = false;
+            bool bot = false;               // a playerbot (testing, or filling a party): its runs rank apart
+            uint32 deaths = 0;
+            uint32 retMap = 0;              // where to put them back (their perimeter)
+        };
+
+        struct Run
+        {
+            uint32 id = 0;
+            std::string raid;
+            uint32 map = 0;
+            uint32 tier = 1, size = 0, affixes = 0;
+            uint32 instanceId = 0;
+            uint32 groupId = 0;
+            Phase phase = PORTING;
+            uint32 clock = 0;               // since the pop
+            uint32 pullAt = 0;              // clock at the first pull (0: not yet)
+            uint32 endedAt = 0;
+            uint32 mask = 0;
+            std::vector<std::pair<uint32, uint32>> splits;  // encounter index, ms since the pull
+            uint32 wipes = 0;
+            bool allDead = false;
+            bool cleared = false, stored = false;
+            time_t started = 0;
+            std::map<uint32, Member> members;
+            uint32 leader = 0;              // the raid group's leader (the oldest ticket's first member)
+            uint32 lastSec = 0;
+        };
+
+        struct PlayerState
+        {
+            bool loaded = false;
+            bool mode = false;
+            std::string lobby;
+            Role role = ROLE_DPS;
+            float bonusApplied = 0.0f;
+            uint32 factionSet = 0;          // the shared faction is on (perimeter or run)
+            uint32 fenceTick = 0;
+        };
+
+        std::mutex g_lock;
+        std::list<QTicket> g_queue;                             // a list: tickets keep their address
+        std::unordered_map<uint32, QTicket*> g_queued;           // guid -> its ticket (in g_queue)
+        std::map<uint32, Post> g_posts;
+        uint32 g_nextPost = 1;
+        std::map<uint32, std::shared_ptr<Run>> g_runs;
+        std::unordered_map<uint32, uint32> g_inRun;             // guid -> run id
+        std::unordered_map<uint32, std::vector<std::string>> g_notice;   // guid -> lines for its next update
+        std::unordered_map<uint32, PlayerState> g_players;
+        std::unordered_map<uint32, time_t> g_locked;            // guid -> queue locked until
+        std::vector<std::pair<uint32, uint32>> g_joins;         // party search: (joiner, leader), world thread
+        uint32 g_nextRun = 1;
+        uint32 g_tick = 0;
+        std::string g_live = "0,0,0";
+
+        // The per-instance scale table (damage and spawn hooks, any map thread).
+        struct InstanceScale
+        {
+            uint32 runId = 0;
+            Scale tier, size;
+            uint32 affixes = 0;
+            std::set<uint32> scaled;                            // creatures given their health already
+            std::unordered_map<uint32, std::pair<uint32, uint32>> fights;   // boss guid -> (fight start, last hit), ms
+        };
+        std::mutex g_scaleLock;
+        std::unordered_map<uint32, InstanceScale> g_scale;      // instance id -> scale
+        std::atomic<bool> g_anyScale(false);
+
+        void Notice(uint32 guid, std::string const& line)       // g_lock held
+        {
+            g_notice[guid].push_back(line);
+        }
+
+        void Reply(Player* p, std::string const& body, char const* chat = nullptr)
+        {
+            OwPlay::Send(p, "BF", body);
+            if (chat && *chat)
+                ChatHandler(p).PSendSysMessage("|cffff8000[Boss Fights]|r %s", chat);
+        }
+
+        std::string Err(char const* why) { return std::string("err,") + why; }
+
+        char const* ErrText(std::string const& why)
+        {
+            static std::map<std::string, char const*> const t =
+            {
+                { "off", "Boss Fights aren't on here." }, { "level", "Boss Fights are for level 60." },
+                { "dead", "Not while dead." }, { "combat", "Not in combat." }, { "busy", "Not now: you're in a run or a battle." },
+                { "raid", "That raid isn't offered here." }, { "tier", "That tier isn't open to you yet: clear the tier below it." },
+                { "queue", "You're not queued." }, { "party", "Your party is bigger than a run." },
+                { "leader", "Only the party's leader can do that." }, { "full", "That party is full." },
+                { "gone", "That post is gone." }, { "locked", "You left a run: you can queue again in a few minutes." },
+                { "self", "That's your own post." }, { "note", "Pick a raid, a tier and the roles you need." },
+                { "mode", "Queue for a raid (or \"go\") to join Boss Fights first." },
+            };
+            auto it = t.find(why);
+            return it == t.end() ? "That didn't work." : it->second;
+        }
+
+        void Fail(Player* p, char const* why) { Reply(p, Err(why), ErrText(why)); }
+
+        void GiveItem(Player* p, uint32 item, uint32 count)
+        {
+            uint32 have = p->GetItemCount(item, true);
+            if (have >= count)
+                return;
+            ItemPosCountVec dest;
+            if (p->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, item, count - have) == EQUIP_ERR_OK)
+                if (Item* it = p->StoreNewItem(dest, item, true))
+                    p->SendNewItem(it, count - have, true, false);
+        }
+
+        void SetShared(Player* p, bool on)
+        {
+            if (on)
+            {
+                p->setFaction(SHARED_FACTION);
+                if (Pet* pet = p->GetPet())
+                    pet->setFaction(SHARED_FACTION);
+            }
+            else
+            {
+                p->setFactionForRace(p->getRace());
+                if (Pet* pet = p->GetPet())
+                    pet->setFaction(p->GetFaction());
+            }
+        }
