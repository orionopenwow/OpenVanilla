+        uint32 BestCleared(uint32 account, std::string const& raid)
+        {
+            if (auto q = CharacterDatabase.PQuery("SELECT best_tier FROM bossfights_progress WHERE account = %u AND raid = '%s'", account, raid.c_str()))
+                return q->Fetch()[0].GetUInt32();
+            return 0;
