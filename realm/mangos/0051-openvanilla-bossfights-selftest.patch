+/*
+ * Open Vanilla — Boss Fights' self-test rules (GPLv2, as CMaNGOS): which accounts are test accounts, the queue
+ * command's words, the test state line. No game objects, so realm/bossfights/tests/test_selftest.cpp runs them
+ * without a server. Used by BossFights.cpp (realm/mangos/0051-openvanilla-bossfights-selftest.patch).
+ */
+
+#ifndef OPENVANILLA_BOSSFIGHTS_SELFTEST_H
+#define OPENVANILLA_BOSSFIGHTS_SELFTEST_H
+
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <cstdlib>
+#include <set>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace BossFights
+{
+    // OpenVanilla.BossFights.TestAccounts: words, any of "<account id>", "<NAME>", "<PREFIX>*" (case blind).
+    struct TestAccounts
+    {
+        std::set<uint32_t> ids;
+        std::set<std::string> names;
+        std::vector<std::string> prefixes;
+
+        static TestAccounts Parse(std::string const& text)
+        {
+            TestAccounts t;
+            std::istringstream in(text);
+            std::string one;
+            while (in >> one)
+            {
+                std::transform(one.begin(), one.end(), one.begin(), [](unsigned char c) { return char(std::toupper(c)); });
+                if (one.find_first_not_of("0123456789") == std::string::npos)
+                    t.ids.insert(uint32_t(std::strtoul(one.c_str(), nullptr, 10)));
+                else if (one.size() > 1 && one.back() == '*')
+                    t.prefixes.push_back(one.substr(0, one.size() - 1));
+                else if (one != "*")                    // a lone "*" would make every account a test account
+                    t.names.insert(one);
+            }
+            return t;
+        }
+
+        bool Matches(uint32_t id, std::string name) const
+        {
+            if (ids.count(id))
+                return true;
+            std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return char(std::toupper(c)); });
+            if (name.empty())
+                return false;
+            if (names.count(name))
+                return true;
+            for (std::string const& pre : prefixes)
+                if (!pre.empty() && name.compare(0, pre.size(), pre) == 0)
+                    return true;
+            return false;
+        }
+
+        bool Empty() const { return ids.empty() && names.empty() && prefixes.empty(); }
+    };
+
+    // "q <raid|any> [tier] [size=N]" after the "q": the raid, the tier (1 when not given) and a test raid size
+    // (0 when not given). False for a malformed word (a tier or size that is no number, or out of range).
+    inline bool ParseQueueWords(std::string const& rest, std::string& raid, uint32_t& tier, uint32_t& size)
+    {
+        std::istringstream in(rest);
+        std::string w;
+        raid.clear();
+        tier = 1;
+        size = 0;
+        bool haveTier = false;
+        while (in >> w)
+        {
+            if (w.compare(0, 5, "size=") == 0)
+            {
+                std::string n = w.substr(5);
+                if (n.empty() || n.find_first_not_of("0123456789") != std::string::npos || n.size() > 3)
+                    return false;
+                size = uint32_t(std::strtoul(n.c_str(), nullptr, 10));
+                if (size < 1 || size > 40)
+                    return false;
+            }
+            else if (raid.empty() && !std::isdigit((unsigned char)w[0]))
+                raid = w;
+            else if (!haveTier && w.find_first_not_of("0123456789") == std::string::npos && w.size() <= 2)
+            {
+                tier = uint32_t(std::strtoul(w.c_str(), nullptr, 10));
+                haveTier = true;
+            }
+            else
+                return false;
+        }
+        if (tier < 1)
+            tier = 1;
+        return true;
+    }
+
+    // The test state line: "state,k=v,k=v,..." (fixed key order; values have no commas or '=').
+    class StateLine
+    {
+    public:
+        StateLine& Add(char const* key, std::string value)
+        {
+            value.erase(std::remove_if(value.begin(), value.end(), [](char c) { return c == ',' || c == '=' || c == ';'; }), value.end());
+            m_kv.emplace_back(key, value.empty() ? std::string("-") : value);
+            return *this;
+        }
+        StateLine& Add(char const* key, uint64_t value) { return Add(key, std::to_string(value)); }
+        StateLine& Add(char const* key, bool value) { return Add(key, std::string(value ? "1" : "0")); }
+        std::string Str() const
+        {
+            std::string s = "state";
+            for (auto const& kv : m_kv)
+                s += "," + kv.first + "=" + kv.second;
+            return s;
+        }
+    private:
+        std::vector<std::pair<std::string, std::string>> m_kv;
+    };
+
+    // Read a key back from a state line (tests and tools): the value, or "" when the key is not there.
+    inline std::string StateValue(std::string const& line, std::string const& key)
+    {
+        std::istringstream in(line);
+        std::string f;
+        while (std::getline(in, f, ','))
+        {
+            size_t e = f.find('=');
+            if (e != std::string::npos && f.compare(0, e, key) == 0 && e == key.size())
+                return f.substr(e + 1);
+        }
+        return std::string();
+    }
+}
