+        void TestKill(Player* p)
+        {
+            uint32 map = 0, inst = 0;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                auto r = g_inRun.find(p->GetGUIDLow());
+                if (r != g_inRun.end())
+                {
+                    auto it = g_runs.find(r->second);
+                    if (it != g_runs.end() && it->second->phase != DONE)
+                    {
+                        map = it->second->map;
+                        inst = it->second->instanceId;
+                    }
+                }
+            }
+            if (!map || p->GetMapId() != map || p->GetInstanceId() != inst)
+                return Reply(p, "test,kill,err,notinside", "Test kill: not inside a run's raid.");
+            DungeonPersistentState* state = (DungeonPersistentState*)sMapPersistentStateMgr.GetPersistentState(map, inst);
+            if (!state)
+                return Reply(p, "test,kill,err,nosave", "Test kill: the run has no save.");
+            Map* m = p->GetMap();
+            uint32 mask = state->GetCompletedEncountersMask(), killed = 0, credited = 0;
+            DungeonEncounterMapBounds bounds = sObjectMgr.GetDungeonEncounterBoundsByMap(map);
+            for (auto e = bounds.first; e != bounds.second; ++e)
+            {
+                DungeonEncounter const& enc = e->second;
+                if (!enc.dbcEntry || enc.dbcEntry->Difficulty != 0 || enc.dbcEntry->encounterIndex >= 31)
+                    continue;
+                if (mask & (1u << enc.dbcEntry->encounterIndex))
+                    continue;
+                bool done = false;
+                if (enc.creditType == ENCOUNTER_CREDIT_KILL_CREATURE)
+                {
+                    std::vector<std::pair<uint32, CreatureData>> spawns;
+                    auto collect = [&](CreatureDataPair const& d)
+                    {
+                        if (d.second.id == enc.creditEntry && d.second.mapid == map)
+                            spawns.emplace_back(d.first, d.second);
+                        return false;
+                    };
+                    sObjectMgr.DoCreatureData(collect);
+                    for (auto const& sp : spawns)
+                    {
+                        m->ForceLoadGrid(sp.second.posX, sp.second.posY);
+                        Creature* c = m->GetCreature(sp.first);
+                        if (!c || !c->IsInWorld() || !c->IsAlive())
