+                        Unit::DealDamage(p, c, c->GetHealth(), nullptr, INSTAKILL, SPELL_SCHOOL_MASK_NORMAL, nullptr, false);
+                        done = true;
+                        ++killed;
+                    }
+                }
+                if (!done)
+                {
+                    state->UpdateEncounterState(enc.creditType, enc.creditEntry);
+                    ++credited;
+                }
+            }
+            std::string body = "test,kill," + std::to_string(killed) + "," + std::to_string(credited);
+            Reply(p, body, ("Test kill: " + std::to_string(killed) + " killed, " + std::to_string(credited) + " credited.").c_str());
+        }
+
+        // The run members standing in this player's copy of the raid (map thread: the same map).
+        std::vector<Player*> MembersHere(Player* p)
+        {
+            std::vector<Player*> out;
+            std::vector<uint32> guids;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                auto r = g_inRun.find(p->GetGUIDLow());
+                if (r == g_inRun.end())
+                    return out;
+                auto it = g_runs.find(r->second);
