+        // Out of a run, back in the hangout as fresh as on arrival: alive, full health and mana, no rage, out
+        // of combat, the run's world buffs gone, every cooldown ready. (The consumables stay in the bags.)
+        void Refresh(Player* p)
+        {
+            if (!p->IsAlive())
+            {
+                p->ResurrectPlayer(1.0f);
+                p->SpawnCorpseBones();
+            }
+            for (uint32 spell : Conf().worldBuffs)
+                p->RemoveAurasDueToSpell(spell);
+            p->CombatStop(true);
+            p->RemoveAllCooldowns();
+            p->SetHealth(p->GetMaxHealth());
+            if (p->GetPowerType() == POWER_MANA)
+                p->SetPower(POWER_MANA, p->GetMaxPower(POWER_MANA));
+            else if (p->GetPowerType() == POWER_RAGE)
+                p->SetPower(POWER_RAGE, 0);
+            else if (p->GetPowerType() == POWER_ENERGY)
+                p->SetPower(POWER_ENERGY, p->GetMaxPower(POWER_ENERGY));
+        }
