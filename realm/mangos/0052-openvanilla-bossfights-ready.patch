+            case MAGE: return { "Arcane Intellect", "Arcane Brilliance", "Mage Armor", "Ice Armor|Frost Armor", "Dampen Magic", "Amplify Magic",
+                                "Polymorph", "Conjure Mana Ruby|Conjure Mana Citrine", "Conjure Water", "Conjure Food", "Slow Fall", "Fire Ward" };
+            case WARLOCK: return { "Demon Armor|Demon Skin", "Summon Imp", "Summon Voidwalker", "Summon Succubus", "Summon Felhunter",
+                                   "Create Healthstone (Major)|Create Healthstone (Greater)|Create Healthstone", "Create Soulstone (Major)|Create Soulstone (Greater)|Create Soulstone",
+                                   "Ritual of Summoning", "Banish", "Shadow Ward", "Health Funnel", "Unending Breath" };
+            case DRUID: return { "Mark of the Wild", "Gift of the Wild", "Thorns", "Omen of Clarity", "Travel Form", "Entangling Roots",
+                                 "Hibernate", "Frenzied Regeneration", "Bash", "Dash", "Tiger's Fury", "Cower" };
+            default: return {};
+        }
+    }
+
+    // Where the bars' abilities go. free(button) tells an empty button; know(alternatives) gives the name the
+    // character knows ("" if none); onBar(name) is true when that spell is on a button already (it isn't placed
+    // twice). Every ability takes its own button when it's empty; the others then take the first empty
+    // buttons left on their bar, then on the bars after it. Returns (button, name) pairs.
+    template <class FreeFn, class KnowFn, class OnBarFn>
+    std::vector<std::pair<uint32_t, std::string>> PlanBars(std::vector<std::string> const& spec, std::vector<std::string> const& cls,
+                                                           FreeFn free, KnowFn know, OnBarFn onBar)
+    {
+        static uint32_t const BARS[5] = { 0, 60, 48, 24, 36 };
+        std::vector<std::pair<uint32_t, std::string>> out;
+        std::set<uint32_t> taken;
+        std::set<std::string> placed;
+        auto isFree = [&](uint32_t b) { return !taken.count(b) && free(b); };
+        auto place = [&](std::vector<std::string> const& list, uint32_t firstBar)
+        {
+            // first every ability that can have its own button, then the rest in the gaps left
+            std::vector<std::pair<size_t, std::string>> later;
+            for (size_t i = 0; i < list.size() && i < 12; ++i)
+            {
+                std::string name = know(list[i]);
+                if (name.empty() || placed.count(name) || onBar(name))
+                    continue;
+                uint32_t own = BARS[firstBar] + uint32_t(i);
+                if (isFree(own))
+                {
+                    taken.insert(own);
+                    placed.insert(name);
+                    out.emplace_back(own, name);
+                }
+                else
+                    later.emplace_back(i, name);
+            }
+            for (auto const& l : later)
+            {
+                if (placed.count(l.second))
+                    continue;
+                uint32_t at = 1000;
+                for (uint32_t bar = firstBar; at == 1000 && bar < 5; ++bar)
+                    for (uint32_t k = 0; k < 12 && at == 1000; ++k)
+                        if (isFree(BARS[bar] + k))
+                            at = BARS[bar] + k;
+                if (at == 1000)
+                    return;
+                taken.insert(at);
+                placed.insert(l.second);
+                out.emplace_back(at, l.second);
+            }
+        };
+        place(spec, 0);
+        place(cls, 1);
+        return out;
+    }
+
+    // ── consumables ──
+
+    // "<item>:<count> ..." (count capped at `cap`)
+    inline std::vector<std::pair<uint32_t, uint32_t>> ItemCounts(std::string const& text, uint32_t cap)
+    {
+        std::vector<std::pair<uint32_t, uint32_t>> out;
+        std::istringstream in(text);
+        std::string one;
+        while (in >> one)
+        {
+            size_t c = one.find(':');
+            uint32_t item = uint32_t(std::strtoul(one.substr(0, c).c_str(), nullptr, 10));
+            uint32_t count = c == std::string::npos ? 1 : uint32_t(std::strtoul(one.substr(c + 1).c_str(), nullptr, 10));
+            if (item && count)
+                out.emplace_back(item, count < cap ? count : cap);
+        }
+        return out;
+    }
+
+    // Defaults (each a setting, see BossFightsReady.cpp). Every item here sells for nothing on the realm
+    // (bossfights_world.sql). Everyone: Major Healing and Mana Potions, the three flasks, Elixirs of the
+    // Mongoose, Giants and Greater Arcane, Smoked Desert Dumplings, Alterac Swiss, Heavy Runecloth Bandages.
+    inline char const* DefaultConsumables() { return "13446:10 13444:10 13510:1 13511:1 13512:1 13452:5 9206:5 13454:5 20452:10 8932:20 14530:20"; }
+    inline char const* DefaultManaConsumables() { return "8766:20"; }      // Morning Glory Dew (mana users)
+    inline char const* DefaultClassConsumables(uint8_t cls)
+    {
+        switch (cls)
+        {
+            case ROGUE: return "8928:20 20844:20 5140:20";          // Instant Poison VI, Deadly Poison V, Flash Powder
+            case MAGE: return "17020:20";                           // Arcane Powder
+            case PRIEST: return "17029:20";                         // Sacred Candle
+            case PALADIN: return "21177:40 17033:5";                // Symbol of Kings, Symbol of Divinity
+            case DRUID: return "17026:20 17038:5";                  // Wild Thornroot, Ironwood Seed
+            case SHAMAN: return "17030:5";                          // Ankh
+            case WARLOCK: return "6265:6";                          // Soul Shard (one a slot)
+            default: return "";
+        }
+    }
+    inline bool UsesMana(uint8_t cls) { return cls != WARRIOR && cls != ROGUE; }
+
+    // A hunter's ammunition for the ranged weapon worn (item subclass: 2 bow, 3 gun, 18 crossbow): Thorium
+    // Headed Arrows or Thorium Shells. 0: none needed.
+    inline uint32_t AmmoFor(uint32_t rangedSubclass)
+    {
+        if (rangedSubclass == 2 || rangedSubclass == 18)
+            return 18042;
+        if (rangedSubclass == 3)
+            return 15997;
+        return 0;
+    }
+
+    // ── the ready line (".wnl wf bf ready", tag BF): "ready," then key=value pairs, comma separated ──
+    //   ready,level=<n>,spec=<name, spaces as _>,spent=<n>,free=<n>,sets=<whole>,setsof=<n>,worn=<kit|own|mixed|->,
+    //         slots=<free bag slots>,buttons=<n>,consumables=<had>,wanted=<n>,missing=<id:id or ->,ok=<0|1>
+    struct Info
+    {
+        uint32_t level = 0;
+        std::string spec;
+        uint32_t spent = 0, free = 0;
+        uint32_t setsInBags = 0, sets = 0;
+        std::string worn;               // a kit key, "own" (not a gear set) or "-" (nothing much worn)
+        uint32_t freeSlots = 0;
+        uint32_t buttons = 0;
+        uint32_t consHave = 0, consWant = 0;
+        std::vector<uint32_t> missing;
+    };
+
+    inline bool IsReady(Info const& i, uint32_t wantLevel)
+    {
+        return i.level >= wantLevel && i.spent > 0 && i.sets > 0 && i.setsInBags == i.sets && i.worn != "-" &&
+               i.buttons >= 12 && i.consWant > 0 && i.consHave == i.consWant;
+    }
+
+    // a value can't hold the separators (",", ";", "|", " "): spaces become "_"
+    inline std::string Clean(std::string s)
+    {
+        for (char& c : s)
+            if (c == ',' || c == ';' || c == '|' || c == '\n' || c == '=')
+                c = ' ';
+        for (char& c : s)
+            if (c == ' ' || c == '\t')
+                c = '_';
+        return s.empty() ? std::string("-") : s;
+    }
+
+    inline std::string Line(Info const& i, uint32_t wantLevel)
+    {
+        std::ostringstream o;
+        o << "ready,level=" << i.level << ",spec=" << Clean(i.spec) << ",spent=" << i.spent << ",free=" << i.free
+          << ",sets=" << i.setsInBags << ",setsof=" << i.sets << ",worn=" << Clean(i.worn) << ",slots=" << i.freeSlots
+          << ",buttons=" << i.buttons << ",consumables=" << i.consHave << ",wanted=" << i.consWant << ",missing=";
+        if (i.missing.empty())
+            o << '-';
+        for (size_t k = 0; k < i.missing.size() && k < 12; ++k)
+            o << (k ? ":" : "") << i.missing[k];
+        o << ",ok=" << (IsReady(i, wantLevel) ? 1 : 0);
+        return o.str();
+    }
+}
+
+#endif
