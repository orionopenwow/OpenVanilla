+            std::string Serialized(std::vector<std::pair<uint32, uint32>> list)
+            {
+                std::sort(list.begin(), list.end(), [](auto const& a, auto const& b)
+                {
+                    TalentEntry const* ta = sTalentStore.LookupEntry(a.first);
