index 0000000..b2a48dc
--- /dev/null
+++ b/src/game/OpenVanilla/BossFightsReady.cpp
@@ -0,0 +1,673 @@
+/*
+ * Open Vanilla — Boss Fights, the ready raider (GPLv2, as CMaNGOS). Patch 0052.
+ *
+ * A character in Boss Fights has nothing to set up: in the Gurubashi hangout, a moment after it arrives, the realm
+ * makes it ready.
+ *   level        OpenVanilla.BossFights.Ready.Level (60): a lower character is raised to it; the class's spells
+ *                (AutoLearn) and every weapon skill at its maximum (as a duelist gets).
+ *   bags         an empty bag slot gets OpenVanilla.BossFights.Ready.Bag (4500, Traveler's Backpack: sells for
+ *                nothing on Warfront realms).
+ *   talents      the spec of the talent tree its role plays (BossFightsReadyLogic.h TreeFor) made active with that
+ *                tree's raid build: DualSpec's templates take the raid builds for Boss Fights characters. Never
+ *                over a player's own choice: only when the talents are a template's (a new body) or what Boss
+ *                Fights set last time, untouched (bossfights_ready.spec, .talents).
+ *   gear         every gear set of the class in the bags (Warfront's kits); the role's set worn when the body is
+ *                bare or wears only gear-set pieces that Boss Fights put on (or, the first time, any gear sets).
+ *                Anything else worn is the player's own: left on.
+ *   consumables  topped up on arrival, after every run and each minute in the hangout:
+ *                OpenVanilla.BossFights.Ready.Consumables, .Consumables.Mana (mana users), .Consumables.<Class>
+ *                (reagents, poisons), and a hunter's arrows or shells (.Ready.Ammo, 1000) for the ranged weapon worn.
+ *   bars         the active spec's raid abilities on the main bar, the class's buffs, auras, forms and utility on
+ *                the bottom left bar, every other class spell on the bottom right and side bars, the main bar
+ *                copied to the stance and form bars; on empty buttons only. A body less than 10 minutes old whose
+ *                bars Boss Fights hasn't laid out yet is cleared first (only the realm's starter layout is on it).
+ *                The Boss Fights addon switches the four extra bars on (they're the client's own setting).
+ *   refresh      after every run, back in the hangout: health and mana full, cooldowns reset, the run's world
+ *                buffs gone, the bags topped up.
+ * OpenVanilla.BossFights.Ready (1), .Ready.Talents (1), .Ready.Gear (1), .Ready.Bars (1): each part on or off.
+ * Nothing here runs unless OpenVanilla.BossFights = 1. Playerbots are left alone (the bot factory gears them).
+ * The characters table bossfights_ready (realm/bossfights/bossfights_characters.sql) keeps Boss Fights' picks.
+ * ".wnl wf bf ready" reports the state: BossFightsReadyLogic.h Line().
+ */
+
+#include "OpenVanilla/BossFights.h"
+#include "OpenVanilla/BossFightsReadyLogic.h"
+#include "OpenVanilla/Play.h"
+#include "OpenVanilla/PlayState.h"
+#include "OpenVanilla/Warfront.h"
+#include "OpenVanilla/WarfrontArena.h"
+
+#include "Chat/Chat.h"
+#include "Config/Config.h"
+#include "Database/DatabaseEnv.h"
+#include "Entities/Bag.h"
+#include "Entities/Item.h"
+#include "Entities/Pet.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "Log/Log.h"
+#include "Server/DBCStores.h"
+#include "Server/SQLStorages.h"
+#include "Server/WorldSession.h"
+#include "Spells/SpellMgr.h"
+#ifdef ENABLE_PLAYERBOTS
+#include "playerbot/playerbot.h"
+#endif
+
+#include <algorithm>
+#include <ctime>
+#include <map>
+#include <mutex>
+#include <set>
+#include <unordered_map>
+
+namespace BossFights
+{
+    namespace
+    {
+        using namespace BossFightsReady;
+        typedef std::vector<std::pair<uint32, uint32>> Items;
+
+        struct ReadyConf
+        {
+            bool on = false;
+            uint32 level = 60;
+            uint32 bag = 4500;
+            bool talents = true, gear = true, bars = true;
+            Items consumables, mana;
+            std::map<uint8, Items> perClass;
+            uint32 ammo = 1000;
+            std::vector<uint32> worldBuffs;
+        };
+
+        ReadyConf const& RConf()
+        {
+            static ReadyConf const s = []
+            {
+                ReadyConf c;
+                ::Config& conf = MaNGOS::Singleton<::Config>::Instance();
+                c.on = Enabled() && conf.GetBoolDefault("OpenVanilla.BossFights.Ready", true);
+                c.level = uint32(std::max(0, std::min(60, conf.GetIntDefault("OpenVanilla.BossFights.Ready.Level", 60))));
+                c.bag = uint32(std::max(0, conf.GetIntDefault("OpenVanilla.BossFights.Ready.Bag", 4500)));
+                c.talents = conf.GetBoolDefault("OpenVanilla.BossFights.Ready.Talents", true);
+                c.gear = conf.GetBoolDefault("OpenVanilla.BossFights.Ready.Gear", true);
+                c.bars = conf.GetBoolDefault("OpenVanilla.BossFights.Ready.Bars", true);
+                c.ammo = uint32(std::max(0, std::min(2000, conf.GetIntDefault("OpenVanilla.BossFights.Ready.Ammo", 1000))));
+                c.consumables = ItemCounts(conf.GetStringDefault("OpenVanilla.BossFights.Ready.Consumables", DefaultConsumables()), 200);
+                c.mana = ItemCounts(conf.GetStringDefault("OpenVanilla.BossFights.Ready.Consumables.Mana", DefaultManaConsumables()), 200);
+                static std::pair<uint8, char const*> const NAMES[] = { { WARRIOR, "Warrior" }, { PALADIN, "Paladin" }, { HUNTER, "Hunter" },
+                    { ROGUE, "Rogue" }, { PRIEST, "Priest" }, { SHAMAN, "Shaman" }, { MAGE, "Mage" }, { WARLOCK, "Warlock" }, { DRUID, "Druid" } };
+                for (auto const& n : NAMES)
+                    c.perClass[n.first] = ItemCounts(conf.GetStringDefault((std::string("OpenVanilla.BossFights.Ready.Consumables.") + n.second).c_str(),
+                                                                           DefaultClassConsumables(n.first)), 200);
+                // every item must exist, or it would be asked for forever
+                auto known = [](Items& list)
+                {
+                    list.erase(std::remove_if(list.begin(), list.end(), [](std::pair<uint32, uint32> const& it)
+                    {
+                        return !sObjectMgr.GetItemPrototype(it.first);
+                    }), list.end());
+                };
+                known(c.consumables);
+                known(c.mana);
+                for (auto& pc : c.perClass)
+                    known(pc.second);
+                if (c.bag && !sObjectMgr.GetItemPrototype(c.bag))
+                    c.bag = 0;
+                std::istringstream wb(conf.GetStringDefault("OpenVanilla.BossFights.WorldBuffs", "22888 16609 15366 22817 22818 22820 24425"));
+                uint32 spell;
+                while (wb >> spell)
+                    c.worldBuffs.push_back(spell);
+                if (c.on)
+                    sLog.outString("Open Vanilla Boss Fights: raiders made ready in the hangout (level %u, %u consumables)", c.level,
+                                   uint32(c.consumables.size()));
+                return c;
+            }();
+            return s;
+        }
+
+        bool g_tableChecked = false, g_tableOk = false;
+        std::mutex g_tableLock;
+
+        bool TableOk()
+        {
+            std::lock_guard<std::mutex> guard(g_tableLock);
+            if (!g_tableChecked)
+            {
+                g_tableChecked = true;
+                if (auto r = CharacterDatabase.Query("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = 'bossfights_ready'"))
+                    g_tableOk = r->Fetch()[0].GetUInt32() != 0;
+                if (!g_tableOk)
+                    sLog.outError("Open Vanilla Boss Fights: characters table bossfights_ready missing (run bossfights_characters.sql): raid talents and gear are picked again each login");
+            }
+            return g_tableOk;
+        }
+
+        // Per character, this session (the player's own map thread reads and writes its entry).
+        struct RState
+        {
+            bool rowLoaded = false;
+            uint32 waitMs = 0;              // in the hangout, alive, out of combat: since when (ms)
+            bool done = false;              // made ready this session
+            bool wasRun = false;            // back from a run: refresh
+            bool roleDirty = false;
+            time_t lastTop = 0;
+            uint32 setSpec = 0;             // bossfights_ready: Boss Fights' talent pick
+            std::string setTalents;
+            std::string kit;                // the gear set Boss Fights put on
+            uint32 bars = 0;                // Boss Fights laid out the bars once
+            bool readied = false;           // the row exists (logged once per character)
+        };
+
+        std::mutex g_lock;
+        std::unordered_map<uint32, RState> g_state;
+
+        bool IsBot(Player* p)
+        {
+#ifdef ENABLE_PLAYERBOTS
+            return p && p->GetPlayerbotAI() && !p->isRealPlayer();
+#else
+            (void)p;
+            return false;
+#endif
+        }
+
+        void LoadRow(Player* p, RState& s)
+        {
+            s.rowLoaded = true;
+            if (!TableOk())
+                return;
+            if (auto r = CharacterDatabase.PQuery("SELECT spec, talents, kit, bars FROM bossfights_ready WHERE guid = %u", p->GetGUIDLow()))
+            {
+                Field* f = r->Fetch();
+                s.setSpec = f[0].GetUInt32();
+                s.setTalents = f[1].GetCppString();
+                s.kit = f[2].GetCppString();
+                s.bars = f[3].GetUInt32();
+                s.readied = true;
+            }
+        }
+
+        void SaveRow(Player* p, RState& s)
+        {
+            if (!TableOk())
+                return;
+            std::string talents = s.setTalents, kit = s.kit;
+            CharacterDatabase.escape_string(talents);
+            CharacterDatabase.escape_string(kit);
+            CharacterDatabase.PExecute("INSERT INTO bossfights_ready (guid, spec, talents, kit, bars, readied) VALUES (%u, %u, '%s', '%s', %u, UNIX_TIMESTAMP()) "
+                                       "ON DUPLICATE KEY UPDATE spec = VALUES(spec), talents = VALUES(talents), kit = VALUES(kit), bars = VALUES(bars)",
+                                       p->GetGUIDLow(), s.setSpec, talents.c_str(), kit.c_str(), s.bars);
+        }
+
+        // ── bags ──
+
+        void FillBagSlots(Player* p)
+        {
+            uint32 bag = RConf().bag;
+            if (!bag)
+                return;
+            for (uint8 slot = INVENTORY_SLOT_BAG_START; slot < INVENTORY_SLOT_BAG_END; ++slot)
+                if (!p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+                {
+                    uint16 dest = 0;
+                    if (p->CanEquipNewItem(slot, dest, bag, false) == EQUIP_ERR_OK)
+                        p->EquipNewItem(dest, bag, true);
+                }
+        }
+
+        uint32 FreeBagSlots(Player* p)
+        {
+            uint32 n = 0;
+            for (uint8 i = INVENTORY_SLOT_ITEM_START; i < INVENTORY_SLOT_ITEM_END; ++i)
+                if (!p->GetItemByPos(INVENTORY_SLOT_BAG_0, i))
+                    ++n;
+            for (uint8 b = INVENTORY_SLOT_BAG_START; b < INVENTORY_SLOT_BAG_END; ++b)
+                if (Bag* bag = (Bag*)p->GetItemByPos(INVENTORY_SLOT_BAG_0, b))
+                    for (uint32 j = 0; j < bag->GetBagSize(); ++j)
+                        if (!bag->GetItemByPos(uint8(j)))
+                            ++n;
+            return n;
+        }
+
+        // ── consumables ──
+
+        // What this character keeps in its bags: (item, count)
+        Items Wanted(Player* p)
+        {
+            ReadyConf const& c = RConf();
+            Items out = c.consumables;
+            if (UsesMana(p->getClass()))
+                out.insert(out.end(), c.mana.begin(), c.mana.end());
+            auto pc = c.perClass.find(p->getClass());
+            if (pc != c.perClass.end())
+                out.insert(out.end(), pc->second.begin(), pc->second.end());
+            if (p->getClass() == CLASS_HUNTER && c.ammo)
+                if (Item* r = p->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_RANGED))
+                    if (uint32 ammo = AmmoFor(r->GetProto()->SubClass))
+                        if (sObjectMgr.GetItemPrototype(ammo))
+                            out.emplace_back(ammo, c.ammo);
+            return out;
+        }
+
+        void TopUp(Player* p)
+        {
+            for (auto const& it : Wanted(p))
+            {
+                uint32 have = p->GetItemCount(it.first);
+                if (have < it.second)
+                    p->StoreNewItemInBestSlots(it.first, it.second - have);
+            }
+            if (p->getClass() == CLASS_HUNTER)
+                if (Item* r = p->GetItemByPos(INVENTORY_SLOT_BAG_0, EQUIPMENT_SLOT_RANGED))
+                    if (uint32 ammo = AmmoFor(r->GetProto()->SubClass))
+                        if (p->GetUInt32Value(PLAYER_AMMO_ID) != ammo && p->GetItemCount(ammo))
+                            p->SetAmmo(ammo);
+        }
+
+        // ── action bars ──
+
+        bool ButtonFree(Player* p, uint8 button)
+        {
+            ActionButtonList const& list = p->GetActionButtons();
+            auto it = list.find(button);
+            return it == list.end() || it->second.uState == ACTIONBUTTON_DELETED;
+        }
+
+        uint32 ButtonsSet(Player* p)
+        {
+            uint32 n = 0;
+            for (auto const& kv : p->GetActionButtons())
+                if (kv.second.uState != ACTIONBUTTON_DELETED)
+                    ++n;
+            return n;
+        }
+
+        bool ClassSkill(uint32 id)
+        {
+            SkillLineAbilityMapBounds b = sSpellMgr.GetSkillLineAbilityMapBoundsBySpellId(id);
+            for (auto it = b.first; it != b.second; ++it)
+                if (SkillLineEntry const* sl = sSkillLineStore.LookupEntry(it->second->skillId))
+                    if (sl->categoryId == SKILL_CATEGORY_CLASS)
+                        return true;
+            return false;
+        }
+
+        struct Book
+        {
+            std::map<std::string, uint32> byName;           // the highest rank known, by name
+            std::vector<std::pair<uint32, uint32>> classSpells;     // (spell level, id): the class's actives
+        };
+
+        Book SpellBook(Player* p)
+        {
+            Book b;
+            std::map<std::string, uint32> level;
+            for (auto const& kv : p->GetSpellMap())
+            {
+                PlayerSpell const& ps = kv.second;
+                if (ps.state == PLAYERSPELL_REMOVED || !ps.active || ps.disabled)
+                    continue;
+                SpellEntry const* e = sSpellTemplate.LookupEntry<SpellEntry>(kv.first);
+                if (!e || IsPassiveSpell(e) || !e->SpellName[0] || !*e->SpellName[0])
+                    continue;
+                uint32 next = sSpellMgr.GetNextSpellInChain(kv.first);
+                if (next && p->HasSpell(next))
+                    continue;                           // a lower rank: the highest goes on the bar
+                std::string name = e->SpellName[0];
+                auto have = level.find(name);
+                if (have == level.end() || e->spellLevel > have->second)
+                {
+                    b.byName[name] = kv.first;
+                    level[name] = e->spellLevel;
+                }
+                if (ClassSkill(kv.first))
+                    b.classSpells.emplace_back(e->spellLevel, kv.first);
+            }
+            std::sort(b.classSpells.begin(), b.classSpells.end());
+            return b;
+        }
+
+        std::set<uint32> SpellsOnBars(Player* p)
+        {
+            std::set<uint32> on;
+            for (auto const& kv : p->GetActionButtons())
+                if (kv.second.uState != ACTIONBUTTON_DELETED && kv.second.GetType() == ACTION_BUTTON_SPELL)
+                    on.insert(kv.second.GetAction());
+            return on;
+        }
+
+        // Returns how many buttons it filled.
+        uint32 LayOutBars(Player* p, uint32 tree, bool clearFirst)
+        {
+            if (clearFirst)
+            {
+                std::vector<uint8> old;
+                for (auto const& kv : p->GetActionButtons())
+                    if (kv.second.uState != ACTIONBUTTON_DELETED)
+                        old.push_back(kv.first);
+                for (uint8 b : old)
+                    p->removeActionButton(b);
+            }
+            Book book = SpellBook(p);
+            std::set<uint32> on = SpellsOnBars(p);
+            uint8 cls = p->getClass();
+            auto know = [&](std::string const& alts) -> std::string
+            {
+                size_t start = 0;
+                while (start <= alts.size())
+                {
+                    size_t bar = alts.find('|', start);
+                    std::string one = alts.substr(start, bar == std::string::npos ? std::string::npos : bar - start);
+                    if (book.byName.count(one))
+                        return one;
+                    if (bar == std::string::npos)
+                        break;
+                    start = bar + 1;
+                }
+                return std::string();
+            };
+            auto free = [&](uint32 b) { return ButtonFree(p, uint8(b)); };
+            auto onBar = [&](std::string const& name) { return on.count(book.byName[name]) != 0; };
+            uint32 placed = 0;
+            for (auto const& pl : PlanBars(SpecBar(cls, tree), ClassBar(cls), free, know, onBar))
+                if (p->addActionButton(uint8(pl.first), book.byName[pl.second], ACTION_BUTTON_SPELL))
+                {
+                    on.insert(book.byName[pl.second]);
+                    ++placed;
+                }
+            // every other class spell: bottom right, right, right 2
+            static uint8 const ranges[][2] = { { 48, 59 }, { 24, 35 }, { 36, 47 } };
+            size_t next = 0;
+            for (auto const& r : ranges)
+                for (int b = r[0]; b <= r[1]; ++b)
+                {
+                    while (next < book.classSpells.size() && on.count(book.classSpells[next].second))
+                        ++next;
+                    if (next >= book.classSpells.size())
+                        break;
+                    if (ButtonFree(p, uint8(b)) && p->addActionButton(uint8(b), book.classSpells[next].second, ACTION_BUTTON_SPELL))
+                    {
+                        on.insert(book.classSpells[next].second);
+                        ++placed;
+                    }
+                }
+            // the main bar on the stance, form and stealth bars (72-83, 84-95, 96-107)
+            if (cls == CLASS_WARRIOR || cls == CLASS_DRUID || cls == CLASS_ROGUE)
+            {
+                ActionButtonList const list = p->GetActionButtons();
+                for (uint8 bar = 72; bar < 108; bar += 12)
+                    for (uint8 i = 0; i < 12; ++i)
+                    {
+                        auto it = list.find(i);
+                        if (it == list.end() || it->second.uState == ACTIONBUTTON_DELETED || !ButtonFree(p, uint8(bar + i)))
+                            continue;
+                        if (p->addActionButton(uint8(bar + i), it->second.GetAction(), it->second.GetType()))
+                            ++placed;
+                    }
+            }
+            return placed;
+        }
+
+        uint32 ActiveTree(Player* p, uint8 role)
+        {
+            if (auto st = OwPlay::StateOf(p))
+                if (st->activeSpec >= 1 && st->activeSpec <= 3)
+                    return uint32(st->activeSpec - 1);
+            return TreeFor(p->getClass(), role);
+        }
+
+        // ── the whole of it ──
+
+        void MakeReady(Player* p, uint8 role, RState& s, bool first)
+        {
+            ReadyConf const& c = RConf();
+            uint8 cls = p->getClass();
+            bool fresh = !s.readied;
+            // 1. level, spells, weapon skills
+            if (c.level && p->GetLevel() < c.level)
+            {
+                uint32 was = p->GetLevel();
+                p->GiveLevel(c.level);
+                p->SetUInt32Value(PLAYER_XP, 0);
+                sLog.outString("Open Vanilla Boss Fights: %s raised from level %u to %u", p->GetName(), was, c.level);
+            }
+            OwPlay::AutoLearn::Run(p, false);
+            Warfront::Arena::MaxSkills(p);
+            // 2. bags
+            FillBagSlots(p);
+            // 3. talents: the role's tree, its raid build (unless the player chose)
+            if (c.talents)
+                OwPlay::Spec::ReadyRaider(p, TreeFor(cls, role), s.setSpec, s.setTalents);
+            // 4. gear: every set in the bags, the role's set worn
+            if (c.gear && Warfront::Enabled())
+            {
+                uint32 given = 0, full = 0;
+                Warfront::GiveGearSets(p, given, full);
+                std::string want = PickKit(Warfront::GearSetKeys(p), KitWords(cls, role));
+                std::string worn = Warfront::WornGearSet(p);
+                bool mayDress = worn == "-" || (worn != "own" && (s.kit.empty() || worn == s.kit || worn == "mixed"));
+                if (!want.empty() && worn != want && mayDress)
+                {
+                    if (Warfront::WearGearSet(p, want))
+                        s.kit = want;
+                    Warfront::GiveGearSets(p, given, full);     // pieces taken off outside Duels come back
+                }
+                else if (worn == want)
+                    s.kit = want;
+            }
+            // 5. consumables, reagents, ammunition
+            TopUp(p);
+            // 6. bars
+            if (c.bars)
+            {
+                bool clear = !s.bars && p->GetTotalPlayedTime() < 600;
+                uint32 placed = LayOutBars(p, ActiveTree(p, role), clear);
+                if (placed || clear)
+                    p->SendInitialActionButtons();
+                s.bars = 1;
+            }
+            SaveRow(p, s);
+            if (fresh)
+                sLog.outString("Open Vanilla Boss Fights: %s ready for raids (%s, %s, set %s)", p->GetName(),
+                               OwPlay::Spec::ActiveSpecName(p).c_str(), role == R_TANK ? "tank" : role == R_HEALER ? "healer" : "dps",
+                               s.kit.empty() ? "none" : s.kit.c_str());
+            s.readied = true;
+            (void)first;
+        }
+
+        // back from a run: whole again, the run's buffs gone
+        void Refresh(Player* p)
+        {
+            if (!p->IsAlive())
+            {
+                p->ResurrectPlayer(1.0f);
+                p->SpawnCorpseBones();
+            }
+            for (uint32 spell : RConf().worldBuffs)
+                p->RemoveAurasDueToSpell(spell);
+            p->SetHealth(p->GetMaxHealth());
+            if (p->GetPowerType() == POWER_MANA)
+                p->SetPower(POWER_MANA, p->GetMaxPower(POWER_MANA));
+            if (p->GetPowerType() == POWER_ENERGY)
+                p->SetPower(POWER_ENERGY, p->GetMaxPower(POWER_ENERGY));
+            if (p->GetPowerType() == POWER_RAGE)
+                p->SetPower(POWER_RAGE, 0);
+            p->RemoveSomeCooldown([](SpellEntry const&) { return true; });
+            if (Pet* pet = p->GetPet())
+                if (pet->IsAlive())
+                    pet->SetHealth(pet->GetMaxHealth());
+        }
+
+        Info Check(Player* p, uint32 have[2], std::vector<uint32>& missing);
+
+        // the "ready,..." line to the addon (and the chat line when asked)
+        void SendReport(Player* p, bool inMode, bool chat)
+        {
+            uint32 cons[2] = { 0, 0 };
+            std::vector<uint32> missing;
+            Info i = Check(p, cons, missing);
+            OwPlay::Send(p, "BF", Line(i, RConf().level));
+            if (chat)
+                ChatHandler(p).PSendSysMessage("|cffff8000[Boss Fights]|r %s: level %u, %s (%u talent points), %u of %u gear sets in the bags, wearing %s, "
+                                               "%u free bag slots, %u action buttons, %u of %u consumables.%s",
+                                               IsReady(i, RConf().level) ? "Ready" : "Not ready yet", i.level, i.spec.c_str(), i.spent, i.setsInBags, i.sets,
+                                               i.worn.c_str(), i.freeSlots, i.buttons, cons[0], cons[1], inMode ? "" : " (not in Boss Fights)");
+        }
+
+        Info Check(Player* p, uint32 have[2], std::vector<uint32>& missing)
+        {
+            Info i;
+            i.level = p->GetLevel();
+            i.spec = OwPlay::Spec::ActiveSpecName(p);
+            i.spent = OwPlay::Spec::SpentTalentPoints(p);
+            i.free = p->GetFreeTalentPoints();
+            i.sets = uint32(Warfront::GearSetKeys(p).size());
+            i.setsInBags = Warfront::GearSetsWhole(p);
+            i.worn = Warfront::WornGearSet(p);
+            i.freeSlots = FreeBagSlots(p);
+            i.buttons = ButtonsSet(p);
+            for (auto const& it : Wanted(p))
+            {
+                ++i.consWant;
+                if (p->GetItemCount(it.first) >= it.second)
+                    ++i.consHave;
+                else
+                    i.missing.push_back(it.first);
+            }
+            have[0] = i.consHave;
+            have[1] = i.consWant;
+            missing = i.missing;
+            return i;
+        }
+    }
+
+    bool ReadyOn() { return RConf().on; }
+
+    bool RaidBuilds(Player* p)
+    {
+        return p && ReadyOn() && RConf().talents && !IsBot(p) && Owns(p);
+    }
+
+    namespace Ready
+    {
+        void Tick(Player* p, bool inMode, bool inRun, bool atHub, uint8 role, uint32 diff)
+        {
+            if (!p || !ReadyOn() || !inMode || IsBot(p))
+                return;
+            uint32 guid = p->GetGUIDLow();
+            RState s;
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                s = g_state[guid];
+            }
+            bool save = false;
+            if (inRun)
+            {
+                if (!s.wasRun)
+                {
+                    s.wasRun = true;
+                    save = true;
+                }
+            }
+            else if (!atHub || !p->IsAlive() || p->IsInCombat() || p->IsBeingTeleported() || p->IsTaxiFlying())
+            {
+                if (s.waitMs)
+                {
+                    s.waitMs = 0;
+                    save = true;
+                }
+            }
+            else
+            {
+                s.waitMs += diff;
+                save = true;
+                if (s.waitMs >= 3000)                   // a moment after arriving (the client's bars and bags are up)
+                {
+                    time_t now = time(nullptr);
+                    if (!s.rowLoaded)
+                        LoadRow(p, s);
+                    if (!s.done || s.roleDirty)
+                    {
+                        MakeReady(p, role, s, !s.done);
+                        bool first = !s.done;
+                        s.done = true;
+                        s.roleDirty = false;
+                        s.wasRun = false;
+                        s.lastTop = now;
+                        SendReport(p, true, first);     // the window's "ready" (and, the first time, a chat line)
+                    }
+                    else if (s.wasRun)
+                    {
+                        s.wasRun = false;
+                        Refresh(p);
+                        MakeReady(p, role, s, false);
+                        s.lastTop = now;
+                        SendReport(p, true, false);
+                    }
+                    else if (now - s.lastTop >= 60)
+                    {
+                        s.lastTop = now;
+                        TopUp(p);
+                        if (RConf().gear && Warfront::Enabled())
+                        {
+                            uint32 given = 0, full = 0;
+                            Warfront::GiveGearSets(p, given, full);
+                        }
+                    }
+                }
+            }
+            if (save)
+            {
+                std::lock_guard<std::mutex> guard(g_lock);
+                g_state[guid] = s;
+            }
+        }
+
+        void RoleChanged(Player* p)
+        {
+            if (!p || !ReadyOn())
+                return;
+            std::lock_guard<std::mutex> guard(g_lock);
+            g_state[p->GetGUIDLow()].roleDirty = true;
+        }
+
+        void Report(Player* p, bool inMode, bool atHub, uint8 role)
+        {
+            if (!p)
+                return;
+            if (!ReadyOn())
+            {
+                OwPlay::Send(p, "BF", "err,off");
+                return;
+            }
+            // in the hangout, in Boss Fights: made ready (or refreshed) first, so the check is of the result
+            if (inMode && atHub && p->IsAlive() && !p->IsInCombat() && !IsBot(p))
+            {
+                RState s;
+                {
+                    std::lock_guard<std::mutex> guard(g_lock);
+                    s = g_state[p->GetGUIDLow()];
+                }
+                if (!s.rowLoaded)
+                    LoadRow(p, s);
+                if (s.wasRun)
+                    Refresh(p);
+                MakeReady(p, role, s, !s.done);
+                s.done = true;
+                s.roleDirty = false;
+                s.wasRun = false;
+                s.lastTop = time(nullptr);
+                std::lock_guard<std::mutex> guard(g_lock);
+                g_state[p->GetGUIDLow()] = s;
+            }
+            SendReport(p, inMode, true);
+        }
+
+        void Forget(uint32 guidLow)
+        {
+            std::lock_guard<std::mutex> guard(g_lock);
+            g_state.erase(guidLow);
+        }
+    }
+}
diff --git a/src/game/OpenVanilla/BossFightsReadyLogic.h b/src/game/OpenVanilla/BossFightsReadyLogic.h
new file mode 100644
index 0000000..5e4a629
--- /dev/null
+++ b/src/game/OpenVanilla/BossFightsReadyLogic.h
@@ -0,0 +1,391 @@
+/*
+ * Open Vanilla — Boss Fights, the ready raider: the pure rules (GPLv2, as CMaNGOS). No server types here, so
+ * realm/bossfights/tests/test_ready.cpp builds it on its own.
+ *
+ * A character in Boss Fights is made ready in the Gurubashi hangout with nothing to do: level 60, its talents
+ * spent by a raid build for the spec its role asks for, every gear set of the class in its bags and the role's
+ * set worn, raid consumables and reagents in the bags, and its raid abilities on the action bars. This file
+ * holds the choices (which tree, which gear set, which abilities where) and the "ready" line's format.
+ */
+
+#ifndef OPENVANILLA_BOSSFIGHTS_READY_LOGIC_H
+#define OPENVANILLA_BOSSFIGHTS_READY_LOGIC_H
+
+#include <cstdint>
+#include <cstdlib>
+#include <set>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace BossFightsReady
+{
+    // classes as the server numbers them; roles as BossFightsLogic.h (0 dps, 1 tank, 2 healer)
+    enum : uint8_t { WARRIOR = 1, PALADIN = 2, HUNTER = 3, ROGUE = 4, PRIEST = 5, SHAMAN = 7, MAGE = 8, WARLOCK = 9, DRUID = 11 };
+    enum : uint8_t { R_DPS = 0, R_TANK = 1, R_HEALER = 2 };
+
+    // The talent tree (0-2, the talent frame's order) a role plays, per class. A role the class can't fill
+    // (a healing rogue) plays its damage tree.
+    inline uint32_t TreeFor(uint8_t cls, uint8_t role)
+    {
+        switch (cls)
+        {
+            case WARRIOR: return role == R_TANK ? 2 : 1;                                // Protection, else Fury
+            case PALADIN: return role == R_HEALER ? 0 : role == R_TANK ? 1 : 2;         // Holy, Protection, Retribution
+            case HUNTER:  return 1;                                                     // Marksmanship
+            case ROGUE:   return 1;                                                     // Combat
+            case PRIEST:  return role == R_HEALER ? 1 : 2;                              // Holy, Shadow
+            case SHAMAN:  return role == R_HEALER ? 2 : 0;                              // Restoration, Elemental
+            case MAGE:    return 2;                                                     // Frost
+            case WARLOCK: return 2;                                                     // Destruction
+            case DRUID:   return role == R_HEALER ? 2 : 1;                              // Restoration, Feral (bear or cat)
+            default:      return 0;
+        }
+    }
+
+    // Raid (PvE) builds, one per talent tree: a talent link (one digit per talent in tree, row, column order;
+    // '-' ends a tree), 51 points. From the playerbots' PvE premade specs (aiplayerbot.conf.dist, PremadeSpecLink
+    // ".60"); where it has no PvE build of a tree, its PvP build of that tree (marked). An empty link: the tree
+    // is filled tier by tier (DualSpec.cpp).
+    struct RaidBuild { char const* name; char const* link; };
+    inline RaidBuild const* RaidBuilds(uint8_t cls)
+    {
+        static RaidBuild const WARRIOR_B[3] = { { "Arms", "303050213520105001-0505300502" },
+            { "Fury", "30305001302-05050005525010051" }, { "Protection", "05005001-05-55250110530101051" } };
+        static RaidBuild const PALADIN_B[3] = { { "Holy", "0550312152105-503251000131" },
+            { "Protection", "500501-053050335001051-05004" } /* PvP */, { "Retribution", "5550012--552300512003151" } };
+        static RaidBuild const HUNTER_B[3] = { { "Beast Mastery", "5000322050521231-054510005" },
+            { "Marksmanship", "2-05251030513051-33202004103" }, { "Survival", "-5105103051-330005241030315" } /* PvP */ };
+        static RaidBuild const ROGUE_B[3] = { { "Assassination", "00532310505105-320305002001-05" },
+            { "Combat", "005323105-3210052020050150231" }, { "Subtlety", "" } };
+        static RaidBuild const PRIEST_B[3] = { { "Discipline", "505230130505101-0250510313" },
+            { "Holy", "5012301305001-025051031300055" }, { "Shadow", "50520013--5032504103501051" } };
+        static RaidBuild const SHAMAN_B[3] = { { "Elemental", "550331050002151--05204301005" },
+            { "Enhancement", "0523015003-5025230104003151" } /* PvP */, { "Restoration", "-5-550350512553151" } };
+        static RaidBuild const MAGE_B[3] = { { "Arcane", "2300450310031531--053500030013" },
+            { "Fire", "230055000002-5052000123033151-003" }, { "Frost", "230045200003--05050033132301051" } };
+        static RaidBuild const WARLOCK_B[3] = { { "Affliction", "55002530122010051-2351050102" },
+            { "Demonology", "25002-205030015221-52500051020001" }, { "Destruction", "35000231122-001-5052005102005141" } /* PvP */ };
+        static RaidBuild const DRUID_B[3] = { { "Balance", "0143503002551351--5005021" } /* PvP */,
+            { "Feral", "014005001-5050301323222151-05" }, { "Restoration", "0143002002--505503105315051" } };
+        switch (cls)
+        {
+            case WARRIOR: return WARRIOR_B;
+            case PALADIN: return PALADIN_B;
+            case HUNTER: return HUNTER_B;
+            case ROGUE: return ROGUE_B;
+            case PRIEST: return PRIEST_B;
+            case SHAMAN: return SHAMAN_B;
+            case MAGE: return MAGE_B;
+            case WARLOCK: return WARLOCK_B;
+            case DRUID: return DRUID_B;
+            default: return nullptr;
+        }
+    }
+
+    // A link's points, and its points per tree.
+    inline uint32_t LinkPoints(char const* link)
+    {
+        uint32_t n = 0;
+        for (char const* c = link; c && *c; ++c)
+            if (*c >= '0' && *c <= '9')
+                n += uint32_t(*c - '0');
+        return n;
+    }
+    inline std::vector<uint32_t> LinkTrees(char const* link)
+    {
+        std::vector<uint32_t> out(1, 0);
+        for (char const* c = link; c && *c; ++c)
+        {
+            if (*c == '-')
+                out.push_back(0);
+            else if (*c >= '0' && *c <= '9')
+                out.back() += uint32_t(*c - '0');
+        }
+        return out;
+    }
+
+    // The gear set (Warfront kit, keyed like "warrior-fury-a") a role wears: words looked for in the kit's key,
+    // best first. No match: the class's first kit.
+    inline std::vector<std::string> KitWords(uint8_t cls, uint8_t role)
+    {
+        switch (cls)
+        {
+            case WARRIOR: return role == R_TANK ? std::vector<std::string>{ "protection", "fury", "arms" } : std::vector<std::string>{ "fury", "arms" };
+            case PALADIN: return role == R_HEALER ? std::vector<std::string>{ "holy" }
+                               : role == R_TANK ? std::vector<std::string>{ "protection", "holy", "retribution" }
+                               : std::vector<std::string>{ "retribution", "holy" };
+            case PRIEST: return role == R_HEALER ? std::vector<std::string>{ "holy", "discipline" } : std::vector<std::string>{ "shadow" };
+            case SHAMAN: return role == R_HEALER ? std::vector<std::string>{ "restoration" } : std::vector<std::string>{ "elemental", "enhancement" };
+            case DRUID: return role == R_HEALER ? std::vector<std::string>{ "restoration" } : std::vector<std::string>{ "feral", "balance" };
+            case ROGUE: return { "combat", "subtlety" };
+            case HUNTER: return { "marksmanship" };
+            case MAGE: return { "frost", "mage" };
+            case WARLOCK: return { "destruction", "affliction", "warlock" };
+            default: return {};
+        }
+    }
+
+    // Of the class's kit keys (already the right faction), the one a role wears.
+    inline std::string PickKit(std::vector<std::string> const& keys, std::vector<std::string> const& words)
+    {
+        for (std::string const& w : words)
+            for (std::string const& k : keys)
+                if (k.find(w) != std::string::npos)
+                    return k;
+        return keys.empty() ? std::string() : keys.front();
+    }
+
+    // ── action bars ──
+    //
+    // Buttons (0-based, the server's): main bar 0-11, bottom left 60-71, bottom right 48-59, right 24-35,
+    // right 2 36-47; the stance/form/stealth bars 72-107 copy the main bar (warriors, druids, rogues).
+    // The spec's abilities go on the main bar (keys 1 to =), the class's buffs, auras, forms and utility on the
+    // bottom left; every other class spell then fills bottom right and the side bars. Names: the spell's name
+    // (any rank: the highest known is used); "A|B": the first one the character knows.
+    inline std::vector<std::string> SpecBar(uint8_t cls, uint32_t tree)
+    {
+        switch (cls)
+        {
+            case WARRIOR:
+                if (tree == 0) return { "Mortal Strike", "Heroic Strike", "Cleave", "Overpower", "Execute", "Sunder Armor", "Whirlwind",
+                                        "Sweeping Strikes", "Battle Shout", "Bloodrage", "Demoralizing Shout", "Recklessness" };
+                if (tree == 1) return { "Bloodthirst", "Whirlwind", "Heroic Strike", "Cleave", "Execute", "Sunder Armor", "Battle Shout",
+                                        "Bloodrage", "Death Wish", "Recklessness", "Berserker Rage", "Pummel" };
+                return { "Sunder Armor", "Shield Slam", "Revenge", "Shield Block", "Taunt", "Heroic Strike", "Mocking Blow",
+                         "Demoralizing Shout", "Thunder Clap", "Shield Wall", "Last Stand", "Bloodrage" };
+            case PALADIN:
