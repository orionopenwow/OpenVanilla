+            return;
+        EnsureData();
+        GiveAllKits(p, given, full);
+    }
+
+    namespace
+    {
+        bool TakesKit(Player* p, Kit const& kit, bool own)
+        {
+            return kit.playerClass == p->getClass() && (!own || kit.alliance == (p->GetTeam() == ALLIANCE));
+        }
+
+        // a kit's pieces for this character (substituted where it can't wear one): slot -> item
+        std::vector<std::pair<uint8, uint32>> KitPieces(Player* p, Kit const& kit)
+        {
+            std::vector<std::pair<uint8, uint32>> out;
+            for (auto const& si : kit.items)
+                if (uint32 item = Substitute(p, si.second, si.first))
+                    out.emplace_back(si.first, item);
+            return out;
+        }
+    }
+
+    std::vector<std::string> GearSetKeys(Player* p)
+    {
+        std::vector<std::string> keys;
+        if (!p || !Enabled())
+            return keys;
+        EnsureData();
+        bool own = HasOwnFactionKit(p);
+        for (auto const& kv : g_kits)
+            if (TakesKit(p, kv.second, own))
+                keys.push_back(kv.first);
+        return keys;
+    }
+
+    uint32 GearSetsWhole(Player* p)
+    {
+        uint32 whole = 0;
+        for (std::string const& key : GearSetKeys(p))
+        {
+            std::map<uint32, uint32> need;
+            for (auto const& pc : KitPieces(p, g_kits[key]))
+                ++need[pc.second];
+            bool ok = !need.empty();
+            for (auto const& n : need)
+                if (p->GetItemCount(n.first, false) < n.second)
+                    ok = false;
+            if (ok)
+                ++whole;
+        }
+        return whole;
+    }
+
+    std::string WornGearSet(Player* p)
+    {
+        if (!p)
+            return "-";
+        uint32 worn = 0;
+        bool other = false;
+        std::set<uint32> items;
+        for (uint8 slot = EQUIPMENT_SLOT_START; slot < EQUIPMENT_SLOT_END; ++slot)
+            if (Item* it = p->GetItemByPos(INVENTORY_SLOT_BAG_0, slot))
+            {
+                ++worn;
+                items.insert(it->GetEntry());
+                if (it->GetProto()->Quality > ITEM_QUALITY_NORMAL && PoolTier(it->GetEntry()) < 0)
+                    other = true;
+            }
+        if (worn < 8)
+            return "-";
+        if (other)
+            return "own";
+        for (std::string const& key : GearSetKeys(p))
+        {
+            bool all = true;
+            for (auto const& pc : KitPieces(p, g_kits[key]))
+            {
+                Item* on = p->GetItemByPos(INVENTORY_SLOT_BAG_0, pc.first);
+                if (!on || on->GetEntry() != pc.second)
+                    all = false;
+            }
+            if (all)
+                return key;
+        }
+        return "mixed";
+    }
+
+    uint32 WearGearSet(Player* p, std::string const& key)
+    {
+        if (!p || !Enabled() || Blocked(p))
+            return 0;
+        EnsureData();
+        auto k = g_kits.find(key);
+        if (k == g_kits.end())
+            return 0;
+        uint32 on = 0;
+        for (auto const& pc : KitPieces(p, k->second))
+        {
+            char const* err = nullptr;
+            Item* cur = p->GetItemByPos(INVENTORY_SLOT_BAG_0, pc.first);
+            if (cur && cur->GetEntry() == pc.second)
+                continue;
+            if (Wear(p, pc.first, pc.second, 3, err))
+                ++on;
+        }
+        for (auto const& se : k->second.enchants)
+        {
+            char const* err = nullptr;
+            Enchant(p, se.first, se.second, err);
+        }
+        if (on)
+        {
+            sLog.outString("Open Vanilla Boss Fights: %s wears %s (%u pieces put on)", p->GetName(), key.c_str(), on);
+            Reply(p, "WK", "ok," + key + "," + std::to_string(on) + ",0");
+        }
+        return on;
+    }
+}
