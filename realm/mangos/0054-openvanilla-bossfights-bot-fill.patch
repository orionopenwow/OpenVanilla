+        // A kept bot of this role, class and faction nobody uses now, or a new one (bossfights_fill_bot). 0: none.
+        uint32 PickFillBot(BotJob const& j, uint32& made, bool& deferred)
+        {
+            deferred = false;
+            if (auto q = CharacterDatabase.PQuery("SELECT b.guid FROM bossfights_fill_bot b JOIN characters c ON c.guid = b.guid "
+                                                  "WHERE b.role = %u AND b.class = %u AND b.team = %u AND c.online = 0 ORDER BY b.used",
