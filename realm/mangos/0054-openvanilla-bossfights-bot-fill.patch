+                ai->ChangeStrategy("-rpg,-rpg jump,-travel,-grind,-quest,-loot,-gather,-wander,-explore,-lfg,-bg,-battleground,-arena,"
+                                   "-guild,-start duel,-duel,-pvp,-ai chat,-tfish,-mount,+dungeon", BotState::BOT_STATE_NON_COMBAT);
+                ai->ChangeStrategy("+dungeon", BotState::BOT_STATE_COMBAT);
+            }
