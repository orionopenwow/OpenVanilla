+        bool ReadNumber(char const* path, uint64& out)
+        {
+            std::ifstream f(path);
+            std::string v;
+            if (!(f >> v) || v.empty() || v.find_first_not_of("0123456789") != std::string::npos)
+                return false;                                   // missing, or "max" (no limit)
+            out = std::strtoull(v.c_str(), nullptr, 10);
