+                            CharacterDatabase.PExecute("UPDATE bossfights_fill_bot SET prepared = 1, used = UNIX_TIMESTAMP() WHERE guid = %u", j.guid);
+                        }
+                        std::lock_guard<std::mutex> guard(g_lock);
+                        auto it = g_fillBots.find(j.guid);
+                        if (it != g_fillBots.end())
+                        {
+                            it->second.preparing = false;
+                            it->second.prepared = ok;
+                        }
+                        break;
+                    }
+                    case BotJob::ASK:
+                    {
+                        asked.insert(j.ticket);
+                        bool deferred = false;
+                        uint32 g = PickFillBot(j, made, deferred);
+                        if (!g)
+                        {
+                            if (!deferred)
+                                ++failed[j.ticket];             // (deferred: the next second asks again, not a failure)
+                            break;
+                        }
+                        {
+                            std::lock_guard<std::mutex> guard(g_lock);
+                            if (g_fillBots.count(g))
+                                break;                          // taken meanwhile: the next second asks again
+                            FillBot& b = g_fillBots[g];
+                            b.ticket = j.ticket;
+                            b.role = j.role;
+                            b.cls = j.cls;
+                            b.test = j.test;
+                            b.askedAt = g_clock;
+                            // in Boss Fights from its first update (Duels' hangout code leaves it alone)
+                            PlayerState& st = g_players[g];
+                            st.loaded = true;
+                            st.mode = true;
+                            st.role = j.role;
+                            st.test = j.test;
+                            st.lobby = j.raid == "any" ? DefaultRaid() : j.raid;
+                        }
+                        // it logs in at the hangout, with no raid save of an old run
+                        CharacterDatabase.DirectPExecute("UPDATE characters SET map = %u, position_x = %f, position_y = %f, position_z = %f, orientation = %f "
+                                                         "WHERE guid = %u AND online = 0", c.lobby.map, c.lobby.x, c.lobby.y, c.lobby.z, c.lobby.o, g);
+                        CharacterDatabase.DirectPExecute("DELETE FROM character_instance WHERE guid = %u", g);
+                        // its account may log bots in (a bot account made after this server started is not on the list)
+                        uint32 account = sObjectMgr.GetPlayerAccountIdByGUID(ObjectGuid(HIGHGUID_PLAYER, g));
+                        if (account && !sPlayerbotAIConfig.IsInRandomAccountList(account))
+                            sPlayerbotAIConfig.randomBotAccounts.push_back(account);
+                        sRandomPlayerbotMgr.AddPlayerBot(g, 0);
+                        break;
+                    }
+                }
+            }
+            if (asked.empty())
+                return;
+            std::lock_guard<std::mutex> guard(g_lock);
+            for (QTicket& t : g_queue)
+                if (asked.count(t.id))
+                {
+                    t.asking = false;
+                    auto f = failed.find(t.id);
+                    if (f != failed.end())
+                        ++t.fillFails;
+                }
+#else
+            (void)jobs;
+#endif
+        }
