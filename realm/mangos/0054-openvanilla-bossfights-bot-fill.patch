+        // Free memory (MB) for this world server: the host's MemAvailable, and what is left under the container's
+        // limit when it has one (cgroup v2, then v1). Read at most every 5 s.
+        uint32 FreeMemoryMB()
+        {
+            static uint32 s_at = 0, s_mb = 0;                   // world thread only
+            if (s_at && g_clock - s_at < 5 * IN_MILLISECONDS)
+                return s_mb;
+            s_at = std::max<uint32>(1, g_clock);
+            uint64 availKB = 0;
+            {
+                std::ifstream f("/proc/meminfo");
+                std::string key, rest;
+                uint64 value = 0;
+                while (f >> key >> value)
+                {
+                    if (key == "MemAvailable:")
+                    {
+                        availKB = value;
+                        break;
+                    }
+                    std::getline(f, rest);
+                }
+            }
+            if (!availKB)
+                availKB = uint64(1) << 40;                      // no /proc/meminfo: no host limit known
+            uint64 limit = 0, usage = 0;
+            if (!(ReadNumber("/sys/fs/cgroup/memory.max", limit) && ReadNumber("/sys/fs/cgroup/memory.current", usage)) &&
+                !(ReadNumber("/sys/fs/cgroup/memory/memory.limit_in_bytes", limit) && ReadNumber("/sys/fs/cgroup/memory/memory.usage_in_bytes", usage)))
+                limit = usage = 0;
+            s_mb = FreeMB(availKB, limit, usage);
