+                // bots asked for when its turn has come: the oldest of its pool, waited long enough
+                uint32 people = TicketPeople(t), bots = 0;
+                uint32 have[3] = { 0, 0, 0 };
+                for (uint32 m : t.members)
+                    if (!IsFillBot(m))
+                        ++have[g_players[m].role];
+                for (auto const& kv : g_fillBots)
+                    if (kv.second.ticket == t.id)
+                    {
+                        ++bots;
+                        ++have[kv.second.role];
+                    }
+                bool due = !t.asking && people < size && people + bots < size && FillDue(uint32(time(nullptr) - t.since), FillSeconds(t));
+                if (due)
+                    for (auto oi = g_queue.begin(); oi != ti; ++oi)
+                        if (SamePool(*oi, t) && FillEligible(*oi))
+                            due = false;                        // an older ticket of the pool goes first
+                if (due)
+                {
+                    // the younger people of its pool who fit come along (one raid, not one each)
+                    for (auto oi = std::next(ti); oi != g_queue.end();)
+                    {
+                        bool theirBots = false;
+                        for (auto const& kv : g_fillBots)
+                            theirBots |= kv.second.ticket == oi->id;
+                        if (SamePool(*oi, t) && !theirBots && !oi->asking && people + bots + oi->members.size() <= size)
+                        {
+                            for (uint32 m : oi->members)
+                            {
+                                t.members.push_back(m);
+                                g_queued[m] = &t;
+                                ++have[g_players[m].role];
+                                ++people;
+                            }
+                            oi = g_queue.erase(oi);
+                        }
+                        else
+                            ++oi;
+                    }
+                    uint32 need = people + bots < size ? size - people - bots : 0;
+                    t.fillBlock = need ? CanFill(true, FillAiOn(), FreeMemoryMB(), c.botFillMinFreeMB, FillBotsAlive(), need, c.botFillMax, t.fillFails) : FILL_OK;
+                    if (need && t.fillBlock == FILL_OK)
+                    {
+                        RoleRule none;
+                        none.tanks = none.healers = 0;
+                        // have[] counts the people and the bots already asked for: the plan is for the seats left
+                        std::vector<Role> plan = PlanFill(size, have[ROLE_TANK], have[ROLE_HEALER], have[ROLE_DPS], t.test ? none : c.roles);
+                        if (plan.size() > need)
+                            plan.resize(need);
+                        bool alliance = true;
+                        if (Player* lead = sObjectMgr.GetPlayer(ObjectGuid(HIGHGUID_PLAYER, t.members.empty() ? 0 : t.members[0]), false))
+                            alliance = lead->GetTeam() == ALLIANCE;
+                        std::vector<uint8> classes = FillClasses(plan, alliance);
+                        for (size_t i = 0; i < plan.size(); ++i)
+                        {
+                            BotJob j;
+                            j.what = BotJob::ASK;
+                            j.ticket = t.id;
+                            j.role = plan[i];
+                            j.cls = classes[i];
+                            j.alliance = alliance;
+                            j.test = t.test;
+                            j.raid = t.raid;
+                            jobs.push_back(j);
+                        }
+                        t.asking = !plan.empty();
+                    }
+                }
+                FillState now = TicketFill(t);
+                if (now.state != was.state || now.ready != was.ready || now.want != was.want)
+                    NoticeTicket(t);                            // (not every second's countdown: the addon counts)
+            }
+        }
+
+#ifdef ENABLE_PLAYERBOTS
+        // A bot that came, made ready for a raid: level 60; the first time the bot factory's level-60 epic gear,
+        // spells, talents (its role's: chosen when the bot was made) and consumables, later only a top-up; no
+        // wandering, questing or duels; the dungeon strategies on (Onyxia's Lair and Molten Core switch on their
+        // own inside); full, alive, at the hangout. World thread, no g_lock.
+        void PrepareFillBot(Player* b, bool first)
+        {
+            if (!b->IsAlive())
