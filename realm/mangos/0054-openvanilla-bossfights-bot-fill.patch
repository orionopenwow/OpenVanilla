index 0000000..d8d927f
--- /dev/null
+++ b/src/game/OpenVanilla/BossFightsBotFillLogic.h
@@ -0,0 +1,208 @@
+/*
+ * Open Vanilla — Boss Fights' bot fill rules (GPLv2, as CMaNGOS): which roles the bots take, which classes play
+ * them, when a ticket's turn comes, whether bots can come at all (memory, the cap), the queue line's bot fields.
+ * No game objects, so realm/bossfights/tests/test_botfill.cpp runs them without a server. Used by BossFights.cpp
+ * (realm/mangos/0054-openvanilla-bossfights-bot-fill.patch).
+ */
+
+#ifndef OPENVANILLA_BOSSFIGHTS_BOTFILL_LOGIC_H
+#define OPENVANILLA_BOSSFIGHTS_BOTFILL_LOGIC_H
+
+#include "OpenVanilla/BossFightsLogic.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace BossFights
+{
+    // How many tanks and healers a filled raid of `size` aims for: at least the queue's role rule (when the rule
+    // applies to that size: the size holds its tanks and healers), and for a 10 or more 2 tanks and a healer for
+    // every four seats (10: 3, 20: 5, 40: 10); 3 to 9 seats: one of each; 1 or 2: none.
+    struct FillTarget { uint32_t tanks = 0; uint32_t healers = 0; };
+
+    inline FillTarget FillTargetFor(uint32_t size, RoleRule const& rule)
+    {
+        FillTarget t;
+        if (size >= 10)
+        {
+            t.tanks = 2;
+            t.healers = (size + 3) / 4;
+        }
+        else if (size >= 3)
+            t.tanks = t.healers = 1;
+        if (size >= rule.tanks + rule.healers)
+        {
+            t.tanks = std::max(t.tanks, rule.tanks);
+            t.healers = std::max(t.healers, rule.healers);
+        }
+        if (t.tanks + t.healers > size)                 // never more roles than seats
+        {
+            t.tanks = std::min(t.tanks, size);
+            t.healers = std::min(t.healers, size - t.tanks);
+        }
+        return t;
+    }
+
+    // The bots' roles for the seats the people leave: the missing tanks first, then the missing healers, then
+    // damage. `have*` are the people's roles; at most size - people bots (none when the people already fill it).
+    inline std::vector<Role> PlanFill(uint32_t size, uint32_t haveTanks, uint32_t haveHealers, uint32_t haveDps, RoleRule const& rule)
+    {
+        std::vector<Role> out;
+        uint32_t people = haveTanks + haveHealers + haveDps;
+        if (people >= size)
+            return out;
+        uint32_t seats = size - people;
+        FillTarget want = FillTargetFor(size, rule);
+        uint32_t needT = want.tanks > haveTanks ? want.tanks - haveTanks : 0;
+        uint32_t needH = want.healers > haveHealers ? want.healers - haveHealers : 0;
+        for (uint32_t i = 0; i < needT && out.size() < seats; ++i)
+            out.push_back(ROLE_TANK);
+        for (uint32_t i = 0; i < needH && out.size() < seats; ++i)
+            out.push_back(ROLE_HEALER);
+        while (out.size() < seats)
+            out.push_back(ROLE_DPS);
+        return out;
+    }
+
+    // The class a bot plays for a role (vanilla ids: 1 Warrior, 2 Paladin, 3 Hunter, 4 Rogue, 5 Priest, 7 Shaman,
+    // 8 Mage, 9 Warlock, 11 Druid), the n-th of that role in the raid: tanks are Warriors; healers take turns
+    // Priest, Druid, and the faction's own Paladin (Alliance) or Shaman (Horde); damage takes turns Mage, Rogue,
+    // Warlock, Hunter, Warrior.
+    inline uint8_t FillClass(Role role, bool alliance, uint32_t n)
+    {
+        if (role == ROLE_TANK)
+            return 1;
+        if (role == ROLE_HEALER)
+        {
+            uint8_t const heal[3] = { 5, 11, uint8_t(alliance ? 2 : 7) };
+            return heal[n % 3];
+        }
+        uint8_t const dps[5] = { 8, 4, 9, 3, 1 };
+        return dps[n % 5];
+    }
+
+    // The classes for a plan, counted per role (the second healer is a Druid, and so on).
+    inline std::vector<uint8_t> FillClasses(std::vector<Role> const& plan, bool alliance)
+    {
+        std::vector<uint8_t> out;
+        uint32_t n[3] = { 0, 0, 0 };
+        for (Role r : plan)
+            out.push_back(FillClass(r, alliance, n[r]++));
+        return out;
+    }
+
+    // Whether bots can come for a ticket now, and if not why (the queue line says it).
+    enum FillBlock : uint8_t
+    {
+        FILL_OK = 0,
+        FILL_OFF,           // bot fill is off (OpenVanilla.BossFights.BotFill = 0, or a self-test ticket without bots=1)
+        FILL_AI,            // the bot AI is off on this world server (AiPlayerbot.Enabled = 0, or no playerbots build)
+        FILL_MEMORY,        // too little free memory (OpenVanilla.BossFights.BotFill.MinFreeMB)
+        FILL_MAX,           // too many bots alive already (OpenVanilla.BossFights.BotFill.Max)
+        FILL_ERROR          // bots were asked for three times and never came (logins failing)
+    };
+
+    inline char const* FillBlockName(FillBlock b)
+    {
+        switch (b)
+        {
+            case FILL_OK:     return "ok";
+            case FILL_OFF:    return "off";
+            case FILL_AI:     return "ai";
+            case FILL_MEMORY: return "memory";
+            case FILL_MAX:    return "max";
+            default:          return "error";
+        }
+    }
+
+    // `alive`: fill bots logged in or on their way; `need`: the bots this ticket wants; `freeMB`: free memory now.
+    // The cap counts the whole fill: a raid never gets part of its bots and waits for the rest.
+    inline FillBlock CanFill(bool on, bool ai, uint32_t freeMB, uint32_t minFreeMB, uint32_t alive, uint32_t need, uint32_t max, uint32_t fails)
+    {
+        if (!on)
+            return FILL_OFF;
+        if (!ai)
+            return FILL_AI;
+        if (fails >= 3)
+            return FILL_ERROR;
+        if (alive + need > max)
+            return FILL_MAX;
+        if (freeMB < minFreeMB)
+            return FILL_MEMORY;
+        return FILL_OK;
+    }
+
+    // A ticket's turn: it has waited `after` seconds (0: at once).
+    inline bool FillDue(uint32_t waitedSec, uint32_t afterSec) { return waitedSec >= afterSec; }
+
+    // Free memory in MB for a process in a container: the host's MemAvailable (kB, from /proc/meminfo) and,
+    // when the container has a limit, what is left under it (bytes; limit 0 or "max": none). The smaller.
+    inline uint32_t FreeMB(uint64_t hostAvailableKB, uint64_t cgroupLimit, uint64_t cgroupUsage)
+    {
+        uint64_t host = hostAvailableKB / 1024;
+        if (cgroupLimit && cgroupLimit < (uint64_t(1) << 60))
+        {
+            uint64_t left = cgroupLimit > cgroupUsage ? (cgroupLimit - cgroupUsage) / (1024 * 1024) : 0;
+            host = std::min(host, left);
+        }
+        return uint32_t(std::min<uint64_t>(host, 0xFFFFFFFFu));
+    }
+
+    // What the queue line says about bots, after its eight fields (patch 0054; old addons read only the eight):
+    //   ,wait,<s>,0,<want>        bots come in <s> seconds
+    //   ,joining,0,<ready>,<want> bots logging in: <ready> of <want> are in the hangout
+    //   ,ready,0,<want>,<want>    every bot is in: the raid pops
+    //   ,<block>,0,0,<want>       bots can't come now (off, ai, memory, max, error): it waits for people
+    //   ,full,0,0,0               people fill it: no bots
+    struct FillState
+    {
+        std::string state = "full";
+        uint32_t seconds = 0, ready = 0, want = 0;
+    };
+
+    inline FillState FillStateFor(bool filling, uint32_t ready, uint32_t want, FillBlock block, uint32_t waitedSec, uint32_t afterSec)
+    {
+        FillState s;
+        s.want = want;
+        if (want && ready >= want)
+        {
+            s.state = "ready";
+            s.ready = ready;
+        }
+        else if (filling)
+        {
+            s.state = "joining";
+            s.ready = ready;
+        }
+        else if (!want)
+        {
+            s.state = "full";
+            s.want = 0;
+        }
+        else if (block != FILL_OK)
+            s.state = FillBlockName(block);
+        else
+        {
+            s.state = "wait";
+            s.seconds = afterSec > waitedSec ? afterSec - waitedSec : 0;
+        }
+        return s;
+    }
+
+    inline std::string FillFields(FillState const& s)
+    {
+        return "," + s.state + "," + std::to_string(s.seconds) + "," + std::to_string(s.ready) + "," + std::to_string(s.want);
+    }
+
+    // "bots=0|1" in the queue words (the self-test's: its ticket gets bots at once).
+    inline bool ParseBotsWord(std::string const& w, bool& bots)
+    {
+        if (w == "bots=1") { bots = true; return true; }
+        if (w == "bots=0") { bots = false; return true; }
+        return false;
+    }
+}
+
+#endif
