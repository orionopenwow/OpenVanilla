+// ---------------------------------------------------------------------------------------------------------
+// Side trips: none. On Open Vanilla spells are learned on level-up (OpenVanilla.AutoLearn), every character
+// has a mount from level 1 (he rides it whenever he travels, if he has one), and quests at the realm's
+// rates are the fastest XP, so he goes from quest to quest: no trainer, city, auction house, mailbox, bank,
+// boss or sightseeing trips. Vendors (selling grays, repairs) and gathering for the Gather goal stay.
+// ---------------------------------------------------------------------------------------------------------
+
+int TravelPurpose(PlayerbotAI* ai, uint32 purpose)
+{
+    if (!IsHerald(ai))
+        return -1;
+    switch (TravelDestinationPurpose(purpose))
+    {
+        case TravelDestinationPurpose::AH:
+        case TravelDestinationPurpose::Mail:
+        case TravelDestinationPurpose::Boss:
+        case TravelDestinationPurpose::GenericRpg:
+            return 0;
+        case TravelDestinationPurpose::GatherMining:
+        case TravelDestinationPurpose::GatherHerbalism:
+        case TravelDestinationPurpose::GatherSkinning:
+        case TravelDestinationPurpose::GatherFishing:
+            return ai->HasStrategy("gather", BotState::BOT_STATE_NON_COMBAT) ? -1 : 0;
+        default:
+            return -1;
+    }
+}
+
+int TravelNamed(PlayerbotAI* ai, std::string const& name)
+{
+    if (!IsHerald(ai))
+        return -1;
+    if (name == "reagent vendor")
+        return -1;                       // arrows, shot, reagents: still bought on the way
+    return 0;                            // trainers, mount, city, pvp, guild: never
+}
+
+bool SkipTrainer(PlayerbotAI* ai)
+{
+    return IsHerald(ai);
+}
+
