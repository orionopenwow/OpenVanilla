+        // patch 0058: whether someone can be taken into a raid that pops now. As CannotQueue, but combat in the
+        // hangout doesn't count: it is a safe place, and a swing at a practice dummy or a fill bot's pull there
+        // cancelled every pop ("Someone in your raid wasn't ready", 2026-10-23). The fight is stopped instead.
+        char const* CannotGo(Player* p)
+        {
+            char const* why = CannotQueue(p);
+            if (why && std::string(why) == "combat" && InLobby(p))
+            {
+                p->AttackStop();
+                p->CombatStop(true);
+                return nullptr;
+            }
+            return why;
+        }
