+#pragma once
+/*
+ * Open Vanilla 0058: Onyxia's Lair (map 249) geometry for the bots' Onyxia strategy. Pure functions, no game
+ * headers, so they are unit-tested on their own (realm/bossfights/tests/test_onyxia.cpp).
+ *
+ * The room, from CMaNGOS' boss_onyxia.cpp: in phase 2 Onyxia hovers at eight points around the room (aMoveData)
+ * and a Deep Breath crosses from her point through the middle to the opposite point. The middle of those eight
+ * points is about (-21.6, -214.5); +x is north (the north point is (24.2, -216.1)). Whelps come out of the two
+ * egg tunnels at (-30.1, -254.5) and (-30.8, -177.1).
+ */
+#include <cmath>
+
+namespace ai
+{
+namespace onyxia
+{
+    constexpr float PI_F = 3.14159265358979f;
+
+    constexpr float CENTER_X = -21.6f, CENTER_Y = -214.5f;
+    constexpr float FLOOR_RADIUS = 34.0f;           // the bots stay this close to the middle (the walls, the egg tunnels)
+    constexpr float TANK_X = 6.0f, TANK_Y = -214.5f;  // phases 1 and 3: the tank holds her here, facing the north wall
+    constexpr float TUNNEL_A_X = -30.1f, TUNNEL_A_Y = -254.5f;
+    constexpr float TUNNEL_B_X = -30.8f, TUNNEL_B_Y = -177.1f;
+    constexpr float TUNNEL_KEEP = 16.0f;            // no closer to a whelp tunnel (eggs hatch when walked near)
+
+    constexpr float BREATH_HALF_WIDTH = 9.0f;       // the fire trail is 10-18 yards wide by the guides; 9 either side
+    constexpr float BREATH_SAFE = 17.0f;            // where a bot moves to: well outside the trail
+    constexpr float FRONT_HALF_ANGLE = PI_F / 3.0f; // Flame Breath / Cleave / Wing Buffet: a cone in front (±60°)
+    constexpr float REAR_HALF_ANGLE = PI_F / 3.0f;  // Tail Sweep: a cone behind (±60°)
+    constexpr float FRONT_DANGER = 40.0f;           // Flame Breath reaches far (45-yard cone in later versions)
+    constexpr float REAR_DANGER = 30.0f;            // Tail Sweep knocks back up to 30 yards
+
+    // a - b, in (-pi, pi]
+    inline float AngleDiff(float a, float b)
+    {
+        float d = std::fmod(a - b, 2.0f * PI_F);
+        if (d <= -PI_F)
+            d += 2.0f * PI_F;
+        else if (d > PI_F)
+            d -= 2.0f * PI_F;
+        return d;
+    }
+
+    inline float Dist(float ax, float ay, float bx, float by) { return std::sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by)); }
+
+    // Where the point (px, py) is around a unit at (ux, uy) facing uo: the angle off its nose, in (-pi, pi]
+    // (0 straight ahead, ±pi straight behind; positive: on its left).
+    inline float RelativeAngle(float ux, float uy, float uo, float px, float py)
+    {
+        return AngleDiff(std::atan2(py - uy, px - ux), uo);
+    }
+
+    // A non-tank in Onyxia's front cone (breath, cleave, buffet) or tail cone (sweep), close enough to be hit.
+    inline bool InBadSpot(float ox, float oy, float oo, float px, float py)
+    {
+        float rel = RelativeAngle(ox, oy, oo, px, py);
+        float d = Dist(ox, oy, px, py);
+        if (std::fabs(rel) < FRONT_HALF_ANGLE && d < FRONT_DANGER)
+            return true;
+        if (std::fabs(rel) > PI_F - REAR_HALF_ANGLE && d < REAR_DANGER)
+            return true;
+        return false;
+    }
+
+    // The flank a bot goes to: its own side (left +1 / right -1), `dist` yards out, square to her facing.
+    inline void FlankPoint(float ox, float oy, float oo, int side, float dist, float& x, float& y)
+    {
+        float a = oo + (side >= 0 ? 1.0f : -1.0f) * PI_F / 2.0f;
+        x = ox + dist * std::cos(a);
+        y = oy + dist * std::sin(a);
+    }
+
+    // The side of her a point is on (+1 left, -1 right); on her centre line, `tie` decides.
+    inline int SideOf(float ox, float oy, float oo, float px, float py, int tie)
+    {
+        float rel = RelativeAngle(ox, oy, oo, px, py);
+        if (std::fabs(rel) < 0.05f || std::fabs(std::fabs(rel) - PI_F) < 0.05f)
+            return tie >= 0 ? 1 : -1;
+        return rel > 0 ? 1 : -1;
+    }
+
+    // Distance from (px, py) to the infinite line through (ax, ay) and (bx, by), and on which side (+1/-1).
+    inline float LineDistance(float ax, float ay, float bx, float by, float px, float py, int& side)
+    {
+        float dx = bx - ax, dy = by - ay;
+        float len = std::sqrt(dx * dx + dy * dy);
+        if (len < 0.001f)
+        {
+            side = 1;
+            return Dist(ax, ay, px, py);
+        }
+        float cross = (dx * (py - ay) - dy * (px - ax)) / len;
+        side = cross >= 0 ? 1 : -1;
+        return std::fabs(cross);
+    }
+
+    // Phase 2: is (px, py) on the Deep Breath line from Onyxia's spot through the middle of the room?
+    inline bool InBreathLine(float ox, float oy, float px, float py, float halfWidth = BREATH_HALF_WIDTH)
+    {
+        int side = 0;
+        return LineDistance(ox, oy, CENTER_X, CENTER_Y, px, py, side) < halfWidth;
+    }
+
+    inline bool NearTunnel(float x, float y)
+    {
+        return Dist(x, y, TUNNEL_A_X, TUNNEL_A_Y) < TUNNEL_KEEP || Dist(x, y, TUNNEL_B_X, TUNNEL_B_Y) < TUNNEL_KEEP;
+    }
+
+    // Pull a point back inside the floor circle.
+    inline void ClampToFloor(float& x, float& y, float radius = FLOOR_RADIUS)
+    {
+        float d = Dist(x, y, CENTER_X, CENTER_Y);
+        if (d > radius && d > 0.001f)
+        {
+            x = CENTER_X + (x - CENTER_X) * radius / d;
+            y = CENTER_Y + (y - CENTER_Y) * radius / d;
+        }
+    }
+
+    // Phase 2: the spot out of the breath line, square to it on the bot's own side (or `tie`'s on the line),
+    // `safe` yards from it, inside the floor and away from the egg tunnels. False if no such spot (try the
+    // other side then).
+    inline bool BreathEscape(float ox, float oy, float px, float py, int side, float& x, float& y, float safe = BREATH_SAFE)
+    {
+        float dx = CENTER_X - ox, dy = CENTER_Y - oy;
+        float len = std::sqrt(dx * dx + dy * dy);
+        if (len < 0.001f)
+            return false;
+        dx /= len;
+        dy /= len;
+        // the normal on the left of the line's direction
+        float nx = -dy, ny = dx;
+        // the foot of the point on the line
+        float t = (px - ox) * dx + (py - oy) * dy;
+        float fx = ox + t * dx, fy = oy + t * dy;
+        float s = side >= 0 ? 1.0f : -1.0f;
+        for (float along = 0.0f; along <= 24.0f; along += 6.0f)
+        {
+            for (int k = 0; k < 2; ++k)
+            {
+                float shift = k == 0 ? along : -along;      // slide along the line too, when the wall is in the way
+                x = fx + dx * shift + nx * s * safe;
+                y = fy + dy * shift + ny * s * safe;
+                if (Dist(x, y, CENTER_X, CENTER_Y) <= FLOOR_RADIUS && !NearTunnel(x, y))
+                    return true;
+                if (along == 0.0f)
+                    break;
+            }
+        }
+        return false;
+    }
+}
+}
