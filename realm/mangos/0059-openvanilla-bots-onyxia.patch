--- /dev/null
+++ b/src/modules/PlayerBots/playerbot/strategy/generic/OnyxiaHelpers.h
@@ -0,0 +1,66 @@
+#pragma once
+/*
+ * Open Vanilla 0058: finding Onyxia and telling her phase, for the bots' Onyxia strategy (triggers and actions).
+ */
+#include "playerbot/playerbot.h"
+#include "OnyxiaGeometry.h"
+#include "Grids/GridNotifiers.h"
+#include "Grids/GridNotifiersImpl.h"
+#include "Grids/CellImpl.h"
+
+namespace ai
+{
+namespace onyxia
+{
+    constexpr uint32 NPC_ONYXIA = 10184;
+    constexpr uint32 SPELL_PACIFY_SELF = 19951;     // on her for the whole flight (phase 2)
+    constexpr uint32 SPELL_DRAGON_HOVER = 18430;    // hovering at a point (phase 2)
+    constexpr uint32 MAP_ONYXIAS_LAIR = 249;
+    constexpr float PHASE_3_PCT = 40.0f;
+
+    // Onyxia, alive and fighting, within 150 yards (the whole lair); nullptr otherwise.
+    inline Creature* Find(Player* bot)
+    {
+        if (!bot || !bot->IsInWorld() || bot->GetMapId() != MAP_ONYXIAS_LAIR)
+            return nullptr;
+        std::list<Unit*> units;
+        MaNGOS::AllCreaturesOfEntryInRangeCheck check(bot, NPC_ONYXIA, 150.0f);
+        MaNGOS::UnitListSearcher<MaNGOS::AllCreaturesOfEntryInRangeCheck> searcher(units, check);
+        Cell::VisitAllObjects(bot, searcher, 150.0f);
+        for (Unit* u : units)
+            if (u && u->IsAlive() && u->IsInCombat())
+                return static_cast<Creature*>(u);
+        return nullptr;
+    }
+
+    // In the air (phase 2), breathing and throwing fireballs; or on her way up or down.
+    inline bool Flying(Creature* ony)
+    {
+        return ony && (ony->HasAura(SPELL_PACIFY_SELF) || ony->HasAura(SPELL_DRAGON_HOVER) || ony->IsHovering());
+    }
+
+    // On the ground and fighting: phase 1 or phase 3 (not walking off to take flight: no target then).
+    inline bool OnGround(Creature* ony)
+    {
+        return ony && !Flying(ony) && ony->GetVictim();
+    }
+
+    // Phase 3: landed, below 40%.
+    inline bool PhaseThree(Creature* ony)
+    {
+        return OnGround(ony) && ony->GetHealthPercent() <= PHASE_3_PCT + 1.0f;
+    }
+
+    // A bot's side of the raid when nothing else decides: half one way, half the other.
+    inline int DefaultSide(Player* bot)
+    {
+        return (bot->GetGUIDLow() & 1) ? 1 : -1;
+    }
+
+    inline float FloorZ(Player* bot, float x, float y)
+    {
+        float z = bot->GetMap()->GetHeight(x, y, bot->GetPositionZ() + 10.0f);
+        return z > INVALID_HEIGHT ? z : bot->GetPositionZ();
+    }
+}
+}
