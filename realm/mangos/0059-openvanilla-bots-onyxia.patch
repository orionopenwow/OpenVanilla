+using namespace ai;
+
+// Open Vanilla 0058: the Onyxia fight.
+
+namespace
+{
+    // Somewhere the bot can walk to and see from: on the floor, not by a whelp tunnel.
+    bool Reachable(Player* bot, float x, float y, float z)
+    {
+        if (onyxia::NearTunnel(x, y))
+            return false;
+        if (!bot->IsWithinLOS(x, y, z + bot->GetCollisionHeight()))
+            return false;
+        return WorldPosition(bot).canPathTo(WorldPosition(bot->GetMapId(), x, y, z), bot);
+    }
+}
+
+bool MoveToOnyxiaFlankAction::Execute(Event& /*event*/)
+{
+    Creature* ony = onyxia::Find(bot);
+    if (!onyxia::OnGround(ony))
+        return false;
+    float ox = ony->GetPositionX(), oy = ony->GetPositionY(), oo = ony->GetOrientation();
+    int side = onyxia::SideOf(ox, oy, oo, bot->GetPositionX(), bot->GetPositionY(), onyxia::DefaultSide(bot));
+    bool far = ai->IsRanged(bot) || ai->IsHeal(bot);
+    float dist = far ? 22.0f : std::min(12.0f, ony->GetCombatReach() + bot->GetCombatReach() + 0.5f);
+    for (int attempt = 0; attempt < 2; ++attempt, side = -side)
+    {
+        float x, y;
+        onyxia::FlankPoint(ox, oy, oo, side, dist, x, y);
+        onyxia::ClampToFloor(x, y);
+        float z = onyxia::FloorZ(bot, x, y);
+        if (!Reachable(bot, x, y, z))
+            continue;
+        if (MoveTo(bot->GetMapId(), x, y, z, false, false, false, true))
+            return true;
+    }
+    return false;
+}
+
+bool MoveToOnyxiaTankSpotAction::Execute(Event& /*event*/)
+{
+    Creature* ony = onyxia::Find(bot);
+    if (!onyxia::OnGround(ony) || ony->GetVictim() != bot)
+        return false;
+    float z = onyxia::FloorZ(bot, onyxia::TANK_X, onyxia::TANK_Y);
+    return MoveTo(bot->GetMapId(), onyxia::TANK_X, onyxia::TANK_Y, z, false, false, false, true);
+}
+
+bool MoveOutOfOnyxiaBreathAction::Execute(Event& /*event*/)
+{
+    Creature* ony = onyxia::Find(bot);
+    if (!ony || !onyxia::Flying(ony))
+        return false;
+    float ox = ony->GetPositionX(), oy = ony->GetPositionY();
+    int side = 0;
+    float d = onyxia::LineDistance(ox, oy, onyxia::CENTER_X, onyxia::CENTER_Y, bot->GetPositionX(), bot->GetPositionY(), side);
+    if (d < 0.5f)
+        side = onyxia::DefaultSide(bot);
+    for (int attempt = 0; attempt < 2; ++attempt, side = -side)
+    {
+        float x, y;
+        if (!onyxia::BreathEscape(ox, oy, bot->GetPositionX(), bot->GetPositionY(), side, x, y))
+            continue;
+        float z = onyxia::FloorZ(bot, x, y);
+        if (!Reachable(bot, x, y, z))
+            continue;
+        if (MoveTo(bot->GetMapId(), x, y, z, false, IsReaction(), false, true))
+        {
+            if (IsReaction())
+                WaitForReach(bot->GetDistance(x, y, z));
+            return true;
+        }
+    }
+    return false;
+}
 
-using namespace ai;
\ No newline at end of file
+bool OnyxiaFearCounterAction::Execute(Event& /*event*/)
+{
+    Creature* ony = onyxia::Find(bot);
+    if (!onyxia::PhaseThree(ony))
+        return false;
+    if (bot->getClass() == CLASS_SHAMAN)
+        return ai->CastSpell("tremor totem", bot);
+    if (bot->getClass() == CLASS_PRIEST)
+        if (Unit* tank = ony->GetVictim())
+            return ai->CastSpell("fear ward", tank);
+    return false;
+}
