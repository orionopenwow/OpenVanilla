+ * when hurt (kick it), and every 20 s a crowd control in turn (Polymorph, Psychic Scream, Hammer of
+ * Justice in melee) to break or trinket. It never dies (back to full at 10%), and when you stop for
+ * 6 s it whispers your damage per second, the damage it did to you and the casts you stopped.
  */
 
 #include "AI/ScriptDevAI/include/sc_common.h"
@@ -106,8 +112,176 @@ struct npc_openvanilla_training_dummyAI : public ScriptedAI
     }
 };
 
+// ── the sparring dummy (patch 0061) ──
+
+namespace
+{
+    uint32 const SPAR_FROSTBOLT = 10181;        // Frostbolt (Rank 10), 3 s cast
+    uint32 const SPAR_SHADOWBOLT = 11661;       // Shadow Bolt (Rank 9), 3 s cast
+    uint32 const SPAR_FLASH_HEAL = 10917;       // Flash Heal (Rank 7), 1.5 s
+    uint32 const SPAR_POLYMORPH = 12826;        // Polymorph (Rank 4)
+    uint32 const SPAR_SCREAM = 10890;           // Psychic Scream (Rank 4)
+    uint32 const SPAR_HAMMER = 10308;           // Hammer of Justice (Rank 4), melee range
+
+    struct Spar { uint64 dealt = 0; uint64 taken = 0; uint32 hits = 0; uint32 stopped = 0; uint32 start = 0; uint32 last = 0; };
+}
+
+struct npc_openvanilla_sparring_dummyAI : public ScriptedAI
+{
+    npc_openvanilla_sparring_dummyAI(Creature* creature) : ScriptedAI(creature), m_clock(0), m_check(1000), m_bolt(2500),
+        m_heal(8000), m_cc(12000), m_ccTurn(0), m_casting(0)
+    {
+        SetReactState(REACT_DEFENSIVE);
+        SetCombatMovement(false);
+        Reset();
+    }
+
+    uint32 m_clock, m_check, m_bolt, m_heal, m_cc, m_ccTurn, m_casting;
+    std::map<ObjectGuid, Spar> m_sessions;
+
+    void Reset() override
+    {
+        m_bolt = 2500;
+        m_heal = 8000;
+        m_cc = 12000;
+        m_casting = 0;
+    }
+
+    Spar& SessionOf(Player* player)
+    {
+        Spar& s = m_sessions[player->GetObjectGuid()];
+        if (!s.hits && !s.taken)
+            s.start = m_clock;
+        s.last = m_clock;
+        return s;
+    }
+
+    void DamageTaken(Unit* dealer, uint32& damage, DamageEffectType /*damageType*/, SpellEntry const* /*spellInfo*/) override
+    {
+        if (Player* player = dealer ? dealer->GetBeneficiaryPlayer() : nullptr)
+        {
+            Spar& s = SessionOf(player);
+            s.dealt += damage;
+            ++s.hits;
+        }
+        uint32 floor = m_creature->GetMaxHealth() / 10;
+        if (m_creature->GetHealth() <= floor + damage)
+        {
+            damage = 0;
+            m_creature->SetHealth(m_creature->GetMaxHealth());
+        }
+    }
+
+    void DamageDeal(Unit* doneTo, uint32& damage, DamageEffectType /*damageType*/, SpellEntry const* /*spellInfo*/) override
+    {
+        if (Player* player = doneTo ? doneTo->GetBeneficiaryPlayer() : nullptr)
+            SessionOf(player).taken += damage;
+    }
+
+    void OnSpellInterrupt(SpellEntry const* spellInfo) override
+    {
+        ScriptedAI::OnSpellInterrupt(spellInfo);
+        if (Unit* victim = m_creature->GetVictim())
+            if (Player* player = victim->GetBeneficiaryPlayer())
+                ++SessionOf(player).stopped;
+    }
+
+    void Report(ObjectGuid guid, Spar const& s)
+    {
+        Player* player = m_creature->GetMap()->GetPlayer(guid);
+        if (!player)
+            return;
+        float secs = std::max(1.0f, (s.last - s.start) / 1000.0f);
+        char text[255];
+        std::snprintf(text, sizeof(text), "%.1f damage per second (%llu in %.1f s). I did %llu to you. You stopped %u of my casts.",
+                      s.dealt / secs, (unsigned long long)s.dealt, secs, (unsigned long long)s.taken, s.stopped);
+        m_creature->MonsterWhisper(text, player);
+    }
+
+    bool Cast(Unit* target, uint32 spell)
+    {
+        if (!target || !sSpellTemplate.LookupEntry<SpellEntry>(spell))
+            return false;
+        return DoCastSpellIfCan(target, spell) == CAST_OK;
+    }
+
+    void UpdateAI(uint32 const diff) override
+    {
+        m_clock += diff;
+        if (m_check <= diff)
+        {
+            m_check = 1000;
+            for (auto it = m_sessions.begin(); it != m_sessions.end();)
+            {
+                if (m_clock - it->second.last >= REPORT_AFTER)
+                {
+                    Report(it->first, it->second);
+                    it = m_sessions.erase(it);
+                }
+                else
+                    ++it;
+            }
+            if (m_sessions.empty() && m_creature->IsInCombat())
+            {
+                EnterEvadeMode();                   // back to full health, out of combat
+                return;
+            }
+        }
+        else
+            m_check -= diff;
+
+        if (!m_creature->SelectHostileTarget() || !m_creature->GetVictim())
+            return;
+        Unit* victim = m_creature->GetVictim();
+        m_creature->SetFacingToObject(victim);
+        if (m_creature->IsNonMeleeSpellCasted(false))
+            return;
+
+        if (m_cc <= diff)
+        {
+            m_cc = 20000;
+            uint32 const turn[3] = { SPAR_POLYMORPH, SPAR_SCREAM, SPAR_HAMMER };
+            uint32 spell = turn[m_ccTurn++ % 3];
+            if ((spell == SPAR_SCREAM || spell == SPAR_HAMMER) && !m_creature->CanReachWithMeleeAttack(victim))
+                spell = SPAR_POLYMORPH;
+            if (Cast(spell == SPAR_SCREAM ? m_creature : victim, spell))
+                return;
+        }
+        else
+            m_cc -= diff;
+
+        if (m_heal <= diff)
+        {
+            if (m_creature->GetHealthPercent() < 70.0f && Cast(m_creature, SPAR_FLASH_HEAL))
+            {
+                m_heal = 10000;
+                return;
+            }
+            m_heal = 1000;
+        }
+        else
+            m_heal -= diff;
+
+        if (m_bolt <= diff)
+        {
+            m_bolt = 3500;
+            if (Cast(victim, (m_clock / 3500) % 2 ? SPAR_SHADOWBOLT : SPAR_FROSTBOLT))
+                return;
+        }
+        else
+            m_bolt -= diff;
+
+        DoMeleeAttackIfReady();
+    }
+};
+
 void AddSC_openvanilla_training_dummy()
 {
+    Script* pSpar = new Script;
+    pSpar->Name = "npc_openvanilla_sparring_dummy";
+    pSpar->GetAI = &GetNewAIInstance<npc_openvanilla_sparring_dummyAI>;
+    pSpar->RegisterSelf();
+
     Script* pNewScript = new Script;
     pNewScript->Name = "npc_openvanilla_training_dummy";
     pNewScript->GetAI = &GetNewAIInstance<npc_openvanilla_training_dummyAI>;
