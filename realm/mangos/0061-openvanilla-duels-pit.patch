+        struct Settings
+        {
+            bool on = false;
+            float x = -13202.9f, y = 276.76f, z = 21.86f, radius = 70.0f;
+            bool line = true;
+            uint32 lineBreakMs = 8 * IN_MILLISECONDS;
+            uint32 crowd = 16;
+            uint32 crowdEntry = 900120;
+            bool brawl = true;
+            uint32 brawlEvery = 60;
+            uint32 brawlMs = 180 * IN_MILLISECONDS;
+            uint32 brawlMin = 3;
