diff --git a/src/game/OpenVanilla/DuelsPitLogic.h b/src/game/OpenVanilla/DuelsPitLogic.h
new file mode 100644
index 000000000..e22821808
--- /dev/null
+++ b/src/game/OpenVanilla/DuelsPitLogic.h
@@ -0,0 +1,280 @@
+/*
+ * Open Vanilla — Duels: the pit's rules, without the game (patch 0061, DuelsPit.cpp).
+ * Header only and free of CMaNGOS, so realm/duels/tests/test_pit.cpp can test it alone.
+ */
+
+#ifndef OPENVANILLA_DUELS_PIT_LOGIC_H
+#define OPENVANILLA_DUELS_PIT_LOGIC_H
+
+#include <algorithm>
+#include <cstdint>
+#include <ctime>
+#include <deque>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace DuelsPitLogic
+{
+    // The announcer calls a streak at 3, 5, 10 and every 5 after that.
+    inline bool CallStreak(uint32_t streak)
+    {
+        return streak == 3 || streak == 5 || (streak >= 10 && streak % 5 == 0);
+    }
+
+    // ...and an ended streak of 3 or more.
+    inline bool CallEnded(uint32_t ended) { return ended >= 3; }
+
+    // How many of the crowd cheer a finish: a few always, more for a streak, all of them for 10.
+    inline uint32_t Cheering(uint32_t streak, uint32_t ended, uint32_t crowd)
+    {
+        uint32_t n = 3 + 2 * std::max(streak, ended);
+        return std::min(n, crowd);
+    }
+
+    // A win counts for the record at most this often a day against the same opponent.
+    uint32_t const SAME_OPPONENT_PER_DAY = 5;
+
+    // Counted wins per (winner, loser) and day.
+    class Matchups
+    {
+    public:
+        // true when this win counts (and it is counted now)
+        bool Count(uint32_t winner, uint32_t loser, std::time_t now)
+        {
+            long day = long(now / 86400);
+            if (day != m_day)
+            {
+                m_day = day;
+                m_count.clear();
+            }
+            uint32_t& n = m_count[std::make_pair(winner, loser)];
+            if (n >= SAME_OPPONENT_PER_DAY)
+                return false;
+            ++n;
+            return true;
+        }
+
+    private:
+        long m_day = -1;
+        std::map<std::pair<uint32_t, uint32_t>, uint32_t> m_count;
+    };
+
+    // Winner stays on: the champion holds the pit, the line waits behind.
+    class Line
+    {
+    public:
+        bool Has(uint32_t guid) const
+        {
+            return std::find(m_line.begin(), m_line.end(), guid) != m_line.end();
+        }
+        // the place in line (1 = next), 0 when not in it
+        uint32_t Place(uint32_t guid) const
+        {
+            for (size_t i = 0; i < m_line.size(); ++i)
+                if (m_line[i] == guid)
+                    return uint32_t(i + 1);
+            return 0;
+        }
+        bool Join(uint32_t guid)
+        {
+            if (!guid || guid == champion || Has(guid))
+                return false;
+            m_line.push_back(guid);
+            return true;
+        }
+        bool Leave(uint32_t guid)
+        {
+            if (guid == champion && guid)
+            {
+                champion = 0;
+                streak = 0;
+                return true;
+            }
+            auto it = std::find(m_line.begin(), m_line.end(), guid);
+            if (it == m_line.end())
+                return false;
+            m_line.erase(it);
+            return true;
+        }
+        // Who fights next: no champion yet, the first in line takes the pit. 0,0 when nobody can.
+        std::pair<uint32_t, uint32_t> Next()
+        {
+            if (!champion && !m_line.empty())
+            {
+                champion = m_line.front();
+                m_line.pop_front();
+                streak = 0;
+            }
+            if (!champion || m_line.empty())
+                return std::make_pair(0u, 0u);
+            return std::make_pair(champion, m_line.front());
+        }
+        // The challenger didn't come (away, dead, busy): to the back (or out after three misses).
+        void Skip(uint32_t challenger)
+        {
+            auto it = std::find(m_line.begin(), m_line.end(), challenger);
+            if (it == m_line.end())
+                return;
+            m_line.erase(it);
+            if (++m_misses[challenger] < 3)
+                m_line.push_back(challenger);
+            else
+                m_misses.erase(challenger);
+        }
+        // A line fight ended. The winner holds the pit; the loser goes to the back when he stays in line.
+        // Returns the streak that ended (the champion's, when the challenger won).
+        uint32_t Result(uint32_t winner, uint32_t loser, bool loserStays)
+        {
+            uint32_t ended = 0;
+            m_line.erase(std::remove(m_line.begin(), m_line.end(), winner), m_line.end());
+            m_line.erase(std::remove(m_line.begin(), m_line.end(), loser), m_line.end());
+            m_misses.erase(winner);
+            m_misses.erase(loser);
+            if (winner == champion)
+                ++streak;
+            else
+            {
+                ended = loser == champion ? streak : 0;
+                champion = winner;
+                streak = 1;
+            }
+            if (loserStays && loser)
+                m_line.push_back(loser);
+            return ended;
+        }
+        std::deque<uint32_t> const& Waiting() const { return m_line; }
+        void Clear()
+        {
+            m_line.clear();
+            m_misses.clear();
+            champion = 0;
+            streak = 0;
+        }
+
+        uint32_t champion = 0;
+        uint32_t streak = 0;
+
+    private:
+        std::deque<uint32_t> m_line;
+        std::map<uint32_t, uint32_t> m_misses;
+    };
+
+    // Seconds until the next brawl starts (on the clock: every `everyMin` minutes from midnight UTC).
+    inline long SecondsToBrawl(std::time_t now, uint32_t everyMin)
+    {
+        long every = long(std::max<uint32_t>(everyMin, 5)) * 60;
+        long into = long(now % every);
+        return into == 0 ? 0 : every - into;
+    }
+
+    // The cup's week: Monday-based week number since the epoch, so each week has its own cup.
+    inline long WeekOf(std::time_t now) { return long((now / 86400 + 3) / 7); }   // 1970-01-01 was a Thursday
+
+    // Seconds from now to this week's cup start (negative once it has started), for day 0..6 (0 Sunday), hour UTC.
+    inline long SecondsToCup(std::time_t now, int day, int hour)
+    {
+        long today = long(now / 86400);
+        int wday = int((today + 4) % 7);            // 0 Sunday
+        long start = (today + (day - wday)) * 86400 + long(hour) * 3600;
+        return long(start - now);
+    }
+
+    // A single-elimination bracket fought one duel at a time.
+    class Bracket
+    {
+    public:
+        struct Fight { uint32_t a = 0, b = 0, winner = 0; };
+
+        void Start(std::vector<uint32_t> entrants)
+        {
+            m_rounds.clear();
+            m_round = 0;
+            m_entrants = entrants.size();
+            Fill(entrants);
+        }
+        bool Running() const { return !m_rounds.empty() && !Champion(); }
+        uint32_t Champion() const
+        {
+            if (m_rounds.empty())
+                return 0;
+            std::vector<Fight> const& last = m_rounds[m_round];
+            return last.size() == 1 && last[0].winner ? last[0].winner : 0;
+        }
+        // The next fight to call: a pointer into the bracket, nullptr when the round is waiting on nothing.
+        Fight* Next()
+        {
+            if (m_rounds.empty())
+                return nullptr;
+            for (Fight& f : m_rounds[m_round])
+                if (!f.winner)
+                    return &f;
+            return nullptr;
+        }
+        // A fight's result (or a no-show: the other one goes through). Moves to the next round when done.
+        void Result(uint32_t winner)
+        {
+            if (m_rounds.empty())
+                return;
+            for (Fight& f : m_rounds[m_round])
+                if (!f.winner && (f.a == winner || f.b == winner))
+                {
+                    f.winner = winner;
+                    break;
+                }
+            if (Finished(m_round) && Left(m_round) > 1)
+            {
+                std::vector<uint32_t> next;
+                for (Fight const& f : m_rounds[m_round])
+                    next.push_back(f.winner);
+                ++m_round;
+                Fill(next);
+            }
+        }
+        uint32_t Round() const { return uint32_t(m_round + 1); }
+        size_t Entrants() const { return m_entrants; }
+        std::vector<std::vector<Fight>> const& Rounds() const { return m_rounds; }
+
+    private:
+        bool Finished(size_t r) const
+        {
+            for (Fight const& f : m_rounds[r])
+                if (!f.winner)
+                    return false;
+            return true;
+        }
+        size_t Left(size_t r) const { return m_rounds[r].size(); }
+        void Fill(std::vector<uint32_t> const& in)
+        {
+            std::vector<Fight> round;
+            for (size_t i = 0; i < in.size(); i += 2)
+            {
+                Fight f;
+                f.a = in[i];
+                f.b = i + 1 < in.size() ? in[i + 1] : 0;
+                if (!f.b)
+                    f.winner = f.a;                 // a bye
+                round.push_back(f);
+            }
+            m_rounds.push_back(round);
+        }
+
+        std::vector<std::vector<Fight>> m_rounds;
+        size_t m_round = 0;
+        size_t m_entrants = 0;
+    };
+
+    // Names and titles in addon lines: no separators.
+    inline std::string Clean(std::string s, size_t max = 32)
+    {
+        for (char& c : s)
+            if (c == ',' || c == ';' || c == '|' || c == '\n' || c == '\r' || c == '\'' || c == '\\')
+                c = ' ';
+        if (s.size() > max)
+            s.resize(max);
+        return s;
+    }
+}
+
+#endif
