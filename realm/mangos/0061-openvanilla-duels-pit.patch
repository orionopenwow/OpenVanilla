+            uint32 challengeMax = 100;
+            bool cup = true;
+            int cupDay = 6, cupHour = 19;
+            uint32 cupSignupMin = 60;
+            uint32 cupMax = 32;
+            std::string rules;
+        };
+
+        Settings const& Conf()
+        {
+            static Settings const s = []
+            {
+                Settings c;
+                ::Config& conf = MaNGOS::Singleton<::Config>::Instance();
+                c.on = conf.GetBoolDefault("OpenVanilla.Duels", false) && conf.GetBoolDefault("OpenVanilla.Duels.Pit", false);
+                std::istringstream in(conf.GetStringDefault("OpenVanilla.Duels.Pit.Center", ""));
+                float x, y, z;
+                if (in >> x >> y >> z)
+                {
+                    c.x = x;
+                    c.y = y;
+                    c.z = z;
+                }
+                c.radius = std::max(20.0f, std::min(150.0f, conf.GetFloatDefault("OpenVanilla.Duels.Pit.Radius", 70.0f)));
+                c.line = conf.GetBoolDefault("OpenVanilla.Duels.Pit.Line", true);
+                c.lineBreakMs = uint32(std::max(3, std::min(60, conf.GetIntDefault("OpenVanilla.Duels.Pit.Line.BreakSeconds", 8)))) * IN_MILLISECONDS;
+                c.crowd = uint32(std::max(0, std::min(40, conf.GetIntDefault("OpenVanilla.Duels.Pit.Crowd", 16))));
+                c.crowdEntry = uint32(conf.GetIntDefault("OpenVanilla.Duels.Pit.Crowd.Entry", 900120));
+                c.brawl = conf.GetBoolDefault("OpenVanilla.Duels.Pit.Brawl", true);
+                c.brawlEvery = uint32(std::max(10, std::min(24 * 60, conf.GetIntDefault("OpenVanilla.Duels.Pit.Brawl.EveryMinutes", 60))));
+                c.brawlMs = uint32(std::max(60, std::min(600, conf.GetIntDefault("OpenVanilla.Duels.Pit.Brawl.Seconds", 180)))) * IN_MILLISECONDS;
+                c.brawlMin = uint32(std::max(2, std::min(40, conf.GetIntDefault("OpenVanilla.Duels.Pit.Brawl.Min", 3))));
+                c.brawlPrize = uint32(std::max(0, conf.GetIntDefault("OpenVanilla.Duels.Pit.Brawl.Prize", 19160)));
+                c.challenge = conf.GetBoolDefault("OpenVanilla.Duels.Pit.Challenge", true);
+                c.challengeMax = uint32(std::max(1, std::min(10000, conf.GetIntDefault("OpenVanilla.Duels.Pit.Challenge.Max", 100))));
+                c.cup = conf.GetBoolDefault("OpenVanilla.Duels.Pit.Cup", true);
+                c.cupDay = std::max(0, std::min(6, conf.GetIntDefault("OpenVanilla.Duels.Pit.Cup.Day", 6)));
+                c.cupHour = std::max(0, std::min(23, conf.GetIntDefault("OpenVanilla.Duels.Pit.Cup.Hour", 19)));
+                c.cupSignupMin = uint32(std::max(5, std::min(24 * 60, conf.GetIntDefault("OpenVanilla.Duels.Pit.Cup.SignupMinutes", 60))));
+                c.cupMax = uint32(std::max(2, std::min(64, conf.GetIntDefault("OpenVanilla.Duels.Pit.Cup.Max", 32))));
+                c.rules = Clean(conf.GetStringDefault("OpenVanilla.Duels.Pit.Rules",
+                    "Health, mana and cooldowns reset before line and cup fights. Potions and consumables allowed."), 120);
+                if (c.brawlPrize && !sObjectMgr.GetItemPrototype(c.brawlPrize))
+                    c.brawlPrize = 0;
+                if (c.crowd)
+                    for (uint32 i = 0; i < 4; ++i)
+                        if (!sObjectMgr.GetCreatureTemplate(c.crowdEntry + i))
+                        {
+                            sLog.outError("Open Vanilla Duels pit: no creature %u for the crowd (realm/duels/duels_world.sql): no crowd", c.crowdEntry + i);
+                            c.crowd = 0;
+                            break;
+                        }
+                if (c.on)
+                    sLog.outString("Open Vanilla Duels pit: on at (%.1f, %.1f), line %s, crowd %u, brawl %s every %u min, challenges %s, cup %s (day %d, %02d:00 UTC)",
+                                   c.x, c.y, c.line ? "on" : "off", c.crowd, c.brawl ? "on" : "off", c.brawlEvery,
+                                   c.challenge ? "on" : "off", c.cup ? "on" : "off", c.cupDay, c.cupHour);
+                return c;
+            }();
+            return s;
