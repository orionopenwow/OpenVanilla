+            uint32 pct = boss->IsAlive() ? uint32(boss->GetHealthPercent() + 0.5f) : 0;
+            uint32 phase = OnyxiaPhase(boss->IsAlive(), boss->IsInCombat(), air, boss->GetHealthPercent(), run.bossWasAir);
+            if (pct == run.bossPct && phase == run.bossPhase)
+                return;
+            bool phaseChanged = phase != run.bossPhase;
+            run.bossPct = pct;
+            run.bossPhase = phase;
+            for (auto const& kv : run.members)
+                if (!kv.second.bot)
+                    Notice(kv.first, "bhp," + std::to_string(pct) + "," + std::to_string(phase));
+            if (phaseChanged && !run.test)
+                CharacterDatabase.PExecute("UPDATE bossfights_now SET phase = %u WHERE run = %u", phase, run.id);
+        }
