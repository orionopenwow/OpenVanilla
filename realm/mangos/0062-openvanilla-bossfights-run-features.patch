+        // A quick reset, this member: up, full, cooldowns ready, buffed again, back at the start.
+        void ResetMember(Player* p, Run& run, Member& m)
+        {
+            Settings const& c = Conf();
+            if (!p->IsAlive())
+            {
+                p->ResurrectPlayer(1.0f);
+                p->SpawnCorpseBones();
+            }
+            p->CombatStop(true);
+            p->RemoveAllCooldowns();
+            p->SetHealth(p->GetMaxHealth());
+            if (p->GetPowerType() == POWER_MANA)
+                p->SetPower(POWER_MANA, p->GetMaxPower(POWER_MANA));
+            else if (p->GetPowerType() == POWER_RAGE)
+                p->SetPower(POWER_RAGE, 0);
+            for (uint32 spell : c.worldBuffs)
+                if (!p->HasAura(spell))
+                    p->CastSpell(p, spell, TRIGGERED_OLD_TRIGGERED);
+            if (run.twist != TWIST_IRON_WILL)
+            {
+                for (auto const& it : c.consumables)
+                    GiveItem(p, it.first, it.second);
+                auto rc = c.raidConsumables.find(run.raid);
+                if (rc != c.raidConsumables.end())
+                    for (auto const& it : rc->second)
+                        GiveItem(p, it.first, it.second);
+            }
+            m.alive = true;
+            ToStartSpot(p);
+            ChatHandler(p).PSendSysMessage("|cffff8000[Boss Fights]|r Reset: back at the start, full and buffed. Wipes so far: %u.", run.wipes);
+        }
