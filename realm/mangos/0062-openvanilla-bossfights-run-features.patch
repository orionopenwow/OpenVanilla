+            return;
+        Map* map = victim->GetMap();
+        if (!map || !map->IsRaid())
+            return;
+        Player* from = healer->GetBeneficiaryPlayer();
+        if (!from)
+            return;
+        std::lock_guard<std::mutex> sg(g_scaleLock);
+        auto it = g_scale.find(map->GetInstanceId());
+        if (it == g_scale.end())
+            return;
+        it->second.tallies[from->GetGUIDLow()].healing += uint64(gain);
+    }
