+                for (auto& kv : run.members)
+                {
+                    kv.second.rc = (kv.second.bot || kv.first == guid) ? 1 : 0;   // bots and the leader say yes
+                    people += !kv.second.bot && !kv.second.left && !kv.second.spectator;
