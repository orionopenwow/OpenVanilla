+                auto it = g_scale.find(run.instanceId);
+                if (it != g_scale.end())
+                {
+                    it->second.fights.clear();              // the enrage and Short Fuse clocks start again
+                    it->second.whelps.clear();
+                }
+            }
+            run.bossWasAir = false;
+        }
