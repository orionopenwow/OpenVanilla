diff --git a/src/game/OpenVanilla/BossFightsNpcs.cpp b/src/game/OpenVanilla/BossFightsNpcs.cpp
new file mode 100644
index 0000000..0e39ebf
--- /dev/null
+++ b/src/game/OpenVanilla/BossFightsNpcs.cpp
@@ -0,0 +1,101 @@
+/*
+ * Open Vanilla — Boss Fights' NPCs in the Gurubashi hangout (GPLv2, as CMaNGOS), realm/mangos/0062:
+ *
+ *   npc_openvanilla_bf_hall    the Hall of Fame keeper: this week's fastest clear per raid and tier (players' runs,
+ *                              the stock kind; the week starts Monday 00:00 UTC)
+ *   npc_openvanilla_bf_hoard   the Hoard Keeper: tabards, pets and toys for Dragon Scales (cosmetic, soulbound,
+ *                              sell for nothing; never for money)
+ *
+ * realm/bossfights/bossfights_world.sql makes and spawns them. The lists come from BossFights.cpp.
+ */
+
+#include "AI/ScriptDevAI/include/sc_common.h"
+#include "Entities/Player.h"
+#include "Globals/ObjectMgr.h"
+#include "OpenVanilla/BossFights.h"
+
+#include <string>
+
+namespace
+{
+    std::string RaidTitle(std::string const& key)
+    {
+        if (key == "onyxia") return "Onyxia's Lair";
+        if (key == "mc") return "Molten Core";
+        if (key == "bwl") return "Blackwing Lair";
+        if (key == "zg") return "Zul'Gurub";
+        if (key == "aq20") return "Ruins of Ahn'Qiraj";
+        if (key == "aq40") return "Temple of Ahn'Qiraj";
+        if (key == "naxx") return "Naxxramas";
+        return key;
+    }
+}
+
+bool GossipHello_npc_openvanilla_bf_hall(Player* player, Creature* creature)
+{
+    std::vector<std::string> lines = BossFights::HallOfFame();
+    if (lines.empty())
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, "No clears this week yet. Be the first!", GOSSIP_SENDER_MAIN, GOSSIP_ACTION_INFO_DEF);
+    for (std::string const& l : lines)
+    {
+        // raid:tier:clock:leader[:bots]
+        std::vector<std::string> f;
+        size_t a = 0, b;
+        while ((b = l.find(':', a)) != std::string::npos)
+        {
+            f.push_back(l.substr(a, b - a));
+            a = b + 1;
+        }
+        f.push_back(l.substr(a));
+        if (f.size() < 4)
+            continue;
+        std::string text = RaidTitle(f[0]) + ", tier " + f[1] + ": " + f[2] + " by " + f[3] + "'s raid" + (f.size() > 4 ? " (with bots)" : "");
+        player->ADD_GOSSIP_ITEM(GOSSIP_ICON_BATTLE, text.c_str(), GOSSIP_SENDER_MAIN, GOSSIP_ACTION_INFO_DEF);
+    }
+    player->SEND_GOSSIP_MENU(player->GetGossipTextId(creature), creature->GetObjectGuid());
+    return true;
+}
+
+bool GossipSelect_npc_openvanilla_bf_hall(Player* player, Creature* /*creature*/, uint32 /*sender*/, uint32 /*action*/)
+{
+    player->CLOSE_GOSSIP_MENU();
+    return true;
+}
+
+bool GossipHello_npc_openvanilla_bf_hoard(Player* player, Creature* creature)
+{
+    uint32 scales = player->GetItemCount(BossFights::ScalesItem(), true);
+    std::string head = "You have " + std::to_string(scales) + " Dragon Scale" + (scales == 1 ? "" : "s") + ".";
+    player->ADD_GOSSIP_ITEM(GOSSIP_ICON_CHAT, head.c_str(), GOSSIP_SENDER_MAIN, GOSSIP_ACTION_INFO_DEF);
+    for (auto const& it : BossFights::ShopItems())
+        if (ItemPrototype const* proto = sObjectMgr.GetItemPrototype(it.first))
+        {
+            std::string text = std::string(proto->Name1) + " - " + std::to_string(it.second) + " scales";
+            player->ADD_GOSSIP_ITEM(GOSSIP_ICON_VENDOR, text.c_str(), GOSSIP_SENDER_MAIN + 1, it.first);
+        }
+    player->SEND_GOSSIP_MENU(player->GetGossipTextId(creature), creature->GetObjectGuid());
+    return true;
+}
+
+bool GossipSelect_npc_openvanilla_bf_hoard(Player* player, Creature* /*creature*/, uint32 sender, uint32 action)
+{
+    player->CLOSE_GOSSIP_MENU();
+    if (sender == GOSSIP_SENDER_MAIN + 1)
+        BossFights::ShopBuy(player, action);
+    return true;
+}
+
+void AddSC_openvanilla_bossfights_npcs()
+{
+    Script* s = new Script;
+    s->Name = "npc_openvanilla_bf_hall";
+    s->pGossipHello = &GossipHello_npc_openvanilla_bf_hall;
+    s->pGossipSelect = &GossipSelect_npc_openvanilla_bf_hall;
+    s->RegisterSelf();
+
+    s = new Script;
+    s->Name = "npc_openvanilla_bf_hoard";
+    s->pGossipHello = &GossipHello_npc_openvanilla_bf_hoard;
+    s->pGossipSelect = &GossipSelect_npc_openvanilla_bf_hoard;
+    s->RegisterSelf();
+}
diff --git a/src/game/OpenVanilla/BossFightsRunLogic.h b/src/game/OpenVanilla/BossFightsRunLogic.h
new file mode 100644
index 0000000..d4fcb86
--- /dev/null
+++ b/src/game/OpenVanilla/BossFightsRunLogic.h
@@ -0,0 +1,538 @@
+/*
+ * Open Vanilla — Boss Fights' run features, the pure rules (GPLv2, as CMaNGOS): run kinds (practice phases,
+ * hardcore, story), weekly twists and Raid Roulette, the quick reset after a wipe, the pull timer's ready check,
+ * the ghost split, the end screen's meters and death recap, feats, Dragon Scales and Dragon Eggs, the Dragon's
+ * Hoard, the Rally Horn and the Hall of Fame's week. No game objects, so realm/bossfights/tests/test_run.cpp runs
+ * them without a server. Used by BossFights.cpp (realm/mangos/0062-openvanilla-bossfights-run-features.patch).
+ */
+
+#ifndef OPENVANILLA_BOSSFIGHTS_RUN_LOGIC_H
+#define OPENVANILLA_BOSSFIGHTS_RUN_LOGIC_H
+
+#include "BossFightsLogic.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <deque>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace BossFights
+{
+    // ── run kinds: what a queue ticket asks for (tickets of different kinds never share a raid) ──
+    enum RunKind : uint8_t
+    {
+        KIND_NORMAL    = 0,     // the stock run: records, unlocks
+        KIND_PRACTICE2 = 1,     // practice: the boss starts at her phase 2 (Onyxia: 64%); no records, no unlocks
+        KIND_PRACTICE3 = 2,     // practice: the boss starts at her phase 3 (Onyxia: 39%); no records, no unlocks
+        KIND_HARDCORE  = 3,     // one death and you watch; its own board; unlocks as a normal clear
+        KIND_STORY     = 4,     // 1 to 5 people, bots for the rest, a softer raid; no records, no unlocks
+    };
+
+    inline char const* KindName(RunKind k)
+    {
+        switch (k)
+        {
+            case KIND_PRACTICE2: return "practice2";
+            case KIND_PRACTICE3: return "practice3";
+            case KIND_HARDCORE:  return "hardcore";
+            case KIND_STORY:     return "story";
+            default:             return "normal";
+        }
+    }
+
+    inline bool KindFrom(std::string const& w, RunKind& k)
+    {
+        if (w == "normal") { k = KIND_NORMAL; return true; }
+        if (w == "practice2" || w == "p2") { k = KIND_PRACTICE2; return true; }
+        if (w == "practice3" || w == "p3") { k = KIND_PRACTICE3; return true; }
+        if (w == "hardcore" || w == "hc") { k = KIND_HARDCORE; return true; }
+        if (w == "story") { k = KIND_STORY; return true; }
+        return false;
+    }
+
+    // bossfights_result.mode / bossfights_now.mode (the website and Herald read it): '' normal, 'practice', 'story',
+    // 'hardcore' (practice and story never rank; hardcore has its own board)
+    inline char const* KindMode(RunKind k)
+    {
+        switch (k)
+        {
+            case KIND_PRACTICE2: case KIND_PRACTICE3: return "practice";
+            case KIND_HARDCORE:  return "hardcore";
+            case KIND_STORY:     return "story";
+            default:             return "";
+        }
+    }
+
+    inline bool KindIsPractice(RunKind k) { return k == KIND_PRACTICE2 || k == KIND_PRACTICE3; }
+    // a clear opens the next tier and counts as the account's best
+    inline bool KindUnlocks(RunKind k) { return k == KIND_NORMAL || k == KIND_HARDCORE; }
+    // the board a clear ranks on: "players" (the main one), "hardcore", or none ("")
+    inline char const* KindBoard(RunKind k) { return k == KIND_NORMAL ? "players" : k == KIND_HARDCORE ? "hardcore" : ""; }
+    // rewards (scales, eggs, feats) for a clear of this kind: practice gives none, story a little
+    inline bool KindRewards(RunKind k) { return !KindIsPractice(k); }
+
+    // The boss's health at the pull of a practice run (percent of the most): 64 starts Onyxia's phase 2 at once,
+    // 39 her phase 3 (she lifts off and lands again at once: the stock script needs her phase 2 first).
+    inline float PracticeHealthPct(RunKind k) { return k == KIND_PRACTICE2 ? 64.0f : k == KIND_PRACTICE3 ? 39.0f : 100.0f; }
+
+    // The raid offers practice phases (only Onyxia's phases are known: 65% and 40%).
+    inline bool PracticeOffered(std::string const& raid) { return raid == "onyxia"; }
+
+    // A queue's words without the kind words: "q onyxia 2 hardcore" -> rest "onyxia 2", kind hardcore. More than
+    // one kind word -> false.
+    inline bool ExtractKind(std::string const& rest, std::string& out, RunKind& kind)
+    {
+        std::istringstream in(rest);
+        std::string w;
+        bool have = false;
+        out.clear();
+        kind = KIND_NORMAL;
+        while (in >> w)
+        {
+            RunKind k;
+            if (KindFrom(w, k))
+            {
+                if (have)
+                    return false;
+                have = true;
+                kind = k;
+                continue;
+            }
+            if (!out.empty())
+                out += ' ';
+            out += w;
+        }
+        return true;
+    }
+
+    // ── weekly twists: one extra rule a week on top of the tier's affixes ──
+    enum Twist : uint8_t
+    {
+        TWIST_NONE       = 0,
+        TWIST_BLOOD_MOON = 1,   // every hit 20% harder, both ways (the raid's creatures take and deal more)
+        TWIST_SHORT_FUSE = 2,   // the boss enrages at 6 minutes in one fight: +25%, then +25% every 30 s
+        TWIST_WHELP_SWARM = 3,  // Onyxia's whelps come two at a time
+        TWIST_IRON_WILL  = 4,   // no consumables on entering; the tier aura counts double in the run
+    };
+
+    inline char const* TwistName(Twist t)
+    {
+        switch (t)
+        {
+            case TWIST_BLOOD_MOON:  return "bloodmoon";
+            case TWIST_SHORT_FUSE:  return "shortfuse";
+            case TWIST_WHELP_SWARM: return "whelpswarm";
+            case TWIST_IRON_WILL:   return "ironwill";
+            default:                return "none";
+        }
+    }
+
+    inline char const* TwistTitle(Twist t)
+    {
+        switch (t)
+        {
+            case TWIST_BLOOD_MOON:  return "Blood Moon";
+            case TWIST_SHORT_FUSE:  return "Short Fuse";
+            case TWIST_WHELP_SWARM: return "Whelp Swarm";
+            case TWIST_IRON_WILL:   return "Iron Will";
+            default:                return "No twist";
+        }
+    }
+
+    inline char const* TwistLine(Twist t)
+    {
+        switch (t)
+        {
+            case TWIST_BLOOD_MOON:  return "Every hit lands 20% harder, both ways.";
+            case TWIST_SHORT_FUSE:  return "The boss enrages after 6 minutes.";
+            case TWIST_WHELP_SWARM: return "Whelps come two at a time.";
+            case TWIST_IRON_WILL:   return "No consumables; your tier aura counts double.";
+            default:                return "";
+        }
+    }
+
+    // "bloodmoon shortfuse whelpswarm ironwill" (spaces or commas) -> the rotation; unknown words are skipped.
+    inline std::vector<Twist> ParseTwists(std::string const& text)
+    {
+        std::vector<Twist> out;
+        std::string s = text;
+        std::replace(s.begin(), s.end(), ',', ' ');
+        std::istringstream in(s);
+        std::string w;
+        while (in >> w)
+        {
+            if (w == "bloodmoon") out.push_back(TWIST_BLOOD_MOON);
+            else if (w == "shortfuse") out.push_back(TWIST_SHORT_FUSE);
+            else if (w == "whelpswarm") out.push_back(TWIST_WHELP_SWARM);
+            else if (w == "ironwill") out.push_back(TWIST_IRON_WILL);
+            else if (w == "none") out.push_back(TWIST_NONE);
+        }
+        return out;
+    }
+
+    // Days since 1970-01-01 (UTC) of a time; Monday-based weeks: 1970-01-01 was a Thursday.
+    inline int64_t DayNumber(time_t t) { return int64_t(t) >= 0 ? int64_t(t) / 86400 : (int64_t(t) - 86399) / 86400; }
+
+    // The week's number since the first Monday of 1970 (1970-01-05): changes every Monday 00:00 UTC.
+    inline int64_t WeekNumber(time_t t) { int64_t d = DayNumber(t) - 4; return d >= 0 ? d / 7 : (d - 6) / 7; }
+
+    // Monday 00:00 UTC of the week of `t` (the Hall of Fame's week starts there).
+    inline time_t WeekStart(time_t t) { return time_t((WeekNumber(t) * 7 + 4) * 86400); }
+
+    // This week's twist: the rotation read by the week number (no rotation: none).
+    inline Twist WeeklyTwist(std::vector<Twist> const& rotation, time_t now)
+    {
+        if (rotation.empty())
+            return TWIST_NONE;
+        int64_t w = WeekNumber(now) % int64_t(rotation.size());
+        if (w < 0)
+            w += int64_t(rotation.size());
+        return rotation[size_t(w)];
+    }
+
+    // Damage factors of a twist. Taken by players from the raid's creatures, and a factor on those creatures'
+    // health (Blood Moon: they also take 20% more, as 1/1.2 of their health).
+    inline float TwistDamageTaken(Twist t) { return t == TWIST_BLOOD_MOON ? 1.2f : 1.0f; }
+    inline float TwistCreatureHealth(Twist t) { return t == TWIST_BLOOD_MOON ? 1.0f / 1.2f : 1.0f; }
+
+    // Short Fuse: the boss's extra damage after `combatMs` in one fight.
+    inline float ShortFuseFactor(uint32_t combatMs)
+    {
+        if (combatMs < 360000u)
+            return 1.0f;
+        uint32_t steps = std::min<uint32_t>(8u, 1u + (combatMs - 360000u) / 30000u);
+        return 1.0f + 0.25f * float(steps);
+    }
+
+    // Raid Roulette: one of `raids` and one twist from `rotation`, by a seed (the server passes a random number).
+    inline std::pair<size_t, Twist> RoulettePick(size_t raids, std::vector<Twist> const& rotation, uint32_t seed)
+    {
+        size_t r = raids ? size_t(seed % raids) : 0;
+        Twist t = TWIST_NONE;
+        if (!rotation.empty())
+            t = rotation[size_t((seed / 7u + 3u) % rotation.size())];
+        return { r, t };
+    }
+
+    // ── the quick reset after a wipe ──
+    // A wipe in a normal, practice or story run resets after `delaySec` (0: off): everyone up, full, buffed again,
+    // back at the start; the boss evades to full. A hardcore wipe ends the run instead.
+    inline bool WipeResets(RunKind k, uint32_t delaySec) { return delaySec > 0 && k != KIND_HARDCORE; }
+
+    // ── the pull timer: a ready check, then a countdown ──
+    // The ready check's outcome: 0 waiting, 1 everyone said yes (the countdown starts), -1 someone said no,
+    // -2 nobody answered in time (people who didn't answer are named).
+    inline int ReadyOutcome(uint32_t people, uint32_t yes, bool anyNo, uint32_t elapsedMs, uint32_t timeoutMs = 20000)
+    {
+        if (anyNo)
+            return -1;
+        if (people && yes >= people)
+            return 1;
+        if (elapsedMs >= timeoutMs)
+            return -2;
+        return 0;
+    }
+
+    // ── the ghost split: your best and the record, live ──
+    // "ghost,<my best ms>,<record ms>,<record holder>" (0: none yet; the holder without commas).
+    inline std::string GhostLine(uint32_t bestMs, uint32_t recordMs, std::string holder)
+    {
+        holder.erase(std::remove(holder.begin(), holder.end(), ','), holder.end());
+        if (holder.empty())
+            holder = "-";
+        return "ghost," + std::to_string(bestMs) + "," + std::to_string(recordMs) + "," + holder;
+    }
+
+    // Ahead (negative) or behind (positive) a ghost at the same point, in ms: the run's elapsed time against the
+    // ghost's (the ghost only knows its finish, so it is paced evenly by the boss's health lost so far).
+    inline int64_t GhostDelta(uint32_t elapsedMs, uint32_t ghostMs, float bossHealthPct)
+    {
+        if (!ghostMs)
+            return 0;
+        float done = std::max(0.0f, std::min(100.0f, 100.0f - bossHealthPct)) / 100.0f;
+        return int64_t(elapsedMs) - int64_t(float(ghostMs) * done);
+    }
+
+    // ── the end screen: meters and the death recap ──
+    struct Hit
+    {
+        std::string source;     // who hit (a creature's or player's name, or "the world")
+        std::string spell;      // what ("melee", a spell's name)
+        uint32_t amount = 0;
+        bool killing = false;   // the hit that killed
+    };
+
+    // A name safe for the addon's lines: no , ; | : (they split the lines), at most 32 characters.
+    inline std::string LineSafe(std::string const& s)
+    {
+        std::string o;
+        for (char c : s)
+            if (c != ',' && c != ';' && c != '|' && c != ':' && c != '\n' && c != '\r')
+                o += c;
+        if (o.size() > 32)
+            o.resize(32);
+        return o.empty() ? std::string("?") : o;
+    }
+
+    // The last hits a player took (oldest first), at most `keep`.
+    inline void PushHit(std::deque<Hit>& hits, Hit h, size_t keep = 5)
+    {
+        hits.push_back(std::move(h));
+        while (hits.size() > keep)
+            hits.pop_front();
+    }
+
+    // "recap,<killer>|<spell>|<amount>|<1 killing>;..." the last hits before a death, the killing blow last.
+    inline std::string RecapLine(std::vector<Hit> const& hits)
+    {
+        std::string s = "recap";
+        bool first = true;
+        for (Hit const& h : hits)
+        {
+            s += first ? "," : ";";
+            first = false;
+            s += LineSafe(h.source) + "|" + LineSafe(h.spell) + "|" + std::to_string(h.amount) + "|" + (h.killing ? "1" : "0");
+        }
+        if (first)
+            s += ",-";
+        return s;
+    }
+
+    struct MeterRow
+    {
+        std::string name;
+        uint32_t cls = 0;
+        std::string role;
+        uint64_t damage = 0, healing = 0;
+        uint32_t deaths = 0;
+        bool bot = false;
+    };
+
+    // "meters;<name>:<class>:<role>:<damage>:<healing>:<deaths>:<bot>;..." damage done first, most first.
+    inline std::string MetersLine(std::vector<MeterRow> rows)
+    {
+        std::stable_sort(rows.begin(), rows.end(), [](MeterRow const& a, MeterRow const& b) { return a.damage > b.damage; });
+        std::string s = "meters";
+        for (MeterRow const& r : rows)
+            s += ";" + LineSafe(r.name) + ":" + std::to_string(r.cls) + ":" + LineSafe(r.role) + ":" + std::to_string(r.damage) + ":" +
+                 std::to_string(r.healing) + ":" + std::to_string(r.deaths) + ":" + (r.bot ? "1" : "0");
+        return s;
+    }
+
+    // bossfights_result.stats: "name:damage:healing:deaths,..." the whole run (the website reads it).
+    inline std::string StatsColumn(std::vector<MeterRow> const& rows)
+    {
+        std::string s;
+        for (MeterRow const& r : rows)
+        {
+            if (!s.empty()) s += ',';
+            s += LineSafe(r.name) + ":" + std::to_string(r.damage) + ":" + std::to_string(r.healing) + ":" + std::to_string(r.deaths);
+        }
+        return s;
+    }
+
+    // Onyxia's Deep Breath, every direction (the feat "no Deep Breath hit" counts these).
+    inline bool IsDeepBreath(uint32_t spell)
+    {
+        switch (spell)
+        {
+            case 17086: case 18351: case 18564: case 18576: case 18584: case 18596: case 18609: case 18617: case 21131:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    // ── feats: small achievements of a clear ──
+    // Keys as bossfights_result.feats stores them (comma separated; the website and Herald read them).
+    enum Feat : uint32_t
+    {
+        FEAT_NODEATHS  = 1,     // nobody died
+        FEAT_UNDER3    = 2,     // under 3 minutes from the pull
+        FEAT_NOBREATH  = 4,     // Onyxia: nobody was hit by a Deep Breath
+        FEAT_BOTSONLY  = 8,     // one person, the rest bots
+        FEAT_FIRSTTRY  = 16,    // no wipe before the kill
+        FEAT_ROULETTE  = 32,    // a Raid Roulette clear
+        FEAT_HARDCORE  = 64,    // a hardcore clear
+        FEAT_LAST      = FEAT_HARDCORE,
+    };
+
+    inline char const* FeatKey(uint32_t bit)
+    {
+        switch (bit)
+        {
+            case FEAT_NODEATHS: return "nodeaths";
+            case FEAT_UNDER3:   return "under3";
+            case FEAT_NOBREATH: return "nobreath";
+            case FEAT_BOTSONLY: return "botsonly";
+            case FEAT_FIRSTTRY: return "firsttry";
+            case FEAT_ROULETTE: return "roulette";
+            case FEAT_HARDCORE: return "hardcore";
+            default:            return "";
+        }
+    }
+
+    // A feat's title in the window and chat.
+    inline char const* FeatTitle(uint32_t bit)
+    {
+        switch (bit)
+        {
+            case FEAT_NODEATHS: return "Untouchable";
+            case FEAT_UNDER3:   return "Swift as the Wind";
+            case FEAT_NOBREATH: return "Breath Dodger";
+            case FEAT_BOTSONLY: return "Commander";
+            case FEAT_FIRSTTRY: return "First Try";
+            case FEAT_ROULETTE: return "Daredevil";
+            case FEAT_HARDCORE: return "Ironclad";
+            default:            return "";
+        }
+    }
+
+    struct RunFacts
+    {
+        bool cleared = false;
+        RunKind kind = KIND_NORMAL;
+        bool roulette = false;
+        std::string raid;
+        uint32_t lengthMs = 0;
+        uint32_t deaths = 0;
+        uint32_t wipes = 0;
+        uint32_t breathHits = 0;
+        uint32_t people = 0, bots = 0;
+    };
+
+    inline uint32_t FeatsFor(RunFacts const& f)
+    {
+        if (!f.cleared || !KindRewards(f.kind))
+            return 0;
+        uint32_t m = 0;
+        if (f.deaths == 0) m |= FEAT_NODEATHS;
+        if (f.lengthMs > 0 && f.lengthMs < 180000u) m |= FEAT_UNDER3;
+        if (f.raid == "onyxia" && f.breathHits == 0) m |= FEAT_NOBREATH;
+        if (f.people == 1 && f.bots > 0) m |= FEAT_BOTSONLY;
+        if (f.wipes == 0) m |= FEAT_FIRSTTRY;
+        if (f.roulette) m |= FEAT_ROULETTE;
+        if (f.kind == KIND_HARDCORE) m |= FEAT_HARDCORE;
+        return m;
+    }
+
+    // "nodeaths,under3" (bossfights_result.feats; "" none). sep: ',' for the column, '+' for an addon line.
+    inline std::string FeatNames(uint32_t m, char sep = ',')
+    {
+        std::string s;
+        for (uint32_t b = 1; b <= FEAT_LAST; b <<= 1)
+            if (m & b)
+            {
+                if (!s.empty()) s += sep;
+                s += FeatKey(b);
+            }
+        return s;
+    }
+
+    inline uint32_t FeatCount(uint32_t m)
+    {
+        uint32_t n = 0;
+        for (uint32_t b = 1; b <= FEAT_LAST; b <<= 1)
+            n += (m & b) ? 1 : 0;
+        return n;
+    }
+
+    // ── bossfights_now.phase: Onyxia's phase for the website (0 not pulled, 1 ground, 2 air, 3 landed) ──
+    inline uint32_t OnyxiaPhase(bool alive, bool inCombat, bool flying, float healthPct, bool wasInAir)
+    {
+        if (!alive || !inCombat)
+            return 0;
+        if (flying)
+            return 2;
+        if (wasInAir && healthPct <= 41.0f)
+            return 3;
+        return 1;
+    }
+
+    // ── bot fill: someone for Onyxia's phase 3 fear ──
+    // A raid of bots needs a Fear Ward (a Dwarf Priest, Alliance) or a Tremor Totem (a Shaman, Horde). When the
+    // people bring none, one healer seat of the plan becomes that: the class (5 Priest, 7 Shaman) in `classes`, and
+    // the race asked for (3 Dwarf; 0 any) in `races`. Returns the seat changed, or -1 (no healer seat, or no need).
+    inline int FearSeat(std::vector<Role> const& plan, std::vector<uint8_t>& classes, std::vector<uint8_t>& races, bool alliance, bool peopleHaveOne)
+    {
+        races.assign(plan.size(), 0);
+        if (peopleHaveOne || classes.size() != plan.size())
+            return -1;
+        uint8_t want = alliance ? 5 : 7;
+        for (size_t i = 0; i < plan.size(); ++i)
+            if (plan[i] == ROLE_HEALER && classes[i] == want && (!alliance))
+                return -1;                              // a Shaman healer is in the plan already
+        for (size_t i = 0; i < plan.size(); ++i)
+            if (plan[i] == ROLE_HEALER)
+            {
+                classes[i] = want;
+                if (alliance)
+                    races[i] = 3;
+                return int(i);
+            }
+        return -1;
+    }
+
+    // ── rewards: cosmetic only, soulbound, never sold ──
+    // Dragon Scales for a clear: the tier's number, +2 on the account's first clear of that raid and tier,
+    // + the hoard's 1..5 (a roll the server makes), +1 a feat; a story clear gives 1 and no hoard.
+    inline uint32_t ScalesFor(RunKind kind, uint32_t tier, bool firstOfTier, uint32_t hoardRoll, uint32_t feats)
+    {
+        if (!KindRewards(kind))
+            return 0;
+        if (kind == KIND_STORY)
+            return 1;
+        uint32_t n = std::max<uint32_t>(1u, tier) + (firstOfTier ? 2u : 0u) + std::min<uint32_t>(5u, hoardRoll);
+        n += FeatCount(feats);
+        return n;
+    }
+
+    // A Dragon Egg on the account's first clear of a raid at a tier (normal or hardcore); five hatch a whelp.
+    inline bool EggFor(RunKind kind, bool firstOfTier) { return firstOfTier && KindUnlocks(kind); }
+    inline uint32_t EggsToHatch() { return 5; }
+
+    // The Dragon's Hoard: a cosmetic from the hoard list on a lucky roll (roll 0..99 under `chancePct`).
+    inline bool HoardDrops(uint32_t roll, uint32_t chancePct) { return roll % 100u < chancePct; }
+
+    // "item:price item:price ..." -> the shop's list (malformed pairs skipped; price at least 1).
+    inline std::vector<std::pair<uint32_t, uint32_t>> ParseShop(std::string const& text)
+    {
+        std::vector<std::pair<uint32_t, uint32_t>> out;
+        std::string s = text;
+        std::replace(s.begin(), s.end(), ',', ' ');
+        std::istringstream in(s);
+        std::string w;
+        while (in >> w)
+        {
+            size_t c = w.find(':');
+            if (c == std::string::npos)
+                continue;
+            uint32_t item = uint32_t(std::strtoul(w.substr(0, c).c_str(), nullptr, 10));
+            uint32_t price = uint32_t(std::strtoul(w.substr(c + 1).c_str(), nullptr, 10));
+            if (item && price)
+                out.emplace_back(item, price);
+        }
+        return out;
+    }
+
+    // ── the Rally Horn: once a minute a player ──
+    inline bool HornReady(uint32_t lastMs, uint32_t nowMs, uint32_t everyMs = 60000)
+    {
+        return !lastMs || nowMs - lastMs >= everyMs;
+    }
+
+    // "LFM Onyxia's Lair tier 2, 6 of 10: /bf to join"
+    inline std::string HornText(std::string const& raidName, uint32_t tier, uint32_t have, uint32_t size, RunKind kind)
+    {
+        std::string k = kind == KIND_NORMAL ? std::string() : std::string(" (") + KindName(kind) + ")";
+        return "LFM " + raidName + " tier " + std::to_string(tier) + k + ", " + std::to_string(have) + " of " + std::to_string(size) + ": /bf to join";
+    }
+}
+
+#endif
