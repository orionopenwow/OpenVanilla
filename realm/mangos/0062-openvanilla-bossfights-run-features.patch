+        // patch 0062: the board a run ranks on, as SQL: the same raid, tier and mode, players' or bots' runs
+        std::string BoardWhere(std::string const& raid, uint32 tier, RunKind kind, bool withBots, bool test)
+        {
+            return "raid = '" + raid + "' AND tier = " + std::to_string(tier) + " AND cleared = 1 AND length_ms > 0 AND mode = '" + KindMode(kind) +
+                   "' AND bots " + (withBots ? ">" : "=") + " 0 AND test = " + (test ? "1" : "0");
+        }
+
+        // The ghost split: each person's best and the record of this raid, tier and kind (players' runs, or
+        // bots' when the run has bots). World thread, at the pop.
+        void Ghosts(Run& run)                                   // g_lock held
+        {
+            if (!KindUnlocks(run.kind) && run.kind != KIND_STORY)
+                return;                                         // practice: no ghost
+            uint32 bots = 0;
+            for (auto const& kv : run.members)
+                bots += kv.second.bot;
+            std::string where = BoardWhere(run.raid, run.tier, run.kind, bots > 0, run.test);
+            if (auto q = CharacterDatabase.PQuery("SELECT length_ms, members FROM bossfights_result WHERE %s ORDER BY length_ms LIMIT 1", where.c_str()))
+            {
+                run.recordMs = q->Fetch()[0].GetUInt32();
+                std::string members = q->Fetch()[1].GetCppString();
+                run.recordName = members.substr(0, members.find(':'));
+            }
+            for (auto& kv : run.members)
+            {
+                if (kv.second.bot)
+                    continue;
+                std::string name = kv.second.name;
+                CharacterDatabase.escape_string(name);
+                if (auto q = CharacterDatabase.PQuery("SELECT MIN(length_ms) FROM bossfights_result WHERE raid = '%s' AND tier = %u AND cleared = 1 AND length_ms > 0 "
+                                                      "AND mode = '%s' AND test = %u AND (members LIKE '%s:%%' OR members LIKE '%%,%s:%%')",
+                                                      run.raid.c_str(), run.tier, KindMode(run.kind), run.test ? 1 : 0, name.c_str(), name.c_str()))
+                    kv.second.bestMs = q->Fetch()[0].GetUInt32();
+            }
+        }
