+        // ── patch 0062: the run's extras, the player's side (map thread) ──
+
+        // Iron Will: the tier aura counts double in the run (a second modifier the size of the first; at least 4%).
+        void ApplyRunAura(Player* p, Member& m, bool on)
+        {
+            float pct = 0.0f;
+            if (on)
+            {
+                Settings const& c = Conf();
+                pct = std::max(4.0f, StatBonusPct(BestClearedAny(p->GetSession()->GetAccountId()), c.bonusPerTier, c.bonusCap));
+            }
+            if (std::fabs(pct - m.ironAura) < 0.01f)
+                return;
+            for (int s = 0; s < MAX_STATS; ++s)
+            {
+                UnitMods mod = UnitMods(UNIT_MOD_STAT_START + s);
+                if (m.ironAura > 0.0f)
+                    p->HandleStatModifier(mod, TOTAL_PCT, m.ironAura, false);
+                if (pct > 0.0f)
+                    p->HandleStatModifier(mod, TOTAL_PCT, pct, true);
+            }
+            m.ironAura = pct;
+        }
+
+        // Out of a run: what the run's twist and kind changed comes back (g_lock held).
+        void LeaveRunExtras(Player* p, Member& m)
+        {
+            if (m.spectator)
+            {
+                m.spectator = false;
+                if (p->IsGameMaster())
+                    p->SetGameMaster(false);
+            }
+            if (m.ironTaken)
+            {
+                m.ironTaken = false;
+                for (auto const& it : Conf().consumables)
+                    GiveItem(p, it.first, it.second);
+            }
+            ApplyRunAura(p, m, false);
+        }
