+        void LookAtBoss(Player* p, Run& run)                    // g_lock held
+        {
+            if (run.clock - run.bossLookAt < 2 * IN_MILLISECONDS && run.bossLookAt)
+                return;
+            run.bossLookAt = std::max<uint32>(1, run.clock);
