+        // The run's boss on this map (Onyxia; found by its spawn once, then by its db guid). nullptr: none.
+        Creature* BossOf(Player* p, Run& run)                   // g_lock held
+        {
+            if (p->GetMapId() != 249)
+                return nullptr;
+            if (run.bossDb)
+                if (Creature* c = p->GetMap()->GetCreature(run.bossDb))
+                    if (c->IsInWorld())
+                        return c;
+            std::vector<std::pair<uint32, CreatureData>> spawns;
+            auto collect = [&](CreatureDataPair const& d)
+            {
+                if (d.second.id == NPC_ONYXIA_ENTRY && d.second.mapid == 249)
+                    spawns.emplace_back(d.first, d.second);
+                return false;
+            };
+            sObjectMgr.DoCreatureData(collect);
+            for (auto const& sp : spawns)
+            {
+                p->GetMap()->ForceLoadGrid(sp.second.posX, sp.second.posY);
+                if (Creature* c = p->GetMap()->GetCreature(sp.first))
+                    if (c->IsInWorld())
+                    {
+                        run.bossDb = sp.first;
+                        return c;
+                    }
+            }
+            return nullptr;
+        }
