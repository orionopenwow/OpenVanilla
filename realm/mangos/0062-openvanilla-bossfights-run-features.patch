+    void OnDamage(Unit* dealer, Unit* victim, uint32 amount, bool killing, SpellEntry const* spell)
+    {
+        if (!g_anyScale || !victim || !amount)
+            return;
+        Map* map = victim->GetMap();
+        if (!map || !map->IsRaid())
+            return;
+        Player* from = dealer ? dealer->GetBeneficiaryPlayer() : nullptr;
+        Player* to = victim->GetTypeId() == TYPEID_PLAYER ? static_cast<Player*>(victim) : nullptr;
+        if (!from && !to)
+            return;
+        std::lock_guard<std::mutex> sg(g_scaleLock);
+        auto it = g_scale.find(map->GetInstanceId());
+        if (it == g_scale.end())
+            return;
+        InstanceScale& sc = it->second;
+        if (from && victim->GetTypeId() == TYPEID_UNIT && !victim->IsPlayerControlled())
+        {
+            InstanceScale::Tally& t = sc.tallies[from->GetGUIDLow()];
+            t.damage += amount;
+        }
+        if (to)
+        {
+            InstanceScale::Tally& t = sc.tallies[to->GetGUIDLow()];
+            Hit h;
+            h.source = !dealer ? std::string("the world") : dealer->GetName();
+            h.spell = spell && spell->SpellName[0] && *spell->SpellName[0] ? spell->SpellName[0] : (dealer ? "melee" : "a fall");
+            h.amount = amount;
+            h.killing = killing;
+            PushHit(t.hits, h);
+            if (killing)
+            {
+                t.recap.assign(t.hits.begin(), t.hits.end());
+                t.hits.clear();
+            }
+            if (spell && IsDeepBreath(spell->Id))
+                ++sc.breathHits;
+        }
+    }
+
