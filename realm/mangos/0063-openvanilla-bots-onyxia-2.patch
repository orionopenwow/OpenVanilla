diff --git a/src/modules/PlayerBots/playerbot/strategy/generic/OnyxiaGeometry.h b/src/modules/PlayerBots/playerbot/strategy/generic/OnyxiaGeometry.h
index e4fe6ca..3d35a2f 100644
--- a/src/modules/PlayerBots/playerbot/strategy/generic/OnyxiaGeometry.h
+++ b/src/modules/PlayerBots/playerbot/strategy/generic/OnyxiaGeometry.h
@@ -149,5 +149,89 @@ namespace onyxia
         }
         return false;
     }
+
+    // Open Vanilla 0063 (round 2) ----------------------------------------------------------------------------
+
+    constexpr float SPREAD = 8.0f;                  // phase 2: Fireball splashes about 8 yards
+    constexpr float SPREAD_STEP = 9.0f;             // how far a bot steps away from its neighbours
+    constexpr float WHELP_MOUTH = 20.0f;            // an off-tank waits this far out from a tunnel's mouth (outside TUNNEL_KEEP)
+
+    // Phase 2: a step away from the neighbours closer than SPREAD (their positions in nx/ny, n of them), inside the
+    // floor, away from the egg tunnels and off the Deep Breath line from (ox, oy) through the middle. The step goes
+    // against the sum of the neighbours' pushes; on a tie, square to the line on the bot's own side. False: no
+    // neighbour too close, or no safe step (the bot stays).
+    inline bool SpreadPoint(float ox, float oy, float px, float py, float const* nx, float const* ny, int n, int tie, float& x, float& y)
+    {
+        float vx = 0.0f, vy = 0.0f;
+        int close = 0;
+        for (int i = 0; i < n; ++i)
+        {
+            float d = Dist(px, py, nx[i], ny[i]);
+            if (d >= SPREAD)
+                continue;
+            ++close;
+            if (d < 0.01f)
+                continue;                           // on top of each other: the tie decides
+            float w = (SPREAD - d) / SPREAD;
+            vx += (px - nx[i]) / d * w;
+            vy += (py - ny[i]) / d * w;
+        }
+        if (!close)
+            return false;
+        float len = std::sqrt(vx * vx + vy * vy);
+        if (len < 0.01f)
+        {
+            // square to the breath line, on the bot's own side
+            float dx = CENTER_X - ox, dy = CENTER_Y - oy;
+            float l = std::sqrt(dx * dx + dy * dy);
+            if (l < 0.001f)
+            {
+                dx = 1.0f;
+                dy = 0.0f;
+                l = 1.0f;
+            }
+            vx = -dy / l * (tie >= 0 ? 1.0f : -1.0f);
+            vy = dx / l * (tie >= 0 ? 1.0f : -1.0f);
+            len = 1.0f;
+        }
+        vx /= len;
+        vy /= len;
+        // the push itself, then turned 45 and 90 degrees either way when the floor, a tunnel or the line is in the way
+        float const turns[5] = { 0.0f, PI_F / 4.0f, -PI_F / 4.0f, PI_F / 2.0f, -PI_F / 2.0f };
+        for (int t = 0; t < 5; ++t)
+        {
+            float c = std::cos(turns[t]), s = std::sin(turns[t]);
+            float dx = vx * c - vy * s, dy = vx * s + vy * c;
+            x = px + dx * SPREAD_STEP;
+            y = py + dy * SPREAD_STEP;
+            if (Dist(x, y, CENTER_X, CENTER_Y) > FLOOR_RADIUS || NearTunnel(x, y) || InBreathLine(ox, oy, x, y))
+                continue;
+            return true;
+        }
+        return false;
+    }
+
+    // Phase 2: where an off-tank waits for whelps: WHELP_MOUTH yards from the tunnel nearer to (px, py), toward the
+    // middle of the room.
+    inline void WhelpWaitPoint(float px, float py, float& x, float& y)
+    {
+        bool a = Dist(px, py, TUNNEL_A_X, TUNNEL_A_Y) <= Dist(px, py, TUNNEL_B_X, TUNNEL_B_Y);
+        float tx = a ? TUNNEL_A_X : TUNNEL_B_X, ty = a ? TUNNEL_A_Y : TUNNEL_B_Y;
+        float dx = CENTER_X - tx, dy = CENTER_Y - ty;
+        float l = std::sqrt(dx * dx + dy * dy);
+        x = tx + dx / l * WHELP_MOUTH;
+        y = ty + dy / l * WHELP_MOUTH;
+    }
+
+    // Phase 3 begins with Bellowing Roar the moment she lands, then every 15-45 s (CMaNGOS boss_onyxia.cpp).
+    // Damage dealers hold this long after the landing, and until her target is a tank, so she starts on the tank.
+    constexpr unsigned LANDING_HOLD_MS = 5000;
+    constexpr unsigned LANDING_HOLD_MAX_MS = 10000;
+    inline bool HoldDamage(unsigned msSinceLanding, bool victimIsTank)
+    {
+        if (msSinceLanding >= LANDING_HOLD_MAX_MS)
+            return false;
+        return msSinceLanding < LANDING_HOLD_MS || !victimIsTank;
+    }
 }
 }
