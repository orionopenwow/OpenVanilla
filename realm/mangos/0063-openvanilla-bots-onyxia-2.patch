+// Open Vanilla 0063 (round 2) ------------------------------------------------------------------------------------
+
+bool OnyxiaWhelpsLooseTrigger::IsActive()
+{
+    if (!bot->IsAlive() || !PlayerbotAI::IsTank(bot) || bot->GetMapId() != onyxia::MAP_ONYXIAS_LAIR)
+        return false;
+    Creature* ony = onyxia::Find(bot);
+    if (!ony || ony->GetVictim() == bot)
+        return false;                               // her tank stays on her
+    Creature* w = onyxia::LooseWhelp(bot, 40.0f);
+    if (!w)
+        return false;
+    Unit* cur = AI_VALUE(Unit*, "current target");
+    return !(cur && cur->GetEntry() == onyxia::NPC_ONYXIAN_WHELP && cur->IsAlive() && cur->GetVictim() == bot);
+}
+
+bool OnyxiaWhelpWaitTrigger::IsActive()
+{
+    if (!bot->IsAlive() || !PlayerbotAI::IsTank(bot))
+        return false;
+    Creature* ony = onyxia::Find(bot);
+    if (!ony || !onyxia::Flying(ony))
+        return false;
+    if (!onyxia::Whelps(bot, 12.0f).empty())
+        return false;                               // busy with whelps already
+    float x, y;
+    onyxia::WhelpWaitPoint(bot->GetPositionX(), bot->GetPositionY(), x, y);
+    return onyxia::Dist(bot->GetPositionX(), bot->GetPositionY(), x, y) > 6.0f &&
+           !onyxia::InBreathLine(ony->GetPositionX(), ony->GetPositionY(), x, y);
+}
+
+bool OnyxiaSpreadTrigger::IsActive()
+{
+    if (!bot->IsAlive() || PlayerbotAI::IsTank(bot))
+        return false;                               // tanks gather whelps: they stand with them
+    Creature* ony = onyxia::Find(bot);
+    if (!ony || !onyxia::Flying(ony))
+        return false;
+    float xs[40], ys[40];
+    return onyxia::Neighbours(bot, onyxia::SPREAD, xs, ys, 40) > 0;
+}
+
+bool OnyxiaHoldDamageTrigger::IsActive()
+{
+    if (!bot->IsAlive() || PlayerbotAI::IsTank(bot) || PlayerbotAI::IsHeal(bot))
+        return false;
+    Creature* ony = onyxia::Find(bot);
+    if (!onyxia::OnGround(ony) || ony->GetHealthPercent() > onyxia::PHASE_3_PCT + 1.0f)
+        return false;
+    Unit* cur = AI_VALUE(Unit*, "current target");
+    if (cur != ony && bot->GetVictim() != ony)
+        return false;
+    return onyxia::HoldDamage(onyxia::MsSinceLanding(ony), onyxia::IsTankUnit(ony->GetVictim()));
+}
+
+bool OnyxiaRoarComingTrigger::IsActive()
+{
+    if (!bot->IsAlive() || bot->getClass() != CLASS_WARRIOR || ai->HasAura("berserker rage", bot))
+        return false;
+    Creature* ony = onyxia::Find(bot);
+    if (!onyxia::PhaseThree(ony) || ony->GetVictim() != bot)
+        return false;
+    if (!ai->HasSpell("berserker rage") || !AI_VALUE2(bool, "spell ready", "berserker rage"))
+        return false;
+    bool landing = onyxia::MsSinceLanding(ony) < 3000;
+    Spell* cast = ony->GetCurrentSpell(CURRENT_GENERIC_SPELL);
+    bool roaring = cast && cast->m_spellInfo && cast->m_spellInfo->Id == onyxia::SPELL_BELLOWING_ROAR;
+    return landing || roaring;
+}
