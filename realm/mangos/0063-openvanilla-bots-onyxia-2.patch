+
+    // Open Vanilla 0063 (round 2) ----------------------------------------------------------------------------
+
+    constexpr uint32 NPC_ONYXIAN_WHELP = 11262;
+    constexpr uint32 SPELL_BELLOWING_ROAR = 18431;
+
+    // When she landed: the bots see her flying, then on the ground. Keyed by her guid (one per raid copy); every
+    // bot of the copy reads and writes the same entry, under a lock (raid copies run on several map threads).
+    struct Landing { uint32 lastFlyingMs = 0; uint32 landedMs = 0; };
+    inline std::mutex& LandingLock() { static std::mutex m; return m; }
+    inline std::map<uint64, Landing>& Landings() { static std::map<uint64, Landing> l; return l; }
+
+    // Milliseconds since she landed for phase 3; a large number when she hasn't (or long ago).
+    inline uint32 MsSinceLanding(Creature* ony)
+    {
+        if (!ony)
+            return 0xFFFFFFFF;
+        uint32 now = WorldTimer::getMSTime();
+        std::lock_guard<std::mutex> guard(LandingLock());
+        std::map<uint64, Landing>& all = Landings();
+        if (all.size() > 64)
+            all.clear();                            // old raid copies: nothing to keep
+        Landing& l = all[ony->GetObjectGuid().GetRawValue()];
+        if (Flying(ony))
+        {
+            l.lastFlyingMs = now;
+            l.landedMs = 0;
+            return 0xFFFFFFFF;
+        }
+        if (!l.lastFlyingMs)
+            return 0xFFFFFFFF;                      // never seen flying: phase 1
+        if (!l.landedMs)
+            l.landedMs = now;
+        return WorldTimer::getMSTimeDiff(l.landedMs, now);
+    }
+
+    // Is this unit one of the raid's tanks (a player the bot AI calls a tank)?
+    inline bool IsTankUnit(Unit* u)
+    {
+        return u && u->GetTypeId() == TYPEID_PLAYER && PlayerbotAI::IsTank(static_cast<Player*>(u));
+    }
+
+    // Phase 2 and on: the whelps alive near the bot (within `range`), nearest first.
+    inline std::list<Creature*> Whelps(Player* bot, float range)
+    {
+        std::list<Unit*> units;
+        MaNGOS::AllCreaturesOfEntryInRangeCheck check(bot, NPC_ONYXIAN_WHELP, range);
+        MaNGOS::UnitListSearcher<MaNGOS::AllCreaturesOfEntryInRangeCheck> searcher(units, check);
+        Cell::VisitAllObjects(bot, searcher, range);
+        std::list<Creature*> out;
+        for (Unit* u : units)
+            if (u && u->IsAlive())
+                out.push_back(static_cast<Creature*>(u));
+        out.sort([bot](Creature* a, Creature* b) { return bot->GetDistance(a) < bot->GetDistance(b); });
+        return out;
+    }
+
+    // The nearest whelp hitting someone who isn't a tank (the off-tank's next pick), or nullptr.
+    inline Creature* LooseWhelp(Player* bot, float range)
+    {
+        for (Creature* w : Whelps(bot, range))
+        {
+            Unit* v = w->GetVictim();
+            if (v && v != bot && !IsTankUnit(v))
+                return w;
+        }
+        return nullptr;
+    }
+
+    // The bot's group mates (players, alive, in this map) within `range`: their positions, for spreading.
+    inline int Neighbours(Player* bot, float range, float* xs, float* ys, int max)
+    {
+        int n = 0;
+        Group* g = bot->GetGroup();
+        if (!g)
+            return 0;
+        for (GroupReference* r = g->GetFirstMember(); r && n < max; r = r->next())
+        {
+            Player* m = r->getSource();
+            if (!m || m == bot || !m->IsAlive() || !m->IsInWorld() || m->GetMap() != bot->GetMap())
+                continue;
+            if (bot->GetDistance2d(m->GetPositionX(), m->GetPositionY()) >= range)
+                continue;
+            xs[n] = m->GetPositionX();
+            ys[n] = m->GetPositionY();
+            ++n;
+        }
+        return n;
+    }
 }
 }
