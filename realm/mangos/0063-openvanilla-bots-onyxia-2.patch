+// Open Vanilla 0063 (round 2) ------------------------------------------------------------------------------------
+
+bool OnyxiaPickUpWhelpAction::Execute(Event& /*event*/)
+{
+    Creature* w = onyxia::LooseWhelp(bot, 40.0f);
+    if (!w)
+        return false;
+    SET_AI_VALUE(Unit*, "current target", w);
+    bot->SetSelectionGuid(w->GetObjectGuid());
+    // the class's taunt when it has one ready; the tank strategy's own attacks follow
+    if (bot->getClass() == CLASS_WARRIOR && ai->CanCastSpell("taunt", w, 0))
+        ai->CastSpell("taunt", w);
+    else if (bot->getClass() == CLASS_DRUID && ai->CanCastSpell("growl", w, 0))
+        ai->CastSpell("growl", w);
+    bot->Attack(w, !ai->IsRanged(bot));
+    return true;
+}
+
+bool MoveToOnyxiaWhelpWaitAction::Execute(Event& /*event*/)
+{
+    float x, y;
+    onyxia::WhelpWaitPoint(bot->GetPositionX(), bot->GetPositionY(), x, y);
+    float z = onyxia::FloorZ(bot, x, y);
+    return MoveTo(bot->GetMapId(), x, y, z, false, false, false, true);
+}
+
+bool OnyxiaSpreadAction::Execute(Event& /*event*/)
+{
+    Creature* ony = onyxia::Find(bot);
+    if (!ony || !onyxia::Flying(ony))
+        return false;
+    float xs[40], ys[40];
+    int n = onyxia::Neighbours(bot, onyxia::SPREAD, xs, ys, 40);
+    float x, y;
+    if (!onyxia::SpreadPoint(ony->GetPositionX(), ony->GetPositionY(), bot->GetPositionX(), bot->GetPositionY(), xs, ys, n,
+                             onyxia::DefaultSide(bot), x, y))
+        return false;
+    float z = onyxia::FloorZ(bot, x, y);
+    if (!bot->IsWithinLOS(x, y, z + bot->GetCollisionHeight()))
+        return false;
+    return MoveTo(bot->GetMapId(), x, y, z, false, false, false, true);
+}
+
+bool OnyxiaHoldDamageAction::Execute(Event& /*event*/)
+{
+    std::list<Creature*> whelps = onyxia::Whelps(bot, 30.0f);
+    if (!whelps.empty())
+    {
+        Creature* w = whelps.front();
+        SET_AI_VALUE(Unit*, "current target", w);
+        bot->SetSelectionGuid(w->GetObjectGuid());
+        bot->Attack(w, !ai->IsRanged(bot));
+        return true;
+    }
+    // nothing else to hit: stand down for the moment (the hold lasts 5 to 10 seconds)
+    SET_AI_VALUE(Unit*, "current target", nullptr);
+    bot->SetSelectionGuid(ObjectGuid());
+    ai->InterruptSpell();
+    bot->AttackStop();
+    return true;
+}
+
+bool OnyxiaBerserkerRageAction::Execute(Event& /*event*/)
+{
+    if (!ai->HasAura("berserker stance", bot))
+        return ai->CastSpell("berserker stance", bot);
+    return ai->CastSpell("berserker rage", bot);
+}
