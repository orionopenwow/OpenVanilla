+/*
+ * Open Vanilla — the World channel and the Discord bridge's server side (GPLv2, as CMaNGOS).
+ *
+ * "World" is an ordinary custom chat channel every player joins at login (both factions hear
+ * each other: lines go out in LANG_UNIVERSAL to the members of the Alliance and the Horde
+ * channel). Players talk in it like any channel ("/4 hi", the Chat addon's World tab, or the
+ * server command ".world <text>"). On top of the stock channel rules:
+ *
+ *   * one line per 2 s per player (GMs exempt); the stock mute (account mutetime) and the
+ *     anticheat silence apply as for every channel; the receiver's ignore list is honoured
+ *   * every line is appended to classiccharacters.openvanilla_world_log (a ring of 1,000 rows),
+ *     which Herald tails and posts to the linked Discord channel
+ *   * ".wnl worldoff" leaves World and stays out across logins, ".wnl worldon" comes back
+ *
+ * Staff / Herald (console or SOAP, SEC_GAMEMASTER):
+ *   .wnl worldsay <Name> <text>             a Discord line into World, shown as "[D] Name: text"
+ *   .wnl guildsay <guildId> <Name> <text>   a Discord line into one guild's chat
+ * Players:
+ *   .wnl guildlink <code>                   a guild master or officer confirms a Discord link
+ *                                           (Herald gave the code; table openvanilla_guild_link_code)
+ *
+ * Discord lines have no player behind them, so they travel as an addon line to clients that
+ * greeted (WD "<W|G>,<name>,<text>", see Wnl.h) and as a plain system line to the others.
+ * Switch: OpenVanilla.WorldChannel (default 1). Tables: realm/classicplus/pending/classicplus_world.sql.
+ */
+
+#ifndef OPENVANILLA_WORLD_H
+#define OPENVANILLA_WORLD_H
+
+#include "Common.h"
+
+#include <string>
+
+class Channel;
+class ChatHandler;
+class Player;
+
+namespace OwWorld
+{
+    char const* const CHANNEL = "World";
+
+    bool Enabled();
+    // CharacterHandler: end of HandlePlayerLogin (world thread). Joins World unless switched off.
+    void OnLogin(Player* player);
+    // Channel::Say, after the stock checks: true when this was World and it was handled here.
+    bool OnSay(Channel& channel, Player* player, char const* text, uint32 lang);
+    // Guild::BroadcastToGuild: logs the line when the guild is linked to a Discord channel.
+    void OnGuildChat(Player* player, uint32 guildId, std::string const& msg, uint32 lang);
+    // ".wnl <cmd> ..." from a player or the console: true when cmd was one of ours.
+    // access: the handler's GetAccessLevel() (the SOAP account's level on the console).
+    bool HandleCommand(ChatHandler& handler, uint32 access, char const* args);
+    // ".world <text>"
+    bool Say(ChatHandler& handler, char const* text);
+
+    // Pure helpers (unit-testable): Discord names and text made safe for the game.
+    std::string CleanName(std::string const& in);
+    std::string CleanText(std::string const& in, size_t max = 255);
+}
+
+#endif
