@@ -0,0 +1,35 @@
+/*
+ * Open Vanilla — the armory privacy setting (GPLv2, as CMaNGOS). See docs/ARMORY.md.
+ *
+ * The website's armory (tools/armory_export.py) publishes every character unless its player says
+ * otherwise. The Social addon's "Armory: Public / Friends only / Hidden" sends
+ *   .wnl armory                          ask: answers AR <mode>,<key>
+ *   .wnl armory public|friends|hidden    set: answers AR <mode>,<key>
+ *   .wnl armory newlink                  a new key (the old friends-only link stops working)
+ * and the answer is
+ *   AR <mode>,<key>      key: 20 characters a-z0-9 once friends-only was picked, else empty
+ *   AR err,<reason>      off (column missing: run classicplus_armory.sql), rate, bad
+ * The setting is classiccharacters.openvanilla_character.armory / armory_key; no row means public.
+ * Hooked from OwPlay::HandleCommand (OpenVanilla/Play.cpp), so it works with or without the other
+ * pending .wnl patches.
+ */
+#ifndef OPENVANILLA_ARMORY_H
+#define OPENVANILLA_ARMORY_H
+
+#include "Common.h"
+#include <string>
+
+class Player;
+
+namespace OwArmory
+{
+    // ".wnl armory <rest>" from a player; always handled (true).
+    bool HandleCommand(Player* player, std::string const& rest);
+
+    // For tests: is this a mode the column may hold?
+    bool ValidMode(std::string const& mode);
+    // A new 20-character key, a-z0-9.
+    std::string NewKey();
+}
+
+#endif
