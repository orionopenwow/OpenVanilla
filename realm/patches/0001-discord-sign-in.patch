--- /dev/null
+++ b/crates/wenilla-realm/src/auth/discord.rs
@@ -0,0 +1,282 @@
+//! Discord sign-in (Open Vanilla). The OAuth2 application is the same one the server's Discord bot
+//! runs as, which is what lets the bot add a player to the server with the player's own token.
+//!
+//! Environment (the provider is on when the first two are set):
+//!   DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET   the application's OAuth2 credentials
+//!   DISCORD_GUILD_ID          the Discord server players join on sign-in
+//!   DISCORD_BOT_TOKEN         the application's bot token: joins the player to the server,
+//!                             reads and grants roles
+//!   DISCORD_REQUIRE_ROLE_IDS  comma-separated role ids; when set, only members holding one of
+//!                             them may sign in (the invite waves: Alpha Tester, Player, staff)
+//!   DISCORD_GRANT_ROLE_ID     a role given on every successful sign-in (e.g. Player)
+//!   DISCORD_INVITE_URL        shown to players who are not let in yet
+//!   DISCORD_API_BASE          https://discord.com/api/v10 (tests point it at a mock)
+
+use anyhow::{anyhow, bail, Context, Result};
+use async_trait::async_trait;
+use serde::Deserialize;
+
+use super::provider::{Identity, IdentityProvider};
+
+/// The member is not (yet) allowed in: not in a wave, or the server could not be joined.
+#[derive(Debug)]
+pub struct NotAllowed {
+    pub message: String,
+}
+
+impl std::fmt::Display for NotAllowed {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for NotAllowed {}
+
+pub struct Discord {
+    client_id: String,
+    client_secret: String,
+    guild_id: Option<String>,
+    bot_token: Option<String>,
+    require_roles: Vec<String>,
+    grant_role: Option<String>,
+    invite_url: Option<String>,
+    api: String,
+    authorize: String,
+    http: reqwest::Client,
+}
+
+fn env(name: &str) -> Option<String> {
+    std::env::var(name).ok().map(|v| v.trim().to_string()).filter(|v| !v.is_empty())
+}
+
+fn snowflake(v: &str) -> bool {
+    (15..=22).contains(&v.len()) && v.bytes().all(|b| b.is_ascii_digit())
+}
+
+impl Discord {
+    /// `None` unless the OAuth2 client id and secret are configured.
+    pub fn from_env() -> Result<Option<Self>> {
+        let (Some(client_id), Some(client_secret)) =
+            (env("DISCORD_CLIENT_ID"), env("DISCORD_CLIENT_SECRET"))
+        else {
+            return Ok(None);
+        };
+        let guild_id = env("DISCORD_GUILD_ID");
+        let require_roles: Vec<String> = env("DISCORD_REQUIRE_ROLE_IDS")
+            .map(|v| v.split(',').map(|s| s.trim().to_string()).filter(|s| !s.is_empty()).collect())
+            .unwrap_or_default();
+        let grant_role = env("DISCORD_GRANT_ROLE_ID");
+        for id in [Some(&client_id), guild_id.as_ref(), grant_role.as_ref()]
+            .into_iter()
+            .flatten()
+            .chain(require_roles.iter())
+        {
+            if !snowflake(id) {
+                bail!("Discord ids must be 15-22 digits; got {id:?}");
+            }
+        }
+        let bot_token = env("DISCORD_BOT_TOKEN");
+        if (!require_roles.is_empty() || grant_role.is_some()) && (guild_id.is_none() || bot_token.is_none()) {
+            bail!("DISCORD_REQUIRE_ROLE_IDS / DISCORD_GRANT_ROLE_ID need DISCORD_GUILD_ID and DISCORD_BOT_TOKEN");
+        }
+        let api = env("DISCORD_API_BASE").unwrap_or_else(|| "https://discord.com/api/v10".into());
+        let authorize = env("DISCORD_AUTHORIZE_URL")
+            .unwrap_or_else(|| "https://discord.com/oauth2/authorize".into());
+        Ok(Some(Self {
+            client_id,
+            client_secret,
+            guild_id,
+            bot_token,
+            require_roles,
+            grant_role,
+            invite_url: env("DISCORD_INVITE_URL"),
+            api: api.trim_end_matches('/').to_string(),
+            authorize,
+            http: reqwest::Client::builder()
+                .timeout(std::time::Duration::from_secs(15))
+                .user_agent("wenilla-realm (Open Vanilla Discord sign-in)")
+                .build()?,
+        }))
+    }
+
+    fn joins_server(&self) -> bool {
+        self.guild_id.is_some() && self.bot_token.is_some()
+    }
+
+    fn not_allowed(&self, why: &str) -> anyhow::Error {
+        let tail = match &self.invite_url {
+            Some(u) => format!(" Join the Discord to get in line: {u}"),
+            None => String::new(),
+        };
+        NotAllowed { message: format!("{why}{tail}") }.into()
+    }
+
+    async fn bot(&self, method: reqwest::Method, path: &str) -> Result<reqwest::RequestBuilder> {
+        let token = self.bot_token.as_deref().context("no bot token")?;
+        Ok(self
+            .http
+            .request(method, format!("{}{path}", self.api))
+            .header("Authorization", format!("Bot {token}")))
+    }
+
+    /// Add the player to the server (no-op when already a member), check the wave roles and
+    /// grant the sign-in role.
+    async fn admit(&self, user_id: &str, access_token: &str) -> Result<()> {
+        let guild = self.guild_id.as_deref().context("no guild")?;
+        let join = self
+            .bot(reqwest::Method::PUT, &format!("/guilds/{guild}/members/{user_id}"))
+            .await?
+            .header("Content-Type", "application/json")
+            .body(serde_json::json!({ "access_token": access_token }).to_string())
+            .send()
+            .await?;
+        match join.status().as_u16() {
+            200 | 201 | 204 => {}
+            s => {
+                let body = join.text().await.unwrap_or_default();
+                tracing::warn!(status = s, body = %body.chars().take(300).collect::<String>(), "discord guild join");
+                // A failed join (bot missing permission, server full) must not lock out an
+                // existing member: fall through to the role check, which reads membership.
+            }
+        }
+        #[derive(Deserialize)]
+        struct Member {
+            roles: Vec<String>,
+        }
+        let resp = self
+            .bot(reqwest::Method::GET, &format!("/guilds/{guild}/members/{user_id}"))
+            .await?
+            .send()
+            .await?;
+        if resp.status().as_u16() == 404 {
+            return Err(self.not_allowed("Your Discord account isn't in the Open Vanilla server yet."));
+        }
+        let member: Member = json(resp.error_for_status()?).await?;
+        if !self.require_roles.is_empty() && !member.roles.iter().any(|r| self.require_roles.contains(r)) {
+            return Err(self.not_allowed(
+                "You're on the waitlist — we let players in by waves, and your invite hasn't come up yet. \
+                 You'll get a Discord DM when it does.",
+            ));
+        }
+        if let Some(role) = &self.grant_role {
+            if !member.roles.contains(role) {
+                let r = self
+                    .bot(reqwest::Method::PUT, &format!("/guilds/{guild}/members/{user_id}/roles/{role}"))
+                    .await?
+                    .header("X-Audit-Log-Reason", "Signed in to the realm")
+                    .send()
+                    .await?;
+                if !r.status().is_success() {
+                    tracing::warn!(status = r.status().as_u16(), "discord grant role");
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[async_trait]
+impl IdentityProvider for Discord {
+    fn id(&self) -> &str {
+        "discord"
+    }
+
+    fn label(&self) -> &str {
+        "Discord"
+    }
+
+    fn authorize_url(&self, state: &str, _pkce: Option<&str>, redirect_uri: &str) -> url::Url {
+        let scope = if self.joins_server() { "identify guilds.join" } else { "identify" };
+        let mut u = url::Url::parse(&self.authorize).expect("authorize URL");
+        u.query_pairs_mut()
+            .append_pair("client_id", &self.client_id)
+            .append_pair("response_type", "code")
+            .append_pair("redirect_uri", redirect_uri)
+            .append_pair("scope", scope)
+            .append_pair("state", state)
+            .append_pair("prompt", "none");
+        u
+    }
+
+    async fn callback(&self, code: &str, _pkce: Option<&str>, redirect_uri: &str) -> Result<Identity> {
+        #[derive(Deserialize)]
+        struct Token {
+            access_token: String,
+        }
+        let token: Token = json(self
+            .http
+            .post(format!("{}/oauth2/token", self.api))
+            .basic_auth(&self.client_id, Some(&self.client_secret))
+            .form(&[
+                ("grant_type", "authorization_code"),
+                ("code", code),
+                ("redirect_uri", redirect_uri),
+            ])
+            .send()
+            .await?
+            .error_for_status()
+            .map_err(|e| anyhow!("Discord refused the sign-in code: {e}"))?)
+            .await?;
+        #[derive(Deserialize)]
+        struct Me {
+            id: String,
+            username: String,
+            global_name: Option<String>,
+            email: Option<String>,
+        }
+        let me: Me = json(
+            self.http
+                .get(format!("{}/users/@me", self.api))
+                .bearer_auth(&token.access_token)
+                .send()
+                .await?
+                .error_for_status()?,
+        )
+        .await?;
+        if !snowflake(&me.id) {
+            bail!("Discord returned an unexpected user id");
+        }
+        if self.joins_server() {
+            self.admit(&me.id, &token.access_token).await?;
+        }
+        Ok(Identity {
+            provider: "discord".into(),
+            subject: me.id,
+            display_name: me.global_name.filter(|n| !n.trim().is_empty()).unwrap_or(me.username),
+            email: me.email,
+        })
+    }
+}
+
+/// reqwest is built without its `json` feature here; decode by hand.
+async fn json<T: serde::de::DeserializeOwned>(resp: reqwest::Response) -> Result<T> {
+    let text = resp.text().await?;
+    serde_json::from_str(&text).context("unexpected reply from Discord")
+}
+
+/// A realm username from a Discord name: the allowed characters only, 3–24 long.
+pub fn base_username(name: &str) -> String {
+    let mut s: String = name
+        .chars()
+        .filter(|c| c.is_ascii_alphanumeric() || *c == '_' || *c == '-')
+        .take(24)
+        .collect();
+    if s.len() < 3 {
+        s = format!("player{s}");
+    }
+    s
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn usernames_are_valid() {
+        assert_eq!(base_username("Thrall.Warchief!"), "ThrallWarchief");
+        assert_eq!(base_username("ö"), "player");
+        assert_eq!(base_username("a"), "playera");
+        assert_eq!(base_username(&"x".repeat(40)).len(), 24);
+        assert!(crate::auth::local::valid_username(&base_username("--")));
+    }
+}
