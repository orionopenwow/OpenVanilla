diff --git a/crates/wenilla-realm/src/auth/oauth.rs b/crates/wenilla-realm/src/auth/oauth.rs
new file mode 100644
index 0000000..b649ef2
--- /dev/null
+++ b/crates/wenilla-realm/src/auth/oauth.rs
@@ -0,0 +1,209 @@
+//! `/auth/{provider}/start` and `/auth/{provider}/callback` for every configured
+//! [`IdentityProvider`]: the CSRF `state` rides in a short-lived cookie scoped to `/auth`, the
+//! identity maps to a user through `identities`, and a first sign-in creates the user (a player,
+//! no local password) and their game account.
+
+use std::sync::Arc;
+
+use axum::extract::{Path, Query, State};
+use axum::http::HeaderMap;
+use axum::response::{IntoResponse, Redirect, Response};
+use axum::routing::get;
+use axum::Router;
+use axum_extra::extract::cookie::{Cookie, SameSite};
+use axum_extra::extract::CookieJar;
+use sqlx::SqlitePool;
+
+use super::provider::{Identity, IdentityProvider};
+use crate::db::now;
+use crate::secrets::{random_string, ALNUM};
+use crate::session::{self, client_ip};
+use crate::{accounts, audit, render, templates, AppError, AppState};
+
+const STATE_COOKIE: &str = "wr_oauth";
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/auth/{provider}/start", get(start))
+        .route("/auth/{provider}/callback", get(callback))
+}
+
+fn provider(state: &AppState, id: &str) -> Option<Arc<dyn IdentityProvider>> {
+    state.providers.iter().find(|p| p.id() == id).cloned()
+}
+
+fn redirect_uri(state: &AppState, id: &str) -> String {
+    format!("{}/auth/{id}/callback", state.cfg.public_url)
+}
+
+async fn start(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<String>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Response {
+    let Some(p) = provider(&state, &id) else {
+        return Redirect::to("/login").into_response();
+    };
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !state.limiter.allow(&format!("oauth:ip:{ip}"), 30, 900) {
+        return login_error(&state, "too many sign-in attempts — wait 15 minutes").await;
+    }
+    let nonce = random_string(ALNUM, 32);
+    let c = Cookie::build((STATE_COOKIE, format!("{id}.{nonce}")))
+        .path("/auth")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        .max_age(time::Duration::minutes(10))
+        .build();
+    let url = p.authorize_url(&nonce, None, &redirect_uri(&state, &id));
+    (jar.add(c), Redirect::to(url.as_str())).into_response()
+}
+
+#[derive(serde::Deserialize)]
+struct CallbackQuery {
+    code: Option<String>,
+    state: Option<String>,
+    error: Option<String>,
+}
+
+async fn callback(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<String>,
+    Query(q): Query<CallbackQuery>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Result<Response, AppError> {
+    let Some(p) = provider(&state, &id) else {
+        return Ok(Redirect::to("/login").into_response());
+    };
+    let expected = jar.get(STATE_COOKIE).map(|c| c.value().to_string());
+    let jar = jar.remove(Cookie::build((STATE_COOKIE, "")).path("/auth").build());
+    if q.error.is_some() {
+        return Ok((jar, login_error(&state, "sign-in was cancelled").await).into_response());
+    }
+    let (Some(code), Some(got)) = (q.code, q.state) else {
+        return Ok((jar, login_error(&state, "that sign-in link is incomplete — try again").await).into_response());
+    };
+    let ok_state = expected
+        .as_deref()
+        .and_then(|v| v.split_once('.'))
+        .is_some_and(|(pid, nonce)| {
+            pid == id && subtle::ConstantTimeEq::ct_eq(nonce.as_bytes(), got.as_bytes()).into()
+        });
+    if !ok_state {
+        return Ok((jar, login_error(&state, "that sign-in expired — try again").await).into_response());
+    }
+    let ip = client_ip(&headers);
+    let identity = match p.callback(&code, None, &redirect_uri(&state, &id)).await {
+        Ok(i) => i,
+        Err(e) => {
+            let msg = match e.downcast_ref::<super::discord::NotAllowed>() {
+                Some(na) => na.message.clone(),
+                None => {
+                    tracing::warn!(error = %e, provider = %id, "oauth callback");
+                    format!("{} sign-in failed — try again in a minute", p.label())
+                }
+            };
+            audit::log(&state.db, None, ip.as_deref(), "login.oauth_refused", Some(&id), Some(&msg)).await;
+            return Ok((jar, login_error(&state, &msg).await).into_response());
+        }
+    };
+    let user_id = match find_or_create(&state, &identity).await? {
+        Some(u) => u,
+        None => {
+            return Ok((jar, login_error(&state, "this account is disabled — ask an admin").await).into_response());
+        }
+    };
+    let token = session::create(
+        &state.db,
+        user_id,
+        ip.as_deref(),
+        headers.get("user-agent").and_then(|v| v.to_str().ok()),
+    )
+    .await?;
+    audit::log(&state.db, Some(user_id), ip.as_deref(), "login.ok", Some(&id), Some(&identity.subject)).await;
+    let role: (String,) = sqlx::query_as("SELECT role FROM users WHERE id = ?")
+        .bind(user_id)
+        .fetch_one(&state.db)
+        .await?;
+    let jar = jar.add(session::cookie(token, !state.cfg.cookie_insecure));
+    Ok((jar, Redirect::to(if role.0 == "admin" { "/admin" } else { "/" })).into_response())
+}
+
+/// The user behind an external identity, created on first sign-in. `None` when disabled.
+pub async fn find_or_create(state: &AppState, i: &Identity) -> anyhow::Result<Option<i64>> {
+    let existing: Option<(i64, i64)> = sqlx::query_as(
+        "SELECT u.id, u.disabled FROM identities i JOIN users u ON u.id = i.user_id WHERE i.provider = ? AND i.subject = ?",
+    )
+    .bind(&i.provider)
+    .bind(&i.subject)
+    .fetch_optional(&state.db)
+    .await?;
+    if let Some((uid, disabled)) = existing {
+        sqlx::query("UPDATE identities SET last_login = ?, display_name = ?, email = COALESCE(?, email) WHERE provider = ? AND subject = ?")
+            .bind(now())
+            .bind(&i.display_name)
+            .bind(&i.email)
+            .bind(&i.provider)
+            .bind(&i.subject)
+            .execute(&state.db)
+            .await?;
+        return Ok((disabled == 0).then_some(uid));
+    }
+    let username = free_username(&state.db, &super::discord::base_username(&i.display_name)).await?;
+    let display: String = i.display_name.chars().take(40).collect();
+    let mut tx = state.db.begin().await?;
+    let uid = sqlx::query("INSERT INTO users (username, display_name, role, created_at) VALUES (?, ?, 'player', ?)")
+        .bind(&username)
+        .bind(&display)
+        .bind(now())
+        .execute(&mut *tx)
+        .await?
+        .last_insert_rowid();
+    sqlx::query("INSERT INTO identities (user_id, provider, subject, display_name, email, created_at, last_login) VALUES (?, ?, ?, ?, ?, ?, ?)")
+        .bind(uid)
+        .bind(&i.provider)
+        .bind(&i.subject)
+        .bind(&display)
+        .bind(&i.email)
+        .bind(now())
+        .bind(now())
+        .execute(&mut *tx)
+        .await?;
+    tx.commit().await?;
+    audit::log(&state.db, None, None, "user.create", Some(&username), Some(&i.provider)).await;
+    if let Err(e) = accounts::provision(&state.db, &state.soap, &state.secrets, uid).await {
+        // `/api/play` provisions again on first play.
+        tracing::warn!(error = %e, user = %username, "game account provisioning deferred");
+    }
+    Ok(Some(uid))
+}
+
+async fn free_username(db: &SqlitePool, base: &str) -> anyhow::Result<String> {
+    for n in 0..1000 {
+        let candidate = if n == 0 { base.to_string() } else { format!("{base}-{n}") };
+        let taken: Option<(i64,)> = sqlx::query_as("SELECT id FROM users WHERE username = ?")
+            .bind(&candidate)
+            .fetch_optional(db)
+            .await?;
+        if taken.is_none() {
+            return Ok(candidate);
+        }
+    }
+    Ok(format!("{base}-{}", random_string(ALNUM, 6)))
+}
+
+async fn login_error(state: &AppState, msg: &str) -> Response {
+    render(templates::Login {
+        error: Some(msg.to_string()),
+        realm_name: state.realm_name().await,
+        providers: login_buttons(state),
+    })
+}
+
+/// (id, label) for the login page's sign-in buttons.
+pub fn login_buttons(state: &AppState) -> Vec<(String, String)> {
+    state.providers.iter().map(|p| (p.id().to_string(), p.label().to_string())).collect()
+}
