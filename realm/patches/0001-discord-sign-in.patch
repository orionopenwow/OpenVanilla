diff --git a/crates/wenilla-realm/src/templates.rs b/crates/wenilla-realm/src/templates.rs
index 9481690..5a54468 100644
--- a/crates/wenilla-realm/src/templates.rs
+++ b/crates/wenilla-realm/src/templates.rs
@@ -9,6 +9,8 @@ use crate::session::User;
 pub struct Login {
     pub error: Option<String>,
     pub realm_name: String,
