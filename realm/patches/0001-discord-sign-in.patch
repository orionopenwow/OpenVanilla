+#[tokio::test]
+async fn discord_sign_in_creates_a_player_joins_the_server_and_respects_waves() {
+    const WAVE: &str = "222222222222222222";
+    const PLAYER: &str = "333333333333333333";
+    let roles: Arc<Mutex<Vec<String>>> = Arc::new(Mutex::new(vec![WAVE.to_string()]));
+    let calls: Arc<Mutex<Vec<String>>> = Arc::default();
+    let api = mock_discord(Arc::clone(&roles), Arc::clone(&calls)).await;
+    std::env::set_var("DISCORD_CLIENT_ID", "111111111111111111");
+    std::env::set_var("DISCORD_CLIENT_SECRET", "s3cret");
+    std::env::set_var("DISCORD_GUILD_ID", "444444444444444444");
+    std::env::set_var("DISCORD_BOT_TOKEN", "bot-token");
+    std::env::set_var("DISCORD_REQUIRE_ROLE_IDS", WAVE);
+    std::env::set_var("DISCORD_GRANT_ROLE_ID", PLAYER);
+    std::env::set_var("DISCORD_INVITE_URL", "https://discord.gg/openvanilla");
+    std::env::set_var("DISCORD_API_BASE", &api);
+    let discord = wenilla_realm::auth::discord::Discord::from_env().unwrap().expect("configured");
+    let h = harness_with(vec![Arc::new(discord)]).await;
+    run_setup(&h).await;
+
+    // the login page offers the button
+    let r = send(&h.app, get("/login", None)).await;
+    assert!(r.body.contains("/auth/discord/start"), "{}", r.body);
+
+    // start: redirect to Discord with our client id, the join scope and a state cookie
+    let r = send(&h.app, get("/auth/discord/start", None)).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER);
+    let to = r.location().to_string();
+    assert!(to.starts_with("https://discord.com/oauth2/authorize?"), "{to}");
+    assert_eq!(query_param(&to, "client_id"), "111111111111111111");
+    assert_eq!(query_param(&to, "scope"), "identify guilds.join");
+    assert_eq!(query_param(&to, "redirect_uri"), "http://localhost:8090/auth/discord/callback");
+    let state = query_param(&to, "state");
+    let oauth_cookie = r.cookie().expect("state cookie");
+    assert!(oauth_cookie.starts_with("wr_oauth=discord."));
+
+    // a forged state is refused
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state=nope"), Some(&oauth_cookie))).await;
+    assert!(r.body.contains("expired"), "{}", r.body);
+    assert!(r.cookie().map_or(true, |c| !c.starts_with("wr_session=")));
+
+    // the real callback: player created, joined, granted the Player role, signed in
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), Some(&oauth_cookie))).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    assert_eq!(r.location(), "/");
+    let all_cookies: Vec<String> = r.headers.get_all(header::SET_COOKIE).iter().map(|v| v.to_str().unwrap().to_string()).collect();
+    let session = all_cookies.iter().find(|c| c.starts_with("wr_session=")).expect("session cookie").split(';').next().unwrap().to_string();
+    let (name, display): (String, String) = sqlx::query_as("SELECT u.username, u.display_name FROM users u JOIN identities i ON i.user_id = u.id WHERE i.provider = 'discord' AND i.subject = '123456789012345678'")
+        .fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(name, "ThrallWarchief");
+    assert_eq!(display, "Thrall Warchief");
+    {
+        let c = calls.lock().unwrap();
+        assert!(c.iter().any(|x| x.starts_with("join") && x.contains("AT123")), "{c:?}");
+        assert!(c.iter().any(|x| x == &format!("grant {PLAYER}")), "{c:?}");
+        assert!(c.iter().any(|x| x.contains("code=OK") && x.contains("grant_type=authorization_code")), "{c:?}");
+    }
+    assert!(h.soap_log.lock().unwrap().iter().any(|c| c.starts_with("account create WR")), "game account made");
+    // the session works for the game routes
+    let r = send(&h.app, Request::get("/api/play").header(header::COOKIE, &session).header("X-Requested-With", "wenilla").body(Body::empty()).unwrap()).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert!(r.body.contains("\"user\""), "{}", r.body);
+
+    // signing in again maps to the same user, no duplicate
+    let r = send(&h.app, get("/auth/discord/start", None)).await;
+    let (state2, c2) = (query_param(r.location(), "state"), r.cookie().unwrap());
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state2}"), Some(&c2))).await;
+    assert_eq!(r.location(), "/");
+    let n: (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE role = 'player'").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(n.0, 1);
+
+    // someone not in a wave is turned away with the invite link, and no user is made
+    roles.lock().unwrap().clear();
+    sqlx::query("DELETE FROM identities").execute(&h.state.db).await.unwrap();
+    sqlx::query("DELETE FROM users WHERE role = 'player'").execute(&h.state.db).await.unwrap();
+    let r = send(&h.app, get("/auth/discord/start", None)).await;
+    let (state3, c3) = (query_param(r.location(), "state"), r.cookie().unwrap());
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state3}"), Some(&c3))).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(r.body.contains("waitlist") && r.body.contains("https://discord.gg/openvanilla"), "{}", r.body);
+    let n: (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE role = 'player'").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(n.0, 0);
+
+    // Discord rejecting the code is a friendly error
+    roles.lock().unwrap().push(WAVE.into());
+    let r = send(&h.app, get("/auth/discord/start", None)).await;
+    let (state4, c4) = (query_param(r.location(), "state"), r.cookie().unwrap());
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=BAD&state={state4}"), Some(&c4))).await;
+    assert!(r.body.contains("sign-in failed"), "{}", r.body);
+}
