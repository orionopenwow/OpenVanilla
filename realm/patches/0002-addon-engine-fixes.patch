+            if model.input_language == language {
+                return;
+            }
+            model.input_language = language.to_string();
+            let handles: Vec<FrameHandle> = model
+                .scripts
+                .iter()
+                .filter(|(_, kinds)| kinds.contains("OnInputLanguageChanged"))
+                .map(|(h, _)| *h)
+                .collect();
+            let mut ids: Vec<u32> = handles.into_iter().map(|h| model.frame_id(h)).collect();
+            ids.sort_unstable(); // creation order, not the hash map's
+            ids
+        };
+        for id in ids {
+            fire_script(self.lua(), id, "OnInputLanguageChanged");
+        }
+    }
+}
