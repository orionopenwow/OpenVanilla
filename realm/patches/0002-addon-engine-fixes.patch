+/// G5: the stock chat edit box's `OnInputLanguageChanged` is accepted, because the host's
+/// input-language report fires it, and `GetInputLanguage` answers the reported language.
+#[test]
+fn on_input_language_changed_is_accepted_because_the_host_fires_it() {
+    let s = script();
+    s.run(
+        r#"
+        seen = {}
+        Box = CreateFrame("EditBox", "LangBox")
+        Box:SetScript("OnInputLanguageChanged", function()
+            table.insert(seen, this:GetInputLanguage())
+        end)
+    "#,
+    )
+    .unwrap();
+    assert_eq!(s.eval::<String>("return Box:GetInputLanguage()").unwrap(), "ROMAN");
+    s.set_input_language("ROMAN");
+    assert_eq!(s.eval::<i64>("return table.getn(seen)").unwrap(), 0, "no change, no fire");
+    s.set_input_language("IME");
+    assert_eq!(s.eval::<String>("return seen[1]").unwrap(), "IME", "…and it FIRED");
+}
