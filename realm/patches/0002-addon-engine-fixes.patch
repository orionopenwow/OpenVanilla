+/// G4: `UnitCanAssist` answers a friendly unit and not a hostile one; `UnitIsTrivial` answers a
+/// grey creature, never a player, and not a creature inside the green band.
+#[test]
+fn unit_can_assist_and_unit_is_trivial_answer_from_reaction_and_level() {
+    use crate::script::PlayerReqState;
+    let mut s = UiScript::new().unwrap();
+    s.set_unit("player", Some(UnitState { exists: true, is_player: true, level: 30, ..Default::default() }));
+    s.set_player_req_state(PlayerReqState { level: 30, ..Default::default() });
+    s.set_unit("target", Some(UnitState { exists: true, reaction: 5, level: 10, ..Default::default() }));
+    assert_eq!(s.eval::<Option<i64>>(r#"return UnitCanAssist("player", "target")"#).unwrap(), Some(1));
+    assert_eq!(s.eval::<Option<i64>>(r#"return UnitIsTrivial("target")"#).unwrap(), Some(1));
+    s.set_unit("target", Some(UnitState { exists: true, reaction: 2, level: 28, ..Default::default() }));
+    assert_eq!(s.eval::<Option<i64>>(r#"return UnitCanAssist("player", "target")"#).unwrap(), None);
+    assert_eq!(s.eval::<Option<i64>>(r#"return UnitIsTrivial("target")"#).unwrap(), None);
+    s.set_unit("target", Some(UnitState { exists: true, is_player: true, reaction: 5, level: 1, ..Default::default() }));
+    assert_eq!(s.eval::<Option<i64>>(r#"return UnitIsTrivial("target")"#).unwrap(), None);
