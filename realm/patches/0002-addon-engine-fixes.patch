+/// How often the web build writes the player's saved state while in the world.
+pub(crate) const WEB_AUTOSAVE_SECS: f64 = 30.0;
+
+/// Deviation (G3, the web build only): a page can close without a `/logout`, so the shutdown tail
+/// never runs and the session's saved variables, flat saved file and enable state would be lost.
+/// Every [`WEB_AUTOSAVE_SECS`] in the world the same writes run, without `PLAYER_LOGOUT` (an
+/// addon's last-chance handler still fires once, at a real logout). Native keeps the reference's
+/// no-autosave behaviour.
+pub(crate) fn web_autosave(world: &mut World) {
+    if !cfg!(target_arch = "wasm32") {
+        return;
+    }
+    autosave_tick(world, WEB_AUTOSAVE_SECS);
+}
+
+/// [`web_autosave`]'s body, target-independent so a native test drives it.
+pub(crate) fn autosave_tick(world: &mut World, every: f64) {
+    if world.contains_resource::<PendingEntryUiLoad>() {
+        return; // no in-game UI yet: writing now would replace the files with a boot VM's state
+    }
+    let now = world
+        .get_resource::<Time>()
+        .map(|t| t.elapsed_secs_f64())
+        .unwrap_or_default();
+    let due = {
+        let mut next = world.get_resource_or_insert_with(|| NextAutosave(now + every));
+        if now < next.0 {
+            false
+        } else {
+            next.0 = now + every;
+            true
+        }
+    };
+    if !due {
+        return;
+    }
+    let identity = world
+        .get_resource::<AddOnIdentity>()
+        .and_then(|id| id.0.clone());
+    if let Some(mut script) = world.get_non_send_resource_mut::<UiScript>() {
+        crate::ui_saved::save(&mut script);
+        addons::save_addon_variables(&mut script, identity.as_ref());
+        addons::save_enable_state(&script, identity.as_ref());
+    }
+}
+
+/// When [`autosave_tick`] next writes, in `Time::elapsed` seconds; reset per world session.
+#[derive(Resource)]
+pub(crate) struct NextAutosave(pub(crate) f64);
+
 /// `OnExit(InWorld)`, a `/logout` or a disconnect (two of the reference's five roots): run the
 /// shutdown tail, then end this session's Lua state, so no frame, global or addon upvalue reaches
 /// the next login. The reference's state outlives `0x490bd0` and is replaced twice through
@@ -781,6 +831,7 @@ pub(crate) fn shutdown_ui_state(
 pub(crate) fn end_ui_session(world: &mut World) {
     // A VM still parked (the load never ran) goes back into the world first.
     unpark_boot_vm(world);
+    world.remove_resource::<NextAutosave>();
     // An entry load still armed means no in-game UI was built, and the tail would overwrite the
     // saved files with the boot VM's emptiness.
     let ui_never_loaded = world.remove_resource::<PendingEntryUiLoad>().is_some();
