+/// G3: a host whose state is not a file system (the web build's page storage) seats its own
+/// reader, and `LoadAddOn` restores the saved variables through it before `ADDON_LOADED`.
+#[test]
+fn saved_variables_read_through_the_hosts_reader() {
+    let mut s = UiScript::new().unwrap();
+    s.set_addon_chain_reader(Box::new(|path| {
+        (path == "Interface/AddOns/Keeper/Keeper.lua").then(|| b"KeeperDB = { n = 0 }".to_vec())
+    }));
+    s.set_addon_saved_reader(Box::new(|path| {
+        if path == std::path::Path::new("/benilla-config/saved/Keeper.lua") {
+            Ok(b"KeeperDB = { n = 42 }".to_vec())
+        } else {
+            Err(std::io::Error::new(std::io::ErrorKind::NotFound, "none"))
+        }
+    }));
+    s.register_addons(
+        vec![AddOnInfo {
+            name: "Keeper".into(),
+            interface: 11200,
+            load_on_demand: true,
+            chain: true,
+            files: vec!["Keeper.lua".into()],
+            saved_variables: vec!["KeeperDB".into()],
+            enabled: true,
+            ..Default::default()
+        }],
+        None,
+        Some(std::path::PathBuf::from("/benilla-config/saved")),
+        None,
+    );
+    s.note_addon_info_reply(&[]);
+    s.run("LoadAddOn('Keeper')").unwrap();
+    assert_eq!(s.eval::<i64>("return KeeperDB.n").ok(), Some(42));
+    assert!(s.errors().is_empty(), "{:?}", s.errors());
+}
