+++ b/crates/wenilla-realm/src/auth/launcher.rs
@@ -0,0 +1,315 @@
+//! The desktop launcher's sign-in (Open Vanilla), the loopback flow desktop apps use for OAuth:
+//!
+//! 1. The launcher listens on `127.0.0.1:<port>` and opens the player's browser at
+//!    `/auth/launcher?port=<port>&state=<nonce>`.
+//! 2. Already signed in on this site → straight on. Otherwise → Discord (or the password form when
+//!    Discord is not configured); after that sign-in the browser comes back here.
+//! 3. `/auth/launcher/finish` mints a one-time code (2 minutes) and redirects the browser to
+//!    `http://127.0.0.1:<port>/openvanilla-signin?code=…&state=…`; the launcher checks the nonce.
+//! 4. The launcher trades the code at `POST /api/launcher/token` for the player's game account and a
+//!    launcher token; `GET /api/launcher/me` with that token answers whether it is still signed in
+//!    (and the credentials again); `POST /api/launcher/signout` forgets it.
+//!
+//! `?switch=1` signs the browser out first and asks Discord to show its account screen, so a
+//! player can change accounts.
+
+use std::sync::Arc;
+
+use axum::extract::{Query, State};
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Redirect, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use axum_extra::extract::cookie::{Cookie, SameSite};
+use axum_extra::extract::CookieJar;
+
+use crate::db::now;
+use crate::session::{self, client_ip};
+use crate::{accounts, audit, AppError, AppState};
+
+/// The pending launcher sign-in, `<port>.<state>`, carried across the Discord round trip.
+pub const PENDING_COOKIE: &str = "wr_launcher";
+const CODE_TTL_SECS: i64 = 120;
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/auth/launcher", get(begin))
+        .route("/auth/launcher/finish", get(finish))
+        .route("/api/launcher/token", post(token))
+        .route("/api/launcher/me", get(me))
+        .route("/api/launcher/signout", post(signout))
+}
+
+/// Where a browser sign-in goes next: on to the launcher when one is waiting, else `fallback`.
+pub fn after_sign_in<'a>(jar: &CookieJar, fallback: &'a str) -> &'a str {
+    if jar.get(PENDING_COOKIE).is_some() {
+        "/auth/launcher/finish"
+    } else {
+        fallback
+    }
+}
+
+#[derive(serde::Deserialize)]
+struct BeginQuery {
+    port: u16,
+    state: String,
+    switch: Option<String>,
+}
+
+fn valid_state(s: &str) -> bool {
+    (16..=64).contains(&s.len()) && s.bytes().all(|b| b.is_ascii_alphanumeric())
+}
+
+async fn begin(
+    State(state): State<Arc<AppState>>,
+    Query(q): Query<BeginQuery>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Result<Response, AppError> {
+    if q.port < 1024 || !valid_state(&q.state) {
+        return Err(AppError::BadRequest(
+            "that sign-in link is broken — press Sign in in the launcher again".into(),
+        ));
+    }
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !state.limiter.allow(&format!("launcher:begin:{ip}"), 30, 900) {
+        return Err(AppError::TooMany);
+    }
+    let pending = Cookie::build((PENDING_COOKIE, format!("{}.{}", q.port, q.state)))
+        .path("/")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        .max_age(time::Duration::minutes(10))
+        .build();
+    let mut jar = jar.add(pending);
+    let discord = state.providers.iter().any(|p| p.id() == "discord");
+
+    if q.switch.is_some() {
+        // Switching accounts: forget this browser's sign-in and let Discord show who is signing in.
+        if let Some(c) = jar.get(session::COOKIE) {
+            session::delete_by_token(&state.db, c.value()).await?;
+        }
+        jar = jar.remove(session::removal_cookie());
+        let to = if discord { "/auth/discord/start?prompt=consent" } else { "/login" };
+        return Ok((jar, Redirect::to(to)).into_response());
+    }
+
+    // Already signed in on this site: no second prompt at all.
+    if let Some(c) = jar.get(session::COOKIE) {
+        if let Ok(Some(s)) = session::lookup(&state.db, c.value()).await {
+            if !s.must_change_password {
+                let mut resp = (jar, Redirect::to("/auth/launcher/finish")).into_response();
+                set_fresh(&state, &mut resp, s.fresh_token);
+                return Ok(resp);
+            }
+        }
+    }
+    let to = if discord { "/auth/discord/start" } else { "/login" };
+    Ok((jar, Redirect::to(to)).into_response())
+}
+
+fn set_fresh(state: &AppState, resp: &mut Response, fresh: Option<String>) {
+    if let Some(token) = fresh {
+        let c = session::cookie(token, !state.cfg.cookie_insecure);
+        if let Ok(v) = HeaderValue::from_str(&c.to_string()) {
+            resp.headers_mut().append(header::SET_COOKIE, v);
+        }
+    }
+}
+
+async fn finish(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Result<Response, AppError> {
+    let Some((port, nonce)) = jar
+        .get(PENDING_COOKIE)
+        .and_then(|c| c.value().split_once('.').map(|(p, s)| (p.to_string(), s.to_string())))
+        .and_then(|(p, s)| Some((p.parse::<u16>().ok()?, s)))
+        .filter(|(p, s)| *p >= 1024 && valid_state(s))
+    else {
+        return Ok(Redirect::to("/").into_response());
+    };
+    let session = match jar.get(session::COOKIE) {
+        Some(c) => session::lookup(&state.db, c.value()).await?,
+        None => None,
+    };
+    let Some(session) = session else {
+        // Not signed in after all (the Discord step was cancelled): start over.
+        return Ok(Redirect::to(&format!("/auth/launcher?port={port}&state={nonce}")).into_response());
+    };
+    let code = session::new_token();
+    sqlx::query("DELETE FROM launcher_codes WHERE expires_at < ?")
+        .bind(now())
+        .execute(&state.db)
+        .await?;
+    sqlx::query("INSERT INTO launcher_codes (code_hash, user_id, expires_at) VALUES (?, ?, ?)")
+        .bind(session::hash(&code))
+        .bind(session.user.id)
+        .bind(now() + CODE_TTL_SECS)
+        .execute(&state.db)
+        .await?;
+    audit::log(
+        &state.db,
+        Some(session.user.id),
+        client_ip(&headers).as_deref(),
+        "launcher.code",
+        None,
+        None,
+    )
+    .await;
+    let jar = jar.remove(Cookie::build((PENDING_COOKIE, "")).path("/").build());
+    let to = format!("http://127.0.0.1:{port}/openvanilla-signin?code={code}&state={nonce}");
+    let mut resp = (jar, Redirect::to(&to)).into_response();
+    set_fresh(&state, &mut resp, session.fresh_token);
+    Ok(resp)
+}
+
+#[derive(serde::Deserialize)]
+struct TokenBody {
+    code: String,
+}
+
+/// What the launcher keeps: the game account it logs in with, and who that is.
+async fn credentials(state: &AppState, user_id: i64) -> Result<serde_json::Value, AppError> {
+    let (username, display_name): (String, Option<String>) =
+        sqlx::query_as("SELECT username, display_name FROM users WHERE id = ?")
+            .bind(user_id)
+            .fetch_one(&state.db)
+            .await?;
+    let acct = match accounts::get(&state.db, user_id).await? {
+        Some(a) => a,
+        None => accounts::provision(&state.db, &state.soap, &state.secrets, user_id).await?,
+    };
+    let pass = accounts::password(&state.secrets, &acct)?;
+    Ok(serde_json::json!({
+        "user": acct.game_username,
+        "pass": pass,
+        "host": state.cfg.public_host(),
+        "port": 3724,
+        "realm": state.realm_name().await,
+        "username": username,
+        "display_name": display_name.filter(|d| !d.trim().is_empty()).unwrap_or(username.clone()),
+    }))
+}
+
+fn no_store(mut resp: Response) -> Response {
+    resp.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    resp
+}
+
+async fn token(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(body): Json<TokenBody>,
+) -> Result<Response, AppError> {
+    let ip = client_ip(&headers);
+    if !state
+        .limiter
+        .allow(&format!("launcher:token:{}", ip.clone().unwrap_or_default()), 20, 900)
+    {
+        return Err(AppError::TooMany);
+    }
+    let row: Option<(i64, i64)> = sqlx::query_as(
+        "SELECT c.user_id, u.disabled FROM launcher_codes c JOIN users u ON u.id = c.user_id \
+         WHERE c.code_hash = ? AND c.expires_at >= ?",
+    )
+    .bind(session::hash(body.code.trim()))
+    .bind(now())
+    .fetch_optional(&state.db)
+    .await?;
+    // One use only, whatever happens next.
+    sqlx::query("DELETE FROM launcher_codes WHERE code_hash = ?")
+        .bind(session::hash(body.code.trim()))
+        .execute(&state.db)
+        .await?;
+    let Some((user_id, disabled)) = row else {
+        return Ok((
+            StatusCode::UNAUTHORIZED,
+            Json(serde_json::json!({ "message": "That sign-in expired. Press Sign in again." })),
+        )
+            .into_response());
+    };
+    if disabled != 0 {
+        return Ok((
+            StatusCode::FORBIDDEN,
+            Json(serde_json::json!({ "message": "This account is disabled — ask an admin." })),
+        )
+            .into_response());
+    }
+    let launcher_token = session::new_token();
+    let t = now();
+    sqlx::query(
+        "INSERT INTO launcher_tokens (token_hash, user_id, created_at, last_seen, user_agent) VALUES (?, ?, ?, ?, ?)",
+    )
+    .bind(session::hash(&launcher_token))
+    .bind(user_id)
+    .bind(t)
+    .bind(t)
+    .bind(
+        headers
+            .get(header::USER_AGENT)
+            .and_then(|v| v.to_str().ok())
+            .map(|u| u.chars().take(200).collect::<String>()),
+    )
+    .execute(&state.db)
+    .await?;
+    audit::log(&state.db, Some(user_id), ip.as_deref(), "launcher.signin", None, None).await;
+    let mut out = credentials(&state, user_id).await?;
+    out["token"] = serde_json::Value::String(launcher_token);
+    Ok(no_store((StatusCode::OK, Json(out)).into_response()))
+}
+
+fn bearer(headers: &HeaderMap) -> Option<String> {
+    headers
+        .get(header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.strip_prefix("Bearer "))
+        .map(|t| t.trim().to_string())
+        .filter(|t| !t.is_empty())
+}
+
+async fn me(State(state): State<Arc<AppState>>, headers: HeaderMap) -> Result<Response, AppError> {
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !state.limiter.allow(&format!("launcher:me:{ip}"), 120, 900) {
+        return Err(AppError::TooMany);
+    }
+    let signed_out = || {
+        (
+            StatusCode::UNAUTHORIZED,
+            Json(serde_json::json!({ "message": "Signed out — sign in again." })),
+        )
+            .into_response()
+    };
+    let Some(tok) = bearer(&headers) else {
+        return Ok(signed_out());
+    };
+    let row: Option<(i64, i64)> = sqlx::query_as(
+        "SELECT t.user_id, u.disabled FROM launcher_tokens t JOIN users u ON u.id = t.user_id WHERE t.token_hash = ?",
+    )
+    .bind(session::hash(&tok))
+    .fetch_optional(&state.db)
+    .await?;
+    let Some((user_id, 0)) = row else {
+        return Ok(signed_out());
+    };
+    sqlx::query("UPDATE launcher_tokens SET last_seen = ? WHERE token_hash = ?")
+        .bind(now())
+        .bind(session::hash(&tok))
+        .execute(&state.db)
+        .await?;
+    let out = credentials(&state, user_id).await?;
+    Ok(no_store((StatusCode::OK, Json(out)).into_response()))
+}
+
+async fn signout(State(state): State<Arc<AppState>>, headers: HeaderMap) -> Result<Response, AppError> {
+    if let Some(tok) = bearer(&headers) {
+        sqlx::query("DELETE FROM launcher_tokens WHERE token_hash = ?")
+            .bind(session::hash(&tok))
+            .execute(&state.db)
+            .await?;
+    }
+    Ok(StatusCode::NO_CONTENT.into_response())
+}
