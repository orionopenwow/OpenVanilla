+    assert_eq!(r.status, StatusCode::BAD_REQUEST);
+    let r = send(&h.app, get("/auth/launcher?port=50123&state=short", None)).await;
+    assert_eq!(r.status, StatusCode::BAD_REQUEST);
+
+    // 1. not signed in: straight to Discord, remembering the launcher
+    let r = send(&h.app, get(&format!("/auth/launcher?port=50123&state={nonce}"), None)).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER);
+    assert_eq!(r.location(), "/auth/discord/start");
+    let pending = r.cookie().expect("pending cookie");
+    assert_eq!(pending, format!("wr_launcher=50123.{nonce}"));
+
+    // 2. Discord round trip: the callback sends the browser on to the launcher, not the play page
+    let r = send(&h.app, get("/auth/discord/start", Some(&pending))).await;
+    let (dstate, oauth) = (query_param(r.location(), "state"), r.cookie().unwrap());
+    assert_eq!(query_param(r.location(), "prompt"), "none", "a returning player is not asked again");
+    let both = format!("{oauth}; {pending}");
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={dstate}"), Some(&both))).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    assert_eq!(r.location(), "/auth/launcher/finish");
+    let session = cookies_of(&r).into_iter().find(|c| c.starts_with("wr_session=")).expect("session");
+
+    // 3. finish: a one-time code back to the launcher's loopback port, with its own nonce
+    let r = send(&h.app, get("/auth/launcher/finish", Some(&format!("{session}; {pending}")))).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER);
+    let to = r.location().to_string();
+    assert!(to.starts_with("http://127.0.0.1:50123/openvanilla-signin?"), "{to}");
+    assert_eq!(query_param(&to, "state"), nonce);
+    let code = query_param(&to, "code");
+    assert!(cookies_of(&r).iter().any(|c| c == "wr_launcher="), "pending cookie cleared");
+
+    // 4. the code buys the game account and a launcher token, once
+    let r = send(&h.app, json_req("POST", "/api/launcher/token", None, &format!(r#"{{"code":"{code}"}}"#))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let v: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    assert!(v["user"].as_str().unwrap().starts_with("WR"), "{v}");
+    assert_eq!(v["pass"].as_str().unwrap().len(), 16);
+    assert_eq!(v["display_name"], "Thrall Warchief");
+    assert_eq!(v["host"], "localhost");
+    let tok = v["token"].as_str().unwrap().to_string();
+    let r = send(&h.app, json_req("POST", "/api/launcher/token", None, &format!(r#"{{"code":"{code}"}}"#))).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED, "a code works once");
+
+    // 5. the launcher can tell it is signed in, and gets the same account back
+    let r = send(&h.app, json_req("GET", "/api/launcher/me", Some(&tok), "")).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let me: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    assert_eq!(me["user"], v["user"]);
+    assert_eq!(me["pass"], v["pass"]);
+    let r = send(&h.app, json_req("GET", "/api/launcher/me", Some("not-a-token"), "")).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+    let r = send(&h.app, json_req("GET", "/api/launcher/me", None, "")).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+
+    // 6. already signed in on the site: no Discord prompt at all
+    let r = send(&h.app, get(&format!("/auth/launcher?port=50124&state={nonce}"), Some(&session))).await;
+    assert_eq!(r.location(), "/auth/launcher/finish");
+
+    // 7. switch account: the site signs out and Discord shows its account screen
+    let r = send(&h.app, get(&format!("/auth/launcher?port=50124&state={nonce}&switch=1"), Some(&session))).await;
+    assert_eq!(r.location(), "/auth/discord/start?prompt=consent");
+    assert!(cookies_of(&r).iter().any(|c| c == "wr_session="), "browser signed out");
+    let r = send(&h.app, get("/api/play", Some(&session))).await;
+    assert_ne!(r.status, StatusCode::OK, "the old browser session is gone");
+    let r = send(&h.app, get("/auth/discord/start?prompt=consent", None)).await;
+    assert_eq!(query_param(r.location(), "prompt"), "consent");
+
+    // 8. one game account per player, however many sign-ins
+    assert_eq!(creates(), before + 1, "{:?}", h.soap_log.lock().unwrap());
+
+    // 9. sign out from the launcher
+    let r = send(&h.app, json_req("POST", "/api/launcher/signout", Some(&tok), "")).await;
+    assert_eq!(r.status, StatusCode::NO_CONTENT);
+    let r = send(&h.app, json_req("GET", "/api/launcher/me", Some(&tok), "")).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+
+    // 10. a finish without a waiting launcher just goes to the play page
+    let r = send(&h.app, get("/auth/launcher/finish", None)).await;
+    assert_eq!(r.location(), "/");
+}
