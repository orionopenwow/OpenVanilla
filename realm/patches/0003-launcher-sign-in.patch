+-- OpenWoW: the desktop launcher's sign-in. A browser sign-in (Discord, or the password form)
+-- hands the launcher a one-time code over a loopback redirect; the launcher trades it for its
+-- game credentials and a long-lived launcher token it uses to check it is still signed in.
+CREATE TABLE launcher_codes (
+    code_hash BLOB PRIMARY KEY,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    expires_at INTEGER NOT NULL
+);
+CREATE TABLE launcher_tokens (
+    token_hash BLOB PRIMARY KEY,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    created_at INTEGER NOT NULL,
+    last_seen INTEGER NOT NULL,
+    user_agent TEXT
+);
+CREATE INDEX launcher_tokens_user ON launcher_tokens(user_id);
diff --git a/crates/wenilla-realm/src/auth/launcher.rs b/crates/wenilla-realm/src/auth/launcher.rs
