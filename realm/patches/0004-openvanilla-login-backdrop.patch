     // remembered name is typed over.
     let focus = form.focus;
     form.focus(focus);
-    preview.scene = Some(GlueScene::MainMenu);
+    // OpenVanilla: a page that paints its own backdrop behind the canvas (`login_backdrop: "page"` in
+    // `window.__wenilla_env`, `WOW_LOGIN_BACKDROP=page` natively) gets no UI_MainMenu scene, so
+    // the screen is transparent behind the login form.
+    let page_backdrop = crate::webenv::var("WOW_LOGIN_BACKDROP").as_deref() == Some("page");
+    preview.scene = (!page_backdrop).then_some(GlueScene::MainMenu);
     preview.look = None;
     preview.yaw = 0.0;
 }
