+    /// OpenVanilla: patch-Z's families revalidate; the rest of the chain stays immutable.
+    #[test]
+    fn patch_family_names_and_validators() {
+        use super::{etag_of, if_none_match_hits, patch_family};
+        assert!(patch_family(
+            "Interface\\AddOns\\WenillaCore\\WenillaCore.lua"
+        ));
+        assert!(patch_family("interface\\classicplus\\Magic.blp"));
+        assert!(patch_family("DBFilesClient\\Spell.dbc"));
+        assert!(!patch_family("Interface\\FrameXML\\UI.lua"));
+        assert!(!patch_family("World\\Maps\\Azeroth\\Azeroth_32_48.adt"));
+        let a = etag_of(b"one");
+        assert_eq!(a, etag_of(b"one"), "stable for the same bytes");
+        assert_ne!(a, etag_of(b"two"));
+        assert!(a.starts_with("W/\""));
+        let mut h = super::HeaderMap::new();
+        assert!(!if_none_match_hits(&h, &a));
+        h.insert(
+            super::header::IF_NONE_MATCH,
+            format!("\"x\", {a}").parse().unwrap(),
+        );
+        assert!(if_none_match_hits(&h, &a));
+        h.insert(
+            super::header::IF_NONE_MATCH,
+            a.trim_start_matches("W/").parse().unwrap(),
+        );
+        assert!(if_none_match_hits(&h, &a), "weak comparison");
+        h.insert(
+            super::header::IF_NONE_MATCH,
+            etag_of(b"two").parse().unwrap(),
+        );
+        assert!(!if_none_match_hits(&h, &a));
+    }
