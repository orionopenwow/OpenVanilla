+/// A weak validator for a body: its length and a 64-bit hash. Weak because the compression layer
+/// may re-encode the bytes; it names the content, not the encoding.
+fn etag_of(bytes: &[u8]) -> String {
+    use std::hash::{Hash, Hasher};
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    bytes.hash(&mut h);
+    format!("W/\"{:x}-{:016x}\"", bytes.len(), h.finish())
+}
