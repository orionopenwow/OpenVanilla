+        .flat_map(|v| v.split(','))
+        .map(str::trim)
+        // Weak comparison (RFC 9110 §8.8.3.2): `W/` is ignored on either side.
+        .any(|t| t == "*" || t.trim_start_matches("W/") == tag.trim_start_matches("W/"))
+}
