+    /// OpenVanilla: the settled share of every pipeline queued so far (1 with none), the loading
+    /// bar's last stretch while the warm pass holds the cover.
+    pub(crate) fn settled_fraction(&self) -> f32 {
+        let settled = self.0.settled.load(Ordering::Relaxed);
+        let created = self.0.created.load(Ordering::Relaxed);
+        if created == 0 {
+            1.0
+        } else {
+            (settled as f32 / created as f32).clamp(0.0, 1.0)
+        }
+    }
