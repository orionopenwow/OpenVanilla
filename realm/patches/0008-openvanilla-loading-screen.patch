+    let gpu = if world >= 1.0 {
+        gpu.clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    if !ui_stage {
+        return (OW_WORLD_SHARE + OW_UI_SHARE) * world + OW_GPU_SHARE * gpu;
+    }
+    OW_WORLD_SHARE * world + OW_UI_SHARE * ui.unwrap_or(0.0).clamp(0.0, 1.0) + OW_GPU_SHARE * gpu
+}
+
+/// OpenVanilla: one frame of the bar's ease toward `target`: exponential, monotonic (residency dips as
+/// the view turns) and capped below full.
+pub(crate) fn ow_smooth(displayed: f32, target: f32, dt: f32) -> f32 {
+    let target = target.min(OW_BAR_CAP);
+    if target <= displayed {
+        return displayed;
+    }
+    let k = 1.0 - (-OW_BAR_RATE * dt.max(0.0)).exp();
+    (displayed + (target - displayed) * k).min(OW_BAR_CAP)
+}
+
+/// OpenVanilla: turn art meant for additive blending (light on black) into straight alpha, so it can
+/// be drawn with ordinary alpha blending: alpha is the brightest channel and the colour is
+/// un-premultiplied by it. RGBA8.
+pub(crate) fn additive_to_alpha(rgba: &mut [u8]) {
+    for px in rgba.chunks_exact_mut(4) {
+        let a = px[0].max(px[1]).max(px[2]);
+        if a == 0 {
+            px.copy_from_slice(&[0, 0, 0, 0]);
+            continue;
+        }
+        for c in &mut px[..3] {
+            *c = ((u16::from(*c) * 255 + u16::from(a) / 2) / u16::from(a)).min(255) as u8;
+        }
+        px[3] = a;
+    }
 }
 
