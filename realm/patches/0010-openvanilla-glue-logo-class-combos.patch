+
+// ── OpenVanilla: the realm's race/class combinations ────────────────────────────────────────────────
+//
+// The stock screen lists only the classes the race may be (CharBaseInfo.dbc), so the slot under
+// the pointer changes meaning per race. Open Vanilla's grid is fixed, one slot per class, and a class
+// the race cannot be is greyed with a hover line saying so; picking that class anyway switches to
+// a race that can be it, and greys the races that cannot. Which combinations exist is the realm's
+// call, so the page hands them over (`ow/combos.json` → `class_combos` in `window.__wenilla_env`,
+// `WOW_CLASS_COMBOS` natively), in the compact form `race:class,class;race:class,…`. Without it
+// the client's own CharBaseInfo.dbc decides, as before.
+
+/// Every class, in grid order: Warrior, Paladin, Hunter, Rogue, Priest, Shaman, Mage, Warlock,
+/// Druid.
+pub(crate) const ALL_CLASSES: [u8; 9] = [1, 2, 3, 4, 5, 7, 8, 9, 11];
+
+/// The realm's allowed (race → classes), when the page provided them.
+#[derive(Resource, Default, Clone, Debug)]
+pub(crate) struct ClassCombos(Option<std::collections::HashMap<u8, Vec<u8>>>);
+
+impl ClassCombos {
+    fn from_env() -> Self {
+        let parsed = crate::webenv::var("WOW_CLASS_COMBOS").and_then(|s| Self::parse(&s));
+        match &parsed {
+            Some(m) => info!("char create: {} races' classes from the realm", m.len()),
+            None => info!("char create: classes from CharBaseInfo.dbc"),
+        }
+        Self(parsed)
+    }
+
+    /// `1:1,2,3;2:1,3` → {1: [1,2,3], 2: [1,3]}; `None` for an empty or malformed string, so a bad
+    /// value falls back to the DBC rather than locking every class.
+    pub(crate) fn parse(s: &str) -> Option<std::collections::HashMap<u8, Vec<u8>>> {
+        let mut out = std::collections::HashMap::new();
+        for part in s.split(';').map(str::trim).filter(|p| !p.is_empty()) {
+            let (race, classes) = part.split_once(':')?;
+            let race: u8 = race.trim().parse().ok()?;
+            let mut list = Vec::new();
+            for c in classes.split(',').map(str::trim).filter(|c| !c.is_empty()) {
+                list.push(c.parse::<u8>().ok()?);
+            }
+            list.sort_unstable();
+            list.dedup();
+            out.insert(race, list);
+        }
+        (!out.is_empty()).then_some(out)
+    }
+}
+
+/// May `race` be `class`? The realm's list when it gave one, else the client's DBC (else yes).
+pub(crate) fn allowed(
+    catalog: Option<&CharCreate>,
+    combos: Option<&ClassCombos>,
+    race: u8,
+    class: u8,
+) -> bool {
+    match combos.and_then(|c| c.0.as_ref()) {
+        Some(map) => map.get(&race).is_some_and(|l| l.contains(&class)),
+        None => match catalog {
+            Some(c) => c.0.allows(race, class),
+            None => true,
+        },
+    }
+}
+
+/// The first class (grid order) `race` may be.
+fn first_class(catalog: Option<&CharCreate>, combos: Option<&ClassCombos>, race: u8) -> u8 {
+    ALL_CLASSES
+        .into_iter()
+        .find(|&c| allowed(catalog, combos, race, c))
+        .unwrap_or(1)
+}
+
+/// A race that may be `class`: the first of `prefer`'s side, else of the other side.
+fn race_for_class(
+    catalog: Option<&CharCreate>,
+    combos: Option<&ClassCombos>,
+    class: u8,
+    prefer_alliance: bool,
+) -> Option<u8> {
+    let (first, second) = if prefer_alliance {
+        (ALLIANCE, HORDE)
+    } else {
+        (HORDE, ALLIANCE)
+    };
+    first
+        .into_iter()
+        .chain(second)
+        .find(|&r| allowed(catalog, combos, r, class))
+}
+
+/// Plural race names for the "can't be" lines.
+pub(crate) fn race_plural(race: u8) -> &'static str {
+    match race {
+        1 => "Humans",
+        2 => "Orcs",
+        3 => "Dwarves",
+        4 => "Night Elves",
+        5 => "Undead",
+        6 => "Tauren",
+        7 => "Gnomes",
+        8 => "Trolls",
+        _ => "They",
+    }
+}
+
+/// Plural class names for the "can't be" lines.
+pub(crate) fn class_plural(class: u8) -> &'static str {
+    match class {
+        1 => "Warriors",
+        2 => "Paladins",
+        3 => "Hunters",
+        4 => "Rogues",
+        5 => "Priests",
+        7 => "Shaman",
+        8 => "Mages",
+        9 => "Warlocks",
+        11 => "Druids",
+        _ => "that class",
+    }
+}
+
+/// "Night Elves can't be Paladins".
+pub(crate) fn cant_be(race: u8, class: u8) -> String {
+    format!("{} can't be {}", race_plural(race), class_plural(class))
 }
 
