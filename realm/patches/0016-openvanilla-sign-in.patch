+/// The Discord tests set process-wide env vars (the provider reads them), so they take turns.
+static DISCORD_ENV: Mutex<()> = Mutex::new(());
+
+/// A stand-in for Discord's API: one user, membership roles chosen per test.
+async fn mock_discord(roles: Arc<Mutex<Vec<String>>>, calls: Arc<Mutex<Vec<String>>>) -> String {
+    use axum::routing::{get as aget, post as apost, put as aput};
+    let c1 = Arc::clone(&calls);
+    let c2 = Arc::clone(&calls);
+    let c3 = Arc::clone(&calls);
+    let app = axum::Router::new()
+        .route("/oauth2/token", apost(move |body: String| {
+            let c = Arc::clone(&c1);
+            async move {
+                c.lock().unwrap().push(format!("token {body}"));
+                if body.contains("code=BAD") {
+                    return (StatusCode::BAD_REQUEST, "{}".to_string()).into_response();
+                }
+                (StatusCode::OK, r#"{"access_token":"AT123","token_type":"Bearer"}"#.to_string()).into_response()
+            }
+        }))
+        .route("/users/@me", aget(|| async {
+            r#"{"id":"123456789012345678","username":"thrall","global_name":"Thrall Warchief"}"#
+        }))
+        .route("/guilds/{g}/members/{u}", aput(move |body: String| {
+            let c = Arc::clone(&c2);
+            async move { c.lock().unwrap().push(format!("join {body}")); StatusCode::CREATED }
+        }).get(move || {
+            let r = Arc::clone(&roles);
+            async move { serde_json::json!({ "roles": *r.lock().unwrap() }).to_string() }
+        }))
+        .route("/guilds/{g}/members/{u}/roles/{r}", aput(move |axum::extract::Path((_g, _u, r)): axum::extract::Path<(String, String, String)>| {
+            let c = Arc::clone(&c3);
+            async move { c.lock().unwrap().push(format!("grant {r}")); StatusCode::NO_CONTENT }
+        }));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    url
+}
+
+fn query_param(url: &str, key: &str) -> String {
+    let u = url::Url::parse(url).unwrap();
+    u.query_pairs().find(|(k, _)| k == key).map(|(_, v)| v.to_string()).unwrap_or_default()
+}
+
+
+fn cookies_of(r: &Resp) -> Vec<String> {
+    r.headers
+        .get_all(header::SET_COOKIE)
+        .iter()
+        .map(|v| v.to_str().unwrap().split(';').next().unwrap().to_string())
+        .collect()
+}
+
+async fn setup_discord() -> (Harness, Arc<Mutex<Vec<String>>>) {
+    const WAVE: &str = "222222222222222222";
+    let roles: Arc<Mutex<Vec<String>>> = Arc::new(Mutex::new(vec![WAVE.to_string()]));
+    let calls: Arc<Mutex<Vec<String>>> = Arc::default();
+    let api = mock_discord(Arc::clone(&roles), Arc::clone(&calls)).await;
+    std::env::set_var("DISCORD_CLIENT_ID", "111111111111111111");
+    std::env::set_var("DISCORD_CLIENT_SECRET", "s3cret");
+    std::env::set_var("DISCORD_GUILD_ID", "444444444444444444");
+    std::env::set_var("DISCORD_BOT_TOKEN", "bot-token");
+    std::env::set_var("DISCORD_REQUIRE_ROLE_IDS", WAVE);
+    std::env::remove_var("DISCORD_GRANT_ROLE_ID");
+    std::env::set_var("DISCORD_INVITE_URL", "https://discord.gg/openvanilla");
+    std::env::set_var("DISCORD_API_BASE", &api);
+    let discord = wenilla_realm::auth::discord::Discord::from_env().unwrap().expect("configured");
+    let h = harness_with(vec![Arc::new(discord)]).await;
+    run_setup(&h).await;
+    (h, calls)
+}
+
+fn named(r: &Resp, name: &str) -> Option<String> {
+    cookies_of(r).into_iter().find(|c| c.starts_with(&format!("{name}=")))
+}
+
+fn direct_url(body: &str) -> String {
+    let i = body.find("data-direct=\"").expect("direct Discord link") + "data-direct=\"".len();
+    body[i..].split('"').next().unwrap().replace("&amp;", "&").replace("&#38;", "&")
+}
+
+/// Sign in through Discord from the login page; returns (session cookie, all cookies set).
+async fn sign_in(h: &Harness, cookie: Option<&str>) -> (String, Resp) {
+    let page = send(&h.app, get("/login", cookie)).await;
+    let state = query_param(&direct_url(&page.body), "state");
+    let oauth = named(&page, "wr_oauth").expect("state cookie");
+    let jar = match cookie { Some(c) => format!("{c}; {oauth}"), None => oauth };
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), Some(&jar))).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    (named(&r, "wr_session").expect("session"), r)
+}
