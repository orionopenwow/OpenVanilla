+#[tokio::test]
+async fn a_returning_player_is_greeted_by_name_and_can_forget_it() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let (_session, r) = sign_in(&h, None).await;
+    let seen = named(&r, "wr_seen").expect("name remembered");
+    let r = send(&h.app, get("/login", Some(&seen))).await;
+    assert!(r.body.contains("Welcome back") && r.body.contains("Continue as Thrall Warchief"), "{}", r.body);
+    assert!(r.body.contains(">T<"), "the initial in the avatar");
+    let r = send(&h.app, get("/login?forget=1", Some(&seen))).await;
+    assert!(r.body.contains("Sign in to play") && !r.body.contains("Continue as"));
+    assert!(named(&r, "wr_seen").is_some_and(|c| c == "wr_seen="));
+    // a tampered cookie is ignored
+    let r = send(&h.app, get("/login", Some("wr_seen=%%%"))).await;
+    assert!(r.body.contains("Sign in to play"));
+}
