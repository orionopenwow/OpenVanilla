+#[tokio::test]
+async fn game_requests_never_rotate_the_session_and_use_keeps_it_alive() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let (session, _) = sign_in(&h, None).await;
+    sqlx::query("UPDATE sessions SET rotated_at = 0, last_seen = 0, expires_at = strftime('%s','now') + 60")
+        .execute(&h.state.db).await.unwrap();
+    // the game's own request: no new token (its response may never reach the cookie jar)...
+    let r = send(&h.app, Request::get("/api/play").header(header::COOKIE, &session).header("X-Requested-With", "wenilla").body(Body::empty()).unwrap()).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert!(named(&r, "wr_session").is_none(), "no rotation on a game request");
+    // ...but the sign-in slides forward
+    let (exp,): (i64,) = sqlx::query_as("SELECT MAX(expires_at) FROM sessions").fetch_one(&h.state.db).await.unwrap();
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64;
+    assert!(exp > now + 59 * 86400, "slid to 60 days: {exp} vs {now}");
+    // a page load rotates, and the old token keeps working for a while (a sleeping phone tab)
+    let r = send(&h.app, get("/", Some(&session))).await;
+    assert_eq!(r.status, StatusCode::OK);
+    let fresh = named(&r, "wr_session").expect("rotated on a page load");
+    assert_ne!(fresh, session);
+    sqlx::query("UPDATE sessions SET previous_valid_until = strftime('%s','now') + 300").execute(&h.state.db).await.unwrap();
+    let r = send(&h.app, Request::get("/api/play").header(header::COOKIE, &session).header("X-Requested-With", "wenilla").body(Body::empty()).unwrap()).await;
+    assert_eq!(r.status, StatusCode::OK, "the previous token still works inside the grace window");
+}
