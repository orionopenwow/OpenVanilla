+#[tokio::test]
+async fn an_expired_sign_in_is_retried_once_silently() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let r = send(&h.app, get("/login", None)).await;
+    let state = query_param(&direct_url(&r.body), "state");
+    // the state cookie is gone (the page sat open for an hour): start again by itself
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), None)).await;
+    assert_eq!(r.location(), "/auth/discord/start?again=1");
+    let r = send(&h.app, get(r.location(), None)).await;
+    let again = query_param(r.location(), "state");
+    assert!(again.starts_with('r'));
+    let oauth = named(&r, "wr_oauth").unwrap();
+    // with its cookie it signs in
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={again}"), Some(&oauth))).await;
+    assert_eq!(r.location(), "/");
+    // without it a second time, it says so instead of looping
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={again}"), None)).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(r.body.contains("expired"));
+    // Discord's cancel is a friendly message on the themed page
+    let r = send(&h.app, get("/auth/discord/callback?error=access_denied", None)).await;
+    assert!(r.body.contains("cancelled") && r.body.contains("/brand/logo.webp"));
+}
