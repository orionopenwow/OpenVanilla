+    std::fs::write(conf_dir.join("aiplayerbot.conf"), "AiPlayerbot.Enabled = 1\nAiPlayerbot.MinRandomBots = 50\nAiPlayerbot.MaxRandomBots = 50\nAiPlayerbot.RandomBotAccountCount = 50\n").unwrap();
+    std::fs::write(
