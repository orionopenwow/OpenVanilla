+#[tokio::test]
+async fn the_login_page_is_openvanilla_and_its_discord_button_goes_straight_to_discord() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let r = send(&h.app, get("/login", None)).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(r.body.contains("/brand/logo.webp") && r.body.contains("Sign in to play"), "{}", r.body);
+    assert!(!r.body.contains("Wenilla Realm"));
+    assert!(r.body.contains("Test Realm"), "the realm's name is still shown");
+    assert!(r.body.contains("https://discord.gg/openvanilla"), "Discord invite in the footer");
+    assert_eq!(r.headers.get(header::CACHE_CONTROL).unwrap(), "no-store");
+    let url = direct_url(&r.body);
+    assert!(url.starts_with("https://discord.com/oauth2/authorize?"), "{url}");
+    assert_eq!(query_param(&url, "prompt"), "none");
+    let oauth = named(&r, "wr_oauth").unwrap();
+    assert_eq!(oauth, format!("wr_oauth=discord.{}", query_param(&url, "state")));
+    // a second tab reuses the nonce, so both buttons work
+    let r2 = send(&h.app, get("/login", Some(&oauth))).await;
+    assert_eq!(query_param(&direct_url(&r2.body), "state"), query_param(&url, "state"));
+    // the art is public and cached
+    for (f, kind) in [("logo.webp", "image/webp"), ("frame.png", "image/png"), ("manifest.webmanifest", "application/manifest+json")] {
+        let r = h.app.clone().oneshot(Request::get(format!("/brand/{f}")).body(Body::empty()).unwrap()).await.unwrap();
+        assert_eq!(r.status(), StatusCode::OK, "{f}");
+        assert_eq!(r.headers().get(header::CONTENT_TYPE).unwrap(), kind);
+    }
+    let r = h.app.clone().oneshot(Request::get("/brand/secrets.db").body(Body::empty()).unwrap()).await.unwrap();
+    assert_eq!(r.status(), StatusCode::NOT_FOUND);
+}
