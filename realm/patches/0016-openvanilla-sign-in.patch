+
+/// Where a finished sign-in goes: on to the launcher when one is waiting, else where the player
+/// was headed (`wr_next`), else `fallback`.
+pub fn landing(jar: &CookieJar, fallback: &str) -> String {
+    let launcher = super::launcher::after_sign_in(jar, "");
