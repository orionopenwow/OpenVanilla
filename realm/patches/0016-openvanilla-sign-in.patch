+// -- OpenVanilla: the sign-in page's state, the remembered name and the way back ---------------------
+
+/// Where to go after `next` was asked for (`/login?next=…`); 15 minutes to sign in.
+pub const NEXT_COOKIE: &str = "wr_next";
+/// The provider and display name this browser last signed in with, for "Continue as …".
+pub const SEEN_COOKIE: &str = "wr_seen";
+
+fn state_cookie<'a>(state: &AppState, id: &str, nonce: &str) -> Cookie<'a> {
+    Cookie::build((STATE_COOKIE, format!("{id}.{nonce}")))
+        .path("/auth")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        // long enough for a page left open, a slow handover to the Discord app and back
+        .max_age(time::Duration::minutes(30))
+        .build()
+}
+
+fn remember_cookie<'a>(state: &AppState, provider: &str, name: &str) -> Cookie<'a> {
+    let name: String = name.chars().filter(|c| !c.is_control()).take(40).collect();
+    let v = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(format!("{provider}\n{name}"));
+    Cookie::build((SEEN_COOKIE, v))
+        .path("/")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        .max_age(time::Duration::days(400))
+        .build()
+}
+
+/// (provider, display name) remembered on this browser.
+pub fn remembered(jar: &CookieJar) -> Option<(String, String)> {
+    let raw = base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(jar.get(SEEN_COOKIE)?.value()).ok()?;
+    let s = String::from_utf8(raw).ok()?;
+    let (p, n) = s.split_once('\n')?;
+    let n = n.trim();
+    (!n.is_empty() && n.chars().count() <= 40).then(|| (p.to_string(), n.to_string()))
+}
+
+pub fn forget(jar: CookieJar) -> CookieJar {
+    jar.remove(Cookie::build((SEEN_COOKIE, "")).path("/").build())
+}
+
+/// A same-site path to come back to: `/x?y`, never `//host`, `/\host` or a scheme.
+pub fn safe_next(next: &str) -> Option<String> {
+    let ok = next.starts_with('/')
+        && !next.starts_with("//")
+        && !next.starts_with("/\\")
+        && next.len() <= 512
+        && !next.chars().any(|c| c.is_control() || c == '\\')
+        && !next.starts_with("/login")
+        && !next.starts_with("/logout")
+        && !next.starts_with("/auth/");
