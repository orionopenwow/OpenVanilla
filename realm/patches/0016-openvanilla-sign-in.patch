+#[tokio::test]
+async fn signed_in_players_are_not_sent_to_discord_again_and_come_back_where_they_were() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, calls) = setup_discord().await;
+    // a page that needs a sign-in sends you to the login page, remembering where you were
+    let r = send(&h.app, get("/account/password?x=1", None)).await;
+    assert_eq!(r.location(), "/login?next=%2Faccount%2Fpassword%3Fx%3D1");
+    let r = send(&h.app, get(r.location(), None)).await;
+    let next = named(&r, "wr_next").expect("next remembered");
+    let (session, r) = sign_in(&h, Some(&next)).await;
+    assert_eq!(r.location(), "/account/password?x=1", "back to the page that asked");
+    assert!(named(&r, "wr_next").is_some_and(|c| c == "wr_next="), "cleared");
+    // off-site and loop targets are ignored
+    let r = send(&h.app, get("/login?next=%2F%2Fevil.example", None)).await;
+    assert!(named(&r, "wr_next").is_none());
+    let r = send(&h.app, get("/login?next=https%3A%2F%2Fevil.example", None)).await;
+    assert!(named(&r, "wr_next").is_none());
+    // signed in: Sign in with Discord goes straight to the game, no Discord round trip
+    let before = calls.lock().unwrap().len();
+    let r = send(&h.app, get("/auth/discord/start", Some(&session))).await;
+    assert_eq!(r.location(), "/");
+    assert!(named(&r, "wr_oauth").is_none());
+    let r = send(&h.app, get("/login", Some(&session))).await;
+    assert_eq!(r.location(), "/");
+    assert_eq!(calls.lock().unwrap().len(), before, "Discord was not asked");
+    // but "use another account" still reaches Discord's account screen
+    let r = send(&h.app, get("/auth/discord/start?prompt=consent", Some(&session))).await;
+    assert_eq!(query_param(r.location(), "prompt"), "consent");
+}
