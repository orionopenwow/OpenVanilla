+
+// -- OpenVanilla: guest accounts -------------------------------------------------------------------
+
+fn guest_count(h: &Harness) -> impl std::future::Future<Output = i64> + '_ {
+    async move {
+        let (n,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE guest = 1").fetch_one(&h.state.db).await.unwrap();
+        n
+    }
+}
+
+#[tokio::test]
+async fn a_guest_plays_without_signing_up_and_comes_back_on_the_same_device() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1"); // this harness has the Discord role gate on
+    let (h, _) = setup_discord().await;
+    let page = send(&h.app, get("/login", None)).await;
+    assert!(page.body.contains("action=\"/auth/guest\"") && page.body.contains("Play free as a guest"), "{}", page.body);
+
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    assert_eq!(r.location(), "/");
+    let sess = named(&r, "wr_session").expect("signed in");
+    let key = named(&r, "wr_guest").expect("device key");
+    assert_eq!(guest_count(&h).await, 1);
+    assert!(h.soap_log.lock().unwrap().iter().any(|c| c.starts_with("account create WR")), "game account made");
+
+    // the play page offers to keep the heroes by linking Discord, and has no password link
+    let play = send(&h.app, get("/", Some(&sess))).await;
+    assert_eq!(play.status, StatusCode::OK);
+    assert!(play.body.contains("link Discord") && play.body.contains("Guest "), "{}", play.body);
+    assert!(!play.body.contains("/account/password"));
+
+    // signed out, the same device is welcomed back and resumes the same guest
+    let page = send(&h.app, get("/login", Some(&key))).await;
+    assert!(page.body.contains("Welcome back") && page.body.contains("Continue as guest") && page.body.contains("<b>Guest "), "{}", page.body);
+    let r = send(&h.app, form("/auth/guest", Some(&key), &[])).await;
+    assert_eq!(r.location(), "/");
+    assert!(named(&r, "wr_session").is_some());
+    assert_eq!(guest_count(&h).await, 1, "no second guest for the same device");
+
+    // a made-up key is just a new visitor
+    let page = send(&h.app, get("/login", Some("wr_guest=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"))).await;
+    assert!(page.body.contains("Play free as a guest"));
+}
+
+#[tokio::test]
+async fn guest_accounts_are_rate_limited_and_can_be_turned_off() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1"); // this harness has the Discord role gate on
+    let (h, _) = setup_discord().await;
+    for _ in 0..20 {
+        let r = send(&h.app, form("/auth/guest", None, &[])).await;
+        assert_eq!(r.status, StatusCode::SEE_OTHER);
+    }
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(r.body.contains("Too many guest accounts"), "{}", r.body);
+    assert_eq!(guest_count(&h).await, 20);
+
+    std::env::set_var("OPENVANILLA_GUESTS", "0");
+    let page = send(&h.app, get("/login", None)).await;
+    assert!(!page.body.contains("/auth/guest"));
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert!(r.body.contains("Guest play is off"));
+    // unset + the Discord role gate on: off, so guests can't walk around the gate
+    std::env::remove_var("OPENVANILLA_GUESTS");
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert!(r.body.contains("Guest play is off"), "{}", r.body);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
+
+#[tokio::test]
+async fn guests_cannot_be_made_from_another_site() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    let (h, _) = setup_discord().await;
+    for (name, value) in [("sec-fetch-site", "cross-site"), ("origin", "https://evil.example")] {
+        let req = Request::post("/auth/guest")
+            .header(header::CONTENT_TYPE, "application/x-www-form-urlencoded")
+            .header(name, value)
+            .body(Body::empty())
+            .unwrap();
+        let r = send(&h.app, req).await;
+        assert!(named(&r, "wr_guest").is_none(), "{name}: no guest key from another site");
+        assert_ne!(r.status, StatusCode::SEE_OTHER, "{name}: refused, not signed in ({})", r.status);
+    }
+    assert_eq!(guest_count(&h).await, 0);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
+
+#[tokio::test]
+async fn linking_discord_keeps_the_guests_heroes() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1"); // this harness has the Discord role gate on
+    let (h, _) = setup_discord().await;
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    let sess = named(&r, "wr_session").unwrap();
+    let key = named(&r, "wr_guest").unwrap();
+    let (guest_id,): (i64,) = sqlx::query_as("SELECT id FROM users WHERE guest = 1").fetch_one(&h.state.db).await.unwrap();
+    let jar = format!("{sess}; {key}");
+
+    // a signed-in guest pressing Discord goes to Discord (it's a link, not a sign-in)
+    let r = send(&h.app, get("/auth/discord/start", Some(&jar))).await;
+    assert!(r.location().contains("/oauth2/authorize"), "{}", r.location());
+    let state = query_param(r.location(), "state");
+    let oauth = named(&r, "wr_oauth").unwrap();
+    let r = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), Some(&format!("{jar}; {oauth}")))).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    assert_eq!(r.location(), "/");
+    assert_eq!(named(&r, "wr_guest").as_deref(), Some("wr_guest="), "the device key is spent");
+
+    let (id, guest, name): (i64, i64, String) = sqlx::query_as(
+        "SELECT u.id, u.guest, u.display_name FROM identities i JOIN users u ON u.id = i.user_id WHERE i.provider = 'discord'",
+    )
+    .fetch_one(&h.state.db)
+    .await
+    .unwrap();
+    assert_eq!((id, guest, name.as_str()), (guest_id, 0, "Thrall Warchief"), "same user, same game account");
+    let (n,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM identities WHERE provider = 'guest'").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(n, 0);
+    // the old key no longer resumes anything
+    let page = send(&h.app, get("/login", Some(&key))).await;
+    assert!(!page.body.contains("Continue as guest"));
+}
