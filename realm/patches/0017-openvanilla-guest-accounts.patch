@@ -0,0 +1,344 @@
+//! OpenVanilla: free guest accounts — play without linking anything.
+//!
+//! `POST /auth/guest` makes a player with no Discord and no password. The only way back in is a
+//! key in an HttpOnly cookie (`wr_guest`, 400 days) on the device that made it; the key is kept
+//! here only as a hash, as an `identities` row with provider `guest`. Pressing "Play as guest"
+//! again on that device resumes the same guest (and its characters) instead of making another.
+//!
+//! A guest keeps everything by linking Discord: the OAuth callback (see `oauth::callback`) moves
+//! the Discord identity onto the guest's user, so the characters come along.
+//!
+//! Guards against farming: per-network limits (an hour and a day; IPv6 counted per /64), a
+//! realm-wide daily cap, no new guests from a network whose guest an admin disabled (ban
+//! evasion), same-site requests only, a limit on resuming, at most 10 sessions per guest, and
+//! idle guests are removed (with their game account) after `OPENVANILLA_GUEST_IDLE_DAYS`.
+//!
+//! Environment:
+//!   OPENVANILLA_GUESTS             1 offers "Play as guest", 0 turns it off. Unset: on, unless the
+//!                              Discord role gate (DISCORD_REQUIRE_ROLE_IDS) is set; a gated realm
+//!                              must opt in, or guests would walk around the gate
+//!   OPENVANILLA_GUEST_DAILY_MAX    guests the realm makes per day, all IPs (default 100000)
+//!   OPENVANILLA_GUEST_IDLE_DAYS    remove guests unused this long (default 30; 0 keeps them)
+
+use std::sync::Arc;
+
+use axum::extract::State;
+use axum::http::HeaderMap;
+use axum::response::{IntoResponse, Redirect, Response};
+use axum::routing::post;
+use axum::Router;
+use axum_extra::extract::cookie::{Cookie, SameSite};
+use axum_extra::extract::CookieJar;
+use sha2::{Digest, Sha256};
+use sqlx::SqlitePool;
+
+use crate::db::{self, now};
+use crate::secrets::{random_string, ALNUM};
+use crate::session::{self, client_ip};
+use crate::{accounts, audit, AppError, AppState};
+
+/// The device's guest key.
+pub const COOKIE: &str = "wr_guest";
+pub const PROVIDER: &str = "guest";
+const PER_IP_HOUR: u32 = 20;
+const PER_IP_DAY: i64 = 50;
+
+fn env(name: &str) -> Option<String> {
+    std::env::var(name).ok().map(|v| v.trim().to_string()).filter(|v| !v.is_empty())
+}
+
+fn env_num(name: &str, default: i64) -> i64 {
+    env(name).and_then(|v| v.parse().ok()).filter(|n: &i64| *n >= 0).unwrap_or(default)
+}
+
+pub fn enabled() -> bool {
+    match env("OPENVANILLA_GUESTS").as_deref() {
+        Some("0") => false,
+        Some(_) => true,
+        None => env("DISCORD_REQUIRE_ROLE_IDS").is_none(),
+    }
+}
+
+/// The network a request comes from, for limits: the address itself for IPv4, its /64 for IPv6
+/// (one home or phone gets a whole /64, so per-address limits would never bite).
+pub fn ip_bucket(ip: &str) -> String {
+    match ip.parse::<std::net::IpAddr>() {
+        Ok(std::net::IpAddr::V6(v6)) => {
+            if let Some(v4) = v6.to_ipv4_mapped() {
+                return v4.to_string();
+            }
+            let s = v6.segments();
+            format!("{:x}:{:x}:{:x}:{:x}::/64", s[0], s[1], s[2], s[3])
+        }
+        Ok(std::net::IpAddr::V4(v4)) => v4.to_string(),
+        Err(_) => ip.to_string(),
+    }
+}
+
+/// A form posted from this site, not from another one (no cross-site guest making: a page
+/// elsewhere could otherwise make a guest on a visitor's device and replace their guest key).
+fn same_site(headers: &HeaderMap) -> bool {
+    if let Some(s) = headers.get("sec-fetch-site").and_then(|v| v.to_str().ok()) {
+        return s == "same-origin" || s == "none";
+    }
+    match headers.get("origin").and_then(|v| v.to_str().ok()) {
+        None => true, // old browsers and tools: the SameSite=Lax cookies still guard them
+        Some(o) => {
+            let host = headers.get("host").and_then(|v| v.to_str().ok()).unwrap_or("");
+            !host.is_empty() && (o == format!("https://{host}") || o == format!("http://{host}"))
+        }
+    }
+}
+
+/// Keep a user's newest `keep` sessions, drop the rest.
+async fn prune_sessions(db: &SqlitePool, uid: i64, keep: i64) {
+    let _ = sqlx::query(
+        "DELETE FROM sessions WHERE user_id = ?1 AND id NOT IN          (SELECT id FROM sessions WHERE user_id = ?1 ORDER BY last_seen DESC, id DESC LIMIT ?2)",
+    )
+    .bind(uid)
+    .bind(keep)
+    .execute(db)
+    .await;
+}
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new().route("/auth/guest", post(play_as_guest))
+}
+
+fn key_hash(key: &str) -> String {
+    hex::encode(Sha256::digest(format!("openvanilla-guest\n{key}").as_bytes()))
+}
+
+fn key_cookie<'a>(state: &AppState, key: String) -> Cookie<'a> {
+    Cookie::build((COOKIE, key))
+        .path("/")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        .max_age(time::Duration::days(400))
+        .build()
+}
+
+pub fn forget(jar: CookieJar) -> CookieJar {
+    if jar.get(COOKIE).is_some() {
+        jar.remove(Cookie::build((COOKIE, "")).path("/").build())
+    } else {
+        jar
+    }
+}
+
+fn plausible_key(k: &str) -> bool {
+    k.len() == 40 && k.bytes().all(|b| b.is_ascii_alphanumeric())
+}
+
+/// The guest this device can resume: (user id, display name, disabled), when its key still works.
+pub async fn resumable(db: &SqlitePool, jar: &CookieJar) -> Option<(i64, String, bool)> {
+    let key = jar.get(COOKIE)?.value().to_string();
+    if !plausible_key(&key) {
+        return None;
+    }
+    let row: Option<(i64, String, i64)> = sqlx::query_as(
+        "SELECT u.id, u.display_name, u.disabled FROM identities i JOIN users u ON u.id = i.user_id \
+         WHERE i.provider = ? AND i.subject = ? AND u.guest = 1",
+    )
+    .bind(PROVIDER)
+    .bind(key_hash(&key))
+    .fetch_optional(db)
+    .await
+    .ok()?;
+    row.map(|(id, name, disabled)| (id, name, disabled != 0))
+}
+
+async fn play_as_guest(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Result<Response, AppError> {
+    // Already signed in (any account): straight on.
+    if let Some(c) = jar.get(session::COOKIE) {
+        if let Ok(Some(s)) = session::lookup(&state.db, c.value()).await {
+            let dest = super::oauth::landing(&jar, if s.user.is_admin() { "/admin" } else { "/" });
+            let jar = match s.fresh_token {
+                Some(t) => jar.add(session::cookie(t, !state.cfg.cookie_insecure)),
+                None => jar,
+            };
+            return Ok((super::oauth::clear_next(jar), Redirect::to(&dest)).into_response());
+        }
+    }
+    if !enabled() {
+        return Ok(super::oauth::login_error(&state, jar, "Guest play is off on this realm. Sign in with Discord instead.", false).await);
+    }
+    if !same_site(&headers) {
+        return Ok(super::oauth::login_error(&state, jar, "Open the realm's own page to play as a guest.", false).await);
+    }
+    let ip = client_ip(&headers);
+    let net = ip_bucket(ip.as_deref().unwrap_or(""));
+    let ua = headers.get("user-agent").and_then(|v| v.to_str().ok());
+
+    // This device's guest: resume it rather than make another.
+    if let Some((uid, _, disabled)) = resumable(&state.db, &jar).await {
+        if disabled {
+            return Ok(super::oauth::login_error(&state, jar, "This guest account is disabled. Ask an admin.", false).await);
+        }
+        if !state.limiter.allow(&format!("guest:resume:{uid}"), 20, 3600) || !state.limiter.allow(&format!("guest:resume-net:{net}"), 60, 3600) {
+            return Ok(super::oauth::login_error(&state, jar, "Too many sign-ins. Wait a few minutes and try again.", false).await);
+        }
+        sqlx::query("UPDATE identities SET last_login = ? WHERE user_id = ? AND provider = ?")
+            .bind(now())
+            .bind(uid)
+            .bind(PROVIDER)
+            .execute(&state.db)
+            .await?;
+        let token = session::create(&state.db, uid, ip.as_deref(), ua).await?;
+        prune_sessions(&state.db, uid, 10).await;
+        audit::log(&state.db, Some(uid), ip.as_deref(), "login.ok", Some(PROVIDER), None).await;
+        let jar = jar.add(session::cookie(token, !state.cfg.cookie_insecure));
+        let dest = super::oauth::landing(&jar, "/");
+        return Ok((super::oauth::clear_next(jar), Redirect::to(&dest)).into_response());
+    }
+
+    // A new guest. Limits first: per IP in memory (an hour) and on disk (a day), then the realm.
+    let ip_s = net.clone();
+    let day_ago = now() - 86_400;
+    if !state.limiter.allow(&format!("guest:ip:{ip_s}"), PER_IP_HOUR, 3600) {
+        return Ok(super::oauth::login_error(&state, jar, "Too many guest accounts from here. Wait an hour, or sign in with Discord.", false).await);
+    }
+    let (from_ip,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE guest = 1 AND created_ip = ? AND created_at > ?")
+        .bind(&ip_s)
+        .bind(day_ago)
+        .fetch_one(&state.db)
+        .await?;
+    let (today,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE guest = 1 AND created_at > ?")
+        .bind(day_ago)
+        .fetch_one(&state.db)
+        .await?;
+    // A guest from this network was disabled by an admin lately: no fresh guests from it (ban
+    // evasion by clearing cookies). Discord sign-in still works and goes through the usual checks.
+    let (banned,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM users WHERE guest = 1 AND disabled != 0 AND created_ip = ? AND created_at > ?")
+        .bind(&ip_s)
+        .bind(now() - 30 * 86_400)
+        .fetch_one(&state.db)
+        .await?;
+    if banned > 0 {
+        audit::log(&state.db, None, ip.as_deref(), "guest.refused", None, Some("disabled guest on this network")).await;
+        return Ok(super::oauth::login_error(&state, jar, "Guest play isn't available from here. Sign in with Discord instead.", false).await);
+    }
+    if from_ip >= PER_IP_DAY || today >= env_num("OPENVANILLA_GUEST_DAILY_MAX", 100000) {
+        audit::log(&state.db, None, ip.as_deref(), "guest.refused", None, Some(if from_ip >= PER_IP_DAY { "ip" } else { "daily cap" })).await;
+        return Ok(super::oauth::login_error(&state, jar, "No more guest accounts today. Sign in with Discord to play now.", false).await);
+    }
+    sweep(&state).await;
+
+    let key = random_string(ALNUM, 40);
+    let tag = random_string(b"23456789abcdefghjkmnpqrstuvwxyz", 8);
+    let username = format!("guest-{tag}");
+    let display = format!("Guest {}", tag.to_uppercase());
+    let mut tx = state.db.begin().await?;
+    let uid = sqlx::query("INSERT INTO users (username, display_name, role, created_at, guest, created_ip) VALUES (?, ?, 'player', ?, 1, ?)")
+        .bind(&username)
+        .bind(&display)
+        .bind(now())
+        .bind(&ip_s)
+        .execute(&mut *tx)
+        .await?
+        .last_insert_rowid();
+    sqlx::query("INSERT INTO identities (user_id, provider, subject, display_name, created_at, last_login) VALUES (?, ?, ?, ?, ?, ?)")
+        .bind(uid)
+        .bind(PROVIDER)
+        .bind(key_hash(&key))
+        .bind(&display)
+        .bind(now())
+        .bind(now())
+        .execute(&mut *tx)
+        .await?;
+    tx.commit().await?;
+    audit::log(&state.db, None, ip.as_deref(), "guest.create", Some(&username), None).await;
+    if let Err(e) = accounts::provision(&state.db, &state.soap, &state.secrets, uid).await {
+        // `/api/play` provisions again on first play.
+        tracing::warn!(error = %e, user = %username, "guest game account deferred");
+    }
+    let token = session::create(&state.db, uid, ip.as_deref(), ua).await?;
+    let jar = jar
+        .add(session::cookie(token, !state.cfg.cookie_insecure))
+        .add(key_cookie(&state, key));
+    let dest = super::oauth::landing(&jar, "/");
+    Ok((super::oauth::clear_next(jar), Redirect::to(&dest)).into_response())
+}
+
+/// Remove guests nobody has used for `OPENVANILLA_GUEST_IDLE_DAYS` (their game account and characters
+/// too). Runs at most hourly, a few at a time, when a new guest is made.
+pub async fn sweep(state: &AppState) {
+    let days = env_num("OPENVANILLA_GUEST_IDLE_DAYS", 30);
+    if days == 0 {
+        return;
+    }
+    let last: i64 = db::meta_get(&state.db, "guest_sweep_at").await.ok().flatten().and_then(|v| v.parse().ok()).unwrap_or(0);
+    if now() - last < 3600 {
+        return;
+    }
+    let _ = db::meta_set(&state.db, "guest_sweep_at", &now().to_string()).await;
+    let cutoff = now() - days * 86_400;
+    let stale: Vec<(i64, String)> = sqlx::query_as(
+        "SELECT u.id, u.username FROM users u WHERE u.guest = 1 AND u.created_at < ?1 \
+         AND NOT EXISTS (SELECT 1 FROM sessions s WHERE s.user_id = u.id AND s.last_seen >= ?1) \
+         AND NOT EXISTS (SELECT 1 FROM identities i WHERE i.user_id = u.id AND COALESCE(i.last_login, 0) >= ?1) \
+         ORDER BY u.created_at LIMIT 25",
+    )
+    .bind(cutoff)
+    .fetch_all(&state.db)
+    .await
+    .unwrap_or_default();
+    for (uid, username) in stale {
+        match accounts::delete_user(&state.db, &state.soap, uid).await {
+            Ok(()) => audit::log(&state.db, None, None, "guest.expired", Some(&username), None).await,
+            Err(e) => tracing::warn!(error = %e, user = %username, "guest sweep"),
+        }
+    }
+}
+
+/// Discord signed in while a guest was: move the Discord identity onto the guest's user, so the
+/// guest's characters become the Discord account's. `false` when there was nothing to link (the
+/// Discord account already has its own user, which then simply signs in).
+pub async fn link(db: &SqlitePool, guest_user: i64, identity: &super::provider::Identity, username: &str) -> anyhow::Result<bool> {
+    let taken: Option<(i64,)> = sqlx::query_as("SELECT user_id FROM identities WHERE provider = ? AND subject = ?")
+        .bind(&identity.provider)
+        .bind(&identity.subject)
+        .fetch_optional(db)
+        .await?;
+    if taken.is_some() {
+        return Ok(false);
+    }
+    let display: String = identity.display_name.chars().take(40).collect();
+    let mut tx = db.begin().await?;
+    let moved = sqlx::query("UPDATE users SET guest = 0, username = ?, display_name = ? WHERE id = ? AND guest = 1")
+        .bind(username)
+        .bind(&display)
+        .bind(guest_user)
+        .execute(&mut *tx)
+        .await?;
+    if moved.rows_affected() != 1 {
+        return Ok(false);
+    }
+    sqlx::query("DELETE FROM identities WHERE user_id = ? AND provider = ?")
+        .bind(guest_user)
+        .bind(PROVIDER)
+        .execute(&mut *tx)
+        .await?;
+    // Whoever used the guest before (a shared PC, a borrowed phone) must not keep a way into what
+    // is now a Discord account: its web sessions and launcher sign-ins end here. The OAuth
+    // callback signs this browser in again right after.
+    sqlx::query("DELETE FROM sessions WHERE user_id = ?").bind(guest_user).execute(&mut *tx).await?;
+    sqlx::query("DELETE FROM launcher_tokens WHERE user_id = ?").bind(guest_user).execute(&mut *tx).await?;
+    sqlx::query("INSERT INTO identities (user_id, provider, subject, display_name, email, created_at, last_login) VALUES (?, ?, ?, ?, ?, ?, ?)")
+        .bind(guest_user)
+        .bind(&identity.provider)
+        .bind(&identity.subject)
+        .bind(&display)
+        .bind(&identity.email)
+        .bind(now())
+        .bind(now())
+        .execute(&mut *tx)
+        .await?;
+    tx.commit().await?;
+    Ok(true)
+}
