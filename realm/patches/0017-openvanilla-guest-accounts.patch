+-- OpenWoW: free guest accounts. A guest is a normal player whose only way back in is a key kept
+-- in an HttpOnly cookie on the device that made it (stored here hashed, as an `identities` row
+-- with provider 'guest'). Linking Discord later turns the same user, characters and all, into a
+-- normal account.
+ALTER TABLE users ADD COLUMN guest INTEGER NOT NULL DEFAULT 0;
+ALTER TABLE users ADD COLUMN created_ip TEXT;
+CREATE INDEX users_guest ON users(guest, created_at);
diff --git a/crates/wenilla-realm/src/auth/guest.rs b/crates/wenilla-realm/src/auth/guest.rs
