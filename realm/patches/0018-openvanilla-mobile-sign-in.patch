+#[tokio::test]
+async fn a_sign_in_that_comes_back_in_another_browser_finishes_where_it_started() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let (state, jar_a, code_a) = start_in_a(&h).await;
+    let (j, _) = status(&h, &jar_a).await;
+    assert_eq!(j["wait"], true);
+    assert_eq!(j["answered"], false);
+    // Discord's app opens the way back in its own browser (B): no cookies at all
+    let b = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), None)).await;
+    assert_eq!(b.status, StatusCode::OK, "{}", b.body);
+    assert!(b.body.contains("One last step") && b.body.contains("Thrall Warchief"), "{}", b.body);
+    assert_eq!(code_on(&b.body), code_a, "the same code on both pages");
+    assert!(named(&b, "wr_session").is_none(), "B isn't signed in until the player chooses");
+    let (j, _) = status(&h, &jar_a).await;
+    assert_eq!(j["answered"], true);
+    assert!(j.get("go").is_none());
+    // a wrong token does nothing
+    let bad = send(&h.app, form("/auth/discord/handoff", None, &[("nonce", &state), ("token", "nope"), ("action", "there")])).await;
+    assert!(bad.body.contains("expired"));
+    // "Yes, finish on that page"
+    let ok = send(&h.app, form("/auth/discord/handoff", None, &[("nonce", &field(&b.body, "nonce")), ("token", &field(&b.body, "token")), ("action", "there")])).await;
+    assert!(ok.body.contains("You're signed in"), "{}", ok.body);
+    assert!(named(&ok, "wr_session").is_none());
+    // A, still waiting, signs in by itself, once
+    let (j, r) = status(&h, &jar_a).await;
+    assert_eq!(j["go"], "/");
+    let session = named(&r, "wr_session").expect("A is signed in");
+    assert!(named(&r, "wr_seen").is_some(), "remembered for Continue as …");
+    let (j, _) = status(&h, &jar_a).await;
+    assert_eq!(j["none"], true, "the approval can't be claimed twice");
+    let r = send(&h.app, get("/", Some(&session))).await;
+    assert_ne!(r.location(), "/login", "the session works");
+    // the same confirmation can't be replayed
+    let again = send(&h.app, form("/auth/discord/handoff", None, &[("nonce", &field(&b.body, "nonce")), ("token", &field(&b.body, "token")), ("action", "here")])).await;
+    assert!(again.body.contains("expired"));
+}
