+
+fn field(html: &str, name: &str) -> String {
+    let k = format!("name=\"{name}\" value=\"");
+    let i = html.find(&k).unwrap_or_else(|| panic!("no {name} in {html}")) + k.len();
+    html[i..].split('"').next().unwrap().to_string()
+}
+
+fn code_on(html: &str) -> String {
+    let i = html.find("aria-label=\"Code ").expect("a code") + "aria-label=\"Code ".len();
+    html[i..i + 4].to_string()
+}
+
+async fn status(h: &Harness, jar: &str) -> (serde_json::Value, Resp) {
+    let r = send(&h.app, get("/auth/discord/handoff/status", Some(jar))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert_eq!(r.headers.get(header::CACHE_CONTROL).unwrap(), "no-store");
+    (serde_json::from_str(&r.body).unwrap(), r)
+}
+
+/// The sign-in page in "browser A": its state and its cookies (state + handoff secret).
+async fn start_in_a(h: &Harness) -> (String, String, String) {
+    let page = send(&h.app, get("/login", None)).await;
+    let state = query_param(&direct_url(&page.body), "state");
+    let jar = format!("{}; {}", named(&page, "wr_oauth").unwrap(), named(&page, "wr_handoff").expect("handoff secret"));
+    let i = page.body.find("class=\"c\">").expect("the waiting code") + "class=\"c\">".len();
+    (state, jar, page.body[i..i + 4].to_string())
+}
