@@ -0,0 +1,15 @@
+-- OpenWoW: a Discord sign-in that comes back in another browser (a phone's Discord app opens the
+-- way back in its own browser, which doesn't have the sign-in page's cookie) can finish in the
+-- browser that started it: the player confirms a 4-digit code shown on both pages, then the
+-- starting page, which has been waiting, signs in by itself. One row per sign-in page, 30 minutes.
+CREATE TABLE signin_handoff (
+  nonce       TEXT PRIMARY KEY,   -- the OAuth state, also in the starting browser's wr_oauth cookie
+  claim_hash  TEXT NOT NULL,      -- sha256 of the secret in that browser's wr_handoff cookie (never in a URL)
+  code        TEXT NOT NULL,      -- 4 digits shown on both pages, for the player to match
+  created_at  INTEGER NOT NULL,
+  user_id     INTEGER,            -- set once Discord answered in the other browser
+  display     TEXT,               -- their Discord name, for "Continue as …" on the starting browser
+  confirm_hash TEXT,              -- sha256 of the one-time token in the other browser's confirm form
+  approved_at INTEGER             -- the player confirmed: the starting browser may now claim it
+);
+CREATE INDEX signin_handoff_created ON signin_handoff(created_at);
diff --git a/crates/wenilla-realm/src/auth/handoff.rs b/crates/wenilla-realm/src/auth/handoff.rs
