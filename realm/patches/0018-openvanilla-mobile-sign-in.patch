index 00000000..c0e50181
--- /dev/null
+++ b/crates/wenilla-realm/src/auth/handoff.rs
@@ -0,0 +1,164 @@
+//! OpenVanilla: a Discord sign-in that comes back in another browser.
+//!
+//! On a phone, Discord's app takes over the sign-in and opens the way back (the callback) in a
+//! browser of its own choosing: its in-app browser, or the default browser when the player started
+//! in another one. That browser doesn't hold the sign-in page's state cookie, so the sign-in used
+//! to fail ("That sign-in expired") or end up signed in somewhere the player wasn't playing.
+//!
+//! Every sign-in page now also leaves a row here, keyed by its OAuth state, with a secret only
+//! that browser holds (the `wr_handoff` cookie, never in a URL) and a 4-digit code it shows. When
+//! the callback arrives without the cookie but with a state this server issued in the last 30
+//! minutes, the other browser shows the code and asks "Finish signing in on the page showing
+//! 4821?". A yes marks the row approved, and the starting page, which polls
+//! `/auth/discord/handoff/status` while it waits, signs in by itself. "Play here instead" signs
+//! in the browser Discord opened. Someone who sends a player their own sign-in link gains nothing
+//! unless that player confirms a code they have never seen.
+
+use sha2::{Digest, Sha256};
+use sqlx::SqlitePool;
+
+use crate::db::now;
+use crate::secrets::{random_string, ALNUM};
+
+/// How long a sign-in page's handoff lasts (the state cookie's own lifetime).
+pub const TTL_SECS: i64 = 30 * 60;
+/// The starting browser's secret: proves a claim comes from the page that started the sign-in.
+pub const CLAIM_COOKIE: &str = "wr_handoff";
+
+fn hash(kind: &str, secret: &str) -> String {
+    hex::encode(Sha256::digest(format!("openvanilla-handoff-{kind}\n{secret}").as_bytes()))
+}
+
+fn code() -> String {
+    use rand::Rng;
+    format!("{:04}", rand::thread_rng().gen_range(0..10_000))
+}
+
+/// A sign-in page's row: makes it (or keeps it, when this browser already holds its secret) and
+/// returns (the secret for the `wr_handoff` cookie, the code to show). Old rows are swept here.
+pub async fn register(db: &SqlitePool, nonce: &str, claim: Option<&str>) -> anyhow::Result<(String, String)> {
+    let t = now();
+    sqlx::query("DELETE FROM signin_handoff WHERE created_at < ?")
+        .bind(t - TTL_SECS)
+        .execute(db)
+        .await?;
+    let row: Option<(String, String)> = sqlx::query_as("SELECT claim_hash, code FROM signin_handoff WHERE nonce = ?")
+        .bind(nonce)
+        .fetch_optional(db)
+        .await?;
+    if let (Some((h, code)), Some(c)) = (row.as_ref(), claim) {
+        if subtle::ConstantTimeEq::ct_eq(h.as_bytes(), hash("claim", c).as_bytes()).into() {
+            return Ok((c.to_string(), code.clone()));
+        }
+    }
+    if row.is_some() {
+        // a row is never taken over (whoever learned a state can't re-key it to their browser):
+        // the caller starts a fresh sign-in with a new state
+        anyhow::bail!("state already registered");
+    }
+    let secret = random_string(ALNUM, 32);
+    let code = code();
+    sqlx::query("INSERT INTO signin_handoff (nonce, claim_hash, code, created_at) VALUES (?, ?, ?, ?)")
+    .bind(nonce)
+    .bind(hash("claim", &secret))
+    .bind(&code)
+    .bind(t)
+    .execute(db)
+    .await?;
+    Ok((secret, code))
+}
+
+/// The callback came back without the state cookie: is this a sign-in this server started in the
+/// last 30 minutes that nobody has answered yet? Returns its code.
+pub async fn pending(db: &SqlitePool, nonce: &str) -> anyhow::Result<Option<String>> {
+    let row: Option<(String,)> = sqlx::query_as(
+        "SELECT code FROM signin_handoff WHERE nonce = ? AND user_id IS NULL AND created_at >= ?",
+    )
+    .bind(nonce)
+    .bind(now() - TTL_SECS)
+    .fetch_optional(db)
+    .await?;
+    Ok(row.map(|r| r.0))
+}
+
+/// Discord answered in the other browser: remember who it was and return the one-time token for
+/// that browser's confirm form.
+pub async fn answered(db: &SqlitePool, nonce: &str, user_id: i64, display: &str) -> anyhow::Result<String> {
+    let token = random_string(ALNUM, 32);
+    sqlx::query("UPDATE signin_handoff SET user_id = ?, display = ?, confirm_hash = ? WHERE nonce = ? AND user_id IS NULL")
+        .bind(user_id)
+        .bind(display)
+        .bind(hash("confirm", &token))
+        .bind(nonce)
+        .execute(db)
+        .await?;
+    Ok(token)
+}
+
+/// The other browser's answer, checked against its one-time token: the user it signed in.
+pub async fn confirm(db: &SqlitePool, nonce: &str, token: &str) -> anyhow::Result<Option<i64>> {
+    let row: Option<(Option<String>, Option<i64>)> = sqlx::query_as(
+        "SELECT confirm_hash, user_id FROM signin_handoff WHERE nonce = ? AND created_at >= ? AND approved_at IS NULL",
+    )
+    .bind(nonce)
+    .bind(now() - TTL_SECS)
+    .fetch_optional(db)
+    .await?;
+    let Some((Some(h), Some(uid))) = row else { return Ok(None) };
+    let ok: bool = subtle::ConstantTimeEq::ct_eq(h.as_bytes(), hash("confirm", token).as_bytes()).into();
+    Ok(ok.then_some(uid))
+}
+
+pub async fn approve(db: &SqlitePool, nonce: &str) -> anyhow::Result<()> {
+    sqlx::query("UPDATE signin_handoff SET approved_at = ? WHERE nonce = ?")
+        .bind(now())
+        .bind(nonce)
+        .execute(db)
+        .await?;
+    Ok(())
+}
+
+pub async fn forget(db: &SqlitePool, nonce: &str) -> anyhow::Result<()> {
+    sqlx::query("DELETE FROM signin_handoff WHERE nonce = ?").bind(nonce).execute(db).await?;
+    Ok(())
+}
+
+/// What the starting page sees while it waits.
+pub enum Status {
+    /// No sign-in of this browser's is waiting.
+    None,
+    /// Still waiting; `answered` once Discord came back in the other browser.
+    Waiting { code: String, answered: bool },
+    /// Confirmed: sign this browser in as the user (the row is gone).
+    Approved { user_id: i64, display: String },
+}
+
+/// The starting browser asks, with its state cookie's nonce and its `wr_handoff` secret.
+pub async fn status(db: &SqlitePool, nonce: &str, claim: &str) -> anyhow::Result<Status> {
+    let row: Option<(String, String, Option<i64>, Option<String>, Option<i64>)> = sqlx::query_as(
+        "SELECT claim_hash, code, user_id, display, approved_at FROM signin_handoff WHERE nonce = ? AND created_at >= ?",
+    )
+    .bind(nonce)
+    .bind(now() - TTL_SECS)
+    .fetch_optional(db)
+    .await?;
+    let Some((h, code, uid, display, approved)) = row else { return Ok(Status::None) };
+    if !bool::from(subtle::ConstantTimeEq::ct_eq(h.as_bytes(), hash("claim", claim).as_bytes())) {
+        return Ok(Status::None);
+    }
+    match (uid, approved) {
+        (Some(user_id), Some(_)) => {
+            // claimed once: the row goes, so the same approval can't sign in a second browser
+            let gone = sqlx::query("DELETE FROM signin_handoff WHERE nonce = ? AND approved_at IS NOT NULL")
+                .bind(nonce)
+                .execute(db)
+                .await?
+                .rows_affected();
+            if gone == 0 {
+                return Ok(Status::None);
+            }
+            Ok(Status::Approved { user_id, display: display.unwrap_or_default() })
+        }
+        (uid, _) => Ok(Status::Waiting { code, answered: uid.is_some() }),
+    }
+}
