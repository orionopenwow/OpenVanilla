+/// Trade Discord's code for the player's identity; a refusal (not in the server, no role yet, …)
+/// or a failure is the sign-in page with the reason.
+async fn exchange(
+    state: &AppState,
+    p: &dyn IdentityProvider,
+    id: &str,
+    code: &str,
+    ip: Option<&str>,
+) -> Result<Identity, Response> {
+    match p.callback(code, None, &redirect_uri(state, id)).await {
+        Ok(i) => Ok(i),
+        Err(e) => {
+            let msg = match e.downcast_ref::<super::discord::NotAllowed>() {
+                Some(na) => na.message.clone(),
+                None => {
+                    tracing::warn!(error = %e, provider = %id, "oauth callback");
+                    format!("{} sign-in failed — try again in a minute", p.label())
+                }
+            };
+            audit::log(&state.db, None, ip, "login.oauth_refused", Some(id), Some(&msg)).await;
+            Err(login_error(state, CookieJar::new(), &msg, false).await)
+        }
+    }
+}
+
+fn claim_cookie<'a>(state: &AppState, secret: String) -> Cookie<'a> {
+    Cookie::build((handoff::CLAIM_COOKIE, secret))
+        .path("/auth")
+        .http_only(true)
+        .secure(!state.cfg.cookie_insecure)
+        .same_site(SameSite::Lax)
+        .max_age(time::Duration::seconds(handoff::TTL_SECS))
+        .build()
+}
+
+#[derive(serde::Deserialize)]
+struct HandoffForm {
+    nonce: String,
+    token: String,
+    /// `there`: finish on the page that started; `here`: sign in this browser instead.
+    action: String,
+}
+
+/// The other browser's answer to "Finish signing in on the page showing 4821?".
+async fn handoff_answer(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<String>,
+    headers: HeaderMap,
+    jar: CookieJar,
+    Form(f): Form<HandoffForm>,
+) -> Result<Response, AppError> {
+    if provider(&state, &id).is_none() {
+        return Ok(Redirect::to("/login").into_response());
+    }
+    let Some(user_id) = handoff::confirm(&state.db, &f.nonce, &f.token).await? else {
+        return Ok(login_error(&state, jar, "That sign-in expired. Tap the button to try again.", false).await);
+    };
+    let ip = client_ip(&headers);
+    if f.action == "here" {
+        handoff::forget(&state.db, &f.nonce).await?;
+        let token = session::create(&state.db, user_id, ip.as_deref(), headers.get("user-agent").and_then(|v| v.to_str().ok())).await?;
+        audit::log(&state.db, Some(user_id), ip.as_deref(), "login.ok", Some(&id), Some("handoff: here")).await;
+        let jar = jar.add(session::cookie(token, !state.cfg.cookie_insecure));
+        return Ok((clear_next(jar.clone()), Redirect::to(&landing(&jar, "/"))).into_response());
+    }
+    handoff::approve(&state.db, &f.nonce).await?;
+    audit::log(&state.db, Some(user_id), ip.as_deref(), "login.handoff_approved", Some(&id), None).await;
+    let code: Option<(String, Option<String>)> = sqlx::query_as("SELECT code, display FROM signin_handoff WHERE nonce = ?")
+        .bind(&f.nonce)
+        .fetch_optional(&state.db)
+        .await?;
+    let (code, name) = code.map(|(c, d)| (c, d.unwrap_or_default())).unwrap_or_default();
+    let (jar, mut page) = login_view(&state, jar, None, false).await;
+    page.handoff = Some(templates::Handoff { provider: id, code, name, nonce: String::new(), token: String::new(), done: true });
+    Ok((jar, render(page)).into_response())
+}
+
+/// The starting page, waiting: `{"go": url}` once the player confirmed (this browser is then
+/// signed in), `{"wait": true, "code": "4821", "answered": bool}` meanwhile, `{"none": true}`
+/// when nothing of this browser's is waiting.
+async fn handoff_status(
+    State(state): State<Arc<AppState>>,
+    Path(id): Path<String>,
+    headers: HeaderMap,
+    jar: CookieJar,
+) -> Result<Response, AppError> {
+    let json = |jar: CookieJar, v: serde_json::Value| {
+        (jar, [(axum::http::header::CACHE_CONTROL, "no-store")], axum::Json(v)).into_response()
+    };
+    // signed in meanwhile (Discord came back in this same browser, in another tab): on with it
+    if let Some(c) = jar.get(session::COOKIE) {
+        if let Ok(Some(s)) = session::lookup_with(&state.db, c.value(), false).await {
+            if !s.user.guest && !s.must_change_password {
+                let dest = landing(&jar, if s.user.is_admin() { "/admin" } else { "/" });
+                return Ok(json(clear_next(jar), serde_json::json!({ "go": dest })));
+            }
+        }
+    }
+    let nonce = jar
+        .get(STATE_COOKIE)
+        .and_then(|c| c.value().split_once('.').filter(|(p, _)| *p == id).map(|(_, n)| n.to_string()));
+    let claim = jar.get(handoff::CLAIM_COOKIE).map(|c| c.value().to_string());
+    let (Some(nonce), Some(claim)) = (nonce, claim) else {
+        return Ok(json(jar, serde_json::json!({ "none": true })));
+    };
+    match handoff::status(&state.db, &nonce, &claim).await? {
+        handoff::Status::None => Ok(json(jar, serde_json::json!({ "none": true }))),
+        handoff::Status::Waiting { code, answered } => {
+            Ok(json(jar, serde_json::json!({ "wait": true, "code": code, "answered": answered })))
+        }
+        handoff::Status::Approved { user_id, display } => {
+            let ip = client_ip(&headers);
+            let token = session::create(&state.db, user_id, ip.as_deref(), headers.get("user-agent").and_then(|v| v.to_str().ok())).await?;
+            audit::log(&state.db, Some(user_id), ip.as_deref(), "login.ok", Some(&id), Some("handoff: there")).await;
+            let jar = jar
+                .remove(Cookie::build((STATE_COOKIE, "")).path("/auth").build())
+                .remove(Cookie::build((handoff::CLAIM_COOKIE, "")).path("/auth").build())
+                .add(session::cookie(token, !state.cfg.cookie_insecure))
+                .add(remember_cookie(&state, &id, &display));
+            let role: (String,) = sqlx::query_as("SELECT role FROM users WHERE id = ?").bind(user_id).fetch_one(&state.db).await?;
+            let dest = landing(&jar, if role.0 == "admin" { "/admin" } else { "/" });
+            Ok(json(clear_next(jar), serde_json::json!({ "go": dest })))
+        }
+    }
+}
