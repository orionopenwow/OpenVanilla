+/// Open Vanilla: the one dressing-room booth belongs to the NAMED `DressUpModel` that acted last
+/// (the stock `DressUpModel`, the auction house's, or an addon's, e.g. `TransmogModel`): its
+/// intents dress the booth, and the booth draws into it ([`super::UiScript::dressup_owner`]). An
+/// anonymous pane (an addon's grid of small previews) has no name to be drawn by, so its verbs
+/// are no-ops and can never undress the owner's look mid-preview. Addons can read
+/// `OPENVANILLA_ONE_DRESSING_ROOM` to know that only one named pane draws at a time.
+fn queue(lua: &Lua, this: &Table, intent: DressUpIntent) -> mlua::Result<()> {
+    let h = frame_handle_of(lua, this)?;
+    let mut model = lua.app_data_mut::<Model>().expect("model app_data");
+    let Some(name) = model.arena.frame(h).and_then(|f| f.name.clone()) else {
+        return Ok(());
+    };
+    model.dressup_owner = Some(name);
+    model.dressup_intents.push(intent);
+    Ok(())
 }
 
