+#[tokio::test]
+async fn a_sign_in_link_opened_on_another_network_never_offers_to_finish_on_the_page_that_started() {
+    // the attack: someone opens the sign-in page, sends the victim Discord's link with that state and
+    // asks them to confirm "the code on your screen". The victim's browser is on another network.
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let (state, jar_a, _) = start_in_a(&h).await;            // attacker, on 203.0.113.x
+    let (j, _) = status(&h, &jar_a).await;
+    assert_eq!(j["wait"], true);
+    let mut req = get(&format!("/auth/discord/callback?code=OK&state={state}"), None);
+    req.headers_mut().insert("x-forwarded-for", "198.51.100.20".parse().unwrap());
+    let b = send(&h.app, req).await;                          // victim, on 198.51.100.x
+    assert!(!b.body.contains("One last step"), "no handoff offered across networks: {}", b.body);
+    assert!(!b.body.contains("name=\"token\""), "no confirmation token handed out");
+    let n: (i64,) = sqlx::query_as("SELECT COUNT(*) FROM signin_handoff WHERE user_id IS NOT NULL").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(n.0, 0, "the attacker's waiting row never learns the victim");
+    let (j, _) = status(&h, &jar_a).await;
+    assert!(j.get("go").is_none(), "the attacker's page is never signed in");
+    // the same network (a phone's Discord app and its browser) still gets the handoff
+    let b2 = send(&h.app, get(&format!("/auth/discord/callback?code=OK&state={state}"), None)).await;
+    assert!(b2.body.contains("One last step"), "{}", b2.body);
+}
