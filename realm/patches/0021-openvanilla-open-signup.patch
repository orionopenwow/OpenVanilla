+/// The network an address is on, for comparing two browsers: an IPv4 /24 or an IPv6 /64.
+pub fn net_of(ip: Option<&str>) -> Option<String> {
+    let ip: std::net::IpAddr = ip?.trim().parse().ok()?;
+    Some(match ip {
+        std::net::IpAddr::V4(v) => {
+            let o = v.octets();
+            format!("{}.{}.{}", o[0], o[1], o[2])
+        }
+        std::net::IpAddr::V6(v) => {
+            if let Some(v4) = v.to_ipv4_mapped() {
+                let o = v4.octets();
+                return Some(format!("{}.{}.{}", o[0], o[1], o[2]));
+            }
+            let s = v.segments();
+            format!("{:x}:{:x}:{:x}:{:x}", s[0], s[1], s[2], s[3])
+        }
+    })
+}
+
+/// Remember the starting browser's network (the first one seen wins; never changed afterwards).
+pub async fn set_net(db: &SqlitePool, nonce: &str, net: Option<&str>) -> anyhow::Result<()> {
+    if let Some(net) = net {
+        sqlx::query("UPDATE signin_handoff SET net = ? WHERE nonce = ? AND net IS NULL")
+            .bind(net)
+            .bind(nonce)
+            .execute(db)
+            .await?;
+    }
+    Ok(())
+}
