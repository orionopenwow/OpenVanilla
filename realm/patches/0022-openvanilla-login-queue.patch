+#[tokio::test]
+async fn download_gate_and_returning_marker_over_http() {
+    let mut cfg = on(1, 100);
+    cfg.data_version = None; // derived from the test www
+    let h = harness(cfg).await;
+    let (alice, a) = player(&h, "alice").await;
+    let (_, b) = player(&h, "bob").await;
+
+    let r = send(&h.app, page("/", &a)).await;
+    assert!(r.body.contains("id=\"ovq\"") && r.body.contains("You're in line"));
+    assert!(r.body.contains("https://openvanilla.app/solo.html"));
+    assert!(r.body.contains("Keep this tab open"));
+    let r = send(&h.app, get("/brand/queue/frame.webp", &a)).await;
+    assert_eq!(r.status, StatusCode::OK);
+
+    // nothing moves before the line says so
+    assert_eq!(send(&h.app, get("/data/x.dbc", &a)).await.status, StatusCode::FORBIDDEN);
+    assert_eq!(send(&h.app, get("/wenilla_bg.wasm", &a)).await.status, StatusCode::FORBIDDEN);
+    assert_eq!(send(&h.app, play(&a, None)).await.status, StatusCode::FORBIDDEN);
+    // a join must come from the page
+    let mut forged = post_json("/api/queue/join", &a, "192.0.2.1", serde_json::json!({}));
+    forged.headers_mut().remove("x-requested-with");
+    assert_eq!(send(&h.app, forged).await.status, StatusCode::FORBIDDEN);
+
+    let ja = send(&h.app, post_json("/api/queue/join", &a, "192.0.2.1", serde_json::json!({}))).await.json();
+    assert_eq!((ja["status"].as_str(), ja["gate"].as_str()), (Some("go"), Some("download")));
+    let jb = send(&h.app, post_json("/api/queue/join", &b, "192.0.2.2", serde_json::json!({}))).await.json();
+    assert_eq!((jb["status"].as_str(), jb["position"].as_u64()), (Some("waiting"), Some(1)));
+    assert!(jb["eta_secs"].as_u64().unwrap() >= 1);
+    assert_eq!(jb["waiting"].as_u64(), Some(1));
+
+    // alice downloads; bob still cannot
+    assert_eq!(send(&h.app, get("/data/x.dbc", &a)).await.status, StatusCode::SERVICE_UNAVAILABLE);
+    assert_eq!(send(&h.app, get("/wenilla_bg.wasm", &a)).await.status, StatusCode::OK);
+    assert_eq!(send(&h.app, get("/data/x.dbc", &b)).await.status, StatusCode::FORBIDDEN);
+
+    // alice's download is done: the slot goes to bob, alice gets the world and a marker
+    let ta = ja["ticket"].as_str().unwrap();
+    let d = send(&h.app, post_json("/api/queue/done", &a, "192.0.2.1", serde_json::json!({ "ticket": ta }))).await.json();
+    assert_eq!((d["status"].as_str(), d["gate"].as_str()), (Some("go"), Some("world")));
+    let marker = d["marker"].as_str().unwrap().to_string();
+    assert_eq!(d["data_version"].as_str(), Some(h.state.queue.data_version()));
+    let pass = d["pass"].as_str().unwrap().to_string();
+    let tb = jb["ticket"].as_str().unwrap();
+    let sb = send(&h.app, get(&format!("/api/queue/status?ticket={tb}"), &b)).await.json();
+    assert_eq!((sb["status"].as_str(), sb["gate"].as_str()), (Some("go"), Some("download")));
+    // someone else's ticket is not yours to poll
+    assert_eq!(send(&h.app, get(&format!("/api/queue/status?ticket={ta}"), &b)).await.status, StatusCode::NOT_FOUND);
+
+    // the world pass signs alice in
+    assert_eq!(send(&h.app, play(&a, Some("nope"))).await.status, StatusCode::FORBIDDEN);
+    let r = send(&h.app, play(&a, Some(&pass))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+
+    // alice comes back in a new browser (a new sign-in) with the marker: straight to the world
+    let (_, a2) = player(&h, "alice").await;
+    let back = send(&h.app, post_json("/api/queue/join", &a2, "192.0.2.1", serde_json::json!({ "marker": marker }))).await.json();
+    assert_eq!((back["status"].as_str(), back["gate"].as_str(), back["returning"].as_bool()), (Some("go"), Some("world"), Some(true)));
+    // bob cannot borrow alice's marker, nor make one up
+    let (_, b2) = player(&h, "bob").await;
+    let borrowed = send(&h.app, post_json("/api/queue/join", &b2, "192.0.2.3", serde_json::json!({ "marker": marker }))).await.json();
+    assert_eq!(borrowed["returning"].as_bool(), Some(false));
+    assert_eq!(borrowed["gate"].as_str(), Some("download"));
+    let (_, b3) = player(&h, "bob").await;
+    let made_up = send(&h.app, post_json("/api/queue/join", &b3, "192.0.2.4", serde_json::json!({ "marker": "AAAA" }))).await.json();
+    assert_eq!(made_up["returning"].as_bool(), Some(false));
+    // a marker from an older data version is retired
+    let old = wenilla_realm::queue::seal_marker(&h.state.secrets, alice, "old-build").unwrap();
+    let (_, a3) = player(&h, "alice").await;
+    let stale = send(&h.app, post_json("/api/queue/join", &a3, "192.0.2.5", serde_json::json!({ "marker": old }))).await.json();
+    assert_eq!(stale["returning"].as_bool(), Some(false));
+
+    // cancel gives the place up
+    let t3 = stale["ticket"].as_str().unwrap();
+    let r = send(&h.app, post_json("/api/queue/leave", &a3, "192.0.2.5", serde_json::json!({ "ticket": t3 }))).await;
+    assert_eq!(r.status, StatusCode::NO_CONTENT);
+    assert_eq!(send(&h.app, get(&format!("/api/queue/status?ticket={t3}"), &a3)).await.status, StatusCode::NOT_FOUND);
+}
