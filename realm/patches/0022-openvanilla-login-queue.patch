+/// OpenVanilla: the queue window's art and fonts (the realm list's painted frame, corners, divider,
+/// gem, bar and Cancel button; Cinzel and Nunito, SIL OFL 1.1). Same posture as [`brand`].
+async fn queue_art(Path(file): Path<String>) -> Response {
+    macro_rules! art {
+        ($name:literal, $kind:literal) => {
+            (include_bytes!(concat!("../../assets/queue/", $name)) as &'static [u8], $kind)
+        };
+    }
+    let (bytes, kind): (&'static [u8], &'static str) = match file.as_str() {
+        "frame.webp" => art!("frame.webp", "image/webp"),
+        "corner_tl.webp" => art!("corner_tl.webp", "image/webp"),
+        "corner_tr.webp" => art!("corner_tr.webp", "image/webp"),
+        "div_gold.webp" => art!("div_gold.webp", "image/webp"),
+        "gem_soon.webp" => art!("gem_soon.webp", "image/webp"),
+        "bar_dark.webp" => art!("bar_dark.webp", "image/webp"),
+        "btn_cancel.webp" => art!("btn_cancel.webp", "image/webp"),
+        "feat_play.webp" => art!("feat_play.webp", "image/webp"),
+        "Cinzel-SemiBold.ttf" => art!("Cinzel-SemiBold.ttf", "font/ttf"),
+        "nunito-latin-600-normal.woff2" => art!("nunito-latin-600-normal.woff2", "font/woff2"),
+        "nunito-latin-700-normal.woff2" => art!("nunito-latin-700-normal.woff2", "font/woff2"),
+        "nunito-latin-800-normal.woff2" => art!("nunito-latin-800-normal.woff2", "font/woff2"),
+        _ => return StatusCode::NOT_FOUND.into_response(),
+    };
+    let mut r = bytes.into_response();
+    let h = r.headers_mut();
+    h.insert(header::CONTENT_TYPE, HeaderValue::from_static(kind));
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("public, max-age=86400"));
+    h.insert("cross-origin-resource-policy", HeaderValue::from_static("same-origin"));
+    r
+}
