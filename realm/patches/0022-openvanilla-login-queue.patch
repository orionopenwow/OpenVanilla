+#[tokio::test]
+async fn world_gate_blocks_sign_in_beyond_its_size() {
+    let h = harness(on(10, 2)).await;
+    let marker_for = |uid| wenilla_realm::queue::seal_marker(&h.state.secrets, uid, "v1").unwrap();
+    let mut players = Vec::new();
+    for name in ["w1", "w2", "w3"] {
+        let (uid, c) = player(&h, name).await;
+        let j = send(&h.app, post_json("/api/queue/join", &c, &format!("192.0.2.{uid}"), serde_json::json!({ "marker": marker_for(uid) }))).await.json();
+        players.push((c, j));
+    }
+    let (c1, j1) = &players[0];
+    let (c2, j2) = &players[1];
+    let (c3, j3) = &players[2];
+    assert_eq!(j1["status"].as_str(), Some("go"));
+    assert_eq!(j2["status"].as_str(), Some("go"));
+    assert_eq!((j3["status"].as_str(), j3["gate"].as_str(), j3["position"].as_u64()), (Some("waiting"), Some("world"), Some(1)));
+    assert_eq!(j3["busy"].as_bool(), Some(true));
+    assert_eq!(send(&h.app, play(c1, j1["pass"].as_str())).await.status, StatusCode::OK);
+    assert_eq!(send(&h.app, play(c2, j2["pass"].as_str())).await.status, StatusCode::OK);
+    // the third cannot sign in: not without a pass, not with someone else's
+    assert_eq!(send(&h.app, play(c3, None)).await.status, StatusCode::FORBIDDEN);
+    assert_eq!(send(&h.app, play(c3, j1["pass"].as_str())).await.status, StatusCode::FORBIDDEN);
+    // returning players need no download slot: the data is open to them
+    assert_eq!(send(&h.app, get("/data/x.dbc", c3)).await.status, StatusCode::SERVICE_UNAVAILABLE);
+    // one leaves the world; the third goes in
+    let t1 = j1["ticket"].as_str().unwrap();
+    send(&h.app, post_json("/api/queue/leave", c1, "192.0.2.1", serde_json::json!({ "ticket": t1 }))).await;
+    let t3 = j3["ticket"].as_str().unwrap();
+    let s3 = send(&h.app, get(&format!("/api/queue/status?ticket={t3}"), c3)).await.json();
+    assert_eq!(s3["status"].as_str(), Some("go"));
+    assert_eq!(send(&h.app, play(c3, s3["pass"].as_str())).await.status, StatusCode::OK);
+    assert_eq!(h.state.queue.stats(Instant::now()).in_world, 2);
+}
