@@ -0,0 +1,513 @@
+//! OpenVanilla: the login/download queue (`src/queue.rs`). The gate logic runs against the in-memory
+//! `Queue` with an explicit clock (expiry and pacing need time to pass); the HTTP surface —
+//! join/status/done/leave, the data gate on `/data/*` and the wasm, the world gate on
+//! `/api/play`, the returning-player marker, and "queue off changes nothing" — goes through the
+//! router with a mock console.
+
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use axum::response::IntoResponse;
+use axum::routing::post;
+use http_body_util::BodyExt;
+use tower::ServiceExt;
+use wenilla_realm::queue::{Gate, JoinError, Queue, QueueConfig, TICKET_TTL};
+use wenilla_realm::{db, mangos_conf, ratelimit, realmdb, secrets, session, soap, AppState, Config};
+
+// ---------------------------------------------------------------------------------------------
+// the gates, in memory
+
+fn on(downloads: usize, world: usize) -> QueueConfig {
+    QueueConfig {
+        enabled: true,
+        downloads,
+        world,
+        per_ip: 100,
+        admit_per_min: 6000,
+        admit_burst: 1000,
+        data_version: Some("v1".into()),
+    }
+}
+
+#[test]
+fn fifo_order_and_download_slots_free_up() {
+    let q = Queue::new(on(2, 100), None);
+    let t0 = Instant::now();
+    let v: Vec<_> = (1..=5)
+        .map(|b| q.join(b, b, Some(&format!("10.0.0.{b}")), false, t0).unwrap())
+        .collect();
+    assert_eq!(v[0].status, "go");
+    assert_eq!(v[0].gate, Gate::Download);
+    assert_eq!(v[1].status, "go");
+    for (i, w) in v[2..].iter().enumerate() {
+        assert_eq!(w.status, "waiting");
+        assert_eq!(w.gate, Gate::Download);
+        assert_eq!(w.position, i + 1, "first come, first served");
+    }
+    assert_eq!(q.status(5, &v[4].ticket, t0).unwrap().waiting, 3);
+    // only the downloaders may read the game data
+    assert!(q.has_data_grant(1, t0) && q.has_data_grant(2, t0));
+    assert!(!q.has_data_grant(3, t0));
+
+    // the first download finishes: its slot goes to the head of the line, not to anyone else
+    let done = q.download_done(1, &v[0].ticket, t0).unwrap();
+    assert_eq!(done.gate, Gate::World, "on to the world gate");
+    let s3 = q.status(3, &v[2].ticket, t0).unwrap();
+    assert_eq!((s3.status, s3.gate), ("go", Gate::Download));
+    assert!(q.has_data_grant(3, t0));
+    let s4 = q.status(4, &v[3].ticket, t0).unwrap();
+    assert_eq!((s4.status, s4.position), ("waiting", 1));
+    let s5 = q.status(5, &v[4].ticket, t0).unwrap();
+    assert_eq!(s5.position, 2);
+
+    // a download that never reports back gives its slot up after the cap
+    let later = t0 + wenilla_realm::queue::DOWNLOAD_MAX + Duration::from_secs(1);
+    let mut at = t0;
+    while at < later {
+        at += Duration::from_secs(60);
+        for (b, t) in [(2, &v[1].ticket), (3, &v[2].ticket), (4, &v[3].ticket), (5, &v[4].ticket)] {
+            q.status(b, t, at.min(later - Duration::from_secs(1))).unwrap(); // keep them alive
+        }
+    }
+    let s4 = q.status(4, &v[3].ticket, later).unwrap();
+    assert_eq!(s4.status, "go", "a stuck download freed its slot");
+}
+
+#[test]
+fn one_ticket_per_browser() {
+    let q = Queue::new(on(1, 100), None);
+    let t0 = Instant::now();
+    let a = q.join(1, 1, Some("1.1.1.1"), false, t0).unwrap();
+    let b = q.join(2, 2, Some("1.1.1.2"), false, t0).unwrap();
+    let again = q.join(2, 2, Some("1.1.1.2"), false, t0).unwrap();
+    assert_eq!(again.ticket, b.ticket, "a rejoin keeps the place");
+    assert_eq!(again.position, 1);
+    assert_eq!(q.stats(t0).waiting_download, 1);
+    // a ticket answers only to its own browser
+    assert!(q.status(2, &a.ticket, t0).is_none());
+    assert!(!q.leave(2, &a.ticket));
+}
+
+#[test]
+fn expired_tickets_are_dropped_with_their_slot() {
+    let q = Queue::new(on(1, 100), None);
+    let t0 = Instant::now();
+    let a = q.join(1, 1, None, false, t0).unwrap();
+    assert_eq!(a.status, "go");
+    let b = q.join(2, 2, None, false, t0).unwrap();
+    let c = q.join(3, 3, None, false, t0).unwrap();
+    assert_eq!((b.position, c.position), (1, 2));
+    // b and c keep polling; a (downloading) and nobody else stops
+    let mid = t0 + Duration::from_secs(120);
+    q.status(2, &b.ticket, mid).unwrap();
+    q.status(3, &c.ticket, mid).unwrap();
+    let still = q.status(2, &b.ticket, t0 + TICKET_TTL - Duration::from_secs(1)).unwrap();
+    assert_eq!(still.status, "waiting", "a is still within its 3 minutes");
+    let after = t0 + TICKET_TTL + Duration::from_secs(1);
+    let b2 = q.status(2, &b.ticket, after).unwrap();
+    assert_eq!(b2.status, "go", "a's slot came free when a expired");
+    assert!(q.status(1, &a.ticket, after).is_none(), "a is gone");
+    // c stopped polling at `mid`: gone 3 minutes later
+    assert!(q.status(3, &c.ticket, mid + TICKET_TTL).is_none());
+    // a waiting ticket that steps away for 2 minutes keeps its place
+    let d = q.join(4, 4, None, false, after).unwrap();
+    let e = q.join(5, 5, None, false, after).unwrap();
+    assert_eq!(q.status(4, &d.ticket, after + Duration::from_secs(150)).unwrap().position, 1);
+    assert_eq!(q.status(5, &e.ticket, after + Duration::from_secs(150)).unwrap().position, 2);
+}
+
+#[test]
+fn per_ip_cap_counts_waiting_tickets() {
+    let mut cfg = on(1, 100);
+    cfg.per_ip = 2;
+    let q = Queue::new(cfg, None);
+    let t0 = Instant::now();
+    let ip = Some("203.0.113.9");
+    assert_eq!(q.join(1, 1, ip, false, t0).unwrap().status, "go"); // downloading: not waiting
+    q.join(2, 2, ip, false, t0).unwrap();
+    q.join(3, 3, ip, false, t0).unwrap();
+    assert_eq!(q.join(4, 4, ip, false, t0).unwrap_err(), JoinError::IpCap);
+    // the same browser asking again is not a new ticket
+    assert!(q.join(3, 3, ip, false, t0).is_ok());
+    // another address is unaffected
+    assert!(q.join(5, 5, Some("198.51.100.1"), false, t0).is_ok());
+    assert_eq!(q.stats(t0).waiting_download, 3);
+}
+
+#[test]
+fn returning_players_skip_the_download_gate() {
+    let q = Queue::new(on(1, 100), None);
+    let t0 = Instant::now();
+    q.join(1, 1, None, false, t0).unwrap(); // the one download slot
+    let first = q.join(2, 2, None, false, t0).unwrap();
+    assert_eq!((first.status, first.gate), ("waiting", Gate::Download));
+    let back = q.join(3, 3, None, true, t0).unwrap();
+    assert_eq!((back.status, back.gate), ("go", Gate::World));
+    assert!(back.returning && back.pass.is_some());
+    assert!(q.has_data_grant(3, t0), "a cache miss can still fetch");
+    // a waiting first-timer whose page finds a marker moves over too
+    let moved = q.join(2, 2, None, true, t0).unwrap();
+    assert_eq!((moved.status, moved.gate), ("go", Gate::World));
+}
+
+#[test]
+fn world_gate_holds_everyone_beyond_its_size() {
+    let q = Queue::new(on(10, 2), None);
+    let t0 = Instant::now();
+    let a = q.join(1, 1, None, true, t0).unwrap();
+    let b = q.join(2, 2, None, true, t0).unwrap();
+    let c = q.join(3, 3, None, true, t0).unwrap();
+    assert_eq!((a.status, b.status), ("go", "go"));
+    assert_eq!((c.status, c.gate, c.position), ("waiting", Gate::World, 1));
+    assert!(c.busy, "anyone waiting means the realm is busy");
+    // signing in takes the pass, and only one's own
+    assert!(!q.check_world_pass(3, a.pass.as_deref().unwrap(), t0));
+    assert!(!q.check_world_pass(1, "forged", t0));
+    assert!(q.check_world_pass(1, a.pass.as_deref().unwrap(), t0));
+    assert!(q.check_world_pass(1, a.pass.as_deref().unwrap(), t0), "a reload signs in again");
+    assert_eq!(q.stats(t0).in_world, 2);
+    // a first-timer done downloading waits behind the world line in join order
+    let d = q.join(4, 4, None, false, t0).unwrap();
+    let d = q.download_done(4, &d.ticket, t0).unwrap();
+    assert_eq!((d.gate, d.position), (Gate::World, 2));
+    // a leaves: c (first in line) goes in
+    assert!(q.leave(1, &a.ticket));
+    let c2 = q.status(3, &c.ticket, t0).unwrap();
+    assert_eq!(c2.status, "go");
+    assert_eq!(q.status(4, &d.ticket, t0).unwrap().position, 1);
+}
+
+#[test]
+fn admissions_are_paced() {
+    let mut cfg = on(100, 100);
+    cfg.admit_per_min = 60;
+    cfg.admit_burst = 1;
+    let q = Queue::new(cfg, None);
+    let t0 = Instant::now();
+    assert_eq!(q.join(1, 1, None, false, t0).unwrap().status, "go");
+    let b = q.join(2, 2, None, false, t0).unwrap();
+    assert_eq!(b.status, "waiting", "one a second, even with free slots");
+    assert!(b.eta_secs >= 1);
+    assert_eq!(q.status(2, &b.ticket, t0 + Duration::from_millis(1100)).unwrap().status, "go");
+}
+
+#[test]
+fn config_from_env_names() {
+    let off = QueueConfig::from_lookup(|_| None).unwrap();
+    assert!(!off.enabled);
+    assert_eq!((off.downloads, off.world), (25, 120));
+    let vars = [
+        ("QUEUE_ENABLED", "1"),
+        ("QUEUE_DOWNLOADS", "7"),
+        ("QUEUE_WORLD", "300"),
+        ("QUEUE_PER_IP", "3"),
+        ("QUEUE_ADMIT_PER_MIN", "90"),
+        ("QUEUE_DATA_VERSION", "build-42"),
+    ];
+    let c = QueueConfig::from_lookup(|k| vars.iter().find(|(n, _)| *n == k).map(|(_, v)| v.to_string())).unwrap();
+    assert!(c.enabled);
+    assert_eq!((c.downloads, c.world, c.per_ip, c.admit_per_min), (7, 300, 3, 90));
+    assert_eq!(Queue::new(c, None).data_version(), "build-42");
+    assert!(QueueConfig::from_lookup(|k| (k == "QUEUE_WORLD").then(|| "lots".into())).is_err());
+}
