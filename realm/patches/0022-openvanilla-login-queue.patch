+/// A player with a fresh sign-in: `(user id, cookie)`. Each call is another browser.
+async fn player(h: &Harness, name: &str) -> (i64, String) {
+    let id: i64 = match sqlx::query_scalar("SELECT id FROM users WHERE username = ?")
+        .bind(name)
+        .fetch_optional(&h.state.db)
+        .await
+        .unwrap()
+    {
+        Some(id) => id,
+        None => sqlx::query_scalar(
+            "INSERT INTO users (username, display_name, role, created_at) VALUES (?, ?, 'player', 0) RETURNING id",
+        )
+        .bind(name)
+        .bind(name)
+        .fetch_one(&h.state.db)
+        .await
+        .unwrap(),
+    };
+    let token = session::create(&h.state.db, id, None, None).await.unwrap();
+    (id, format!("{}={token}", session::COOKIE))
+}
+
+struct Resp {
+    status: StatusCode,
+    body: String,
+}
+
+impl Resp {
+    fn json(&self) -> serde_json::Value {
+        serde_json::from_str(&self.body).unwrap_or_else(|e| panic!("{e}: {}", self.body))
+    }
+}
+
+async fn send(app: &axum::Router, req: Request<Body>) -> Resp {
+    let resp = app.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let body = String::from_utf8_lossy(&resp.into_body().collect().await.unwrap().to_bytes()).into_owned();
+    Resp { status, body }
+}
+
+fn get(path: &str, cookie: &str) -> Request<Body> {
+    Request::get(path)
+        .header(header::COOKIE, cookie)
+        .header("x-forwarded-for", "192.0.2.1")
+        .body(Body::empty())
+        .unwrap()
+}
+
+fn page(path: &str, cookie: &str) -> Request<Body> {
+    Request::get(path)
+        .header(header::COOKIE, cookie)
+        .header(header::ACCEPT, "text/html")
+        .body(Body::empty())
+        .unwrap()
+}
+
+fn play(cookie: &str, pass: Option<&str>) -> Request<Body> {
+    let mut b = Request::get("/api/play")
+        .header(header::COOKIE, cookie)
+        .header("x-requested-with", "wenilla");
+    if let Some(p) = pass {
+        b = b.header("x-queue-pass", p);
+    }
+    b.body(Body::empty()).unwrap()
+}
+
+fn post_json(path: &str, cookie: &str, ip: &str, body: serde_json::Value) -> Request<Body> {
+    Request::post(path)
+        .header(header::COOKIE, cookie)
+        .header(header::CONTENT_TYPE, "application/json")
+        .header("x-requested-with", "wenilla")
+        .header("x-forwarded-for", ip)
+        .body(Body::from(body.to_string()))
+        .unwrap()
+}
