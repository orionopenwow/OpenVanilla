diff --git a/crates/wenilla-realm/src/queue.rs b/crates/wenilla-realm/src/queue.rs
new file mode 100644
index 00000000..3071f5ed
--- /dev/null
+++ b/crates/wenilla-realm/src/queue.rs
@@ -0,0 +1,869 @@
+//! OpenVanilla: the login/download queue — two gates, in memory, in front of the browser realm.
+//!
+//! * **Download gate** (first-time players only): at most `QUEUE_DOWNLOADS` players fetch the
+//!   game data (`/data/*` and the wasm, ~72 MB) at once. A player is let through by a *data
+//!   grant* on their account, which [`data_gate`] checks on those routes. A returning player —
+//!   the page holds a marker the realm sealed when their download finished, for the current data
+//!   version — skips this gate and gets the grant at once.
+//! * **World gate** (everyone): at most `QUEUE_WORLD` players in the world or signing in. Going
+//!   through it hands the page a short-lived pass; `/api/play` (the game sign-in: it hands out
+//!   the game credentials) refuses without one. "In the world" is counted as admitted tickets
+//!   that keep polling (the page heartbeats every 30 s while it plays). CMaNGOS `PlayerLimit`
+//!   stays above `QUEUE_WORLD` as the backstop.
+//!
+//! One ticket per browser (keyed by the session cookie), a cap on waiting tickets per IP, fair
+//! FIFO (both gates order by join time, so a first-timer who waited for the download keeps
+//! their place for the world), admissions paced by a token bucket (`QUEUE_ADMIT_PER_MIN`), and
+//! a ticket that is not polled for 3 minutes is dropped with whatever slot it held.
+//!
+//! `QUEUE_ENABLED=0` (the default) turns all of it off: the endpoints answer 404, nothing is
+//! checked, and the play page is exactly what it was.
+
+use std::collections::{HashMap, VecDeque};
+use std::path::Path;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use anyhow::{anyhow, Context, Result};
+use axum::extract::{Query, Request, State};
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::middleware::Next;
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use base64::Engine;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::session::{client_ip, Session};
+use crate::AppState;
+
+/// How long a ticket lives without a poll. The window promises it: "your place is kept for 3
+/// minutes if you step away".
+pub const TICKET_TTL: Duration = Duration::from_secs(180);
+/// A world pass must be used (at `/api/play`) within this long; a later poll issues a new one.
+pub const PASS_TTL: Duration = Duration::from_secs(120);
+/// A download slot is given back after this long even if the page never says it finished.
+pub const DOWNLOAD_MAX: Duration = Duration::from_secs(15 * 60);
+/// How long a data grant lets an account read `/data/*` (it slides with every poll): the game
+/// keeps streaming zone data while it plays.
+pub const DATA_GRANT: Duration = Duration::from_secs(12 * 3600);
+/// The window over which the admission rate (and so the ETA) is measured.
+const RATE_WINDOW: Duration = Duration::from_secs(600);
+/// How far back "Up N places in M min" looks.
+const MOVED_WINDOW: Duration = Duration::from_secs(300);
+
+#[derive(Clone, Debug)]
+pub struct QueueConfig {
+    /// `QUEUE_ENABLED` (default `0`).
+    pub enabled: bool,
+    /// `QUEUE_DOWNLOADS` (default 25): first-time players fetching the game data at once.
+    pub downloads: usize,
+    /// `QUEUE_WORLD` (default 120): players in the world or signing in.
+    pub world: usize,
+    /// `QUEUE_PER_IP` (default 4): waiting tickets one address may hold.
+    pub per_ip: usize,
+    /// `QUEUE_ADMIT_PER_MIN` (default 60): the steady admission rate, per gate.
+    pub admit_per_min: u32,
+    /// `QUEUE_ADMIT_BURST` (default 10): admissions allowed at once when slots are free.
+    pub admit_burst: u32,
+    /// `QUEUE_DATA_VERSION`: names the game data a returning player's marker must match.
+    /// Unset, it is derived from the wasm bundle and boot manifest in `REALM_WWW`.
+    pub data_version: Option<String>,
+}
+
+impl Default for QueueConfig {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            downloads: 25,
+            world: 120,
+            per_ip: 4,
+            admit_per_min: 60,
+            admit_burst: 10,
+            data_version: None,
+        }
+    }
+}
+
+impl QueueConfig {
+    pub fn from_env() -> Result<Self> {
+        Self::from_lookup(|k| std::env::var(k).ok())
+    }
+
+    /// [`from_env`](Self::from_env) over any lookup — tests pass a map instead of mutating the
+    /// process environment.
+    pub fn from_lookup(get: impl Fn(&str) -> Option<String>) -> Result<Self> {
+        let d = Self::default();
+        let get = |k: &str| get(k).map(|v| v.trim().to_string()).filter(|v| !v.is_empty());
+        fn num<T: std::str::FromStr>(name: &str, raw: Option<String>, default: T) -> Result<T> {
+            match raw {
+                None => Ok(default),
+                Some(v) => v
+                    .parse()
+                    .map_err(|_| anyhow!("{name} {v:?} is not a whole number")),
+            }
+        }
+        let cfg = Self {
+            enabled: get("QUEUE_ENABLED").map(|v| v == "1" || v.eq_ignore_ascii_case("true")).unwrap_or(false),
+            downloads: num("QUEUE_DOWNLOADS", get("QUEUE_DOWNLOADS"), d.downloads)?,
+            world: num("QUEUE_WORLD", get("QUEUE_WORLD"), d.world)?,
+            per_ip: num("QUEUE_PER_IP", get("QUEUE_PER_IP"), d.per_ip)?,
+            admit_per_min: num("QUEUE_ADMIT_PER_MIN", get("QUEUE_ADMIT_PER_MIN"), d.admit_per_min)?,
+            admit_burst: num("QUEUE_ADMIT_BURST", get("QUEUE_ADMIT_BURST"), d.admit_burst)?,
+            data_version: get("QUEUE_DATA_VERSION"),
+        };
+        if cfg.enabled && (cfg.downloads == 0 || cfg.world == 0 || cfg.admit_per_min == 0) {
+            return Err(anyhow!(
+                "QUEUE_DOWNLOADS, QUEUE_WORLD and QUEUE_ADMIT_PER_MIN must be at least 1 when QUEUE_ENABLED=1"
+            ));
+        }
+        Ok(cfg)
+    }
+}
+
+/// Which gate a ticket is waiting at (or went through last).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Gate {
+    Download,
+    World,
+}
+
+#[derive(Clone, Debug)]
+enum Stage {
+    WaitDownload,
+    Downloading { since: Instant },
+    WaitWorld,
+    /// Holds a world slot; the pass has not been used at `/api/play` yet.
+    Admitted { pass: String, issued: Instant },
+    /// Signed in; holds a world slot while it keeps polling.
+    InWorld { pass: String },
+}
+
+#[derive(Clone, Debug)]
+struct Ticket {
+    id: String,
+    seq: u64,
+    browser: i64,
+    user: i64,
+    ip: Option<String>,
+    stage: Stage,
+    returning: bool,
+    last_seen: Instant,
+    /// (when, position) samples for "Up N places in M min".
+    marks: VecDeque<(Instant, usize)>,
+}
+
+impl Ticket {
+    fn waiting_gate(&self) -> Option<Gate> {
+        match self.stage {
+            Stage::WaitDownload => Some(Gate::Download),
+            Stage::WaitWorld => Some(Gate::World),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Bucket {
+    tokens: f64,
+    at: Option<Instant>,
+}
+
+impl Bucket {
+    fn take(&mut self, now: Instant, per_min: u32, burst: u32) -> bool {
+        let burst = f64::from(burst.max(1));
+        let tokens = match self.at {
+            None => burst,
+            Some(at) => {
+                let dt = now.saturating_duration_since(at).as_secs_f64();
+                (self.tokens + dt * f64::from(per_min) / 60.0).min(burst)
+            }
+        };
+        self.at = Some(now);
+        if tokens >= 1.0 {
+            self.tokens = tokens - 1.0;
+            true
+        } else {
+            self.tokens = tokens;
+            false
+        }
+    }
+}
+
+#[derive(Default)]
+struct Inner {
+    tickets: HashMap<String, Ticket>,
+    by_browser: HashMap<i64, String>,
+    seq: u64,
+    buckets: [Option<Bucket>; 2],
+    admits: [VecDeque<Instant>; 2],
+    grants: HashMap<i64, Instant>,
+}
+
+/// What the page is told about its ticket.
+#[derive(Clone, Debug, Serialize)]
+pub struct View {
+    /// `"waiting"` or `"go"`.
+    pub status: &'static str,
+    pub ticket: String,
+    pub gate: Gate,
+    /// 1-based place at `gate` while waiting; 0 once through.
+    pub position: usize,
+    /// Everyone waiting at `gate`.
+    pub waiting: usize,
+    pub eta_secs: u64,
+    /// Places gained over the last `moved_secs`.
+    pub moved: usize,
+    pub moved_secs: u64,
+    /// The world pass for `/api/play` (`go` at the world gate only).
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub pass: Option<String>,
+    pub returning: bool,
+    pub in_world: usize,
+    pub world_max: usize,
+    /// The realm busy indicator: anyone waiting for the world, or the world 90% full.
+    pub busy: bool,
+}
+
+/// Counts, for the panel and the tests.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, Serialize)]
+pub struct Stats {
+    pub waiting_download: usize,
+    pub downloading: usize,
+    pub waiting_world: usize,
+    pub in_world: usize,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum JoinError {
+    /// This address already holds `QUEUE_PER_IP` waiting tickets.
+    IpCap,
+}
+
+pub struct Queue {
+    cfg: QueueConfig,
+    data_version: String,
+    inner: Mutex<Inner>,
+}
+
+impl Default for Queue {
+    fn default() -> Self {
+        Self::new(QueueConfig::default(), None)
+    }
+}
+
+impl Queue {
+    /// `www` names the static client folder the data version is derived from when
+    /// `QUEUE_DATA_VERSION` is unset.
+    pub fn new(cfg: QueueConfig, www: Option<&Path>) -> Self {
+        let data_version = cfg
+            .data_version
+            .clone()
+            .unwrap_or_else(|| derive_data_version(www));
+        Self {
+            cfg,
+            data_version,
+            inner: Mutex::default(),
+        }
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.cfg.enabled
+    }
+
+    pub fn config(&self) -> &QueueConfig {
+        &self.cfg
+    }
+
+    pub fn data_version(&self) -> &str {
+        &self.data_version
+    }
+
+    fn lock(&self) -> std::sync::MutexGuard<'_, Inner> {
+        self.inner.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// Take a place in line — or get back the one this browser already has. `returning` (a
+    /// verified marker) starts the ticket at the world gate with the data grant in hand.
+    pub fn join(
+        &self,
+        browser: i64,
+        user: i64,
+        ip: Option<&str>,
+        returning: bool,
+        now: Instant,
+    ) -> Result<View, JoinError> {
+        let mut g = self.lock();
+        self.pump(&mut g, now);
+        if let Some(id) = g.by_browser.get(&browser).cloned() {
+            if let Some(t) = g.tickets.get_mut(&id) {
+                t.last_seen = now;
+                if returning && matches!(t.stage, Stage::WaitDownload) {
+                    t.stage = Stage::WaitWorld;
+                    t.returning = true;
+                }
+                if !matches!(t.stage, Stage::WaitDownload) {
+                    g.grants.insert(user, now + DATA_GRANT);
+                }
+                self.pump(&mut g, now);
+                return Ok(self.view(&mut g, &id, now));
+            }
+        }
+        let ip = ip.filter(|s| !s.is_empty()).map(str::to_string);
+        if let Some(ip) = &ip {
+            let held = g
+                .tickets
+                .values()
+                .filter(|t| t.ip.as_deref() == Some(ip) && t.waiting_gate().is_some())
+                .count();
+            if held >= self.cfg.per_ip {
+                return Err(JoinError::IpCap);
+            }
+        }
+        g.seq += 1;
+        let id = crate::session::new_token();
+        let ticket = Ticket {
+            id: id.clone(),
+            seq: g.seq,
+            browser,
+            user,
+            ip,
+            stage: if returning {
+                Stage::WaitWorld
+            } else {
+                Stage::WaitDownload
+            },
+            returning,
+            last_seen: now,
+            marks: VecDeque::new(),
+        };
+        if returning {
+            g.grants.insert(user, now + DATA_GRANT);
+        }
+        g.tickets.insert(id.clone(), ticket);
+        g.by_browser.insert(browser, id.clone());
+        self.pump(&mut g, now);
+        Ok(self.view(&mut g, &id, now))
+    }
+
+    /// Poll (and so keep) a ticket. `None` when it is gone (expired, cancelled) or not this
+    /// browser's.
+    pub fn status(&self, browser: i64, ticket: &str, now: Instant) -> Option<View> {
+        let mut g = self.lock();
+        self.pump(&mut g, now);
+        let t = g.tickets.get_mut(ticket).filter(|t| t.browser == browser)?;
+        t.last_seen = now;
+        let user = t.user;
+        if !matches!(t.stage, Stage::WaitDownload) {
+            g.grants.insert(user, now + DATA_GRANT);
+        }
+        Some(self.view(&mut g, ticket, now))
+    }
+
+    /// The page finished the first download: the slot goes back and the ticket moves on to the
+    /// world gate, keeping its place in line.
+    pub fn download_done(&self, browser: i64, ticket: &str, now: Instant) -> Option<View> {
+        let mut g = self.lock();
+        self.pump(&mut g, now);
+        let t = g.tickets.get_mut(ticket).filter(|t| t.browser == browser)?;
+        t.last_seen = now;
+        if matches!(t.stage, Stage::Downloading { .. }) {
+            t.stage = Stage::WaitWorld;
+        }
+        self.pump(&mut g, now);
+        Some(self.view(&mut g, ticket, now))
+    }
+
+    /// Cancel: the place (and any slot) is given up.
+    pub fn leave(&self, browser: i64, ticket: &str) -> bool {
+        let mut g = self.lock();
+        match g.tickets.get(ticket) {
+            Some(t) if t.browser == browser => {
+                g.tickets.remove(ticket);
+                g.by_browser.remove(&browser);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// The world gate at sign-in: is `pass` this browser's live world pass? Using it moves the
+    /// ticket into the world.
+    pub fn check_world_pass(&self, browser: i64, pass: &str, now: Instant) -> bool {
+        use subtle::ConstantTimeEq;
+        let mut g = self.lock();
+        self.pump(&mut g, now);
+        let Some(id) = g.by_browser.get(&browser).cloned() else {
+            return false;
+        };
+        let Some(t) = g.tickets.get_mut(&id) else {
+            return false;
+        };
+        let same = |p: &str| -> bool { p.as_bytes().ct_eq(pass.as_bytes()).into() };
+        match &t.stage {
+            Stage::Admitted { pass: p, issued } if same(p) && now.saturating_duration_since(*issued) < PASS_TTL => {
+                t.stage = Stage::InWorld { pass: p.clone() };
+                t.last_seen = now;
+                true
+            }
+            Stage::InWorld { pass: p } if same(p) => {
+                t.last_seen = now;
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// The download gate: may this account read the game data now?
+    pub fn has_data_grant(&self, user: i64, now: Instant) -> bool {
+        let g = self.lock();
+        g.grants.get(&user).is_some_and(|until| *until > now)
+    }
+
+    pub fn stats(&self, now: Instant) -> Stats {
+        let mut g = self.lock();
+        self.pump(&mut g, now);
+        stats_of(&g)
+    }
+
+    /// Drop expired tickets, then let people through as slots free, at the steady rate.
+    fn pump(&self, g: &mut Inner, now: Instant) {
+        let expired: Vec<(String, i64)> = g
+            .tickets
+            .values()
+            .filter(|t| now.saturating_duration_since(t.last_seen) >= TICKET_TTL)
+            .map(|t| (t.id.clone(), t.browser))
+            .collect();
+        for (id, browser) in expired {
+            g.tickets.remove(&id);
+            if g.by_browser.get(&browser) == Some(&id) {
+                g.by_browser.remove(&browser);
+            }
+        }
+        if g.grants.len() > 10_000 {
+            g.grants.retain(|_, until| *until > now);
+        }
+        for t in g.tickets.values_mut() {
+            if let Stage::Downloading { since } = t.stage {
+                if now.saturating_duration_since(since) >= DOWNLOAD_MAX {
+                    t.stage = Stage::WaitWorld;
+                }
+            }
+        }
+        for q in g.admits.iter_mut() {
+            while q.front().is_some_and(|at| now.saturating_duration_since(*at) > RATE_WINDOW) {
+                q.pop_front();
+            }
+        }
+        // download gate
+        loop {
+            let used = g
+                .tickets
+                .values()
+                .filter(|t| matches!(t.stage, Stage::Downloading { .. }))
+                .count();
+            if used >= self.cfg.downloads {
+                break;
+            }
+            let Some(id) = head(g, Gate::Download) else { break };
+            if !self.take_token(g, 0, now) {
+                break;
+            }
+            let t = g.tickets.get_mut(&id).expect("head is live");
+            t.stage = Stage::Downloading { since: now };
+            let user = t.user;
+            g.grants.insert(user, now + DATA_GRANT);
+            g.admits[0].push_back(now);
+        }
+        // world gate
+        loop {
+            let used = g
+                .tickets
+                .values()
+                .filter(|t| matches!(t.stage, Stage::Admitted { .. } | Stage::InWorld { .. }))
+                .count();
+            if used >= self.cfg.world {
+                break;
+            }
+            let Some(id) = head(g, Gate::World) else { break };
+            if !self.take_token(g, 1, now) {
+                break;
+            }
+            let t = g.tickets.get_mut(&id).expect("head is live");
+            t.stage = Stage::Admitted {
+                pass: crate::session::new_token(),
+                issued: now,
+            };
+            g.admits[1].push_back(now);
+        }
+    }
+
+    fn take_token(&self, g: &mut Inner, gate: usize, now: Instant) -> bool {
+        let b = g.buckets[gate].get_or_insert(Bucket {
+            tokens: 0.0,
+            at: None,
+        });
+        b.take(now, self.cfg.admit_per_min, self.cfg.admit_burst)
+    }
+
+    /// Admissions per second at a gate: measured when there is enough history, else a guess
+    /// from the slot count (a first download takes about two minutes, a play session about
+    /// half an hour), never above the configured pace.
+    fn rate(&self, g: &Inner, gate: Gate, now: Instant) -> f64 {
+        let pace = f64::from(self.cfg.admit_per_min) / 60.0;
+        let q = &g.admits[gate as usize];
+        let measured = if q.len() >= 3 {
+            let span = now
+                .saturating_duration_since(*q.front().expect("len >= 3"))
+                .as_secs_f64()
+                .max(60.0);
+            Some(q.len() as f64 / span)
+        } else {
+            None
+        };
+        let guess = match gate {
+            Gate::Download => self.cfg.downloads as f64 / 120.0,
+            Gate::World => self.cfg.world as f64 / 1800.0,
+        };
+        measured.unwrap_or(guess).min(pace).max(1e-3)
+    }
+
+    fn view(&self, g: &mut Inner, id: &str, now: Instant) -> View {
+        let stats = stats_of(g);
+        let t = g.tickets.get(id).expect("view of a live ticket").clone();
+        let busy = stats.waiting_world > 0 || stats.in_world * 10 >= self.cfg.world * 9;
+        let base = |status, gate, pass| View {
+            status,
+            ticket: t.id.clone(),
+            gate,
+            position: 0,
+            waiting: 0,
+            eta_secs: 0,
+            moved: 0,
+            moved_secs: 0,
+            pass,
+            returning: t.returning,
+            in_world: stats.in_world,
+            world_max: self.cfg.world,
+            busy,
+        };
+        match &t.stage {
+            Stage::Downloading { .. } => base("go", Gate::Download, None),
+            Stage::Admitted { pass, issued } => {
+                if now.saturating_duration_since(*issued) >= PASS_TTL {
+                    // a fresh pass for a page that came back late (it still holds the slot)
+                    let fresh = crate::session::new_token();
+                    if let Some(tm) = g.tickets.get_mut(id) {
+                        tm.stage = Stage::Admitted {
+                            pass: fresh.clone(),
+                            issued: now,
+                        };
+                    }
+                    base("go", Gate::World, Some(fresh))
+                } else {
+                    base("go", Gate::World, Some(pass.clone()))
+                }
+            }
+            Stage::InWorld { pass } => base("go", Gate::World, Some(pass.clone())),
+            Stage::WaitDownload | Stage::WaitWorld => {
+                let gate = t.waiting_gate().expect("waiting");
+                let ahead = g
+                    .tickets
+                    .values()
+                    .filter(|o| o.waiting_gate() == Some(gate) && o.seq < t.seq)
+                    .count();
+                let waiting = g
+                    .tickets
+                    .values()
+                    .filter(|o| o.waiting_gate() == Some(gate))
+                    .count();
+                let position = ahead + 1;
+                let eta = (position as f64 / self.rate(g, gate, now)).ceil() as u64;
+                let tm = g.tickets.get_mut(id).expect("live");
+                while tm.marks.front().is_some_and(|(at, _)| now.saturating_duration_since(*at) > MOVED_WINDOW) {
+                    tm.marks.pop_front();
+                }
+                // a sample at most every 10 s keeps the history small
+                if tm.marks.back().is_none_or(|(at, _)| now.saturating_duration_since(*at) >= Duration::from_secs(10)) {
+                    tm.marks.push_back((now, position));
+                }
+                let (moved, moved_secs) = match tm.marks.front() {
+                    Some((at, p)) => (p.saturating_sub(position), now.saturating_duration_since(*at).as_secs()),
+                    None => (0, 0),
+                };
+                View {
+                    position,
+                    waiting,
+                    eta_secs: eta.min(6 * 3600),
+                    moved,
+                    moved_secs,
+                    ..base("waiting", gate, None)
+                }
+            }
+        }
+    }
+}
+
+fn head(g: &Inner, gate: Gate) -> Option<String> {
+    g.tickets
+        .values()
+        .filter(|t| t.waiting_gate() == Some(gate))
+        .min_by_key(|t| t.seq)
+        .map(|t| t.id.clone())
+}
+
+fn stats_of(g: &Inner) -> Stats {
+    let mut s = Stats::default();
+    for t in g.tickets.values() {
+        match t.stage {
+            Stage::WaitDownload => s.waiting_download += 1,
+            Stage::Downloading { .. } => s.downloading += 1,
+            Stage::WaitWorld => s.waiting_world += 1,
+            Stage::Admitted { .. } | Stage::InWorld { .. } => s.in_world += 1,
+        }
+    }
+    s
+}
+
+/// The data version when `QUEUE_DATA_VERSION` is unset: the wasm bundle's size and mtime and
+/// the boot manifest's bytes — what a new client build changes.
+fn derive_data_version(www: Option<&Path>) -> String {
+    let Some(www) = www else { return "1".into() };
+    let mut h = Sha256::new();
+    let mut any = false;
+    if let Ok(m) = std::fs::metadata(www.join("wenilla_bg.wasm")) {
+        any = true;
+        h.update(m.len().to_le_bytes());
+        if let Ok(t) = m.modified() {
+            if let Ok(d) = t.duration_since(std::time::UNIX_EPOCH) {
+                h.update(d.as_secs().to_le_bytes());
+            }
+        }
+    }
+    if let Ok(b) = std::fs::read(www.join("boot-manifest.json")) {
+        any = true;
+        h.update(&b);
+    }
+    if !any {
+        return "1".into();
+    }
+    hex::encode(&h.finalize()[..6])
+}
+
+// ---------------------------------------------------------------------------------------------
+// The returning-player marker: sealed by the realm when a download finishes, kept by the page
+// (localStorage `ov-data`), shown back at join. It names the account and the data version, so it
+// cannot be minted by hand nor carried to another account, and a new client build retires it.
+
+const MARKER_TAG: &str = "ovq1";
+
+pub fn seal_marker(keys: &crate::secrets::Keyring, user: i64, version: &str) -> Result<String> {
+    let (ct, nonce) = keys.encrypt(format!("{MARKER_TAG}|{user}|{version}").as_bytes())?;
+    let mut b = nonce;
+    b.extend_from_slice(&ct);
+    Ok(base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(b))
+}
+
+pub fn open_marker(keys: &crate::secrets::Keyring, marker: &str) -> Result<(i64, String)> {
+    let raw = base64::engine::general_purpose::URL_SAFE_NO_PAD
+        .decode(marker.trim())
+        .context("marker is not base64")?;
+    if raw.len() < 12 + 16 {
+        return Err(anyhow!("marker too short"));
+    }
+    let plain = keys.decrypt(&raw[12..], &raw[..12])?;
+    let s = String::from_utf8(plain).context("marker")?;
+    let mut it = s.splitn(3, '|');
+    match (it.next(), it.next(), it.next()) {
+        (Some(MARKER_TAG), Some(user), Some(version)) => Ok((user.parse()?, version.to_string())),
+        _ => Err(anyhow!("not a queue marker")),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// HTTP
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/api/queue/join", post(join))
+        .route("/api/queue/status", get(status))
+        .route("/api/queue/done", post(done))
+        .route("/api/queue/leave", post(leave))
+}
+
+fn json(code: StatusCode, body: serde_json::Value) -> Response {
+    let mut r = (code, Json(body)).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+fn not_enabled() -> Response {
+    json(StatusCode::NOT_FOUND, serde_json::json!({ "error": "the queue is off" }))
+}
+
+fn gone() -> Response {
+    json(StatusCode::NOT_FOUND, serde_json::json!({ "status": "expired" }))
+}
+
+/// The page's own JSON mutations carry `X-Requested-With: wenilla` (a cross-site form cannot).
+fn from_page(headers: &HeaderMap) -> bool {
+    headers
+        .get("x-requested-with")
+        .and_then(|v| v.to_str().ok())
+        .is_some_and(|v| v == "wenilla")
+}
+
+fn view_json(v: &View) -> Response {
+    json(StatusCode::OK, serde_json::to_value(v).unwrap_or_default())
+}
+
+#[derive(Deserialize, Default)]
+struct JoinBody {
+    #[serde(default)]
+    marker: Option<String>,
+}
+
+async fn join(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    body: Option<Json<JoinBody>>,
+) -> Response {
+    if !state.queue.enabled() {
+        return not_enabled();
+    }
+    if !from_page(&headers) {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    if !state.limiter.allow(&format!("qjoin:{}", session.id), 20, 60) {
+        return json(StatusCode::TOO_MANY_REQUESTS, serde_json::json!({ "error": "slow down" }));
+    }
+    let marker = body.and_then(|Json(b)| b.marker);
+    let returning = marker
+        .as_deref()
+        .and_then(|m| open_marker(&state.secrets, m).ok())
+        .is_some_and(|(user, version)| user == session.user.id && version == state.queue.data_version());
+    let ip = client_ip(&headers);
+    match state.queue.join(session.id, session.user.id, ip.as_deref(), returning, Instant::now()) {
+        Ok(v) => {
+            let mut body = serde_json::to_value(&v).unwrap_or_default();
+            body["data_version"] = state.queue.data_version().into();
+            json(StatusCode::OK, body)
+        }
+        Err(JoinError::IpCap) => json(
+            StatusCode::TOO_MANY_REQUESTS,
+            serde_json::json!({ "error": "ip_cap", "message": "Too many people are already waiting from your network. Try again in a few minutes." }),
+        ),
+    }
+}
+
+#[derive(Deserialize)]
+struct TicketQuery {
+    ticket: String,
+}
+
+async fn status(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    Query(q): Query<TicketQuery>,
+) -> Response {
+    if !state.queue.enabled() {
+        return not_enabled();
+    }
+    if !state.limiter.allow(&format!("qstat:{}", session.id), 60, 60) {
+        return json(StatusCode::TOO_MANY_REQUESTS, serde_json::json!({ "error": "slow down" }));
+    }
+    match state.queue.status(session.id, &q.ticket, Instant::now()) {
+        Some(v) => view_json(&v),
+        None => gone(),
+    }
+}
+
+#[derive(Deserialize)]
+struct TicketBody {
+    ticket: String,
+}
+
+async fn done(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<TicketBody>,
+) -> Response {
+    if !state.queue.enabled() {
+        return not_enabled();
+    }
+    if !from_page(&headers) {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    let Some(v) = state.queue.download_done(session.id, &b.ticket, Instant::now()) else {
+        return gone();
+    };
+    let mut body = serde_json::to_value(&v).unwrap_or_default();
+    match seal_marker(&state.secrets, session.user.id, state.queue.data_version()) {
+        Ok(m) => body["marker"] = m.into(),
+        Err(e) => tracing::warn!(error = %e, "queue marker"),
+    }
+    body["data_version"] = state.queue.data_version().into();
+    json(StatusCode::OK, body)
+}
+
+async fn leave(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<TicketBody>,
+) -> Response {
+    if !state.queue.enabled() {
+        return not_enabled();
+    }
+    if !from_page(&headers) {
+        return StatusCode::FORBIDDEN.into_response();
+    }
+    state.queue.leave(session.id, &b.ticket);
+    StatusCode::NO_CONTENT.into_response()
+}
+
+/// Middleware on the game routes (inside the session layer): with the queue on, the game data
+/// (`/data/*`) and the wasm bundle need the account's data grant.
+pub async fn data_gate(State(state): State<Arc<AppState>>, req: Request, next: Next) -> Response {
+    if state.queue.enabled() {
+        let p = req.uri().path();
+        if p.starts_with("/data/") || p.ends_with(".wasm") {
+            let user = req.extensions().get::<Session>().map(|s| s.user.id);
+            let ok = user.is_some_and(|u| state.queue.has_data_grant(u, Instant::now()));
+            if !ok {
+                let mut r = (
+                    StatusCode::FORBIDDEN,
+                    "wait for your turn in the queue — reload the page",
+                )
+                    .into_response();
+                r.headers_mut()
+                    .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+                return r;
+            }
+        }
+    }
+    next.run(req).await
+}
+
+/// The world gate at sign-in (`/api/play`): `None` lets the request through.
+pub fn world_gate(state: &AppState, session: &Session, headers: &HeaderMap) -> Option<Response> {
+    if !state.queue.enabled() {
+        return None;
+    }
+    let pass = headers
+        .get("x-queue-pass")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("");
+    if !pass.is_empty() && state.queue.check_world_pass(session.id, pass, Instant::now()) {
+        return None;
+    }
+    Some(json(
+        StatusCode::FORBIDDEN,
+        serde_json::json!({ "error": "queue", "message": "the realm is full: join the queue first" }),
+    ))
+}
