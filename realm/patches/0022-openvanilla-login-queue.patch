+#[tokio::test]
+async fn queue_off_changes_nothing() {
+    let h = harness(QueueConfig::default()).await;
+    let (_, cookie) = player(&h, "alice").await;
+    let r = send(&h.app, page("/", &cookie)).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(!r.body.contains("id=\"ovq\""), "no queue window");
+    assert!(!r.body.contains("/api/queue/"), "no queue calls");
+    assert!(r.body.contains("await signIn(null);"));
+    let r = send(&h.app, post_json("/api/queue/join", &cookie, "192.0.2.1", serde_json::json!({}))).await;
+    assert_eq!(r.status, StatusCode::NOT_FOUND);
+    let r = send(&h.app, play(&cookie, None)).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert!(r.json()["pass"].as_str().is_some());
+    // the data route answers as it always did (503: no client data in tests), not 403
+    let r = send(&h.app, get("/data/DBFilesClient%5CMap.dbc", &cookie)).await;
+    assert_eq!(r.status, StatusCode::SERVICE_UNAVAILABLE);
+    let r = send(&h.app, get("/wenilla_bg.wasm", &cookie)).await;
+    assert_eq!(r.status, StatusCode::OK);
+}
