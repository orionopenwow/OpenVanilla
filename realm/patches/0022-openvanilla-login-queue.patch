+#[tokio::test]
+async fn per_ip_cap_over_http() {
+    let mut cfg = on(1, 100);
+    cfg.per_ip = 1;
+    let h = harness(cfg).await;
+    let mut codes = Vec::new();
+    for name in ["p1", "p2", "p3"] {
+        let (_, c) = player(&h, name).await;
+        codes.push(send(&h.app, post_json("/api/queue/join", &c, "198.51.100.7", serde_json::json!({}))).await.status);
+    }
+    // p1 downloads, p2 waits (the one waiting ticket this address may hold), p3 is refused
+    assert_eq!(codes, [StatusCode::OK, StatusCode::OK, StatusCode::TOO_MANY_REQUESTS]);
+}
