+++ b/crates/wenilla-realm/src/auth/google.rs
@@ -0,0 +1,160 @@
+//! Google sign-in (Open Vanilla), the second external provider next to Discord: OpenID Connect,
+//! authorization code flow. Only the `openid profile` scopes are asked for: the realm learns the
+//! Google account's stable id and display name, never its e-mail address.
+//!
+//! Environment (the provider is on when both are set):
+//!   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   an OAuth client of type "Web application" in Google
+//!                                            Cloud Console, with the redirect URI
+//!                                            <public url>/auth/google/callback
+//!   GOOGLE_AUTHORIZE_URL, GOOGLE_TOKEN_URL, GOOGLE_USERINFO_URL   overrides (tests point them at a mock)
+
+use anyhow::{anyhow, bail, Context, Result};
+use async_trait::async_trait;
+use serde::Deserialize;
+
+use super::provider::{Identity, IdentityProvider};
+
+pub struct Google {
+    client_id: String,
+    client_secret: String,
+    authorize: String,
+    token: String,
+    userinfo: String,
+    http: reqwest::Client,
+}
+
+fn env(name: &str) -> Option<String> {
+    std::env::var(name).ok().map(|v| v.trim().to_string()).filter(|v| !v.is_empty())
+}
+
+impl Google {
+    /// `None` unless the OAuth client id and secret are configured.
+    pub fn from_env() -> Result<Option<Self>> {
+        let (Some(client_id), Some(client_secret)) = (env("GOOGLE_CLIENT_ID"), env("GOOGLE_CLIENT_SECRET")) else {
+            return Ok(None);
+        };
+        if !client_id.ends_with(".apps.googleusercontent.com") {
+            bail!("GOOGLE_CLIENT_ID should end in .apps.googleusercontent.com; got {client_id:?}");
+        }
+        Ok(Some(Self {
+            client_id,
+            client_secret,
+            authorize: env("GOOGLE_AUTHORIZE_URL").unwrap_or_else(|| "https://accounts.google.com/o/oauth2/v2/auth".into()),
+            token: env("GOOGLE_TOKEN_URL").unwrap_or_else(|| "https://oauth2.googleapis.com/token".into()),
+            userinfo: env("GOOGLE_USERINFO_URL")
+                .unwrap_or_else(|| "https://openidconnect.googleapis.com/v1/userinfo".into()),
+            http: reqwest::Client::builder()
+                .timeout(std::time::Duration::from_secs(15))
+                .user_agent("wenilla-realm (Open Vanilla Google sign-in)")
+                .build()?,
+        }))
+    }
+}
+
+/// Google's `sub`: a stable account id of up to 255 ASCII characters (digits in practice).
+fn valid_subject(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 255 && s.bytes().all(|b| b.is_ascii_alphanumeric())
+}
+
+#[async_trait]
+impl IdentityProvider for Google {
+    fn id(&self) -> &str {
+        "google"
+    }
+
+    fn label(&self) -> &str {
+        "Google"
+    }
+
+    fn authorize_url(&self, state: &str, _pkce: Option<&str>, redirect_uri: &str) -> url::Url {
+        let mut u = url::Url::parse(&self.authorize).expect("authorize URL");
+        u.query_pairs_mut()
+            .append_pair("client_id", &self.client_id)
+            .append_pair("response_type", "code")
+            .append_pair("redirect_uri", redirect_uri)
+            .append_pair("scope", "openid profile")
+            .append_pair("state", state)
+            .append_pair("prompt", "select_account");
+        u
+    }
+
+    async fn callback(&self, code: &str, _pkce: Option<&str>, redirect_uri: &str) -> Result<Identity> {
+        #[derive(Deserialize)]
+        struct Token {
+            access_token: String,
+        }
+        let token: Token = json(
+            self.http
+                .post(&self.token)
+                .form(&[
+                    ("grant_type", "authorization_code"),
+                    ("code", code),
+                    ("redirect_uri", redirect_uri),
+                    ("client_id", self.client_id.as_str()),
+                    ("client_secret", self.client_secret.as_str()),
+                ])
+                .send()
+                .await?
+                .error_for_status()
+                .map_err(|e| anyhow!("Google refused the sign-in code: {e}"))?,
+        )
+        .await?;
+        #[derive(Deserialize)]
+        struct Me {
+            sub: String,
+            name: Option<String>,
+            given_name: Option<String>,
+        }
+        let me: Me = json(
+            self.http
+                .get(&self.userinfo)
+                .bearer_auth(&token.access_token)
+                .send()
+                .await?
+                .error_for_status()?,
+        )
+        .await?;
+        if !valid_subject(&me.sub) {
+            bail!("Google returned an unexpected account id");
+        }
+        let name = me
+            .given_name
+            .filter(|n| !n.trim().is_empty())
+            .or(me.name.filter(|n| !n.trim().is_empty()))
+            .unwrap_or_else(|| "Adventurer".into());
+        Ok(Identity { provider: "google".into(), subject: me.sub, display_name: name, email: None })
+    }
+}
+
+/// reqwest is built without its `json` feature here; decode by hand.
+async fn json<T: serde::de::DeserializeOwned>(resp: reqwest::Response) -> Result<T> {
+    let text = resp.text().await?;
+    serde_json::from_str(&text).context("unexpected reply from Google")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn subjects() {
+        assert!(valid_subject("110169484474386276334"));
+        assert!(!valid_subject(""));
+        assert!(!valid_subject("1 2"));
+        assert!(!valid_subject(&"9".repeat(300)));
+    }
+
+    #[test]
+    fn authorize_url_asks_for_name_only() {
+        std::env::set_var("GOOGLE_CLIENT_ID", "123-abc.apps.googleusercontent.com");
+        std::env::set_var("GOOGLE_CLIENT_SECRET", "s");
+        let g = Google::from_env().unwrap().unwrap();
+        let u = g.authorize_url("st", None, "https://play.example/auth/google/callback").to_string();
+        assert!(u.starts_with("https://accounts.google.com/o/oauth2/v2/auth?"));
+        assert!(u.contains("scope=openid+profile"));
+        assert!(!u.contains("email"));
+        assert!(u.contains("state=st"));
+        std::env::remove_var("GOOGLE_CLIENT_ID");
+        std::env::remove_var("GOOGLE_CLIENT_SECRET");
+    }
+}
