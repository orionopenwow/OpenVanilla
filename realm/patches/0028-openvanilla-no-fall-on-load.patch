     } else if player.world_stale || progressed {
         player.settle_deadline = now + SETTLE_TIMEOUT;
     } else if now >= player.settle_deadline {
-        player.end_settle(false, now);
+        // Open Vanilla: a stall gives up only over ground. With the body's own tile not resident or
+        // its colliders still pending, gravity would drop it through the world, so the hold keeps
+        // the body still until the hard cap instead.
+        let ground_under = p.focus_resident
+            && focus_matches
+            && p.colliders_pending == 0
+            && p.merge_pending == 0;
+        if ground_under || now - player.settle_since >= SETTLE_HARD_CAP {
+            player.end_settle(false, now);
+        } else {
+            player.settle_deadline = now + SETTLE_TIMEOUT;
+        }
     }
     // The worldport ack, the reference's post-load `0xDC`, goes at either end of the hold: the
     // server keeps an unacked transfer out of world until logout.
