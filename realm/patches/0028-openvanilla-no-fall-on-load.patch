+    /// "Fell through the world on login": a stream that stalls before the body's own tile has
+    /// ground must not turn gravity on over the hole at the stall budget; it holds to the hard cap.
+    #[test]
+    fn a_stall_with_no_ground_under_the_body_holds_until_the_hard_cap() {
+        let mut app = app();
+        app.world_mut().resource_mut::<Player>().world_stale = false;
+        let frozen = |p: &mut WorldLoadProgress| {
+            p.total = 2000;
+            p.ready = 500;
+            p.colliders_pending = 300;
+            p.scene_ready = false;
+            p.focus_resident = false;
+        };
+        let mut t = 0.0;
+        while t < SETTLE_HARD_CAP - 1.0 {
+            step(&mut app, 1.0, frozen);
+            t += 1.0;
+            assert!(
+                settling(&mut app),
+                "gravity came back at ~{t}s with no ground under the body"
+            );
+        }
+        for _ in 0..3 {
+            step(&mut app, 1.0, frozen);
+        }
+        assert!(
+            !settling(&mut app),
+            "a dead stream must still let go at the hard cap"
+        );
+    }
+
+    /// The tile is resident but its colliders are still pending: still a hole, still held.
+    #[test]
+    fn a_resident_tile_with_pending_colliders_is_not_ground() {
+        let mut app = app();
+        app.world_mut().resource_mut::<Player>().world_stale = false;
+        for _ in 0..(3.0 * SETTLE_TIMEOUT) as usize {
+            step(&mut app, 1.0, |p| {
+                p.total = 2000;
+                p.ready = 2000;
+                p.colliders_pending = 12;
+                p.scene_ready = true;
+                p.focus_resident = true;
+            });
+            assert!(settling(&mut app), "released over unattached colliders");
+        }
+        // The colliders land: presentable, released at once.
+        step(&mut app, 0.1, |p| p.colliders_pending = 0);
+        assert!(!settling(&mut app));
+    }
+
