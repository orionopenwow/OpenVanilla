     DEFAULT_COLLISION_HEIGHT, FEATHER_TERMINAL_VELOCITY, GRAVITY, HOVER_CLIMB_RATE, HOVER_HEIGHT,
-    SETTLE_TIMEOUT, STEP_UP_HEIGHT, TERMINAL_VELOCITY,
+    SETTLE_HARD_CAP, SETTLE_TIMEOUT, STEP_UP_HEIGHT, TERMINAL_VELOCITY,
