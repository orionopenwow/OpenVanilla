+    send(&h.app, form("/logout", Some(&sess), &[("_csrf", &csrf_of(&kp.body))])).await;
+    let (_, r) = sign_in(&h, None).await;
+    assert_eq!(r.location(), "/", "saved: Discord signs in as before until it is turned off");
+
+    // off: no Discord button, and Discord can't sign in at all
+    std::env::set_var("DISCORD_SIGNIN", "off");
+    let page = send(&h.app, get("/login", None)).await;
+    assert!(!page.body.contains("href=\"/auth/discord/start\"") && !page.body.contains("Sign in with Discord"), "{}", page.body);
