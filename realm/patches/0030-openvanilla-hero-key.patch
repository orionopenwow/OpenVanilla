+#[tokio::test]
+async fn a_hero_key_signs_in_anywhere_and_a_new_key_stops_the_old_one() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let (sess, page) = new_guest(&h).await;
+    let key = key_on(&page.body);
+    let csrf = csrf_of(&page.body);
+    let uid: (i64,) = sqlx::query_as("SELECT user_id FROM hero_keys").fetch_one(&h.state.db).await.unwrap();
+
+    // "I have a Hero Key", from another device: the page, then the key (a whole file works too)
+    let p = send(&h.app, get("/key", None)).await;
+    assert!(p.body.contains("Drop your key file here") && p.body.contains("action=\"/auth/key\""), "{}", p.body);
+    let file = format!("Open Vanilla Hero Key\n\nKeep it private.\n-----BEGIN OPEN VANILLA HERO KEY-----\n{key}\n-----END OPEN VANILLA HERO KEY-----\n");
+    let mut req = form("/auth/key", None, &[("key", &file)]);
+    req.headers_mut().insert(header::USER_AGENT, "Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) Version/18.0 Mobile/15E148 Safari/604.1".parse().unwrap());
+    let r = send(&h.app, req).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    assert_eq!(r.location(), "/account/key?back=1");
+    let other = named(&r, "wr_session").expect("signed in with the key");
+    let back = send(&h.app, get("/account/key?back=1", Some(&other))).await;
+    assert!(back.body.contains("Welcome back") && back.body.contains("Signed in with your Hero Key") && back.body.contains("Last used"), "{}", back.body);
+    let (first, last, ua): (Option<i64>, Option<i64>, Option<String>) =
+        sqlx::query_as("SELECT first_used_at, last_used_at, last_used_ua FROM hero_keys WHERE revoked_at IS NULL").fetch_one(&h.state.db).await.unwrap();
+    assert!(first.is_some() && last.is_some());
+    assert_eq!(ua.as_deref(), Some("Safari on iPhone"), "the device, nothing more");
+    let who: (i64,) = sqlx::query_as("SELECT user_id FROM sessions ORDER BY id DESC LIMIT 1").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(who.0, uid.0, "the key's own account");
+
+    // a wrong key is refused, and says why in plain words
+    let r = send(&h.app, form("/auth/key", None, &[("key", &format!("{}X", &key[..key.len() - 1]))])).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(r.body.contains("That Hero Key didn") && named(&r, "wr_session").is_none(), "{}", r.body);
+    let r = send(&h.app, form("/auth/key", None, &[("key", "hello")])).await;
+    assert!(r.body.contains("look like a Hero Key"), "{}", r.body);
+
+    // a new key needs the form token, and revokes the old one at once
+    let r = send(&h.app, form("/account/key/new", Some(&sess), &[("_csrf", "nope")])).await;
+    assert_eq!(r.status, StatusCode::FORBIDDEN);
+    let r = send(&h.app, form("/account/key/new", Some(&sess), &[("_csrf", &csrf)])).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    let shown = named(&r, "wr_herokey");
+    let fresh = key_on(&send(&h.app, get("/account/key", Some(&with(&sess, &shown)))).await.body);
+    assert_ne!(fresh, key);
+    let r = send(&h.app, form("/auth/key", None, &[("key", &key)])).await;
+    assert!(r.body.contains("That Hero Key didn"), "the old key no longer works");
+    let r = send(&h.app, form("/auth/key", None, &[("key", &fresh)])).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER);
+    let (working,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM hero_keys WHERE revoked_at IS NULL").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(working, 1, "one working key per account");
+
+    // a disabled account's key stops working
+    sqlx::query("UPDATE users SET disabled = 1 WHERE id = ?").bind(uid.0).execute(&h.state.db).await.unwrap();
+    let r = send(&h.app, form("/auth/key", None, &[("key", &fresh)])).await;
+    assert!(named(&r, "wr_session").is_none());
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
