+#[tokio::test]
+async fn hero_key_sign_in_is_rate_limited_and_same_site_only() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let bogus = format!("ovk1.abcdefghij.{}", "A".repeat(43));
+    for _ in 0..10 {
+        let r = send(&h.app, form("/auth/key", None, &[("key", &bogus)])).await;
+        assert!(r.body.contains("That Hero Key didn"), "{}", r.body);
+    }
+    let r = send(&h.app, form("/auth/key", None, &[("key", &bogus)])).await;
+    assert!(r.body.contains("Too many tries with that key"), "per key: {}", r.body);
+    for i in 0..9 {
+        let k = format!("ovk1.abcdefgh{i:02}.{}", "B".repeat(43));
+        send(&h.app, form("/auth/key", None, &[("key", &k)])).await;
+    }
+    let r = send(&h.app, form("/auth/key", None, &[("key", "ovk1.zzzzzzzzzz.CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC")])).await;
+    assert!(r.body.contains("Too many tries"), "per network: {}", r.body);
+    // a page elsewhere can't sign a visitor in with a key it planted
+    let req = Request::post("/auth/key")
+        .header(header::CONTENT_TYPE, "application/x-www-form-urlencoded")
+        .header("x-forwarded-for", "198.51.100.9")
+        .header("origin", "https://evil.example")
+        .body(Body::from(format!("key={}", urlenc(&bogus))))
+        .unwrap();
+    let r = send(&h.app, req).await;
+    assert!(r.body.contains("Open the realm") && named(&r, "wr_session").is_none(), "{}", r.body);
+}
