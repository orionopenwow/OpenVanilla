+-- Open Vanilla: Hero Keys. A Hero Key is an account's own sign-in, written as one line of text the
+-- player keeps (ovk1.<key_id>.<secret>). Only the key id and a SHA-256 of the secret are kept here;
+-- the secret itself is shown once, when the key is made. One working key per account: a new key
+-- revokes the old one at once.
+CREATE TABLE hero_keys (
+  id INTEGER PRIMARY KEY,
+  user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+  key_id TEXT NOT NULL UNIQUE,
+  secret_hash BLOB NOT NULL,
+  created_at INTEGER NOT NULL,
+  saved_at INTEGER,
+  first_used_at INTEGER,
+  last_used_at INTEGER,
+  last_used_ua TEXT,
+  revoked_at INTEGER
+);
+CREATE INDEX hero_keys_user ON hero_keys(user_id);
+CREATE UNIQUE INDEX hero_keys_one_working ON hero_keys(user_id) WHERE revoked_at IS NULL;
+-- "Remind me later" on the in-game reminder: not before this time.
+ALTER TABLE users ADD COLUMN hero_key_snooze_until INTEGER;
