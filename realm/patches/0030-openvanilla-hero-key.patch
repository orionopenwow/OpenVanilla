+// -- Open Vanilla: Hero Keys (auth::herokey) -------------------------------------------------------
+
+fn key_on(html: &str) -> String {
+    let i = html.find("id=\"keytext\">").expect("a key on the page") + "id=\"keytext\">".len();
+    html[i..].split('<').next().unwrap().trim().to_string()
+}
+
+/// A new guest (Hero Keys are about them first): (session cookie, the key page).
+async fn new_guest(h: &Harness) -> (String, Resp) {
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert_eq!(r.location(), "/account/key", "{}", r.body);
+    let sess = named(&r, "wr_session").expect("signed in");
+    let page = send(&h.app, get("/account/key", Some(&sess))).await;
+    assert_eq!(page.status, StatusCode::OK, "{}", page.body);
+    (sess, page)
+}
+
+fn with(a: &str, b: &Option<String>) -> String {
+    match b {
+        Some(b) => format!("{a}; {b}"),
+        None => a.to_string(),
+    }
+}
+
+async fn ask(h: &Harness, sess: &str) -> serde_json::Value {
+    let mut req = get("/api/herokey", Some(sess));
+    req.headers_mut().insert(header::ACCEPT, "application/json".parse().unwrap());
+    let r = send(&h.app, req).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    serde_json::from_str(&r.body).unwrap()
+}
+
+#[tokio::test]
+async fn a_new_guest_gets_a_hero_key_shown_once_and_stored_only_as_a_hash() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let (sess, page) = new_guest(&h).await;
+    assert!(page.body.contains("Your Hero Key") && page.body.contains("Download file") && page.body.contains("Copy as text"), "{}", page.body);
+    assert!(page.body.contains("It's your sign-in") && !page.body.to_lowercase().contains("crypto"));
+    let key = key_on(&page.body);
+    assert!(key.starts_with("ovk1.") && key.len() == 5 + 10 + 1 + 43, "{key}");
+    let shown = named(&page, "wr_herokey").expect("the key rides to a reload, encrypted");
+    assert!(!shown.contains(&key[16..]), "the cookie is not the key in the clear");
+
+    // only the id and a hash are kept; the secret is nowhere in the database
+    let (id, hash): (String, Vec<u8>) = sqlx::query_as("SELECT key_id, secret_hash FROM hero_keys").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(id, &key[5..15]);
+    assert_eq!(hash.len(), 32);
+    let secret = &key[16..];
+    for (table, col) in [("hero_keys", "key_id"), ("audit", "detail"), ("audit", "target"), ("identities", "subject"), ("meta", "value")] {
+        let hits: (i64,) = sqlx::query_as(&format!("SELECT COUNT(*) FROM {table} WHERE {col} LIKE ?")).bind(format!("%{secret}%")).fetch_one(&h.state.db).await.unwrap();
+        assert_eq!(hits.0, 0, "secret found in {table}");
+    }
+
+    // a reload within 15 minutes shows the same key; without that cookie it is never shown again
+    let again = send(&h.app, get("/account/key", Some(&with(&sess, &Some(shown))))).await;
+    assert_eq!(key_on(&again.body), key);
+    let later = send(&h.app, get("/account/key", Some(&sess))).await;
+    assert!(!later.body.contains("id=\"keytext\"") && !later.body.contains(secret), "{}", later.body);
+    assert!(later.body.contains("can't be shown again") && later.body.contains("Make a new key"), "{}", later.body);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
