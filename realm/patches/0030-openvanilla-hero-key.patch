+    std::env::remove_var("DISCORD_SIGNIN");
+    std::env::remove_var("DISCORD_RETIRE_DATE");
+    let page = send(&h.app, get("/login", None)).await;
+    assert!(page.body.contains("Sign in with Discord") && !page.body.contains("retiring"), "on by default");
+}
