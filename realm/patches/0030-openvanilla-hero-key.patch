+#[tokio::test]
+async fn the_game_asks_until_the_key_is_saved_or_snoozed() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+
+    // a Discord player: no key yet, so the game asks, saying Discord sign-in is retiring
+    let (dsess, _) = sign_in(&h, None).await;
+    let j = ask(&h, &dsess).await;
+    assert_eq!(j["ask"], true, "{j}");
+    assert_eq!(j["kind"], "discord");
+    assert!(j["line"].as_str().unwrap().contains("Discord sign-in is retiring"), "{j}");
+    // the window makes the key itself (form token required), then says it's saved
+    let csrf = j["csrf"].as_str().unwrap().to_string();
+    let mut req = form("/account/key/mint.json", Some(&dsess), &[("_csrf", "nope")]);
+    req.headers_mut().insert("x-requested-with", "wenilla".parse().unwrap());
+    assert_eq!(send(&h.app, req).await.status, StatusCode::FORBIDDEN);
+    let mut req = form("/account/key/mint.json", Some(&dsess), &[("_csrf", &csrf)]);
+    req.headers_mut().insert("x-requested-with", "wenilla".parse().unwrap());
+    let r = send(&h.app, req).await;
+    let key = serde_json::from_str::<serde_json::Value>(&r.body).unwrap()["key"].as_str().unwrap().to_string();
+    assert!(key.starts_with("ovk1."));
+    assert_eq!(ask(&h, &dsess).await["ask"], true, "made but not saved yet");
+    let mut req = form("/account/key/saved", Some(&dsess), &[("_csrf", &csrf)]);
+    req.headers_mut().insert("x-requested-with", "wenilla".parse().unwrap());
+    let r = send(&h.app, req).await;
+    assert!(r.body.contains("\"saved\":true"), "{}", r.body);
+    assert_eq!(ask(&h, &dsess).await["ask"], false, "saved: no more asking");
+
+    // a guest who says "later" isn't asked again for a day
+    let (gsess, page) = new_guest(&h).await;
+    let gcsrf = csrf_of(&page.body);
+    let j = ask(&h, &gsess).await;
+    assert_eq!(j["kind"], "guest");
+    assert!(j["line"].as_str().unwrap().contains("only in this browser"));
+    let r = send(&h.app, form("/account/key/later", Some(&gsess), &[("_csrf", "nope")])).await;
+    assert_eq!(r.status, StatusCode::FORBIDDEN);
+    send(&h.app, form("/account/key/later", Some(&gsess), &[("_csrf", &gcsrf)])).await;
+    assert_eq!(ask(&h, &gsess).await["ask"], false);
+
+    // the play page carries the window and the Hero Key link
+    let play = send(&h.app, get("/", Some(&dsess))).await;
+    assert!(play.body.contains("id=\"ovk\"") && play.body.contains("/api/herokey") && play.body.contains("🔑 Hero Key"), "{}", play.body);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
