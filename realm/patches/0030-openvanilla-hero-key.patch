diff --git a/crates/wenilla-realm/src/auth/herokey.rs b/crates/wenilla-realm/src/auth/herokey.rs
new file mode 100644
index 0000000..479ef67
--- /dev/null
+++ b/crates/wenilla-realm/src/auth/herokey.rs
@@ -0,0 +1,636 @@
+//! Open Vanilla: Hero Keys — an account's own sign-in, as one line of text the player keeps.
+//!
+//! A key reads `ovk1.<key_id>.<secret>`: a 10-character id and 32 random bytes (base64url). The
+//! realm keeps the id and a SHA-256 of the secret, never the secret. The secret is 256 bits from the
+//! OS generator, so a plain hash cannot be reversed or guessed; a pepper would add nothing an
+//! attacker holding the database could not also take from the state volume. Checks compare in
+//! constant time. One working key per account: making a new one revokes the old one at once.
+//!
+//! The secret is shown once, when it is made: it rides to the key page in a short-lived cookie
+//! encrypted with the realm's master key (`wr_herokey`, 15 minutes, only `/account/key`), so a
+//! reload still shows it, and afterwards the page offers a new key instead.
+//!
+//! Routes:
+//!   GET  /key                    "I have a Hero Key": drop the file or paste the line
+//!   POST /auth/key               sign in with a key (same-site, rate-limited per network and key)
+//!   GET  /account/key            the key page: the new key, or what the account's key is up to;
+//!                                makes a first key when the account has none (nothing to revoke)
+//!   POST /account/key/new        a new key (revokes the old one)
+//!   POST /account/key/saved      the player saved it (download, copy or the checkbox)
+//!   POST /account/key/later      "Remind me later": the in-game reminder waits a day
+//!   POST /account/key/mint.json  the in-game window's key, as JSON
+//!   GET  /api/herokey            whether the in-game window should ask, and what to say
+//!
+//! Discord's sign-in is being retired in favour of Hero Keys (see [`discord_mode`]).
+
+use std::sync::Arc;
+
+use axum::extract::{Form, Query, State};
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Redirect, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use axum_extra::extract::cookie::{Cookie, SameSite};
+use axum_extra::extract::CookieJar;
+use base64::Engine;
+use sha2::{Digest, Sha256};
+use sqlx::SqlitePool;
+
+use crate::db::now;
+use crate::secrets::{random_string, ALNUM};
+use crate::session::{self, client_ip, Session};
+use crate::{audit, csrf, render, templates, AppError, AppState};
+
+pub const PREFIX: &str = "ovk1";
+const ID_LEN: usize = 10;
+const SECRET_LEN: usize = 43; // 32 bytes, base64url without padding
+/// The just-made key, encrypted, on its way to the key page.
+pub const NEW_KEY_COOKIE: &str = "wr_herokey";
+const NEW_KEY_SECS: i64 = 15 * 60;
+const SNOOZE_SECS: i64 = 24 * 3600;
+
+// -- the Discord phases ------------------------------------------------------------------------------
+
+/// `DISCORD_SIGNIN`: `on` (today: Discord signs in as before), `keyonly` (Discord still signs in,
+/// but only to get a Hero Key: it always lands on the key page until one is saved, and the sign-in
+/// page says Discord sign-in is retiring) or `off` (no Discord button; Discord can't sign in).
+pub fn discord_mode() -> &'static str {
+    match std::env::var("DISCORD_SIGNIN").map(|v| v.trim().to_ascii_lowercase()).as_deref() {
+        Ok("off") | Ok("0") => "off",
+        Ok("keyonly") | Ok("key-only") | Ok("key") => "keyonly",
+        _ => "on",
+    }
+}
+
+/// `DISCORD_RETIRE_DATE`: the day shown in the "retiring" notices (free text, e.g. "1 December").
+pub fn retire_date() -> String {
+    std::env::var("DISCORD_RETIRE_DATE")
+        .ok()
+        .map(|v| v.trim().chars().filter(|c| !c.is_control()).take(40).collect::<String>())
+        .unwrap_or_default()
+}
+
+// -- keys --------------------------------------------------------------------------------------------
+
+fn secret_hash(key_id: &str, secret: &str) -> Vec<u8> {
+    Sha256::digest(format!("openvanilla-hero-key\n{key_id}\n{secret}").as_bytes()).to_vec()
+}
+
+fn new_secret() -> String {
+    use rand::RngCore;
+    let mut bytes = [0u8; 32];
+    rand::rngs::OsRng.fill_bytes(&mut bytes);
+    base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(bytes)
+}
+
+fn is_b64url(b: u8) -> bool {
+    b.is_ascii_alphanumeric() || b == b'-' || b == b'_'
+}
+
+/// The key in whatever the player pasted or dropped (a whole `.ovkey` file, a line with spaces
+/// around it, a key broken over two lines by an e-mail client): `(key_id, secret)`.
+pub fn parse(input: &str) -> Option<(String, String)> {
+    let joined: String = input.split_whitespace().collect::<Vec<_>>().join("\n");
+    let bytes = joined.as_bytes();
+    let mut from = 0;
+    while let Some(at) = joined[from..].find("ovk1.") {
+        let start = from + at + PREFIX.len() + 1;
+        let id_ok = bytes.len() > start + ID_LEN
+            && bytes[start..start + ID_LEN].iter().all(|b| b.is_ascii_alphanumeric())
+            && bytes[start + ID_LEN] == b'.';
+        if id_ok {
+            // the secret: 43 base64url characters, which a wrapping mail client may have split with
+            // a line break; one more on the same line means it is something else
+            let mut secret = String::with_capacity(SECRET_LEN);
+            let mut i = start + ID_LEN + 1;
+            while i < bytes.len() && secret.len() < SECRET_LEN {
+                match bytes[i] {
+                    b if is_b64url(b) => secret.push(char::from(b)),
+                    b'\n' if !secret.is_empty() => {}
+                    _ => break,
+                }
+                i += 1;
+            }
+            let ends = i >= bytes.len() || !is_b64url(bytes[i]);
+            if secret.len() == SECRET_LEN && ends {
+                return Some((joined[start..start + ID_LEN].to_string(), secret));
+            }
+        }
+        from = from + at + 1;
+    }
+    None
+}
+
+/// A new working key for `user_id` (any older one stops working). Returns the whole key text.
+pub async fn mint(db: &SqlitePool, user_id: i64) -> anyhow::Result<String> {
+    let key_id = random_string(ALNUM, ID_LEN);
+    let secret = new_secret();
+    let mut tx = db.begin().await?;
+    sqlx::query("UPDATE hero_keys SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL")
+        .bind(now())
+        .bind(user_id)
+        .execute(&mut *tx)
+        .await?;
+    sqlx::query("INSERT INTO hero_keys (user_id, key_id, secret_hash, created_at) VALUES (?, ?, ?, ?)")
+        .bind(user_id)
+        .bind(&key_id)
+        .bind(secret_hash(&key_id, &secret))
+        .bind(now())
+        .execute(&mut *tx)
+        .await?;
+    tx.commit().await?;
+    Ok(format!("{PREFIX}.{key_id}.{secret}"))
+}
+
+/// The account a key belongs to, when the key is the account's working one and the account is
+/// enabled. Constant-time on the secret.
+pub async fn verify(db: &SqlitePool, key_id: &str, secret: &str) -> anyhow::Result<Option<i64>> {
+    use subtle::ConstantTimeEq;
+    let row: Option<(i64, Vec<u8>, i64)> = sqlx::query_as(
+        "SELECT k.user_id, k.secret_hash, u.disabled FROM hero_keys k JOIN users u ON u.id = k.user_id \
+         WHERE k.key_id = ? AND k.revoked_at IS NULL",
+    )
+    .bind(key_id)
+    .fetch_optional(db)
+    .await?;
+    let Some((uid, stored, disabled)) = row else {
+        // the same work as a real check, so a missing id and a wrong secret take as long
+        let _ = secret_hash(key_id, secret).as_slice().ct_eq([0u8; 32].as_slice());
+        return Ok(None);
+    };
+    let ok: bool = secret_hash(key_id, secret).as_slice().ct_eq(stored.as_slice()).into();
+    Ok((ok && disabled == 0).then_some(uid))
+}
+
+/// Revoke an account's working key (an admin, or the player making a new one elsewhere).
+pub async fn revoke(db: &SqlitePool, user_id: i64) -> anyhow::Result<()> {
+    sqlx::query("UPDATE hero_keys SET revoked_at = ? WHERE user_id = ? AND revoked_at IS NULL")
+        .bind(now())
+        .bind(user_id)
+        .execute(db)
+        .await?;
+    Ok(())
+}
+
+/// The account's working key, as the pages describe it.
+#[derive(Clone, Debug, sqlx::FromRow)]
+pub struct KeyInfo {
+    pub key_id: String,
+    pub created_at: i64,
+    pub saved_at: Option<i64>,
+    pub first_used_at: Option<i64>,
+    pub last_used_at: Option<i64>,
+    pub last_used_ua: Option<String>,
+}
+
+pub async fn info(db: &SqlitePool, user_id: i64) -> anyhow::Result<Option<KeyInfo>> {
+    Ok(sqlx::query_as(
+        "SELECT key_id, created_at, saved_at, first_used_at, last_used_at, last_used_ua FROM hero_keys \
+         WHERE user_id = ? AND revoked_at IS NULL",
+    )
+    .bind(user_id)
+    .fetch_optional(db)
+    .await?)
+}
+
+pub async fn mark_saved(db: &SqlitePool, user_id: i64) -> anyhow::Result<bool> {
+    let r = sqlx::query("UPDATE hero_keys SET saved_at = COALESCE(saved_at, ?) WHERE user_id = ? AND revoked_at IS NULL")
+        .bind(now())
+        .bind(user_id)
+        .execute(db)
+        .await?;
+    Ok(r.rows_affected() == 1)
+}
+
+async fn mark_used(db: &SqlitePool, key_id: &str, ua: Option<&str>) {
+    let t = now();
+    let _ = sqlx::query(
+        "UPDATE hero_keys SET first_used_at = COALESCE(first_used_at, ?), last_used_at = ?, last_used_ua = ? WHERE key_id = ?",
+    )
+    .bind(t)
+    .bind(t)
+    .bind(ua.map(short_ua))
+    .bind(key_id)
+    .execute(db)
+    .await;
+}
+
+/// "Chrome on Windows", "Safari on iPhone" — enough to recognise a device, nothing more.
+pub fn short_ua(ua: &str) -> String {
+    let browser = if ua.contains("Edg/") {
+        "Edge"
+    } else if ua.contains("OPR/") {
+        "Opera"
+    } else if ua.contains("Firefox/") {
+        "Firefox"
+    } else if ua.contains("Chrome/") || ua.contains("CriOS/") {
+        "Chrome"
+    } else if ua.contains("Safari/") {
+        "Safari"
+    } else {
+        "a browser"
+    };
+    let os = if ua.contains("iPhone") {
+        "iPhone"
+    } else if ua.contains("iPad") {
+        "iPad"
+    } else if ua.contains("Android") {
+        "Android"
+    } else if ua.contains("Windows") {
+        "Windows"
+    } else if ua.contains("Mac OS X") || ua.contains("Macintosh") {
+        "Mac"
+    } else if ua.contains("CrOS") {
+        "ChromeOS"
+    } else if ua.contains("Linux") {
+        "Linux"
+    } else {
+        "a computer"
+    };
+    format!("{browser} on {os}")
+}
+
+/// "20 Oct 2026".
+pub fn day(t: i64) -> String {
+    const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+    match time::OffsetDateTime::from_unix_timestamp(t) {
+        Ok(d) => format!("{} {} {}", d.day(), MONTHS[usize::from(u8::from(d.month())) - 1], d.year()),
+        Err(_) => String::new(),
+    }
+}
+
+/// How the account signs in today, for the reminder's wording: `discord`, `google`, `guest`, or
+/// `None` for accounts with only a password (admins), which the reminder leaves alone.
+pub async fn sign_in_kind(db: &SqlitePool, user_id: i64) -> anyhow::Result<Option<String>> {
+    let rows: Vec<(String,)> = sqlx::query_as("SELECT provider FROM identities WHERE user_id = ?")
+        .bind(user_id)
+        .fetch_all(db)
+        .await?;
+    let has = |p: &str| rows.iter().any(|(x,)| x == p);
+    Ok(["discord", "google", "guest"].iter().find(|p| has(p)).map(|p| p.to_string()))
+}
+
+/// Should the in-game window ask this account to save a key? No saved working key, not snoozed,
+/// and an account that signs in with Discord, Google or as a guest.
+pub async fn needs_reminder(db: &SqlitePool, user_id: i64) -> anyhow::Result<Option<String>> {
+    let Some(kind) = sign_in_kind(db, user_id).await? else {
+        return Ok(None);
+    };
+    if info(db, user_id).await?.is_some_and(|k| k.saved_at.is_some()) {
+        return Ok(None);
+    }
+    let (snooze,): (Option<i64>,) = sqlx::query_as("SELECT hero_key_snooze_until FROM users WHERE id = ?")
+        .bind(user_id)
+        .fetch_one(db)
+        .await?;
+    if snooze.is_some_and(|s| s > now()) {
+        return Ok(None);
+    }
+    Ok(Some(kind))
+}
+
+/// Add an external identity to an account ("Link Google"). `false` when another account already
+/// has it; `true` when it is now (or already was) this account's.
+pub async fn link_identity(db: &SqlitePool, user_id: i64, i: &super::provider::Identity) -> anyhow::Result<bool> {
+    let taken: Option<(i64,)> = sqlx::query_as("SELECT user_id FROM identities WHERE provider = ? AND subject = ?")
+        .bind(&i.provider)
+        .bind(&i.subject)
+        .fetch_optional(db)
+        .await?;
+    match taken {
+        Some((owner,)) => Ok(owner == user_id),
+        None => {
+            let display: String = i.display_name.chars().take(40).collect();
+            sqlx::query("INSERT INTO identities (user_id, provider, subject, display_name, email, created_at, last_login) VALUES (?, ?, ?, ?, ?, ?, ?)")
+                .bind(user_id)
+                .bind(&i.provider)
+                .bind(&i.subject)
+                .bind(&display)
+                .bind(&i.email)
+                .bind(now())
+                .bind(now())
+                .execute(db)
+                .await?;
+            Ok(true)
+        }
+    }
+}
+
+/// Has this account saved its working key?
+pub async fn has_saved(db: &SqlitePool, user_id: i64) -> bool {
+    info(db, user_id).await.ok().flatten().is_some_and(|k| k.saved_at.is_some())
+}
+
+// -- the just-made key's cookie ----------------------------------------------------------------------
+
+fn new_key_cookie<'a>(state: &AppState, key: &str) -> Option<Cookie<'a>> {
+    let (ct, nonce) = state.secrets.encrypt(key.as_bytes()).ok()?;
+    Some(
+        Cookie::build((NEW_KEY_COOKIE, format!("{}.{}", hex::encode(nonce), hex::encode(ct))))
+            .path("/account/key")
+            .http_only(true)
+            .secure(!state.cfg.cookie_insecure)
+            .same_site(SameSite::Strict)
+            .max_age(time::Duration::seconds(NEW_KEY_SECS))
+            .build(),
+    )
+}
+
+fn forget_new_key(jar: CookieJar) -> CookieJar {
+    if jar.get(NEW_KEY_COOKIE).is_some() {
+        jar.remove(Cookie::build((NEW_KEY_COOKIE, "")).path("/account/key").build())
+    } else {
+        jar
+    }
+}
+
+/// The key this browser was just given, if it is still this account's working key.
+async fn just_made(state: &AppState, jar: &CookieJar, user_id: i64) -> Option<String> {
+    let v = jar.get(NEW_KEY_COOKIE)?.value().to_string();
+    let (nonce, ct) = v.split_once('.')?;
+    let key = state.secrets.decrypt_string(&hex::decode(ct).ok()?, &hex::decode(nonce).ok()?).ok()?;
+    let (id, secret) = parse(&key)?;
+    (verify(&state.db, &id, &secret).await.ok()?? == user_id).then_some(key)
+}
+
+// -- routes --------------------------------------------------------------------------------------------
+
+/// Public: the "I have a Hero Key" page and its sign-in.
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/key", get(key_login_page))
+        .route("/auth/key", post(key_sign_in))
+}
+
+/// Behind the session: the key page and the in-game window's calls.
+pub fn account_router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/account/key", get(key_page))
+        .route("/account/key/new", post(new_key))
+        .route("/account/key/saved", post(saved))
+        .route("/account/key/later", post(later))
+        .route("/account/key/mint.json", post(mint_json))
+        .route("/api/herokey", get(reminder))
+}
+
+fn no_store(mut r: Response) -> Response {
+    r.headers_mut().insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+async fn key_login_page(State(state): State<Arc<AppState>>, jar: CookieJar) -> Response {
+    // already signed in: the key page has everything
+    if let Some(c) = jar.get(session::COOKIE) {
+        if let Ok(Some(_)) = session::lookup_with(&state.db, c.value(), false).await {
+            return Redirect::to("/account/key").into_response();
+        }
+    }
+    no_store(render(login_page(&state, None).await))
+}
+
+async fn fail(state: &AppState, msg: &str) -> Response {
+    no_store(render(login_page(state, Some(msg.to_string())).await))
+}
+
+async fn login_page(state: &AppState, error: Option<String>) -> templates::HeroKeyLogin {
+    templates::HeroKeyLogin {
+        error,
+        realm_name: state.realm_name().await,
+        google: state.providers.iter().any(|p| p.id() == "google"),
+    }
+}
+
+#[derive(serde::Deserialize)]
+struct KeyForm {
+    #[serde(default)]
+    key: String,
+}
+
+async fn key_sign_in(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    jar: CookieJar,
+    Form(f): Form<KeyForm>,
+) -> Result<Response, AppError> {
+    if !super::guest::same_site(&headers) {
+        return Ok(fail(&state, "Open the realm's own page to sign in with your Hero Key.").await);
+    }
+    let ip = client_ip(&headers);
+    let net = super::guest::ip_bucket(ip.as_deref().unwrap_or(""));
+    if !state.limiter.allow(&format!("herokey:net:{net}"), 20, 900) {
+        audit::log(&state.db, None, ip.as_deref(), "login.limited", Some("herokey"), None).await;
+        return Ok(fail(&state, "Too many tries. Wait 15 minutes and try again.").await);
+    }
+    let Some((key_id, secret)) = parse(&f.key) else {
+        return Ok(fail(&state, "That doesn't look like a Hero Key. It starts with ovk1. Paste the whole line, or drop the file.").await);
+    };
+    if !state.limiter.allow(&format!("herokey:id:{key_id}"), 10, 900) {
+        return Ok(fail(&state, "Too many tries with that key. Wait 15 minutes and try again.").await);
+    }
+    let Some(uid) = verify(&state.db, &key_id, &secret).await? else {
+        audit::log(&state.db, None, ip.as_deref(), "login.fail", Some("herokey"), None).await;
+        return Ok(fail(&state, "That Hero Key didn't work. It may have been replaced by a newer one. Check you copied all of it, or sign in another way and make a new key.").await);
+    };
+    let ua = headers.get("user-agent").and_then(|v| v.to_str().ok());
+    mark_used(&state.db, &key_id, ua).await;
+    let token = session::create(&state.db, uid, ip.as_deref(), ua).await?;
+    audit::log(&state.db, Some(uid), ip.as_deref(), "login.ok", Some("herokey"), None).await;
+    let jar = jar.add(session::cookie(token, !state.cfg.cookie_insecure));
+    let dest = super::oauth::landing(&jar, "/account/key?back=1");
+    Ok((super::oauth::clear_next(jar), Redirect::to(&dest)).into_response())
+}
+
+#[derive(serde::Deserialize, Default)]
+struct PageQuery {
+    back: Option<String>,
+    linked: Option<String>,
+}
+
+async fn key_page(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    jar: CookieJar,
+    Query(q): Query<PageQuery>,
+) -> Result<Response, AppError> {
+    let uid = session.user.id;
+    let mut jar = jar;
+    let mut key = just_made(&state, &jar, uid).await;
+    if key.is_none() {
+        jar = forget_new_key(jar);
+        // a first key needs no button: there is nothing to revoke
+        if info(&state.db, uid).await?.is_none() {
+            let k = mint(&state.db, uid).await?;
+            audit::log(&state.db, Some(uid), None, "herokey.mint", None, Some("first")).await;
+            if let Some(c) = new_key_cookie(&state, &k) {
+                jar = jar.add(c);
+            }
+            key = Some(k);
+        }
+    }
+    let k = info(&state.db, uid).await?;
+    let kind = sign_in_kind(&state.db, uid).await?;
+    let google_linked = kind.as_deref() == Some("google")
+        || sqlx::query_as::<_, (i64,)>("SELECT COUNT(*) FROM identities WHERE user_id = ? AND provider = 'google'")
+            .bind(uid)
+            .fetch_one(&state.db)
+            .await?
+            .0
+            > 0;
+    let page = templates::HeroKey {
+        csrf: session.csrf_token.clone(),
+        display_name: session.user.display_name.clone(),
+        realm_name: state.realm_name().await,
+        key,
+        back: q.back.is_some(),
+        linked: q.linked.filter(|p| p == "google" || p == "discord"),
+        made: k.as_ref().map(|k| day(k.created_at)).unwrap_or_default(),
+        saved: k.as_ref().is_some_and(|k| k.saved_at.is_some()),
+        last_used: k
+            .as_ref()
+            .and_then(|k| k.last_used_at.map(|t| format!("{}{}", day(t), k.last_used_ua.as_deref().map(|u| format!(", {u}")).unwrap_or_default())))
+            .unwrap_or_default(),
+        discord: kind.as_deref() == Some("discord"),
+        guest: session.user.guest,
+        retiring: discord_mode() != "on",
+        retire_date: retire_date(),
+        can_link_google: !google_linked && state.providers.iter().any(|p| p.id() == "google") && !session.user.guest,
+    };
+    Ok(no_store((jar, render(page)).into_response()))
+}
+
+#[derive(serde::Deserialize)]
+struct CsrfForm {
+    #[serde(rename = "_csrf", default)]
+    csrf: String,
+}
+
+fn from_script(headers: &HeaderMap) -> bool {
+    headers.get("x-requested-with").and_then(|v| v.to_str().ok()) == Some("wenilla")
+}
+
+async fn new_key(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    jar: CookieJar,
+    Form(f): Form<CsrfForm>,
+) -> Result<Response, AppError> {
+    csrf::verify(&session, &f.csrf)?;
+    let uid = session.user.id;
+    let k = mint(&state.db, uid).await?;
+    audit::log(&state.db, Some(uid), client_ip(&headers).as_deref(), "herokey.mint", None, Some("new")).await;
+    let jar = match new_key_cookie(&state, &k) {
+        Some(c) => jar.add(c),
+        None => jar,
+    };
+    Ok((jar, Redirect::to("/account/key")).into_response())
+}
+
+async fn saved(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Form(f): Form<CsrfForm>,
+) -> Result<Response, AppError> {
+    csrf::verify(&session, &f.csrf)?;
+    let ok = mark_saved(&state.db, session.user.id).await?;
+    if ok {
+        audit::log(&state.db, Some(session.user.id), client_ip(&headers).as_deref(), "herokey.saved", None, None).await;
+    }
+    if from_script(&headers) {
+        return Ok(no_store(Json(serde_json::json!({ "saved": ok })).into_response()));
+    }
+    Ok(Redirect::to("/account/key").into_response())
+}
+
+async fn later(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Form(f): Form<CsrfForm>,
+) -> Result<Response, AppError> {
+    csrf::verify(&session, &f.csrf)?;
+    sqlx::query("UPDATE users SET hero_key_snooze_until = ? WHERE id = ?")
+        .bind(now() + SNOOZE_SECS)
+        .bind(session.user.id)
+        .execute(&state.db)
+        .await?;
+    if from_script(&headers) {
+        return Ok(StatusCode::NO_CONTENT.into_response());
+    }
+    Ok(Redirect::to("/").into_response())
+}
+
+async fn mint_json(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Form(f): Form<CsrfForm>,
+) -> Result<Response, AppError> {
+    csrf::verify(&session, &f.csrf)?;
+    if !state.limiter.allow(&format!("herokey:mint:{}", session.user.id), 10, 3600) {
+        return Err(AppError::TooMany);
+    }
+    let k = mint(&state.db, session.user.id).await?;
+    audit::log(&state.db, Some(session.user.id), client_ip(&headers).as_deref(), "herokey.mint", None, Some("in game")).await;
+    Ok(no_store(Json(serde_json::json!({ "key": k })).into_response()))
+}
+
+/// The in-game window: `{"ask": false}`, or what to say and the form token to answer with.
+async fn reminder(session: Session, State(state): State<Arc<AppState>>) -> Result<Response, AppError> {
+    let kind = needs_reminder(&state.db, session.user.id).await?;
+    let body = match kind {
+        None => serde_json::json!({ "ask": false }),
+        Some(kind) => {
+            let retiring = kind == "discord";
+            let line = match kind.as_str() {
+                "discord" => "Your account has no Hero Key saved yet. Discord sign-in is retiring: save your key so you never get locked out.",
+                "guest" => "Your heroes live only in this browser until you save your Hero Key. Save it so you can always come back.",
+                _ => "Your account has no Hero Key saved yet. Save it so you can always get back in.",
+            };
+            serde_json::json!({
+                "ask": true,
+                "kind": kind,
+                "retiring": retiring,
+                "retire_date": retire_date(),
+                "line": line,
+                "csrf": session.csrf_token,
+            })
+        }
+    };
+    Ok(no_store(Json(body).into_response()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_key_from_a_file_a_line_or_a_wrapped_mail() {
+        let id = "abcDEF2345";
+        let secret = "A".repeat(SECRET_LEN - 1) + "z";
+        let key = format!("ovk1.{id}.{secret}");
+        assert_eq!(parse(&key), Some((id.into(), secret.clone())));
+        assert_eq!(parse(&format!("  {key}  \n")), Some((id.into(), secret.clone())));
+        let file = format!("Open Vanilla Hero Key\n\nKeep it private (ovk1. is how it starts).\n-----BEGIN OPEN VANILLA HERO KEY-----\n{key}\n-----END OPEN VANILLA HERO KEY-----\n");
+        assert_eq!(parse(&file), Some((id.into(), secret.clone())));
+        let wrapped = format!("ovk1.{id}.{}\n{}", &secret[..20], &secret[20..]);
+        assert_eq!(parse(&wrapped), Some((id.into(), secret.clone())));
+        assert_eq!(parse("ovk1.short.abc"), None);
+        assert_eq!(parse(&format!("ovk1.{id}.{}", &secret[..30])), None);
+        assert_eq!(parse(""), None);
+    }
+
+    #[test]
+    fn names_a_device_without_more_detail() {
+        assert_eq!(short_ua("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0 Safari/537.36"), "Chrome on Windows");
+        assert_eq!(short_ua("Mozilla/5.0 (iPhone; CPU iPhone OS 18_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Mobile/15E148 Safari/604.1"), "Safari on iPhone");
+        assert_eq!(day(1792536400), "20 Oct 2026");
+    }
+
+    #[test]
+    fn phases_default_to_on() {
+        std::env::remove_var("DISCORD_SIGNIN");
+        assert_eq!(discord_mode(), "on");
+    }
+}
