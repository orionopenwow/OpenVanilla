+      </div>
+      <ul class="why">
+        <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4Zm-1 15-4-4 1.4-1.4L11 13.2l5.6-5.6L18 9l-7 7Z"/></svg>
+          <span><b>It's your sign-in,</b> written as a secure code made just for you. It only works on Open Vanilla.</span></li>
+        <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm6-9h-1V6A5 5 0 0 0 7 6v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2ZM9 6a3 3 0 0 1 6 0v2H9V6Z"/></svg>
+          <span><b>Keep it private,</b> like a password. Anyone with it can play your heroes. We'll never ask you for it.</span></li>
+        <li><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7ZM5 18v2h14v-2H5Z"/></svg>
+          <span><b>Keep a copy</b> in a password manager, your notes, or print it. Lost it? You can make a new one here.</span></li>
+      </ul>
+      <div class="row2">
+        <button class="btn btn-gold" id="dl" type="button"><svg class="ic" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19 9h-4V3H9v6H5l7 7 7-7ZM5 18v2h14v-2H5Z"/></svg>Download file</button>
+        <button class="btn btn-ghost" id="copy" type="button"><svg class="ic" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1Zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2Zm0 16H8V7h11v14Z"/></svg>Copy as text</button>
+      </div>
+      <label class="check"><input type="checkbox" id="saved"{% if saved %} checked{% endif %}> I've saved my Hero Key somewhere safe</label>
+      <a class="btn btn-play" id="enter" href="/"{% if !saved %} aria-disabled="true" data-locked="1"{% endif %}>Enter the realm</a>
+      <form method="post" action="/account/key/later" class="fine" style="margin-bottom:6px"><input type="hidden" name="_csrf" value="{{ csrf }}"><button type="submit" class="linkish">Remind me later</button> · the game asks again</form>
+      <form method="post" action="/account/key/saved" id="savedform" hidden><input type="hidden" name="_csrf" value="{{ csrf }}"></form>
+{% else %}{% if back %}
+      <h1 id="t">Welcome back</h1>
+      <p class="sub">Your adventure is waiting. <span class="realm"><i></i>{{ realm_name }}</span></p>
+      <div class="who"><div class="avatar star" aria-hidden="true">★</div><div><b>{{ display_name }}</b><span>Signed in with your Hero Key</span></div></div>
+      <div class="ok"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>Signed in with your Hero Key.</div>
+{% else %}
+      <h1 id="t">Your Hero Key</h1>
+      <p class="sub">{{ display_name }} · <span class="realm"><i></i>{{ realm_name }}</span></p>
+      {% if let Some(p) = linked %}<div class="ok"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>{% if p == "google" %}Google is linked: you can sign in with it too.{% else %}Linked.{% endif %}</div>{% endif %}
+      {% if saved %}<div class="ok"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2Z"/></svg>Your Hero Key is saved. Sign in with it on any device.</div>
+      {% else %}<div class="notice" role="note"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" style="flex:none;margin-top:1px"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm0-8h-2V7h2v2Z"/></svg><span><b>Your key isn't saved yet,</b> and for safety it can't be shown again. Make a new one and save it: the old one stops working.</span></div>{% endif %}
+{% endif %}
+      <div class="meta">
+        {% if !made.is_empty() %}<span>Key made <b>{{ made }}</b></span>{% endif %}
+        {% if !last_used.is_empty() %}<span>Last used <b>{{ last_used }}</b></span>{% else %}<span>Not used to sign in yet</span>{% endif %}
+        <span>Lost it, or someone else has it? A new key stops the old one working at once.</span>
+      </div>
+      {% if back %}<a class="btn btn-play" href="/">Play</a>{% endif %}
+      <form method="post" action="/account/key/new" id="newform">
+        <input type="hidden" name="_csrf" value="{{ csrf }}">
+        <button class="btn {% if saved || back %}btn-ghost{% else %}btn-play{% endif %}" type="submit" style="margin-top:10px"><svg class="ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 14a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.65-4A6 6 0 1 0 12.65 14H15v3h3v-3h2v-4h-7.35Z"/></svg><span class="label">Make a new key</span></button>
+      </form>
+      {% if can_link_google %}<a class="btn btn-google" href="/auth/google/start?link=1"><svg class="ic" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg><span class="label">Link Google too</span></a>{% endif %}
+      {% if !back %}<p class="fine" style="margin-bottom:6px"><a href="/">Back to the game</a></p>{% else %}<form method="post" action="/logout" class="fine" style="margin-bottom:6px"><button type="submit" class="linkish">Sign out</button></form>{% endif %}
+{% endif %}
+    </div>
+  </section>
+  <footer>
+    <a href="https://openvanilla.app">openvanilla.app</a><a href="/about">About</a><a href="/privacy">Privacy</a>
+    <small>A free fan project. Not affiliated with or endorsed by Blizzard Entertainment.</small>
+  </footer>
+</main>
+<div class="toast" id="toast" role="status"></div>
+<script>
+  (function () {
+    var box = document.getElementById('keybox');
+    var nf = document.getElementById('newform');
+    if (nf) nf.addEventListener('submit', function (e) {
+      if (!confirm('Make a new Hero Key? Your old key stops working at once.')) e.preventDefault();
+    });
+    if (!box) return;
+    var key = document.getElementById('keytext').textContent.trim();
+    var peek = document.getElementById('peek'), saved = document.getElementById('saved'), enter = document.getElementById('enter');
+    var csrf = document.querySelector('#savedform input[name=_csrf]').value;
+    function toast(m) { var t = document.getElementById('toast'); t.textContent = m; t.classList.add('on'); clearTimeout(toast.h); toast.h = setTimeout(function () { t.classList.remove('on'); }, 2200); }
+    peek.addEventListener('click', function () { var on = box.classList.toggle('shown'); peek.textContent = on ? 'Hide' : 'Show'; peek.setAttribute('aria-pressed', on); });
+    var told = false;
+    function markSaved() {
+      saved.checked = true; enter.removeAttribute('aria-disabled'); enter.removeAttribute('data-locked');
+      if (told) return; told = true;
+      fetch('/account/key/saved', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'wenilla' }, body: '_csrf=' + encodeURIComponent(csrf) }).catch(function () { told = false; });
+    }
+    saved.addEventListener('change', function () { if (saved.checked) markSaved(); else { enter.setAttribute('aria-disabled', 'true'); enter.setAttribute('data-locked', '1'); } });
+    enter.addEventListener('click', function (e) { if (enter.getAttribute('data-locked')) { e.preventDefault(); toast('Save your key first: Download it or copy it.'); } });
+    document.getElementById('copy').addEventListener('click', function () {
+      var done = function () { toast('Hero Key copied'); markSaved(); };
+      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(key).then(done, function () { box.classList.add('shown'); toast('Select the key and copy it'); });
+      else { box.classList.add('shown'); toast('Select the key and copy it'); }
+    });
+    document.getElementById('dl').addEventListener('click', function () {
+      var text = 'Open Vanilla Hero Key\n\nThis key signs you in to Open Vanilla (' + location.host + ').\nKeep it private, like a password: anyone with it can play your heroes.\nTo use it: on the sign-in page choose "I have a Hero Key" and drop this file in.\n\n-----BEGIN OPEN VANILLA HERO KEY-----\n' + key + '\n-----END OPEN VANILLA HERO KEY-----\n';
+      var a = document.createElement('a');
+      a.href = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
+      a.download = 'OpenVanilla-HeroKey.ovkey'; document.body.appendChild(a); a.click(); a.remove();
+      setTimeout(function () { URL.revokeObjectURL(a.href); }, 5000);
+      toast('Saved OpenVanilla-HeroKey.ovkey'); markSaved();
+    });
+  })();
+</script>
+</body>
+</html>
diff --git a/crates/wenilla-realm/templates/herokey_login.html b/crates/wenilla-realm/templates/herokey_login.html
new file mode 100644
index 0000000..bc0b9fa
--- /dev/null
+++ b/crates/wenilla-realm/templates/herokey_login.html
@@ -0,0 +1,78 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>Hero Key · {{ realm_name }} · Open Vanilla</title>
+<meta name="theme-color" content="#0a0816">
+<meta name="color-scheme" content="dark">
+<meta name="apple-mobile-web-app-capable" content="yes">
+<meta name="mobile-web-app-capable" content="yes">
+<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
+<meta name="apple-mobile-web-app-title" content="Open Vanilla">
+<link rel="icon" type="image/png" href="/brand/icon-180.png">
+<link rel="apple-touch-icon" href="/brand/icon-180.png">
+<link rel="manifest" href="/brand/manifest.webmanifest">
+<link rel="preload" as="image" href="/brand/logo.webp?v=ov2">
+<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">
+{% include "signin_style.html" %}
+</head>
+<body>
+<div class="bg" aria-hidden="true"></div><div class="stars" aria-hidden="true"></div>
+<main class="stage">
+  <img class="logo" src="/brand/logo.webp?v=ov2" width="480" height="272" alt="Open Vanilla" style="width:min(240px,64vw)">
+  <section class="card" aria-labelledby="t">
+    <img class="crest" src="/brand/crest.webp" width="160" height="165" alt="">
+    <div class="inner">
+      <h1 id="t">Welcome back</h1>
+      <p class="sub">Sign in with your Hero Key. <span class="realm"><i></i>{{ realm_name }}</span></p>
+      {% if let Some(e) = error %}<div class="flash" role="alert"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M1 21h22L12 2 1 21Zm12-3h-2v-2h2v2Zm0-4h-2v-4h2v4Z"/></svg><span>{{ e }}</span></div>{% endif %}
+      <form method="post" action="/auth/key" id="kf">
+        <label class="drop" id="drop" tabindex="0">
+          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" style="color:var(--gold)"><path fill="currentColor" d="M19.35 10.04A7.49 7.49 0 0 0 12 4C9.11 4 6.6 5.64 5.35 8.04A6 6 0 0 0 6 20h13a5 5 0 0 0 .35-9.96ZM14 13v4h-4v-4H7l5-5 5 5h-3Z"/></svg>
+          <b>Drop your key file here</b>
+          <span id="dropsay">or tap to choose it (it ends in .ovkey)</span>
+          <input type="file" accept=".ovkey,.txt,text/plain" hidden id="file">
+        </label>
+        <div class="rule">or paste it</div>
+        <textarea name="key" id="paste" placeholder="ovk1.…" spellcheck="false" autocomplete="off" autocapitalize="none" aria-label="Your Hero Key"></textarea>
+        <button class="btn btn-play" type="submit" style="margin-top:12px" data-busy="Checking your key…"><span class="spin"></span><span class="label">Sign in with my key</span></button>
+      </form>
+      <p class="fine">Lost your key? {% if google %}If you linked Google, <a href="/auth/google/start">sign in with Google</a> and make a new one.{% else %}Sign in the way you did before and make a new one.{% endif %}</p>
+      <p class="fine" style="margin-bottom:6px"><a href="/login">← Back</a></p>
+    </div>
+  </section>
+  <footer>
+    <a href="https://openvanilla.app">openvanilla.app</a><a href="/about">About</a><a href="/privacy">Privacy</a>
+    <small>A free fan project. Not affiliated with or endorsed by Blizzard Entertainment.</small>
+  </footer>
+</main>
+<script>
+  // The file never leaves the page: its text goes into the box, and the box is what's sent.
+  var drop = document.getElementById('drop'), file = document.getElementById('file'), paste = document.getElementById('paste'), say = document.getElementById('dropsay');
+  ['dragenter', 'dragover'].forEach(function (n) { drop.addEventListener(n, function (e) { e.preventDefault(); drop.classList.add('over'); }); });
+  ['dragleave', 'drop'].forEach(function (n) { drop.addEventListener(n, function (e) { e.preventDefault(); drop.classList.remove('over'); }); });
+  function take(f) {
+    if (!f) return;
+    if (f.size > 65536) { say.textContent = 'That file is too big to be a Hero Key.'; return; }
+    var r = new FileReader();
+    r.onload = function () {
+      var m = String(r.result).replace(/\s+/g, '\n').match(/ovk1\.[A-Za-z0-9]{10}\.[A-Za-z0-9_\-\n]{43,}/);
+      if (m) { paste.value = m[0].replace(/\n/g, ''); say.textContent = 'Key read from ' + f.name; document.getElementById('kf').requestSubmit ? document.getElementById('kf').requestSubmit() : document.getElementById('kf').submit(); }
+      else say.textContent = 'That file has no Hero Key in it.';
+    };
+    r.readAsText(f);
+  }
+  drop.addEventListener('drop', function (e) { take(e.dataTransfer.files[0]); });
+  drop.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); file.click(); } });
+  file.addEventListener('change', function () { take(file.files[0]); });
+  document.querySelectorAll('[data-busy]').forEach(function (el) {
+    el.closest('form').addEventListener('submit', function () {
+      el.classList.add('loading'); var t = el.querySelector('.label'); if (t) t.textContent = el.getAttribute('data-busy');
+    });
+  });
+  window.addEventListener('pageshow', function (e) { if (e.persisted) location.reload(); });
+</script>
+</body>
+</html>
