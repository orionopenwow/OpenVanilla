+/// Open Vanilla: the game (realmd) account ids behind these account names, by upper-case name
+/// (auth::herokey's Hero ID list for Legend issuers: characters belong to the id).
+pub async fn account_ids(
+    db: &MySqlPool,
+    usernames: &[&str],
+) -> Result<std::collections::HashMap<String, i64>> {
+    let mut result = std::collections::HashMap::new();
+    for chunk in usernames.chunks(500) {
+        let mut query = sqlx::QueryBuilder::<sqlx::MySql>::new(
+            "SELECT a.username, CAST(a.id AS SIGNED) FROM classicrealmd.account a WHERE a.username IN (",
+        );
+        let mut values = query.separated(", ");
+        for username in chunk {
+            values.push_bind(*username);
+        }
+        values.push_unseparated(")");
+        for (name, id) in query.build_query_as::<(String, i64)>().fetch_all(db).await? {
+            result.insert(name.to_ascii_uppercase(), id);
+        }
+    }
+    Ok(result)
+}
