+    let (aname,): (String,) = sqlx::query_as("SELECT game_username FROM game_accounts WHERE user_id = ?").bind(users[0].0).fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(heroes[0]["username"], aname.as_str());
+    assert!(heroes[0]["account"].is_null(), "the game database isn't reachable in tests");
+
+    // a revoked key's Hero ID is no longer listed; unticking takes it off too
+    sqlx::query("UPDATE hero_keys SET revoked_at = 1 WHERE user_id = ?").bind(users[0].0).execute(&h.state.db).await.unwrap();
+    assert!(list(&h).await.is_empty());
+    sqlx::query("UPDATE hero_keys SET revoked_at = NULL WHERE user_id = ?").bind(users[0].0).execute(&h.state.db).await.unwrap();
+    assert_eq!(list(&h).await.len(), 1);
+    send(&h.app, form("/account/hero/public", Some(&asess), &[("_csrf", &csrf_of(&apage.body))])).await;
+    assert!(list(&h).await.is_empty());
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
