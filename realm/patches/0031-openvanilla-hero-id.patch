+// -- Hero IDs ----------------------------------------------------------------------------------------
+
+/// The Ed25519 seed a key's secret makes (the Legend standard, fixed for good):
+/// HKDF-SHA256 over the secret's 32 bytes, salt `openvanilla-hero-v1`, info `ed25519-seed`, 32 bytes.
+/// Any other implementation (the key page's WebCrypto, a Legend issuer) must get the same seed.
+pub fn hero_seed(secret: &[u8; 32]) -> [u8; 32] {
+    let mut seed = [0u8; 32];
+    hkdf::Hkdf::<Sha256>::new(Some(b"openvanilla-hero-v1"), secret)
+        .expand(b"ed25519-seed", &mut seed)
+        .expect("32 bytes is a valid HKDF-SHA256 length");
+    seed
+}
+
+/// The 32 bytes behind a key's secret (43 characters of base64url).
+fn secret_bytes(secret: &str) -> Option<[u8; 32]> {
+    base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(secret).ok()?.try_into().ok()
+}
+
+fn hero_signing_key(secret: &str) -> Option<SigningKey> {
+    Some(SigningKey::from_bytes(&hero_seed(&secret_bytes(secret)?)))
+}
+
+/// The Hero ID's public key for a key's secret.
+pub fn hero_pub_of(secret: &str) -> Option<[u8; 32]> {
+    Some(hero_signing_key(secret)?.verifying_key().to_bytes())
+}
+
+/// `ovh1.<public key, base64url>`.
+pub fn hero_id(public: &[u8]) -> String {
+    format!("{HERO_PREFIX}.{}", base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(public))
+}
+
+/// The public key in a Hero ID string.
+pub fn parse_hero(s: &str) -> Option<[u8; 32]> {
+    let b64 = s.trim().strip_prefix("ovh1.")?;
+    base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(b64).ok()?.try_into().ok()
+}
+
+/// Sign `message` with the Hero ID a key's secret makes: the signature, base64url. The realm never
+/// signs anything itself (it never keeps the secret); this is for tests and tools.
+pub fn hero_sign(secret: &str, message: &[u8]) -> Option<String> {
+    let sig = hero_signing_key(secret)?.sign(message);
+    Some(base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(sig.to_bytes()))
+}
+
+/// Is `sig` (base64url, 64 bytes) this Hero ID's signature of `message`? Strict RFC 8032 checks.
+pub fn hero_verify(public: &[u8; 32], message: &[u8], sig: &str) -> bool {
+    let Ok(sig) = base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(sig.trim().trim_end_matches('=')) else {
+        return false;
+    };
+    let Ok(sig) = ed25519_dalek::Signature::from_slice(&sig) else {
+        return false;
+    };
+    VerifyingKey::from_bytes(public).is_ok_and(|k| k.verify_strict(message, &sig).is_ok())
+}
+
+/// Fill in the Hero ID of a key that has none yet (keys made before Hero IDs), from its secret,
+/// which the caller has just checked.
+async fn fill_hero_pub(db: &SqlitePool, key_id: &str, secret: &str) {
+    if let Some(p) = hero_pub_of(secret) {
+        let _ = sqlx::query("UPDATE hero_keys SET hero_pub = ? WHERE key_id = ? AND hero_pub IS NULL")
+            .bind(p.to_vec())
+            .bind(key_id)
+            .execute(db)
+            .await;
+    }
+}
+
+/// A new sign-in challenge: 32 random bytes, base64url, and when it stops working.
+pub async fn new_challenge(db: &SqlitePool) -> anyhow::Result<(String, i64)> {
+    use rand::RngCore;
+    let mut bytes = [0u8; 32];
+    rand::rngs::OsRng.fill_bytes(&mut bytes);
+    let challenge = base64::engine::general_purpose::URL_SAFE_NO_PAD.encode(bytes);
+    let expires = now() + CHALLENGE_SECS;
+    sqlx::query("DELETE FROM hero_challenges WHERE expires_at <= ?").bind(now()).execute(db).await?;
+    sqlx::query("INSERT INTO hero_challenges (challenge, expires_at) VALUES (?, ?)")
+        .bind(&challenge)
+        .bind(expires)
+        .execute(db)
+        .await?;
+    Ok((challenge, expires))
+}
+
+/// Use up a challenge: `true` once, while it is fresh.
+async fn take_challenge(db: &SqlitePool, challenge: &str) -> anyhow::Result<bool> {
+    let r = sqlx::query("DELETE FROM hero_challenges WHERE challenge = ? AND expires_at > ?")
+        .bind(challenge)
+        .bind(now())
+        .execute(db)
+        .await?;
+    Ok(r.rows_affected() == 1)
+}
