+// -- Hero ID routes ------------------------------------------------------------------------------------
+
+/// The network a request comes from, for limits (as `auth::guest` counts it).
+fn net_of(headers: &HeaderMap) -> String {
+    super::guest::ip_bucket(client_ip(headers).as_deref().unwrap_or(""))
+}
+
+fn json_status(status: StatusCode, body: serde_json::Value) -> Response {
+    no_store((status, Json(body)).into_response())
+}
+
+/// `GET /api/hero/challenge`: `{"challenge": "<32 random bytes, base64url>", "expires": <unix>}`.
+async fn challenge(State(state): State<Arc<AppState>>, headers: HeaderMap) -> Result<Response, AppError> {
+    if !state.limiter.allow(&format!("herochallenge:net:{}", net_of(&headers)), 60, 900) {
+        return Err(AppError::TooMany);
+    }
+    let (challenge, expires) = new_challenge(&state.db).await?;
+    Ok(no_store(Json(serde_json::json!({ "challenge": challenge, "expires": expires })).into_response()))
+}
+
+#[derive(serde::Deserialize)]
+struct HeroSignIn {
+    #[serde(default)]
+    key_id: String,
+    #[serde(default)]
+    hero: String,
+    #[serde(default)]
+    challenge: String,
+    #[serde(default)]
+    sig: String,
+}
+
+/// `POST /auth/hero`: the key page signed a challenge with the key's Hero ID, so the secret never
+/// left the browser. Signs in exactly as `/auth/key` does. `{"ok": true, "to": "<where next>"}`, or
+/// `{"ok": false, "error": "…"}`; `"fallback": true` asks the page to send the key the old way
+/// once (a key made before Hero IDs: the realm has no Hero ID for it yet).
+async fn hero_sign_in(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    jar: CookieJar,
+    Json(f): Json<HeroSignIn>,
+) -> Result<Response, AppError> {
+    let no = |status: StatusCode, msg: &str| json_status(status, serde_json::json!({ "ok": false, "error": msg }));
+    if !super::guest::same_site(&headers) {
+        return Ok(no(StatusCode::FORBIDDEN, "Open the realm's own page to sign in with your Hero Key."));
+    }
+    let ip = client_ip(&headers);
+    // the same counters as /auth/key: switching ways in buys no extra tries
+    if !state.limiter.allow(&format!("herokey:net:{}", net_of(&headers)), 20, 900) {
+        audit::log(&state.db, None, ip.as_deref(), "login.limited", Some("herokey"), None).await;
+        return Ok(no(StatusCode::TOO_MANY_REQUESTS, "Too many tries. Wait 15 minutes and try again."));
+    }
+    let key_id = f.key_id.trim();
+    if key_id.len() != ID_LEN || !key_id.bytes().all(|b| b.is_ascii_alphanumeric()) {
+        return Ok(no(StatusCode::BAD_REQUEST, "That doesn't look like a Hero Key. It starts with ovk1. Paste the whole line, or drop the file."));
+    }
+    if !state.limiter.allow(&format!("herokey:id:{key_id}"), 10, 900) {
+        return Ok(no(StatusCode::TOO_MANY_REQUESTS, "Too many tries with that key. Wait 15 minutes and try again."));
+    }
+    // used up whatever happens next: one challenge, one try
+    if f.challenge.len() > 64 || !take_challenge(&state.db, &f.challenge).await? {
+        return Ok(no(StatusCode::UNAUTHORIZED, "That took too long. Try again."));
+    }
+    let row: Option<(i64, Option<Vec<u8>>, i64)> = sqlx::query_as(
+        "SELECT k.user_id, k.hero_pub, u.disabled FROM hero_keys k JOIN users u ON u.id = k.user_id \
+         WHERE k.key_id = ? AND k.revoked_at IS NULL",
+    )
+    .bind(key_id)
+    .fetch_optional(&state.db)
+    .await?;
+    let failed = "That Hero Key didn't work. It may have been replaced by a newer one. Check you copied all of it, or sign in another way and make a new key.";
+    let Some((uid, stored, disabled)) = row else {
+        audit::log(&state.db, None, ip.as_deref(), "login.fail", Some("herokey"), Some("hero")).await;
+        return Ok(no(StatusCode::UNAUTHORIZED, failed));
+    };
+    let Some(stored) = stored.and_then(|p| <[u8; 32]>::try_from(p.as_slice()).ok()) else {
+        return Ok(json_status(StatusCode::CONFLICT, serde_json::json!({ "ok": false, "fallback": true })));
+    };
+    let ok = {
+        use subtle::ConstantTimeEq;
+        let same: bool = parse_hero(&f.hero).is_some_and(|h| h.ct_eq(&stored).into());
+        same && hero_verify(&stored, format!("{CHALLENGE_MESSAGE}{}", f.challenge).as_bytes(), &f.sig)
+    };
+    if !ok || disabled != 0 {
+        audit::log(&state.db, None, ip.as_deref(), "login.fail", Some("herokey"), Some("hero")).await;
+        return Ok(no(StatusCode::UNAUTHORIZED, failed));
+    }
+    let ua = headers.get("user-agent").and_then(|v| v.to_str().ok());
+    mark_used(&state.db, key_id, ua).await;
+    let token = session::create(&state.db, uid, ip.as_deref(), ua).await?;
+    audit::log(&state.db, Some(uid), ip.as_deref(), "login.ok", Some("herokey"), Some("hero")).await;
+    let jar = jar.add(session::cookie(token, !state.cfg.cookie_insecure));
+    let dest = super::oauth::landing(&jar, "/account/key?back=1");
