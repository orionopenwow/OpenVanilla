+        .header("sec-fetch-site", "same-origin")
+        .body(Body::from(body.to_string()))
+        .unwrap()
+}
+
+async fn new_challenge(h: &Harness) -> String {
+    let r = send(&h.app, Request::get("/api/hero/challenge").body(Body::empty()).unwrap()).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    let j: serde_json::Value = serde_json::from_str(&r.body).unwrap();
+    assert!(j["expires"].as_i64().unwrap() > wenilla_realm::db::now());
+    j["challenge"].as_str().unwrap().to_string()
+}
+
+/// What the key page sends: the key id, the Hero ID, the challenge and its signature (never the secret).
+async fn hero_sign_in(h: &Harness, key: &str, challenge: &str) -> (Resp, serde_json::Value) {
+    let sig = herokey::hero_sign(&key[16..], format!("openvanilla-hero-v1\nchallenge:{challenge}").as_bytes()).unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(key), "challenge": challenge, "sig": sig });
+    let r = send(&h.app, json_post("/auth/hero", body)).await;
+    let j = serde_json::from_str(&r.body).unwrap_or_default();
+    (r, j)
+}
