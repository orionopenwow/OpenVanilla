+#[tokio::test]
+async fn hero_sign_in_shares_the_key_sign_in_limits() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let bogus = format!("ovk1.abcdefghij.{}", "A".repeat(43));
+    for _ in 0..10 {
+        let c = new_challenge(&h).await;
+        let (r, _) = hero_sign_in(&h, &bogus, &c).await;
+        assert_eq!(r.status, StatusCode::UNAUTHORIZED, "{}", r.body);
+    }
+    let c = new_challenge(&h).await;
+    let (r, _) = hero_sign_in(&h, &bogus, &c).await;
+    assert!(r.status == StatusCode::TOO_MANY_REQUESTS && r.body.contains("Too many tries with that key"), "per key: {}", r.body);
+    // the same counter as /auth/key
+    let r = send(&h.app, form("/auth/key", None, &[("key", &bogus)])).await;
+    assert!(r.body.contains("Too many tries with that key"), "{}", r.body);
+    for i in 0..8 {
+        let k = format!("ovk1.abcdefgh{i:02}.{}A", "B".repeat(42));
+        let c = new_challenge(&h).await;
+        hero_sign_in(&h, &k, &c).await;
+    }
+    let c = new_challenge(&h).await;
+    let (r, _) = hero_sign_in(&h, &format!("ovk1.zzzzzzzzzz.{}A", "C".repeat(42)), &c).await;
+    assert!(r.status == StatusCode::TOO_MANY_REQUESTS && r.body.contains("Too many tries."), "per network: {}", r.body);
+}
