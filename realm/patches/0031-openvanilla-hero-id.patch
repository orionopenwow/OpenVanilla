+#[tokio::test]
+async fn a_key_gets_its_hero_id_when_made_and_an_older_key_on_its_next_sign_in() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let (sess, page) = new_guest(&h).await;
+    let key = key_on(&page.body);
+
+    // made with the key: the Hero ID is right under it, and kept (the public half only)
+    let hero = hero_on(&page.body);
+    assert_eq!(hero, hero_of(&key));
+    assert!(hero.starts_with("ovh1.") && hero.len() == 5 + 43, "{hero}");
+    assert!(page.body.contains("Your Hero ID is public-safe: it proves a Legend is yours without giving away your key."), "{}", page.body);
+    assert!(page.body.contains("action=\"/account/hero/public\"") && page.body.contains("Show my Hero ID on my Legends"));
+    let (p,): (Vec<u8>,) = sqlx::query_as("SELECT hero_pub FROM hero_keys").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(herokey::hero_id(&p), hero);
+    let later = send(&h.app, get("/account/key", Some(&sess))).await;
+    assert_eq!(hero_on(&later.body), hero, "shown every time, unlike the key");
+
+    // a key made before Hero IDs: none yet, so the page says how to get one, and the key page's
+    // signed sign-in asks for the key the old way once
+    sqlx::query("UPDATE hero_keys SET hero_pub = NULL").execute(&h.state.db).await.unwrap();
+    let old = send(&h.app, get("/account/key", Some(&sess))).await;
+    assert!(old.body.contains("Sign in with your Hero Key once to see your Hero ID.") && !old.body.contains("id=\"herotext\""), "{}", old.body);
+    let c = new_challenge(&h).await;
+    let (r, j) = hero_sign_in(&h, &key, &c).await;
+    assert_eq!(r.status, StatusCode::CONFLICT, "{}", r.body);
+    assert_eq!(j["fallback"], true);
+    assert!(named(&r, "wr_session").is_none());
+    let r = send(&h.app, form("/auth/key", None, &[("key", &key)])).await;
+    assert_eq!(r.status, StatusCode::SEE_OTHER, "{}", r.body);
+    let (p,): (Option<Vec<u8>>,) = sqlx::query_as("SELECT hero_pub FROM hero_keys").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(herokey::hero_id(&p.expect("filled on sign-in")), hero);
+    let c = new_challenge(&h).await;
+    let (r, j) = hero_sign_in(&h, &key, &c).await;
+    assert_eq!(j["ok"], true, "{}", r.body);
+
+    // a new key gets a new Hero ID (mint fills it)
+    let csrf = csrf_of(&page.body);
+    let r = send(&h.app, form("/account/key/new", Some(&sess), &[("_csrf", &csrf)])).await;
+    let fresh = send(&h.app, get("/account/key", Some(&with(&sess, &named(&r, "wr_herokey"))))).await;
+    let (fkey, fhero) = (key_on(&fresh.body), hero_on(&fresh.body));
+    assert_ne!(fhero, hero);
+    assert_eq!(fhero, hero_of(&fkey));
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
