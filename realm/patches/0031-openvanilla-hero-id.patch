+#[tokio::test]
+async fn any_site_can_check_a_hero_id_signature() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    let (h, _) = setup_discord().await;
+    let secret = format!("{}A", "Q".repeat(42));
+    let hero = herokey::hero_id(&herokey::hero_pub_of(&secret).unwrap());
+    let message = "Legend: First to 60 on Open Vanilla";
+    let sig = herokey::hero_sign(&secret, message.as_bytes()).unwrap();
+    // from another site's page, as text/plain (no preflight): no cookies, nothing changes
+    let check = |body: String| {
+        Request::post("/api/hero/verify")
+            .header(header::CONTENT_TYPE, "text/plain")
+            .header("sec-fetch-site", "cross-site")
+            .header("origin", "https://legends.example")
+            .body(Body::from(body))
+            .unwrap()
+    };
+    let r = send(&h.app, check(serde_json::json!({ "hero": hero, "message": message, "sig": sig }).to_string())).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert_eq!(r.body, r#"{"ok":true}"#);
+    assert_eq!(r.headers.get(header::ACCESS_CONTROL_ALLOW_ORIGIN).unwrap(), "*");
+    let r = send(&h.app, check(serde_json::json!({ "hero": hero, "message": "Legend: something else", "sig": sig }).to_string())).await;
+    assert_eq!(r.body, r#"{"ok":false}"#);
+    let r = send(&h.app, check(serde_json::json!({ "hero": "ovh1.nope", "message": message, "sig": sig }).to_string())).await;
+    assert_eq!(r.body, r#"{"ok":false}"#);
+    let r = send(&h.app, check("not json".into())).await;
+    assert_eq!(r.status, StatusCode::BAD_REQUEST);
+    // the published test vector checks out here too
+    let r = send(&h.app, check(serde_json::json!({
+        "hero": "ovh1.GVSN6lA0SzCD8nQfZIyrChuVy5ERLpDJNQT1xssI-Sg",
+        "message": "openvanilla-hero-v1\nchallenge:abc",
+        "sig": "N-HLEYmR5g_4FCo_me8yAcKGnFyzI2zaH9K0paTp1zG4itrnvcjtF9CtCh1do9HWOQXvKT81o2C7K0mE3usdCA",
+    }).to_string())).await;
+    assert_eq!(r.body, r#"{"ok":true}"#);
+    // a browser's preflight is answered
+    let r = send(&h.app, Request::options("/api/hero/verify").header("origin", "https://legends.example").body(Body::empty()).unwrap()).await;
+    assert_eq!(r.status, StatusCode::NO_CONTENT);
+    assert_eq!(r.headers.get(header::ACCESS_CONTROL_ALLOW_ORIGIN).unwrap(), "*");
+    // and it is limited per network
+    for _ in 0..300 {
+        send(&h.app, check("{}".into())).await;
+    }
+    let r = send(&h.app, check(serde_json::json!({ "hero": hero, "message": message, "sig": sig }).to_string())).await;
+    assert_eq!(r.status, StatusCode::TOO_MANY_REQUESTS);
+}
