+/// `POST /account/hero/public`: "Show my Hero ID on my Legends".
+async fn hero_public(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Form(f): Form<PublicForm>,
+) -> Result<Response, AppError> {
+    csrf::verify(&session, &f.csrf)?;
+    let on = f.public.is_some_and(|v| !v.is_empty() && v != "0");
+    sqlx::query("UPDATE users SET hero_public = ? WHERE id = ?")
+        .bind(i64::from(on))
+        .bind(session.user.id)
+        .execute(&state.db)
+        .await?;
+    audit::log(&state.db, Some(session.user.id), client_ip(&headers).as_deref(), "herokey.public", None, Some(if on { "on" } else { "off" })).await;
+    if from_script(&headers) {
+        return Ok(no_store(Json(serde_json::json!({ "public": on })).into_response()));
+    }
+    Ok(Redirect::to("/account/key").into_response())
+}
+
+/// Any site may read the Hero ID list and use the verify endpoint (neither reads cookies).
+fn open_cors(mut r: Response) -> Response {
+    let h = r.headers_mut();
+    h.insert(header::ACCESS_CONTROL_ALLOW_ORIGIN, HeaderValue::from_static("*"));
+    h.insert(header::ACCESS_CONTROL_ALLOW_METHODS, HeaderValue::from_static("GET, POST, OPTIONS"));
+    h.insert(header::ACCESS_CONTROL_ALLOW_HEADERS, HeaderValue::from_static("content-type"));
+    h.insert(header::ACCESS_CONTROL_MAX_AGE, HeaderValue::from_static("86400"));
+    r
+}
+
+async fn open_to_all() -> Response {
+    open_cors(StatusCode::NO_CONTENT.into_response())
+}
+
+/// `GET /api/heroes.json`: `{"heroes": [{"account": <game account id>, "username": "WR000007",
+/// "hero": "ovh1.…"}]}`, only for players who ticked "Show my Hero ID on my Legends" and have a
+/// working key with a Hero ID. `account` is the game (realmd) account's id, which characters
+/// belong to; it is `null` while the game database can't be reached.
+async fn heroes_json(State(state): State<Arc<AppState>>, headers: HeaderMap) -> Result<Response, AppError> {
+    if !state.limiter.allow(&format!("heroes:net:{}", net_of(&headers)), 120, 900) {
+        return Err(AppError::TooMany);
+    }
+    let rows: Vec<(String, Vec<u8>)> = sqlx::query_as(
+        "SELECT g.game_username, k.hero_pub FROM users u \
+         JOIN hero_keys k ON k.user_id = u.id AND k.revoked_at IS NULL \
+         JOIN game_accounts g ON g.user_id = u.id \
+         WHERE u.hero_public = 1 AND u.disabled = 0 AND k.hero_pub IS NOT NULL ORDER BY u.id",
+    )
+    .fetch_all(&state.db)
+    .await?;
+    let ids = if rows.is_empty() {
+        Default::default()
+    } else {
+        let names: Vec<&str> = rows.iter().map(|(n, _)| n.as_str()).collect();
+        crate::realmdb::account_ids(&state.realmdb, &names).await.unwrap_or_else(|e| {
+            tracing::warn!(error = %e, "heroes.json: game account ids");
+            Default::default()
+        })
+    };
+    let heroes: Vec<serde_json::Value> = rows
+        .iter()
+        .filter(|(_, p)| p.len() == 32)
+        .map(|(name, p)| {
+            serde_json::json!({ "account": ids.get(&name.to_ascii_uppercase()), "username": name, "hero": hero_id(p) })
+        })
+        .collect();
+    let mut r = open_cors(Json(serde_json::json!({ "heroes": heroes })).into_response());
+    r.headers_mut().insert(header::CACHE_CONTROL, HeaderValue::from_static("public, max-age=60"));
+    Ok(r)
+}
+
+#[derive(serde::Deserialize)]
+struct VerifyReq {
+    #[serde(default)]
+    hero: String,
+    #[serde(default)]
+    message: String,
+    #[serde(default)]
+    sig: String,
+}
+
+/// `POST /api/hero/verify` `{"hero", "message", "sig"}` → `{"ok": true|false}`: is `sig` (base64url)
+/// that Hero ID's signature of the UTF-8 `message`? A pure check, so any site can use Hero IDs
+/// without its own Ed25519. The body is read as JSON whatever its content type, so a page
+/// elsewhere can send it as text/plain without a preflight.
+async fn hero_verify_api(State(state): State<Arc<AppState>>, headers: HeaderMap, body: axum::body::Bytes) -> Response {
+    if !state.limiter.allow(&format!("heroverify:net:{}", net_of(&headers)), 300, 900) {
+        return open_cors(json_status(StatusCode::TOO_MANY_REQUESTS, serde_json::json!({ "ok": false, "error": "slow down" })));
+    }
+    let Ok(v) = serde_json::from_slice::<VerifyReq>(&body) else {
+        return open_cors(json_status(StatusCode::BAD_REQUEST, serde_json::json!({ "ok": false, "error": "send JSON: {\"hero\", \"message\", \"sig\"}" })));
+    };
+    let ok = v.message.len() <= 4096 && parse_hero(&v.hero).is_some_and(|p| hero_verify(&p, v.message.as_bytes(), &v.sig));
+    open_cors(json_status(StatusCode::OK, serde_json::json!({ "ok": ok })))
+}
