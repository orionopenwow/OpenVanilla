+#[tokio::test]
+async fn the_key_page_signs_in_with_a_signed_challenge_instead_of_the_key() {
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let (_, page) = new_guest(&h).await;
+    let key = key_on(&page.body);
+    let uid: (i64,) = sqlx::query_as("SELECT user_id FROM hero_keys").fetch_one(&h.state.db).await.unwrap();
+    let p = send(&h.app, get("/key", None)).await;
+    assert!(p.body.contains("/api/hero/challenge") && p.body.contains("/auth/hero") && p.body.contains("action=\"/auth/key\""), "the page signs, and falls back to the form");
+
+    // a correct signature signs in like the key itself, to the same page
+    let c = new_challenge(&h).await;
+    let (r, j) = hero_sign_in(&h, &key, &c).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", r.body);
+    assert_eq!(j["ok"], true);
+    assert_eq!(j["to"], "/account/key?back=1");
+    let sess = named(&r, "wr_session").expect("signed in");
+    let back = send(&h.app, get("/account/key?back=1", Some(&sess))).await;
+    assert!(back.body.contains("Welcome back") && back.body.contains("Last used"), "{}", back.body);
+    let who: (i64,) = sqlx::query_as("SELECT user_id FROM sessions ORDER BY id DESC LIMIT 1").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(who.0, uid.0);
+    let (detail,): (Option<String>,) = sqlx::query_as("SELECT detail FROM audit WHERE action = 'login.ok' ORDER BY id DESC LIMIT 1").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(detail.as_deref(), Some("hero"));
+
+    // a challenge works once
+    let (r, j) = hero_sign_in(&h, &key, &c).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+    assert!(j["error"].as_str().unwrap().contains("took too long") && named(&r, "wr_session").is_none(), "{}", r.body);
+
+    // a signature of something else
+    let c = new_challenge(&h).await;
+    let other = new_challenge(&h).await;
+    let sig = herokey::hero_sign(&key[16..], format!("openvanilla-hero-v1\nchallenge:{other}").as_bytes()).unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&key), "challenge": c, "sig": sig });
+    let r = send(&h.app, json_post("/auth/hero", body)).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+    assert!(r.body.contains("That Hero Key didn") && named(&r, "wr_session").is_none(), "{}", r.body);
+    // ...and that challenge is gone too: one challenge, one try
+    let (r, _) = hero_sign_in(&h, &key, &c).await;
+    assert!(r.body.contains("took too long"), "{}", r.body);
+
+    // an expired challenge
+    sqlx::query("UPDATE hero_challenges SET expires_at = ? WHERE challenge = ?").bind(wenilla_realm::db::now() - 1).bind(&other).execute(&h.state.db).await.unwrap();
+    let (r, _) = hero_sign_in(&h, &key, &other).await;
+    assert_eq!(r.status, StatusCode::UNAUTHORIZED);
+    assert!(r.body.contains("took too long"), "{}", r.body);
+
+    // another key's id, or another key's Hero ID with its own good signature
+    let c = new_challenge(&h).await;
+    let wrong_id = format!("ovk1.ZZZZZZZZZZ.{}", &key[16..]);
+    let (r, _) = hero_sign_in(&h, &wrong_id, &c).await;
+    assert!(r.status == StatusCode::UNAUTHORIZED && r.body.contains("That Hero Key didn"), "{}", r.body);
+    let c = new_challenge(&h).await;
+    let stranger = format!("{}.{}", &key[..15], "B".repeat(42) + "A");
+    let sig = herokey::hero_sign(&stranger[16..], format!("openvanilla-hero-v1\nchallenge:{c}").as_bytes()).unwrap();
+    let body = serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&stranger), "challenge": c, "sig": sig });
+    let r = send(&h.app, json_post("/auth/hero", body)).await;
+    assert!(r.status == StatusCode::UNAUTHORIZED && named(&r, "wr_session").is_none(), "{}", r.body);
+
+    // only from the realm's own page
+    let c = new_challenge(&h).await;
+    let sig = herokey::hero_sign(&key[16..], format!("openvanilla-hero-v1\nchallenge:{c}").as_bytes()).unwrap();
+    let req = Request::post("/auth/hero")
+        .header(header::CONTENT_TYPE, "application/json")
+        .header("origin", "https://evil.example")
+        .body(Body::from(serde_json::json!({ "key_id": &key[5..15], "hero": hero_of(&key), "challenge": c, "sig": sig }).to_string()))
+        .unwrap();
+    let r = send(&h.app, req).await;
+    assert!(r.status == StatusCode::FORBIDDEN && named(&r, "wr_session").is_none(), "{}", r.body);
+
+    // and a disabled account can't
+    sqlx::query("UPDATE users SET disabled = 1 WHERE id = ?").bind(uid.0).execute(&h.state.db).await.unwrap();
+    let (r, _) = hero_sign_in(&h, &key, &c).await;
+    assert!(named(&r, "wr_session").is_none(), "{}", r.body);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
