+-- Open Vanilla: Hero IDs. A Hero ID (ovh1.<public key>) is the public half of an Ed25519 key that
+-- comes from the Hero Key's secret (auth::herokey). It proves a Legend is yours without giving
+-- away the key, and lets the key page sign in without sending the secret. The realm fills it in
+-- whenever it sees the secret (a key being made, a sign-in with the key); the secret itself is
+-- still never stored.
+ALTER TABLE hero_keys ADD COLUMN hero_pub BLOB;
+-- "Show my Hero ID on my Legends": off until the player turns it on.
+ALTER TABLE users ADD COLUMN hero_public INTEGER NOT NULL DEFAULT 0;
+-- Sign-in challenges for the key page (POST /auth/hero): random, five minutes, used once.
+CREATE TABLE hero_challenges (
+  challenge TEXT PRIMARY KEY,
+  expires_at INTEGER NOT NULL
+);
