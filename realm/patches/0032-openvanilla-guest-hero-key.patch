+#[tokio::test]
+async fn a_new_guests_key_is_made_at_play_now_and_shown_in_game_until_saved() {
+    // Open Vanilla 0032
+    let _env = DISCORD_ENV.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+    std::env::set_var("OPENVANILLA_GUESTS", "1");
+    std::env::remove_var("DISCORD_SIGNIN");
+    let (h, _) = setup_discord().await;
+    let r = send(&h.app, form("/auth/guest", None, &[])).await;
+    assert_eq!(r.location(), "/", "straight into the game");
+    let sess = named(&r, "wr_session").expect("signed in");
+    let play = named(&r, "wr_herokey_play").expect("the key, encrypted, for the in-game window");
+    let (n,): (i64,) = sqlx::query_as("SELECT COUNT(*) FROM hero_keys WHERE revoked_at IS NULL").fetch_one(&h.state.db).await.unwrap();
+    assert_eq!(n, 1, "the key exists from the first click");
+
+    // the in-game window gets the key itself (no "Make my key" step), the same one on every reload
+    let both = with(&sess, &Some(play.clone()));
+    let j = ask(&h, &both).await;
+    assert_eq!(j["ask"], true);
+    let key = j["key"].as_str().expect("the key in the window").to_string();
+    assert!(key.starts_with("ovk1.") && key.len() == 5 + 10 + 1 + 43, "{key}");
+    assert!(!play.contains(&key[16..]), "the cookie is not the key in the clear");
+    assert_eq!(ask(&h, &both).await["key"], key.as_str());
+    assert!(ask(&h, &sess).await["key"].is_null(), "another browser (no cookie) never sees it");
+
+    // the key works at once ("I have a Hero Key", the .txt file's whole text pasted)
+    let file = format!("Open Vanilla Hero Key\r\n\r\nYour key:\r\n\r\n{key}\r\n");
+    let r2 = send(&h.app, form("/auth/key", None, &[("key", &file)])).await;
+    assert_eq!(r2.status, StatusCode::SEE_OTHER, "{}", r2.body);
+
+    // saved: the cookie goes, and nobody is asked again
+    let kp = send(&h.app, get("/account/key", Some(&both))).await;
+    assert_eq!(key_on(&kp.body), key, "the key page shows the same key");
+    let mut req = form("/account/key/saved", Some(&both), &[("_csrf", &csrf_of(&kp.body))]);
+    req.headers_mut().insert("x-requested-with", "wenilla".parse().unwrap());
+    let r3 = send(&h.app, req).await;
+    assert!(r3.body.contains("\"saved\":true"), "{}", r3.body);
+    let gone = r3.headers.get_all(header::SET_COOKIE).iter().map(|v| v.to_str().unwrap().to_string())
+        .any(|c| c.starts_with("wr_herokey_play=") && (c.contains("Max-Age=0") || c.contains("1970")));
+    assert!(gone, "the key's cookie is dropped once saved");
+    assert_eq!(ask(&h, &both).await["ask"], false);
+
+    // the key-file part of /key waits behind ?debug=1 (the page script shows it; players paste)
+    let p = send(&h.app, get("/key", None)).await;
+    assert!(p.body.contains("id=\"drop\" tabindex=\"0\" data-debug hidden") && p.body.contains("DEBUG · "), "{}", p.body);
+    std::env::remove_var("OPENVANILLA_GUESTS");
+}
