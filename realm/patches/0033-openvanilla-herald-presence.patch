+/// Open Vanilla: whether a server spline driving our own player counts as presence this frame.
+/// Herald, the realm's bot AI playing this character (`.bot self`), moves the player by server
+/// splines while the player watches with hands off the keys. With only raw input stamping the
+/// clock, the 5-minute leg sat Herald down and marked the player AFK, and the 30-minute leg asked
+/// for a logout mid-session (a player's report, 2026-10-21). A taxi flight is not presence: it
+/// keeps the reference's timer, so a long flight still goes AFK as it does in 1.12. A charge or a
+/// fear is a server ride too, too short to matter either way.
+pub(crate) fn ride_is_presence(riding: bool, on_taxi: bool) -> bool {
+    riding && !on_taxi
+}
+
+/// Stamp the clock while a server ride other than a taxi flight drives our player; see
+/// [`ride_is_presence`]. `Player` is absent in tests that build the chat plugin alone.
+pub(crate) fn stamp_server_ride(
+    time: Res<Time<Real>>,
+    mut last: ResMut<LastInput>,
+    player: Option<Res<crate::player::Player>>,
+    self_q: Query<&crate::net::ObjectStore, With<crate::net::SelfPlayer>>,
+) {
+    let Some(player) = player else {
+        return;
+    };
+    let on_taxi = self_q
+        .iter()
+        .next()
+        .is_some_and(|store| store.0.unit_flags() & crate::player::UNIT_FLAG_TAXI_FLIGHT != 0);
+    if ride_is_presence(player.server_riding(), on_taxi) {
+        last.0 = time.elapsed();
+    }
+}
+
