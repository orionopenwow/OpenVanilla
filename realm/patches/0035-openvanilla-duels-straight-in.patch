--- /dev/null
+++ b/crates/benilla-app/src/char_select/duel.rs
@@ -0,0 +1,321 @@
+//! Open Vanilla Duels: straight in. With `WOW_DUEL` (the page's `?duel=…`, or `duel` in
+//! `window.__wenilla_env`) the character screen never waits for a click: the first roster is
+//! answered with the account's duel body, made on the spot when there is none.
+//!
+//! The value is a wish: `1` (any body: the remembered one, else a new one of a random race and
+//! class), or words in any order: a race (`orc`, `nightelf`, `undead`, …), a class (`warrior`,
+//! `mage`, …) and `f` for a female body (`?duel=orc-warrior`, `?duel=mage`, `?duel=gnome+warlock+f`).
+//! A character of that race and class (the highest level) is entered; with only a class, any race;
+//! with none on the account, one is made with a generated name (a few tries if the name is taken)
+//! and entered. The Duels realm starts every character at level 60 in the Lion's Pride Inn
+//! (hetzner/duels_up.sh), and the world server queues it from there.
+
+use benilla_protocol::{CharAction, CharCreateReq, Character};
+use bevy::prelude::*;
+
+use super::{send_pick, Roster};
+use crate::net::{CharActionResultMessage, CharPick, CharRequest};
+
+/// What `WOW_DUEL` asked for.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct Wish {
+    pub(crate) race: Option<u8>,
+    pub(crate) class: Option<u8>,
+    pub(crate) female: bool,
+}
+
+/// The duel fast path's progress, kept on [`Roster`].
+#[derive(Clone, Debug, Default)]
+pub(crate) struct DuelPath {
+    pub(crate) wish: Option<Wish>,
+    /// A create is in flight under this name; the next roster with the body picks it.
+    pub(crate) creating: Option<String>,
+    pub(crate) tries: u8,
+}
+
+const MAX_TRIES: u8 = 6;
+
+/// Races per class in 1.12 (`CharBaseInfo.dbc`).
+const VALID: [(u8, &[u8]); 9] = [
+    (1, &[1, 2, 3, 4, 5, 6, 7, 8]), // warrior
+    (2, &[1, 3]),                   // paladin
+    (3, &[2, 3, 4, 6, 8]),          // hunter
+    (4, &[1, 2, 3, 4, 5, 7, 8]),    // rogue
+    (5, &[1, 3, 4, 5, 8]),          // priest
+    (7, &[2, 6, 8]),                // shaman
+    (8, &[1, 5, 7, 8]),             // mage
+    (9, &[1, 2, 5, 7]),             // warlock
+    (11, &[4, 6]),                  // druid
+];
+
+fn race_word(w: &str) -> Option<u8> {
+    Some(match w {
+        "human" => 1,
+        "orc" => 2,
+        "dwarf" => 3,
+        "nightelf" | "nelf" | "elf" => 4,
+        "undead" | "scourge" | "forsaken" => 5,
+        "tauren" => 6,
+        "gnome" => 7,
+        "troll" => 8,
+        _ => return None,
+    })
+}
+
+fn class_word(w: &str) -> Option<u8> {
+    Some(match w {
+        "warrior" => 1,
+        "paladin" => 2,
+        "hunter" => 3,
+        "rogue" => 4,
+        "priest" => 5,
+        "shaman" => 7,
+        "mage" => 8,
+        "warlock" => 9,
+        "druid" => 11,
+        _ => return None,
+    })
+}
+
+pub(crate) fn valid(race: u8, class: u8) -> bool {
+    VALID
+        .iter()
+        .any(|(c, races)| *c == class && races.contains(&race))
+}
+
+/// `WOW_DUEL`'s value as a wish; `None` when it is off (`0`, `off`, `no`). Unknown words are
+/// ignored; a race and class that never go together keep the class.
+pub(crate) fn parse(value: &str) -> Option<Wish> {
+    let v = value.trim().to_ascii_lowercase();
+    if matches!(v.as_str(), "0" | "off" | "no" | "false") {
+        return None;
+    }
+    let mut wish = Wish::default();
+    for word in v
+        .split(|c: char| c == '-' || c == '_' || c == '+' || c == ',' || c == ' ' || c == '.')
+        .filter(|w| !w.is_empty())
+    {
+        if let Some(r) = race_word(word) {
+            wish.race = Some(r);
+        } else if let Some(c) = class_word(word) {
+            wish.class = Some(c);
+        } else if matches!(word, "f" | "female" | "woman") {
+            wish.female = true;
+        }
+    }
+    if let (Some(r), Some(c)) = (wish.race, wish.class) {
+        if !valid(r, c) {
+            wish.race = None;
+        }
+    }
+    Some(wish)
+}
+
+/// The character the wish lands on: of the wished race and class, the highest level; with no
+/// race or class asked for, the row already selected (the one last played).
+pub(crate) fn choose(chars: &[Character], wish: &Wish, selected: Option<usize>) -> Option<u64> {
+    if wish.race.is_none() && wish.class.is_none() {
+        return selected.and_then(|i| chars.get(i)).or(chars.first()).map(|c| c.guid);
+    }
+    chars
+        .iter()
+        .filter(|c| wish.race.is_none_or(|r| r == c.race) && wish.class.is_none_or(|k| k == c.class))
+        .max_by_key(|c| c.level)
+        .map(|c| c.guid)
+}
+
+/// A race and class for the wish, filling what it leaves open from `roll` (any number).
+pub(crate) fn body(wish: &Wish, roll: u32) -> (u8, u8) {
+    match (wish.race, wish.class) {
+        (Some(r), Some(c)) => (r, c),
+        (None, Some(c)) => {
+            let races = VALID.iter().find(|(k, _)| *k == c).map(|(_, r)| *r).unwrap_or(&[1]);
+            (races[roll as usize % races.len()], c)
+        }
+        (Some(r), None) => {
+            let classes: Vec<u8> = VALID.iter().filter(|(_, rs)| rs.contains(&r)).map(|(c, _)| *c).collect();
+            (r, classes[roll as usize % classes.len()])
+        }
+        (None, None) => {
+            let all: Vec<(u8, u8)> = VALID
+                .iter()
+                .flat_map(|(c, rs)| rs.iter().map(move |r| (*r, *c)))
+                .collect();
+            all[roll as usize % all.len()]
+        }
+    }
+}
+
+const START: [&str; 24] = [
+    "Ka", "Mor", "Thal", "Bri", "Dro", "Vel", "Gar", "Lo", "Zan", "Ker", "Fen", "Ash", "Tor",
+    "Ul", "Ry", "Sha", "Gru", "El", "Va", "Ost", "Bel", "Dur", "Nim", "Qua",
+];
+const MIDDLE: [&str; 12] = ["", "", "", "a", "e", "i", "o", "ar", "en", "il", "or", "u"];
+const END: [&str; 20] = [
+    "dan", "gor", "wyn", "rak", "mir", "thas", "dor", "kin", "zul", "ros", "lia", "nar", "vek",
+    "tis", "bek", "ga", "mos", "rin", "lok", "sha",
+];
+
+/// A name the server takes: letters only, at most 12, a capital and then lower case.
+pub(crate) fn name(roll: u32) -> String {
+    let a = START[roll as usize % START.len()];
+    let b = MIDDLE[(roll / 31) as usize % MIDDLE.len()];
+    let c = END[(roll / 401) as usize % END.len()];
+    let mut n = format!("{a}{b}{c}");
+    n.truncate(12);
+    let mut chars = n.chars();
+    match chars.next() {
+        Some(f) => f.to_ascii_uppercase().to_string() + &chars.as_str().to_ascii_lowercase(),
+        None => "Duelist".into(),
+    }
+}
+
+/// The create request for a wish; the appearance stays the default one.
+pub(crate) fn create_req(wish: &Wish, roll: u32) -> CharCreateReq {
+    let (race, class) = body(wish, roll);
+    CharCreateReq {
+        name: name(roll.rotate_left(11) ^ 0x9e37_79b9),
+        race,
+        class,
+        gender: u8::from(wish.female),
+        skin: 0,
+        face: 0,
+        hair_style: 0,
+        hair_color: 0,
+        facial_hair: 0,
+    }
+}
+
+/// Read once, when the roster policy first runs.
+pub(crate) fn wish_from_env() -> Option<Wish> {
+    let v = crate::webenv::var("WOW_DUEL")?;
+    let w = parse(&v);
+    if let Some(w) = &w {
+        info!("char select: duel mode ({v:?}) — straight into the world: {w:?}");
+    }
+    w
+}
+
+/// Answer a roster in duel mode: enter the body, or ask for one. `true` when it answered.
+pub(crate) fn answer(roster: &mut Roster, pick: &CharPick) -> bool {
+    let Some(wish) = roster.duel.wish.clone() else {
+        return false;
+    };
+    // A create in flight: its own roster (which comes before the result) carries the new body.
+    if let Some(made) = roster.duel.creating.clone() {
+        if let Some(c) = roster.chars.iter().find(|c| c.name.eq_ignore_ascii_case(&made)) {
+            let guid = c.guid;
+            info!("char select: duel body {made} made — entering");
+            roster.duel = DuelPath::default();
+            send_pick(roster, pick, guid);
+            return true;
+        }
+        return false;
+    }
+    if let Some(guid) = pick_guid(roster, &wish) {
+        roster.duel = DuelPath::default();
+        info!("char select: duel mode — entering the duel body");
+        send_pick(roster, pick, guid);
+        return true;
+    }
+    create(roster, pick, &wish);
+    true
+}
+
+fn pick_guid(roster: &Roster, wish: &Wish) -> Option<u64> {
+    choose(&roster.chars, wish, roster.selected)
+}
+
+fn create(roster: &mut Roster, pick: &CharPick, wish: &Wish) {
+    let roll = rand::random::<u32>();
+    let req = create_req(wish, roll);
+    info!(
+        "char select: duel mode — no body for {wish:?} on this account, making {} (race {}, class {})",
+        req.name, req.race, req.class
+    );
+    roster.duel.creating = Some(req.name.clone());
+    roster.duel.tries += 1;
+    let _ = pick.0.try_send(CharRequest::Create(req));
+}
+
+/// A refused duel-body create: another name (taken, reserved), or the roster as it is (account
+/// full, or too many tries) on the remembered character.
+pub(crate) fn create_result(
+    mut msgs: MessageReader<CharActionResultMessage>,
+    mut roster: ResMut<Roster>,
+    pick: Res<CharPick>,
+) {
+    for msg in msgs.read() {
+        if msg.action != CharAction::Create || roster.duel.creating.is_none() {
+            continue;
+        }
+        if msg.code == benilla_protocol::messages::CHAR_CREATE_SUCCESS {
+            continue; // the fresh roster before it already picked, or the next one will
+        }
+        let Some(wish) = roster.duel.wish.clone() else { continue };
+        roster.duel.creating = None;
+        let full = msg.code == benilla_protocol::messages::CHAR_CREATE_SERVER_LIMIT;
+        if full || roster.duel.tries >= MAX_TRIES {
+            warn!(
+                "char select: duel body refused (code {:#04x}) — entering the remembered character",
+                msg.code
+            );
+            let any = Wish::default();
+            roster.duel = DuelPath::default();
+            if let Some(guid) = choose(&roster.chars, &any, roster.selected) {
+                send_pick(&mut roster, &pick, guid);
+            }
+            continue;
+        }
+        warn!("char select: duel body refused (code {:#04x}) — another name", msg.code);
+        create(&mut roster, &pick, &wish);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn wishes_parse_in_any_order() {
+        assert_eq!(parse("1"), Some(Wish::default()));
+        assert_eq!(parse("off"), None);
+        assert_eq!(
+            parse("orc-warrior"),
+            Some(Wish { race: Some(2), class: Some(1), female: false })
+        );
+        assert_eq!(
+            parse("Mage gnome F"),
+            Some(Wish { race: Some(7), class: Some(8), female: true })
+        );
+        // a pair that never exists keeps the class
+        assert_eq!(parse("tauren+mage"), Some(Wish { race: None, class: Some(8), female: false }));
+    }
+
+    #[test]
+    fn every_body_is_a_real_pair() {
+        for roll in 0..2000u32 {
+            for w in [Wish::default(), parse("druid").unwrap(), parse("troll").unwrap(), parse("human paladin").unwrap()] {
+                let (r, c) = body(&w, roll);
+                assert!(valid(r, c), "{r}/{c} from {w:?}");
+                if let Some(k) = w.class {
+                    assert_eq!(c, k);
+                }
+                if let Some(k) = w.race {
+                    assert_eq!(r, k);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn names_are_letters_up_to_twelve() {
+        for roll in (0..200_000u32).step_by(97) {
+            let n = name(roll);
+            assert!((2..=12).contains(&n.len()), "{n}");
+            assert!(n.chars().all(|c| c.is_ascii_alphabetic()), "{n}");
+            assert!(n.chars().next().unwrap().is_ascii_uppercase(), "{n}");
+            assert!(n.chars().skip(1).all(|c| c.is_ascii_lowercase()), "{n}");
+        }
+    }
+}
