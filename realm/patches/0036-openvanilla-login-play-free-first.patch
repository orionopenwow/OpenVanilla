--- a/crates/wenilla-realm/src/auth/oauth.rs
+++ b/crates/wenilla-realm/src/auth/oauth.rs
@@ -605,6 +605,7 @@ pub async fn login_view(
         realm_name: state.realm_name().await,
         password_open: password || providers.is_empty(),
         providers,
+        discord_joins: discord_url.as_deref().is_some_and(|u| u.contains("guilds.join")),
         discord_url,
