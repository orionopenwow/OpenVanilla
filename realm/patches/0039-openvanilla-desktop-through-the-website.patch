+/// Open Vanilla: a launcher token (`Authorization: Bearer ...`, made by /api/launcher/token) as a
+/// session for the game relay only. Rate-limited per address; a disabled account or a signed-out
+/// token gets nothing.
+async fn launcher_session(state: &AppState, headers: &axum::http::HeaderMap) -> Option<Session> {
+    let tok = headers
+        .get(header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.strip_prefix("Bearer "))
+        .map(str::trim)
+        .filter(|t| !t.is_empty())?;
+    let ip = client_ip(headers).unwrap_or_default();
+    if !state.limiter.allow(&format!("launcher:ws:{ip}"), 240, 900) {
+        return None;
+    }
+    #[derive(sqlx::FromRow)]
+    struct Row {
+        id: i64,
+        username: String,
+        display_name: String,
+        role: String,
+        guest: i64,
+        must_change: i64,
+    }
+    let row: Option<Row> = sqlx::query_as(
+        "SELECT u.id, u.username, u.display_name, u.role, u.guest, COALESCE(c.must_change, 0) AS must_change \
+         FROM launcher_tokens t JOIN users u ON u.id = t.user_id \
+         LEFT JOIN local_credentials c ON c.user_id = u.id \
+         WHERE t.token_hash = ? AND u.disabled = 0",
+    )
+    .bind(hash(tok))
+    .fetch_optional(&state.db)
+    .await
+    .unwrap_or_else(|e| {
+        tracing::error!(error = %e, "launcher token lookup");
+        None
+    });
+    let row = row?;
+    let _ = sqlx::query("UPDATE launcher_tokens SET last_seen = ? WHERE token_hash = ?")
+        .bind(now())
+        .bind(hash(tok))
+        .execute(&state.db)
+        .await;
+    Some(Session {
+        id: 0, // not a browser session: no cookie to rotate, no forms (only /ws/* comes here)
+        user: User {
+            id: row.id,
+            username: row.username,
+            display_name: row.display_name,
+            role: row.role,
+            disabled: 0,
+            guest: row.guest != 0,
+        },
+        csrf_token: String::new(),
+        fresh_token: None,
+        must_change_password: row.must_change != 0,
+    })
+}
