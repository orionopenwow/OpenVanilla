+    // ---- Open Vanilla: the ground guard ----
+
+    /// A flat floor from x = -20 to x = 0 at y = 0 and nothing past it, with the guard registered.
+    fn guard_app(ready: bool) -> App {
+        use avian3d::prelude::*;
+        let mut app = App::new();
+        app.init_resource::<benilla_world::collision::MoverTraceExclusions>();
+        app.add_plugins((
+            MinimalPlugins,
+            bevy::transform::TransformPlugin,
+            bevy::asset::AssetPlugin::default(),
+            bevy::scene::ScenePlugin,
+            PhysicsPlugins::new(bevy::app::PostUpdate),
+        ));
+        app.init_asset::<Mesh>();
+        let verts = vec![
+            Vec3::new(-20.0, 0.0, -20.0),
+            Vec3::new(0.0, 0.0, -20.0),
+            Vec3::new(0.0, 0.0, 20.0),
+            Vec3::new(-20.0, 0.0, 20.0),
+        ];
+        app.world_mut().spawn((
+            RigidBody::Static,
+            Collider::trimesh(verts, vec![[0, 2, 1], [0, 3, 2]]),
+            Transform::default(),
+        ));
+        let capsule = Collider::capsule(
+            super::super::CAPSULE_RADIUS,
+            super::super::CAPSULE_HEIGHT - 2.0 * super::super::CAPSULE_RADIUS,
+        );
+        app.insert_resource(super::super::PlayerCapsule(capsule));
+        let player = Player {
+            active: true,
+            settling: false,
+            ..Player::default()
+        };
+        let wow = benilla_assets::coords::bevy_to_wow(Vec3::new(-3.0, 0.0, 0.0));
+        let (tx, ty) = benilla_formats::world_to_tile(wow[0], wow[1]);
+        app.insert_resource(WorldLoadProgress {
+            focus_tile: Some((tx as i32, ty as i32)),
+            focus_resident: ready,
+            colliders_pending: if ready { 0 } else { 40 },
+            total: 9,
+            ..WorldLoadProgress::default()
+        })
+        .insert_resource(player);
+        app.update(); // builds the spatial-query trees
+        app
+    }
+
+    /// One run of the guard over the built trees. A second full frame would run avian's own
+    /// diagnostics-timed systems, whose resources only its diagnostics plugin inserts.
+    fn guard(app: &mut App) {
+        use bevy::ecs::system::RunSystemOnce;
+        app.world_mut()
+            .run_system_once(guard_unloaded_ground)
+            .expect("the guard runs");
+    }
+
+    fn place(app: &mut App, x: f32, vx: f32) {
+        let mut p = app.world_mut().resource_mut::<Player>();
+        p.pos = Vec3::new(x, 0.0, 0.0);
+        p.horiz_vel = Vec3::new(vx, 0.0, 0.0);
+        p.settling = false;
+        p.ground_hold = false;
+    }
+
+    #[test]
+    fn the_guard_holds_a_walk_off_the_edge_of_ground_still_streaming_in() {
+        let mut app = guard_app(false);
+        place(&mut app, -0.5, 7.0); // running at the edge: 1.4 yd of lookahead is past it
+        guard(&mut app);
+        let p = app.world().resource::<Player>();
+        assert!(p.settling && p.ground_hold, "a step into unloaded ground must hold, not fall");
+        assert_eq!(p.horiz_vel, Vec3::ZERO);
+    }
+
+    #[test]
+    fn the_guard_leaves_a_walk_over_solid_ground_alone_while_streaming() {
+        let mut app = guard_app(false);
+        place(&mut app, -10.0, 7.0); // floor under and ahead
+        guard(&mut app);
+        assert!(!app.world().resource::<Player>().settling);
+    }
+
+    #[test]
+    fn the_guard_leaves_real_ledges_alone_once_the_ground_is_in() {
+        let mut app = guard_app(true);
+        place(&mut app, -0.5, 7.0);
+        guard(&mut app);
+        assert!(
+            !app.world().resource::<Player>().settling,
+            "over loaded ground a ledge is a ledge: the body may fall"
+        );
+    }
+
+    #[test]
+    fn a_ground_hold_releases_on_its_own_tile_without_the_whole_scene() {
+        let mut app = app();
+        {
+            let mut p = app.world_mut().resource_mut::<Player>();
+            p.ground_hold = true;
+            p.world_stale = false;
+        }
+        // The tile under the body is in with its colliders; the 8 neighbours are not (no scene).
+        step(&mut app, 0.1, |p| {
+            p.focus_resident = true;
+            p.colliders_pending = 0;
+            p.scene_ready = false;
+            p.total = 9;
+        });
+        let p = app.world().resource::<Player>();
+        assert!(!p.settling && !p.ground_hold, "the guard's hold needs only the ground under the body");
+    }
+
+    #[test]
+    fn a_snap_hold_still_waits_for_the_scene() {
+        let mut app = app();
+        app.world_mut().resource_mut::<Player>().world_stale = false;
+        step(&mut app, 0.1, |p| {
+            p.focus_resident = true;
+            p.colliders_pending = 0;
+            p.scene_ready = false;
+            p.total = 9;
+        });
+        assert!(settling(&mut app), "a login or teleport hold still waits for the presentable scene");
+    }
+
 }
