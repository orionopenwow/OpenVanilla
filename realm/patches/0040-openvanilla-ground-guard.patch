+/// Open Vanilla: the tile under the body is resident with every collider attached: ground a walking
+/// body can stand on. `colliders_pending` and `merge_pending` count the whole stream, not one tile,
+/// so this errs on the side of holding.
+fn ground_ready(p: &WorldLoadProgress, focus_matches: bool) -> bool {
+    p.focus_resident && focus_matches && p.colliders_pending == 0 && p.merge_pending == 0
+}
+
+/// Open Vanilla: how far below the body the guard looks for a floor (yd). A walking step never
+/// drops more than this without the mover electing a fall.
+const GROUND_GUARD_REACH: f32 = 4.0;
+/// Open Vanilla: how far ahead of a walking body the guard also looks (seconds of its velocity), so
+/// the hold lands before the step that would leave the edge.
+const GROUND_GUARD_LOOKAHEAD: f32 = 0.2;
+
+/// Open Vanilla: never let a walking body step off into ground that has not streamed in.
+///
+/// The settle hold covers logins and teleports, but a walk can reach a tile whose terrain or
+/// colliders are still arriving (a tile border on a slow load, a weak machine). There the mover
+/// finds no floor, elects a fall, and the body drops through the world ("made an orc, walked five
+/// steps, fell through the world"). The reference client never shows unloaded ground; this one
+/// streams it, so the guard stands in: when the ground under the body is not fully in and there is
+/// no floor below the body or a step ahead of it, the body is held (gravity off) until its tile's
+/// colliders arrive. Real ledges over loaded ground are untouched: the guard only acts while the
+/// stream is behind.
+pub(super) fn guard_unloaded_ground(
+    mut player: ResMut<Player>,
+    progress: Option<Res<WorldLoadProgress>>,
+    collide: benilla_world::collision::WorldCollision,
+    capsule: Res<super::PlayerCapsule>,
+    time: Res<Time>,
+) {
+    let Some(p) = progress else { return };
+    if player.settling
+        || !player.active
+        || player.detached
+        || player.server_riding()
+        || player.ride.is_some()
+        || player.swimming
+        || player.airborne_prev
+    {
+        return;
+    }
+    let focus_matches = p.focus_tile.is_some_and(|t| {
+        let wow = benilla_assets::coords::bevy_to_wow(player.pos);
+        let (tx, ty) = benilla_formats::world_to_tile(wow[0], wow[1]);
+        t == (tx as i32, ty as i32)
+    });
+    if ground_ready(&p, focus_matches) {
+        return;
+    }
+    let half_h = Vec3::Y * (super::CAPSULE_HEIGHT * 0.5);
+    let center = player.pos + half_h;
+    let ahead = player.horiz_vel * GROUND_GUARD_LOOKAHEAD;
+    let floor_at = |c: Vec3| {
+        collide
+            .cast_mover(&capsule.0, c, Vec3::NEG_Y * GROUND_GUARD_REACH, super::state::SKIN_WIDTH)
+            .is_some()
+    };
+    if floor_at(center) && floor_at(center + ahead) {
+        return;
+    }
+    let now = time.elapsed_secs();
+    player.settling = true;
+    player.ground_hold = true;
+    player.settle_since = now;
+    player.settle_deadline = now + SETTLE_TIMEOUT;
+    player.vel_y = 0.0;
+    player.horiz_vel = Vec3::ZERO;
+    info!(
+        "ground guard: held at ({:.1},{:.1},{:.1}): no floor under or ahead while the ground streams \
+         in (resident={}, on own tile={}, colliders pending={})",
+        player.pos.x, player.pos.y, player.pos.z, p.focus_resident, focus_matches, p.colliders_pending
+    );
+}
