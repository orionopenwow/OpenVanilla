new file mode 100644
index 00000000..f06cfd48
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/config.rs
@@ -0,0 +1,121 @@
+//! Environment for the player-network parts. Every switch defaults to off.
+
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+use anyhow::{Context, Result};
+
+#[derive(Clone, Debug)]
+pub struct P2pConfig {
+    pub state_dir: PathBuf,
+
+    // --- directory ---
+    pub directory_enabled: bool,
+    /// Keep claims (token hashes, host ids) across restarts in `<state>/directory-state.json`.
+    /// Staff decisions (verified / delisted) are always kept, in `<state>/directory-staff.json`.
+    pub directory_persist: bool,
+    /// Discord webhook that receives `POST /api/directory/report` (empty = log only).
+    pub report_webhook: Option<String>,
+    /// Optional file of words (one per line, case-insensitive) refused in names/descriptions.
+    pub wordlist: Option<PathBuf>,
+    /// The host relayed entries are listed under, e.g. `relay.openvanilla.app`.
+    pub relay_host: String,
+    /// Base URL of the relay's player side, e.g. `wss://relay.openvanilla.app`; the probe and the
+    /// launcher use `<relay_url>/h/<host_id>/ws/3724`.
+    pub relay_url: String,
+    pub probe_timeout: Duration,
+    /// Accept loopback / private addresses for host and probe — tests and LAN labs only.
+    pub allow_private: bool,
+    pub max_claims: usize,
+    /// Shared secret for the relay's `GET /api/directory/verify` (unset = endpoint off).
+    pub relay_verify_secret: Option<String>,
+
+    // --- identity ---
+    pub identity_enabled: bool,
+    pub identity_ttl_secs: i64,
+
+    // --- tracker ---
+    pub tracker_enabled: bool,
+    pub tracker_allowlist: PathBuf,
+    pub tracker_interval: i64,
+    pub tracker_max_peers: usize,
+}
+
+fn env(name: &str) -> Option<String> {
+    std::env::var(name).ok().filter(|v| !v.trim().is_empty())
+}
+
+fn flag(name: &str) -> bool {
+    matches!(
+        env(name).as_deref().map(str::trim),
+        Some("1" | "true" | "yes" | "on")
+    )
+}
+
+fn num<T: std::str::FromStr>(name: &str, default: T) -> Result<T> {
+    match env(name) {
+        None => Ok(default),
+        Some(v) => v
+            .trim()
+            .parse()
+            .ok()
+            .with_context(|| format!("{name}={v:?} is not a number")),
+    }
+}
+
+impl P2pConfig {
+    /// Everything off; paths under `state_dir`. Tests start here and flip what they need.
+    pub fn off(state_dir: &Path) -> Self {
+        Self {
+            state_dir: state_dir.to_path_buf(),
+            directory_enabled: false,
+            directory_persist: false,
+            report_webhook: None,
+            wordlist: None,
+            relay_host: "relay.openvanilla.app".into(),
+            relay_url: "wss://relay.openvanilla.app".into(),
+            probe_timeout: Duration::from_secs(5),
+            allow_private: false,
+            max_claims: 2000,
+            relay_verify_secret: None,
+            identity_enabled: false,
+            identity_ttl_secs: 300,
+            tracker_enabled: false,
+            tracker_allowlist: state_dir.join("torrents.allow"),
+            tracker_interval: 1800,
+            tracker_max_peers: 50,
+        }
+    }
+
+    pub fn from_env(state_dir: &Path) -> Result<Self> {
+        let mut c = Self::off(state_dir);
+        c.directory_enabled = flag("DIRECTORY_ENABLED");
+        c.directory_persist = flag("DIRECTORY_PERSIST");
+        c.report_webhook = env("DIRECTORY_REPORT_WEBHOOK");
+        if let Some(w) = &c.report_webhook {
+            let u = url::Url::parse(w).context("DIRECTORY_REPORT_WEBHOOK is not a URL")?;
+            anyhow::ensure!(u.scheme() == "https", "DIRECTORY_REPORT_WEBHOOK must be https");
+        }
+        c.wordlist = env("DIRECTORY_WORDLIST").map(PathBuf::from);
+        if let Some(h) = env("RELAY_HOST") {
+            c.relay_host = h;
+        }
+        if let Some(u) = env("RELAY_PLAYER_URL") {
+            url::Url::parse(&u).context("RELAY_PLAYER_URL is not a URL")?;
+            c.relay_url = u.trim_end_matches('/').to_string();
+        }
+        c.probe_timeout = Duration::from_secs(num("DIRECTORY_PROBE_TIMEOUT_SECS", 5u64)?);
+        c.allow_private = flag("DIRECTORY_ALLOW_PRIVATE");
+        c.max_claims = num("DIRECTORY_MAX_CLAIMS", 2000usize)?;
+        c.relay_verify_secret = env("RELAY_VERIFY_SECRET").map(|s| s.trim().to_string());
+        c.identity_enabled = flag("IDENTITY_ENABLED");
+        c.identity_ttl_secs = num("IDENTITY_TOKEN_TTL_SECS", 300i64)?.clamp(30, 3600);
+        c.tracker_enabled = flag("TRACKER_ENABLED");
+        if let Some(p) = env("TRACKER_ALLOWLIST") {
+            c.tracker_allowlist = p.into();
+        }
+        c.tracker_interval = num("TRACKER_INTERVAL", 1800i64)?.max(60);
+        c.tracker_max_peers = num("TRACKER_MAX_PEERS", 50usize)?.clamp(1, 200);
+        Ok(c)
+    }
+}
