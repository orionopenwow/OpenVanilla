+impl Directory {
+    pub fn relay_verify_enabled(&self) -> bool {
+        self.cfg.relay_verify_secret.as_deref().is_some_and(|s| !s.is_empty())
+    }
+
+    /// Does `token_sha` (hex SHA-256 of the claim token) match a live, non-delisted claim for
+    /// `host_id`? Returns its visibility.
+    pub fn verify_claim(&self, host_id: &str, token_sha: &str) -> Option<&'static str> {
+        use subtle::ConstantTimeEq;
+        if !super::valid_host_id(host_id)
+            || token_sha.len() != 64
+            || !token_sha.bytes().all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+        {
+            return None;
+        }
+        let e = self.known(host_id)?;
+        if now() - e.last_seen >= CLAIM_TTL || self.is_blocked(&e.host_id, &e.host) {
+            return None;
+        }
+        let ok: bool = e.token_hash.as_bytes().ct_eq(token_sha.as_bytes()).into();
+        ok.then_some(if e.public { "public" } else { "private" })
+    }
+}
+
+#[derive(Deserialize)]
+struct VerifyQuery {
+    #[serde(default)]
+    host_id: String,
+    #[serde(default)]
+    token_sha: String,
+}
+
+/// For the relay: authenticates host agents by their directory token's SHA-256.
+async fn relay_verify(
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    axum::extract::Query(q): axum::extract::Query<VerifyQuery>,
+) -> Response {
+    use subtle::ConstantTimeEq;
+    let d = dir(&state);
+    let secret = d.cfg.relay_verify_secret.as_deref().unwrap_or("");
+    let given = super::bearer(&headers).unwrap_or_default();
+    let good: bool = Sha256::digest(given.as_bytes())
+        .ct_eq(&Sha256::digest(secret.as_bytes()))
+        .into();
+    if secret.is_empty() || !good {
+        return json_err(StatusCode::UNAUTHORIZED, "bad relay secret");
+    }
+    let body = match d.verify_claim(&q.host_id, &q.token_sha.to_ascii_lowercase()) {
+        Some(vis) => serde_json::json!({ "ok": true, "visibility": vis }),
+        None => serde_json::json!({ "ok": false }),
+    };
+    let mut r = Json(body).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
