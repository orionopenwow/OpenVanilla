index 00000000..f05c452a
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/directory.rs
@@ -0,0 +1,987 @@
+//! The community-realm directory: hosts heartbeat in, launchers read the list.
+//!
+//! * First heartbeat → `201` with a claim token (only SHA-256 of it is kept) and a `host_id`
+//!   (16 lowercase base32). Later beats carry `Authorization: Bearer <token>`.
+//! * Nothing is listed until the reachability probe has seen a realmd answer at the entry
+//!   (directly, or through the relay for `relay: true`) within the last 30 minutes.
+//! * An entry leaves the list 180 s after its last heartbeat; the claim itself lasts 24 h.
+//! * Private entries get a `host_id` (for invite links) but are never listed.
+//! * `verified` and delisting are staff decisions (admin endpoints), kept on disk.
+//!
+//! Claims live in memory; `DIRECTORY_PERSIST=1` also keeps them in `<state>/directory-state.json`.
+
+use std::collections::{BTreeSet, HashMap};
+use std::net::IpAddr;
+use std::sync::{Arc, Mutex};
+
+use anyhow::Result;
+use axum::body::Bytes;
+use axum::extract::State;
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use super::config::P2pConfig;
+use super::probe;
+use crate::db::now;
+use crate::ratelimit::Limiter;
+use crate::session::{client_ip, Session};
+use crate::{AppError, AppState};
+
+pub const LIST_TTL: i64 = 180;
+pub const HEARTBEAT_EVERY: i64 = 60;
+pub const CLAIM_TTL: i64 = 24 * 3600;
+pub const MIN_BEAT_GAP: i64 = 20;
+/// A successful probe keeps an entry listable this long; it is re-probed well before.
+pub const PROBE_VALID: i64 = 30 * 60;
+pub const REPROBE_AFTER: i64 = 10 * 60;
+pub const RETRY_FAILED_AFTER: i64 = 30;
+pub const MAX_BODY: usize = 4096;
+
+/// What a host's agent sends.
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Heartbeat {
+    pub name: String,
+    #[serde(default)]
+    pub host: Option<String>,
+    #[serde(default)]
+    pub port: Option<u32>,
+    #[serde(rename = "type")]
+    pub kind: String,
+    pub population: i64,
+    pub version: String,
+    #[serde(default)]
+    pub portal: Option<String>,
+    #[serde(default)]
+    pub build: Option<u32>,
+    #[serde(default)]
+    pub description: Option<String>,
+    #[serde(default)]
+    pub tags: Vec<String>,
+    #[serde(default)]
+    pub visibility: Option<String>,
+    #[serde(default)]
+    pub relay: bool,
+    #[serde(default)]
+    pub template: Option<String>,
+    #[serde(default)]
+    pub region: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, Serialize, Deserialize)]
+pub struct ProbeState {
+    pub ok_at: Option<i64>,
+    pub tried_at: i64,
+    pub error: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Entry {
+    pub host_id: String,
+    pub token_hash: String,
+    pub name: String,
+    /// Empty for relay-only hosts.
+    pub host: String,
+    pub port: u16,
+    pub kind: String,
+    pub population: i64,
+    pub version: String,
+    pub portal: Option<String>,
+    pub build: u32,
+    pub description: String,
+    pub tags: Vec<String>,
+    pub public: bool,
+    pub relay: bool,
+    pub template: String,
+    pub region: String,
+    pub created_at: i64,
+    pub last_seen: i64,
+    #[serde(default)]
+    pub probe: ProbeState,
+}
+
+impl Entry {
+    fn listable(&self, t: i64) -> bool {
+        self.public && t - self.last_seen <= LIST_TTL && self.probe_ok(t)
+    }
+    fn probe_ok(&self, t: i64) -> bool {
+        self.probe.ok_at.is_some_and(|at| t - at <= PROBE_VALID)
+    }
+    fn addr_key(&self) -> Option<String> {
+        (!self.relay).then(|| format!("{}:{}", self.host, self.port))
+    }
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct Staff {
+    verified: BTreeSet<String>,
+    /// Delisted host ids and (lower-case) host names / addresses.
+    blocked: BTreeSet<String>,
+}
+
+#[derive(Default)]
+struct Inner {
+    entries: HashMap<String, Entry>,
+}
+
+impl Inner {
+    fn by_token(&self, hash: &str) -> Option<&str> {
+        self.entries
+            .values()
+            .find(|e| e.token_hash == hash)
+            .map(|e| e.host_id.as_str())
+    }
+    fn by_addr(&self, key: &str) -> Option<&Entry> {
+        self.entries
+            .values()
+            .find(|e| e.addr_key().as_deref() == Some(key))
+    }
+}
+
+pub struct Directory {
+    cfg: P2pConfig,
+    inner: Mutex<Inner>,
+    staff: Mutex<Staff>,
+    wordlist: Vec<String>,
+    limiter: Limiter,
+    http: reqwest::Client,
+}
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+fn sha256_hex(s: &str) -> String {
+    hex::encode(Sha256::digest(s.as_bytes()))
+}
+
+/// Normalised, validated heartbeat.
+#[derive(Debug, Clone)]
+pub struct Valid {
+    pub name: String,
+    pub host: String,
+    pub port: u16,
+    pub kind: String,
+    pub population: i64,
+    pub version: String,
+    pub portal: Option<String>,
+    pub build: u32,
+    pub description: String,
+    pub tags: Vec<String>,
+    pub public: bool,
+    pub relay: bool,
+    pub template: String,
+    pub region: String,
+}
+
+const RESERVED_TAGS: &[&str] = &[
+    "official", "community", "verified", "pve", "pvp", "rp", "rppve", "rppvp", "relay", "classic+",
+];
+
+fn type_tag(kind: &str) -> &'static str {
+    match kind {
+        "pve" => "PvE",
+        "pvp" => "PvP",
+        "rp" => "RPPvE",
+        _ => "RPPvP",
+    }
+}
+
+fn printable(s: &str) -> bool {
+    !s.chars().any(|c| c.is_control())
+}
+
+/// A public DNS name or IP literal; `allow_private` lifts the address rules (tests / LAN labs).
+pub fn valid_host(h: &str, allow_private: bool) -> Result<String, String> {
+    let h = h.trim().trim_end_matches('.').to_ascii_lowercase();
+    if h.is_empty() || h.len() > 253 {
+        return Err("host: 1–253 characters".into());
+    }
+    let ip_text = h.trim_start_matches('[').trim_end_matches(']');
+    if let Ok(ip) = ip_text.parse::<IpAddr>() {
+        if !allow_private && !probe::is_public_ip(ip) {
+            return Err("host: not a public address".into());
+        }
+        return Ok(ip_text.to_string());
+    }
+    let labels: Vec<&str> = h.split('.').collect();
+    let label_ok = |l: &&str| {
+        !l.is_empty()
+            && l.len() <= 63
+            && !l.starts_with('-')
+            && !l.ends_with('-')
+            && l.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-')
+    };
+    if !labels.iter().all(label_ok) {
+        return Err("host: not a DNS name".into());
+    }
+    if !allow_private {
+        if labels.len() < 2 || labels.last().unwrap().bytes().all(|c| c.is_ascii_digit()) {
+            return Err("host: not a public DNS name".into());
+        }
+        const LOCAL: &[&str] = &["localhost", "local", "lan", "home", "internal", "localdomain", "intranet", "corp", "arpa", "test", "invalid", "example"];
+        if LOCAL.contains(labels.last().unwrap()) || labels[0] == "localhost" {
+            return Err("host: not a public DNS name".into());
+        }
+    }
+    Ok(h)
+}
+
+impl Directory {
+    pub fn new(cfg: P2pConfig) -> Result<Self> {
+        let wordlist = match &cfg.wordlist {
+            Some(p) => std::fs::read_to_string(p)?
+                .lines()
+                .map(|l| l.trim().to_lowercase())
+                .filter(|l| !l.is_empty() && !l.starts_with('#'))
+                .collect(),
+            None => Vec::new(),
+        };
+        let staff = std::fs::read_to_string(cfg.state_dir.join("directory-staff.json"))
+            .ok()
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_default();
+        let mut inner = Inner::default();
+        if cfg.directory_persist {
+            if let Ok(s) = std::fs::read_to_string(cfg.state_dir.join("directory-state.json")) {
+                let list: Vec<Entry> = serde_json::from_str(&s).unwrap_or_default();
+                for e in list {
+                    inner.entries.insert(e.host_id.clone(), e);
+                }
+            }
+        }
+        Ok(Self {
+            cfg,
+            inner: Mutex::new(inner),
+            staff: Mutex::new(staff),
+            wordlist,
+            limiter: Limiter::default(),
+            http: reqwest::Client::builder()
+                .timeout(std::time::Duration::from_secs(10))
+                .build()?,
+        })
+    }
+
+    pub fn validate(&self, hb: Heartbeat) -> Result<Valid, String> {
+        let name = hb.name.trim().to_string();
+        let n = name.chars().count();
+        if !(3..=40).contains(&n) || !printable(&name) {
+            return Err("name: 3–40 printable characters".into());
+        }
+        let kind = hb.kind.to_ascii_lowercase();
+        if !["pve", "pvp", "rp", "rppvp"].contains(&kind.as_str()) {
+            return Err("type: pve | pvp | rp | rppvp".into());
+        }
+        if !(0..=5000).contains(&hb.population) {
+            return Err("population: 0–5000".into());
+        }
+        if hb.version.is_empty()
+            || hb.version.len() > 32
+            || !hb
+                .version
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || b".-+_".contains(&c))
+        {
+            return Err("version: 1–32 of A-Za-z0-9.-+_".into());
+        }
+        let port = match hb.port {
+            None if hb.relay => 3724,
+            None => return Err("port: required".into()),
+            Some(p) if (1..=65535).contains(&p) => p as u16,
+            Some(_) => return Err("port: 1–65535".into()),
+        };
+        let host = match (&hb.host, hb.relay) {
+            (Some(h), _) => valid_host(h, self.cfg.allow_private)?,
+            (None, true) => String::new(),
+            (None, false) => return Err("host: required (or relay: true)".into()),
+        };
+        let portal = match hb.portal.as_deref().map(str::trim).filter(|s| !s.is_empty()) {
+            None => None,
+            Some(p) => {
+                let u = url::Url::parse(p).map_err(|_| "portal: not a URL".to_string())?;
+                if u.scheme() != "https" || p.len() > 200 {
+                    return Err("portal: https only, ≤ 200 characters".into());
+                }
+                valid_host(u.host_str().unwrap_or(""), self.cfg.allow_private)
+                    .map_err(|e| format!("portal {e}"))?;
+                Some(u.to_string())
+            }
+        };
+        let build = hb.build.unwrap_or(5875);
+        if build != 5875 {
+            return Err("build: only 5875 (1.12.1) is supported".into());
+        }
+        let description = hb.description.unwrap_or_default().trim().to_string();
+        if description.chars().count() > 200 || !printable(&description) {
+            return Err("description: ≤ 200 printable characters".into());
+        }
+        if hb.tags.len() > 4 {
+            return Err("tags: at most four".into());
+        }
+        let mut tags = Vec::new();
+        for t in &hb.tags {
+            let t = t.trim();
+            let c = t.chars().count();
+            if !(1..=20).contains(&c) || !printable(t) {
+                return Err("tags: 1–20 printable characters each".into());
+            }
+            if RESERVED_TAGS.contains(&t.to_lowercase().as_str()) {
+                return Err(format!("tags: {t:?} is set by the directory"));
+            }
+            tags.push(t.to_string());
+        }
+        let public = match hb.visibility.as_deref().unwrap_or("public") {
+            "public" => true,
+            "private" => false,
+            _ => return Err("visibility: public | private".into()),
+        };
+        let template = hb.template.unwrap_or_else(|| "classicplus".into());
+        if !["classicplus", "vanilla"].contains(&template.as_str()) {
+            return Err("template: classicplus | vanilla".into());
+        }
+        let region = hb.region.unwrap_or_else(|| "us".into());
+        if region != "us" {
+            return Err("region: only \"us\" for now".into());
+        }
+        let lower = format!("{} {} {}", name, description, tags.join(" ")).to_lowercase();
+        if self.wordlist.iter().any(|w| lower.contains(w.as_str())) {
+            return Err("name, description or tags contain a word that is not allowed".into());
+        }
+        Ok(Valid {
+            name,
+            host,
+            port,
+            kind,
+            population: hb.population,
+            version: hb.version,
+            portal,
+            build,
+            description,
+            tags,
+            public,
+            relay: hb.relay,
+            template,
+            region,
+        })
+    }
+
+    fn is_blocked(&self, host_id: &str, host: &str) -> bool {
+        let s = lock(&self.staff);
+        s.blocked.contains(host_id) || (!host.is_empty() && s.blocked.contains(host))
+    }
+
+    fn save_staff(&self) -> Result<()> {
+        let body = serde_json::to_string_pretty(&*lock(&self.staff))?;
+        super::write_atomic(&self.cfg.state_dir.join("directory-staff.json"), &body)
+    }
+
+    /// Persist claims (only with `DIRECTORY_PERSIST=1`).
+    pub fn save(&self) -> Result<()> {
+        if !self.cfg.directory_persist {
+            return Ok(());
+        }
+        let list: Vec<Entry> = lock(&self.inner).entries.values().cloned().collect();
+        super::write_atomic(
+            &self.cfg.state_dir.join("directory-state.json"),
+            &serde_json::to_string(&list)?,
+        )
+    }
+
+    /// Forget claims 24 h after their last heartbeat.
+    pub fn sweep(&self) {
+        let t = now();
+        lock(&self.inner)
+            .entries
+            .retain(|_, e| t - e.last_seen < CLAIM_TTL);
+    }
+
+    /// Run the probe for `host_id` if it is due; updates the entry.
+    pub async fn probe_if_due(&self, host_id: &str) {
+        let t = now();
+        let target = {
+            let g = lock(&self.inner);
+            let Some(e) = g.entries.get(host_id) else { return };
+            let due = match e.probe.ok_at {
+                Some(at) => t - at >= REPROBE_AFTER,
+                None => t - e.probe.tried_at >= RETRY_FAILED_AFTER || e.probe.tried_at == 0,
+            };
+            if !due {
+                return;
+            }
+            (e.relay, e.host.clone(), e.port)
+        };
+        {
+            // Mark the attempt first so concurrent beats don't stack probes.
+            let mut g = lock(&self.inner);
+            if let Some(e) = g.entries.get_mut(host_id) {
+                e.probe.tried_at = t;
+            }
+        }
+        let res = if target.0 {
+            probe::probe_relay(&self.cfg.relay_url, host_id, self.cfg.probe_timeout).await
+        } else {
+            probe::probe_direct(&target.1, target.2, self.cfg.allow_private, self.cfg.probe_timeout)
+                .await
+        };
+        let mut g = lock(&self.inner);
+        if let Some(e) = g.entries.get_mut(host_id) {
+            match res {
+                Ok(()) => {
+                    e.probe.ok_at = Some(now());
+                    e.probe.error = None;
+                }
+                Err(err) => {
+                    tracing::info!(host_id, error = %format!("{err:#}"), "directory probe failed");
+                    e.probe.ok_at = None;
+                    e.probe.error = Some(format!("{err:#}"));
+                }
+            }
+        }
+    }
+
+    pub fn public_list(&self) -> serde_json::Value {
+        let t = now();
+        let staff = lock(&self.staff);
+        let g = lock(&self.inner);
+        let mut list: Vec<&Entry> = g
+            .entries
+            .values()
+            .filter(|e| e.listable(t))
+            .filter(|e| !staff.blocked.contains(&e.host_id) && !staff.blocked.contains(&e.host))
+            .collect();
+        list.sort_by(|a, b| {
+            let va = staff.verified.contains(&a.host_id);
+            let vb = staff.verified.contains(&b.host_id);
+            vb.cmp(&va)
+                .then(b.population.cmp(&a.population))
+                .then(a.name.cmp(&b.name))
+        });
+        let servers: Vec<serde_json::Value> = list
+            .into_iter()
+            .map(|e| self.public_json(e, staff.verified.contains(&e.host_id)))
+            .collect();
+        serde_json::json!({ "servers": servers, "updated": t })
+    }
+
+    fn public_json(&self, e: &Entry, verified: bool) -> serde_json::Value {
+        let mut tags = vec!["community".to_string(), type_tag(&e.kind).to_string()];
+        if e.template == "classicplus" {
+            tags.push("Classic+".into());
+        }
+        tags.extend(e.tags.iter().cloned());
+        let (host, port) = if e.relay {
+            (self.cfg.relay_host.clone(), 3724)
+        } else {
+            (e.host.clone(), e.port)
+        };
+        let mut v = serde_json::json!({
+            "name": e.name, "host": host, "port": port, "build": e.build, "tags": tags,
+            "description": e.description, "population": e.population, "last_seen": e.last_seen,
+            "host_id": e.host_id, "type": e.kind, "template": e.template, "region": e.region,
+            "verified": verified, "official": false, "relay": e.relay, "version": e.version,
+        });
+        if let Some(p) = &e.portal {
+            v["portal"] = p.clone().into();
+        }
+        if e.relay {
+            v["relay_url"] = format!("{}/h/{}", self.cfg.relay_url, e.host_id).into();
+        }
+        v
+    }
+
+    fn known(&self, host_id: &str) -> Option<Entry> {
+        lock(&self.inner).entries.get(host_id).cloned()
+    }
+}
