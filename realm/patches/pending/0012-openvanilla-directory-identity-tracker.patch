+//! The player-network services through the router: directory heartbeats probed against a fake
+//! realmd (directly and through a fake relay), staff delist/verify, reports to a webhook,
+//! identity tokens and the signed revocation list, and the restricted tracker.
+
+use std::sync::{Arc, Mutex};
+
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use base64::Engine;
+use http_body_util::BodyExt;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tower::ServiceExt;
+use wenilla_realm::p2p::{P2p, P2pConfig};
+use wenilla_realm::{db, mangos_conf, ratelimit, realmdb, secrets, soap, AppState, Config};
+
+struct NoBuilder;
+#[async_trait::async_trait]
+impl wenilla_realm::presets::Provisioner for NoBuilder {
+    async fn build(&self, _: wenilla_realm::presets::Job) -> anyhow::Result<wenilla_realm::presets::headless::Built> {
+        anyhow::bail!("unused")
+    }
+    async fn inspect(&self, _: &wenilla_realm::presets::Job) -> anyhow::Result<wenilla_realm::presets::headless::Inspection> {
+        anyhow::bail!("unused")
+    }
+}
+
+struct H {
+    app: axum::Router,
+    state: Arc<AppState>,
+    _dir: tempfile::TempDir,
+}
+
+async fn harness(edit: impl FnOnce(&mut P2pConfig)) -> H {
+    let dir = tempfile::tempdir().unwrap();
+    let state_dir = dir.path().join("state");
+    let www = dir.path().join("www");
+    std::fs::create_dir_all(&state_dir).unwrap();
+    std::fs::create_dir_all(&www).unwrap();
+    std::env::set_var("REALM_PUBLIC_URL", "http://localhost:8090");
+    let mut cfg = Config::from_env().unwrap();
+    cfg.state_dir = state_dir.clone();
+    cfg.www = www.clone();
+    cfg.config_dir = dir.path().join("config");
+    cfg.mariadb_url = "mysql://nobody:nothing@127.0.0.1:1/classicrealmd".into();
+    let sqlite = db::open_sqlite(&cfg.sqlite_path()).await.unwrap();
+    db::meta_set(&sqlite, "setup_complete", "1").await.unwrap();
+    let mut pc = P2pConfig::off(&state_dir);
+    edit(&mut pc);
+    let state = Arc::new(AppState {
+        p2p: P2p::from_config(&pc).unwrap(),
+        setup_cache: Default::default(),
+        realmdb: realmdb::connect(&cfg.mariadb_url).await.unwrap(),
+        soap: soap::Client::new("http://127.0.0.1:1/", "A", "A"),
+        conf: mangos_conf::ConfFiles::in_dir(&cfg.config_dir),
+        secrets: secrets::Keyring::load_or_create(&state_dir).unwrap(),
+        providers: Vec::new(),
+        limiter: ratelimit::Limiter::default(),
+        provisioner: Arc::new(NoBuilder),
+        client_data_error: Some("test".into()),
+        db: sqlite,
+        cfg: cfg.clone(),
+    });
+    H { app: wenilla_realm::app(Arc::clone(&state), None, &www), state, _dir: dir }
+}
+
+struct Resp {
+    status: StatusCode,
+    headers: axum::http::HeaderMap,
+    body: Vec<u8>,
+}
+impl Resp {
+    fn json(&self) -> serde_json::Value {
+        serde_json::from_slice(&self.body).unwrap_or_else(|_| panic!("not json: {}", String::from_utf8_lossy(&self.body)))
+    }
+}
+
+impl H {
+    async fn req(&self, method: &str, uri: &str, hdrs: &[(&str, &str)], body: Option<serde_json::Value>) -> Resp {
+        let mut b = Request::builder().method(method).uri(uri).header("x-forwarded-for", "203.0.113.9");
+        for (k, v) in hdrs {
+            b = b.header(*k, *v);
+        }
+        let body = match body {
+            Some(j) => {
+                b = b.header(header::CONTENT_TYPE, "application/json");
+                Body::from(j.to_string())
+            }
+            None => Body::empty(),
+        };
+        let r = self.app.clone().oneshot(b.body(body).unwrap()).await.unwrap();
+        let status = r.status();
+        let headers = r.headers().clone();
+        let body = r.into_body().collect().await.unwrap().to_bytes().to_vec();
+        Resp { status, headers, body }
+    }
+
+    /// A user with a web session; returns (cookie header, csrf token, user id).
+    async fn user(&self, name: &str, role: &str) -> (String, String, i64) {
+        let id: i64 = sqlx::query_scalar("INSERT INTO users (username, display_name, role, created_at) VALUES (?, ?, ?, 0) RETURNING id")
+            .bind(name).bind(name).bind(role)
+            .fetch_one(&self.state.db).await.unwrap();
+        let tok = wenilla_realm::session::create(&self.state.db, id, None, None).await.unwrap();
+        let csrf: String = sqlx::query_scalar("SELECT csrf_token FROM sessions WHERE user_id = ?")
+            .bind(id).fetch_one(&self.state.db).await.unwrap();
+        (format!("wr_session={tok}"), csrf, id)
+    }
+}
+
+/// A fake realmd: reads one AUTH_LOGON_CHALLENGE, records it, answers "unknown account".
+async fn fake_realmd(seen: Arc<Mutex<Vec<Vec<u8>>>>) -> u16 {
+    let l = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = l.local_addr().unwrap().port();
+    tokio::spawn(async move {
+        loop {
+            let (mut s, _) = l.accept().await.unwrap();
+            let seen = Arc::clone(&seen);
+            tokio::spawn(async move {
+                let mut head = [0u8; 4];
+                if s.read_exact(&mut head).await.is_err() {
+                    return;
+                }
+                let mut rest = vec![0u8; u16::from_le_bytes([head[2], head[3]]) as usize];
+                s.read_exact(&mut rest).await.unwrap();
+                seen.lock().unwrap().push([head.to_vec(), rest].concat());
+                s.write_all(&[0x00, 0x00, 0x04]).await.unwrap();
+            });
+        }
+    });
+    port
+}
+
+/// Something that is not a realmd: answers HTTP.
+async fn fake_http() -> u16 {
+    let l = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = l.local_addr().unwrap().port();
+    tokio::spawn(async move {
+        loop {
+            let (mut s, _) = l.accept().await.unwrap();
+            let _ = s.write_all(b"HTTP/1.1 400 Bad Request\r\n\r\n").await;
+        }
+    });
+    port
+}
+
+fn beat(name: &str, port: u16) -> serde_json::Value {
+    serde_json::json!({ "name": name, "host": "127.0.0.1", "port": port, "type": "pvp",
+        "population": 3, "version": "0.9.1", "tags": ["Chill"] })
+}
+
+#[tokio::test]
+async fn everything_is_off_by_default() {
+    let h = harness(|_| {}).await;
+    for (m, u) in [("GET", "/api/directory"), ("POST", "/api/directory/heartbeat"), ("GET", "/.well-known/openvanilla-keys.json"), ("POST", "/api/identity/token"), ("GET", "/announce")] {
+        let r = h.req(m, u, &[], None).await;
+        assert!(matches!(r.status, StatusCode::NOT_FOUND | StatusCode::UNAUTHORIZED), "{m} {u}: {}", r.status);
+    }
+}
+
+#[tokio::test]
+async fn directory_probe_list_report_and_staff() {
+    // A webhook stand-in for Discord.
+    let hook_seen: Arc<Mutex<Vec<serde_json::Value>>> = Arc::default();
+    let hs = Arc::clone(&hook_seen);
+    let hook = axum::Router::new().route("/hook", axum::routing::post(move |axum::Json(v): axum::Json<serde_json::Value>| {
+        let hs = Arc::clone(&hs);
+        async move { hs.lock().unwrap().push(v); StatusCode::NO_CONTENT }
+    }));
+    let hl = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let hook_url = format!("http://{}/hook", hl.local_addr().unwrap());
+    tokio::spawn(async move { axum::serve(hl, hook).await.unwrap() });
+
+    let h = harness(|c| {
+        c.directory_enabled = true;
+        c.allow_private = true;
+        c.report_webhook = Some(hook_url);
+        c.probe_timeout = std::time::Duration::from_secs(2);
+    }).await;
+    let seen: Arc<Mutex<Vec<Vec<u8>>>> = Arc::default();
+    let port = fake_realmd(Arc::clone(&seen)).await;
+
+    // First claim: 201, token, host id, probed and listed.
+    let r = h.req("POST", "/api/directory/heartbeat", &[], Some(beat("Night Harbor", port))).await;
+    assert_eq!(r.status, StatusCode::CREATED, "{}", String::from_utf8_lossy(&r.body));
+    let j = r.json();
+    let token = j["token"].as_str().unwrap().to_string();
+    let host_id = j["host_id"].as_str().unwrap().to_string();
+    assert_eq!(token.len(), 64);
+    assert!(wenilla_realm::p2p::valid_host_id(&host_id));
+    assert_eq!(j["listed"], true, "{j}");
+    assert_eq!(j["ttl"], 180);
+    // The probe sent a 1.12.1 build 5875 challenge for PROBE.
+    let pkt = seen.lock().unwrap()[0].clone();
+    assert_eq!(&pkt[4..8], b"WoW\0");
+    assert_eq!(u16::from_le_bytes([pkt[11], pkt[12]]), 5875);
+    assert!(pkt.ends_with(b"PROBE"));
+    // Only the hash of the token is kept.
+    let entries = h.req("GET", "/api/directory", &[], None).await;
+    assert_eq!(entries.headers["access-control-allow-origin"], "*");
+    assert!(entries.headers["cache-control"].to_str().unwrap().contains("max-age=15"));
+    let list = entries.json();
+    let s = &list["servers"][0];
+    assert_eq!(s["name"], "Night Harbor");
+    assert_eq!(s["host_id"], host_id.as_str());
+    assert_eq!(s["tags"], serde_json::json!(["community", "PvP", "Classic+", "Chill"]));
+    assert_eq!(s["verified"], false);
+    assert!(!String::from_utf8_lossy(&entries.body).contains(&token));
+
+    // Someone else cannot take the address; the owner is rate-limited per 20 s.
+    let r = h.req("POST", "/api/directory/heartbeat", &[], Some(beat("Squatter", port))).await;
+    assert_eq!(r.status, StatusCode::FORBIDDEN);
+    let auth = format!("Bearer {token}");
+    let r = h.req("POST", "/api/directory/heartbeat", &[("authorization", &auth)], Some(beat("Night Harbor", port))).await;
+    assert_eq!(r.status, StatusCode::TOO_MANY_REQUESTS);
+    let r = h.req("POST", "/api/directory/heartbeat", &[("authorization", "Bearer nope")], Some(beat("Night Harbor", port))).await;
+    assert_eq!(r.status, StatusCode::FORBIDDEN);
+    // Unknown fields and claimed badges are refused.
+    let mut bad = beat("Fake Official", port + 1);
+    bad["official"] = true.into();
+    assert_eq!(h.req("POST", "/api/directory/heartbeat", &[], Some(bad)).await.status, StatusCode::BAD_REQUEST);
+
+    // A port that does not speak realmd never lists; a private realm gets an id but no listing.
+    let dead = fake_http().await;
+    let r = h.req("POST", "/api/directory/heartbeat", &[], Some(beat("Not A Realm", dead))).await;
+    assert_eq!(r.status, StatusCode::CREATED);
+    assert_eq!(r.json()["listed"], false);
+    assert!(r.json()["probe"]["error"].as_str().unwrap().contains("realmd"));
+    let port2 = fake_realmd(Arc::default()).await;
+    let mut private = beat("Friends Only", port2);
+    private["visibility"] = "private".into();
+    let r = h.req("POST", "/api/directory/heartbeat", &[], Some(private)).await;
+    assert_eq!(r.status, StatusCode::CREATED);
+    let private_id = r.json()["host_id"].as_str().unwrap().to_string();
+    assert_eq!(r.json()["probe"]["ok"], true);
+    assert_eq!(r.json()["listed"], false);
+    assert_eq!(h.req("GET", "/api/directory", &[], None).await.json()["servers"].as_array().unwrap().len(), 1);
+
+    // Reports: sign-in required; forwarded to the webhook without pinging anyone.
+    let body = serde_json::json!({ "host_id": private_id, "reason": "offensive realm name @everyone" });
+    assert_eq!(h.req("POST", "/api/directory/report", &[], Some(body.clone())).await.status, StatusCode::UNAUTHORIZED);
+    let (cookie, _, _) = h.user("reporter", "player").await;
+    let r = h.req("POST", "/api/directory/report", &[("cookie", &cookie)], Some(body.clone())).await;
+    assert_eq!(r.status, StatusCode::ACCEPTED);
+    for _ in 0..50 {
+        if !hook_seen.lock().unwrap().is_empty() { break; }
+        tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+    }
+    let sent = hook_seen.lock().unwrap()[0].clone();
+    assert!(sent["content"].as_str().unwrap().contains(&private_id));
+    assert_eq!(sent["allowed_mentions"]["parse"], serde_json::json!([]));
+    for _ in 0..4 {
+        h.req("POST", "/api/directory/report", &[("cookie", &cookie)], Some(body.clone())).await;
+    }
+    assert_eq!(h.req("POST", "/api/directory/report", &[("cookie", &cookie)], Some(body)).await.status, StatusCode::TOO_MANY_REQUESTS);
+
+    // Staff: players are refused; admins verify and delist (with the CSRF header).
+    let (pc, pcsrf, _) = h.user("player2", "player").await;
+    let v = serde_json::json!({ "target": host_id });
+    assert_eq!(h.req("POST", "/admin/api/directory/verify", &[("cookie", &pc), ("x-csrf-token", &pcsrf)], Some(v.clone())).await.status, StatusCode::FORBIDDEN);
+    let (ac, acsrf, _) = h.user("staff", "admin").await;
+    assert_eq!(h.req("POST", "/admin/api/directory/verify", &[("cookie", &ac)], Some(v.clone())).await.status, StatusCode::FORBIDDEN, "csrf header required");
+    let r = h.req("POST", "/admin/api/directory/verify", &[("cookie", &ac), ("x-csrf-token", &acsrf)], Some(v.clone())).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", String::from_utf8_lossy(&r.body));
+    assert_eq!(h.req("GET", "/api/directory", &[], None).await.json()["servers"][0]["verified"], true);
+    let all = h.req("GET", "/admin/api/directory", &[("cookie", &ac)], None).await.json();
+    assert_eq!(all["entries"].as_array().unwrap().len(), 3);
+    let r = h.req("POST", "/admin/api/directory/delist", &[("cookie", &ac), ("x-csrf-token", &acsrf)], Some(v)).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(h.req("GET", "/api/directory", &[], None).await.json()["servers"].as_array().unwrap().is_empty());
+    // Staff decisions survive a restart.
+    let staff = std::fs::read_to_string(h.state.cfg.state_dir.join("directory-staff.json")).unwrap();
+    assert!(staff.contains(&host_id));
+}
