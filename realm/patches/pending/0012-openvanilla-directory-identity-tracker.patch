+#[tokio::test]
+async fn relay_verify_endpoint() {
+    // Off without the secret.
+    let h = harness(|c| c.directory_enabled = true).await;
+    assert_ne!(h.req("GET", "/api/directory/verify?host_id=x&token_sha=y", &[], None).await.status, StatusCode::OK);
+
+    let h = harness(|c| {
+        c.directory_enabled = true;
+        c.allow_private = true;
+        c.relay_verify_secret = Some("s3cret".into());
+    }).await;
+    let port = fake_realmd(Arc::default()).await;
+    let mut b = beat("Hidden Grove", port);
+    b["visibility"] = "private".into();
+    let j = h.req("POST", "/api/directory/heartbeat", &[], Some(b)).await.json();
+    let id = j["host_id"].as_str().unwrap().to_string();
+    let sha = hex::encode(<sha2::Sha256 as sha2::Digest>::digest(j["token"].as_str().unwrap().as_bytes()));
+    let url = |s: &str| format!("/api/directory/verify?host_id={id}&token_sha={s}");
+    assert_eq!(h.req("GET", &url(&sha), &[], None).await.status, StatusCode::UNAUTHORIZED);
+    assert_eq!(h.req("GET", &url(&sha), &[("authorization", "Bearer wrong")], None).await.status, StatusCode::UNAUTHORIZED);
+    let ok = h.req("GET", &url(&sha), &[("authorization", "Bearer s3cret")], None).await;
+    assert_eq!(ok.status, StatusCode::OK);
+    assert_eq!(ok.json(), serde_json::json!({ "ok": true, "visibility": "private" }));
+    let bad = h.req("GET", &url(&"0".repeat(64)), &[("authorization", "Bearer s3cret")], None).await.json();
+    assert_eq!(bad, serde_json::json!({ "ok": false }));
+    // Delisted → ok:false.
+    let (ac, acsrf, _) = h.user("staff", "admin").await;
+    h.req("POST", "/admin/api/directory/delist", &[("cookie", &ac), ("x-csrf-token", &acsrf)], Some(serde_json::json!({ "target": id }))).await;
+    assert_eq!(h.req("GET", &url(&sha), &[("authorization", "Bearer s3cret")], None).await.json(), serde_json::json!({ "ok": false }));
+}
