+#[tokio::test]
+async fn relayed_host_is_probed_through_the_relay() {
+    use axum::extract::ws::{Message, WebSocketUpgrade};
+    use axum::extract::Path;
+    let hits: Arc<Mutex<Vec<String>>> = Arc::default();
+    let hh = Arc::clone(&hits);
+    let relay = axum::Router::new().route("/h/{id}/ws/3724", axum::routing::get(move |Path(id): Path<String>, ws: WebSocketUpgrade| {
+        let hh = Arc::clone(&hh);
+        async move {
+            hh.lock().unwrap().push(id);
+            ws.on_upgrade(|mut s| async move {
+                if let Some(Ok(Message::Binary(b))) = s.recv().await {
+                    if b.ends_with(b"PROBE") {
+                        let _ = s.send(Message::Binary(vec![0u8, 0, 4].into())).await;
+                    }
+                }
+                let _ = s.recv().await;
+            })
+        }
+    }));
+    let l = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let relay_url = format!("ws://{}", l.local_addr().unwrap());
+    tokio::spawn(async move { axum::serve(l, relay).await.unwrap() });
+    let h = harness(|c| {
+        c.directory_enabled = true;
+        c.relay_url = relay_url.clone();
+        c.probe_timeout = std::time::Duration::from_secs(2);
+    }).await;
+    let body = serde_json::json!({ "name": "Behind CGNAT", "relay": true, "type": "rp", "population": 0, "version": "1.0", "template": "vanilla" });
+    let r = h.req("POST", "/api/directory/heartbeat", &[], Some(body)).await;
+    assert_eq!(r.status, StatusCode::CREATED, "{}", String::from_utf8_lossy(&r.body));
+    let id = r.json()["host_id"].as_str().unwrap().to_string();
+    assert_eq!(r.json()["listed"], true, "{}", r.json());
+    assert_eq!(hits.lock().unwrap().as_slice(), [id.clone()]);
+    let s = h.req("GET", "/api/directory", &[], None).await.json()["servers"][0].clone();
+    assert_eq!(s["host"], "relay.openvanilla.app");
+    assert_eq!(s["relay"], true);
+    assert_eq!(s["relay_url"], format!("{relay_url}/h/{id}"));
+    assert_eq!(s["tags"], serde_json::json!(["community", "RPPvE"]));
+}
