+#[tokio::test]
+async fn identity_tokens_keys_and_revocation() {
+    let h = harness(|c| c.identity_enabled = true).await;
+    let aud = "abcdefghijklmn23";
+    assert_eq!(h.req("POST", "/api/identity/token", &[], Some(serde_json::json!({ "aud": aud }))).await.status, StatusCode::UNAUTHORIZED);
+    let (cookie, _, uid) = h.user("alice", "player").await;
+    assert_eq!(h.req("POST", "/api/identity/token", &[("cookie", &cookie)], Some(serde_json::json!({ "aud": "NOT-A-HOST" }))).await.status, StatusCode::BAD_REQUEST);
+    let r = h.req("POST", "/api/identity/token", &[("cookie", &cookie)], Some(serde_json::json!({ "aud": aud }))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", String::from_utf8_lossy(&r.body));
+    let j = r.json();
+    let tok = j["token"].as_str().unwrap();
+    assert!(tok.starts_with("v4.public."));
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs() as i64;
+    assert!((now + 295..=now + 305).contains(&j["exp"].as_i64().unwrap()));
+
+    // Verify the way a host does: keys document → kid from the footer → Ed25519 over PAE.
+    let keys = h.req("GET", "/.well-known/openvanilla-keys.json", &[], None).await;
+    assert_eq!(keys.headers["access-control-allow-origin"], "*");
+    let keys = keys.json();
+    let footer: serde_json::Value = serde_json::from_slice(&base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(tok.rsplit('.').next().unwrap()).unwrap()).unwrap();
+    let key = keys["keys"].as_array().unwrap().iter().find(|k| k["kid"] == footer["kid"]).unwrap();
+    assert_eq!(key["alg"], "Ed25519");
+    let x: [u8; 32] = base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(key["x"].as_str().unwrap()).unwrap().try_into().unwrap();
+    let vk = ed25519_dalek::VerifyingKey::from_bytes(&x).unwrap();
+    let (m, _) = wenilla_realm::p2p::identity::verify_v4_public(&vk, tok).unwrap();
+    let claims: serde_json::Value = serde_json::from_slice(&m).unwrap();
+    assert_eq!(claims["sub"], uid.to_string());
+    assert_eq!(claims["aud"], aud);
+    assert_eq!(claims["name"], "alice");
+    assert_eq!(claims["roles"], serde_json::json!(["player"]));
+    assert_eq!(claims["jti"].as_str().unwrap().len(), 32);
+    assert!(claims["exp"].as_str().unwrap().ends_with('Z'));
+    // The key file sits in the state dir, owner-only.
+    let kid = footer["kid"].as_str().unwrap();
+    let kp = h.state.cfg.state_dir.join("identity").join(format!("{kid}.key"));
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(std::fs::metadata(&kp).unwrap().permissions().mode() & 0o777, 0o600);
+    }
+
+    // The launcher's bearer token works too.
+    let lt = "launcher-token-for-alice";
+    sqlx::query("INSERT INTO launcher_tokens (token_hash, user_id, created_at, last_seen) VALUES (?, ?, 0, 0)")
+        .bind(<sha2::Sha256 as sha2::Digest>::digest(lt.as_bytes()).to_vec())
+        .bind(uid).execute(&h.state.db).await.unwrap();
+    let bearer = format!("Bearer {lt}");
+    assert_eq!(h.req("POST", "/api/identity/token", &[("authorization", &bearer)], Some(serde_json::json!({ "aud": aud }))).await.status, StatusCode::OK);
+
+    // Staff revoke alice; the signed list names her and she gets no more tokens.
+    let (ac, acsrf, _) = h.user("staff", "admin").await;
+    let r = h.req("POST", "/admin/api/identity/revoke", &[("cookie", &ac), ("x-csrf-token", &acsrf)], Some(serde_json::json!({ "sub": uid }))).await;
+    assert_eq!(r.status, StatusCode::OK, "{}", String::from_utf8_lossy(&r.body));
+    assert_eq!(h.req("POST", "/api/identity/token", &[("cookie", &cookie)], Some(serde_json::json!({ "aud": aud }))).await.status, StatusCode::FORBIDDEN);
+    let rv = h.req("GET", "/api/identity/revoked", &[], None).await;
+    assert_eq!(rv.status, StatusCode::OK);
+    assert_eq!(rv.headers["x-openvanilla-kid"].to_str().unwrap(), kid);
+    let sig = base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(rv.headers["x-openvanilla-signature"].to_str().unwrap()).unwrap();
+    use ed25519_dalek::Verifier;
+    vk.verify(&rv.body, &ed25519_dalek::Signature::from_slice(&sig).unwrap()).unwrap();
+    assert_eq!(rv.json()["sub"], serde_json::json!([uid.to_string()]));
+
+    // Rotation: a new active kid, the old key still published.
+    let r = h.req("POST", "/admin/api/identity/rotate", &[("cookie", &ac), ("x-csrf-token", &acsrf)], None).await;
+    assert_eq!(r.status, StatusCode::OK);
+    let keys = h.req("GET", "/.well-known/openvanilla-keys.json", &[], None).await.json();
+    assert_eq!(keys["keys"].as_array().unwrap().len(), 2);
+    assert_eq!(keys["keys"][0]["kid"], r.json()["kid"]);
+}
