new file mode 100644
index 00000000..c7801e74
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/identity.rs
@@ -0,0 +1,469 @@
+//! One Open Vanilla identity on every community host: audience-bound PASETO v4.public tokens
+//! (Ed25519), the public keys at `/.well-known/openvanilla-keys.json`, and a signed revocation list.
+//!
+//! Keys live in `<state>/identity/`: `<kid>.key` (hex Ed25519 seed, 0600) for every published
+//! key, `active` naming the one that signs. Rotation (`POST /admin/api/identity/rotate`) adds a
+//! key and makes it active; the old one stays published so tokens it signed in the last few
+//! minutes still verify. Retire it later by renaming `<kid>.key` to `<kid>.retired`.
+//!
+//! Token claims: `iss`, `sub` (account id as a string), `name`, `roles`, `aud` (host id), `iat`,
+//! `exp` (RFC 3339 UTC, as PASETO registers them), `jti` (single use: the host enforces that).
+//! Footer: `{"kid":"…"}`. Implicit assertion: empty.
+
+use std::collections::BTreeSet;
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, RwLock};
+
+use anyhow::{anyhow, bail, Context, Result};
+use axum::body::Bytes;
+use axum::extract::State;
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use base64::engine::general_purpose::URL_SAFE_NO_PAD as B64;
+use base64::Engine;
+use ed25519_dalek::{Signer, SigningKey, Verifier, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use super::config::P2pConfig;
+use crate::db::now;
+use crate::ratelimit::Limiter;
+use crate::session::{client_ip, Session};
+use crate::{AppError, AppState};
+
+const HEADER: &str = "v4.public.";
+
+/// PASETO pre-authentication encoding.
+pub fn pae(pieces: &[&[u8]]) -> Vec<u8> {
+    let mut out = Vec::new();
+    out.extend_from_slice(&((pieces.len() as u64) & (u64::MAX >> 1)).to_le_bytes());
+    for p in pieces {
+        out.extend_from_slice(&((p.len() as u64) & (u64::MAX >> 1)).to_le_bytes());
+        out.extend_from_slice(p);
+    }
+    out
+}
+
+/// `v4.public` sign: `message` is the claims JSON, `footer` may be empty.
+pub fn sign_v4_public(key: &SigningKey, message: &[u8], footer: &[u8]) -> String {
+    let sig = key.sign(&pae(&[HEADER.as_bytes(), message, footer, b""]));
+    let mut body = message.to_vec();
+    body.extend_from_slice(&sig.to_bytes());
+    let mut tok = format!("{HEADER}{}", B64.encode(body));
+    if !footer.is_empty() {
+        tok.push('.');
+        tok.push_str(&B64.encode(footer));
+    }
+    tok
+}
+
+/// `v4.public` verify; returns `(message, footer)`. Claims are not checked here.
+pub fn verify_v4_public(key: &VerifyingKey, token: &str) -> Result<(Vec<u8>, Vec<u8>)> {
+    let rest = token.strip_prefix(HEADER).ok_or_else(|| anyhow!("not a v4.public token"))?;
+    let (body, footer) = match rest.split_once('.') {
+        Some((b, f)) => (b, B64.decode(f).context("footer")?),
+        None => (rest, Vec::new()),
+    };
+    let body = B64.decode(body).context("body")?;
+    if body.len() < 64 {
+        bail!("token too short");
+    }
+    let (m, s) = body.split_at(body.len() - 64);
+    let sig = ed25519_dalek::Signature::from_slice(s)?;
+    key.verify(&pae(&[HEADER.as_bytes(), m, &footer, b""]), &sig)
+        .map_err(|_| anyhow!("bad signature"))?;
+    Ok((m.to_vec(), footer))
+}
+
+/// Unix seconds → `YYYY-MM-DDTHH:MM:SSZ`.
+pub fn rfc3339(secs: i64) -> String {
+    let days = secs.div_euclid(86_400);
+    let sod = secs.rem_euclid(86_400);
+    // Howard Hinnant's civil_from_days.
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let d = doy - (153 * mp + 2) / 5 + 1;
+    let m = if mp < 10 { mp + 3 } else { mp - 9 };
+    let y = yoe + era * 400 + i64::from(m <= 2);
+    format!(
+        "{y:04}-{m:02}-{d:02}T{:02}:{:02}:{:02}Z",
+        sod / 3600,
+        (sod / 60) % 60,
+        sod % 60
+    )
+}
+
+pub fn kid_of(vk: &VerifyingKey) -> String {
+    hex::encode(&Sha256::digest(vk.as_bytes())[..8])
+}
+
+struct Keys {
+    active_kid: String,
+    active: SigningKey,
+    /// Every published key, active first.
+    published: Vec<(String, VerifyingKey)>,
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct RevokedFile {
+    updated: i64,
+    sub: BTreeSet<i64>,
+}
+
+pub struct Identity {
+    dir: PathBuf,
+    ttl: i64,
+    keys: RwLock<Keys>,
+    revoked: Mutex<RevokedFile>,
+    limiter: Limiter,
+}
+
+fn read_seed(path: &Path) -> Result<SigningKey> {
+    let hex = std::fs::read_to_string(path).with_context(|| format!("reading {}", path.display()))?;
+    let b = hex::decode(hex.trim()).with_context(|| format!("{} is not hex", path.display()))?;
+    let seed: [u8; 32] = b
+        .try_into()
+        .map_err(|_| anyhow!("{} must hold 32 bytes", path.display()))?;
+    Ok(SigningKey::from_bytes(&seed))
+}
+
+fn load_keys(dir: &Path) -> Result<Keys> {
+    std::fs::create_dir_all(dir).with_context(|| format!("creating {}", dir.display()))?;
+    let active_path = dir.join("active");
+    if !active_path.exists() {
+        new_key(dir)?;
+    }
+    let active_kid = std::fs::read_to_string(&active_path)?.trim().to_string();
+    let active = read_seed(&dir.join(format!("{active_kid}.key")))?;
+    if kid_of(&active.verifying_key()) != active_kid {
+        bail!("identity key {active_kid}.key does not match its name");
+    }
+    let mut published = vec![(active_kid.clone(), active.verifying_key())];
+    let mut others: Vec<_> = std::fs::read_dir(dir)?
+        .filter_map(|e| e.ok())
+        .map(|e| e.path())
+        .filter(|p| p.extension().is_some_and(|x| x == "key"))
+        .collect();
+    others.sort();
+    for p in others {
+        let k = read_seed(&p)?;
+        let kid = kid_of(&k.verifying_key());
+        if kid != active_kid {
+            published.push((kid, k.verifying_key()));
+        }
+    }
+    Ok(Keys { active_kid, active, published })
+}
+
+/// Generate a key, write it, make it active. Returns its kid.
+fn new_key(dir: &Path) -> Result<String> {
+    let k = SigningKey::generate(&mut rand::rngs::OsRng);
+    let kid = kid_of(&k.verifying_key());
+    crate::secrets::write_private(&dir.join(format!("{kid}.key")), &hex::encode(k.to_bytes()))?;
+    super::write_atomic(&dir.join("active"), &kid)?;
+    Ok(kid)
+}
+
+impl Identity {
+    pub fn load_or_create(cfg: &P2pConfig) -> Result<Self> {
+        let dir = cfg.state_dir.join("identity");
+        let keys = load_keys(&dir)?;
+        let revoked = std::fs::read_to_string(dir.join("revoked.json"))
+            .ok()
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_default();
+        tracing::info!(kid = %keys.active_kid, "identity tokens enabled");
+        Ok(Self {
+            dir,
+            ttl: cfg.identity_ttl_secs,
+            keys: RwLock::new(keys),
+            revoked: Mutex::new(revoked),
+            limiter: Limiter::default(),
+        })
+    }
+
+    pub fn rotate(&self) -> Result<String> {
+        let kid = new_key(&self.dir)?;
+        *self.keys.write().unwrap_or_else(|e| e.into_inner()) = load_keys(&self.dir)?;
+        Ok(kid)
+    }
+
+    pub fn active_kid(&self) -> String {
+        self.keys.read().unwrap_or_else(|e| e.into_inner()).active_kid.clone()
+    }
+
+    pub fn keys_json(&self) -> serde_json::Value {
+        let k = self.keys.read().unwrap_or_else(|e| e.into_inner());
+        let keys: Vec<_> = k
+            .published
+            .iter()
+            .map(|(kid, vk)| serde_json::json!({ "kid": kid, "alg": "Ed25519", "x": B64.encode(vk.as_bytes()) }))
+            .collect();
+        serde_json::json!({ "keys": keys })
+    }
+
+    /// Mint a token. Returns `(token, exp)`.
+    pub fn issue(&self, iss: &str, sub: i64, name: &str, roles: &[&str], aud: &str) -> (String, i64) {
+        let iat = now();
+        let exp = iat + self.ttl;
+        let jti = {
+            use rand::RngCore;
+            let mut b = [0u8; 16];
+            rand::thread_rng().fill_bytes(&mut b);
+            hex::encode(b)
+        };
+        let claims = serde_json::json!({
+            "iss": iss, "sub": sub.to_string(), "name": name, "roles": roles, "aud": aud,
+            "iat": rfc3339(iat), "exp": rfc3339(exp), "jti": jti,
+        });
+        let k = self.keys.read().unwrap_or_else(|e| e.into_inner());
+        let footer = serde_json::json!({ "kid": k.active_kid }).to_string();
+        let tok = sign_v4_public(&k.active, claims.to_string().as_bytes(), footer.as_bytes());
+        (tok, exp)
+    }
+
+    /// Verify against the published keys (the footer's kid picks one). For tests and tooling;
+    /// hosts do the same with the keys document.
+    pub fn verify(&self, token: &str) -> Result<serde_json::Value> {
+        let k = self.keys.read().unwrap_or_else(|e| e.into_inner());
+        let footer = token
+            .strip_prefix(HEADER)
+            .and_then(|r| r.split_once('.'))
+            .map(|(_, f)| f)
+            .ok_or_else(|| anyhow!("no footer"))?;
+        let footer: serde_json::Value = serde_json::from_slice(&B64.decode(footer)?)?;
+        let kid = footer["kid"].as_str().unwrap_or("");
+        let (_, vk) = k
+            .published
+            .iter()
+            .find(|(id, _)| id == kid)
+            .ok_or_else(|| anyhow!("unknown kid"))?;
+        let (m, _) = verify_v4_public(vk, token)?;
+        Ok(serde_json::from_slice(&m)?)
+    }
+
+    pub fn is_revoked(&self, sub: i64) -> bool {
+        self.revoked.lock().unwrap_or_else(|e| e.into_inner()).sub.contains(&sub)
+    }
+
+    pub fn set_revoked(&self, sub: i64, on: bool) -> Result<()> {
+        let body = {
+            let mut r = self.revoked.lock().unwrap_or_else(|e| e.into_inner());
+            if on {
+                r.sub.insert(sub);
+            } else {
+                r.sub.remove(&sub);
+            }
+            r.updated = now();
+            serde_json::to_string_pretty(&*r)?
+        };
+        super::write_atomic(&self.dir.join("revoked.json"), &body)
+    }
+
+    /// The signed revocation document: `(body, signature b64url, kid)`.
+    pub fn revoked_doc(&self, disabled: &[i64]) -> (String, String, String) {
+        let mut all: BTreeSet<i64> = self.revoked.lock().unwrap_or_else(|e| e.into_inner()).sub.clone();
+        all.extend(disabled.iter().copied());
+        let subs: Vec<String> = all.iter().map(|s| s.to_string()).collect();
+        let body = serde_json::json!({ "updated": now(), "sub": subs }).to_string();
+        let k = self.keys.read().unwrap_or_else(|e| e.into_inner());
+        let sig = B64.encode(k.active.sign(body.as_bytes()).to_bytes());
+        (body, sig, k.active_kid.clone())
+    }
+}
+
+fn ident(state: &AppState) -> &Identity {
+    state
+        .p2p
+        .identity
+        .as_ref()
+        .expect("identity routes are mounted only when enabled")
+}
+
+pub fn public_router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/.well-known/openvanilla-keys.json", get(keys))
+        .route("/api/identity/token", post(token))
+        .route("/api/identity/revoked", get(revoked))
+}
+
+pub fn admin_router() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/admin/api/identity/revoke", post(admin_revoke))
+        .route("/admin/api/identity/rotate", post(admin_rotate))
+}
+
+fn public_headers(r: &mut Response, cache: &'static str) {
+    let h = r.headers_mut();
+    h.insert(header::ACCESS_CONTROL_ALLOW_ORIGIN, HeaderValue::from_static("*"));
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static(cache));
+}
+
+async fn keys(State(state): State<Arc<AppState>>) -> Response {
+    let mut r = Json(ident(&state).keys_json()).into_response();
+    public_headers(&mut r, "public, max-age=300");
+    r
+}
+
+fn err(status: StatusCode, msg: &str) -> Response {
+    let mut r = (status, Json(serde_json::json!({ "error": msg }))).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TokenBody {
+    aud: String,
+}
+
+async fn token(State(state): State<Arc<AppState>>, headers: HeaderMap, body: Bytes) -> Result<Response, AppError> {
+    let id = ident(&state);
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !id.limiter.allow(&format!("idtok:ip:{ip}"), 120, 60) {
+        return Ok(err(StatusCode::TOO_MANY_REQUESTS, "slow down"));
+    }
+    let Some(user) = super::caller(&state, &headers).await? else {
+        return Ok(err(StatusCode::UNAUTHORIZED, "sign in first"));
+    };
+    if !id.limiter.allow(&format!("idtok:user:{}", user.id), 30, 60) {
+        return Ok(err(StatusCode::TOO_MANY_REQUESTS, "slow down"));
+    }
+    let Ok(b) = serde_json::from_slice::<TokenBody>(&body) else {
+        return Ok(err(StatusCode::BAD_REQUEST, "body: {\"aud\": \"<host_id>\"}"));
+    };
+    if !super::valid_host_id(&b.aud) {
+        return Ok(err(StatusCode::BAD_REQUEST, "aud: a 16-character host id"));
+    }
+    if id.is_revoked(user.id) {
+        return Ok(err(StatusCode::FORBIDDEN, "this account may not join community realms"));
+    }
+    let roles: &[&str] = if user.is_admin() { &["player", "staff"] } else { &["player"] };
+    let (tok, exp) = id.issue(&state.cfg.public_url, user.id, &user.display_name, roles, &b.aud);
+    let mut r = Json(serde_json::json!({ "token": tok, "exp": exp })).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    Ok(r)
+}
+
+async fn revoked(State(state): State<Arc<AppState>>) -> Result<Response, AppError> {
+    let disabled: Vec<i64> = sqlx::query_scalar("SELECT id FROM users WHERE disabled != 0")
+        .fetch_all(&state.db)
+        .await?;
+    let (body, sig, kid) = ident(&state).revoked_doc(&disabled);
+    let mut r = (StatusCode::OK, [(header::CONTENT_TYPE, "application/json")], body).into_response();
+    public_headers(&mut r, "public, max-age=60");
+    let h = r.headers_mut();
+    h.insert("x-openvanilla-signature", HeaderValue::from_str(&sig)?);
+    h.insert("x-openvanilla-kid", HeaderValue::from_str(&kid)?);
+    h.insert(
+        header::ACCESS_CONTROL_EXPOSE_HEADERS,
+        HeaderValue::from_static("x-openvanilla-signature, x-openvanilla-kid"),
+    );
+    Ok(r)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RevokeBody {
+    sub: i64,
+    #[serde(default = "yes")]
+    on: bool,
+}
+fn yes() -> bool {
+    true
+}
+
+async fn admin_revoke(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<RevokeBody>,
+) -> Result<Response, AppError> {
+    super::check_csrf(&session, &headers)?;
+    ident(&state).set_revoked(b.sub, b.on)?;
+    let action = if b.on { "identity.revoke" } else { "identity.unrevoke" };
+    crate::audit::log(&state.db, Some(session.user.id), None, action, Some(&b.sub.to_string()), None).await;
+    Ok(Json(serde_json::json!({ "ok": true, "sub": b.sub.to_string(), "revoked": b.on })).into_response())
+}
+
+async fn admin_rotate(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+) -> Result<Response, AppError> {
+    super::check_csrf(&session, &headers)?;
+    let kid = ident(&state).rotate()?;
+    crate::audit::log(&state.db, Some(session.user.id), None, "identity.rotate", Some(&kid), None).await;
+    Ok(Json(serde_json::json!({ "ok": true, "kid": kid })).into_response())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// PASETO v4 official test vector 4-S-1 (public, no footer, no implicit assertion).
+    #[test]
+    fn paseto_vector_4_s_1() {
+        let seed: [u8; 32] = hex::decode("b4cbfb43df4ce210727d953e4a713307fa19bb7d9f85041438d9e11b942a3774").unwrap().try_into().unwrap();
+        let k = SigningKey::from_bytes(&seed);
+        assert_eq!(hex::encode(k.verifying_key().as_bytes()), "1eb9dbbbbc047c03fd70604e0071f0987e16b28b757225c11f00415d0e20b1a2");
+        let msg = br#"{"data":"this is a signed message","exp":"2022-01-01T00:00:00+00:00"}"#;
+        let tok = sign_v4_public(&k, msg, b"");
+        assert_eq!(tok, "v4.public.eyJkYXRhIjoidGhpcyBpcyBhIHNpZ25lZCBtZXNzYWdlIiwiZXhwIjoiMjAyMi0wMS0wMVQwMDowMDowMCswMDowMCJ9bg_XBBzds8lTZShVlwwKSgeKpLT3yukTw6JUz3W4h_ExsQV-P0V54zemZDcAxFaSeef1QlXEFtkqxT1ciiQEDA");
+        let (m, f) = verify_v4_public(&k.verifying_key(), &tok).unwrap();
+        assert_eq!(m, msg);
+        assert!(f.is_empty());
+    }
+
+    #[test]
+    fn dates() {
+        assert_eq!(rfc3339(0), "1970-01-01T00:00:00Z");
+        assert_eq!(rfc3339(1_640_995_200), "2022-01-01T00:00:00Z");
+        assert_eq!(rfc3339(951_782_400 + 3661), "2000-02-29T01:01:01Z");
+    }
+
+    #[test]
+    fn issue_rotate_revoke() {
+        let dir = tempfile::tempdir().unwrap();
+        let cfg = P2pConfig::off(dir.path());
+        let id = Identity::load_or_create(&cfg).unwrap();
+        let first = id.active_kid();
+        let (tok, exp) = id.issue("https://play.openvanilla.app", 7, "Bob", &["player"], "abcdefghijklmnop");
+        let c = id.verify(&tok).unwrap();
+        assert_eq!(c["sub"], "7");
+        assert_eq!(c["aud"], "abcdefghijklmnop");
+        assert_eq!(c["exp"], rfc3339(exp));
+        assert_eq!(c["jti"].as_str().unwrap().len(), 32);
+        // Tampering breaks it.
+        let mut bad = tok.clone().into_bytes();
+        bad[20] ^= 1;
+        assert!(id.verify(std::str::from_utf8(&bad).unwrap()).is_err());
+
+        let second = id.rotate().unwrap();
+        assert_ne!(first, second);
+        let ks = id.keys_json();
+        assert_eq!(ks["keys"].as_array().unwrap().len(), 2);
+        assert_eq!(ks["keys"][0]["kid"], second);
+        assert!(id.verify(&tok).is_ok(), "old token still verifies after rotation");
+        // Reload from disk keeps the active key.
+        let again = Identity::load_or_create(&cfg).unwrap();
+        assert_eq!(again.active_kid(), second);
+
+        id.set_revoked(9, true).unwrap();
+        let (body, sig, kid) = id.revoked_doc(&[3]);
+        let v: serde_json::Value = serde_json::from_str(&body).unwrap();
+        assert_eq!(v["sub"], serde_json::json!(["3", "9"]));
+        let x = ks["keys"].as_array().unwrap().iter().find(|k| k["kid"] == kid).unwrap()["x"].as_str().unwrap().to_string();
+        let vk = VerifyingKey::from_bytes(&B64.decode(x).unwrap().try_into().unwrap()).unwrap();
+        vk.verify(body.as_bytes(), &ed25519_dalek::Signature::from_slice(&B64.decode(sig).unwrap()).unwrap()).unwrap();
+        assert!(Identity::load_or_create(&cfg).unwrap().is_revoked(9));
+    }
+}
diff --git a/crates/wenilla-realm/src/p2p/mod.rs b/crates/wenilla-realm/src/p2p/mod.rs
new file mode 100644
index 00000000..f1c52c85
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/mod.rs
@@ -0,0 +1,190 @@
+//! Open Vanilla player network, the central half (see `docs/P2P_NETWORK.md` in the Open Vanilla repo):
+//!
+//! * [`directory`] — community hosts heartbeat in, launchers read the public list; every entry is
+//!   probed ([`probe`]) before it is listed.
+//! * [`identity`] — audience-bound PASETO v4.public tokens so a player signs in on any community
+//!   host without the host ever seeing their Open Vanilla password; the signing keys and a signed
+//!   revocation list.
+//! * [`tracker`] — a restricted HTTP BitTorrent tracker for Open Vanilla's own files only.
+//!
+//! Each part is off unless its switch is set (`DIRECTORY_ENABLED`, `IDENTITY_ENABLED`,
+//! `TRACKER_ENABLED`); while off its routes are not mounted at all (404).
+
+pub mod config;
+pub mod directory;
+pub mod identity;
+pub mod probe;
+pub mod tracker;
+
+use std::sync::Arc;
+
+use anyhow::Result;
+use axum::http::HeaderMap;
+use axum::Router;
+use axum_extra::extract::cookie::CookieJar;
+
+pub use config::P2pConfig;
+
+use crate::session::{self, User};
+use crate::AppState;
+
+/// The parts that are switched on. `None` = off.
+#[derive(Default)]
+pub struct P2p {
+    pub directory: Option<directory::Directory>,
+    pub identity: Option<identity::Identity>,
+    pub tracker: Option<tracker::Tracker>,
+}
+
+impl P2p {
+    /// Everything off — what tests and a default deployment get.
+    pub fn disabled() -> Arc<Self> {
+        Arc::new(Self::default())
+    }
+
+    pub fn from_config(cfg: &P2pConfig) -> Result<Arc<Self>> {
+        Ok(Arc::new(Self {
+            directory: if cfg.directory_enabled {
+                Some(directory::Directory::new(cfg.clone())?)
+            } else {
+                None
+            },
+            identity: if cfg.identity_enabled {
+                Some(identity::Identity::load_or_create(cfg)?)
+            } else {
+                None
+            },
+            tracker: if cfg.tracker_enabled {
+                Some(tracker::Tracker::new(cfg))
+            } else {
+                None
+            },
+        }))
+    }
+
+    /// Background housekeeping (expiry, persistence). Call once from `main`.
+    pub fn spawn_housekeeping(self: &Arc<Self>) {
+        let me = Arc::clone(self);
+        tokio::spawn(async move {
+            loop {
+                tokio::time::sleep(std::time::Duration::from_secs(60)).await;
+                if let Some(d) = &me.directory {
+                    d.sweep();
+                    if let Err(e) = d.save() {
+                        tracing::warn!(error = %e, "directory: saving state");
+                    }
+                }
+                if let Some(t) = &me.tracker {
+                    t.sweep();
+                }
+            }
+        });
+    }
+}
+
+/// Public routes (each handler does its own auth). Only the switched-on parts are mounted.
+pub fn public_router(p2p: &P2p) -> Router<Arc<AppState>> {
+    let mut r = Router::new();
+    if let Some(d) = &p2p.directory {
+        r = r.merge(directory::public_router());
+        if d.relay_verify_enabled() {
+            r = r.merge(directory::relay_verify_router());
+        }
+    }
+    if p2p.identity.is_some() {
+        r = r.merge(identity::public_router());
+    }
+    if p2p.tracker.is_some() {
+        r = r.merge(tracker::router());
+    }
+    r
+}
+
+/// Staff routes; the caller layers the existing session + admin gates over them.
+pub fn admin_router(p2p: &P2p) -> Router<Arc<AppState>> {
+    let mut r = Router::new();
+    if p2p.directory.is_some() {
+        r = r.merge(directory::admin_router());
+    }
+    if p2p.identity.is_some() {
+        r = r.merge(identity::admin_router());
+    }
+    r
+}
+
+/// The signed-in Open Vanilla account behind a request: the web session cookie, or the launcher's
+/// `Authorization: Bearer <launcher token>`. Disabled users and sessions that still owe a
+/// password change get `None`.
+pub async fn caller(state: &AppState, headers: &HeaderMap) -> Result<Option<User>> {
+    let jar = CookieJar::from_headers(headers);
+    if let Some(tok) = jar.get(session::COOKIE).map(|c| c.value().to_string()) {
+        if let Some(s) = session::lookup(&state.db, &tok).await? {
+            if !s.must_change_password {
+                return Ok(Some(s.user));
+            }
+            return Ok(None);
+        }
+    }
+    let Some(tok) = bearer(headers) else {
+        return Ok(None);
+    };
+    let user: Option<User> = sqlx::query_as(
+        "SELECT u.id, u.username, u.display_name, u.role, u.disabled FROM launcher_tokens t \
+         JOIN users u ON u.id = t.user_id WHERE t.token_hash = ? AND u.disabled = 0",
+    )
+    .bind(session::hash(&tok))
+    .fetch_optional(&state.db)
+    .await?;
+    Ok(user)
+}
+
+pub(crate) fn bearer(headers: &HeaderMap) -> Option<String> {
+    headers
+        .get(axum::http::header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .and_then(|v| v.strip_prefix("Bearer "))
+        .map(|t| t.trim().to_string())
+        .filter(|t| !t.is_empty())
+}
+
+/// Staff JSON endpoints are reached by `fetch` from the panel or by `curl`; on top of the global
+/// cross-site filter they require the session's CSRF token in `X-CSRF-Token`.
+pub(crate) fn check_csrf(s: &session::Session, headers: &HeaderMap) -> Result<(), crate::AppError> {
+    let tok = headers
+        .get("x-csrf-token")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("");
+    crate::csrf::verify(s, tok)
+}
+
+/// 16 lowercase RFC 4648 base32 characters (80 random bits).
+pub fn new_host_id() -> String {
+    use rand::RngCore;
+    let mut b = [0u8; 10];
+    rand::thread_rng().fill_bytes(&mut b);
+    data_encoding::BASE32_NOPAD.encode(&b).to_ascii_lowercase()
+}
+
+pub fn valid_host_id(s: &str) -> bool {
+    s.len() == 16 && s.bytes().all(|c| c.is_ascii_lowercase() || (b'2'..=b'7').contains(&c))
+}
+
+/// Write `contents` to `path` atomically (temp file + rename), owner-only.
+pub(crate) fn write_atomic(path: &std::path::Path, contents: &str) -> Result<()> {
+    let tmp = path.with_extension("tmp");
+    crate::secrets::write_private(&tmp, contents)?;
+    std::fs::rename(&tmp, path)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn host_ids() {
+        let id = super::new_host_id();
+        assert!(super::valid_host_id(&id), "{id}");
+        assert!(!super::valid_host_id("ABCDEFGHIJKLMNOP"));
+        assert!(!super::valid_host_id("abcdefgh01234567"));
+        assert!(!super::valid_host_id("abc"));
+    }
+}
diff --git a/crates/wenilla-realm/src/p2p/probe.rs b/crates/wenilla-realm/src/p2p/probe.rs
new file mode 100644
index 00000000..fe11c4d0
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/probe.rs
@@ -0,0 +1,175 @@
+//! Reachability probe: does `host:port` (or the relay's `/h/<host_id>/ws/3724`) answer like a
+//! 1.12.1 realmd? We send a well-formed `AUTH_LOGON_CHALLENGE` (build 5875, account `PROBE`)
+//! and accept any `AUTH_LOGON_CHALLENGE` reply header (`00 00 <result>`) — an unknown-account
+//! failure is as good a proof of a realmd as a real challenge. We never continue the login.
+
+use std::net::{IpAddr, SocketAddr};
+use std::time::Duration;
+
+use anyhow::{anyhow, bail, Context, Result};
+use futures_util::{SinkExt, StreamExt};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::TcpStream;
+
+pub const PROBE_ACCOUNT: &str = "PROBE";
+
+/// The client's `AUTH_LOGON_CHALLENGE` for 1.12.1 (5875).
+pub fn challenge_packet(account: &str) -> Vec<u8> {
+    let acct = account.to_ascii_uppercase();
+    let mut p = Vec::with_capacity(34 + acct.len());
+    p.push(0x00); // CMD_AUTH_LOGON_CHALLENGE
+    p.push(0x03); // protocol "error" byte the 1.12 client sends
+    p.extend_from_slice(&((30 + acct.len()) as u16).to_le_bytes());
+    p.extend_from_slice(b"WoW\0");
+    p.extend_from_slice(&[1, 12, 1]);
+    p.extend_from_slice(&5875u16.to_le_bytes());
+    p.extend_from_slice(b"68x\0"); // "x86", little-endian fourcc
+    p.extend_from_slice(b"niW\0"); // "Win"
+    p.extend_from_slice(b"SUne"); // "enUS"
+    p.extend_from_slice(&0u32.to_le_bytes()); // timezone bias
+    p.extend_from_slice(&[127, 0, 0, 1]); // client ip (realmd ignores it)
+    p.push(acct.len() as u8);
+    p.extend_from_slice(acct.as_bytes());
+    p
+}
+
+/// Is `b` the start of a realmd `AUTH_LOGON_CHALLENGE` reply? `00` cmd, `00` padding, then a
+/// result code from the 1.12 set (0x00 success … 0x20).
+pub fn looks_like_challenge_reply(b: &[u8]) -> bool {
+    b.len() >= 3 && b[0] == 0x00 && b[1] == 0x00 && b[2] <= 0x20
+}
+
+/// Addresses a probe (or a listing) may never point at.
+pub fn is_public_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(v4) => {
+            let o = v4.octets();
+            !(v4.is_private()
+                || v4.is_loopback()
+                || v4.is_link_local()
+                || v4.is_broadcast()
+                || v4.is_documentation()
+                || v4.is_unspecified()
+                || v4.is_multicast()
+                || o[0] == 0
+                || (o[0] == 100 && (o[1] & 0xc0) == 64) // 100.64/10 CGNAT
+                || (o[0] == 192 && o[1] == 0 && o[2] == 0) // 192.0.0/24
+                || (o[0] == 198 && (o[1] & 0xfe) == 18) // 198.18/15 benchmarking
+                || o[0] >= 240)
+        }
+        IpAddr::V6(v6) => {
+            if let Some(v4) = v6.to_ipv4_mapped() {
+                return is_public_ip(IpAddr::V4(v4));
+            }
+            let s = v6.segments();
+            !(v6.is_loopback()
+                || v6.is_unspecified()
+                || v6.is_multicast()
+                || (s[0] & 0xfe00) == 0xfc00 // ULA
+                || (s[0] & 0xffc0) == 0xfe80 // link-local
+                || s[0] == 0x2001 && s[1] == 0x0db8) // documentation
+        }
+    }
+}
+
+/// Resolve and pick the first address allowed by policy.
+async fn resolve(host: &str, port: u16, allow_private: bool) -> Result<SocketAddr> {
+    let addrs: Vec<SocketAddr> = tokio::net::lookup_host((host, port))
+        .await
+        .with_context(|| format!("cannot resolve {host}"))?
+        .collect();
+    if addrs.is_empty() {
+        bail!("{host} has no address");
+    }
+    // A name that resolves to any private address is refused outright (DNS rebinding games).
+    if !allow_private && addrs.iter().any(|a| !is_public_ip(a.ip())) {
+        bail!("{host} resolves to a non-public address");
+    }
+    Ok(addrs[0])
+}
+
+/// Direct probe: TCP connect, send the challenge, read the reply header.
+pub async fn probe_direct(host: &str, port: u16, allow_private: bool, timeout: Duration) -> Result<()> {
+    tokio::time::timeout(timeout, async {
+        let addr = resolve(host, port, allow_private).await?;
+        let mut s = TcpStream::connect(addr)
+            .await
+            .with_context(|| format!("cannot connect to {host}:{port}"))?;
+        s.write_all(&challenge_packet(PROBE_ACCOUNT)).await?;
+        let mut buf = [0u8; 3];
+        s.read_exact(&mut buf)
+            .await
+            .context("connection closed before a realmd reply")?;
+        if !looks_like_challenge_reply(&buf) {
+            bail!("{host}:{port} did not answer like a realmd");
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|_| anyhow!("timed out after {}s", timeout.as_secs()))?
+}
+
+/// Relay probe: the same exchange as binary frames over the relay's player WebSocket
+/// (`<relay_url>/h/<host_id>/ws/3724`). The relay itself is a trusted, configured URL.
+pub async fn probe_relay(relay_url: &str, host_id: &str, timeout: Duration) -> Result<()> {
+    use tokio_tungstenite::tungstenite::Message;
+    let url = format!("{}/h/{host_id}/ws/3724", relay_url.trim_end_matches('/'));
+    tokio::time::timeout(timeout, async {
+        let (mut ws, _) = tokio_tungstenite::connect_async(url.as_str())
+            .await
+            .with_context(|| format!("cannot open {url}"))?;
+        ws.send(Message::Binary(challenge_packet(PROBE_ACCOUNT).into()))
+            .await?;
+        let mut got = Vec::new();
+        while got.len() < 3 {
+            match ws.next().await {
+                Some(Ok(Message::Binary(b))) => got.extend_from_slice(&b),
+                Some(Ok(Message::Ping(_) | Message::Pong(_) | Message::Frame(_))) => {}
+                Some(Ok(Message::Text(_))) => bail!("relay sent text, expected realmd bytes"),
+                Some(Ok(Message::Close(_))) | None => bail!("relay closed: host agent not connected?"),
+                Some(Err(e)) => return Err(e.into()),
+            }
+        }
+        let _ = ws.close(None).await;
+        if !looks_like_challenge_reply(&got) {
+            bail!("relayed host did not answer like a realmd");
+        }
+        Ok(())
+    })
+    .await
+    .map_err(|_| anyhow!("timed out after {}s", timeout.as_secs()))?
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn packet_shape() {
+        let p = challenge_packet("probe");
+        assert_eq!(p.len(), 4 + 30 + 5);
+        assert_eq!(u16::from_le_bytes([p[2], p[3]]) as usize, p.len() - 4);
+        assert_eq!(&p[4..8], b"WoW\0");
+        assert_eq!(u16::from_le_bytes([p[11], p[12]]), 5875);
+        assert_eq!(p[33], 5);
+        assert_eq!(&p[34..], b"PROBE");
+    }
+
+    #[test]
+    fn reply_recognised() {
+        assert!(looks_like_challenge_reply(&[0, 0, 4]));
+        assert!(looks_like_challenge_reply(&[0, 0, 0, 1, 2]));
+        assert!(!looks_like_challenge_reply(b"HTTP/1.1 400"));
+        assert!(!looks_like_challenge_reply(&[0, 0]));
+    }
+
+    #[test]
+    fn public_ips() {
+        for bad in ["127.0.0.1", "10.1.2.3", "192.168.1.1", "172.16.0.1", "100.64.1.1", "169.254.1.1", "0.0.0.0", "::1", "fd00::1", "fe80::1", "::ffff:10.0.0.1"] {
+            assert!(!is_public_ip(bad.parse().unwrap()), "{bad}");
+        }
+        for good in ["1.1.1.1", "95.216.1.2", "2a01:4f8::1"] {
+            assert!(is_public_ip(good.parse().unwrap()), "{good}");
+        }
+    }
+}
diff --git a/crates/wenilla-realm/src/p2p/tracker.rs b/crates/wenilla-realm/src/p2p/tracker.rs
new file mode 100644
index 00000000..6d5d3d9f
--- /dev/null
+++ b/crates/wenilla-realm/src/p2p/tracker.rs
@@ -0,0 +1,313 @@
+//! A restricted HTTP BitTorrent tracker (BEP 3, compact peers per BEP 23, `peers6` per BEP 7).
+//! Only info-hashes listed in the allowlist file (40 hex chars per line, `#` comments) are
+//! tracked — Open Vanilla's own files, never Blizzard data; anything else gets a failure reason.
+//! The list is re-read when the file changes. Peers live in memory and expire after two
+//! announce intervals.
+
+use std::collections::{HashMap, HashSet};
+use std::net::IpAddr;
+use std::path::PathBuf;
+use std::sync::{Arc, Mutex};
+use std::time::SystemTime;
+
+use axum::extract::State;
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode, Uri};
+use axum::response::{IntoResponse, Response};
+use axum::routing::get;
+use axum::Router;
+
+use super::config::P2pConfig;
+use crate::db::now;
+use crate::ratelimit::Limiter;
+use crate::session::client_ip;
+use crate::AppState;
+
+/// Hard cap of peers remembered per torrent (oldest dropped).
+pub const MAX_SWARM: usize = 5000;
+
+#[derive(Clone, Debug)]
+struct Peer {
+    ip: IpAddr,
+    port: u16,
+    seeder: bool,
+    seen: i64,
+}
+
+#[derive(Default)]
+struct Allow {
+    mtime: Option<SystemTime>,
+    checked: i64,
+    set: HashSet<[u8; 20]>,
+}
+
+pub struct Tracker {
+    allowlist: PathBuf,
+    interval: i64,
+    max_peers: usize,
+    allow: Mutex<Allow>,
+    /// info-hash → peer_id → peer.
+    swarms: Mutex<HashMap<[u8; 20], HashMap<[u8; 20], Peer>>>,
+    limiter: Limiter,
+}
+
+/// Minimal bencode writer for the one dictionary shape we answer with.
+pub enum B<'a> {
+    I(i64),
+    S(&'a [u8]),
+}
+
+pub fn bdict(items: &[(&str, B<'_>)]) -> Vec<u8> {
+    let mut sorted: Vec<&(&str, B<'_>)> = items.iter().collect();
+    sorted.sort_by_key(|(k, _)| *k);
+    let mut out = b"d".to_vec();
+    for (k, v) in sorted {
+        out.extend_from_slice(format!("{}:{k}", k.len()).as_bytes());
+        match v {
+            B::I(i) => out.extend_from_slice(format!("i{i}e").as_bytes()),
+            B::S(s) => {
+                out.extend_from_slice(format!("{}:", s.len()).as_bytes());
+                out.extend_from_slice(s);
+            }
+        }
+    }
+    out.push(b'e');
+    out
+}
+
+pub fn failure(reason: &str) -> Vec<u8> {
+    bdict(&[("failure reason", B::S(reason.as_bytes()))])
+}
+
+/// Percent-decode a query value into raw bytes (info_hash / peer_id are binary).
+fn pct_decode(s: &str) -> Option<Vec<u8>> {
+    let b = s.as_bytes();
+    let mut out = Vec::with_capacity(b.len());
+    let mut i = 0;
+    while i < b.len() {
+        match b[i] {
+            b'%' => {
+                let h = std::str::from_utf8(b.get(i + 1..i + 3)?).ok()?;
+                out.push(u8::from_str_radix(h, 16).ok()?);
+                i += 3;
+            }
+            b'+' => {
+                out.push(b' ');
+                i += 1;
+            }
+            c => {
+                out.push(c);
+                i += 1;
+            }
+        }
+    }
+    Some(out)
+}
+
+fn parse_query(q: &str) -> HashMap<String, Vec<u8>> {
+    let mut m = HashMap::new();
+    for pair in q.split('&') {
+        let (k, v) = pair.split_once('=').unwrap_or((pair, ""));
+        if let (Some(k), Some(v)) = (pct_decode(k), pct_decode(v)) {
+            if let Ok(k) = String::from_utf8(k) {
+                m.entry(k).or_insert(v);
+            }
+        }
+    }
+    m
+}
+
+fn num(m: &HashMap<String, Vec<u8>>, k: &str) -> Option<i64> {
+    std::str::from_utf8(m.get(k)?).ok()?.parse().ok()
+}
+
+impl Tracker {
+    pub fn new(cfg: &P2pConfig) -> Self {
+        Self {
+            allowlist: cfg.tracker_allowlist.clone(),
+            interval: cfg.tracker_interval,
+            max_peers: cfg.tracker_max_peers,
+            allow: Mutex::default(),
+            swarms: Mutex::default(),
+            limiter: Limiter::default(),
+        }
+    }
+
+    fn allowed(&self, ih: &[u8; 20]) -> bool {
+        let t = now();
+        let mut a = self.allow.lock().unwrap_or_else(|e| e.into_inner());
+        if t - a.checked >= 5 || a.checked == 0 {
+            a.checked = t;
+            let mtime = std::fs::metadata(&self.allowlist).and_then(|m| m.modified()).ok();
+            if mtime != a.mtime {
+                a.mtime = mtime;
+                a.set = std::fs::read_to_string(&self.allowlist)
+                    .unwrap_or_default()
+                    .lines()
+                    .map(|l| l.split('#').next().unwrap_or("").trim())
+                    .filter_map(|l| hex::decode(l).ok())
+                    .filter_map(|b| <[u8; 20]>::try_from(b).ok())
+                    .collect();
+                tracing::info!(count = a.set.len(), "tracker allowlist loaded");
+            }
+        }
+        a.set.contains(ih)
+    }
+
+    pub fn sweep(&self) {
+        let cutoff = now() - 2 * self.interval;
+        let mut s = self.swarms.lock().unwrap_or_else(|e| e.into_inner());
+        s.retain(|_, peers| {
+            peers.retain(|_, p| p.seen >= cutoff);
+            !peers.is_empty()
+        });
+    }
+
+    /// Handle one announce; returns the bencoded body.
+    pub fn announce(&self, query: &str, ip: Option<IpAddr>) -> Vec<u8> {
+        let q = parse_query(query);
+        let Some(ih) = q.get("info_hash").and_then(|v| <[u8; 20]>::try_from(v.as_slice()).ok()) else {
+            return failure("missing or malformed info_hash");
+        };
+        let Some(pid) = q.get("peer_id").and_then(|v| <[u8; 20]>::try_from(v.as_slice()).ok()) else {
+            return failure("missing or malformed peer_id");
+        };
+        let Some(port) = num(&q, "port").filter(|p| (1..=65535).contains(p)) else {
+            return failure("missing or invalid port");
+        };
+        let Some(ip) = ip else {
+            return failure("cannot tell your address");
+        };
+        if !self.allowed(&ih) {
+            return failure("this tracker only serves Open Vanilla's own torrents");
+        }
+        let event = q.get("event").map(|v| v.as_slice()).unwrap_or(b"");
+        let left = num(&q, "left").unwrap_or(1);
+        let want = num(&q, "numwant")
+            .unwrap_or(self.max_peers as i64)
+            .clamp(0, self.max_peers as i64) as usize;
+        let t = now();
+        let mut swarms = self.swarms.lock().unwrap_or_else(|e| e.into_inner());
+        let swarm = swarms.entry(ih).or_default();
+        if event == b"stopped" {
+            swarm.remove(&pid);
+        } else {
+            swarm.insert(pid, Peer { ip, port: port as u16, seeder: left == 0, seen: t });
+            if swarm.len() > MAX_SWARM {
+                if let Some(oldest) = swarm.iter().min_by_key(|(_, p)| p.seen).map(|(k, _)| *k) {
+                    swarm.remove(&oldest);
+                }
+            }
+        }
+        let cutoff = t - 2 * self.interval;
+        let complete = swarm.values().filter(|p| p.seeder && p.seen >= cutoff).count() as i64;
+        let incomplete = swarm.values().filter(|p| !p.seeder && p.seen >= cutoff).count() as i64;
+        // A random sample of other live peers; seeders don't need other seeders.
+        let me_seeder = left == 0;
+        let mut cands: Vec<&Peer> = swarm
+            .iter()
+            .filter(|(k, p)| **k != pid && p.seen >= cutoff && !(me_seeder && p.seeder))
+            .map(|(_, p)| p)
+            .collect();
+        {
+            use rand::seq::SliceRandom;
+            cands.shuffle(&mut rand::thread_rng());
+        }
+        let mut v4 = Vec::new();
+        let mut v6 = Vec::new();
+        for p in cands.into_iter().take(want) {
+            match p.ip {
+                IpAddr::V4(a) => {
+                    v4.extend_from_slice(&a.octets());
+                    v4.extend_from_slice(&p.port.to_be_bytes());
+                }
+                IpAddr::V6(a) => {
+                    v6.extend_from_slice(&a.octets());
+                    v6.extend_from_slice(&p.port.to_be_bytes());
+                }
+            }
+        }
+        if swarm.is_empty() {
+            swarms.remove(&ih);
+        }
+        bdict(&[
+            ("interval", B::I(self.interval)),
+            ("min interval", B::I(self.interval / 2)),
+            ("complete", B::I(complete)),
+            ("incomplete", B::I(incomplete)),
+            ("peers", B::S(&v4)),
+            ("peers6", B::S(&v6)),
+        ])
+    }
+}
+
+pub fn router() -> Router<Arc<AppState>> {
+    Router::new().route("/announce", get(announce))
+}
+
+async fn announce(State(state): State<Arc<AppState>>, headers: HeaderMap, uri: Uri) -> Response {
+    let t = state
+        .p2p
+        .tracker
+        .as_ref()
+        .expect("tracker routes are mounted only when enabled");
+    let ip_s = client_ip(&headers);
+    let body = if !t.limiter.allow(&format!("announce:{}", ip_s.as_deref().unwrap_or("")), 60, 60) {
+        failure("slow down")
+    } else {
+        let ip = ip_s.and_then(|s| s.parse::<IpAddr>().ok()).map(|ip| match ip {
+            IpAddr::V6(v6) => v6.to_ipv4_mapped().map(IpAddr::V4).unwrap_or(ip),
+            v4 => v4,
+        });
+        t.announce(uri.query().unwrap_or(""), ip)
+    };
+    let mut r = (StatusCode::OK, body).into_response();
+    let h = r.headers_mut();
+    h.insert(header::CONTENT_TYPE, HeaderValue::from_static("text/plain"));
+    h.insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn enc(b: &[u8]) -> String {
+        b.iter().map(|c| format!("%{c:02x}")).collect()
+    }
+
+    #[test]
+    fn bencode() {
+        assert_eq!(bdict(&[("b", B::I(1)), ("a", B::S(b"xy"))]), b"d1:a2:xy1:bi1ee");
+        assert_eq!(failure("no"), b"d14:failure reason2:noe");
+    }
+
+    #[test]
+    fn announces() {
+        let dir = tempfile::tempdir().unwrap();
+        let cfg = P2pConfig::off(dir.path());
+        let ih = [0xabu8; 20];
+        std::fs::write(&cfg.tracker_allowlist, format!("# ours\n{}\n", hex::encode(ih))).unwrap();
+        let t = Tracker::new(&cfg);
+        let q = |pid: u8, port: u16, left: u64, hash: &[u8]| {
+            format!("info_hash={}&peer_id={}&port={port}&uploaded=0&downloaded=0&left={left}&compact=1", enc(hash), enc(&[pid; 20]))
+        };
+        let other = t.announce(&q(1, 6881, 0, &[0x11; 20]), Some("1.2.3.4".parse().unwrap()));
+        assert!(String::from_utf8_lossy(&other).contains("failure reason"));
+
+        let r1 = t.announce(&q(1, 6881, 0, &ih), Some("1.2.3.4".parse().unwrap()));
+        assert!(r1.starts_with(b"d8:completei1e10:incompletei0e8:intervali1800e"), "{}", String::from_utf8_lossy(&r1));
+        let r2 = t.announce(&q(2, 51413, 100, &ih), Some("5.6.7.8".parse().unwrap()));
+        // The leecher gets the seeder in compact form: 1.2.3.4:6881.
+        let needle = [b"5:peers6:".as_slice(), &[1, 2, 3, 4, 0x1a, 0xe1]].concat();
+        assert!(r2.windows(needle.len()).any(|w| w == needle.as_slice()), "{:?}", r2);
+        // A v6 peer shows in peers6.
+        let r3 = t.announce(&q(3, 7000, 100, &ih), Some("2a01:4f8::1".parse().unwrap()));
+        assert!(String::from_utf8_lossy(&r3).contains("complete"));
+        let r4 = t.announce(&q(1, 6881, 0, &ih), Some("1.2.3.4".parse().unwrap()));
+        assert!(r4.windows(10).any(|w| w == b"6:peers618"), "{}", String::from_utf8_lossy(&r4));
+        // Stopped peers leave.
+        t.announce(&(q(2, 51413, 100, &ih) + "&event=stopped"), Some("5.6.7.8".parse().unwrap()));
+        assert_eq!(t.swarms.lock().unwrap()[&ih].len(), 2);
+        assert!(String::from_utf8_lossy(&t.announce("info_hash=x", None)).contains("failure"));
+    }
+}
