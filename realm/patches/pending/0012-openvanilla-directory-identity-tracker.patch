+async fn heartbeat(State(state): State<Arc<AppState>>, headers: HeaderMap, body: Bytes) -> Response {
+    let d = dir(&state);
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !d.limiter.allow(&format!("dir:ip:{ip}"), 30, 60) {
+        return json_err(StatusCode::TOO_MANY_REQUESTS, "slow down");
+    }
+    if body.len() > MAX_BODY {
+        return json_err(StatusCode::PAYLOAD_TOO_LARGE, "at most 4 KB");
+    }
+    let hb: Heartbeat = match serde_json::from_slice(&body) {
+        Ok(h) => h,
+        Err(e) => return json_err(StatusCode::BAD_REQUEST, format!("bad heartbeat: {e}")),
+    };
+    let v = match d.validate(hb) {
+        Ok(v) => v,
+        Err(e) => return json_err(StatusCode::BAD_REQUEST, e),
+    };
+    let t = now();
+    let token = super::bearer(&headers);
+    let (host_id, new_token) = {
+        let mut g = lock(&d.inner);
+        let addr_key = (!v.relay).then(|| format!("{}:{}", v.host, v.port));
+        match &token {
+            Some(tok) => {
+                let Some(id) = g.by_token(&sha256_hex(tok)).map(str::to_string) else {
+                    return json_err(StatusCode::FORBIDDEN, "unknown claim token");
+                };
+                if let Some(k) = &addr_key {
+                    if g.by_addr(k).is_some_and(|o| o.host_id != id) {
+                        return json_err(StatusCode::FORBIDDEN, "that host:port is claimed by another entry");
+                    }
+                }
+                let e = g.entries.get_mut(&id).expect("indexed");
+                if t - e.last_seen < MIN_BEAT_GAP {
+                    return json_err(StatusCode::TOO_MANY_REQUESTS, "one heartbeat per 20 s");
+                }
+                // Moving to another address (or between relay/direct) needs a fresh probe.
+                if e.host != v.host || e.port != v.port || e.relay != v.relay {
+                    e.probe = ProbeState::default();
+                }
+                apply(e, &v, t);
+                (id, None)
+            }
+            None => {
+                if let Some(k) = &addr_key {
+                    if g.by_addr(k).is_some() {
+                        return json_err(StatusCode::FORBIDDEN, "that host:port is already claimed — send its token");
+                    }
+                }
+                if g.entries.len() >= d.cfg.max_claims {
+                    return json_err(StatusCode::SERVICE_UNAVAILABLE, "the directory is full");
+                }
+                if !d.limiter.allow(&format!("dir:claim:{ip}"), 5, 3600) {
+                    return json_err(StatusCode::TOO_MANY_REQUESTS, "at most 5 new claims per hour");
+                }
+                let mut id = super::new_host_id();
+                while g.entries.contains_key(&id) {
+                    id = super::new_host_id();
+                }
+                let tok = {
+                    use rand::RngCore;
+                    let mut b = [0u8; 32];
+                    rand::thread_rng().fill_bytes(&mut b);
+                    hex::encode(b)
+                };
+                let mut e = Entry {
+                    host_id: id.clone(),
+                    token_hash: sha256_hex(&tok),
+                    name: String::new(),
+                    host: String::new(),
+                    port: 0,
+                    kind: String::new(),
+                    population: 0,
+                    version: String::new(),
+                    portal: None,
+                    build: 5875,
+                    description: String::new(),
+                    tags: Vec::new(),
+                    public: true,
+                    relay: false,
+                    template: String::new(),
+                    region: String::new(),
+                    created_at: t,
+                    last_seen: t,
+                    probe: ProbeState::default(),
+                };
+                apply(&mut e, &v, t);
+                g.entries.insert(id.clone(), e);
+                (id, Some(tok))
+            }
+        }
+    };
+    if d.is_blocked(&host_id, &v.host) {
+        return json_err(StatusCode::FORBIDDEN, "this realm has been delisted by staff");
+    }
+    d.probe_if_due(&host_id).await;
+    let Some(e) = d.known(&host_id) else {
+        return json_err(StatusCode::GONE, "claim expired");
+    };
+    let verified = lock(&d.staff).verified.contains(&host_id);
+    let mut out = serde_json::json!({
+        "host_id": host_id, "ttl": LIST_TTL, "heartbeat_every": HEARTBEAT_EVERY,
+        "listed": e.listable(now()), "verified": verified,
+        "probe": { "ok": e.probe_ok(now()), "at": e.probe.ok_at, "error": e.probe.error },
+    });
+    let status = match new_token {
+        Some(tok) => {
+            out["token"] = tok.into();
+            StatusCode::CREATED
+        }
+        None => StatusCode::OK,
+    };
+    let mut r = (status, Json(out)).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+fn apply(e: &mut Entry, v: &Valid, t: i64) {
+    e.name = v.name.clone();
+    e.host = v.host.clone();
+    e.port = v.port;
+    e.kind = v.kind.clone();
+    e.population = v.population;
+    e.version = v.version.clone();
+    e.portal = v.portal.clone();
+    e.build = v.build;
+    e.description = v.description.clone();
+    e.tags = v.tags.clone();
+    e.public = v.public;
+    e.relay = v.relay;
+    e.template = v.template.clone();
+    e.region = v.region.clone();
+    e.last_seen = t;
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ReportBody {
+    host_id: String,
+    reason: String,
+}
+
+async fn report(State(state): State<Arc<AppState>>, headers: HeaderMap, body: Bytes) -> Result<Response, AppError> {
+    let d = dir(&state);
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !d.limiter.allow(&format!("report:ip:{ip}"), 20, 3600) {
+        return Ok(json_err(StatusCode::TOO_MANY_REQUESTS, "too many reports"));
+    }
+    let Some(user) = super::caller(&state, &headers).await? else {
+        return Ok(json_err(StatusCode::UNAUTHORIZED, "sign in to report a realm"));
+    };
+    if !d.limiter.allow(&format!("report:user:{}", user.id), 5, 3600) {
+        return Ok(json_err(StatusCode::TOO_MANY_REQUESTS, "at most 5 reports per hour"));
+    }
+    if body.len() > MAX_BODY {
+        return Ok(json_err(StatusCode::PAYLOAD_TOO_LARGE, "at most 4 KB"));
+    }
+    let b: ReportBody = match serde_json::from_slice(&body) {
+        Ok(b) => b,
+        Err(e) => return Ok(json_err(StatusCode::BAD_REQUEST, format!("bad report: {e}"))),
+    };
+    let reason: String = b
+        .reason
+        .chars()
+        .map(|c| if c.is_control() { ' ' } else { c })
+        .collect::<String>()
+        .trim()
+        .to_string();
+    if reason.is_empty() || reason.chars().count() > 500 {
+        return Ok(json_err(StatusCode::BAD_REQUEST, "reason: 1–500 characters"));
+    }
+    let Some(e) = (super::valid_host_id(&b.host_id))
+        .then(|| d.known(&b.host_id))
+        .flatten()
+    else {
+        return Ok(json_err(StatusCode::NOT_FOUND, "no such realm"));
+    };
+    let where_ = if e.relay {
+        "via relay".to_string()
+    } else {
+        format!("{}:{}", e.host, e.port)
+    };
+    let text = format!(
+        "**Realm report** — `{}` \"{}\" ({where_}, {}, {})\nreported by `{}` (#{}): {}",
+        e.host_id,
+        e.name.replace('`', "'"),
+        if e.public { "public" } else { "private" },
+        e.template,
+        user.username,
+        user.id,
+        reason.replace('`', "'"),
+    );
+    tracing::warn!(host_id = %e.host_id, reporter = user.id, %reason, "directory report");
+    crate::audit::log(&state.db, Some(user.id), Some(&ip), "directory.report", Some(&e.host_id), Some(&reason)).await;
+    if let Some(hook) = d.cfg.report_webhook.clone() {
+        let http = d.http.clone();
+        tokio::spawn(async move {
+            let body = serde_json::json!({
+                "username": "Open Vanilla Herald",
+                "content": text.chars().take(1900).collect::<String>(),
+                "allowed_mentions": { "parse": [] },
+            });
+            match http.post(&hook).header("content-type", "application/json").body(body.to_string()).send().await {
+                Ok(r) if r.status().is_success() => {}
+                Ok(r) => tracing::warn!(status = %r.status(), "report webhook refused"),
+                Err(e) => tracing::warn!(error = %e, "report webhook failed"),
+            }
+        });
+    }
+    Ok((StatusCode::ACCEPTED, Json(serde_json::json!({ "ok": true }))).into_response())
+}
+
+async fn admin_list(session: Session, State(state): State<Arc<AppState>>) -> Response {
+    let _ = session;
+    let d = dir(&state);
+    let t = now();
+    let staff = lock(&d.staff);
+    let g = lock(&d.inner);
+    let mut entries: Vec<serde_json::Value> = g
+        .entries
+        .values()
+        .map(|e| {
+            let mut v = d.public_json(e, staff.verified.contains(&e.host_id));
+            v["public"] = e.public.into();
+            v["listed"] = (e.listable(t) && !staff.blocked.contains(&e.host_id)).into();
+            v["probe"] = serde_json::to_value(&e.probe).unwrap_or_default();
+            v["claimed_host"] = e.host.clone().into();
+            v["created_at"] = e.created_at.into();
+            v
+        })
+        .collect();
+    entries.sort_by_key(|v| v["name"].as_str().unwrap_or("").to_string());
+    let blocked: Vec<&String> = staff.blocked.iter().collect();
+    let verified: Vec<&String> = staff.verified.iter().collect();
+    let mut r = Json(serde_json::json!({ "entries": entries, "blocked": blocked, "verified": verified })).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StaffBody {
+    /// A host id, or (delist only) a host name / IP.
+    target: String,
+    /// `true` (default) applies, `false` lifts.
+    #[serde(default = "yes")]
+    on: bool,
+}
+fn yes() -> bool {
+    true
+}
+
+async fn admin_delist(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<StaffBody>,
+) -> Result<Response, AppError> {
+    super::check_csrf(&session, &headers)?;
+    let d = dir(&state);
+    let target = b.target.trim().to_ascii_lowercase();
+    if target.is_empty() || target.len() > 253 {
+        return Err(AppError::BadRequest("target: a host id or host".into()));
+    }
+    let also_host = d.known(&target).filter(|e| !e.relay).map(|e| e.host);
+    {
+        let mut s = lock(&d.staff);
+        for t in std::iter::once(target.clone()).chain(also_host.clone()) {
+            if b.on {
+                s.blocked.insert(t);
+            } else {
+                s.blocked.remove(&t);
+            }
+        }
+    }
+    d.save_staff()?;
+    let action = if b.on { "directory.delist" } else { "directory.relist" };
+    crate::audit::log(&state.db, Some(session.user.id), None, action, Some(&target), also_host.as_deref()).await;
+    Ok(Json(serde_json::json!({ "ok": true, "target": target, "host": also_host, "delisted": b.on })).into_response())
+}
+
+async fn admin_verify(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<StaffBody>,
+) -> Result<Response, AppError> {
+    super::check_csrf(&session, &headers)?;
+    let d = dir(&state);
+    let target = b.target.trim().to_string();
+    if !super::valid_host_id(&target) {
+        return Err(AppError::BadRequest("target: a host id".into()));
+    }
+    {
+        let mut s = lock(&d.staff);
+        if b.on {
+            s.verified.insert(target.clone());
+        } else {
+            s.verified.remove(&target);
+        }
+    }
+    d.save_staff()?;
+    let action = if b.on { "directory.verify" } else { "directory.unverify" };
+    crate::audit::log(&state.db, Some(session.user.id), None, action, Some(&target), None).await;
+    Ok(Json(serde_json::json!({ "ok": true, "target": target, "verified": b.on })).into_response())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn d(private: bool) -> Directory {
+        let dir = tempfile::tempdir().unwrap();
+        let mut c = P2pConfig::off(dir.path());
+        c.allow_private = private;
+        Directory::new(c).unwrap()
+    }
+
+    fn hb(json: serde_json::Value) -> Heartbeat {
+        serde_json::from_value(json).unwrap()
+    }
+
+    #[test]
+    fn hosts() {
+        assert!(valid_host("realm.example.org", false).is_ok());
+        assert!(valid_host("95.216.1.2", false).is_ok());
+        for bad in ["localhost", "box.local", "nas.lan", "10.0.0.5", "192.168.0.2", "100.64.0.1", "intranet", "a..b", "-x.com", "1.2.3"] {
+            assert!(valid_host(bad, false).is_err(), "{bad}");
+        }
+        assert!(valid_host("127.0.0.1", true).is_ok());
+    }
+
+    #[test]
+    fn validation() {
+        let dd = d(false);
+        let ok = dd
+            .validate(hb(serde_json::json!({"name":"Stormwind Nights","host":"realm.example.org","port":3724,"type":"rp","population":12,"version":"1.14.2","tags":["EU"],"visibility":"private","template":"vanilla"})))
+            .unwrap();
+        assert!(!ok.public);
+        assert_eq!(ok.region, "us");
+        assert_eq!(ok.build, 5875);
+        let relay = dd
+            .validate(hb(serde_json::json!({"name":"Behind NAT","relay":true,"type":"pve","population":0,"version":"1"})))
+            .unwrap();
+        assert_eq!((relay.host.as_str(), relay.port), ("", 3724));
+        for bad in [
+            serde_json::json!({"name":"ab","host":"realm.example.org","port":3724,"type":"rp","population":1,"version":"1"}),
+            serde_json::json!({"name":"Fine","host":"localhost","port":3724,"type":"rp","population":1,"version":"1"}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"rp","population":1,"version":"1","tags":["official"]}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"zz","population":1,"version":"1"}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"rp","population":9000,"version":"1"}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"rp","population":1,"version":"1","region":"eu"}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"rp","population":1,"version":"1","portal":"http://realm.example.org/"}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","port":3724,"type":"rp","population":1,"version":"1","build":12340}),
+            serde_json::json!({"name":"Fine","host":"realm.example.org","type":"rp","population":1,"version":"1"}),
+        ] {
+            assert!(dd.validate(hb(bad.clone())).is_err(), "{bad}");
+        }
+        // Unknown fields are refused at parse time.
+        assert!(serde_json::from_value::<Heartbeat>(serde_json::json!({"name":"Fine","host":"a.org","port":1,"type":"rp","population":1,"version":"1","official":true})).is_err());
+    }
+
+    #[test]
+    fn listing_rules() {
+        let dd = d(true);
+        let t = now();
+        let mut e = Entry {
+            host_id: "aaaaaaaaaaaaaaaa".into(), token_hash: String::new(), name: "N".into(),
+            host: "1.1.1.1".into(), port: 3724, kind: "pvp".into(), population: 3, version: "1".into(),
+            portal: None, build: 5875, description: String::new(), tags: vec![], public: true,
+            relay: false, template: "classicplus".into(), region: "us".into(), created_at: t,
+            last_seen: t, probe: ProbeState::default(),
+        };
+        assert!(!e.listable(t), "unprobed");
+        e.probe.ok_at = Some(t);
+        assert!(e.listable(t));
+        assert!(!e.listable(t + LIST_TTL + 1), "stale heartbeat");
+        e.public = false;
+        assert!(!e.listable(t));
+        e.public = true;
+        lock(&dd.inner).entries.insert(e.host_id.clone(), e);
+        assert_eq!(dd.public_list()["servers"].as_array().unwrap().len(), 1);
+        lock(&dd.staff).blocked.insert("aaaaaaaaaaaaaaaa".into());
+        assert_eq!(dd.public_list()["servers"].as_array().unwrap().len(), 0);
+    }
+}
