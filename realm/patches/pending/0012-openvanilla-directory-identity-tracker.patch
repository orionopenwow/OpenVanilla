+#[tokio::test]
+async fn tracker_only_tracks_allowed_hashes() {
+    let h = harness(|c| c.tracker_enabled = true).await;
+    let ih = [0x5au8; 20];
+    std::fs::write(h.state.cfg.state_dir.join("torrents.allow"), hex::encode(ih)).unwrap();
+    let enc = |b: &[u8]| b.iter().map(|c| format!("%{c:02X}")).collect::<String>();
+    let uri = |hash: &[u8]| format!("/announce?info_hash={}&peer_id={}&port=6881&uploaded=0&downloaded=0&left=0&compact=1", enc(hash), enc(&[7u8; 20]));
+    let r = h.req("GET", &uri(&[1u8; 20]), &[], None).await;
+    assert_eq!(r.status, StatusCode::OK);
+    assert!(String::from_utf8_lossy(&r.body).starts_with("d14:failure reason"));
+    let r = h.req("GET", &uri(&ih), &[], None).await;
+    let s = String::from_utf8_lossy(&r.body).to_string();
+    assert!(s.contains("8:intervali1800e") && s.contains("8:completei1e"), "{s}");
+}
