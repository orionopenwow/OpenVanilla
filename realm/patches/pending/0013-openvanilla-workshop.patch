+//! Open Vanilla Workshop: ratings (one per account per addon), reviews, install counts, collections,
+//! the upload queue (zip only, 10 MB, moderators approve after the offline scan) and CORS.
+
+use std::sync::Arc;
+
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use http_body_util::BodyExt;
+use tower::ServiceExt;
+use wenilla_realm::{
+    db, mangos_conf, ratelimit, realmdb, secrets, session, soap, AppState, Config,
+};
+
+struct NoBuilder;
+
+#[async_trait::async_trait]
+impl wenilla_realm::presets::Provisioner for NoBuilder {
+    async fn build(
+        &self,
+        _: wenilla_realm::presets::Job,
+    ) -> anyhow::Result<wenilla_realm::presets::headless::Built> {
+        anyhow::bail!("not in this test")
+    }
+    async fn inspect(
+        &self,
+        _: &wenilla_realm::presets::Job,
+    ) -> anyhow::Result<wenilla_realm::presets::headless::Inspection> {
+        anyhow::bail!("not in this test")
+    }
+}
+
+struct H {
+    app: axum::Router,
+    state: Arc<AppState>,
+    _dir: tempfile::TempDir,
+}
+
+async fn harness() -> H {
+    let dir = tempfile::tempdir().unwrap();
+    let state_dir = dir.path().join("state");
+    let www = dir.path().join("www");
+    std::fs::create_dir_all(&state_dir).unwrap();
+    std::fs::create_dir_all(&www).unwrap();
+    std::env::set_var("REALM_PUBLIC_URL", "http://localhost:8090");
+    std::env::set_var("REALM_COOKIE_INSECURE", "1");
+    let mut cfg = Config::from_env().unwrap();
+    cfg.state_dir = state_dir.clone();
+    cfg.www = www.clone();
+    cfg.config_dir = dir.path().to_path_buf();
+    cfg.mariadb_url = "mysql://nobody:nothing@127.0.0.1:1/classicrealmd".into();
+    let sqlite = db::open_sqlite(&cfg.sqlite_path()).await.unwrap();
+    db::meta_set(&sqlite, "setup_complete", "1").await.unwrap();
+    let state = Arc::new(AppState {
+        p2p: wenilla_realm::p2p::P2p::disabled(),
+        setup_cache: Default::default(),
+        realmdb: realmdb::connect(&cfg.mariadb_url).await.unwrap(),
+        soap: soap::Client::new("http://127.0.0.1:1/", "A", "A"),
+        conf: mangos_conf::ConfFiles::in_dir(dir.path()),
+        secrets: secrets::Keyring::load_or_create(&state_dir).unwrap(),
+        providers: Vec::new(),
+        limiter: ratelimit::Limiter::default(),
+        provisioner: Arc::new(NoBuilder),
+        client_data_error: Some("test".into()),
+        db: sqlite,
+        cfg: cfg.clone(),
+    });
+    let app = wenilla_realm::app(Arc::clone(&state), None, &www);
+    H {
+        app,
+        state,
+        _dir: dir,
+    }
+}
+
+/// A player row and a live session cookie for it.
+async fn user(h: &H, name: &str, role: &str) -> String {
+    let id: (i64,) = sqlx::query_as(
+        "INSERT INTO users (username, display_name, role, created_at) VALUES (?, ?, ?, 0) RETURNING id",
+    )
+    .bind(name)
+    .bind(name)
+    .bind(role)
+    .fetch_one(&h.state.db)
+    .await
+    .unwrap();
+    let token = session::create(&h.state.db, id.0, None, None)
+        .await
+        .unwrap();
+    format!("{}={token}", session::COOKIE)
+}
+
+async fn call(h: &H, req: Request<Body>) -> (StatusCode, serde_json::Value) {
+    let resp = h.app.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let bytes = resp.into_body().collect().await.unwrap().to_bytes();
+    let v = serde_json::from_slice(&bytes).unwrap_or(serde_json::Value::String(
+        String::from_utf8_lossy(&bytes).into_owned(),
+    ));
+    (status, v)
+}
+
+fn req(
+    method: &str,
+    path: &str,
+    cookie: Option<&str>,
+    csrf: Option<&str>,
+    body: Option<serde_json::Value>,
+) -> Request<Body> {
+    let mut b = Request::builder()
+        .method(method)
+        .uri(path)
+        .header(header::ACCEPT, "application/json");
+    if let Some(c) = cookie {
+        b = b.header(header::COOKIE, c);
+    }
+    if let Some(t) = csrf {
+        b = b.header("x-csrf-token", t);
+    }
+    match body {
+        Some(v) => b
+            .header(header::CONTENT_TYPE, "application/json")
+            .body(Body::from(v.to_string()))
+            .unwrap(),
+        None => b.body(Body::empty()).unwrap(),
+    }
+}
+
+async fn csrf_of(h: &H, cookie: &str) -> serde_json::Value {
+    let (s, me) = call(h, req("GET", "/api/workshop/me", Some(cookie), None, None)).await;
+    assert_eq!(s, StatusCode::OK, "{me}");
+    me
+}
+
+fn upload(cookie: &str, csrf: &str, query: &str, bytes: Vec<u8>) -> Request<Body> {
+    Request::post(format!("/api/workshop/upload?{query}"))
+        .header(header::COOKIE, cookie)
+        .header("x-csrf-token", csrf)
+        .header(header::CONTENT_TYPE, "application/zip")
+        .body(Body::from(bytes))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn ratings_reviews_installs_and_collections() {
+    let h = harness().await;
+
+    // Signed out: reading works, writing does not.
+    let (s, r) = call(
+        &h,
+        req("GET", "/api/workshop/reviews/pfui", None, None, None),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    assert_eq!(r["votes"], 0);
+    let (s, _) = call(
+        &h,
+        req("GET", "/api/workshop/reviews/..%2Fetc", None, None, None),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            None,
+            None,
+            Some(serde_json::json!({"addon": "pfui", "stars": 5})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+    let (s, _) = call(&h, req("GET", "/api/workshop/me", None, None, None)).await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+
+    let alice = user(&h, "alice", "player").await;
+    let me = csrf_of(&h, &alice).await;
+    let csrf = me["csrf"].as_str().unwrap().to_string();
+    assert_eq!(me["moderator"], false);
+
+    // CSRF and validation.
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            Some(&alice),
+            Some("nope"),
+            Some(serde_json::json!({"addon": "pfui", "stars": 5})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            Some(&alice),
+            Some(&csrf),
+            Some(serde_json::json!({"addon": "pfui", "stars": 6})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            Some(&alice),
+            Some(&csrf),
+            Some(serde_json::json!({"addon": "Bad Id", "stars": 3})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+
+    // One rating per account per addon: rating again edits it.
+    let (s, r) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            Some(&alice),
+            Some(&csrf),
+            Some(serde_json::json!({"addon": "pfui", "stars": 3, "review": "Fine."})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    let (s, r) = call(&h, req("POST", "/api/workshop/rate", Some(&alice), Some(&csrf), Some(serde_json::json!({"addon": "pfui", "stars": 5, "review": "Great once set up.\u{7}"})))).await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    assert_eq!(r["votes"], 1);
+    assert_eq!(r["rating"], 5.0);
+
+    let bob = user(&h, "bob", "player").await;
+    let bcsrf = csrf_of(&h, &bob).await["csrf"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/rate",
+            Some(&bob),
+            Some(&bcsrf),
+            Some(serde_json::json!({"addon": "pfui", "stars": 2})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/reviews/pfui", None, None, None),
+    )
+    .await;
+    assert_eq!(r["votes"], 2);
+    assert_eq!(r["rating"], 3.5);
+    assert_eq!(r["histogram"], serde_json::json!([0, 1, 0, 0, 1]));
+    let reviews = r["reviews"].as_array().unwrap();
+    assert_eq!(
+        reviews.len(),
+        1,
+        "a rating without words is not a review: {r}"
+    );
+    assert_eq!(reviews[0]["user"], "alice");
+    assert_eq!(reviews[0]["text"], "Great once set up.");
+    let alice_id = reviews[0]["user_id"].as_i64().unwrap();
+    assert_eq!(csrf_of(&h, &alice).await["ratings"]["pfui"], 5);
+
+    // Installs: one per address per addon per day.
+    let inst = |ip: &str| {
+        Request::post("/api/workshop/installs/pfui")
+            .header("x-real-ip", ip)
+            .body(Body::empty())
+            .unwrap()
+    };
+    call(&h, inst("10.0.0.1")).await;
+    call(&h, inst("10.0.0.1")).await;
+    let (s, r) = call(&h, inst("10.0.0.2")).await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(r["installs"], 2);
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/installs/pfui", None, None, None),
+    )
+    .await;
+    assert_eq!(r["installs"], 2);
+
+    let (s, r) = call(&h, req("GET", "/api/workshop/stats", None, None, None)).await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(r["addons"]["pfui"]["installs"], 2);
+    assert_eq!(r["addons"]["pfui"]["votes"], 2);
+
+    // Moderators hide the words (the stars still count); players cannot.
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/review/hide",
+            Some(&bob),
+            Some(&bcsrf),
+            Some(serde_json::json!({"addon": "pfui", "user": alice_id})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+    let admin = user(&h, "mod", "admin").await;
+    let acsrf = csrf_of(&h, &admin).await;
+    assert_eq!(acsrf["moderator"], true);
+    let acsrf = acsrf["csrf"].as_str().unwrap().to_string();
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/review/hide",
+            Some(&admin),
+            Some(&acsrf),
+            Some(serde_json::json!({"addon": "pfui", "user": alice_id})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/reviews/pfui", None, None, None),
+    )
+    .await;
+    assert_eq!(r["reviews"][0]["hidden"], true);
+    assert_eq!(r["reviews"][0]["text"], "");
+    assert_eq!(r["votes"], 2);
+
+    // Unrate.
+    let (s, r) = call(
+        &h,
+        req(
+            "DELETE",
+            "/api/workshop/rate?addon=pfui",
+            Some(&bob),
+            Some(&bcsrf),
+            None,
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(r["votes"], 1);
+
+    // Collections: create, edit own, not someone else's; public read.
+    let (s, r) = call(&h, req("POST", "/api/workshop/my/collections", Some(&alice), Some(&csrf), Some(serde_json::json!({"name": "My raid kit", "addons": ["bigwigs", "cp-raid", "bigwigs"]})))).await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    let n = r["n"].as_i64().unwrap();
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/my/collections",
+            Some(&alice),
+            Some(&csrf),
+            Some(serde_json::json!({"name": "x", "addons": ["pfui"]})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            "/api/workshop/my/collections",
+            Some(&bob),
+            Some(&bcsrf),
+            Some(serde_json::json!({"id": n, "name": "Stolen", "addons": ["pfui"]})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::NOT_FOUND);
+    let (s, r) = call(
+        &h,
+        req(
+            "GET",
+            &format!("/api/workshop/collections/u{n}"),
+            None,
+            None,
+            None,
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(r["name"], "My raid kit");
+    assert_eq!(r["curator"], "alice");
+    assert_eq!(r["addons"], serde_json::json!(["bigwigs", "cp-raid"]));
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/collections", None, None, None),
+    )
+    .await;
+    assert_eq!(r["collections"].as_array().unwrap().len(), 1);
+    let (s, _) = call(
+        &h,
+        req(
+            "DELETE",
+            &format!("/api/workshop/my/collections?id={n}"),
+            Some(&alice),
+            Some(&csrf),
+            None,
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/collections", None, None, None),
+    )
+    .await;
+    assert_eq!(r["collections"].as_array().unwrap().len(), 0);
+
+    // CORS: the site's origin gets credentials, others get nothing.
+    let pre = Request::builder()
+        .method("OPTIONS")
+        .uri("/api/workshop/rate")
+        .header(header::ORIGIN, "https://openvanilla.app")
+        .header("access-control-request-method", "POST")
+        .body(Body::empty())
+        .unwrap();
+    let resp = h.app.clone().oneshot(pre).await.unwrap();
+    assert!(resp.status().is_success(), "{}", resp.status());
+    assert_eq!(
+        resp.headers()["access-control-allow-origin"],
+        "https://openvanilla.app"
+    );
+    assert_eq!(resp.headers()["access-control-allow-credentials"], "true");
+    let evil = Request::get("/api/workshop/stats")
+        .header(header::ORIGIN, "https://evil.example")
+        .body(Body::empty())
+        .unwrap();
+    let resp = h.app.clone().oneshot(evil).await.unwrap();
+    assert!(resp.headers().get("access-control-allow-origin").is_none());
+
+    // A cross-site write is refused before it reaches the handler.
+    let cross = Request::post("/api/workshop/rate")
+        .header(header::COOKIE, &alice)
+        .header("x-csrf-token", &csrf)
+        .header("sec-fetch-site", "cross-site")
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(
+            serde_json::json!({"addon": "pfui", "stars": 1}).to_string(),
+        ))
+        .unwrap();
+    let (s, _) = call(&h, cross).await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+}
