new file mode 100644
index 00000000..16ec1071
--- /dev/null
+++ b/crates/wenilla-realm/migrations/0013_workshop.sql
@@ -0,0 +1,55 @@
+-- Open Vanilla Workshop: ratings and reviews, install counts, player collections and the upload queue
+-- (www/workshop.html and the launcher's Workshop tab; tools/workshop_scan.py --queue scans uploads
+-- offline). Addon ids are the catalogue's (workshop/catalog/<id>.yml): ^[a-z0-9][a-z0-9-]{1,47}$.
+-- Numbered after the patch (0013) so it cannot collide with the migrations other patches add.
+CREATE TABLE workshop_ratings (
+    id INTEGER PRIMARY KEY,
+    addon_id TEXT NOT NULL,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    stars INTEGER NOT NULL CHECK (stars BETWEEN 1 AND 5),
+    review TEXT NOT NULL DEFAULT '',      -- '' = a rating without words
+    hidden INTEGER NOT NULL DEFAULT 0,    -- a moderator hid the words (the stars still count)
+    created_at INTEGER NOT NULL,
+    updated_at INTEGER NOT NULL,
+    UNIQUE (addon_id, user_id)            -- one rating per account per addon (re-rating edits it)
+);
+CREATE INDEX workshop_ratings_addon ON workshop_ratings(addon_id, updated_at);
+
+-- One row per addon, per installer, per day: the count is the number of rows. `who` is a hash of
+-- the address (never the address itself).
+CREATE TABLE workshop_installs (
+    addon_id TEXT NOT NULL,
+    who TEXT NOT NULL,
+    day INTEGER NOT NULL,
+    PRIMARY KEY (addon_id, who, day)
+);
+
+CREATE TABLE workshop_collections (
+    id INTEGER PRIMARY KEY,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    name TEXT NOT NULL,
+    summary TEXT NOT NULL DEFAULT '',
+    addons TEXT NOT NULL,                 -- JSON array of addon ids
+    created_at INTEGER NOT NULL,
+    updated_at INTEGER NOT NULL
+);
+CREATE INDEX workshop_collections_user ON workshop_collections(user_id);
+
+-- Uploads wait here (zip at <state>/workshop/queue/<id>.zip) until tools/workshop_scan.py has
+-- written <id>.scan.json beside the zip and a moderator approved or rejected them.
+CREATE TABLE workshop_uploads (
+    id INTEGER PRIMARY KEY,
+    user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
+    name TEXT NOT NULL,
+    summary TEXT NOT NULL DEFAULT '',
+    license TEXT NOT NULL DEFAULT '',
+    source_url TEXT NOT NULL DEFAULT '',
+    size INTEGER NOT NULL,
+    sha256 TEXT NOT NULL,
+    status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'approved', 'rejected')),
+    moderator TEXT NOT NULL DEFAULT '',
+    note TEXT NOT NULL DEFAULT '',
+    created_at INTEGER NOT NULL,
+    acted_at INTEGER
+);
+CREATE INDEX workshop_uploads_status ON workshop_uploads(status, created_at);
