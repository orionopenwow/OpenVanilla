+#[tokio::test]
+async fn uploads_wait_for_the_scan_and_a_moderator() {
+    let h = harness().await;
+    let alice = user(&h, "uploader", "player").await;
+    let csrf = csrf_of(&h, &alice).await["csrf"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    let zip = b"PK\x03\x04 pretend zip".to_vec();
+
+    let (s, _) = call(
+        &h,
+        upload(&alice, &csrf, "name=My%20Addon", b"MZ not a zip".to_vec()),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let (s, _) = call(&h, upload(&alice, &csrf, "name=", zip.clone())).await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let mut big = b"PK\x03\x04".to_vec();
+    big.resize(wenilla_realm::workshop::MAX_UPLOAD + 1, 0);
+    let (s, _) = call(&h, upload(&alice, &csrf, "name=Big", big)).await;
+    assert_eq!(s, StatusCode::PAYLOAD_TOO_LARGE);
+    let (s, r) = call(
+        &h,
+        upload(
+            &alice,
+            &csrf,
+            "name=My%20Addon&license=MIT&source=https://github.com/a/b",
+            zip.clone(),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    let n = r["upload"].as_i64().unwrap();
+    let queue = h.state.cfg.state_dir.join("workshop").join("queue");
+    assert_eq!(std::fs::read(queue.join(format!("{n}.zip"))).unwrap(), zip);
+
+    // Players cannot see or act on the queue.
+    let (s, _) = call(
+        &h,
+        req("GET", "/api/workshop/queue", Some(&alice), None, None),
+    )
+    .await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+
+    let admin = user(&h, "boss", "admin").await;
+    let acsrf = csrf_of(&h, &admin).await["csrf"]
+        .as_str()
+        .unwrap()
+        .to_string();
+    let path = format!("/api/workshop/queue/{n}");
+    // Not scanned yet: approving waits for tools/workshop_scan.py --queue.
+    let (s, _) = call(
+        &h,
+        req(
+            "POST",
+            &path,
+            Some(&admin),
+            Some(&acsrf),
+            Some(serde_json::json!({"action": "approve"})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::CONFLICT);
+    std::fs::write(
+        queue.join(format!("{n}.scan.json")),
+        r#"{"compat":"works","findings":[],"held":false}"#,
+    )
+    .unwrap();
+    let (s, r) = call(
+        &h,
+        req("GET", "/api/workshop/queue", Some(&admin), None, None),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+    assert_eq!(r["uploads"][0]["status"], "pending");
+    assert_eq!(r["uploads"][0]["scan"]["compat"], "works");
+    assert_eq!(r["uploads"][0]["license"], "MIT");
+    let (s, r) = call(
+        &h,
+        req(
+            "POST",
+            &path,
+            Some(&admin),
+            Some(&acsrf),
+            Some(serde_json::json!({"action": "approve", "note": "ok"})),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    let (_, r) = call(
+        &h,
+        req("GET", "/api/workshop/queue", Some(&admin), None, None),
+    )
+    .await;
+    assert_eq!(r["uploads"][0]["status"], "approved");
+    assert_eq!(r["uploads"][0]["moderator"], "boss");
+}
