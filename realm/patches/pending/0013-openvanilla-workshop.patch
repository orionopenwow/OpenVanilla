+        return Err(AppError::Forbidden("moderators only"));
+    }
+    let r =
+        sqlx::query("UPDATE workshop_ratings SET hidden = ? WHERE addon_id = ? AND user_id = ?")
+            .bind(b.hidden)
+            .bind(&b.addon)
+            .bind(b.user)
+            .execute(&state.db)
+            .await?;
+    if r.rows_affected() == 0 {
+        return Err(AppError::NotFound);
+    }
+    Ok(json(serde_json::json!({ "ok": true, "hidden": b.hidden })))
+}
