+//! Open Vanilla armory uploads through the router: a host claims a directory entry (probed against a
+//! fake realmd), then posts its exported realm as a signed stored zip; the claim, the signature,
+//! the pinned key, the rate, the file rules and the folder swap are checked.
+
+use std::sync::Arc;
+
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use ed25519_dalek::{Signer, SigningKey};
+use http_body_util::BodyExt;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tower::ServiceExt;
+use wenilla_realm::armory::stored_zip;
+use wenilla_realm::p2p::{P2p, P2pConfig};
+use wenilla_realm::{db, mangos_conf, ratelimit, realmdb, secrets, soap, AppState, Config};
+
+struct NoBuilder;
+#[async_trait::async_trait]
+impl wenilla_realm::presets::Provisioner for NoBuilder {
+    async fn build(&self, _: wenilla_realm::presets::Job) -> anyhow::Result<wenilla_realm::presets::headless::Built> {
+        anyhow::bail!("unused")
+    }
+    async fn inspect(&self, _: &wenilla_realm::presets::Job) -> anyhow::Result<wenilla_realm::presets::headless::Inspection> {
+        anyhow::bail!("unused")
+    }
+}
+
+struct H {
+    app: axum::Router,
+    state_dir: std::path::PathBuf,
+    _dir: tempfile::TempDir,
+}
+
+async fn harness(upload_on: bool, directory_on: bool) -> H {
+    let dir = tempfile::tempdir().unwrap();
+    let state_dir = dir.path().join("state");
+    let www = dir.path().join("www");
+    std::fs::create_dir_all(&state_dir).unwrap();
+    std::fs::create_dir_all(&www).unwrap();
+    std::env::set_var("REALM_PUBLIC_URL", "http://localhost:8090");
+    if upload_on {
+        std::env::set_var("ARMORY_UPLOAD_ENABLED", "1");
+    } else {
+        std::env::remove_var("ARMORY_UPLOAD_ENABLED");
+    }
+    let mut cfg = Config::from_env().unwrap();
+    cfg.state_dir = state_dir.clone();
+    cfg.www = www.clone();
+    cfg.config_dir = dir.path().join("config");
+    cfg.mariadb_url = "mysql://nobody:nothing@127.0.0.1:1/classicrealmd".into();
+    let sqlite = db::open_sqlite(&cfg.sqlite_path()).await.unwrap();
+    db::meta_set(&sqlite, "setup_complete", "1").await.unwrap();
+    let mut pc = P2pConfig::off(&state_dir);
+    pc.directory_enabled = directory_on;
+    pc.allow_private = true;
+    pc.probe_timeout = std::time::Duration::from_secs(2);
+    let state = Arc::new(AppState {
+        p2p: P2p::from_config(&pc).unwrap(),
+        setup_cache: Default::default(),
+        realmdb: realmdb::connect(&cfg.mariadb_url).await.unwrap(),
+        soap: soap::Client::new("http://127.0.0.1:1/", "A", "A"),
+        conf: mangos_conf::ConfFiles::in_dir(&cfg.config_dir),
+        secrets: secrets::Keyring::load_or_create(&state_dir).unwrap(),
+        providers: Vec::new(),
+        limiter: ratelimit::Limiter::default(),
+        provisioner: Arc::new(NoBuilder),
+        client_data_error: Some("test".into()),
+        db: sqlite,
+        cfg: cfg.clone(),
+    });
+    H { app: wenilla_realm::app(Arc::clone(&state), None, &www), state_dir, _dir: dir }
+}
+
+impl H {
+    async fn req(&self, method: &str, uri: &str, hdrs: &[(&str, &str)], body: Vec<u8>, ctype: &str) -> (StatusCode, serde_json::Value) {
+        let mut b = Request::builder().method(method).uri(uri).header("x-forwarded-for", "203.0.113.9").header(header::CONTENT_TYPE, ctype);
+        for (k, v) in hdrs {
+            b = b.header(*k, *v);
+        }
+        let r = self.app.clone().oneshot(b.body(Body::from(body)).unwrap()).await.unwrap();
+        let status = r.status();
+        let bytes = r.into_body().collect().await.unwrap().to_bytes();
+        (status, serde_json::from_slice(&bytes).unwrap_or(serde_json::Value::Null))
+    }
+}
+
+async fn fake_realmd() -> u16 {
+    let l = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let port = l.local_addr().unwrap().port();
+    tokio::spawn(async move {
+        loop {
+            let (mut s, _) = l.accept().await.unwrap();
+            tokio::spawn(async move {
+                let mut head = [0u8; 4];
+                if s.read_exact(&mut head).await.is_err() {
+                    return;
+                }
+                let mut rest = vec![0u8; u16::from_le_bytes([head[2], head[3]]) as usize];
+                let _ = s.read_exact(&mut rest).await;
+                let _ = s.write_all(&[0x00, 0x00, 0x04]).await;
+            });
+        }
+    });
+    port
+}
+
+fn signed(key: &SigningKey, body: &[u8], token: &str, host_id: &str) -> Vec<(String, String)> {
+    vec![
+        ("authorization".into(), format!("Bearer {token}")),
+        ("x-openvanilla-host-id".into(), host_id.into()),
+        ("x-openvanilla-host-key".into(), hex::encode(key.verifying_key().to_bytes())),
+        ("x-openvanilla-signature".into(), hex::encode(key.sign(body).to_bytes())),
+    ]
+}
+
+fn refs(v: &[(String, String)]) -> Vec<(&str, &str)> {
+    v.iter().map(|(a, b)| (a.as_str(), b.as_str())).collect()
+}
+
+// One test: the switch is an environment variable, read when the router is built.
+#[tokio::test]
+async fn community_armory_uploads() {
+    // off by default: not mounted (the unmatched path falls through to the session gate)
+    let h = harness(false, true).await;
+    let (s, _) = h.req("POST", "/api/armory/upload", &[], b"x".to_vec(), "application/zip").await;
+    assert!(matches!(s, StatusCode::NOT_FOUND | StatusCode::UNAUTHORIZED), "{s}");
+
+    // on, but the directory is off: 503
+    let h = harness(true, false).await;
+    let (s, _) = h.req("POST", "/api/armory/upload", &[], b"x".to_vec(), "application/zip").await;
+    assert_eq!(s, StatusCode::SERVICE_UNAVAILABLE);
+
+    let h = harness(true, true).await;
+    let port = fake_realmd().await;
+    let beat = serde_json::json!({ "name": "Night Harbor", "host": "127.0.0.1", "port": port, "type": "pve",
+        "population": 1, "version": "1.0", "tags": [] });
+    let (s, j) = h.req("POST", "/api/directory/heartbeat", &[], beat.to_string().into_bytes(), "application/json").await;
+    assert_eq!(s, StatusCode::CREATED, "{j}");
+    let token = j["token"].as_str().unwrap().to_string();
+    let host_id = j["host_id"].as_str().unwrap().to_string();
+
+    let key = SigningKey::from_bytes(&[9u8; 32]);
+    let index = br#"{"schema":1,"realm":"x","name":"Night Harbor","characters":[],"guilds":[]}"#;
+    let body = stored_zip(&[("index.json", index), ("zed.json", b"{\"schema\":1}"), ("guilds/watch.json", b"{}")]);
+
+    // no claim / wrong token
+    let mut hd = signed(&key, &body, "nope", &host_id);
+    let (s, _) = h.req("POST", "/api/armory/upload", &refs(&hd), body.clone(), "application/zip").await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+    // a signature over something else
+    hd = signed(&key, b"other bytes", &token, &host_id);
+    let (s, j) = h.req("POST", "/api/armory/upload", &refs(&hd), body.clone(), "application/zip").await;
+    assert_eq!(s, StatusCode::FORBIDDEN, "{j}");
+    assert_eq!(j["error"], "bad signature");
+    // a bad file is refused whole (and does not use up the rate)
+    let evil = stored_zip(&[("index.json", index), ("../../etc/x.json", b"{}")]);
+    hd = signed(&key, &evil, &token, &host_id);
+    let (s, j) = h.req("POST", "/api/armory/upload", &refs(&hd), evil, "application/zip").await;
+    assert_eq!(s, StatusCode::BAD_REQUEST, "{j}");
+    assert!(!h.state_dir.join("armory-uploads").join(&host_id).exists());
+
+    // the good one
+    hd = signed(&key, &body, &token, &host_id);
+    let (s, j) = h.req("POST", "/api/armory/upload", &refs(&hd), body.clone(), "application/zip").await;
+    assert_eq!(s, StatusCode::OK, "{j}");
+    assert_eq!(j["files"], 3);
+    let folder = h.state_dir.join("armory-uploads").join(&host_id);
+    assert_eq!(std::fs::read(folder.join("index.json")).unwrap(), index.to_vec());
+    assert!(folder.join("guilds").join("watch.json").exists());
+    let pins = std::fs::read_to_string(h.state_dir.join("armory-hosts.json")).unwrap();
+    assert!(pins.contains(&hex::encode(key.verifying_key().to_bytes())), "{pins}");
+
+    // another key for the same host id: refused (pinned)
+    let other = SigningKey::from_bytes(&[3u8; 32]);
+    hd = signed(&other, &body, &token, &host_id);
+    let (s, j) = h.req("POST", "/api/armory/upload", &refs(&hd), body.clone(), "application/zip").await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+    assert!(j["error"].as_str().unwrap().contains("another key"));
+    // the same key again within 10 minutes
+    hd = signed(&key, &body, &token, &host_id);
+    let (s, _) = h.req("POST", "/api/armory/upload", &refs(&hd), body.clone(), "application/zip").await;
+    assert_eq!(s, StatusCode::TOO_MANY_REQUESTS);
+
+    // too big for the body limit
+    let big = vec![0u8; wenilla_realm::armory::MAX_UPLOAD + 10];
+    hd = signed(&key, &big, &token, &host_id);
+    let (s, _) = h.req("POST", "/api/armory/upload", &refs(&hd), big, "application/zip").await;
+    assert_eq!(s, StatusCode::PAYLOAD_TOO_LARGE);
+}
