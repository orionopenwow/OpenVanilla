diff --git a/crates/wenilla-realm/tests/creators.rs b/crates/wenilla-realm/tests/creators.rs
new file mode 100644
index 00000000..7c2901ad
--- /dev/null
+++ b/crates/wenilla-realm/tests/creators.rs
@@ -0,0 +1,274 @@
+//! Open Vanilla creators: a signed-in player links a channel (CSRF-checked, one owner per channel,
+//! validated handles) and the fetcher's export answers only to the staff token.
+
+use std::sync::Arc;
+
+use axum::body::Body;
+use axum::http::{header, Request, StatusCode};
+use http_body_util::BodyExt;
+use tower::ServiceExt;
+use wenilla_realm::{
+    db, mangos_conf, ratelimit, realmdb, secrets, session, soap, AppState, Config,
+};
+
+struct NoBuilder;
+
+#[async_trait::async_trait]
+impl wenilla_realm::presets::Provisioner for NoBuilder {
+    async fn build(
+        &self,
+        _: wenilla_realm::presets::Job,
+    ) -> anyhow::Result<wenilla_realm::presets::headless::Built> {
+        anyhow::bail!("not in this test")
+    }
+    async fn inspect(
+        &self,
+        _: &wenilla_realm::presets::Job,
+    ) -> anyhow::Result<wenilla_realm::presets::headless::Inspection> {
+        anyhow::bail!("not in this test")
+    }
+}
+
+struct H {
+    app: axum::Router,
+    state: Arc<AppState>,
+    _dir: tempfile::TempDir,
+}
+
+async fn harness() -> H {
+    let dir = tempfile::tempdir().unwrap();
+    let state_dir = dir.path().join("state");
+    let www = dir.path().join("www");
+    std::fs::create_dir_all(&state_dir).unwrap();
+    std::fs::create_dir_all(&www).unwrap();
+    std::env::set_var("REALM_PUBLIC_URL", "http://localhost:8090");
+    std::env::set_var("REALM_COOKIE_INSECURE", "1");
+    let mut cfg = Config::from_env().unwrap();
+    cfg.state_dir = state_dir.clone();
+    cfg.www = www.clone();
+    cfg.config_dir = dir.path().to_path_buf();
+    cfg.mariadb_url = "mysql://nobody:nothing@127.0.0.1:1/classicrealmd".into();
+    let sqlite = db::open_sqlite(&cfg.sqlite_path()).await.unwrap();
+    db::meta_set(&sqlite, "setup_complete", "1").await.unwrap();
+    let state = Arc::new(AppState {
+        p2p: wenilla_realm::p2p::P2p::disabled(),
+        setup_cache: Default::default(),
+        realmdb: realmdb::connect(&cfg.mariadb_url).await.unwrap(),
+        soap: soap::Client::new("http://127.0.0.1:1/", "A", "A"),
+        conf: mangos_conf::ConfFiles::in_dir(dir.path()),
+        secrets: secrets::Keyring::load_or_create(&state_dir).unwrap(),
+        providers: Vec::new(),
+        limiter: ratelimit::Limiter::default(),
+        provisioner: Arc::new(NoBuilder),
+        client_data_error: Some("test".into()),
+        db: sqlite,
+        cfg: cfg.clone(),
+    });
+    let app = wenilla_realm::app(Arc::clone(&state), None, &www);
+    H {
+        app,
+        state,
+        _dir: dir,
+    }
+}
+
+/// A player row and a live session cookie for it.
+async fn player(h: &H, name: &str) -> String {
+    let id: (i64,) = sqlx::query_as(
+        "INSERT INTO users (username, display_name, role, created_at) VALUES (?, ?, 'player', 0) RETURNING id",
+    )
+    .bind(name)
+    .bind(name)
+    .fetch_one(&h.state.db)
+    .await
+    .unwrap();
+    let token = session::create(&h.state.db, id.0, None, None)
+        .await
+        .unwrap();
+    format!("{}={token}", session::COOKIE)
+}
+
+async fn call(h: &H, req: Request<Body>) -> (StatusCode, serde_json::Value) {
+    let resp = h.app.clone().oneshot(req).await.unwrap();
+    let status = resp.status();
+    let bytes = resp.into_body().collect().await.unwrap().to_bytes();
+    let v = serde_json::from_slice(&bytes).unwrap_or(serde_json::Value::String(
+        String::from_utf8_lossy(&bytes).into_owned(),
+    ));
+    (status, v)
+}
+
+fn get(path: &str, cookie: Option<&str>, bearer: Option<&str>) -> Request<Body> {
+    let mut b = Request::get(path).header(header::ACCEPT, "application/json");
+    if let Some(c) = cookie {
+        b = b.header(header::COOKIE, c);
+    }
+    if let Some(t) = bearer {
+        b = b.header(header::AUTHORIZATION, format!("Bearer {t}"));
+    }
+    b.body(Body::empty()).unwrap()
+}
+
+fn post(cookie: &str, csrf: &str, body: serde_json::Value) -> Request<Body> {
+    Request::post("/api/creator/link")
+        .header(header::COOKIE, cookie)
+        .header(header::CONTENT_TYPE, "application/json")
+        .header("x-csrf-token", csrf)
+        .body(Body::from(body.to_string()))
+        .unwrap()
+}
+
+#[tokio::test]
+async fn players_link_channels_and_the_fetcher_exports_them() {
+    let h = harness().await;
+    std::env::set_var("CREATOR_EXPORT_TOKEN", "export-token-for-tests-0123456789");
+
+    // Signed out: the link API is closed.
+    let (s, _) = call(&h, get("/api/creator/link", None, None)).await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+
+    let alice = player(&h, "alice").await;
+    let (s, me) = call(&h, get("/api/creator/link", Some(&alice), None)).await;
+    assert_eq!(s, StatusCode::OK, "{me}");
+    let csrf = me["csrf"].as_str().unwrap().to_string();
+    assert!(me["code"].as_str().unwrap().starts_with("OW-"));
+    assert_eq!(me["links"].as_array().unwrap().len(), 0);
+
+    // Without the CSRF header: refused.
+    let (s, _) = call(
+        &h,
+        post(
+            &alice,
+            "nope",
+            serde_json::json!({"platform": "twitch", "handle": "AlicePlays"}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::FORBIDDEN);
+    // A bad handle and an unknown platform: 400.
+    let (s, _) = call(
+        &h,
+        post(
+            &alice,
+            &csrf,
+            serde_json::json!({"platform": "twitch", "handle": "no spaces"}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+    let (s, _) = call(
+        &h,
+        post(
+            &alice,
+            &csrf,
+            serde_json::json!({"platform": "myspace", "handle": "alice"}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+
+    let (s, r) = call(
+        &h,
+        post(
+            &alice,
+            &csrf,
+            serde_json::json!({"platform": "Twitch", "handle": "AlicePlays", "show_live": true}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    let code = r["code"].as_str().unwrap().to_string();
+    let (s, r) = call(
+        &h,
+        post(
+            &alice,
+            &csrf,
+            serde_json::json!({"platform": "tiktok", "handle": "@alice.clips", "show_live": true}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    assert_eq!(r["code"], code, "one code per account");
+    let links = r["links"].as_array().unwrap();
+    assert_eq!(links.len(), 2);
+    assert_eq!(links[0]["platform"], "tiktok");
+    assert_eq!(links[0]["handle"], "alice.clips");
+    assert_eq!(links[1]["handle"], "aliceplays");
+
+    // A character that cannot be checked (no game account yet): refused, nothing stored.
+    let (s, _) = call(&h, post(&alice, &csrf, serde_json::json!({"platform": "twitch", "handle": "AlicePlays", "character": "Alicia"}))).await;
+    assert_eq!(s, StatusCode::BAD_REQUEST);
+
+    // Someone else cannot take Alice's channel.
+    let bob = player(&h, "bob").await;
+    let (_, me) = call(&h, get("/api/creator/link", Some(&bob), None)).await;
+    let bcsrf = me["csrf"].as_str().unwrap().to_string();
+    let (s, _) = call(
+        &h,
+        post(
+            &bob,
+            &bcsrf,
+            serde_json::json!({"platform": "twitch", "handle": "aliceplays"}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::CONFLICT);
+    let (s, _) = call(
+        &h,
+        post(
+            &bob,
+            &bcsrf,
+            serde_json::json!({"platform": "youtube", "handle": "@BobBuilds"}),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK);
+
+    // The export: no token / wrong token / right token.
+    let (s, _) = call(&h, get("/api/creator/links", None, None)).await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+    let (s, _) = call(&h, get("/api/creator/links", None, Some("wrong"))).await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+    // A player session is not the staff token.
+    let (s, _) = call(&h, get("/api/creator/links", Some(&alice), None)).await;
+    assert_eq!(s, StatusCode::UNAUTHORIZED);
+    let (s, rows) = call(
+        &h,
+        get(
+            "/api/creator/links",
+            None,
+            Some("export-token-for-tests-0123456789"),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::OK, "{rows}");
+    let rows = rows.as_array().unwrap();
+    assert_eq!(rows.len(), 3);
+    assert_eq!(rows[0]["display_name"], "alice");
+    assert_eq!(rows[0]["show_live"], true);
+    assert_eq!(rows[0]["code"], code);
+    assert_eq!(rows[2]["handle"], "@BobBuilds");
+
+    // Unlink.
+    let req = Request::delete("/api/creator/link?platform=tiktok")
+        .header(header::COOKIE, &alice)
+        .header("x-csrf-token", &csrf)
+        .body(Body::empty())
+        .unwrap();
+    let (s, r) = call(&h, req).await;
+    assert_eq!(s, StatusCode::OK, "{r}");
+    assert_eq!(r["links"].as_array().unwrap().len(), 1);
+
+    // Unset token: the export does not exist.
+    std::env::remove_var("CREATOR_EXPORT_TOKEN");
+    let (s, _) = call(
+        &h,
+        get(
+            "/api/creator/links",
+            None,
+            Some("export-token-for-tests-0123456789"),
+        ),
+    )
+    .await;
+    assert_eq!(s, StatusCode::NOT_FOUND);
+}
