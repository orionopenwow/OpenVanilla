+
+    fn nodes(private: bool) -> Nodes {
+        let dir = tempfile::tempdir().unwrap();
+        let mut c = P2pConfig::off(dir.path());
+        c.allow_private = private;
+        std::mem::forget(dir);
+        Nodes::new(c).unwrap()
+    }
+
+    fn key() -> (ed25519_dalek::SigningKey, String, String) {
+        let k = ed25519_dalek::SigningKey::from_bytes(&[7u8; 32]);
+        let pub_hex = hex::encode(k.verifying_key().as_bytes());
+        let id = node_id_for(k.verifying_key().as_bytes());
+        (k, pub_hex, id)
+    }
+
+    fn beat(over: serde_json::Value) -> Beat {
+        let (_, k, id) = key();
+        let mut v = serde_json::json!({
+            "node_id": id, "key": k, "url": "ws://95.216.1.2:3728", "region": "us", "version": "1",
+            "protocol": 1, "rules": 1, "e2e_required": true,
+            "caps": {"kbps": 512, "daily_gb": 10.0, "max_hosts": 2, "max_streams": 64},
+            "state": "running", "accepting": true,
+            "stats": {"relay_bytes_today": 0, "relay_bytes_total": 0, "streams_total": 0, "streams_now": 0,
+                      "hosts_now": 0, "uptime_secs": 0, "seed_bytes_total": 0},
+            "leaderboard": "named", "display_name": "  Ann  ", "carrying": [],
+        });
+        for (k, val) in over.as_object().unwrap() {
+            v[k] = val.clone();
+        }
+        serde_json::from_value(v).unwrap()
+    }
+
+    #[test]
+    fn ids_match_the_launcher() {
+        // launcher/p2p/node.py node_id_for: b32(sha256(pub)[:10]).lower()
+        assert_eq!(node_id_for(&[0u8; 32]).len(), 16);
+        assert!(super::super::valid_host_id(&node_id_for(b"x")));
+    }
+
+    #[test]
+    fn validation() {
+        let ns = nodes(false);
+        assert!(ns.validate(&beat(serde_json::json!({}))).is_ok());
+        for bad in [
+            serde_json::json!({"node_id": "aaaaaaaaaaaaaaaa"}),
+            serde_json::json!({"url": "ws://192.168.1.5:3728"}),
+            serde_json::json!({"url": "ws://95.216.1.2:3728/h/x"}),
+            serde_json::json!({"url": "http://95.216.1.2:3728"}),
+            serde_json::json!({"caps": {"kbps": 1, "daily_gb": 10.0, "max_hosts": 2, "max_streams": 64}}),
+            serde_json::json!({"leaderboard": "loud"}),
+            serde_json::json!({"carrying": ["NOTANID"]}),
+        ] {
+            assert!(ns.validate(&beat(bad.clone())).is_err(), "{bad}");
+        }
+        assert!(serde_json::from_value::<Beat>(serde_json::json!({"node_id": "x", "ip": "1.2.3.4"})).is_err());
+    }
+
+    fn passing(t: i64) -> Node {
+        let mut n = Node {
+            node_id: "aaaaaaaaaaaaaaaa".into(), url: "ws://203.0.113.5:3728".into(), region: "us".into(),
+            protocol: 1, rules: 1, e2e_required: true, accepting: true, first_seen: t - 5 * 86_400, last_seen: t,
+            probe_ok_now: true, key_proof: true, status: "pending".into(), leaderboard: "named".into(),
+            display_name: "Ann".into(),
+            caps: Caps { kbps: 512, daily_gb: 10.0, max_hosts: 2, max_streams: 64 },
+            ..Node::default()
+        };
+        n.probes = (0..720).map(|i| (t - i * 600, i % 50 != 0)).collect();
+        n
+    }
+
+    #[test]
+    fn status_flow() {
+        let t = now();
+        let n = passing(t);
+        let ok = checks(&n, t);
+        assert!(ok.values().all(|v| v.0), "{ok:?}");
+        assert_eq!(next_status("pending", &ok, None, Some(99.0)), "pending", "never verified by machines alone");
+        assert_eq!(next_status("pending", &ok, Some("approve"), Some(99.0)), "verified");
+        assert_eq!(next_status("verified", &ok, None, Some(80.0)), "suspended");
+        assert_eq!(next_status("suspended", &ok, None, Some(99.0)), "verified");
+        assert_eq!(next_status("verified", &ok, Some("revoke"), None), "revoked");
+        assert_eq!(next_status("revoked", &ok, Some("approve"), None), "revoked");
+        assert_eq!(next_status("revoked", &ok, Some("unrevoke"), None), "pending");
+        let mut young = passing(t);
+        young.first_seen = t - 3600;
+        young.probes.truncate(6);
+        let c = checks(&young, t);
+        assert!(!c["history"].0);
+        assert_eq!(next_status("unlisted", &c, None, None), "pending");
+        assert_eq!(next_status("pending", &c, Some("approve"), None), "pending", "can't approve too early");
+    }
+
+    #[test]
+    fn stats_are_capped_and_assignment_is_sticky() {
+        let ns = nodes(true);
+        let t = now();
+        let mut n = passing(t);
+        n.status = "verified".into();
+        let b = beat(serde_json::json!({"stats": {"relay_bytes_total": 900_000_000_000u64, "seed_bytes_total": 5}}));
+        n.last_seen = t - 60;
+        Nodes::apply(&mut n, &b, t);
+        let today = &n.days[&utc_day(t)];
+        assert_eq!(today.relay_bytes, 512 * 1024 * 120, "no more than the node's own cap allows");
+        assert_eq!(today.seed_bytes, 5);
+        n.node_id = "aaaaaaaaaaaaaaaa".into();
+        let mut m = n.clone();
+        m.node_id = "bbbbbbbbbbbbbbbb".into();
+        m.url = "ws://203.0.113.6:3728".into();
+        lock(&ns.file).nodes.insert(n.node_id.clone(), n);
+        lock(&ns.file).nodes.insert(m.node_id.clone(), m);
+        let a = ns.assign("hosthosthosthost", None, t).unwrap();
+        assert_eq!(ns.assign("hosthosthosthost", None, t).unwrap(), a, "sticky");
+        let b2 = ns.assign("hosthosthosthost", Some(&a.1), t).unwrap();
+        assert_ne!(a.1, b2.1, "a node the host couldn't reach is skipped");
+        lock(&ns.file).nodes.get_mut(&b2.1).unwrap().paused = true;
+        lock(&ns.file).nodes.get_mut(&a.1).unwrap().paused = true;
+        assert!(ns.assign("hosthosthosthost", None, t).is_none(), "nothing usable: Open Vanilla's relay");
+    }
+
+    #[test]
+    fn public_answers_carry_no_addresses() {
+        let ns = nodes(true);
+        let t = now();
+        let mut n = passing(t);
+        n.status = "verified".into();
+        n.key = "ab".repeat(32);
+        n.days.insert(utc_day(t), Day { relay_bytes: 3_000_000_000, seed_bytes: 1_000_000_000 });
+        let mut hidden = passing(t);
