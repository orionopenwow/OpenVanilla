+async fn heartbeat(State(state): State<Arc<AppState>>, headers: HeaderMap, body: Bytes) -> Response {
+    let ns = nodes(&state);
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !ns.limiter.allow(&format!("nodes:ip:{ip}"), 20, 60) {
+        return json_err(StatusCode::TOO_MANY_REQUESTS, "slow down");
+    }
+    if body.len() > MAX_BODY {
+        return json_err(StatusCode::PAYLOAD_TOO_LARGE, "at most 4 KB");
+    }
+    let b: Beat = match serde_json::from_slice(&body) {
+        Ok(b) => b,
+        Err(e) => return json_err(StatusCode::BAD_REQUEST, format!("bad heartbeat: {e}")),
+    };
+    if let Err(e) = ns.validate(&b) {
+        return json_err(StatusCode::BAD_REQUEST, e);
+    }
+    let t = now();
+    let token = super::bearer(&headers);
+    let new_token = {
+        let mut f = lock(&ns.file);
+        match (&token, f.nodes.get(&b.node_id)) {
+            (Some(tok), Some(n)) if n.token_hash == sha256_hex(tok) => {
+                if t - n.last_seen < MIN_BEAT_GAP {
+                    return json_err(StatusCode::TOO_MANY_REQUESTS, "one heartbeat per 20 s");
+                }
+                None
+            }
+            (_, Some(_)) => return json_err(StatusCode::FORBIDDEN, "unknown claim token for this node"),
+            (_, None) => {
+                if f.nodes.len() >= MAX_NODES {
+                    return json_err(StatusCode::SERVICE_UNAVAILABLE, "the node list is full");
+                }
+                if !ns.limiter.allow(&format!("nodes:claim:{ip}"), 3, 3600) {
+                    return json_err(StatusCode::TOO_MANY_REQUESTS, "at most 3 new nodes per hour");
+                }
+                let tok = {
+                    use rand::RngCore;
+                    let mut r = [0u8; 32];
+                    rand::thread_rng().fill_bytes(&mut r);
+                    hex::encode(r)
+                };
+                f.nodes.insert(
+                    b.node_id.clone(),
+                    Node {
+                        node_id: b.node_id.clone(),
+                        token_hash: sha256_hex(&tok),
+                        first_seen: t,
+                        status: "unlisted".into(),
+                        ..Node::default()
+                    },
+                );
+                Some(tok)
+            }
+        }
+    };
+    {
+        let mut f = lock(&ns.file);
+        let n = f.nodes.get_mut(&b.node_id).expect("just inserted or found");
+        Nodes::apply(n, &b, t);
+    }
+    let due = lock(&ns.file).nodes.get(&b.node_id).is_some_and(|n| t - n.last_probe >= PROBE_EVERY);
+    if due {
+        ns.probe(&b.node_id).await;
+    }
+    let mut out = {
+        let mut f = lock(&ns.file);
+        let n = f.nodes.get_mut(&b.node_id).expect("present");
+        Nodes::restatus(n, t, None);
+        serde_json::json!({
+            "node_id": n.node_id, "status": n.status, "message": n.message,
+            "checks": Nodes::checks_json(n, t), "heartbeat_every": 60,
+        })
+    };
+    let status = match new_token {
+        Some(tok) => {
+            out["token"] = tok.into();
+            StatusCode::CREATED
+        }
+        None => StatusCode::OK,
+    };
+    let mut r = (status, Json(out)).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+async fn admin_list(_session: Session, State(state): State<Arc<AppState>>) -> Response {
+    let ns = nodes(&state);
+    let t = now();
+    let f = lock(&ns.file);
+    let mut list: Vec<serde_json::Value> = f
+        .nodes
+        .values()
+        .map(|n| {
+            serde_json::json!({
+                "node_id": n.node_id, "url": n.url, "region": n.region, "status": n.status, "message": n.message,
+                "fresh": n.fresh(t), "accepting": n.accepting, "paused": n.paused, "caps": n.caps,
+                "version": n.version, "first_seen": n.first_seen, "last_seen": n.last_seen,
+                "uptime_7d": n.uptime_pct(t, 7), "uptime_30d": n.uptime_pct(t, WINDOW_DAYS),
+                "probes": n.probes.len(), "probe_error": n.probe_error, "carrying": n.carrying.len(),
+                "leaderboard": n.leaderboard, "display_name": n.display_name,
+                "checks": Nodes::checks_json(n, t),
+            })
+        })
+        .collect();
+    list.sort_by_key(|v| v["node_id"].as_str().unwrap_or("").to_string());
+    let mut r = Json(serde_json::json!({ "nodes": list, "assignments": f.assignments })).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct DecisionBody {
+    node_id: String,
+    /// approve | revoke | unrevoke
+    decision: String,
+    #[serde(default)]
+    message: String,
+}
+
+async fn admin_verify(
+    session: Session,
+    State(state): State<Arc<AppState>>,
+    headers: HeaderMap,
+    Json(b): Json<DecisionBody>,
+) -> Result<Response, AppError> {
+    super::check_csrf(&session, &headers)?;
+    let ns = nodes(&state);
+    if !["approve", "revoke", "unrevoke"].contains(&b.decision.as_str()) {
+        return Err(AppError::BadRequest("decision: approve | revoke | unrevoke".into()));
+    }
+    let t = now();
+    let (status, checks) = {
+        let mut f = lock(&ns.file);
+        let Some(n) = f.nodes.get_mut(&b.node_id) else {
+            return Err(AppError::BadRequest("no such node".into()));
+        };
+        n.message = b.message.chars().filter(|c| !c.is_control()).take(300).collect();
+        Nodes::restatus(n, t, Some(&b.decision));
+        let out = (n.status.clone(), Nodes::checks_json(n, t));
+        if out.0 == "revoked" {
+            f.assignments.retain(|_, nid| nid != &b.node_id);
+        }
+        out
+    };
+    ns.save()?;
+    crate::audit::log(&state.db, Some(session.user.id), None, &format!("nodes.{}", b.decision), Some(&b.node_id), Some(&b.message)).await;
+    Ok(Json(serde_json::json!({ "ok": true, "node_id": b.node_id, "status": status, "checks": checks })).into_response())
+}
