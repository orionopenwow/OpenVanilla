+/// Which relay carries a realm right now (private realms are joined by invite and never listed):
+/// `{"relay_url", "key", "e2e"}`. Never the host's own address.
+async fn route(State(state): State<Arc<AppState>>, headers: HeaderMap, Path(host_id): Path<String>) -> Response {
+    let d = dir(&state);
+    let ip = client_ip(&headers).unwrap_or_default();
+    if !d.limiter.allow(&format!("dir:route:{ip}"), 60, 60) {
+        return json_err(StatusCode::TOO_MANY_REQUESTS, "slow down");
+    }
+    let t = now();
+    let Some(e) = super::valid_host_id(&host_id)
+        .then(|| d.known(&host_id))
+        .flatten()
+        .filter(|e| e.relay && t - e.last_seen <= LIST_TTL && !d.is_blocked(&e.host_id, ""))
+    else {
+        return json_err(StatusCode::NOT_FOUND, "no such relayed realm online");
+    };
+    let base = e
+        .node
+        .as_deref()
+        .and_then(|n| state.p2p.nodes.as_ref().and_then(|ns| ns.node_url(n)))
+        .unwrap_or_else(|| d.cfg.relay_url.clone());
+    let mut r = Json(serde_json::json!({
+        "relay_url": format!("{base}/h/{}", e.host_id), "key": e.key, "e2e": e.e2e && !e.key.is_empty(),
+    }))
+    .into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
