@@ -0,0 +1,1041 @@
+//! Volunteer relay nodes, the central half (docs/NODE_NETWORK.md in the Open Vanilla repo; the launcher
+//! side is `launcher/p2p/node.py`, the shared rules `launcher/p2p/tiers.py` and
+//! `launcher/p2p/leaderboard.py`, which this file mirrors):
+//!
+//! * `POST /api/nodes/heartbeat` — a node registers (first beat → claim token, only its SHA-256 is
+//!   kept) and reports its caps and counters every minute. Its id is the fingerprint of its
+//!   Ed25519 key, so nobody can register someone else's node.
+//! * The directory probes each node (`GET <node>/node?c=<nonce>`, signed with the node key) every
+//!   10 minutes; 30 days of results drive the uptime check.
+//! * Verification: machines check (reachable, history, uptime, software, caps, rules, standing),
+//!   the maintainer approves (`POST /admin/api/nodes/verify`). Verified nodes that stop passing
+//!   drop to "suspended" by themselves and come back when they recover; "revoked" sticks.
+//! * Assignment: a relayed host that advertises `e2e` + `key` and `nodes: true` may be put on a
+//!   verified, accepting node; its heartbeat answer carries `relay: {url, node_id, ticket}`. The
+//!   ticket is a 10-minute `v4.public` token (typ "node", aud = node, sub = host) signed with the
+//!   identity key, checked offline by the node.
+//! * Stats ingestion: counters become per-node, per-UTC-day rows (deltas, capped by the node's
+//!   own bandwidth cap), from which `GET /api/nodes/leaderboard` builds the supporter list. No
+//!   address, URL, key, node id or account id is ever in a public answer.
+//!
+//! Off unless `NODES_ENABLED=1` (and it needs `DIRECTORY_ENABLED` and `IDENTITY_ENABLED`).
+//! State: `<state>/nodes-state.json`.
+
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Arc, Mutex};
+
+use anyhow::Result;
+use axum::body::Bytes;
+use axum::extract::State;
+use axum::http::{header, HeaderMap, HeaderValue, StatusCode};
+use axum::response::{IntoResponse, Response};
+use axum::routing::{get, post};
+use axum::{Json, Router};
+use ed25519_dalek::{Signature, Verifier, VerifyingKey};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use super::config::P2pConfig;
+use crate::db::now;
+use crate::ratelimit::Limiter;
+use crate::session::{client_ip, Session};
+use crate::{AppError, AppState};
+
+pub const BEAT_TTL: i64 = 180;
+pub const MIN_BEAT_GAP: i64 = 20;
+pub const PROBE_EVERY: i64 = 600;
+pub const TICKET_TTL: i64 = 600;
+pub const CLAIM_TTL: i64 = 30 * 86_400;
+pub const WINDOW_DAYS: i64 = 30;
+pub const MAX_BODY: usize = 4096;
+pub const MAX_NODES: usize = 500;
+
+pub const PROTOCOL: u32 = 1;
+pub const RULES_VERSION: u32 = 1;
+pub const MIN_UPTIME_PCT: f64 = 95.0;
+pub const SUSPEND_BELOW_PCT: f64 = 90.0;
+pub const MIN_HISTORY_DAYS: f64 = 3.0;
+pub const MIN_PROBES: usize = 300;
+pub const MIN_KBPS: u64 = 256;
+pub const MIN_DAILY_GB: f64 = 5.0;
+pub const MIN_STREAMS: u32 = 16;
+pub const SEED_WEIGHT: f64 = 0.5;
+pub const TOP: usize = 50;
+const STATUSES: &[&str] = &["unlisted", "pending", "verified", "suspended", "revoked"];
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Caps {
+    pub kbps: u64,
+    pub daily_gb: f64,
+    pub max_hosts: u32,
+    pub max_streams: u32,
+}
+
+#[derive(Debug, Clone, Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Stats {
+    #[serde(default)]
+    pub relay_bytes_today: u64,
+    #[serde(default)]
+    pub relay_bytes_total: u64,
+    #[serde(default)]
+    pub streams_total: u64,
+    #[serde(default)]
+    pub streams_now: u32,
+    #[serde(default)]
+    pub hosts_now: u32,
+    #[serde(default)]
+    pub uptime_secs: u64,
+    #[serde(default)]
+    pub seed_bytes_total: u64,
+}
+
+/// What a node sends (launcher/p2p/node.py `heartbeat_payload`).
+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Beat {
+    pub node_id: String,
+    pub key: String,
+    pub url: String,
+    #[serde(default)]
+    pub region: Option<String>,
+    pub version: String,
+    pub protocol: u32,
+    pub rules: u32,
+    pub e2e_required: bool,
+    pub caps: Caps,
+    pub state: String,
+    pub accepting: bool,
+    #[serde(default)]
+    pub stats: Stats,
+    pub leaderboard: String,
+    #[serde(default)]
+    pub display_name: String,
+    /// Host ids this node carries right now (the directory treats them as reachable).
+    #[serde(default)]
+    pub carrying: Vec<String>,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct Day {
+    pub relay_bytes: u64,
+    pub seed_bytes: u64,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct Node {
+    pub node_id: String,
+    pub token_hash: String,
+    pub key: String,
+    pub url: String,
+    pub region: String,
+    pub version: String,
+    pub protocol: u32,
+    pub rules: u32,
+    pub e2e_required: bool,
+    pub caps: Caps,
+    pub accepting: bool,
+    pub paused: bool,
+    pub leaderboard: String,
+    pub display_name: String,
+    pub carrying: Vec<String>,
+    pub first_seen: i64,
+    pub last_seen: i64,
+    /// (time, ok) for the last 30 days of probes.
+    pub probes: Vec<(i64, bool)>,
+    pub last_probe: i64,
+    pub probe_ok_now: bool,
+    pub key_proof: bool,
+    pub probe_error: Option<String>,
+    pub status: String,
+    pub message: String,
+    pub reports_open: u32,
+    pub days: BTreeMap<String, Day>,
+    pub last_relay_total: u64,
+    pub last_seed_total: u64,
+}
+
+impl Node {
+    fn fresh(&self, t: i64) -> bool {
+        t - self.last_seen <= BEAT_TTL
+    }
+    fn uptime_pct(&self, t: i64, days: i64) -> Option<f64> {
+        let since = t - days * 86_400;
+        let (ok, n) = self
+            .probes
+            .iter()
+            .filter(|(at, _)| *at >= since)
+            .fold((0usize, 0usize), |(ok, n), (_, good)| (ok + usize::from(*good), n + 1));
+        (n > 0).then(|| 100.0 * ok as f64 / n as f64)
+    }
+    fn usable(&self, t: i64) -> bool {
+        self.status == "verified" && self.fresh(t) && self.accepting && !self.paused
+    }
+}
+
+#[derive(Default, Serialize, Deserialize)]
+struct NodesFile {
+    nodes: HashMap<String, Node>,
+    /// host id -> node id (sticky while the node stays usable).
+    assignments: HashMap<String, String>,
+}
+
+pub struct Nodes {
+    cfg: P2pConfig,
+    file: Mutex<NodesFile>,
+    limiter: Limiter,
+    http: reqwest::Client,
+    wordlist: Vec<String>,
+}
+
+fn lock<T>(m: &Mutex<T>) -> std::sync::MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+fn sha256_hex(s: &str) -> String {
+    hex::encode(Sha256::digest(s.as_bytes()))
+}
+
+/// A node's id: 16 lowercase base32 characters of SHA-256(its public key) — the same as
+/// `node.node_id_for` and the host-key fingerprint in the launcher.
+pub fn node_id_for(key: &[u8]) -> String {
+    data_encoding::BASE32_NOPAD
+        .encode(&Sha256::digest(key)[..10])
+        .to_ascii_lowercase()
+}
+
+pub fn utc_day(t: i64) -> String {
+    super::identity::rfc3339(t)[..10].to_string()
+}
+
+pub fn clean_name(s: &str) -> String {
+    let s: String = s.chars().filter(|c| !c.is_control()).collect();
+    let s = s.split_whitespace().collect::<Vec<_>>().join(" ");
+    let s: String = s.chars().take(24).collect();
+    let low = s.to_lowercase();
+    let reserved = ["admin", "openvanilla staff", "open vanilla staff", "moderator", "official"];
+    if s.chars().count() < 3
+        || reserved.iter().any(|w| low.contains(w))
+        || low.contains("http://")
+        || low.contains("https://")
+        || low.contains("www.")
+    {
+        return String::new();
+    }
+    s
+}
+
+/// The automatic checks (`tiers.node_checks`): name -> (ok, detail).
+pub fn checks(n: &Node, t: i64) -> BTreeMap<&'static str, (bool, String)> {
+    let days = ((t - n.first_seen) as f64 / 86_400.0).max(0.0);
+    let total = n.probes.len();
+    let pct = n.uptime_pct(t, WINDOW_DAYS).unwrap_or(0.0);
+    let mut c = BTreeMap::new();
+    c.insert(
+        "reachable",
+        (
+            n.probe_ok_now && n.key_proof,
+            if n.probe_ok_now {
+                "probe passed and the node signed the challenge".to_string()
+            } else {
+                n.probe_error.clone().unwrap_or_else(|| "the directory can't reach the node's port".into())
+            },
+        ),
+    );
+    c.insert(
+        "history",
+        (
+            days >= MIN_HISTORY_DAYS && total >= MIN_PROBES,
+            format!("{days:.1} of {MIN_HISTORY_DAYS} days, {total} of {MIN_PROBES} probes"),
+        ),
+    );
+    c.insert(
+        "uptime",
+        (total > 0 && pct >= MIN_UPTIME_PCT, format!("{pct:.1}% of probes passed (needs {MIN_UPTIME_PCT:.0}%)")),
+    );
+    c.insert(
+        "software",
+        (
+            n.protocol >= PROTOCOL && n.e2e_required,
+            format!("node protocol v{}, e2e {}", n.protocol, if n.e2e_required { "required" } else { "optional" }),
+        ),
+    );
+    c.insert(
+        "caps",
+        (
+            n.caps.kbps >= MIN_KBPS && n.caps.daily_gb >= MIN_DAILY_GB && n.caps.max_streams >= MIN_STREAMS,
+            format!("{} KB/s, {} GB/day, {} streams", n.caps.kbps, n.caps.daily_gb, n.caps.max_streams),
+        ),
+    );
+    c.insert(
+        "rules",
+        (n.rules >= RULES_VERSION, if n.rules >= RULES_VERSION { "accepted the node rules".into() } else { "rules not accepted".into() }),
+    );
+    c.insert("standing", (n.reports_open == 0, format!("{} open reports", n.reports_open)));
+    c
+}
+
+/// `tiers.node_status`: the next status. decision: None | "approve" | "revoke" | "unrevoke".
+pub fn next_status(current: &str, c: &BTreeMap<&'static str, (bool, String)>, decision: Option<&str>, uptime_pct: Option<f64>) -> String {
+    let current = if STATUSES.contains(&current) { current } else { "unlisted" };
+    let all = c.values().all(|(ok, _)| *ok);
+    let get = |k: &str| c.get(k).map(|v| v.0).unwrap_or(true);
+    let s = match (decision, current) {
+        (Some("revoke"), _) => "revoked",
+        (Some("unrevoke"), "revoked") => "pending",
+        (_, "revoked") => "revoked",
+        (Some("approve"), _) => {
+            if all {
+                "verified"
+            } else {
+                "pending"
+            }
+        }
+        (_, "verified") => {
+            if !get("reachable") || !get("standing") || uptime_pct.is_some_and(|p| p < SUSPEND_BELOW_PCT) {
+                "suspended"
+            } else {
+                "verified"
+            }
+        }
+        (_, "suspended") => {
+            if all {
+                "verified"
+            } else {
+                "suspended"
+            }
+        }
+        _ => {
+            if get("reachable") || current == "pending" {
+                "pending"
+            } else {
+                "unlisted"
+            }
+        }
+    };
+    s.to_string()
+}
+
+fn json_err(status: StatusCode, msg: impl Into<String>) -> Response {
+    let mut r = (status, Json(serde_json::json!({ "error": msg.into() }))).into_response();
+    r.headers_mut()
+        .insert(header::CACHE_CONTROL, HeaderValue::from_static("no-store"));
+    r
+}
+
+impl Nodes {
+    pub fn new(cfg: P2pConfig) -> Result<Self> {
+        let wordlist = match &cfg.wordlist {
+            Some(p) => std::fs::read_to_string(p)?
+                .lines()
+                .map(|l| l.trim().to_lowercase())
+                .filter(|l| !l.is_empty() && !l.starts_with('#'))
+                .collect(),
+            None => Vec::new(),
+        };
+        let file = std::fs::read_to_string(cfg.state_dir.join("nodes-state.json"))
+            .ok()
+            .and_then(|s| serde_json::from_str(&s).ok())
+            .unwrap_or_default();
+        Ok(Self {
+            cfg,
+            file: Mutex::new(file),
+            limiter: Limiter::default(),
+            http: reqwest::Client::builder()
+                .timeout(std::time::Duration::from_secs(8))
+                .redirect(reqwest::redirect::Policy::none())
+                .build()?,
+            wordlist,
+        })
+    }
+
+    pub fn save(&self) -> Result<()> {
+        let body = serde_json::to_string(&*lock(&self.file))?;
+        super::write_atomic(&self.cfg.state_dir.join("nodes-state.json"), &body)
+    }
+
+    /// Forget nodes 30 days after their last heartbeat; trim old probe results and day rows.
+    pub fn sweep(&self) {
+        let t = now();
+        let cutoff = utc_day(t - WINDOW_DAYS * 86_400);
+        let mut f = lock(&self.file);
+        f.nodes.retain(|_, n| t - n.last_seen < CLAIM_TTL || n.status == "revoked");
+        for n in f.nodes.values_mut() {
+            n.probes.retain(|(at, _)| t - at <= WINDOW_DAYS * 86_400);
+            n.days.retain(|d, _| *d >= cutoff);
+        }
+        let nodes = &f.nodes;
+        let keep: HashMap<String, String> = f
+            .assignments
+            .iter()
+            .filter(|(_, nid)| nodes.get(*nid).is_some_and(|n| n.usable(t)))
+            .map(|(h, n)| (h.clone(), n.clone()))
+            .collect();
+        f.assignments = keep;
+    }
+
+    pub fn validate(&self, b: &Beat) -> Result<(), String> {
+        let key = hex::decode(&b.key).map_err(|_| "key: 64 hex characters".to_string())?;
+        if key.len() != 32 || VerifyingKey::from_bytes(&key.clone().try_into().unwrap_or([0u8; 32])).is_err() {
+            return Err("key: an Ed25519 public key".into());
+        }
+        if node_id_for(&key) != b.node_id {
+            return Err("node_id: must be the fingerprint of key".into());
+        }
+        let u = url::Url::parse(&b.url).map_err(|_| "url: ws://host:port or wss://host".to_string())?;
+        if !matches!(u.scheme(), "ws" | "wss") || u.path().trim_matches('/') != "" || u.query().is_some() || b.url.len() > 200 {
+            return Err("url: ws://host:port or wss://host, nothing after it".into());
+        }
+        super::directory::valid_host(u.host_str().unwrap_or(""), self.cfg.allow_private).map_err(|e| format!("url {e}"))?;
+        if b.version.is_empty() || b.version.len() > 16 || !b.version.bytes().all(|c| c.is_ascii_alphanumeric() || b".-+_".contains(&c)) {
+            return Err("version: 1–16 of A-Za-z0-9.-+_".into());
+        }
+        let region = b.region.clone().unwrap_or_else(|| "us".into());
+        if region.is_empty() || region.len() > 8 || !region.bytes().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit()) {
+            return Err("region: 1–8 lowercase letters or digits".into());
+        }
+        if !(32..=1_000_000).contains(&b.caps.kbps)
+            || !(0.5..=10_000.0).contains(&b.caps.daily_gb)
+            || !(1..=32).contains(&b.caps.max_hosts)
+            || !(2..=1024).contains(&b.caps.max_streams)
+        {
+            return Err("caps: out of range".into());
+        }
+        if !["running", "paused"].contains(&b.state.as_str()) {
+            return Err("state: running | paused".into());
+        }
+        if !["off", "anonymous", "named"].contains(&b.leaderboard.as_str()) {
+            return Err("leaderboard: off | anonymous | named".into());
+        }
+        if b.carrying.len() > 32 || !b.carrying.iter().all(|h| super::valid_host_id(h)) {
+            return Err("carrying: up to 32 host ids".into());
+        }
+        let name = clean_name(&b.display_name);
+        if !name.is_empty() && self.wordlist.iter().any(|w| name.to_lowercase().contains(w.as_str())) {
+            return Err("display_name contains a word that is not allowed".into());
+        }
+        Ok(())
+    }
+
+    /// Apply one beat: stats deltas (capped by the node's own caps), state, status.
+    fn apply(n: &mut Node, b: &Beat, t: i64) {
+        let elapsed = if n.last_seen > 0 { (t - n.last_seen).max(1) } else { 60 } as u64;
+        let cap = b.caps.kbps.saturating_mul(1024).saturating_mul(elapsed + 60);
+        let delta = |total: u64, last: u64| if total >= last { total - last } else { total };
+        let relay = delta(b.stats.relay_bytes_total, n.last_relay_total).min(cap);
+        let seed = delta(b.stats.seed_bytes_total, n.last_seed_total);
+        let day = n.days.entry(utc_day(t)).or_default();
+        day.relay_bytes = day.relay_bytes.saturating_add(relay);
+        day.seed_bytes = day.seed_bytes.saturating_add(seed);
+        n.last_relay_total = b.stats.relay_bytes_total;
+        n.last_seed_total = b.stats.seed_bytes_total;
+        if n.url != b.url {
+            n.probe_ok_now = false;
+            n.key_proof = false;
+            n.last_probe = 0;
+        }
+        n.key = b.key.clone();
+        n.url = b.url.clone();
+        n.region = b.region.clone().unwrap_or_else(|| "us".into());
+        n.version = b.version.clone();
+        n.protocol = b.protocol;
+        n.rules = b.rules;
+        n.e2e_required = b.e2e_required;
+        n.caps = b.caps.clone();
+        n.accepting = b.accepting;
+        n.paused = b.state == "paused";
+        n.leaderboard = b.leaderboard.clone();
+        n.display_name = clean_name(&b.display_name);
+        n.carrying = b.carrying.clone();
+        n.last_seen = t;
+    }
+
+    fn restatus(n: &mut Node, t: i64, decision: Option<&str>) {
+        let c = checks(n, t);
+        n.status = next_status(&n.status, &c, decision, n.uptime_pct(t, 7));
+    }
+
+    fn checks_json(n: &Node, t: i64) -> serde_json::Value {
+        let m: serde_json::Map<String, serde_json::Value> = checks(n, t)
+            .into_iter()
+            .map(|(k, (ok, d))| (k.to_string(), serde_json::json!({ "ok": ok, "detail": d })))
+            .collect();
+        serde_json::Value::Object(m)
+    }
+
+    /// Probe one node: `GET http(s)://<node>/node?c=<nonce>`, the answer signed with its key.
+    pub async fn probe(&self, node_id: &str) {
+        let target = {
+            let f = lock(&self.file);
+            let Some(n) = f.nodes.get(node_id) else { return };
+            (n.url.clone(), n.key.clone())
+        };
+        let nonce = {
+            use rand::RngCore;
+            let mut b = [0u8; 16];
+            rand::thread_rng().fill_bytes(&mut b);
+            hex::encode(b)
+        };
+        let http_url = target.0.replacen("wss://", "https://", 1).replacen("ws://", "http://", 1);
+        let res: Result<(), String> = async {
+            let body = self
+                .http
+                .get(format!("{http_url}/node?c={nonce}"))
+                .send()
+                .await
+                .map_err(|e| format!("can't reach the node: {e}"))?
+                .error_for_status()
+                .map_err(|e| format!("node answered {e}"))?
+                .text()
+                .await
+                .map_err(|e| e.to_string())?;
+            let v: serde_json::Value = serde_json::from_str(&body).map_err(|_| "not a node answer".to_string())?;
+            if v["node_id"].as_str() != Some(node_id) || v["key"].as_str() != Some(target.1.as_str()) {
+                return Err("another node answered at that address".into());
+            }
+            let key: [u8; 32] = hex::decode(&target.1).ok().and_then(|k| k.try_into().ok()).ok_or("bad key")?;
+            let vk = VerifyingKey::from_bytes(&key).map_err(|_| "bad key")?;
+            let sig = hex::decode(v["sig"].as_str().unwrap_or("")).ok().and_then(|s| Signature::from_slice(&s).ok()).ok_or("no signature")?;
+            vk.verify(format!("OWNODE1|{node_id}|{nonce}").as_bytes(), &sig)
+                .map_err(|_| "the challenge signature doesn't check out".to_string())?;
+            Ok(())
+        }
+        .await;
+        let t = now();
+        let mut f = lock(&self.file);
+        if let Some(n) = f.nodes.get_mut(node_id) {
+            n.last_probe = t;
+            n.probes.push((t, res.is_ok()));
+            n.probe_ok_now = res.is_ok();
+            n.key_proof = res.is_ok();
+            n.probe_error = res.err();
+            Self::restatus(n, t, None);
+        }
+    }
+
+    /// Probe every node that is due (housekeeping, once a minute).
+    pub async fn probe_due(&self) {
+        let t = now();
+        let due: Vec<String> = lock(&self.file)
+            .nodes
+            .values()
+            .filter(|n| n.fresh(t) && t - n.last_probe >= PROBE_EVERY && n.status != "revoked")
+            .map(|n| n.node_id.clone())
+            .collect();
+        for id in due {
+            self.probe(&id).await;
+        }
+    }
+
+    /// The verified, accepting node for a relayed host (sticky), or None for Open Vanilla's relay.
+    pub fn assign(&self, host_id: &str, failed: Option<&str>, t: i64) -> Option<(String, String)> {
+        let mut f = lock(&self.file);
+        if let Some(nid) = f.assignments.get(host_id).cloned() {
+            if Some(nid.as_str()) != failed && f.nodes.get(&nid).is_some_and(|n| n.usable(t)) {
+                let url = f.nodes[&nid].url.clone();
+                return Some((url, nid));
+            }
+            f.assignments.remove(host_id);
+        }
+        let mut load: HashMap<&str, u32> = HashMap::new();
+        for nid in f.assignments.values() {
+            *load.entry(nid.as_str()).or_default() += 1;
+        }
+        let pick = f
+            .nodes
+            .values()
+            .filter(|n| n.usable(t) && Some(n.node_id.as_str()) != failed)
+            .filter(|n| load.get(n.node_id.as_str()).copied().unwrap_or(0) < n.caps.max_hosts)
+            .min_by_key(|n| (load.get(n.node_id.as_str()).copied().unwrap_or(0), n.node_id.clone()))
+            .map(|n| (n.url.clone(), n.node_id.clone()));
+        if let Some((_, nid)) = &pick {
+            f.assignments.insert(host_id.to_string(), nid.clone());
+        }
+        pick
+    }
+
+    pub fn release(&self, host_id: &str) {
+        lock(&self.file).assignments.remove(host_id);
+    }
+
+    /// The node currently carrying `host_id` (fresh beat that lists it) — the directory's
+    /// reachability signal for hosts on a node.
+    pub fn carrying(&self, host_id: &str, node_id: &str, t: i64) -> bool {
+        lock(&self.file)
+            .nodes
+            .get(node_id)
+            .is_some_and(|n| n.fresh(t) && n.carrying.iter().any(|h| h == host_id))
+    }
+
+    pub fn node_url(&self, node_id: &str) -> Option<String> {
+        lock(&self.file).nodes.get(node_id).map(|n| n.url.clone())
+    }
+
+    /// The supporter leaderboard (`leaderboard.aggregate`): www/community/nodes.json's shape.
+    pub fn leaderboard(&self, t: i64) -> serde_json::Value {
+        let f = lock(&self.file);
+        let since = utc_day(t - WINDOW_DAYS * 86_400);
+        let (mut relay_total, mut seed_total, mut verified, mut pending) = (0u64, 0u64, 0u32, 0u32);
+        let mut regions: BTreeMap<String, u32> = BTreeMap::new();
+        let mut rows: Vec<(f64, serde_json::Value)> = Vec::new();
+        for n in f.nodes.values() {
+            if n.status == "revoked" || n.status == "unlisted" {
+                continue;
+            }
+            let (relay, seed, days) = n
+                .days
+                .iter()
+                .filter(|(d, _)| **d >= since)
+                .fold((0u64, 0u64, 0u32), |(r, s, k), (_, d)| (r + d.relay_bytes, s + d.seed_bytes, k + 1));
+            relay_total += relay;
+            seed_total += seed;
+            if n.status == "verified" {
+                verified += 1;
+            } else {
+                pending += 1;
+            }
+            *regions.entry(n.region.clone()).or_default() += 1;
+            if n.leaderboard == "off" || (relay == 0 && seed == 0) {
+                continue;
+            }
+            let name = if n.leaderboard == "named" { clean_name(&n.display_name) } else { String::new() };
+            let mut badges = vec![if n.status == "verified" { "node" } else { "pending" }];
+            if seed > 0 {
+                badges.push("seeder");
+            }
+            let gb = |b: u64| (b as f64 / 1e8).round() / 10.0;
+            rows.push((
+                relay as f64 + SEED_WEIGHT * seed as f64,
+                serde_json::json!({
+                    "name": if name.is_empty() { "Anonymous node".to_string() } else { name.clone() },
+                    "anonymous": name.is_empty(), "verified": n.status == "verified", "region": n.region,
+                    "relay_gb": gb(relay), "seed_gb": gb(seed),
+                    "uptime_pct": n.uptime_pct(t, WINDOW_DAYS).unwrap_or(0.0).round() as i64,
+                    "days_active": days, "since": &super::identity::rfc3339(n.first_seen)[..7], "badges": badges,
+                }),
+            ));
+        }
+        rows.sort_by(|a, b| {
+            b.0.partial_cmp(&a.0)
+                .unwrap_or(std::cmp::Ordering::Equal)
+                .then(b.1["uptime_pct"].as_i64().cmp(&a.1["uptime_pct"].as_i64()))
+                .then(a.1["name"].as_str().unwrap_or("").to_lowercase().cmp(&b.1["name"].as_str().unwrap_or("").to_lowercase()))
+        });
+        let supporters: Vec<serde_json::Value> = rows
+            .into_iter()
+            .take(TOP)
+            .enumerate()
+            .map(|(i, (_, mut v))| {
+                v["rank"] = (i + 1).into();
+                v
+            })
+            .collect();
+        let gb = |b: u64| (b as f64 / 1e8).round() / 10.0;
+        serde_json::json!({
+            "version": 1, "updated": super::identity::rfc3339(t), "window_days": WINDOW_DAYS,
+            "network": { "relay_gb": gb(relay_total), "seed_gb": gb(seed_total), "nodes_verified": verified,
+                         "nodes_pending": pending, "supporters": supporters.len(), "regions": regions },
+            "supporters": supporters,
+            "privacy": "Opt-in. No IP addresses, node addresses, keys or account ids are published. Names appear only for supporters who chose to show one; everyone else is \"Anonymous node\" or not listed. Totals cover the last 30 days, rounded to 0.1 GB.",
+        })
+    }
+
+    /// Public node list (`tiers.public_node`): no URL, address, key or node id.
+    pub fn public_list(&self, t: i64) -> serde_json::Value {
+        let f = lock(&self.file);
+        let mut nodes: Vec<serde_json::Value> = f
+            .nodes
+            .values()
+            .filter(|n| n.status == "verified" || n.status == "pending")
+            .filter(|n| n.fresh(t))
+            .map(|n| {
+                let name = if n.leaderboard == "named" { clean_name(&n.display_name) } else { String::new() };
+                serde_json::json!({
+                    "tier": "node", "status": n.status,
+                    "badges": [if n.status == "verified" { "node" } else { "pending" }],
+                    "name": if name.is_empty() { "Anonymous node".to_string() } else { name.clone() },
+                    "anonymous": name.is_empty(), "region": n.region,
+                    "since": &super::identity::rfc3339(n.first_seen)[..7],
+                    "uptime_pct": n.uptime_pct(t, WINDOW_DAYS).unwrap_or(0.0).round() as i64,
+                    "accepting": n.accepting && !n.paused,
+                })
+            })
+            .collect();
+        nodes.sort_by_key(|v| (v["status"] != "verified", v["name"].as_str().unwrap_or("").to_string()));
+        serde_json::json!({ "nodes": nodes, "updated": t })
+    }
+
+    /// Write the leaderboard where Caddy serves `/community/nodes.json` (NODES_LEADERBOARD_FILE).
+    pub fn publish(&self) -> Result<()> {
+        if let Some(p) = &self.cfg.nodes_leaderboard_file {
+            let body = serde_json::to_string_pretty(&self.leaderboard(now()))?;
+            let tmp = p.with_extension("tmp");
+            std::fs::write(&tmp, body)?;
+            std::fs::rename(&tmp, p)?;
+        }
+        Ok(())
+    }
+}
+
+fn nodes(state: &AppState) -> &Nodes {
+    state.p2p.nodes.as_ref().expect("node routes are mounted only when enabled")
+}
