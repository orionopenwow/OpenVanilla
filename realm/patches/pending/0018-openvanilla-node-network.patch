+        hidden.leaderboard = "off".into();
+        hidden.display_name = "Hidden Carl".into();
+        hidden.days.insert(utc_day(t), Day { relay_bytes: 7_000_000_000, seed_bytes: 0 });
+        lock(&ns.file).nodes.insert(n.node_id.clone(), n);
+        lock(&ns.file).nodes.insert(hidden.node_id.clone(), hidden);
+        let lb = ns.leaderboard(t);
