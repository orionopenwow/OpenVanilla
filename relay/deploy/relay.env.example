RELAY_VERIFY_URL=https://play.openvanilla.app/api/directory/verify
RELAY_VERIFY_SECRET=change-me-shared-with-central
# Optional static allow-list (host_id token_sha256 [public|private]); checked before central.
RELAY_ALLOW_FILE=/etc/openvanilla-relay/allow.txt
RELAY_MAX_STREAMS=64
RELAY_KBPS=256
RELAY_DAILY_GB=20
RELAY_STREAM_IDLE_SECS=900
RELAY_CTRL_IDLE_SECS=90
RELAY_OPEN_TIMEOUT_SECS=10
RUST_LOG=info
